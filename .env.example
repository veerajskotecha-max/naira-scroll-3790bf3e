# Copy to .env and fill in per environment. Every var must start with VITE_ to
# reach the browser bundle. Nothing secret belongs here — Vite inlines these
# into the client build.

# Host that Shopify web checkout runs on.
#
# Leave unset and checkout falls back to the store's permanent
# nc5eti-gp.myshopify.com domain, which shows an unbranded URL at the payment
# step AND breaks for any browser that blocks third-party cookies (Safari/iOS,
# Firefox, incognito) — see docs/checkout-domain.md.
#
# Set this to a subdomain of nairaflore.com once that subdomain is connected to
# Shopify and made the store's PRIMARY domain.
# VITE_CHECKOUT_DOMAIN=shop.nairaflore.com

# Reveal the real Shopify-backed jewellery grid on /shop instead of the
# "Coming Soon" panel.
# VITE_JEWELLERY_LIVE=true

# Judge.me reviews widget loader URL.
# VITE_JUDGEME_SCRIPT_URL=
