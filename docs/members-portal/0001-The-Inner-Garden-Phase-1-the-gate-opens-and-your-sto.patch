index 0000000..e1c2cad
--- /dev/null
+++ b/src/components/portal/DoorsOpen.test.tsx
@@ -0,0 +1,138 @@
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import DoorsOpen, { DOORS_MS } from "./DoorsOpen";
+import { MemberProvider, type Member } from "./MemberContext";
+import { doorsModeFor, pickDoors } from "@/lib/portal/doors";
+import { istDayKey } from "@/lib/portal/ist";
+import { writePortal } from "@/lib/portal/safeStorage";
+
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => null }));
+
+import GardenHome from "@/pages/members/GardenHome";
+
+const setReducedMotion = (reduce: boolean) => {
+  window.matchMedia = ((query: string) => ({
+    matches: reduce && query.includes("reduce"),
+    media: query,
+    onchange: null,
+    addListener: () => {},
+    removeListener: () => {},
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    dispatchEvent: () => false,
+  })) as typeof window.matchMedia;
+};
+
+const member = (over: Partial<Member> = {}): Member => ({
+  user: { id: "u-1", email: "ananya@example.com", created_at: "2026-11-04T05:00:00Z", user_metadata: {} } as unknown as Member["user"],
+  profile: { id: "u-1", full_name: "Ananya", birthday: "1999-07-14", phone: null, city: null },
+  firstName: "Ananya",
+  preview: false,
+  saveBirthday: async () => ({ ok: true }),
+  addToBag: async () => {},
+  doorsPlayed: false,
+  markDoorsPlayed: () => {},
+  ...over,
+});
+
+const home = (m: Member) =>
+  render(
+    <MemoryRouter>
+      <MemberProvider value={m}>
+        <GardenHome />
+      </MemberProvider>
+    </MemoryRouter>,
+  );
+
+beforeEach(() => {
+  window.localStorage.clear();
+  setReducedMotion(false);
+});
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+});
+
+describe("the Doors", () => {
+  it("fit the plan's timings: 1.6 s in full, 0.5 s after", () => {
+    expect(DOORS_MS.full).toBeLessThanOrEqual(1600);
+    expect(DOORS_MS.short).toBeLessThanOrEqual(500);
+  });
+
+  it("play in full once per IST day on this device, then short", () => {
+    const today = istDayKey(new Date("2026-11-05T06:00:00Z"));
+    expect(doorsModeFor(undefined, today)).toBe("full");
+    expect(doorsModeFor("2026-11-04", today)).toBe("full");
+    expect(doorsModeFor(today, today)).toBe("short");
+    writePortal({ doorsDay: istDayKey() });
+    expect(pickDoors(false)).toBe("short");
+    expect(pickDoors(true)).toBeNull();
+  });
+
+  it("record the full entrance, so the next visit that day is short", () => {
+    const first = home(member());
+    expect(first.container.querySelector(".ig-doors")?.getAttribute("data-mode")).toBe("full");
+    first.unmount();
+    const second = home(member());
+    expect(second.container.querySelector(".ig-doors")?.getAttribute("data-mode")).toBe("short");
+  });
+
+  it("sway at most 24 plants when motion is allowed", () => {
+    const { container } = home(member({ doorsPlayed: true }));
+    const sway = container.querySelectorAll(".ig-sway").length;
+    expect(sway).toBeGreaterThan(0);
+    expect(sway).toBeLessThanOrEqual(24);
+  });
+
+  it("do not replay when she comes back to the garden in the same visit", () => {
+    const { container } = home(member({ doorsPlayed: true }));
+    expect(container.querySelector(".ig-doors")).toBeNull();
+    expect(document.activeElement).toBe(screen.getByRole("heading", { level: 1 }));
+  });
+
+  it("start the garden as the curtain lifts and finish within their time", () => {
+    vi.useFakeTimers();
+    const onReveal = vi.fn();
+    const onDone = vi.fn();
+    render(<DoorsOpen mode="full" name="Ananya" greeting="Good evening" onReveal={onReveal} onDone={onDone} />);
+    act(() => void vi.advanceTimersByTime(819));
+    expect(onReveal).not.toHaveBeenCalled();
+    act(() => void vi.advanceTimersByTime(1));
+    expect(onReveal).toHaveBeenCalledWith(false);
+    act(() => void vi.advanceTimersByTime(780));
+    expect(onDone).toHaveBeenCalledTimes(1);
+  });
+
+  it("skip on a tap, once", () => {
+    const onDone = vi.fn();
+    const { container } = render(<DoorsOpen mode="full" name="Ananya" greeting="Good evening" onReveal={() => {}} onDone={onDone} />);
+    fireEvent.pointerDown(container.querySelector(".ig-doors")!);
+    fireEvent.pointerDown(container.querySelector(".ig-doors")!);
+    expect(onDone).toHaveBeenCalledTimes(1);
+  });
+
+  it("skip on Escape too", () => {
+    const onDone = vi.fn();
+    render(<DoorsOpen mode="short" name="Ananya" greeting="Good evening" onReveal={() => {}} onDone={onDone} />);
+    fireEvent.keyDown(window, { key: "Escape" });
+    expect(onDone).toHaveBeenCalledTimes(1);
+  });
+
+  /* Under reduced motion the garden is simply open: no overlay, nothing left
+     waiting at opacity 0, and the heading takes focus. */
+  it("show the final state at once under reduced motion", () => {
+    setReducedMotion(true);
+    const { container } = home(member());
+    expect(container.querySelector(".ig-doors")).toBeNull();
+    const h1 = screen.getByRole("heading", { level: 1 });
+    expect(h1).toHaveTextContent(/Ananya$/);
+    expect(document.activeElement).toBe(h1);
+    const hidden = [...container.querySelectorAll<HTMLElement>("*")].filter((el) => el.style.opacity === "0");
+    expect(hidden).toEqual([]);
+    // No sway layers either: every plant stands still.
+    expect(container.querySelector(".ig-bed")).not.toBeNull();
+    expect(container.querySelectorAll(".ig-sway")).toHaveLength(0);
+  });
+});
diff --git a/src/components/portal/DoorsOpen.tsx b/src/components/portal/DoorsOpen.tsx
new file mode 100644
index 0000000..90b024f
--- /dev/null
+++ b/src/components/portal/DoorsOpen.tsx
@@ -0,0 +1,151 @@
+import { useCallback, useEffect, useLayoutEffect, useRef } from "react";
+import GateIronwork from "./GateIronwork";
+import FlowerDraw, { drawFlower } from "./FlowerDraw";
+import { burstPetals } from "./PetalBurst";
+import { EASE_CURTAIN, EASE_DRAWER, EASE_IN, EASE_REVEAL, cue, play } from "@/lib/portal/motion";
+
+/*
+  THE DOORS: the way into her garden. Over a sage curtain, the Naira flower
+  draws itself in gold in the gate's latch and fills blush; petals burst from
+  the latch, the two leaves swing back (rotateY ±100°, perspective 900px,
+  --ease-drawer), and the curtain lifts like a blind on its cream five-petal
+  tassel (the shop's PageCurtain recipe, copied, not shared: the global
+  curtain is untouched) while the garden blooms in beneath. 1.6 s in full,
+  once per IST day on this device; 0.5 s every other visit. A tap or a key
+  skips it. The caller never mounts it under reduced motion.
+*/
+
+export type DoorsMode = "full" | "short";
+
+// eslint-disable-next-line react-refresh/only-export-components -- the entrance's timings, beside it for its test
+export const DOORS_MS: Record<DoorsMode, number> = { full: 1600, short: 500 };
+
+type Props = {
+  mode: DoorsMode;
+  name: string;
+  greeting: string;
+  /** The curtain is lifting: start the garden's own bloom-in. */
+  onReveal: (short: boolean) => void;
+  onDone: () => void;
+};
+
+const DoorsOpen = ({ mode, name, greeting, onReveal, onDone }: Props) => {
+  const short = mode === "short";
+  const rootRef = useRef<HTMLDivElement>(null);
+  const curtainRef = useRef<HTMLDivElement>(null);
+  const stageRef = useRef<HTMLDivElement>(null);
+  const leftRef = useRef<HTMLDivElement>(null);
+  const rightRef = useRef<HTMLDivElement>(null);
+  const latchRef = useRef<HTMLDivElement>(null);
+  const greetRef = useRef<HTMLParagraphElement>(null);
+  const anims = useRef<Animation[]>([]);
+  const ended = useRef(false);
+
+  const end = useCallback(() => {
+    if (ended.current) return;
+    ended.current = true;
+    anims.current.forEach((a) => {
+      try {
+        a.finish();
+      } catch {
+        a.cancel();
+      }
+    });
+    onDone();
+  }, [onDone]);
+
+  // Before the first paint, so the closed gate is the first thing she sees.
+  useLayoutEffect(() => {
+    const list = anims.current;
+    const keep = (a: Animation | null) => {
+      if (a) list.push(a);
+    };
+    // Steps cued on the same timeline as the animations, so they stay in time.
+    const later = (ms: number, fn: () => void) => keep(cue(rootRef.current, ms, () => !ended.current && fn()));
+
+    if (!short) {
+      // Drawn and coloured (by ~0.75 s) before the leaves part and it opens out.
+      list.push(...drawFlower(latchRef.current, { duration: 620 }));
+      keep(play(greetRef.current, [{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 420, delay: 120, easing: EASE_REVEAL, fill: "backwards" }));
+      later(650, () => {
+        const root = rootRef.current;
+        const latch = latchRef.current?.getBoundingClientRect();
+        if (!root || !latch) return;
+        list.push(...burstPetals(root, latch.left + latch.width / 2, latch.top + latch.height / 2, { count: 20, spread: 150 }));
+      });
+    }
+
+    const swing = { duration: short ? 420 : 900, delay: short ? 0 : 560, easing: EASE_DRAWER, fill: "both" as const };
+    keep(play(leftRef.current, [{ transform: "rotateY(0deg)", opacity: 1 }, { transform: "rotateY(62deg)", opacity: 1, offset: 0.62 }, { transform: "rotateY(100deg)", opacity: 0 }], swing));
+    keep(play(rightRef.current, [{ transform: "rotateY(0deg)", opacity: 1 }, { transform: "rotateY(-62deg)", opacity: 1, offset: 0.62 }, { transform: "rotateY(-100deg)", opacity: 0 }], swing));
+    const away = { duration: short ? 220 : 280, delay: short ? 60 : 780, easing: EASE_IN, fill: "forwards" as const };
+    keep(play(stageRef.current, [{ opacity: 1, transform: "none" }, { opacity: 0, transform: "translateY(-18px)" }], away));
+    // As the leaves part, the flower in the latch rises and opens out, then goes with the curtain.
+    keep(
+      play(
+        latchRef.current,
+        short
+          ? [{ opacity: 1, transform: "none" }, { opacity: 0, transform: "translateY(-26px) scale(1.12)" }]
+          : [
+              { opacity: 1, transform: "none" },
+              { opacity: 1, transform: "translateY(-12px) scale(2.3)", offset: 0.62 },
+              { opacity: 0, transform: "translateY(-34px) scale(2.7)" },
+            ],
+        short ? away : { duration: 560, delay: 560, easing: EASE_REVEAL, fill: "forwards" },
+      ),
+    );
+    keep(play(curtainRef.current, [{ transform: "translateY(0)" }, { transform: "translateY(-100%)" }], { duration: short ? 400 : 600, delay: short ? 80 : 820, easing: EASE_CURTAIN, fill: "forwards" }));
+
+    later(short ? 60 : 820, () => onReveal(short));
+    later(DOORS_MS[mode], end);
+    // A safety net should the timeline never run (a tab hidden mid-entrance).
+    const net = window.setTimeout(end, 8000);
+    return () => window.clearTimeout(net);
+    // Played once, as mounted.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape" || e.key === "Enter" || e.key === " ") end();
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [end]);
+
+  return (
+    <div ref={rootRef} className="ig-doors" aria-hidden onPointerDown={end} data-mode={mode}>
+      <div ref={curtainRef} className="ig-curtain">
+        <svg className="ig-tassel" viewBox="0 0 40 40" width="40" height="40">
+          {[0, 72, 144, 216, 288].map((a) => {
+            const rad = ((a - 90) * Math.PI) / 180;
+            const x = 20 + Math.cos(rad) * 9;
+            const y = 20 + Math.sin(rad) * 9;
+            return <ellipse key={a} cx={x} cy={y} rx="6" ry="3.4" fill="#FFF8F5" transform={`rotate(${a - 90} ${x} ${y})`} />;
+          })}
+          <circle cx="20" cy="20" r="4.4" fill="var(--nf-blush)" />
+        </svg>
+      </div>
+      <div className="ig-doors-stage">
+        <GateIronwork
+          tone="sage"
+          leftRef={leftRef}
+          rightRef={rightRef}
+          latch={
+            <div ref={latchRef} className="ig-doors-latch">
+              <FlowerDraw height={64} />
+            </div>
+          }
+        />
+        <div ref={stageRef} className="ig-doors-words">
+          <p ref={greetRef} className="ig-doors-greet" data-clarity-mask="true">
+            {greeting}, <em>{name}</em>
+          </p>
+          {!short && <p className="ig-doors-hint">Tap to skip</p>}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default DoorsOpen;
