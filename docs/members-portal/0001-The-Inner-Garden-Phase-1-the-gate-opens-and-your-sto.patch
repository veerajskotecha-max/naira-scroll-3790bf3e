+import { describe, expect, it } from "vitest";
+import { BED, MAX_PLANTS, MAX_SWAY, layoutGarden } from "./gardenLayout";
+
+/* Her garden is hers: the same id grows the same bed on every visit and
+   device, and the bed stays inside the budgets a mid-range Android can
+   composite without dropping frames (80 plants, 24 swaying). */
+describe("the seeded garden", () => {
+  const ids = ["3f2c9a1e-0b7d-4c55-9a51-7e7e2d1c0a11", "preview-ananya", "a", "", "naira-flore-gate"];
+
+  it("grows the same garden from the same id", () => {
+    for (const id of ids) expect(layoutGarden(id)).toEqual(layoutGarden(id));
+  });
+
+  it("grows a different garden for a different member", () => {
+    const a = layoutGarden(ids[0]).plants.map((p) => [p.kind, p.x, p.y]);
+    const b = layoutGarden("3f2c9a1e-0b7d-4c55-9a51-7e7e2d1c0a12").plants.map((p) => [p.kind, p.x, p.y]);
+    expect(a).not.toEqual(b);
+  });
+
+  it.each(ids)("keeps within the budgets (%s)", (id) => {
+    const { plants } = layoutGarden(id);
+    expect(plants.length).toBeLessThanOrEqual(MAX_PLANTS);
+    expect(plants.filter((p) => p.sway).length).toBeLessThanOrEqual(MAX_SWAY);
+    expect(plants.length).toBeGreaterThan(40);
+  });
+
+  it("plants her two flowers on the soil, in front, and swaying", () => {
+    const { plants, naira, stone } = layoutGarden(ids[0]);
+    expect(plants.filter((p) => p.kind === "naira")).toHaveLength(1);
+    expect(plants.filter((p) => p.kind === "stone")).toHaveLength(1);
+    for (const p of [naira, stone]) {
+      expect(p.y).toBe(BED.soil);
+      expect(p.sway).toBe(true);
+    }
+    // Painted last: nothing stands in front of them.
+    expect(plants.slice(-2).map((p) => p.kind).sort()).toEqual(["naira", "stone"]);
+  });
+
+  it("keeps every plant inside the bed and paints back to front", () => {
+    const { plants } = layoutGarden(ids[1]);
+    for (const p of plants) {
+      expect(p.x).toBeGreaterThanOrEqual(0);
+      expect(p.x).toBeLessThanOrEqual(BED.w);
+      expect(p.y).toBeLessThanOrEqual(BED.soil);
+      expect(p.band).toBeGreaterThanOrEqual(0);
+    }
+    const ys = plants.map((p) => p.y);
+    expect(ys).toEqual([...ys].sort((a, b) => a - b));
+  });
+});
diff --git a/src/lib/portal/gardenLayout.ts b/src/lib/portal/gardenLayout.ts
