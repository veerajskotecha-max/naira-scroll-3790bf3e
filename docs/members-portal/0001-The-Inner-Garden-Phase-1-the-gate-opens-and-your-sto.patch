+import { describe, expect, it } from "vitest";
+import { dayBand, formatIstDate, greetingFor, istDayKey } from "./ist";
+
+/* The garden keeps Indian time whatever zone the phone is set to: 18:30 UTC
+   is already tomorrow in Pune, and 11:29 UTC is still morning there. */
+const utc = (s: string) => new Date(`${s}Z`);
+
+describe("IST", () => {
+  it("turns the day over at 18:30 UTC", () => {
+    expect(istDayKey(utc("2026-11-04T18:29:59"))).toBe("2026-11-04");
+    expect(istDayKey(utc("2026-11-04T18:30:00"))).toBe("2026-11-05");
+    expect(istDayKey(utc("2026-12-31T18:30:00"))).toBe("2027-01-01");
+  });
+
+  it.each([
+    ["2026-11-04T22:29:59", "night", "Hello"], // 03:59:59 IST
+    ["2026-11-04T22:30:00", "morning", "Good morning"], // 04:00
+    ["2026-11-05T06:29:59", "morning", "Good morning"], // 11:59:59
+    ["2026-11-05T06:30:00", "afternoon", "Good afternoon"], // 12:00
+    ["2026-11-05T11:29:59", "afternoon", "Good afternoon"], // 16:59:59
+    ["2026-11-05T11:30:00", "evening", "Good evening"], // 17:00
+    ["2026-11-05T18:29:59", "evening", "Good evening"], // 23:59:59
+    ["2026-11-05T18:30:00", "night", "Hello"], // 00:00 IST, the next day
+  ])("%s UTC is %s in IST", (at, band, greeting) => {
+    expect(dayBand(utc(at))).toBe(band);
+    expect(greetingFor(utc(at))).toBe(greeting);
+  });
+
+  it("dates the day she joined as she saw it in India", () => {
+    expect(formatIstDate("2026-11-03T20:00:00Z")).toBe("4 Nov 2026");
+    expect(formatIstDate("2026-11-04T10:00:00+05:30")).toBe("4 Nov 2026");
+    expect(formatIstDate("not a date")).toBeNull();
+    expect(formatIstDate(undefined)).toBeNull();
+  });
+});
diff --git a/src/lib/portal/ist.ts b/src/lib/portal/ist.ts
new file mode 100644
index 0000000..8e84a62
--- /dev/null
+++ b/src/lib/portal/ist.ts
@@ -0,0 +1,62 @@
+/*
+  The garden keeps Indian time. A member in Pune at 7 pm is greeted "Good
+  evening" even if her phone is set to another zone, and "once per day" for
+  the Doors means one IST day. IST has no daylight saving, so it is plain
+  UTC + 5:30 and needs no Intl time-zone data (which some older Android
+  WebViews lack).
+*/
+
+const IST_OFFSET_MS = (5 * 60 + 30) * 60 * 1000;
+
+const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+
+export type IstParts = { year: number; month: number; day: number; hour: number; minute: number };
+
+export const istParts = (at: Date = new Date()): IstParts => {
+  const t = new Date(at.getTime() + IST_OFFSET_MS);
+  return {
+    year: t.getUTCFullYear(),
+    month: t.getUTCMonth() + 1,
+    day: t.getUTCDate(),
+    hour: t.getUTCHours(),
+    minute: t.getUTCMinutes(),
+  };
+};
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+/** "2026-11-04": the IST calendar day, for once-a-day things on this device. */
+export const istDayKey = (at: Date = new Date()): string => {
+  const p = istParts(at);
+  return `${p.year}-${pad(p.month)}-${pad(p.day)}`;
+};
+
+export type DayBand = "morning" | "afternoon" | "evening" | "night";
+
+/** Morning from 4:00, afternoon from 12:00, evening from 17:00, night from midnight. */
+export const dayBand = (at: Date = new Date()): DayBand => {
+  const { hour } = istParts(at);
+  if (hour >= 4 && hour < 12) return "morning";
+  if (hour >= 12 && hour < 17) return "afternoon";
+  if (hour >= 17) return "evening";
+  return "night";
+};
+
+const GREETING: Record<DayBand, string> = {
+  morning: "Good morning",
+  afternoon: "Good afternoon",
+  evening: "Good evening",
+  // Between midnight and four, "good evening" reads wrong and "good night" is a farewell.
+  night: "Hello",
+};
+
+export const greetingFor = (at: Date = new Date()): string => GREETING[dayBand(at)];
+
+/** "4 Nov 2026", in IST: the day a member joined, as she would have seen it. */
+export const formatIstDate = (iso: string | null | undefined): string | null => {
+  if (!iso) return null;
+  const at = new Date(iso);
+  if (Number.isNaN(at.getTime())) return null;
+  const p = istParts(at);
+  return `${p.day} ${MONTHS[p.month - 1]} ${p.year}`;
+};
diff --git a/src/lib/portal/motion.ts b/src/lib/portal/motion.ts
new file mode 100644
index 0000000..4ba1900
--- /dev/null
+++ b/src/lib/portal/motion.ts
@@ -0,0 +1,116 @@
+import { useEffect, useState, type RefObject } from "react";
+
+/*
+  Motion for the portal, in two tiers. Tier 1 (every phone) moves only
+  transform, opacity and stroke-dashoffset, with the Web Animations API, so
+  nothing joins the site-wide stylesheet and every animation can be finished
+  on a tap. Tier 0 (reduced motion, Data Saver, 2g/3g, the prerender) draws
+  every screen in its final state at once.
+*/
+
+export const prefersReducedMotion = (): boolean => {
+  try {
+    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+  } catch {
+    return false;
+  }
+};
+
+type Connection = { saveData?: boolean; effectiveType?: string };
+
+const saveData = (): boolean => {
+  try {
+    const c = (navigator as Navigator & { connection?: Connection }).connection;
+    return Boolean(c?.saveData) || /(^|-)(2g|3g)$/.test(c?.effectiveType ?? "");
+  } catch {
+    return false;
+  }
+};
+
+/** Tier 0: show final states only. */
+export const stillMotion = (): boolean => prefersReducedMotion() || saveData();
+
+/** Starts a WAAPI animation, or returns null where it cannot (old WebViews, tests, Tier 0). */
+export const play = (
+  el: Element | null | undefined,
+  keyframes: Keyframe[],
+  options: KeyframeAnimationOptions,
+): Animation | null => {
+  if (!el || typeof (el as HTMLElement).animate !== "function") return null;
+  try {
+    return (el as HTMLElement).animate(keyframes, options);
+  } catch {
+    return null;
+  }
+};
+
+/**
+ * Calls `fn` `ms` into the element's animation timeline: a cue that keeps
+ * pace with the animations around it (a busy phone, a slowed-down devtools
+ * timeline) where a setTimeout would drift. Finishing it early fires it, so
+ * callers guard against running after a skip. Falls back to a timer.
+ */
+export const cue = (el: Element | null | undefined, ms: number, fn: () => void): Animation | null => {
+  const a = play(el, [{ opacity: 1 }, { opacity: 1 }], { duration: Math.max(1, ms) });
+  if (a) a.onfinish = fn;
+  else window.setTimeout(fn, ms);
+  return a;
+};
+
+export const EASE_DRAWER = "cubic-bezier(0.32, 0.72, 0, 1)";
+export const EASE_REVEAL = "cubic-bezier(0.22, 1, 0.36, 1)";
+export const EASE_BLOOM = "cubic-bezier(0.34, 1.56, 0.64, 1)";
+export const EASE_CURTAIN = "cubic-bezier(0.76, 0, 0.24, 1)";
+/* Accelerating. Spelt out as a curve: the CSS keyword for it, written in any
+   source file, makes Tailwind add a matching utility to the global CSS. */
+export const EASE_IN = "cubic-bezier(0.42, 0, 1, 1)";
+
+export const IDLE_MS = 20_000;
+
+/**
+ * Whether the ambient loop on this screen should run: the element is on
+ * screen, the tab is visible, and someone has touched, scrolled or typed in
+ * the last 20 s. After that "the garden rests" until the next interaction.
+ */
+export const useAmbient = (ref: RefObject<Element>, enabled = true, idleMs = IDLE_MS): boolean => {
+  const [onScreen, setOnScreen] = useState(false);
+  const [visible, setVisible] = useState(() => typeof document === "undefined" || document.visibilityState !== "hidden");
+  const [awake, setAwake] = useState(true);
+
+  useEffect(() => {
+    const el = ref.current;
+    if (!enabled || !el) return;
+    if (typeof IntersectionObserver === "undefined") {
+      setOnScreen(true);
+      return;
+    }
+    const io = new IntersectionObserver(([entry]) => setOnScreen(entry.isIntersecting), { rootMargin: "40px" });
+    io.observe(el);
+    return () => io.disconnect();
+  }, [ref, enabled]);
+
+  useEffect(() => {
+    if (!enabled) return;
+    const onVisibility = () => setVisible(document.visibilityState !== "hidden");
+    document.addEventListener("visibilitychange", onVisibility);
+    return () => document.removeEventListener("visibilitychange", onVisibility);
+  }, [enabled]);
+
+  useEffect(() => {
+    if (!enabled) return;
+    let timer = window.setTimeout(() => setAwake(false), idleMs);
+    const wake = () => {
+      window.clearTimeout(timer);
+      setAwake(true);
+      timer = window.setTimeout(() => setAwake(false), idleMs);
+    };
+    const events = ["pointerdown", "pointermove", "scroll", "keydown", "touchstart"] as const;
+    events.forEach((e) => window.addEventListener(e, wake, { passive: true }));
+    return () => {
+      window.clearTimeout(timer);
+      events.forEach((e) => window.removeEventListener(e, wake));
+    };
+  }, [enabled, idleMs]);
+
+  return enabled && onScreen && visible && awake;
+};
