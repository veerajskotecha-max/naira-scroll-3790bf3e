+++ b/src/lib/portal/gardenLayout.ts
@@ -0,0 +1,160 @@
+/*
+  Her garden bed, laid out from her own user id: the same id always grows the
+  same garden, on every device and every visit, and no two members share one.
+  Pure maths (a 32-bit FNV-1a hash seeding mulberry32), so it is the same in a
+  test, the prerender and the browser.
+
+  The bed is a 390 x 560 view (phone first), planted in three rows from the
+  back. Two plants are hers alone, at the front: the Naira flower, planted the
+  day she joined, and her stone flower (a closed bud until her birthday is
+  known). Budgets from the plan: at most 80 plants and at most 24 swaying, so a
+  mid-range Android composites the bed without dropping frames.
+*/
+
+export const BED = { w: 390, h: 560, soil: 522 } as const;
+export const MAX_PLANTS = 80;
+export const MAX_SWAY = 24;
+export const BANDS = 12;
+
+export type PlantKind = "grass" | "sprig" | "bud" | "bloom" | "breath" | "leaves" | "naira" | "stone";
+
+export type Plant = {
+  id: string;
+  kind: PlantKind;
+  /** 0 back, 1 middle, 2 front. */
+  row: 0 | 1 | 2;
+  /** Stem base, in the 390 x 560 view. */
+  x: number;
+  y: number;
+  scale: number;
+  flip: boolean;
+  /** Index into SPECIES for blooms. */
+  species: number;
+  /** Index into that species' palette. */
+  tone: number;
+  /** Which of the three stems a bloom or bud stands on. */
+  stem: 0 | 1 | 2;
+  sway: boolean;
+  /** Back-to-front band, 0..BANDS-1, for the bloom-in. */
+  band: number;
+  /** Seconds for one sway, and where in it this plant starts. */
+  swayDur: number;
+  swayPhase: number;
+};
+
+export const hashString = (text: string): number => {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < text.length; i++) {
+    h ^= text.charCodeAt(i);
+    h = Math.imul(h, 0x01000193);
+  }
+  return h >>> 0;
+};
+
+export const mulberry32 = (seed: number) => {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+};
+
+type Weights = Partial<Record<PlantKind, number>>;
+type RowSpec = { row: 0 | 1 | 2; count: number; yMin: number; yMax: number; sMin: number; sMax: number; weights: Weights };
+
+const ROWS: RowSpec[] = [
+  { row: 0, count: 26, yMin: 262, yMax: 330, sMin: 0.58, sMax: 0.82, weights: { grass: 26, sprig: 24, breath: 20, bud: 14, bloom: 16 } },
+  { row: 1, count: 22, yMin: 372, yMax: 448, sMin: 0.74, sMax: 0.96, weights: { bloom: 34, sprig: 20, bud: 20, grass: 14, leaves: 12 } },
+  { row: 2, count: 18, yMin: 510, yMax: 520, sMin: 0.92, sMax: 1.14, weights: { bloom: 38, leaves: 20, bud: 14, grass: 16, sprig: 12 } },
+];
+
+const pick = (rand: () => number, weights: Weights): PlantKind => {
+  const entries = Object.entries(weights) as [PlantKind, number][];
+  const total = entries.reduce((s, [, w]) => s + w, 0);
+  let r = rand() * total;
+  for (const [kind, w] of entries) {
+    if ((r -= w) < 0) return kind;
+  }
+  return entries[entries.length - 1][0];
+};
+
+const bandOf = (y: number) => Math.max(0, Math.min(BANDS - 1, Math.floor(((y - 260) / (BED.soil + 2 - 260)) * BANDS)));
+
+export type Garden = { plants: Plant[]; naira: Plant; stone: Plant };
+
+export const layoutGarden = (seedText: string): Garden => {
+  const rand = mulberry32(hashString(seedText || "naira"));
+  const r = (min: number, max: number) => min + rand() * (max - min);
+  const plants: Plant[] = [];
+
+  // Her two plants first, so the rows can keep clear of them.
+  const nairaX = Math.round(r(138, 168));
+  const stoneX = Math.round(nairaX + r(96, 116));
+  const feature = (id: string, kind: PlantKind, x: number): Plant => ({
+    id,
+    kind,
+    row: 2,
+    x,
+    y: BED.soil,
+    scale: 1,
+    flip: false,
+    species: 1,
+    tone: 0,
+    stem: 0,
+    sway: true,
+    band: BANDS - 1,
+    swayDur: r(4.2, 5.4),
+    swayPhase: rand(),
+  });
+  const naira = feature("naira", "naira", nairaX);
+  const stone = feature("stone", "stone", stoneX);
+  const clear = (x: number) => Math.abs(x - (nairaX + 18)) > 62 && Math.abs(x - stoneX) > 34;
+
+  for (const spec of ROWS) {
+    // Inside the arbour's posts.
+    const left = 40;
+    const span = BED.w - 80;
+    const slot = span / spec.count;
+    for (let i = 0; i < spec.count; i++) {
+      const x = Math.round(left + slot * (i + 0.15 + rand() * 0.7));
+      const y = Math.round(r(spec.yMin, spec.yMax));
+      const kind = pick(rand, spec.weights);
+      const species = Math.floor(rand() * 6);
+      const plant: Plant = {
+        id: `p${spec.row}-${i}`,
+        kind,
+        row: spec.row,
+        x,
+        y,
+        scale: Number(r(spec.sMin, spec.sMax).toFixed(3)),
+        flip: rand() < 0.5,
+        species,
+        tone: Math.floor(rand() * 4),
+        stem: Math.floor(rand() * 3) as 0 | 1 | 2,
+        sway: false,
+        band: bandOf(y),
+        swayDur: Number(r(3.4, 5.6).toFixed(2)),
+        swayPhase: rand(),
+      };
+      // The front row leaves room around her two plants.
+      if (spec.row === 2 && !clear(x)) continue;
+      plants.push(plant);
+    }
+  }
+
+  // Sway: her two, then the front and middle rows in a seeded order.
+  const candidates = plants
+    .filter((p) => p.row > 0)
+    .map((p) => ({ p, key: rand() }))
+    .sort((a, b) => a.key - b.key)
+    .slice(0, MAX_SWAY - 2);
+  for (const { p } of candidates) p.sway = true;
+
+  const all = [...plants, naira, stone].slice(0, MAX_PLANTS);
+  // Painter's order: back to front, so nearer plants overlap farther ones.
+  all.sort((a, b) => a.y - b.y || a.x - b.x);
+  return { plants: all, naira, stone };
+};
