+/*
+  The six botanicals of the shop's tap-to-bloom (jewellery/RingAtelierBackdrop),
+  lifted here so the portal's garden, its tap blooms and its drop flowers draw
+  from one table without the portal importing the homepage backdrop (which
+  would split it into a chunk the shop pages then fetch). Flat fills only: the
+  backdrop's radial-gradient cores are replaced by a solid core and a cream
+  dot, which costs nothing to paint on a phone.
+
+  `d` is one petal in a 40x80 box, tip at the top (20,3), base at (20,77).
+*/
+
+export type Species = {
+  name: string;
+  d: string;
+  petals: number;
+  /** Ratio of the inner whorl to the outer one (0 = no inner whorl). */
+  inner: number;
+  palette: readonly string[];
+  core: string;
+  /** Seconds a tap bloom takes to open and fade. */
+  dur: number;
+};
+
+export const SPECIES: readonly Species[] = [
+  {
+    name: "rose",
+    d: "M20,3 C34,20 35,52 20,77 C5,52 6,20 20,3 Z",
