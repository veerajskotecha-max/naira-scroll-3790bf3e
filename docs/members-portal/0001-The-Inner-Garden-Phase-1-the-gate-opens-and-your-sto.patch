@@ -0,0 +1,19 @@
+/*
+  Instagram's and Facebook's in-app browsers. About half the shop's visits
+  arrive in Instagram's, and Google refuses its sign-in inside embedded
+  browsers (disallowed_useragent), so there the Google button can only fail.
+  Instagram puts "Instagram" in its user agent; Facebook's apps add FBAN
+  (iOS) or FBAV (Android).
+*/
+
+export type InAppBrowser = "Instagram" | "Facebook" | null;
+
+export const inAppBrowser = (userAgent: string | null | undefined): InAppBrowser => {
+  const ua = userAgent ?? "";
+  if (/\bInstagram\b/i.test(ua)) return "Instagram";
+  if (/\bFB(AN|AV)\b|FB_IAB|\[FB/i.test(ua)) return "Facebook";
+  return null;
+};
+
+export const googleBlockedNote = (app: Exclude<InAppBrowser, null>) =>
+  `Google sign-in doesn't open inside ${app}. Use your email, or open this page in your browser.`;
