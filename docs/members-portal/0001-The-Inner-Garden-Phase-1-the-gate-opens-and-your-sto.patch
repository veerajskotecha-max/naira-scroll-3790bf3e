+import { cleanup, render, screen } from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { safePerformancePath } from "@/lib/shopperPerformance";
+
+const auth = vi.hoisted(() => ({
+  state: { user: null as unknown, profile: null as unknown, loading: true, refreshProfile: async () => {}, session: null, signOut: async () => {} },
+}));
+vi.mock("@/contexts/AuthContext", () => ({ useAuth: () => auth.state }));
+vi.mock("@/contexts/CartContext", () => ({ useCart: () => ({ addItem: vi.fn(), setDrawerOpen: vi.fn() }) }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => <footer /> }));
+vi.mock("@/components/members/JoinInnerCircleForm", () => ({ default: () => <form aria-label="Join the Inner Circle" /> }));
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => ({ jewellery: [], isLive: false, isLoading: true }) }));
+vi.mock("@/integrations/supabase/lazy", () => ({ getSupabase: vi.fn() }));
+
+import MembersRoute from "./MembersRoute";
+
+const visit = (path: string) =>
+  render(
+    <MemoryRouter initialEntries={[path]}>
+      <Routes>
+        <Route path="/members/*" element={<MembersRoute />} />
+      </Routes>
+    </MemoryRouter>,
+  );
+
+const member = {
+  id: "3f2c9a1e-0b7d-4c55-9a51-7e7e2d1c0a11",
+  email: "ananya.r@example.com",
+  created_at: "2026-11-04T05:00:00Z",
+  user_metadata: {},
+};
+
+beforeEach(() => {
+  auth.state = { ...auth.state, user: null, profile: null, loading: true };
+  window.localStorage.clear();
+});
+afterEach(cleanup);
+
+describe("/members", () => {
+  /* While Supabase is still reading the session, a member must not see the
+     signed-out page (and its sign-in prompt) flash before her garden. */
+  it("keeps the gate closed while sign-in is being read", () => {
+    visit("/members");
+    expect(screen.getByRole("heading", { level: 1 })).toHaveTextContent("The Inner Garden");
+    expect(screen.getByRole("status")).toHaveTextContent("Opening the gate");
+    expect(screen.queryByRole("link", { name: /sign in or join/i })).toBeNull();
+    expect(screen.queryByRole("form", { name: /join the inner circle/i })).toBeNull();
+  });
+
+  it("sends a signed-out visitor to sign in, and back to the room she asked for", () => {
+    auth.state = { ...auth.state, loading: false };
+    visit("/members/stone");
+    const link = screen.getByRole("link", { name: /sign in or join/i });
+    const next = new URLSearchParams(link.getAttribute("href")!.split("?")[1]).get("next");
+    expect(link.getAttribute("href")!.startsWith("/auth?")).toBe(true);
+    expect(next).toBe("/members/stone");
+    expect(screen.getByRole("form", { name: /join the inner circle/i })).toBeInTheDocument();
+    expect(screen.getByRole("img", { name: /closed gold garden gate/i })).toBeInTheDocument();
+  });
+
+  it("makes no promise of prices, codes or perks at the gate", () => {
+    auth.state = { ...auth.state, loading: false };
+    const { container } = visit("/members");
+    expect(container.textContent).not.toMatch(/price|discount|% off|code|reward|exclusive/i);
+  });
+
+  it("opens her garden when she is signed in, greeting her by name", () => {
+    auth.state = { ...auth.state, loading: false, user: member, profile: { id: member.id, full_name: "Ananya Rao", birthday: "1999-07-14", phone: null, city: null } };
+    const { container } = visit("/members");
+    expect(screen.getByRole("heading", { level: 1 }).textContent).toMatch(/^Good (morning|afternoon|evening), Ananya$|^Hello, Ananya$/);
+    expect(container.querySelectorAll(".ig-plant").length).toBeGreaterThan(40);
+    expect(container.querySelectorAll(".ig-plant").length).toBeLessThanOrEqual(80);
+    const growing = screen.getByRole("heading", { name: "What's growing" }).nextElementSibling!;
+    expect(growing.textContent).toMatch(/The Naira flower, planted 4 Nov 2026/);
+    expect(growing.textContent).toMatch(/July · Ruby, in your month's colour/);
+    expect(screen.getByRole("navigation", { name: "Your garden" })).toBeInTheDocument();
+  });
+
+  it("falls back to her email for a name", () => {
+    auth.state = { ...auth.state, loading: false, user: member, profile: { id: member.id, full_name: null, birthday: null, phone: null, city: null } };
+    visit("/members");
+    expect(screen.getByRole("heading", { level: 1 })).toHaveTextContent(/, Ananya$/);
+  });
+
+  it("returns an unknown room to the garden", () => {
+    auth.state = { ...auth.state, loading: false, user: member, profile: null };
+    visit("/members/nowhere");
+    expect(screen.getByRole("heading", { name: "What's growing" })).toBeInTheDocument();
+  });
+
+  /* /auth and /account are kept out of shopper telemetry; so is the portal. */
+  it("is left out of the shopper performance telemetry", () => {
+    expect(safePerformancePath("/members")).toBeNull();
+    expect(safePerformancePath("/members/stone")).toBeNull();
+    expect(safePerformancePath("/jewellery")).toBe("/jewellery");
+  });
+});
