+import type { Stone } from "@/lib/portal/stones";
+import { STONE_PETAL, petalTransform } from "@/lib/portal/species";
+import { LEAF_SAGE } from "@/lib/portal/brandFlower";
+
+/*
+  Her stone as a flower: five petals in the month's hue, five inner petals in
+  its tint, a gold heart and one glint. The same drawing at every size: the
+  garden's stone plant, the seed ceremony, the specimen card and the month
+  chips. Until her month is known it is a closed sage bud.
+*/
+
+type HeadProps = { stone: Stone | null; size: number; className?: string; x?: number; y?: number };
+
+export const StoneHead = ({ stone, size, className = "", x, y }: HeadProps) => (
+  <svg viewBox="-50 -50 100 100" x={x} y={y} width={size} height={size} className={`ig-stonehead ${className}`} aria-hidden>
+    {stone ? (
+      <>
+        <g className="ig-stone-outer">
+          {[0, 1, 2, 3, 4].map((i) => (
+            <path key={i} d={STONE_PETAL} transform={petalTransform(i * 72, 46)} fill={stone.hue} stroke="rgb(128 97 42 / .35)" strokeWidth="1.4" />
+          ))}
+        </g>
+        <g className="ig-stone-inner">
+          {[0, 1, 2, 3, 4].map((i) => (
+            <path key={i} d={STONE_PETAL} transform={petalTransform(36 + i * 72, 26)} fill={stone.tint} opacity=".92" />
+          ))}
+        </g>
+        <path d="M0 9C-9 3-12-3-8-7C-5-10-1-9 0-5C1-9 5-10 8-7C12-3 9 3 0 9Z" fill="var(--nf-accent)" />
+        <g transform="translate(-19 -27)">
+          <path className="ig-glint" d="M0-11L1.6-1.6L11 0L1.6 1.6L0 11L-1.6 1.6L-11 0L-1.6-1.6Z" fill="#FFF8EE" stroke="var(--nf-accent)" strokeWidth=".7" />
+        </g>
+      </>
+    ) : (
+      <>
+        <path d="M0-30C13-17 15-4 0 12C-15-4-13-17 0-30Z" fill={LEAF_SAGE} opacity=".85" />
+        <path d="M0-30C13-17 15-4 0 12C-15-4-13-17 0-30Z" fill="none" stroke="var(--nf-accent)" strokeWidth="1.2" />
+        <path d="M0 12C-8 6-16 8-20 2M0 12C8 6 16 8 20 2" fill="none" stroke={LEAF_SAGE} strokeWidth="2" />
+      </>
+    )}
+  </svg>
+);
+
+/** A small heart-cut stone in the month's hue, with its facets: the piece itself. */
+export const HeartStone = ({ stone, size, className = "" }: { stone: Stone; size: number; className?: string }) => (
+  <svg viewBox="0 0 24 22" width={size} height={Math.round((size * 22) / 24)} className={className} aria-hidden>
+    <path d="M12 20.5C5 15 1.5 11 1.5 6.8C1.5 3.6 4 1.5 6.8 1.5C9 1.5 10.9 2.8 12 4.6C13.1 2.8 15 1.5 17.2 1.5C20 1.5 22.5 3.6 22.5 6.8C22.5 11 19 15 12 20.5Z" fill={stone.hue} stroke="var(--nf-accent-strong)" strokeWidth="1" />
+    <path d="M12 4.6V20.5M1.8 7.4H22.2M6.8 1.5L12 7.4L17.2 1.5M12 7.4L5 13.5M12 7.4L19 13.5" fill="none" stroke="#FFF8EE" strokeOpacity=".45" strokeWidth=".7" />
+  </svg>
+);
+
+/* The whole stone plant for the garden: a tall stem with two leaves and the head. */
+export const StonePlant = ({ stone }: { stone: Stone | null }) => (
+  <svg viewBox="-40 -170 80 170" className="ig-sway-art" aria-hidden>
+    <path d="M0 0C-3-40 6-80 0-122" fill="none" stroke={LEAF_SAGE} strokeWidth="2.2" strokeLinecap="round" />
+    <path d="M-1-38C-14-40-24-50-26-64C-12-60-4-52-1-38Z" fill={LEAF_SAGE} />
+    <path d="M2-70C14-72 22-82 24-96C11-92 4-84 2-70Z" fill={LEAF_SAGE} />
+    <StoneHead stone={stone} size={80} x={-40} y={-170} />
+  </svg>
+);
diff --git a/src/components/portal/StoneCard.test.tsx b/src/components/portal/StoneCard.test.tsx
