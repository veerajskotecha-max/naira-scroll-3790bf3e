+import { useRef } from "react";
+import { Link, useLocation } from "react-router-dom";
+import JoinInnerCircleForm from "@/components/members/JoinInnerCircleForm";
+import { WHATSAPP_NUMBER } from "@/data/jewellery";
+import PortalShell from "@/components/portal/PortalShell";
+import GateIronwork from "@/components/portal/GateIronwork";
+import GardenBed from "@/components/portal/GardenBed";
+import FlowerDraw from "@/components/portal/FlowerDraw";
+import { useTapBloom } from "@/components/portal/useTapBloom";
+import { primaryButton, quietButton, eyebrow } from "@/components/portal/styles";
+
+/*
+  The gate, for anyone not signed in, and (closed, with no sign-in prompt)
+  while sign-in is still being read, so a member never sees the signed-out
+  page flash before her garden. Plain promises only: nothing about prices,
+  codes or perks the shop has not made.
+*/
+
+const WHATSAPP = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
+  "Hello Naira Flore, I'd like to know about the Inner Garden, the members' side of the Inner Circle.",
+)}`;
+
+const PROMISES = [
+  "A first look at each new drop",
+  "Your stone and your size, kept for you",
+  "A pressed flower for every drop",
+];
+
+const Gate = ({ loading = false }: { loading?: boolean }) => {
+  const { pathname } = useLocation();
+  const sceneRef = useRef<HTMLDivElement>(null);
+  useTapBloom(sceneRef, !loading);
+  const next = encodeURIComponent(pathname.startsWith("/members") ? pathname : "/members");
+
+  return (
+    <PortalShell
+      title="The Inner Garden"
+      description="The Inner Garden: the members' side of Naira Flore's Inner Circle."
+      nav={false}
+    >
+      <section className="ig-gate-page">
+        <div ref={sceneRef} className="ig-gate-scene">
+          <GardenBed seed="naira-flore-gate" stone={null} still className="ig-bed--behind" />
+          <GateIronwork
+            tone="ivory"
+            label="A closed gold garden gate, the Naira flower at its latch"
+            latch={<FlowerDraw height={64} />}
+          />
+        </div>
+        <p className={eyebrow}>Naira Flore members</p>
+        <h1 className="ig-h1">
+          The Inner <em>Garden</em>
+        </h1>
+        {loading ? (
+          <p className="ig-lede" role="status">
+            Opening the gate…
+          </p>
+        ) : (
+          <>
+            <p className="ig-lede">The members' side of the Inner Circle: a garden of your own, grown from the day you join.</p>
+            <ul className="ig-promises">
+              {PROMISES.map((p) => (
+                <li key={p}>{p}</li>
+              ))}
+            </ul>
+            <Link to={`/auth?next=${next}`} className={primaryButton}>
+              Sign in or join
+            </Link>
+            <p className="ig-or">
+              <span>or keep in touch</span>
+            </p>
+            <div className="ig-join">
+              <JoinInnerCircleForm source="members-gate" withName={false} cta="Join the Inner Circle" />
+            </div>
+            <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" className={quietButton}>
+              Ask us on WhatsApp
+            </a>
+          </>
+        )}
+      </section>
+    </PortalShell>
+  );
+};
+
+export default Gate;
