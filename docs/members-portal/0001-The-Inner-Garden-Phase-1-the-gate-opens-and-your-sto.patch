+import { FLOWER_ASPECT, FLOWER_SHAPES } from "@/lib/nairaFlower/outline";
+
+/*
+  The Naira flower from the brand deck, split into its parts so the portal can
+  colour it as a living plant: the stem with its three leaves in sage, the four
+  petals in blush. Same tracing the header draws (nairaFlower/outline, already
+  in the main bundle), in its viewBox 0 0 0.6868 1, y down.
+*/
+
+const STEM = 1;
+
+const toPath = (pts: readonly number[]) => {
+  let d = "";
+  for (let i = 0; i < pts.length; i += 2) {
+    d += `${i ? "L" : "M"}${(pts[i] + FLOWER_ASPECT / 2).toFixed(4)} ${(0.5 - pts[i + 1]).toFixed(4)}`;
+  }
+  return `${d}Z`;
+};
+
+export const FLOWER_VIEWBOX = `0 0 ${FLOWER_ASPECT} 1`;
+
+export const FLOWER_STEM: string = toPath(FLOWER_SHAPES[STEM]);
+export const FLOWER_PETALS: readonly string[] = FLOWER_SHAPES.filter((_, i) => i !== STEM).map(toPath);
+
+/* Where the stem meets the soil, as a share of the box: the plant is
+   positioned so this point sits on the soil line. */
+const stemBase = (() => {
+  const pts = FLOWER_SHAPES[STEM];
+  let best = { x: 0.5, y: 0 };
+  for (let i = 0; i < pts.length; i += 2) {
+    const x = (pts[i] + FLOWER_ASPECT / 2) / FLOWER_ASPECT;
+    const y = 0.5 - pts[i + 1];
+    if (y > best.y) best = { x, y };
+  }
+  return best;
+})();
+
+export const FLOWER_BASE_X: number = stemBase.x;
+export { FLOWER_ASPECT };
+
+/* The deck flower's blush petals and a sage a shade deeper than the token,
+   so the leaves hold their shape on ivory. Flower colours only. */
+export const PETAL_BLUSH = "#F7AE98";
+export const LEAF_SAGE = "#8FAAA4";
