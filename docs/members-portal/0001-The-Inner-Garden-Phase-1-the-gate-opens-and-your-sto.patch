+++ b/src/pages/members/MembersRoute.tsx
@@ -0,0 +1,101 @@
+import { useCallback, useMemo, useState } from "react";
+import { Navigate, Route, Routes } from "react-router-dom";
+import { useAuth } from "@/contexts/AuthContext";
+import { useCart } from "@/contexts/CartContext";
+import { getSupabase } from "@/integrations/supabase/lazy";
+import { MemberProvider, firstNameOf, type BagLine, type Member, type SaveResult } from "@/components/portal/MemberContext";
+import { readPreviewMember, logPreviewWrite } from "@/lib/portal/preview";
+import Gate from "./Gate";
+import GardenHome from "./GardenHome";
+import Stone from "./Stone";
+import "./members.css";
+
+/*
+  /members/* — The Inner Garden. One lazy, noindexed route (Disallowed in
+  robots.txt, kept out of scripts/routes.ts and the sitemap, left out of the
+  shopper telemetry). While sign-in is still being read the gate stays closed,
+  never flashing the signed-out page at a member; signed out, the Gate; signed
+  in, her rooms.
+
+  In development only, ?portalPreview=1 stands in a member (see
+  lib/portal/preview.ts). The check sits behind import.meta.env.DEV, which a
+  production build replaces with false, so the preview is not in the build.
+*/
+
+const MembersRoute = () => {
+  const auth = useAuth();
+  const { addItem, setDrawerOpen } = useCart();
+  const [preview, setPreview] = useState(() => (import.meta.env.DEV ? readPreviewMember(window.location.search) : null));
+  const [doorsPlayed, setDoorsPlayed] = useState(false);
+  const markDoorsPlayed = useCallback(() => setDoorsPlayed(true), []);
+
+  const user = preview?.user ?? auth.user;
+  const profile = preview ? preview.profile : auth.profile;
+  const { refreshProfile } = auth;
+
+  const saveBirthday = useCallback(
+    async (birthday: string): Promise<SaveResult> => {
+      if (!user) return { ok: false, message: "Please sign in again." };
+      if (import.meta.env.DEV && preview) {
+        logPreviewWrite("profiles.birthday", { id: user.id, birthday });
+        setPreview({ ...preview, profile: { ...preview.profile, birthday } });
+        return { ok: true };
+      }
+      try {
+        const supabase = await getSupabase();
+        // Her own row, through the same row security Account's details form uses.
+        const { error } = await supabase.from("profiles").upsert({ id: user.id, birthday } as never);
+        if (error) return { ok: false, message: "We couldn't save your birthday. Please try again." };
+        await refreshProfile();
+        return { ok: true };
+      } catch {
+        return { ok: false, message: "We couldn't reach your account. Please try again." };
+      }
+    },
+    [user, preview, refreshProfile],
+  );
+
+  const addToBag = useCallback(
+    async (line: BagLine) => {
+      if (import.meta.env.DEV && preview) {
+        logPreviewWrite("bag line", line);
+        return;
+      }
+      setDrawerOpen(true);
+      await addItem(line);
+    },
+    [preview, addItem, setDrawerOpen],
+  );
+
+  const member = useMemo<Member | null>(
+    () =>
+      user
+        ? {
+            user,
+            profile,
+            firstName: firstNameOf(profile, user) || "friend",
+            preview: Boolean(preview),
+            saveBirthday,
+            addToBag,
+            doorsPlayed,
+            markDoorsPlayed,
+          }
+        : null,
+    [user, profile, preview, saveBirthday, addToBag, doorsPlayed, markDoorsPlayed],
+  );
+
+  if (!preview && auth.loading) return <Gate loading />;
+  if (!member) return <Gate />;
+
+  return (
+    <MemberProvider value={member}>
+      <Routes>
+        <Route index element={<GardenHome />} />
+        <Route path="stone" element={<Stone />} />
+        <Route path="*" element={<Navigate to="/members" replace />} />
+      </Routes>
+    </MemberProvider>
+  );
+};
+
+export default MembersRoute;
