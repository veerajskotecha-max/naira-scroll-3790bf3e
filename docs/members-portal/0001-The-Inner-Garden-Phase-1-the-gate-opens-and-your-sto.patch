+import type { ReactNode } from "react";
+import PageSEO from "@/components/PageSEO";
+import Footer from "@/components/Footer";
+import PetalSymbols from "./PetalSymbols";
+import { GardenSymbols } from "./GardenBed";
+import PortalNav from "./PortalNav";
+
+/*
+  Every portal screen: noindex (the route is also Disallowed in robots.txt and
+  kept out of the sitemap and the prerender), clear of the fixed header, the
+  garden path while signed in, and the slim compact footer, so the footer's
+  3D gift box never starts a second WebGL context here.
+*/
+
+type Props = { title: string; description: string; nav?: boolean; children: ReactNode };
+
+const PortalShell = ({ title, description, nav = true, children }: Props) => (
+  <>
+    <PageSEO title={title} description={description} canonical="https://nairaflore.com/members" noindex />
+    <div className="ig-root">
+      <svg className="ig-sprite" aria-hidden focusable="false">
+        <defs>
+          <PetalSymbols />
+          <GardenSymbols />
+        </defs>
+      </svg>
+      <main className="ig-main pt-[123px] md:pt-[144px]">{children}</main>
+      {nav && <PortalNav />}
+      <Footer compact slim />
+    </div>
+  </>
+);
+
+export default PortalShell;
diff --git a/src/components/portal/SeedCeremony.tsx b/src/components/portal/SeedCeremony.tsx
new file mode 100644
index 0000000..469e715
--- /dev/null
+++ b/src/components/portal/SeedCeremony.tsx
@@ -0,0 +1,148 @@
+import { useCallback, useEffect, useLayoutEffect, useRef } from "react";
+import type { Stone } from "@/lib/portal/stones";
+import { FLOWER_ASPECT, FLOWER_BASE_X } from "@/lib/portal/brandFlower";
+import { EASE_BLOOM, EASE_IN, play, stillMotion } from "@/lib/portal/motion";
+import FlowerDraw, { drawFlower } from "./FlowerDraw";
+import { StonePlant } from "./StoneArt";
+import { burstPetals } from "./PetalBurst";
+
+/*
+  The seed ceremony, on her first visit to Your stone: a seed falls onto the
+  gold soil line, the Naira flower draws itself from it, and beside it her
+  stone's bud grows and opens in her month's hue with a glint. Skip is always
+  there. After the first time (or under reduced motion) the stage is simply
+  drawn, and when she saves a birthday later the bud opens then, with a burst
+  of petals: a bloom for something she did.
+*/
+
+const W = 390;
+const H = 300;
+const SOIL = 252;
+const NAIRA = { x: 150, h: 200 };
+const STONE_X = 262;
+
+const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
+
+type Props = { stone: Stone | null; playing: boolean; onDone: () => void };
+
+const openHead = (root: HTMLElement | null, delay: number): Animation[] => {
+  if (!root) return [];
+  const out: (Animation | null)[] = [
+    play(root.querySelector(".ig-stone-outer"), [{ transform: "scale(0) rotate(-70deg)" }, { transform: "none" }], { duration: 720, delay, easing: EASE_BLOOM, fill: "backwards" }),
+    play(root.querySelector(".ig-stone-inner"), [{ transform: "scale(0) rotate(50deg)" }, { transform: "none" }], { duration: 640, delay: delay + 160, easing: EASE_BLOOM, fill: "backwards" }),
+    play(
+      root.querySelector(".ig-glint"),
+      [
+        { opacity: 0, transform: "scale(0) rotate(0deg)" },
+        { opacity: 1, transform: "scale(1.5) rotate(45deg)", offset: 0.5 },
+        { opacity: 1, transform: "scale(1) rotate(90deg)" },
+      ],
+      { duration: 640, delay: delay + 520, easing: "ease-out", fill: "backwards" },
+    ),
+  ];
+  return out.filter((a): a is Animation => Boolean(a));
+};
+
+const SeedCeremony = ({ stone, playing, onDone }: Props) => {
+  const rootRef = useRef<HTMLDivElement>(null);
+  const seedRef = useRef<HTMLDivElement>(null);
+  const nairaRef = useRef<HTMLDivElement>(null);
+  const stoneRef = useRef<HTMLDivElement>(null);
+  const anims = useRef<Animation[]>([]);
+  const timer = useRef(0);
+  const ended = useRef(!playing);
+  const hadStone = useRef(Boolean(stone));
+
+  const end = useCallback(() => {
+    if (ended.current) return;
+    ended.current = true;
+    window.clearTimeout(timer.current);
+    anims.current.forEach((a) => {
+      try {
+        a.finish();
+      } catch {
+        a.cancel();
+      }
+    });
+    onDone();
+  }, [onDone]);
+
+  useLayoutEffect(() => {
+    if (!playing) return;
+    const list = anims.current;
+    const keep = (a: Animation | null) => a && list.push(a);
+    const root = rootRef.current;
+    keep(play(root?.querySelector(".ig-seed-soil"), [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 520, easing: "ease-out", fill: "backwards" }));
+    keep(
+      play(
+        seedRef.current,
+        [
+          { transform: "translateY(-210px)", opacity: 0, easing: "cubic-bezier(.5,0,.9,.4)" },
+          { opacity: 1, offset: 0.12 },
+          { transform: "translateY(0)", offset: 0.7, easing: "ease-out" },
+          { transform: "translateY(-8px)", offset: 0.82, easing: EASE_IN },
+          { transform: "translateY(0)", opacity: 1, offset: 0.92 },
+          { transform: "translateY(4px) scale(.4)", opacity: 0 },
+        ],
+        { duration: 1250, delay: 150, fill: "both" },
+      ),
+    );
+    list.push(...drawFlower(nairaRef.current, { delay: 1150, duration: 900 }));
+    keep(play(stoneRef.current, [{ transform: "scale(.2, 0)", opacity: 0 }, { transform: "none", opacity: 1 }], { duration: 620, delay: 1800, easing: EASE_BLOOM, fill: "backwards" }));
+    if (stone) list.push(...openHead(stoneRef.current, 2300));
+    timer.current = window.setTimeout(end, stone ? 3500 : 2500);
+    return () => window.clearTimeout(timer.current);
+    // Played once, as mounted.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  // Her birthday saved after the ceremony: the bud opens now.
+  useEffect(() => {
+    if (!stone || hadStone.current) return;
+    hadStone.current = true;
+    if (stillMotion()) return;
+    openHead(stoneRef.current, 80);
+    const box = stoneRef.current?.getBoundingClientRect();
+    const rootBox = rootRef.current?.getBoundingClientRect();
+    if (box && rootBox) burstPetals(rootRef.current, box.left - rootBox.left + box.width / 2, box.top - rootBox.top + box.height * 0.22, { count: 16, spread: 90, delay: 300 });
+  }, [stone]);
+
+  const nairaW = NAIRA.h * FLOWER_ASPECT;
+  return (
+    <div ref={rootRef} className="ig-seed">
+      <svg viewBox={`0 0 ${W} ${H}`} className="ig-seed-ground" aria-hidden>
+        <path className="ig-seed-soil" d={`M36 ${SOIL}H${W - 36}`} pathLength={1} strokeDasharray="1 1" />
+      </svg>
+      <div
+        className="ig-seed-naira"
+        ref={nairaRef}
+        style={{ left: pct(NAIRA.x - nairaW * FLOWER_BASE_X, W), top: pct(SOIL - NAIRA.h, H), width: pct(nairaW, W), height: pct(NAIRA.h, H) }}
+        aria-hidden
+      >
+        <FlowerDraw height={NAIRA.h} />
+      </div>
+      {playing && (
+        <div ref={seedRef} className="ig-seed-drop" style={{ left: pct(NAIRA.x - 6, W), top: pct(SOIL - 17, H) }} aria-hidden>
+          <svg viewBox="0 0 12 17">
+            <path d="M6 0C10 5 12 9 12 11.5A6 6 0 0 1 0 11.5C0 9 2 5 6 0Z" fill="var(--nf-accent-strong)" />
+          </svg>
+        </div>
+      )}
+      <div
+        ref={stoneRef}
+        className="ig-seed-stone"
+        style={{ left: pct(STONE_X - 40, W), top: pct(SOIL - 170, H), width: pct(80, W), height: pct(170, H) }}
+        aria-hidden
+      >
+        <StonePlant stone={stone} />
+      </div>
+      {playing && (
+        <button type="button" className="ig-skip" onClick={end}>
+          Skip
+        </button>
+      )}
+    </div>
+  );
+};
+
+export default SeedCeremony;
diff --git a/src/components/portal/Sprig.tsx b/src/components/portal/Sprig.tsx
new file mode 100644
index 0000000..b1047fc
--- /dev/null
+++ b/src/components/portal/Sprig.tsx
@@ -0,0 +1,29 @@
+/*
+  The gold botanical corner from the Account panels, lifted here with token
+  colours (Account keeps its own copy, so its chunk is untouched). Stroke only:
+  it frames cards, draws the ribbons on the gate and can draw itself in with
+  stroke-dashoffset, since every stroke carries pathLength=1.
+*/
+
+const Sprig = ({ className = "", draw = false }: { className?: string; draw?: boolean }) => (
+  <svg viewBox="0 0 120 120" className={`${className}${draw ? " ig-draw" : ""}`} fill="none" aria-hidden>
+    <path d="M14 108C34 84 54 64 96 24" stroke="var(--nf-accent)" strokeOpacity=".55" strokeWidth="1.1" pathLength={1} />
+    {[0, 1, 2, 3, 4].map((i) => (
+      <ellipse
+        key={i}
+        cx={26 + i * 16}
+        cy={96 - i * 16}
+        rx="11"
+        ry="5.5"
+        transform={`rotate(${-45 + (i % 2 ? 26 : -26)} ${26 + i * 16} ${96 - i * 16})`}
+        stroke="var(--nf-accent)"
+        strokeOpacity=".45"
+        strokeWidth="1"
+        pathLength={1}
+      />
+    ))}
+    <circle cx="96" cy="24" r="4.5" fill="var(--nf-accent)" fillOpacity=".35" />
+  </svg>
+);
+
+export default Sprig;
