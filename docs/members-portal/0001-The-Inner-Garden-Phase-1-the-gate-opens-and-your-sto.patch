@@ -0,0 +1,112 @@
+import { useEffect, type RefObject } from "react";
+import { SPECIES, petalTransform, type Species } from "@/lib/portal/species";
+import { play, stillMotion } from "@/lib/portal/motion";
+
+/*
+  Every tap blooms. The shop's tap-to-bloom (RingAtelierBackdrop) listens on
+  window, so two on a page both answered every tap; this one listens only on
+  the element it is given (the garden bed, the gate), and only there does a
+  flower open. Six species, never the same twice running, at most five alive,
+  each removed when it has opened and faded. A 10 ms tick on phones that can.
+  Nothing under reduced motion.
+*/
+
+export const MAX_BLOOMS = 5;
+const SVG = "http://www.w3.org/2000/svg";
+
+const el = (name: string, attrs: Record<string, string | number>) => {
+  const node = document.createElementNS(SVG, name);
+  for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
+  return node;
+};
+
+const whorl = (species: Species, r: number, offset: number, palette: readonly string[]) => {
+  const g = el("g", {});
+  for (let i = 0; i < species.petals; i++) {
+    const deg = offset + (i * 360) / species.petals;
+    g.appendChild(el("path", { d: species.d, fill: palette[i % palette.length], transform: petalTransform(deg, r) }));
+  }
+  return g;
+};
+
+const bloomNode = (species: Species, x: number, y: number, tilt: number, scale: number) => {
+  const node = document.createElement("div");
+  node.className = "ig-bloom";
+  node.setAttribute("aria-hidden", "true");
+  node.style.cssText = `left:${x}px;top:${y}px`;
+  const svg = el("svg", { viewBox: "-50 -50 100 100", width: Math.round(86 * scale), height: Math.round(86 * scale) });
+  const outer = whorl(species, 40, tilt, species.palette);
+  svg.appendChild(outer);
+  if (species.inner) {
+    const inner = whorl(species, 40 * species.inner, tilt + 180 / species.petals, [...species.palette].reverse());
+    inner.setAttribute("class", "in");
+    svg.appendChild(inner);
+  }
+  svg.appendChild(el("circle", { r: 6.5, fill: species.core }));
+  svg.appendChild(el("circle", { r: 2.4, cx: -1.6, cy: -1.6, fill: "#FFF8EE" }));
+  node.appendChild(svg);
+  return node;
+};
+
+export const useTapBloom = (rootRef: RefObject<HTMLElement>, enabled = true) => {
+  useEffect(() => {
+    const root = rootRef.current;
+    if (!root || !enabled || stillMotion()) return;
+    const alive: HTMLElement[] = [];
+    let last = -1;
+
+    const onDown = (e: PointerEvent) => {
+      if (e.button > 0) return;
+      if ((e.target as Element | null)?.closest?.("a,button,input,select,textarea,label")) return;
+      const box = root.getBoundingClientRect();
+      const x = e.clientX - box.left;
+      const y = e.clientY - box.top;
+      let idx = Math.floor(Math.random() * SPECIES.length);
+      if (idx === last) idx = (idx + 1 + Math.floor(Math.random() * (SPECIES.length - 1))) % SPECIES.length;
+      last = idx;
+      const species = SPECIES[idx];
+      const node = bloomNode(species, x, y, Math.random() * 360, 0.82 + Math.random() * 0.36);
+      root.appendChild(node);
+      alive.push(node);
+      while (alive.length > MAX_BLOOMS) alive.shift()?.remove();
+
+      const dur = species.dur * 1000;
+      const a = play(
+        node,
+        [
+          { transform: "translate(-50%,-50%) scale(.15) rotate(-50deg)", opacity: 0 },
+          { transform: "translate(-50%,-50%) scale(1.04) rotate(0deg)", opacity: 1, offset: 0.36 },
+          { transform: "translate(-50%,-50%) scale(1) rotate(5deg)", opacity: 1, offset: 0.72 },
+          { transform: "translate(-50%,-50%) scale(1.08) rotate(9deg)", opacity: 0 },
+        ],
+        { duration: dur, easing: "cubic-bezier(0.22, 1, 0.36, 1)", fill: "both" },
+      );
+      play(node.querySelector(".in"), [{ transform: "rotate(-30deg) scale(.6)" }, { transform: "rotate(0deg) scale(1)" }], {
+        duration: dur * 0.5,
+        easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
+      });
+      const done = () => {
+        node.remove();
+        const i = alive.indexOf(node);
+        if (i >= 0) alive.splice(i, 1);
+      };
+      if (a) {
+        a.onfinish = done;
+        a.oncancel = done;
+      } else {
+        window.setTimeout(done, dur);
+      }
+      try {
+        navigator.vibrate?.(10);
+      } catch {
+        /* not allowed here: no tick */
+      }
+    };
+
+    root.addEventListener("pointerdown", onDown);
+    return () => {
+      root.removeEventListener("pointerdown", onDown);
+      alive.forEach((n) => n.remove());
+    };
+  }, [rootRef, enabled]);
+};
