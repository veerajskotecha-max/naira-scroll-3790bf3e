+import { describe, expect, it } from "vitest";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { BIRTHSTONE_HANDLE, MONTH_OPTION, STONES, isPlausibleBirthday, monthOfBirthday, stoneForBirthday, variantForMonth } from "./stones";
+
+/* The specimen card opens the Birthstone Heart Necklace on her month. If our
+   twelve names drifted from the listing's ("June · Light Amethyst", not
+   "June · Alexandrite"), the card would open on no variant, or the wrong one,
+   and Add to bag would carry a stone she did not choose. */
+const necklace = jewellerySnapshot.find((p) => p.handle === BIRTHSTONE_HANDLE)!;
+
+describe("her stone, as the shop sells it", () => {
+  it("finds the necklace and its twelve Month variants in the shop's data", () => {
+    expect(necklace).toBeTruthy();
+    expect(necklace.options?.find((o) => o.name === MONTH_OPTION)?.values).toHaveLength(12);
+  });
+
+  it.each(STONES.map((s) => [s.month, s.variant]))("month %i preselects the listing's own variant, %s", (month, name) => {
+    const variant = variantForMonth(necklace, month);
+    expect(variant?.options[MONTH_OPTION]).toBe(name);
+    // Exactly the snapshot's value for that month, in the listing's order.
+    expect(necklace.options!.find((o) => o.name === MONTH_OPTION)!.values[month - 1]).toBe(name);
+  });
+
+  it("keeps the shop's own name if a stone is renamed", () => {
+    const renamed = {
+      ...necklace,
+      variants: necklace.variants!.map((v) =>
+        v.options[MONTH_OPTION] === "July · Ruby" ? { ...v, options: { [MONTH_OPTION]: "July · Crimson" } } : v,
+      ),
+    };
+    expect(variantForMonth(renamed, 7)?.options[MONTH_OPTION]).toBe("July · Crimson");
+  });
+
+  it("reads the month from the birthday text itself, never through a time zone", () => {
+    expect(monthOfBirthday("1999-07-14")).toBe(7);
+    expect(monthOfBirthday("2001-01-01")).toBe(1);
+    expect(monthOfBirthday("2001-12-31")).toBe(12);
+    expect(monthOfBirthday(null)).toBeNull();
+    expect(monthOfBirthday("14/07/1999")).toBeNull();
+    expect(stoneForBirthday("1999-10-03")?.variant).toBe("October · Rose");
+  });
+
+  it("accepts only real, past birthdays", () => {
+    const today = new Date("2026-11-05T00:00:00Z");
+    expect(isPlausibleBirthday("1999-07-14", today)).toBe(true);
+    expect(isPlausibleBirthday("1999-02-30", today)).toBe(false);
+    expect(isPlausibleBirthday("2027-01-01", today)).toBe(false);
+    expect(isPlausibleBirthday("1850-01-01", today)).toBe(false);
+  });
+
+  it("never names a stone as a real gemstone on its own: each name is the listing's month pairing", () => {
+    for (const s of STONES) expect(s.variant.startsWith(`${s.monthName} · `)).toBe(true);
+  });
+});
