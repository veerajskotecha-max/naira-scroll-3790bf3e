+++ b/src/pages/members/GardenHome.tsx
@@ -0,0 +1,120 @@
+import { useCallback, useEffect, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import GardenBed, { type GardenBedHandle } from "@/components/portal/GardenBed";
+import DoorsOpen, { type DoorsMode } from "@/components/portal/DoorsOpen";
+import { StoneHead } from "@/components/portal/StoneArt";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow } from "@/components/portal/styles";
+import { formatIstDate, greetingFor } from "@/lib/portal/ist";
+import { stoneForBirthday } from "@/lib/portal/stones";
+import { pickDoors, recordFullDoors } from "@/lib/portal/doors";
+import { EASE_REVEAL, play } from "@/lib/portal/motion";
+
+/*
+  Her garden: the greeting in Indian time, her own seeded bed with the Naira
+  flower planted the day she joined and her stone flower beside it, one honest
+  card for today, and "What's growing", which is also the garden in words for
+  a screen reader (the drawing itself is decorative).
+*/
+
+const GardenHome = () => {
+  const member = useMember();
+  const { user, profile, firstName, doorsPlayed, markDoorsPlayed } = member;
+  const stone = stoneForBirthday(profile?.birthday);
+  const plantedOn = formatIstDate(user.created_at);
+  const [greeting] = useState(() => greetingFor(new Date()));
+  const [doors, setDoors] = useState<DoorsMode | null>(() => pickDoors(doorsPlayed));
+  const bedRef = useRef<GardenBedHandle>(null);
+  const headRef = useRef<HTMLDivElement>(null);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+
+  useEffect(() => {
+    markDoorsPlayed();
+    if (doors === "full") recordFullDoors();
+    // Arriving with no entrance to watch (reduced motion, or back from another
+    // room), the heading takes focus at once, as a new page's should.
+    if (!doors) h1Ref.current?.focus({ preventScroll: true });
+    // On arrival only.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const reveal = useCallback((short: boolean) => {
+    bedRef.current?.bloomIn(short);
+    play(headRef.current, [{ opacity: 0, transform: "translateY(12px)" }, { opacity: 1, transform: "none" }], {
+      duration: short ? 300 : 600,
+      delay: short ? 0 : 80,
+      easing: EASE_REVEAL,
+      fill: "backwards",
+    });
+  }, []);
+
+  const done = useCallback(() => {
+    setDoors(null);
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  return (
+    <PortalShell title="Your garden" description="Your garden in the Inner Garden, Naira Flore's members' portal.">
+      {doors && <DoorsOpen mode={doors} name={firstName} greeting={greeting} onReveal={reveal} onDone={done} />}
+      <div className="ig-home">
+        <div ref={headRef} className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          {/* Her name stays out of session recordings (Clarity masks marked content). */}
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1 ig-h1--greet" data-clarity-mask="true">
+            {greeting}, <em>{firstName}</em>
+          </h1>
+          <p className="ig-lede">Grown from your own seed. Tap it, and it blooms.</p>
+        </div>
+
+        <div className="ig-bed-wrap">
+          <GardenBed ref={bedRef} seed={user.id} stone={stone} plantedOn={plantedOn} stoneLabel={stone ? stone.variant : "Waiting"} />
+        </div>
+
+        <section className="ig-section" aria-labelledby="ig-today">
+          <h2 id="ig-today" className="ig-h2">
+            Today in the garden
+          </h2>
+          <Link to="/members/stone" className="ig-card-link">
+            <StoneHead stone={stone} size={56} />
+            <span className="ig-card-text">
+              <span className={eyebrow}>{stone ? `${stone.monthName}'s stone` : "Your stone"}</span>
+              <span className="ig-card-title">{stone ? stone.variant : "Waiting for your birthday"}</span>
+              <span className="ig-card-more">{stone ? "See it in your month's colour" : "Tell us your month"} →</span>
+            </span>
+          </Link>
+        </section>
+
+        <section className="ig-section" aria-labelledby="ig-growing">
+          <h2 id="ig-growing" className="ig-h2">
+            What's growing
+          </h2>
+          <ul className="ig-growing">
+            <li>
+              <strong>The Naira flower</strong>
+              {plantedOn ? `, planted ${plantedOn}, the day you joined.` : ", planted the day you joined."}
+            </li>
+            <li>
+              {stone ? (
+                <>
+                  <strong>Your stone flower</strong>, {stone.variant}, in your month's colour.
+                </>
+              ) : (
+                <>
+                  <strong>A bud for your stone</strong>, waiting for your birthday.
+                </>
+              )}
+            </li>
+            <li>
+              <strong>Grasses, sprigs, buds and blooms</strong> grown from your own seed: the same garden on every visit, and
+              yours alone.
+            </li>
+          </ul>
+          <p className="ig-fineprint">Your garden is for joy. Nothing in it is points, and nothing in it can be redeemed.</p>
+        </section>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default GardenHome;
