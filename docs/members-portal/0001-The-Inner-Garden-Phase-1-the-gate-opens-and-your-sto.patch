@@ -0,0 +1,51 @@
+import { createContext, useContext, type ReactNode } from "react";
+import type { User } from "@supabase/supabase-js";
+import type { MemberProfile } from "@/contexts/AuthContext";
+import type { CartItem } from "@/contexts/CartContext";
+
+/*
+  The signed-in member as the portal's screens see her, with the only two
+  writes Phase 1 makes: her birthday (profiles.birthday, her own row, under
+  the existing row security) and a bag line (the shared CartContext, so the
+  bag itself is untouched). MembersRoute supplies the real ones, or the
+  development preview's console-only stand-ins.
+*/
+
+export type SaveResult = { ok: true } | { ok: false; message: string };
+export type BagLine = Omit<CartItem, "quantity" | "lineId">;
+
+export type Member = {
+  user: User;
+  profile: MemberProfile | null;
+  firstName: string;
+  preview: boolean;
+  saveBirthday: (birthday: string) => Promise<SaveResult>;
+  addToBag: (line: BagLine) => Promise<void>;
+  /** The Doors play once per portal visit, however often she returns to the garden. */
+  doorsPlayed: boolean;
+  markDoorsPlayed: () => void;
+};
+
+const MemberContext = createContext<Member | null>(null);
+
+export const MemberProvider = ({ value, children }: { value: Member; children: ReactNode }) => (
+  <MemberContext.Provider value={value}>{children}</MemberContext.Provider>
+);
+
+// eslint-disable-next-line react-refresh/only-export-components -- the hook lives beside its provider
+export const useMember = (): Member => {
+  const member = useContext(MemberContext);
+  if (!member) throw new Error("useMember must be used inside the members portal");
+  return member;
+};
+
+const capitalise = (word: string) => (word ? word[0].toUpperCase() + word.slice(1) : word);
+
+/** Her first name: the profile's, then the sign-in's, then her email's (ananya.r@… → Ananya). */
+// eslint-disable-next-line react-refresh/only-export-components -- shared by the route and its tests
+export const firstNameOf = (profile: MemberProfile | null, user: User | null): string => {
+  const named = profile?.full_name || (user?.user_metadata?.full_name as string | undefined) || "";
+  if (named.trim()) return named.trim().split(/\s+/)[0].slice(0, 40);
+  const local = (user?.email ?? "").split("@")[0].split(/[._\d+-]+/).filter(Boolean)[0] ?? "";
+  return capitalise(local.slice(0, 40));
+};
