index 0000000..aea3cf6
--- /dev/null
+++ b/src/lib/portal/stones.ts
@@ -0,0 +1,93 @@
+import type { JewelPiece, JewelVariant } from "@/data/jewellery";
+
+/*
+  Her stone, as the shop sells it. The Birthstone Heart Necklace's "Month"
+  option names each variant "January · Garnet" … "December · Blue Zircon";
+  `variant` below must equal those names exactly (stones.test reads the
+  snapshot), so the card opens on the variant she can actually buy. The
+  stones are cubic zirconia in each month's colour, so the portal says "in
+  your month's colour" and never calls them garnets or rubies on their own.
+
+  `hue` is sampled from each variant's own photo and drawn only inside
+  flowers and petals, never on buttons or text. `flower` is the traditional
+  birth flower for the month.
+*/
+
+export const BIRTHSTONE_HANDLE = "birthstone-heart-necklace";
+export const MONTH_OPTION = "Month";
+
+export type Stone = {
+  month: number;
+  monthName: string;
+  stone: string;
+  variant: string;
+  hue: string;
+  /** A lighter tint of the hue for inner petals. */
+  tint: string;
+  flower: string;
+};
+
+const row = (month: number, monthName: string, stone: string, hue: string, tint: string, flower: string): Stone => ({
+  month,
+  monthName,
+  stone,
+  variant: `${monthName} · ${stone}`,
+  hue,
+  tint,
+  flower,
+});
+
+export const STONES: readonly Stone[] = [
+  row(1, "January", "Garnet", "#8C1C2C", "#C7707A", "Carnation"),
+  row(2, "February", "Amethyst", "#8A5DB5", "#C4A8DE", "Violet"),
+  row(3, "March", "Aquamarine", "#7DBBD0", "#C3E2EC", "Daffodil"),
+  row(4, "April", "Crystal", "#DCE5EB", "#F6F9FB", "Daisy"),
+  row(5, "May", "Emerald", "#1F8A55", "#8CC9A8", "Lily of the valley"),
+  row(6, "June", "Light Amethyst", "#C9AEDD", "#E9DCF2", "Rose"),
+  row(7, "July", "Ruby", "#C20E3A", "#EC8AA0", "Larkspur"),
+  row(8, "August", "Peridot", "#8DB52A", "#CBE08C", "Gladiolus"),
+  row(9, "September", "Sapphire", "#23509E", "#8EA9DA", "Aster"),
+  row(10, "October", "Rose", "#EE9FBA", "#F9D6E2", "Marigold"),
+  row(11, "November", "Topaz", "#E0950F", "#F3CC83", "Chrysanthemum"),
+  row(12, "December", "Blue Zircon", "#1C9FBC", "#90D3E2", "Narcissus"),
+];
+
+/** 1–12 from a profiles.birthday DATE ("1999-07-14"), or null. Read from the
+    string itself: parsing it as a Date would shift it a day in some zones. */
+export const monthOfBirthday = (birthday: string | null | undefined): number | null => {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(birthday ?? "");
+  if (!m) return null;
+  const month = Number(m[2]);
+  return month >= 1 && month <= 12 ? month : null;
+};
+
+export const stoneForMonth = (month: number | null | undefined): Stone | null =>
+  month && month >= 1 && month <= 12 ? STONES[month - 1] : null;
+
+export const stoneForBirthday = (birthday: string | null | undefined): Stone | null =>
+  stoneForMonth(monthOfBirthday(birthday));
+
+/**
+ * The live variant for a month. Exact name first; if the shop ever renames a
+ * stone, the variant whose name still starts with the month, so the card shows
+ * the listing's own (new) name rather than ours.
+ */
+export const variantForMonth = (piece: JewelPiece | undefined, month: number): JewelVariant | undefined => {
+  const stone = stoneForMonth(month);
+  if (!piece?.variants || !stone) return undefined;
+  const nameOf = (v: JewelVariant) => v.options[MONTH_OPTION] ?? v.title;
+  return (
+    piece.variants.find((v) => nameOf(v) === stone.variant) ??
+    piece.variants.find((v) => nameOf(v).toLowerCase().startsWith(stone.monthName.toLowerCase()))
+  );
+};
+
+/** A valid birthday a member could have: a real date, not in the future, after 1900. */
+export const isPlausibleBirthday = (value: string, today: Date = new Date()): boolean => {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+  if (!m) return false;
+  const [y, mo, d] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  const at = new Date(Date.UTC(y, mo - 1, d));
+  if (at.getUTCFullYear() !== y || at.getUTCMonth() !== mo - 1 || at.getUTCDate() !== d) return false;
+  return y >= 1900 && at.getTime() <= today.getTime();
+};
