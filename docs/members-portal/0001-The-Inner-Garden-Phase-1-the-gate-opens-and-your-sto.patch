+
+/*
+  Her garden bed. Every plant is its own small layer placed over a 390 x 560
+  view, so the sway (at most 24 of them, ±2.5° about the stem base) and the
+  bloom-in move only transform and opacity on the compositor; the soil and
+  everything still is painted once. The sway stops off screen, on a hidden
+  tab and after 20 s without a touch, and never starts under reduced motion.
+*/
+
+const STEM_HEAD: Record<0 | 1 | 2, [number, number]> = { 0: [0, -88], 1: [-8, -88], 2: [8, -88] };
+const BUD_TONES = ["#FFBDA8", "#F3D9C6", "#E5B9A4", "#FFE0D3"];
+const ROW_SHADE = [0.62, 0.84, 1];
+
+/* The bed's shapes, stamped by every plant. */
+export const GardenSymbols = () => (
+  <>
+    <symbol id="ig-stem-0" viewBox="-30 -112 60 112">
+      <path d="M0 0C-2-28 3-56 0-84" fill="none" stroke={LEAF_SAGE} strokeWidth="1.6" />
+      <ellipse cx="-8" cy="-30" rx="9" ry="3.4" transform="rotate(-32 -8 -30)" fill={LEAF_SAGE} />
+      <ellipse cx="8" cy="-52" rx="8" ry="3.1" transform="rotate(34 8 -52)" fill={LEAF_SAGE} />
+    </symbol>
+    <symbol id="ig-stem-1" viewBox="-30 -112 60 112">
+      <path d="M0 0C2-30-10-58-8-84" fill="none" stroke={LEAF_SAGE} strokeWidth="1.6" />
+      <ellipse cx="6" cy="-28" rx="9" ry="3.4" transform="rotate(30 6 -28)" fill={LEAF_SAGE} />
+      <ellipse cx="-12" cy="-52" rx="8" ry="3.1" transform="rotate(-30 -12 -52)" fill={LEAF_SAGE} />
+    </symbol>
+    <symbol id="ig-stem-2" viewBox="-30 -112 60 112">
+      <path d="M0 0C-2-30 10-58 8-84" fill="none" stroke={LEAF_SAGE} strokeWidth="1.6" />
+      <ellipse cx="-6" cy="-28" rx="9" ry="3.4" transform="rotate(-30 -6 -28)" fill={LEAF_SAGE} />
+      <ellipse cx="12" cy="-52" rx="8" ry="3.1" transform="rotate(30 12 -52)" fill={LEAF_SAGE} />
+    </symbol>
+    {SPECIES.map((s, k) => (
+      <symbol key={s.name} id={`ig-head-${k}`} viewBox="-50 -50 100 100">
+        {Array.from({ length: s.petals }, (_, i) => (
+          <path key={i} d={s.d} transform={petalTransform((i * 360) / s.petals, 46)} fill="currentColor" />
+        ))}
+        {s.inner > 0 &&
+          Array.from({ length: s.petals }, (_, i) => (
+            <path key={`i${i}`} d={s.d} transform={petalTransform(180 / s.petals + (i * 360) / s.petals, 46 * s.inner)} fill="#FFF8EE" opacity=".45" />
+          ))}
+        <circle r="8" fill={s.core} />
+        <circle r="3" cx="-2" cy="-2" fill="#FFF8EE" />
+      </symbol>
+    ))}
+    <symbol id="ig-bud" viewBox="-30 -112 60 112">
+      <use href="#ig-stem-0" x="-30" y="-112" width="60" height="112" />
+      <path d="M0-104C7-95 8-88 0-81C-8-88-7-95 0-104Z" fill="currentColor" />
+      <path d="M0-81C-5-84-8-90-7-95M0-81C5-84 8-90 7-95" fill="none" stroke={LEAF_SAGE} strokeWidth="1.4" />
+    </symbol>
+    <symbol id="ig-sprig" viewBox="-30 -112 60 112">
+      <path d="M0 0C-4-30 6-60 2-96" fill="none" stroke={LEAF_SAGE} strokeWidth="1.4" />
+      {[0, 1, 2, 3, 4, 5].map((i) => {
+        const y = -16 - i * 14;
+        const x = (i % 2 ? 7 : -7) + (i > 2 ? 2 : 0);
+        return <ellipse key={i} cx={x} cy={y} rx="7.5" ry="3" transform={`rotate(${i % 2 ? 34 : -34} ${x} ${y})`} fill={LEAF_SAGE} opacity=".8" />;
+      })}
+      <circle cx="2" cy="-98" r="2.4" fill="var(--nf-accent)" />
+    </symbol>
+    <symbol id="ig-grass" viewBox="-30 -112 60 112">
+      <path d="M0 0C-1-20-6-34-12-46M0 0C1-24 2-40 1-58M0 0C2-18 7-30 13-40" fill="none" stroke="var(--nf-accent)" strokeWidth="1" opacity=".85" />
+    </symbol>
+    <symbol id="ig-breath" viewBox="-30 -112 60 112">
+      <path d="M0 0C0-30-2-50-10-70M0-30C4-46 10-58 14-66M-2-48C-6-58-2-66 2-80" fill="none" stroke="var(--nf-accent)" strokeWidth=".9" />
+      {[[-10, -71], [14, -67], [2, -81], [-6, -58], [8, -54], [-3, -40], [11, -74]].map(([x, y], i) => (
+        <circle key={i} cx={x} cy={y} r={i % 3 ? 2.1 : 2.6} fill={i % 2 ? "#FFF6EA" : "#FFD6C6"} />
+      ))}
+    </symbol>
+    <symbol id="ig-leaves" viewBox="-30 -112 60 112">
+      <path d="M0 0C-14-10-22-30-18-52C-6-40-2-20 0 0Z" fill={LEAF_SAGE} />
+      <path d="M0 0C10-8 18-24 16-42C6-32 2-16 0 0Z" fill={LEAF_SAGE} opacity=".85" />
+      <path d="M0 0C-8-16-12-30-17-48M0 0C6-14 10-26 15-39" fill="none" stroke="#7E9893" strokeWidth=".6" />
+    </symbol>
+  </>
+);
+
+/* The arbour over her bed: the gate's arch, opened out, with a vine climbing
+   each post and wisteria-like drops hanging from the top. Drawn once. */
+const ARBOUR_OUTER = `M22 ${BED.soil}V214C22 132 104 78 195 78C286 78 368 132 368 214V${BED.soil}`;
+const ARBOUR_INNER = `M30 ${BED.soil}V216C30 140 108 88 195 88C282 88 360 140 360 216V${BED.soil}`;
+const VINE_L: Seg[] = [
+  [26, 520, 42, 470, 12, 430, 28, 388],
+  [28, 388, 44, 346, 14, 306, 30, 266],
+  [30, 266, 44, 228, 24, 194, 46, 160],
+  [46, 160, 66, 128, 92, 106, 124, 94],
+];
+const VINE_R = mirrorSegs(VINE_L, BED.w);
+const LEAF_TS = [0.05, 0.12, 0.19, 0.26, 0.33, 0.4, 0.47, 0.54, 0.61, 0.68, 0.76, 0.84, 0.92];
+const VINES = [VINE_L, VINE_R].map((segs) => ({
+  d: chainPath(segs),
+  leaves: leavesAlong(segs, LEAF_TS, 6, 50),
+  buds: [0.3, 0.58, 0.88, 0.99].map((t) => pointOn(segs, t)),
+}));
+const DROPS = [
+  { x: 112, y: 104, n: 4 },
+  { x: 150, y: 92, n: 3 },
+  { x: 240, y: 92, n: 3 },
+  { x: 278, y: 104, n: 4 },
+];
+
+const Arbour = () => (
+  <g className="ig-arbour">
+    <path className="ig-arbour-line" d={ARBOUR_OUTER} pathLength={1} strokeDasharray="1 1" />
+    <path className="ig-arbour-line ig-arbour-line--fine" d={ARBOUR_INNER} pathLength={1} strokeDasharray="1 1" />
+    {[250, 290, 330, 370, 410, 450, 490].map((y) => (
+      <path key={y} className="ig-arbour-tick" d={`M22 ${y}H30M360 ${y}H368`} />
+    ))}
+    {VINES.map((v, i) => (
+      <g key={i}>
+        <path d={v.d} fill="none" stroke={LEAF_SAGE} strokeWidth="1.1" />
+        {v.leaves.map((l, j) => (
+          <ellipse key={j} cx={l.x.toFixed(1)} cy={l.y.toFixed(1)} rx="6.2" ry="2.6" transform={`rotate(${l.a.toFixed(1)} ${l.x.toFixed(1)} ${l.y.toFixed(1)})`} fill={LEAF_SAGE} opacity=".85" />
+        ))}
+        {v.buds.map(([x, y], j) => (
+          <circle key={j} cx={x.toFixed(1)} cy={y.toFixed(1)} r={j === 3 ? 3.2 : 2.5} fill={j % 2 ? "#FFF6EA" : "var(--nf-blush)"} stroke="var(--nf-accent)" strokeWidth=".6" />
+        ))}
+      </g>
+    ))}
+    {DROPS.map((d) => (
+      <g key={d.x}>
+        <path d={`M${d.x} ${d.y - 6}V${d.y + (d.n - 1) * 9}`} stroke="var(--nf-accent)" strokeWidth=".6" opacity=".7" />
+        {Array.from({ length: d.n }, (_, k) => (
+          <circle key={k} cx={d.x} cy={d.y + k * 9} r={3.4 - k * 0.55} fill={k % 2 ? "#F3D9C6" : "#FFBDA8"} />
+        ))}
+      </g>
+    ))}
+    <g transform="translate(195 78)">
+      {[0, 72, 144, 216, 288].map((a) => (
+        <ellipse key={a} cx="0" cy="-6" rx="3.4" ry="5.6" transform={`rotate(${a})`} fill="var(--nf-blush)" stroke="var(--nf-accent)" strokeWidth=".6" />
+      ))}
+      <circle r="2.6" fill="var(--nf-accent)" />
+    </g>
+  </g>
+);
+
+const art = (p: Plant) => {
+  const flip = p.flip ? "scale(-1 1)" : undefined;
+  if (p.kind === "bloom") {
+    const [hx, hy] = STEM_HEAD[p.stem];
+    const s = SPECIES[p.species];
+    return (
+      <g transform={flip}>
+        <use href={`#ig-stem-${p.stem}`} x="-30" y="-112" width="60" height="112" />
+        <use href={`#ig-head-${p.species}`} x={hx - 17} y={hy - 17} width="34" height="34" style={{ color: s.palette[p.tone % s.palette.length] }} />
+      </g>
+    );
+  }
+  if (p.kind === "bud") {
+    return <use href="#ig-bud" x="-30" y="-112" width="60" height="112" transform={flip} style={{ color: BUD_TONES[p.tone % BUD_TONES.length] }} />;
+  }
+  return <use href={`#ig-${p.kind}`} x="-30" y="-112" width="60" height="112" transform={flip} />;
+};
+
+/* Each plant's box in the view: 60 x 112 scaled, stem base at the bottom middle. */
+const boxOf = (p: Plant) => {
+  if (p.kind === "naira") {
+    const h = 208;
+    const w = h * FLOWER_ASPECT;
+    return { left: p.x - w * FLOWER_BASE_X, top: p.y - h, w, h };
+  }
+  if (p.kind === "stone") return { left: p.x - 40 * 1.05, top: p.y - 170 * 1.05, w: 80 * 1.05, h: 170 * 1.05 };
+  const w = 60 * p.scale;
+  const h = 112 * p.scale;
+  return { left: p.x - w / 2, top: p.y - h, w, h };
+};
+
+const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
+
+export type GardenBedHandle = { bloomIn: (short?: boolean) => Animation[] };
+
+type Props = {
+  seed: string;
+  stone: Stone | null;
+  plantedOn?: string | null;
+  stoneLabel?: string;
+  /** The gate's backdrop: no sway, no taps, no labels. */
+  still?: boolean;
+  className?: string;
+};
+
+const GardenBed = forwardRef<GardenBedHandle, Props>(({ seed, stone, plantedOn, stoneLabel, still = false, className = "" }, ref) => {
+  const bedRef = useRef<HTMLDivElement>(null);
+  const garden = useMemo(() => layoutGarden(seed), [seed]);
+  const calm = still || stillMotion();
+  const active = useAmbient(bedRef, !calm);
+  const sways = useRef<Animation[]>([]);
+
+  useTapBloom(bedRef, !still);
+
+  useImperativeHandle(ref, () => ({
+    bloomIn: (short = false) => {
+      const root = bedRef.current;
+      if (!root || calm) return [];
+      const out: Animation[] = [];
+      root.querySelectorAll<HTMLElement>(".ig-plant").forEach((node) => {
+        const band = Number(node.dataset.band ?? 0);
+        const a = play(node, [{ transform: "scale(0)", opacity: 0 }, { transform: "scale(1)", opacity: 1 }], {
+          duration: short ? 300 : 500,
+          delay: Math.floor((band * 2) / 3) * (short ? 12 : 40),
+          easing: EASE_BLOOM,
+          fill: "backwards",
+        });
+        if (a) out.push(a);
+      });
+      root.querySelectorAll(".ig-soil, .ig-arbour-line").forEach((line) => {
+        const a = play(line, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], {
+          duration: short ? 300 : 620,
+          easing: "cubic-bezier(0.45, 0, 0.25, 1)",
+          fill: "backwards",
+        });
+        if (a) out.push(a);
+      });
+      return out;
+    },
+  }), [calm]);
+
+  // The sway: built once, then paused and resumed with the garden's attention.
+  useEffect(() => {
+    const root = bedRef.current;
+    if (!root || calm) return;
+    const list: Animation[] = [];
+    root.querySelectorAll<HTMLElement>(".ig-sway").forEach((node) => {
+      const dur = Number(node.dataset.dur ?? 4) * 1000;
+      const a = play(node, [{ transform: "rotate(-2.5deg)" }, { transform: "rotate(2.5deg)" }], {
+        duration: dur,
+        iterations: Infinity,
+        direction: "alternate",
+        easing: "ease-in-out",
+      });
+      if (!a) return;
+      a.currentTime = Number(node.dataset.phase ?? 0) * dur;
+      a.pause();
+      list.push(a);
+    });
+    sways.current = list;
+    return () => {
+      list.forEach((a) => a.cancel());
+      sways.current = [];
+    };
+  }, [calm, garden]);
+
+  useEffect(() => {
+    sways.current.forEach((a) => (active ? a.play() : a.pause()));
+  }, [active]);
+
+  return (
+    <div ref={bedRef} className={`ig-bed ${className}`} data-resting={active ? undefined : ""}>
+      <svg viewBox={`0 0 ${BED.w} ${BED.h}`} className="ig-bed-ground" aria-hidden>
+        {!still && <Arbour />}
+        <path className="ig-soil" d={`M14 ${BED.soil + 1}H${BED.w - 14}`} pathLength={1} strokeDasharray="1 1" />
+        {[40, 92, 236, 318, 352].map((x) => (
+          <circle key={x} cx={x} cy={BED.soil + 5} r="1.2" fill="var(--nf-accent)" opacity=".7" />
+        ))}
+      </svg>
+      {garden.plants.map((p) => {
+        const b = boxOf(p);
+        return (
+          <div
+            key={p.id}
+            className={`ig-plant ig-plant--${p.kind}`}
+            data-band={p.band}
+            style={{ left: pct(b.left, BED.w), top: pct(b.top, BED.h), width: pct(b.w, BED.w), height: pct(b.h, BED.h) }}
+          >
+            <div
+              className={p.sway && !calm ? "ig-sway" : "ig-still"}
+              data-dur={p.swayDur}
+              data-phase={p.swayPhase.toFixed(3)}
+              style={{ opacity: ROW_SHADE[p.row] }}
+            >
+              {p.kind === "naira" ? (
+                <FlowerDraw height={208} />
+              ) : p.kind === "stone" ? (
+                <StonePlant stone={stone} />
+              ) : (
+                <svg viewBox="-30 -112 60 112" className="ig-sway-art" aria-hidden>
+                  {art(p)}
+                </svg>
+              )}
+            </div>
+          </div>
+        );
+      })}
+      {!still && plantedOn && (
+        <p className="ig-bed-label" style={{ left: pct(garden.naira.x, BED.w) }}>
+          <span>Planted</span>
+          {plantedOn}
+        </p>
+      )}
+      {!still && stoneLabel && (
+        <p className="ig-bed-label ig-bed-label--stone" style={{ left: pct(garden.stone.x, BED.w) }}>
+          <span>Your stone</span>
+          {stoneLabel}
+        </p>
+      )}
+    </div>
+  );
+});
+GardenBed.displayName = "GardenBed";
+
+export default GardenBed;
diff --git a/src/components/portal/GateIronwork.tsx b/src/components/portal/GateIronwork.tsx
new file mode 100644
index 0000000..f3e2209
--- /dev/null
+++ b/src/components/portal/GateIronwork.tsx
@@ -0,0 +1,133 @@
+import type { ReactNode, Ref } from "react";
+import { bez, chainPath, leavesAlong, pointOn, type Seg } from "@/lib/portal/curves";
+
+/*
+  The garden gate: two leaves of gold ironwork drawn from the Account sprig.
+  Each leaf is 180 x 360, hinged on its outer edge: a round arch rising to the
+  latch, pickets with bud finials, a vine of the sprig's leaves with blush buds
+  climbing to the latch, and a band of little solitaire rings along the foot
+  (the jewellery, worked into the iron). The right leaf is the left one
+  mirrored, and the two half-rings at the latch close into the medallion that
+  holds the Naira flower.
+
+  The art is drawn twice: a soft under-stroke (cream on the sage curtain,
+  nothing on ivory) and the gold line over it, so the ironwork reads on both
+  grounds without a filter.
+*/
+
+const ARCH = { p0: [8, 118], p1: [8, 70], p2: [104, 44], p3: [180, 44] } as const;
+const MEDAL = { x: 180, y: 196, r: 40 } as const;
+
+/* The arch's height above a picket at x (bisection on the curve's x). */
+const archY = (x: number) => {
+  let lo = 0;
+  let hi = 1;
+  for (let i = 0; i < 24; i++) {
+    const mid = (lo + hi) / 2;
+    if (bez(mid, ARCH.p0[0], ARCH.p1[0], ARCH.p2[0], ARCH.p3[0]) < x) lo = mid;
+    else hi = mid;
+  }
+  return bez(lo, ARCH.p0[1], ARCH.p1[1], ARCH.p2[1], ARCH.p3[1]);
+};
+
+const PICKETS = [34, 60, 86, 112, 138, 160];
+
+/* The climbing vine: one stem, its leaves set alternately along it. */
+const VINE_SEGS: Seg[] = [
+  [16, 262, 46, 246, 30, 208, 62, 192],
+  [62, 192, 96, 176, 84, 140, 116, 128],
+  [116, 128, 140, 119, 138, 96, 158, 84],
+];
+const VINE = chainPath(VINE_SEGS);
+const LEAVES = leavesAlong(VINE_SEGS, [0.08, 0.19, 0.3, 0.41, 0.52, 0.63, 0.74, 0.86]);
+const BUDS = [0.24, 0.57, 0.97].map((t) => pointOn(VINE_SEGS, t));
+
+const RINGS = [21, 47, 73, 99, 125, 150];
+
+const leafArt = (
+  <>
+    {/* frame: hinge stile, arch, latch stile, rails */}
+    <path className="b" d={`M8 352V118C8 70 104 44 180 44`} />
+    <path className="f" d={`M15 344V121C15 79 106 54 172 52`} />
+    <path className="b" d="M176 48V352" />
+    <path className="b" d="M8 352H176M8 344H176" />
+    <path className="b" d="M8 276H176M8 282H176" />
+    {/* pickets, broken by the medallion, each with a bud finial above the arch */}
+    {PICKETS.map((x) => {
+      const top = archY(x);
+      const inMedal = Math.abs(x - MEDAL.x) < MEDAL.r + 2;
+      const cut = inMedal ? Math.sqrt(Math.max(0, (MEDAL.r + 3) ** 2 - (MEDAL.x - x) ** 2)) : 0;
+      return (
+        <g key={x}>
+          {inMedal ? (
+            <path className="f" d={`M${x} 344V${MEDAL.y + cut}M${x} ${MEDAL.y - cut}V${top}`} />
+          ) : (
+            <path className="f" d={`M${x} 344V${top}`} />
+          )}
+          <path className="f" d={`M${x} ${top}V${top - 9}M${x} ${top - 22}C${x + 4.5} ${top - 16} ${x + 4.5} ${top - 12} ${x} ${top - 9}C${x - 4.5} ${top - 12} ${x - 4.5} ${top - 16} ${x} ${top - 22}Z`} />
+        </g>
+      );
+    })}
+    {/* the vine */}
+    <path className="f" d={VINE} />
+    {LEAVES.map((l, i) => (
+      <ellipse key={i} className="f" cx={l.x.toFixed(1)} cy={l.y.toFixed(1)} rx="7.5" ry="3" transform={`rotate(${l.a.toFixed(1)} ${l.x.toFixed(1)} ${l.y.toFixed(1)})`} />
+    ))}
+    {BUDS.map(([x, y], i) => (
+      <circle key={i} className="bud" cx={x.toFixed(1)} cy={y.toFixed(1)} r={i === 2 ? 3.6 : 2.8} />
+    ))}
+    {/* the band of solitaire rings along the foot */}
+    {RINGS.map((x) => (
+      <g key={x}>
+        <circle className="f" cx={x} cy="314" r="8" />
+        <path className="f" d={`M${x - 3} 306L${x} 301.5L${x + 3} 306Z`} />
+      </g>
+    ))}
+    {/* half of the latch medallion and half of the crest */}
+    <path className="b" d={`M${MEDAL.x} ${MEDAL.y - MEDAL.r}A${MEDAL.r} ${MEDAL.r} 0 0 0 ${MEDAL.x} ${MEDAL.y + MEDAL.r}`} />
+    <path className="f" d={`M${MEDAL.x} ${MEDAL.y - MEDAL.r + 6}A${MEDAL.r - 6} ${MEDAL.r - 6} 0 0 0 ${MEDAL.x} ${MEDAL.y + MEDAL.r - 6}`} />
+    <path className="f" d="M180 44C168 38 158 30 163 21C167 14 177 16 178 25M180 44V12" />
+  </>
+);
+
+export const GateLeaf = ({ side, leafRef }: { side: "left" | "right"; leafRef?: Ref<HTMLDivElement> }) => (
+  <div ref={leafRef} className={`ig-leaf ig-leaf--${side}`}>
+    <svg viewBox="0 0 180 360" className="ig-leaf-art" aria-hidden>
+      <g className="ig-iron-under">{leafArt}</g>
+      <g className="ig-iron">{leafArt}</g>
+    </svg>
+  </div>
+);
+
+/**
+ * The closed gate, with whatever sits in the latch medallion (the flower).
+ * `tone` sets the under-stroke for the ground it stands on.
+ */
+const GateIronwork = ({
+  tone = "ivory",
+  label,
+  latch,
+  leftRef,
+  rightRef,
+  className = "",
+}: {
+  tone?: "ivory" | "sage";
+  label?: string;
+  latch?: ReactNode;
+  leftRef?: Ref<HTMLDivElement>;
+  rightRef?: Ref<HTMLDivElement>;
+  className?: string;
+}) => (
+  <div
+    className={`ig-gate ig-gate--${tone} ${className}`}
+    role={label ? "img" : undefined}
+    aria-label={label}
+    aria-hidden={label ? undefined : true}
+  >
+    <GateLeaf side="left" leafRef={leftRef} />
+    <GateLeaf side="right" leafRef={rightRef} />
+    {latch && <div className="ig-latch">{latch}</div>}
+  </div>
+);
+
+export default GateIronwork;
