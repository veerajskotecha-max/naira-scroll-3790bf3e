@@ -0,0 +1,90 @@
+import {
+  FLOWER_ASPECT,
+  FLOWER_PETALS,
+  FLOWER_STEM,
+  FLOWER_VIEWBOX,
+  LEAF_SAGE,
+  PETAL_BLUSH,
+} from "@/lib/portal/brandFlower";
+import { EASE_REVEAL, play } from "@/lib/portal/motion";
+
+/*
+  The Naira flower drawing itself: a gold line traces the stem and its leaves,
+  then the four petals, and the colour comes in under the line (sage leaves,
+  blush petals). Rendered complete; drawFlower() animates it from nothing,
+  using stroke-dashoffset on pathLength=1 lines and opacity on the fills, so
+  under reduced motion or with no animation support it simply stays drawn.
+*/
+
+type Props = {
+  /** Rendered height in px; the stroke is set from it so the line stays a hairline. */
+  height: number;
+  className?: string;
+  /** Leave the colour out: a gold line drawing only. */
+  lineOnly?: boolean;
+  label?: string;
+};
+
+const FlowerDraw = ({ height, className = "", lineOnly = false, label }: Props) => {
+  const stroke = (1.15 / height).toFixed(5);
+  const parts = [FLOWER_STEM, ...FLOWER_PETALS];
+  return (
+    <svg
+      viewBox={FLOWER_VIEWBOX}
+      width={Math.round(height * FLOWER_ASPECT)}
+      height={height}
+      className={`ig-flower ${className}`}
+      role={label ? "img" : undefined}
+      aria-label={label}
+      aria-hidden={label ? undefined : true}
+    >
+      {!lineOnly && (
+        <g className="ig-flower-fill">
+          {parts.map((d, i) => (
+            <path key={i} d={d} fill={i === 0 ? LEAF_SAGE : PETAL_BLUSH} />
+          ))}
+        </g>
+      )}
+      <g className="ig-flower-line" fill="none" stroke="var(--nf-accent-strong)" strokeWidth={stroke} strokeLinejoin="round">
+        {parts.map((d, i) => (
+          <path key={i} d={d} pathLength={1} strokeDasharray="1 1" />
+        ))}
+      </g>
+    </svg>
+  );
+};
+
+export default FlowerDraw;
+
+/**
+ * Draws every flower inside `root`: the stem first, the petals overlapping
+ * it, then the colour. `duration` covers the line; the fill takes 220 ms more.
+ */
+// eslint-disable-next-line react-refresh/only-export-components -- the flower's own choreography, beside its markup
+export const drawFlower = (root: Element | null, { delay = 0, duration = 700 } = {}): Animation[] => {
+  if (!root) return [];
+  const out: Animation[] = [];
+  root.querySelectorAll(".ig-flower").forEach((svg) => {
+    const lines = svg.querySelectorAll(".ig-flower-line path");
+    lines.forEach((path, i) => {
+      const start = i === 0 ? 0 : duration * (0.3 + (i - 1) * 0.08);
+      const span = i === 0 ? duration * 0.62 : duration - start;
+      const a = play(path, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], {
+        duration: span,
+        delay: delay + start,
+        easing: "cubic-bezier(0.45, 0, 0.25, 1)",
+        fill: "backwards",
+      });
+      if (a) out.push(a);
+    });
+    const fill = svg.querySelector(".ig-flower-fill");
+    const f = play(fill, [{ opacity: 0 }, { opacity: 1 }], {
+      duration: 260,
+      delay: delay + duration * 0.86,
+      easing: EASE_REVEAL,
+      fill: "backwards",
+    });
+    if (f) out.push(f);
+  });
+  return out;
+};
