+import { forwardRef, useEffect, useImperativeHandle, useMemo, useRef } from "react";
+import { BED, layoutGarden, type Plant } from "@/lib/portal/gardenLayout";
+import { SPECIES, petalTransform } from "@/lib/portal/species";
+import { FLOWER_ASPECT, FLOWER_BASE_X, LEAF_SAGE } from "@/lib/portal/brandFlower";
+import type { Stone } from "@/lib/portal/stones";
+import { EASE_BLOOM, play, stillMotion, useAmbient } from "@/lib/portal/motion";
+import { chainPath, leavesAlong, mirrorSegs, pointOn, type Seg } from "@/lib/portal/curves";
+import FlowerDraw from "./FlowerDraw";
+import { StonePlant } from "./StoneArt";
