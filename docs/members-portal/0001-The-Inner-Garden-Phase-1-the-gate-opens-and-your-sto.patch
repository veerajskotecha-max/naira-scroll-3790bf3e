+import { cleanup, fireEvent, render } from "@testing-library/react";
+import { useRef } from "react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { MAX_BLOOMS, useTapBloom } from "./useTapBloom";
+import { MAX_PETALS, burstPetals } from "./PetalBurst";
+
+/* The shop's tap-bloom listened on window, so two on one page both answered
+   every tap, and it bloomed under reduced motion. The portal's listens only
+   on its own element, keeps five blooms at most and stays still for anyone
+   who asked for less motion. */
+const Bed = () => {
+  const ref = useRef<HTMLDivElement>(null);
+  useTapBloom(ref);
+  return (
+    <div ref={ref} data-testid="bed">
+      <button type="button">a control</button>
+    </div>
+  );
+};
+
+const reduce = (on: boolean) => {
+  window.matchMedia = ((q: string) => ({ matches: on && q.includes("reduce"), media: q, addEventListener() {}, removeEventListener() {}, addListener() {}, removeListener() {}, onchange: null, dispatchEvent: () => false })) as typeof window.matchMedia;
+};
+
+afterEach(() => {
+  cleanup();
+  reduce(false);
+  vi.restoreAllMocks();
+});
+
+describe("useTapBloom", () => {
+  it("keeps at most five blooms alive", () => {
+    const { getByTestId } = render(<Bed />);
+    const bed = getByTestId("bed");
+    for (let i = 0; i < 9; i++) fireEvent.pointerDown(bed, { clientX: 10 + i, clientY: 10, button: 0 });
+    expect(bed.querySelectorAll(".ig-bloom").length).toBe(MAX_BLOOMS);
+  });
+
+  it("listens on its own element, never on window", () => {
+    const spy = vi.spyOn(window, "addEventListener");
+    render(<Bed />);
+    expect(spy.mock.calls.filter(([type]) => type === "pointerdown")).toEqual([]);
+  });
+
+  it("leaves taps on controls alone", () => {
+    const { getByTestId, getByRole } = render(<Bed />);
+    fireEvent.pointerDown(getByRole("button"), { button: 0 });
+    expect(getByTestId("bed").querySelectorAll(".ig-bloom")).toHaveLength(0);
+  });
+
+  it("blooms nothing under reduced motion", () => {
+    reduce(true);
+    const { getByTestId } = render(<Bed />);
+    fireEvent.pointerDown(getByTestId("bed"), { button: 0 });
+    expect(getByTestId("bed").querySelectorAll(".ig-bloom")).toHaveLength(0);
+  });
+});
+
+describe("burstPetals", () => {
+  it("never throws more than 24 petals, and none under reduced motion", () => {
+    const layer = document.createElement("div");
+    const animate = vi.fn(() => ({ onfinish: null, oncancel: null }) as unknown as Animation);
+    (HTMLElement.prototype as unknown as { animate: unknown }).animate = animate;
+    (SVGElement.prototype as unknown as { animate: unknown }).animate = animate;
+    burstPetals(layer, 0, 0, { count: 200 });
+    expect(layer.querySelectorAll(".ig-petal")).toHaveLength(MAX_PETALS);
+    reduce(true);
+    const quiet = document.createElement("div");
+    burstPetals(quiet, 0, 0, { count: 10 });
+    expect(quiet.childElementCount).toBe(0);
+    delete (HTMLElement.prototype as unknown as { animate?: unknown }).animate;
+    delete (SVGElement.prototype as unknown as { animate?: unknown }).animate;
+  });
+});
