@@ -0,0 +1,150 @@
+import { useEffect, useRef, useState, type FormEvent } from "react";
+import PortalShell from "@/components/portal/PortalShell";
+import SeedCeremony from "@/components/portal/SeedCeremony";
+import StoneCard, { type ShopStatus } from "@/components/portal/StoneCard";
+import { HeartStone } from "@/components/portal/StoneArt";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, primaryButton, quietButton } from "@/components/portal/styles";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { BIRTHSTONE_HANDLE, STONES, isPlausibleBirthday, stoneForBirthday, stoneForMonth } from "@/lib/portal/stones";
+import { formatIstDate } from "@/lib/portal/ist";
+import { readPortal, writePortal } from "@/lib/portal/safeStorage";
+import { stillMotion } from "@/lib/portal/motion";
+
+/*
+  Your stone. The first visit plays the seed ceremony; a birthday, if her
+  profile has none, is one date field saved to her own profile (the column
+  Account already edits). Her month's specimen card turns over to the live
+  necklace; the other eleven months sit below it, for a gift.
+*/
+
+const todayIso = () => new Date().toISOString().slice(0, 10);
+
+const BirthdayForm = ({ onSave }: { onSave: (birthday: string) => Promise<{ ok: true } | { ok: false; message: string }> }) => {
+  const [value, setValue] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<string | null>(null);
+
+  const submit = async (e: FormEvent) => {
+    e.preventDefault();
+    if (!isPlausibleBirthday(value)) {
+      setMessage("Please choose your birthday from the calendar.");
+      return;
+    }
+    setBusy(true);
+    setMessage(null);
+    const result = await onSave(value);
+    setBusy(false);
+    if (result.ok === false) setMessage(result.message);
+  };
+
+  return (
+    <form className="ig-birthday" onSubmit={submit} data-clarity-mask="true">
+      <label htmlFor="ig-birthday" className="ig-h2">
+        When is your birthday?
+      </label>
+      <p className="ig-fineprint">Your flower opens in your month's colour. It is saved to your account, where you can change it.</p>
+      <input
+        id="ig-birthday"
+        type="date"
+        required
+        max={todayIso()}
+        min="1900-01-01"
+        value={value}
+        onChange={(e) => setValue(e.target.value)}
+        className="ig-input"
+        autoComplete="bday"
+      />
+      {message && (
+        <p className="ig-error" role="alert">
+          {message}
+        </p>
+      )}
+      <button type="submit" className={primaryButton} disabled={busy}>
+        {busy ? "Planting…" : "Plant my stone"}
+      </button>
+    </form>
+  );
+};
+
+const Stone = () => {
+  const member = useMember();
+  const { profile, user, preview, saveBirthday, addToBag } = member;
+  const own = stoneForBirthday(profile?.birthday);
+  const [picked, setPicked] = useState<number | null>(null);
+  const shown = stoneForMonth(picked ?? own?.month ?? null);
+  const [ceremony, setCeremony] = useState(() => !readPortal().seedSeen && !stillMotion());
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const { jewellery, isLive, isLoading } = useLiveJewellery();
+  const piece = isLive ? jewellery.find((p) => p.handle === BIRTHSTONE_HANDLE) : undefined;
+  const status: ShopStatus = piece ? "ready" : isLive ? "missing" : isLoading ? "loading" : "offline";
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  const endCeremony = () => {
+    writePortal({ seedSeen: true });
+    setCeremony(false);
+  };
+
+  return (
+    <PortalShell title="Your stone" description="Your birthstone in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-stone-page">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            Your <em>stone</em>
+          </h1>
+          <p className="ig-lede">
+            {own ? `${own.variant}: the heart in your month's colour.` : "Tell us your birthday, and your flower opens in your month's colour."}
+          </p>
+        </div>
+
+        <SeedCeremony stone={own} playing={ceremony} onDone={endCeremony} />
+        <p className="ig-seed-caption">
+          A seed for you{formatIstDate(user.created_at) ? `, planted ${formatIstDate(user.created_at)}` : ""}.{" "}
+          {own ? `Your stone opens: ${own.variant}.` : "Your stone's bud waits for your birthday."}
+        </p>
+
+        {!own && <BirthdayForm onSave={saveBirthday} />}
+
+        {shown && (
+          <section className="ig-section" aria-label={`${shown.variant}, specimen card`}>
+            <StoneCard stone={shown} piece={piece} status={status} own={shown.month === own?.month} preview={preview} onAdd={addToBag} />
+          </section>
+        )}
+
+        <section className="ig-section" aria-labelledby="ig-months">
+          <h2 id="ig-months" className="ig-h2">
+            Every month's colour
+          </h2>
+          <p className="ig-fineprint">For a gift, or a second birthday.</p>
+          <ul className="ig-months">
+            {STONES.map((s) => (
+              <li key={s.month}>
+                <button
+                  type="button"
+                  className="ig-month"
+                  aria-pressed={shown?.month === s.month}
+                  onClick={() => setPicked(s.month)}
+                >
+                  <HeartStone stone={s} size={22} />
+                  <span>{s.monthName.slice(0, 3)}</span>
+                  {own?.month === s.month && <span className="ig-month-own">Yours</span>}
+                </button>
+              </li>
+            ))}
+          </ul>
+          {picked && own && picked !== own.month && (
+            <button type="button" className={quietButton} onClick={() => setPicked(null)}>
+              Back to {own.monthName}
+            </button>
+          )}
+        </section>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Stone;
