+import { describe, expect, it } from "vitest";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+
+/*
+  The portal's honesty rules, enforced on its sources. No invented social
+  proof or scarcity (the product page's "N pieces sold" is exactly what this
+  keeps out), no members' prices, codes or gifts the shop has not created,
+  exclusivity worded as a first look, and stones described as the listing
+  does: cubic zirconia in the month's colour, never real gemstones or solid
+  gold.
+*/
+const src = resolve(__dirname, "../..");
+const dirs = ["pages/members", "components/portal", "lib/portal"];
+const files = (dir: string): string[] =>
+  readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
+    e.isDirectory() ? files(join(dir, e.name)) : /\.(tsx?|css)$/.test(e.name) && !/\.test\./.test(e.name) ? [join(dir, e.name)] : [],
+  );
+const sources = dirs.flatMap((d) => files(join(src, d)));
+
+const BANNED: [string, RegExp][] = [
+  ["the plan's banned phrases", /members-only pric|only \d+ left|\d+ (members|watching)|spots left|sold in the last|selling fast/i],
+  ["exclusivity beyond a first look", /exclusive to members|members only can buy|only members can buy/i],
+  ["a price or reward that does not exist", /\d+\s*%\s*off|discount code|members'? price|birthday gift|free gift|reward points|referral/i],
+  ["scarcity nobody confirmed", /\b(small batch|limited edition|gone for good|almost gone|hurry)\b/i],
+  ["stones or metal beyond the listing's words", /\b(real|genuine|natural|precious) (garnet|amethyst|aquamarine|emerald|ruby|peridot|sapphire|topaz|zircon|gemstone|stone)s?\b|solid gold/i],
+];
+
+describe("portal copy", () => {
+  it("reads the portal's sources", () => {
+    expect(sources.length).toBeGreaterThan(20);
+  });
+
+  it.each(BANNED)("never carries %s", (_what, pattern) => {
+    const hits = sources.flatMap((f) =>
+      readFileSync(f, "utf8")
+        .split("\n")
+        .flatMap((line, i) => (pattern.test(line) ? [`${relative(src, f)}:${i + 1}: ${line.trim()}`] : [])),
+    );
+    expect(hits).toEqual([]);
+  });
+
+  it("says out loud that the garden is for joy, not points", () => {
+    const home = readFileSync(join(src, "pages/members/GardenHome.tsx"), "utf8");
+    expect(home).toMatch(/Nothing in it is points, and nothing in it can be redeemed/);
+  });
+});
