+import { Link, useLocation } from "react-router-dom";
+
+/*
+  The garden path: the portal's own bar, sticky at the foot of the screen
+  while she is in it and resting above the footer at the end. It sits in the
+  z-40 tier, under the bag's z-50, so an open bag always covers it. Phase 1
+  has two rooms; the rest join as they are built, never as "coming soon".
+  Plain Links with aria-current: the shop never uses NavLink, and importing
+  it here would add an export to the vendor chunk every page downloads.
+*/
+
+const GardenIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    {[0, 72, 144, 216, 288].map((a) => (
+      <ellipse key={a} cx="12" cy="6.2" rx="2.6" ry="3.8" transform={`rotate(${a} 12 10)`} className="ig-nav-petal" />
+    ))}
+    <circle cx="12" cy="10" r="1.7" className="ig-nav-core" />
+    <path d="M12 14V22M12 18C10 16.5 8 16.5 7 17.5M12 20C14 18.5 16 18.5 17 19.5" className="ig-nav-line" />
+  </svg>
+);
+
+const StoneIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    <path d="M12 20C6.5 15.6 3.5 12.4 3.5 8.9 3.5 6.3 5.5 4.5 7.8 4.5 9.6 4.5 11.1 5.5 12 7 12.9 5.5 14.4 4.5 16.2 4.5 18.5 4.5 20.5 6.3 20.5 8.9 20.5 12.4 17.5 15.6 12 20Z" className="ig-nav-petal" />
+    <path d="M12 7V20M4 9.5H20M7.8 4.5L12 9.5 16.2 4.5" className="ig-nav-line" />
+  </svg>
+);
+
+const AccountIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    <circle cx="12" cy="8.5" r="3.6" className="ig-nav-line" />
+    <path d="M5 20C5.8 16 8.6 13.8 12 13.8S18.2 16 19 20" className="ig-nav-line" />
+  </svg>
+);
+
+const ROOMS = [
+  { to: "/members", label: "Garden", icon: <GardenIcon /> },
+  { to: "/members/stone", label: "Your stone", icon: <StoneIcon /> },
+  { to: "/account", label: "Account", icon: <AccountIcon /> },
+];
+
+const PortalNav = () => {
+  const here = useLocation().pathname.replace(/\/+$/, "") || "/";
+  return (
+    <nav className="ig-nav" aria-label="Your garden">
+      <ul>
+        {ROOMS.map((room) => {
+          const current = here === room.to;
+          return (
+            <li key={room.to}>
+              <Link to={room.to} className={`ig-nav-link${current ? " is-here" : ""}`} aria-current={current ? "page" : undefined}>
+                {room.icon}
+                <span>{room.label}</span>
+              </Link>
+            </li>
+          );
+        })}
+      </ul>
+    </nav>
+  );
+};
