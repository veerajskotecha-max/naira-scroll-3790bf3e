+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import type { JewelPiece } from "@/data/jewellery";
+import { BIRTHSTONE_HANDLE, STONES } from "@/lib/portal/stones";
+import StoneCard from "./StoneCard";
+
+const necklace = jewellerySnapshot.find((p) => p.handle === BIRTHSTONE_HANDLE)!;
+const july = STONES[6];
+
+const shop = vi.hoisted(() => ({ jewellery: [] as unknown[] }));
+const cart = vi.hoisted(() => ({ addItem: vi.fn(async () => "https://checkout"), setDrawerOpen: vi.fn() }));
+const db = vi.hoisted(() => {
+  const upsert = vi.fn(async () => ({ error: null }));
+  const from = vi.fn(() => ({ upsert }));
+  return { upsert, from };
+});
+const auth = vi.hoisted(() => ({ state: {} as Record<string, unknown>, refreshProfile: vi.fn(async () => {}) }));
+
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => ({ jewellery: shop.jewellery, isLive: true, isLoading: false }) }));
+vi.mock("@/contexts/CartContext", () => ({ useCart: () => cart }));
+vi.mock("@/contexts/AuthContext", () => ({ useAuth: () => auth.state }));
+vi.mock("@/integrations/supabase/lazy", () => ({ getSupabase: async () => ({ from: db.from }) }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => null }));
+
+import MembersRoute from "@/pages/members/MembersRoute";
+
+const card = (piece: JewelPiece, onAdd = vi.fn(async (_line: unknown) => {})) => {
+  render(
+    <MemoryRouter>
+      <StoneCard stone={july} piece={piece} status="ready" own onAdd={onAdd} />
+    </MemoryRouter>,
+  );
+  return onAdd;
+};
+
+const user = { id: "u-7", email: "meera@example.com", created_at: "2026-11-04T05:00:00Z", user_metadata: {} };
+
+beforeEach(() => {
+  shop.jewellery = [necklace];
+  window.localStorage.clear();
+  window.localStorage.setItem("naira-portal", JSON.stringify({ seedSeen: true, doorsDay: "x" }));
+  vi.clearAllMocks();
+});
+afterEach(cleanup);
+
+describe("the specimen card", () => {
+  it("turns over to the live necklace with her month already chosen, priced from the listing", () => {
+    card(necklace);
+    fireEvent.click(screen.getByRole("button", { name: /turn the card over/i }));
+    expect(screen.getAllByText("July · Ruby").length).toBeGreaterThan(0);
+    expect(screen.getByText("₹699")).toBeInTheDocument();
+    expect(screen.getByText("₹1,200").tagName).toBe("S");
+    expect(screen.getByText("Available")).toBeInTheDocument();
+  });
+
+  it("adds exactly her month's variant to the bag", async () => {
+    const onAdd = card(necklace);
+    fireEvent.click(screen.getByRole("button", { name: /turn the card over/i }));
+    fireEvent.click(screen.getByRole("button", { name: "Add to bag" }));
+    await waitFor(() => expect(onAdd).toHaveBeenCalledTimes(1));
+    const line = onAdd.mock.calls[0][0] as { variantId: string; selectedOptions: { name: string; value: string }[] };
+    const variant = necklace.variants!.find((v) => v.options.Month === "July · Ruby")!;
+    expect(line.variantId).toBe(variant.id);
+    expect(line.selectedOptions).toEqual([{ name: "Month", value: "July · Ruby" }]);
+  });
+
+  it("offers WhatsApp, not the bag, when her month is sold out", () => {
+    const soldOut = {
+      ...necklace,
+      variants: necklace.variants!.map((v) => (v.options.Month === "July · Ruby" ? { ...v, availableForSale: false } : v)),
+    };
+    card(soldOut);
+    fireEvent.click(screen.getByRole("button", { name: /turn the card over/i }));
+    expect(screen.queryByRole("button", { name: "Add to bag" })).toBeNull();
+    expect(screen.getByText("Sold out")).toBeInTheDocument();
+    const reserve = screen.getByRole("link", { name: "Reserve on WhatsApp" });
+    expect(reserve.getAttribute("href")).toMatch(/^https:\/\/wa\.me\/\d+\?text=/);
+    expect(decodeURIComponent(reserve.getAttribute("href")!)).toContain("in July · Ruby");
+  });
+
+  it("keeps the back out of reach until it is turned", () => {
+    card(necklace);
+    const back = document.querySelector(".ig-face--back")!;
+    expect(back.getAttribute("aria-hidden")).toBe("true");
+    fireEvent.click(screen.getByRole("button", { name: /turn the card over/i }));
+    expect(back.getAttribute("aria-hidden")).toBeNull();
+  });
+});
+
+describe("Your stone, in the portal", () => {
+  const visitStone = () =>
+    render(
+      <MemoryRouter initialEntries={["/members/stone"]}>
+        <Routes>
+          <Route path="/members/*" element={<MembersRoute />} />
+        </Routes>
+      </MemoryRouter>,
+    );
+
+  it("asks for a birthday when her profile has none, and saves it to her own profile row", async () => {
+    auth.state = { user, profile: { id: user.id, full_name: "Meera", birthday: null, phone: null, city: null }, loading: false, refreshProfile: auth.refreshProfile };
+    visitStone();
+    const field = screen.getByLabelText("When is your birthday?");
+    expect(field).toHaveAttribute("type", "date");
+    fireEvent.change(field, { target: { value: "2001-10-03" } });
+    fireEvent.click(screen.getByRole("button", { name: "Plant my stone" }));
+    await waitFor(() => expect(db.upsert).toHaveBeenCalledTimes(1));
+    expect(db.from).toHaveBeenCalledWith("profiles");
+    expect(db.upsert).toHaveBeenCalledWith({ id: user.id, birthday: "2001-10-03" });
+    await waitFor(() => expect(auth.refreshProfile).toHaveBeenCalled());
+  });
+
+  it("does not ask again once the birthday is known, and opens on her month", () => {
+    auth.state = { user, profile: { id: user.id, full_name: "Meera", birthday: "2001-10-03", phone: null, city: null }, loading: false, refreshProfile: auth.refreshProfile };
+    visitStone();
+    expect(screen.queryByLabelText("When is your birthday?")).toBeNull();
+    expect(screen.getByRole("button", { name: /^October · Rose\. Turn the card over/ })).toBeInTheDocument();
+  });
+
+  it("puts her month in the shared bag through the cart, opening the bag", async () => {
+    auth.state = { user, profile: { id: user.id, full_name: "Meera", birthday: "2001-10-03", phone: null, city: null }, loading: false, refreshProfile: auth.refreshProfile };
+    visitStone();
+    fireEvent.click(screen.getByRole("button", { name: /turn the card over/i }));
+    fireEvent.click(screen.getByRole("button", { name: "Add to bag" }));
+    await waitFor(() => expect(cart.addItem).toHaveBeenCalledTimes(1));
+    expect(cart.setDrawerOpen).toHaveBeenCalledWith(true);
+    const october = necklace.variants!.find((v) => v.options.Month === "October · Rose")!;
+    expect((cart.addItem.mock.calls[0] as unknown[])[0]).toMatchObject({ id: BIRTHSTONE_HANDLE, variantId: october.id, price: 699 });
+  });
+
+  it("refuses a birthday that is not a real past date, without writing", async () => {
+    auth.state = { user, profile: { id: user.id, full_name: "Meera", birthday: null, phone: null, city: null }, loading: false, refreshProfile: auth.refreshProfile };
+    visitStone();
+    fireEvent.change(screen.getByLabelText("When is your birthday?"), { target: { value: "2999-01-01" } });
+    fireEvent.submit(screen.getByRole("button", { name: "Plant my stone" }).closest("form")!);
+    expect(await screen.findByRole("alert")).toHaveTextContent(/choose your birthday/i);
+    expect(db.upsert).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/components/portal/StoneCard.tsx b/src/components/portal/StoneCard.tsx
new file mode 100644
index 0000000..23f8d94
--- /dev/null
+++ b/src/components/portal/StoneCard.tsx
@@ -0,0 +1,248 @@
+import { useEffect, useRef, useState, type PointerEvent as ReactPointerEvent } from "react";
+import { Link } from "react-router-dom";
+import { preorderWhatsAppUrl, type JewelPiece } from "@/data/jewellery";
+import { cartLineFor } from "@/lib/variants";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { BIRTHSTONE_HANDLE, MONTH_OPTION, variantForMonth, type Stone } from "@/lib/portal/stones";
+import { stillMotion } from "@/lib/portal/motion";
+import type { BagLine } from "./MemberContext";
+import { StoneHead } from "./StoneArt";
+import Sprig from "./Sprig";
+import { eyebrow, primaryButton, quietButton, textLink } from "./styles";
+
+/*
+  The specimen card: her month pressed like a herbarium sheet, which turns
+  over (a tap, or a drag that follows her finger) to the live Birthstone Heart
+  Necklace with that month already chosen. Everything on the back is the
+  listing's own: the variant's name ("July · Ruby"), its photo, its live ₹
+  price and compare-at, Available or Sold out from Shopify, and the pendant
+  and plating lines from its details. A month that cannot be bought is
+  reserved on WhatsApp, as on the product page; nothing is ever promised that
+  the listing does not say.
+*/
+
+export type ShopStatus = "loading" | "ready" | "missing" | "offline";
+
+type Props = {
+  stone: Stone;
+  piece: JewelPiece | undefined;
+  status: ShopStatus;
+  own: boolean;
+  preview?: boolean;
+  onAdd: (line: BagLine) => Promise<void>;
+};
+
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
+const pad2 = (n: number) => String(n).padStart(2, "0");
+
+const setInert = (el: HTMLElement | null, inert: boolean) => {
+  if (!el) return;
+  (el as HTMLElement & { inert?: boolean }).inert = inert;
+  if (inert) el.setAttribute("aria-hidden", "true");
+  else el.removeAttribute("aria-hidden");
+};
+
+const StoneCard = ({ stone, piece, status, own, preview = false, onAdd }: Props) => {
+  const [flipped, setFlipped] = useState(false);
+  const [adding, setAdding] = useState<"idle" | "busy" | "done">("idle");
+  const innerRef = useRef<HTMLDivElement>(null);
+  const frontRef = useRef<HTMLButtonElement>(null);
+  const backRef = useRef<HTMLDivElement>(null);
+  const drag = useRef<{ x: number; id: number; moved: boolean } | null>(null);
+  const swallowClick = useRef(false);
+
+  const variant = variantForMonth(piece, stone.month);
+  const name = variant?.options[MONTH_OPTION] ?? stone.variant;
+  const price = variant?.price ?? piece?.price;
+  const compare = variant?.compareAtPrice ?? piece?.compareAtPrice;
+  const available = status === "ready" && Boolean(variant?.availableForSale);
+  const image = variant?.image ?? piece?.image;
+  const facts = (piece?.details ?? []).filter((line) => /^(Pendant|Plating):/i.test(line));
+
+  useEffect(() => {
+    setInert(frontRef.current, flipped);
+    setInert(backRef.current, !flipped);
+  }, [flipped]);
+
+  useEffect(() => setAdding("idle"), [stone.month]);
+
+  const onPointerDown = (e: ReactPointerEvent<HTMLButtonElement>) => {
+    if (stillMotion()) return;
+    drag.current = { x: e.clientX, id: e.pointerId, moved: false };
+  };
+  const onPointerMove = (e: ReactPointerEvent<HTMLButtonElement>) => {
+    const d = drag.current;
+    const inner = innerRef.current;
+    if (!d || !inner) return;
+    const dx = e.clientX - d.x;
+    if (!d.moved && Math.abs(dx) < 8) return;
+    if (!d.moved) {
+      d.moved = true;
+      try {
+        e.currentTarget.setPointerCapture(d.id);
+      } catch {
+        /* capture is a nicety */
+      }
+    }
+    inner.style.transition = "none";
+    inner.style.transform = `rotateY(${Math.max(-180, Math.min(180, dx * 0.55))}deg)`;
+  };
+  const onPointerUp = (e: ReactPointerEvent<HTMLButtonElement>) => {
+    const d = drag.current;
+    drag.current = null;
+    const inner = innerRef.current;
+    if (!d?.moved || !inner) return;
+    swallowClick.current = true;
+    inner.style.transition = "";
+    inner.style.transform = "";
+    if (Math.abs(e.clientX - d.x) > 60) setFlipped(true);
+  };
+
+  const add = async () => {
+    if (!piece || !variant) return;
+    setAdding("busy");
+    await onAdd(cartLineFor(piece, variant));
+    setAdding("done");
+  };
+
+  return (
+    <div className={`ig-card3d${flipped ? " is-flipped" : ""}`} style={{ ["--ig-hue" as string]: stone.hue }}>
+      <div ref={innerRef} className="ig-card-inner">
+        <button
+          ref={frontRef}
+          type="button"
+          className="ig-face ig-face--front"
+          onClick={() => {
+            if (swallowClick.current) {
+              swallowClick.current = false;
+              return;
+            }
+            setFlipped(true);
+          }}
+          onPointerDown={onPointerDown}
+          onPointerMove={onPointerMove}
+          onPointerUp={onPointerUp}
+          onPointerCancel={() => {
+            drag.current = null;
+            if (innerRef.current) innerRef.current.style.transform = "";
+          }}
+          aria-label={`${name}. Turn the card over to see the necklace in ${stone.monthName}'s colour.`}
+        >
+          <Sprig className="ig-corner ig-corner--tl" />
+          <Sprig className="ig-corner ig-corner--br" />
+          <span className="ig-specimen-no">Specimen No. {pad2(stone.month)}</span>
+          <StoneHead stone={stone} size={150} className="ig-specimen-head" />
+          <span className="ig-specimen-label">
+            <span className="ig-specimen-row">
+              <span>Month</span>
+              <span>{stone.monthName}</span>
+            </span>
+            <span className="ig-specimen-row">
+              <span>Stone</span>
+              <span>{name}</span>
+            </span>
+            <span className="ig-specimen-row">
+              <span>Birth flower</span>
+              <span>{stone.flower}</span>
+            </span>
+          </span>
+          <span className="ig-specimen-note">{own ? "Yours, in your month's colour" : "In this month's colour"}</span>
+          <span className="ig-turn">Turn over ↻</span>
+        </button>
+
+        <div ref={backRef} className="ig-face ig-face--back">
+          {status === "loading" && (
+            <div className="ig-back-wait" role="status">
+              <span className="ig-back-photo atelier-shimmer" />
+              <p className="ig-card-title">{name}</p>
+              <p className="ig-fineprint">Reading today's price from the shop…</p>
+            </div>
+          )}
+          {status === "missing" && (
+            <div className="ig-back-wait">
+              <p className="ig-card-title">{name}</p>
+              <p className="ig-fineprint">The Birthstone Heart Necklace isn't in the shop right now.</p>
+              <a
+                className={textLink}
+                href={preorderWhatsAppUrl({ name: "Birthstone Heart Necklace", handle: BIRTHSTONE_HANDLE, choice: name })}
+                target="_blank"
+                rel="noopener noreferrer"
+              >
+                Ask on WhatsApp
+              </a>
+            </div>
+          )}
+          {status === "offline" && (
+            <div className="ig-back-wait">
+              <p className="ig-card-title">{name}</p>
+              <p className="ig-fineprint">We couldn't reach the shop just now.</p>
+              <Link className={textLink} to={`/jewellery/${BIRTHSTONE_HANDLE}`}>
+                See the piece
+              </Link>
+            </div>
+          )}
+          {status === "ready" && piece && (
+            <>
+              {image && (
+                <img
+                  className="ig-back-photo"
+                  src={shopifyImage(image, 480)}
+                  srcSet={shopifySrcSet(image, [240, 360, 480]) || undefined}
+                  sizes="(min-width: 768px) 320px, 80vw"
+                  width={480}
+                  height={480}
+                  loading="lazy"
+                  decoding="async"
+                  alt={`${piece.name}, ${name}`}
+                />
+              )}
+              <p className={eyebrow}>{piece.name}</p>
+              <p className="ig-card-title">{name}</p>
+              {price !== undefined && (
+                <p className="ig-price">
+                  <span>{rupees(price)}</span>
+                  {compare && compare > price ? <s>{rupees(compare)}</s> : null}
+                  <span className={available ? "ig-stock" : "ig-stock ig-stock--out"}>{available ? "Available" : "Sold out"}</span>
+                </p>
+              )}
+              {available ? (
+                <button type="button" className={primaryButton} onClick={add} disabled={adding === "busy"}>
+                  {adding === "busy" ? "Adding…" : "Add to bag"}
+                </button>
+              ) : (
+                <a
+                  className={primaryButton}
+                  href={preorderWhatsAppUrl({ name: piece.name, handle: piece.handle, priceLabel: price !== undefined ? rupees(price) : undefined, choice: name })}
+                  target="_blank"
+                  rel="noopener noreferrer"
+                >
+                  Reserve on WhatsApp
+                </a>
+              )}
+              {adding === "done" && (
+                <p className="ig-fineprint" role="status">
+                  {preview ? "Preview only: nothing was added to a bag." : "In your bag."}
+                </p>
+              )}
+              {facts.length > 0 && (
+                <ul className="ig-facts">
+                  {facts.map((f) => (
+                    <li key={f}>{f}</li>
+                  ))}
+                </ul>
+              )}
+              <Link className={textLink} to={`/jewellery/${BIRTHSTONE_HANDLE}`}>
+                See the piece
+              </Link>
+            </>
+          )}
+          <button type="button" className={quietButton} onClick={() => setFlipped(false)}>
+            Turn back
+          </button>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default StoneCard;
diff --git a/src/components/portal/styles.ts b/src/components/portal/styles.ts
new file mode 100644
index 0000000..e100d80
--- /dev/null
+++ b/src/components/portal/styles.ts
@@ -0,0 +1,13 @@
+/*
+  The portal's buttons and type, matched to the product page and the try-on
+  (ink Add to cart, its outline twin, the gold-underlined link, the small gold
+  eyebrow; square corners). They are classes in src/pages/members/members.css,
+  not Tailwind utilities: anything new in a utility would compile into the one
+  global stylesheet the product page downloads.
+*/
+
+export const primaryButton = "ig-btn";
+export const outlineButton = "ig-btn ig-btn--outline";
+export const quietButton = "ig-quiet";
+export const textLink = "ig-link";
+export const eyebrow = "ig-eyebrow";
