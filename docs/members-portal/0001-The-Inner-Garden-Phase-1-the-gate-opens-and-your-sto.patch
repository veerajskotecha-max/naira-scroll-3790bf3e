@@ -0,0 +1,41 @@
+/*
+  Vines for the gate and the garden's arbour: a chain of cubic curves, with
+  leaves set alternately along it. Computed once, at module load.
+*/
+
+/** x0 y0 c1x c1y c2x c2y x1 y1 */
+export type Seg = readonly [number, number, number, number, number, number, number, number];
+
+export const bez = (t: number, a: number, b: number, c: number, d: number) =>
+  (1 - t) ** 3 * a + 3 * (1 - t) ** 2 * t * b + 3 * (1 - t) * t ** 2 * c + t ** 3 * d;
+
+export const chainPath = (segs: readonly Seg[]) =>
+  `M${segs[0][0]} ${segs[0][1]}` + segs.map((s) => `C${s[2]} ${s[3]} ${s[4]} ${s[5]} ${s[6]} ${s[7]}`).join("");
+
+/** The point at t (0..1 over the whole chain) and the direction there, in degrees. */
+export const pointOn = (segs: readonly Seg[], t: number): [number, number, number] => {
+  const n = segs.length;
+  const i = Math.min(n - 1, Math.floor(t * n));
+  const u = t * n - i;
+  const [x0, y0, x1, y1, x2, y2, x3, y3] = segs[i];
+  const x = bez(u, x0, x1, x2, x3);
+  const y = bez(u, y0, y1, y2, y3);
+  const v = Math.min(1, u + 0.02);
+  const dx = bez(v, x0, x1, x2, x3) - x;
+  const dy = bez(v, y0, y1, y2, y3) - y;
+  return [x, y, (Math.atan2(dy, dx) * 180) / Math.PI];
+};
+
+export type Leaf = { x: number; y: number; a: number };
+
+/** Leaves at each t, turning out from the stem to alternate sides. */
+export const leavesAlong = (segs: readonly Seg[], ts: readonly number[], reach = 7, splay = 52): Leaf[] =>
+  ts.map((t, i) => {
+    const [x, y, a] = pointOn(segs, t);
+    const ang = a + (i % 2 ? splay : -splay);
+    const r = (ang * Math.PI) / 180;
+    return { x: x + Math.cos(r) * reach, y: y + Math.sin(r) * reach, a: ang };
+  });
+
+export const mirrorSegs = (segs: readonly Seg[], width: number): Seg[] =>
+  segs.map((s) => [width - s[0], s[1], width - s[2], s[3], width - s[4], s[5], width - s[6], s[7]] as const);
