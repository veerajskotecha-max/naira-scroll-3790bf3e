@@ -0,0 +1,52 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { PORTAL_KEY, readPortal, safeGet, safeRemove, safeSet, writePortal } from "./safeStorage";
+
+/* Instagram's in-app browser, private windows and "Block all cookies" make
+   localStorage throw on any touch. A throw in a render takes the page down,
+   so blocked storage must read as a first visit and never as an error. */
+afterEach(() => {
+  vi.restoreAllMocks();
+  window.localStorage.clear();
+});
+
+describe("safeStorage", () => {
+  it("keeps and merges the portal's flags", () => {
+    expect(readPortal()).toEqual({});
+    expect(writePortal({ doorsDay: "2026-11-05" })).toBe(true);
+    writePortal({ seedSeen: true });
+    expect(readPortal()).toEqual({ doorsDay: "2026-11-05", seedSeen: true });
+  });
+
+  it("reads a corrupt entry as empty", () => {
+    window.localStorage.setItem(PORTAL_KEY, "{not json");
+    expect(readPortal()).toEqual({});
+    window.localStorage.setItem(PORTAL_KEY, "[1,2]");
+    expect(readPortal()).toEqual({});
+  });
+
+  it("never throws when storage does", () => {
+    vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => {
+      throw new DOMException("denied", "SecurityError");
+    });
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => {
+      throw new DOMException("full", "QuotaExceededError");
+    });
+    vi.spyOn(Storage.prototype, "removeItem").mockImplementation(() => {
+      throw new DOMException("denied", "SecurityError");
+    });
+    expect(() => readPortal()).not.toThrow();
+    expect(readPortal()).toEqual({});
+    expect(writePortal({ seedSeen: true })).toBe(false);
+    expect(safeGet("x", "session")).toBeNull();
+    expect(safeSet("x", "1", "session")).toBe(false);
+    expect(() => safeRemove("x")).not.toThrow();
+  });
+
+  it("never throws when the storage object itself is out of reach", () => {
+    vi.spyOn(window, "localStorage", "get").mockImplementation(() => {
+      throw new DOMException("denied", "SecurityError");
+    });
+    expect(readPortal()).toEqual({});
+    expect(writePortal({ doorsDay: "2026-11-05" })).toBe(false);
+  });
+});
diff --git a/src/lib/portal/safeStorage.ts b/src/lib/portal/safeStorage.ts
new file mode 100644
index 0000000..e0f83af
--- /dev/null
+++ b/src/lib/portal/safeStorage.ts
@@ -0,0 +1,69 @@
+/*
+  The portal's device conveniences: which IST day the gates last opened in
+  full, whether the seed ceremony has been seen. Instagram's in-app browser,
+  "Block all cookies" and private windows can make localStorage throw on any
+  access, and a throw inside a render or effect takes the page down with it.
+  Every read and write goes through here, so an empty or broken store only
+  ever means "first visit".
+*/
+
+export const PORTAL_KEY = "naira-portal";
+
+export type PortalStore = {
+  /** IST day (YYYY-MM-DD) the full Doors entrance last played on this device. */
+  doorsDay?: string;
+  /** The first-visit seed ceremony on Your stone has been seen or skipped. */
+  seedSeen?: boolean;
+};
+
+type Area = "local" | "session";
+
+const areaOf = (area: Area): Storage | null => {
+  try {
+    return area === "local" ? window.localStorage : window.sessionStorage;
+  } catch {
+    return null;
+  }
+};
+
+export const safeGet = (key: string, area: Area = "local"): string | null => {
+  try {
+    return areaOf(area)?.getItem(key) ?? null;
+  } catch {
+    return null;
+  }
+};
+
+export const safeSet = (key: string, value: string, area: Area = "local"): boolean => {
+  try {
+    const store = areaOf(area);
+    if (!store) return false;
+    store.setItem(key, value);
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+export const safeRemove = (key: string, area: Area = "local"): void => {
+  try {
+    areaOf(area)?.removeItem(key);
+  } catch {
+    /* blocked storage: nothing to remove */
+  }
+};
+
+export const readPortal = (): PortalStore => {
+  const raw = safeGet(PORTAL_KEY);
+  if (!raw) return {};
+  try {
+    const parsed: unknown = JSON.parse(raw);
+    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? (parsed as PortalStore) : {};
+  } catch {
+    return {};
+  }
+};
+
+/** Merges `patch` into the stored object; false when the device would not keep it. */
+export const writePortal = (patch: Partial<PortalStore>): boolean =>
+  safeSet(PORTAL_KEY, JSON.stringify({ ...readPortal(), ...patch }));
