new file mode 100644
index 0000000..ad2d626
--- /dev/null
+++ b/src/lib/portal/isolation.test.ts
@@ -0,0 +1,111 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+
+/*
+  The portal must cost the shop nothing. A portal module imported by the
+  product page, the bag or the header would ride in their download; a shop
+  module imported for the first time by the portal and one other route would
+  be split by Rollup into a new chunk the shop then fetches. So:
+  - only pageCode.ts reaches the portal's route, and only Auth.tsx borrows
+    one portal helper (the in-app browser check);
+  - the product page, bag, checkout and header import nothing of the portal;
+  - portal code imports only what already sits in the main or shared chunks.
+*/
+
+const src = resolve(__dirname, "../..");
+const files = (dir: string): string[] =>
+  readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
+    e.isDirectory() ? files(join(dir, e.name)) : /\.(tsx?|css)$/.test(e.name) ? [join(dir, e.name)] : [],
+  );
+const all = files(src).map((f) => relative(src, f).split("\\").join("/"));
+const isTest = (f: string) => /\.test\.tsx?$/.test(f);
+const isPortal = (f: string) => /^(pages\/members|components\/portal|lib\/portal)\//.test(f);
+
+const IMPORT = /(?:import|export)\s[^'";]*?from\s*["']([^"']+)["']|import\s*\(\s*["']([^"']+)["']\s*\)|import\s+["']([^"']+)["']/g;
+const importsOf = (f: string) =>
+  [...readFileSync(join(src, f), "utf8").matchAll(IMPORT)].map((m) => m[1] ?? m[2] ?? m[3]);
+
+/* Where an import lands, as a path under src (or the bare package name). */
+const target = (from: string, spec: string) => {
+  if (spec.startsWith("@/")) return spec.slice(2);
+  if (spec.startsWith(".")) {
+    const parts = from.split("/").slice(0, -1);
+    for (const seg of spec.split("/")) {
+      if (seg === "..") parts.pop();
+      else if (seg !== ".") parts.push(seg);
+    }
+    return parts.join("/");
+  }
+  return spec;
+};
+
+const reachesPortal = (t: string) => /^(pages\/members|components\/portal|lib\/portal)(\/|$)/.test(t);
+
+describe("the portal's isolation", () => {
+  it("finds the portal and the shop", () => {
+    expect(all.filter(isPortal).length).toBeGreaterThan(20);
+    expect(all).toContain("pages/JewelDetailNext.tsx");
+  });
+
+  it("is reached only from pageCode.ts, plus Auth's in-app browser check", () => {
+    const outside = all
+      .filter((f) => !isPortal(f) && !isTest(f))
+      .flatMap((f) => importsOf(f).map((spec) => [f, target(f, spec)] as const))
+      .filter(([, t]) => reachesPortal(t))
+      .map(([f, t]) => `${f} -> ${t.replace(/\.tsx?$/, "")}`);
+    expect(outside.sort()).toEqual(["pageCode.ts -> pages/members/MembersRoute", "pages/Auth.tsx -> lib/portal/inAppBrowser"]);
+  });
+
+  it("is never imported by the product page, the bag, checkout or the header", () => {
+    const shop = all.filter(
+      (f) =>
+        !isTest(f) &&
+        (/^pages\/(JewelDetailNext|ProductDetail)/.test(f) ||
+          /^components\/(cart|checkout)\//.test(f) ||
+          /^contexts\/CartContext/.test(f) ||
+          /^components\/(Header|Navbar|CartDrawer)/.test(f)),
+    );
+    expect(shop.length).toBeGreaterThan(5);
+    const offenders = shop.flatMap((f) => importsOf(f).filter((s) => reachesPortal(target(f, s))).map((s) => `${f}: ${s}`));
+    expect(offenders).toEqual([]);
+  });
+
+  /* Each of these is already in the main bundle or an existing shared chunk
+     (checked against the build: index, PageSEO, Footer, JoinInnerCircleForm,
+     shopifyImage, background_image_flora). Anything new needs the same check. */
+  const ALLOWED = new Set([
+    "react",
+    "react-router-dom",
+    "@supabase/supabase-js",
+    "contexts/AuthContext",
+    "contexts/CartContext",
+    "hooks/useLiveJewellery",
+    "lib/variants",
+    "data/jewellery",
+    "lib/nairaFlower/outline",
+    "components/PageSEO",
+    "components/Footer",
+    "components/members/JoinInnerCircleForm",
+    "lib/shopifyImage",
+    "integrations/supabase/lazy",
+  ]);
+
+  it("imports only modules the shop already ships, or its own", () => {
+    const offenders = all
+      .filter((f) => isPortal(f) && !isTest(f))
+      .flatMap((f) => importsOf(f).map((spec) => [f, target(f, spec)] as const))
+      .filter(([, t]) => !reachesPortal(t) && !ALLOWED.has(t))
+      .map(([f, t]) => `${f}: ${t}`);
+    expect(offenders).toEqual([]);
+  });
+
+  /* lucide icons all compile into the "ui" chunk every page downloads, so a
+     new icon here would grow every page; the portal draws its own. */
+  it("brings in no icon library and none of the shop's invented social proof", () => {
+    const bad = all
+      .filter((f) => isPortal(f) && !isTest(f))
+      .flatMap((f) => importsOf(f).filter((s) => /lucide|FomoPopup|JewelTrustStrip|dailySold|framer-motion|lottie|gsap|three/.test(s)).map((s) => `${f}: ${s}`));
+    expect(bad).toEqual([]);
+  });
+});
