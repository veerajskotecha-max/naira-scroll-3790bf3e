+  backface-visibility: hidden;
+}
+.ig-face--front { justify-content: center; cursor: pointer; touch-action: pan-y; user-select: none; -webkit-tap-highlight-color: transparent; }
+.ig-face--back { transform: rotateY(180deg); }
+.ig-corner { position: absolute; width: 78px; height: 78px; pointer-events: none; }
+.ig-corner--tl { top: -4px; left: -4px; transform: scaleX(-1); }
+.ig-corner--br { right: -4px; bottom: -4px; transform: scaleY(-1); }
+.ig-specimen-no {
+  font-family: var(--nf-font-label);
+  font-size: 10px;
+  letter-spacing: var(--nf-track-28);
+  text-transform: uppercase;
+  color: var(--nf-gold-text);
+}
+.ig-specimen-label { display: block; width: 100%; border-top: 1px solid var(--ig-gold-line); }
+.ig-specimen-row {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 0.5rem 0.2rem;
+  border-bottom: 1px solid var(--ig-line);
+}
+.ig-specimen-row span:first-child {
+  font-family: var(--nf-font-label);
+  font-size: 9.5px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.58);
+}
+.ig-specimen-row span:last-child { font-family: var(--nf-font-editorial); font-size: 1.14rem; text-align: right; }
+.ig-specimen-note { font-family: var(--nf-font-editorial); font-style: italic; font-size: 1.02rem; color: rgb(var(--nf-ink-rgb) / 0.72); }
+.ig-turn {
+  font-family: var(--nf-font-label);
+  font-size: 10px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: var(--nf-gold-text);
+}
+.ig-back-photo { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; background: var(--nf-surface-raised); }
+.ig-back-wait { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; width: 100%; }
+.ig-price { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0.6rem; margin: 0; font-family: var(--nf-font-label); font-size: 16px; }
+.ig-price s { font-size: 13px; color: rgb(var(--nf-ink-rgb) / 0.5); }
+.ig-stock { font-size: 10px; letter-spacing: var(--nf-track-20); text-transform: uppercase; color: var(--nf-cta); }
+.ig-stock--out { color: rgb(var(--nf-ink-rgb) / 0.6); }
+.ig-facts {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  font-family: var(--nf-font-label);
+  font-size: 11.5px;
+  line-height: 1.55;
+  color: rgb(var(--nf-ink-rgb) / 0.66);
+}
+.ig-months { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin: 1rem 0 0; padding: 0; list-style: none; }
+.ig-month {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  width: 100%;
+  min-height: 64px;
+  border: 1px solid var(--ig-line);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 10px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.75);
+  cursor: pointer;
+}
+.ig-month[aria-pressed="true"] { border-color: var(--nf-accent-strong); background: var(--ig-vellum); color: var(--nf-ink); }
+.ig-month-own {
+  position: absolute;
+  top: 3px;
+  right: 4px;
+  font-size: 7.5px;
+  letter-spacing: var(--nf-track-10);
+  color: var(--nf-gold-text);
+}
+
+@media (min-width: 768px) {
+  .ig-months { grid-template-columns: repeat(6, 1fr); }
+  .ig-gate-page,
+  .ig-home,
+  .ig-stone-page { padding-top: 2rem; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ig-card-inner,
+  .ig-btn,
+  .ig-card-link { transition: none; }
+}
