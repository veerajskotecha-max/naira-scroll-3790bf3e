+import type { User } from "@supabase/supabase-js";
+import type { MemberProfile } from "@/contexts/AuthContext";
+import { PORTAL_KEY, safeRemove } from "./safeStorage";
+
+/*
+  DEVELOPMENT ONLY. A stand-in member so the portal can be seen signed in
+  without creating an account or touching the live Supabase or Shopify:
+
+    /members?portalPreview=1&name=Ananya&birthday=1999-07-14
+
+  MembersRoute reaches this only behind `import.meta.env.DEV`, which Vite
+  replaces with false in a production build, so the build drops this module
+  (the build check greps dist for its query name). Every write the preview
+  would make is logged to the console instead.
+
+  Extra switches: joined=2026-11-04 (the planted date), reset=1 (forget this
+  device's Doors and seed-ceremony flags, to see them again).
+*/
+
+export type PreviewMember = { user: User; profile: MemberProfile };
+
+const DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+export const readPreviewMember = (search: string): PreviewMember | null => {
+  const q = new URLSearchParams(search);
+  if (q.get("portalPreview") !== "1") return null;
+  if (q.get("reset") === "1") safeRemove(PORTAL_KEY);
+  const name = (q.get("name") ?? "Ananya").trim().slice(0, 40) || "Ananya";
+  const birthday = q.get("birthday") ?? "";
+  const joined = q.get("joined") ?? "";
+  const id = `preview-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
+  const user = {
+    id,
+    aud: "authenticated",
+    email: `${id}@example.invalid`,
+    created_at: DATE.test(joined) ? `${joined}T10:00:00+05:30` : "2026-11-04T10:00:00+05:30",
+    app_metadata: {},
+    user_metadata: { full_name: name },
+  } as unknown as User;
+  const profile: MemberProfile = {
+    id,
+    full_name: name,
+    phone: null,
+    birthday: DATE.test(birthday) ? birthday : null,
+    city: null,
+  };
+  return { user, profile };
+};
+
+export const logPreviewWrite = (what: string, detail: unknown) => {
+  console.info(`[portal preview] not written: ${what}`, detail);
+};
