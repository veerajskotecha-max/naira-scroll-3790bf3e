+import { istDayKey } from "./ist";
+import { readPortal, writePortal } from "./safeStorage";
+import { stillMotion } from "./motion";
+
+/* Full on the first visit of each IST day on this device, short after that. */
+export const doorsModeFor = (lastFullDay: string | undefined, today: string): "full" | "short" =>
+  lastFullDay === today ? "short" : "full";
+
+/**
+ * Which entrance to play now. Null under reduced motion (the garden is simply
+ * open) or when the Doors already played this visit. With storage blocked
+ * every visit reads as the day's first: harmless.
+ */
+export const pickDoors = (alreadyPlayed: boolean, now: Date = new Date()): "full" | "short" | null => {
+  if (alreadyPlayed || stillMotion()) return null;
+  return doorsModeFor(readPortal().doorsDay, istDayKey(now));
+};
+
+/** Notes that today's full entrance has played on this device. */
+export const recordFullDoors = (now: Date = new Date()) => writePortal({ doorsDay: istDayKey(now) });
