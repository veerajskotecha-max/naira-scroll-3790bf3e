--- /dev/null
+++ b/src/components/portal/PetalBurst.ts
@@ -0,0 +1,58 @@
+import { PETAL_IDS } from "./PetalSymbols";
+import { play, stillMotion } from "@/lib/portal/motion";
+
+/*
+  A burst of flat petals from one point (the gate's latch, a saved stone).
+  At most 24, each a small <svg><use> moved with transform and opacity only,
+  and each removed the moment its flight ends, so nothing is left behind for
+  the compositor. Nothing at all under reduced motion.
+*/
+
+export const MAX_PETALS = 24;
+const SVG = "http://www.w3.org/2000/svg";
+
+type Options = { count?: number; spread?: number; duration?: number; delay?: number };
+
+export const burstPetals = (layer: HTMLElement | null, x: number, y: number, options: Options = {}): Animation[] => {
+  if (!layer || stillMotion()) return [];
+  const count = Math.min(MAX_PETALS, Math.max(0, options.count ?? 18));
+  const spread = options.spread ?? 120;
+  const duration = options.duration ?? 820;
+  const out: Animation[] = [];
+  for (let i = 0; i < count; i++) {
+    const svg = document.createElementNS(SVG, "svg");
+    svg.setAttribute("viewBox", "0 0 20 20");
+    svg.setAttribute("aria-hidden", "true");
+    svg.setAttribute("class", "ig-petal");
+    const size = 9 + Math.random() * 9;
+    svg.style.cssText = `left:${x}px;top:${y}px;width:${size}px;height:${size}px`;
+    const use = document.createElementNS(SVG, "use");
+    use.setAttribute("href", `#${PETAL_IDS[i % PETAL_IDS.length]}`);
+    svg.appendChild(use);
+    layer.appendChild(svg);
+
+    const angle = (i / count) * Math.PI * 2 + Math.random() * 0.5;
+    const dist = spread * (0.55 + Math.random() * 0.6);
+    const dx = Math.cos(angle) * dist;
+    const dy = Math.sin(angle) * dist * 0.8;
+    const turn = (Math.random() - 0.5) * 540;
+    const a = play(
+      svg,
+      [
+        { transform: "translate(-50%,-50%) translate(0,0) rotate(0deg) scale(.3)", opacity: 0 },
+        { transform: `translate(-50%,-50%) translate(${dx * 0.62}px,${dy * 0.62 - 18}px) rotate(${turn * 0.6}deg) scale(1)`, opacity: 1, offset: 0.45 },
+        { transform: `translate(-50%,-50%) translate(${dx}px,${dy + 34}px) rotate(${turn}deg) scale(.85)`, opacity: 0 },
+      ],
+      { duration: duration * (0.8 + Math.random() * 0.35), delay: (options.delay ?? 0) + Math.random() * 60, easing: "cubic-bezier(0.2, 0.7, 0.3, 1)", fill: "both" },
+    );
+    if (!a) {
+      svg.remove();
+      continue;
+    }
+    const done = () => svg.remove();
+    a.onfinish = done;
+    a.oncancel = done;
+    out.push(a);
+  }
+  return out;
+};
