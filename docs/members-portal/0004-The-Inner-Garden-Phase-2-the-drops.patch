@@ -0,0 +1,34 @@
+/*
+  How the drop's gift box (components/portal/DropBox) is held and how its
+  drawer sits: the bag box's own numbers (components/giftbox/pose.ts and
+  lib/nairaBox/config), repeated here so the portal shares no module with the
+  footer's three.js box.
+*/
+
+export type BoxPose = { tilt: number; turn: number };
+export const REST_POSE: BoxPose = { tilt: -22, turn: -14 };
+export const PEEK_POSE: BoxPose = { tilt: -40, turn: 18 };
+
+const BOX = { w: 1.6, d: 1.6, h: 0.7 };
+export const COLOURS = { cardDeep: "#C9A69E", rim: "#E8D2CB", velvet: "#141112" };
+export const SLOT = 0.56;
+
+export const poseTransform = ({ tilt, turn }: BoxPose) => `rotateX(${tilt}deg) rotateY(${turn}deg)`;
+
+export const boxGeometry = (size: number) => {
+  const W = size;
+  const D = size * (BOX.d / BOX.w);
+  const H = Math.round(size * (BOX.h / BOX.w));
+  return { W, D, H, travel: D * 0.5 };
+};
+
+export const drawerTransforms = (size: number, open: number) => {
+  const { D, travel } = boxGeometry(size);
+  const home = (1 - open) * travel;
+  return {
+    front: `translateZ(${D / 2 + open * travel}px)`,
+    tray: `translateY(${-home}px)`,
+    right: `translateX(${home}px)`,
+    left: `translateX(${-home}px)`,
+  };
+};
diff --git a/src/lib/portal/clock.test.ts b/src/lib/portal/clock.test.ts
new file mode 100644
index 0000000..5779fbd
--- /dev/null
+++ b/src/lib/portal/clock.test.ts
@@ -0,0 +1,75 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { measureServerOffset, nextTickAt, offsetFrom, resetServerClock, serverNow } from "./clock";
+
+/* The drop clock keeps the server's time: a phone set five minutes fast
+   must not open the bud early. One HEAD request's Date header sets the
+   offset; anything odd falls back to the phone's own clock. */
+
+afterEach(() => {
+  resetServerClock();
+  vi.restoreAllMocks();
+});
+
+const headers = (h: Record<string, string>) => ({ headers: { get: (k: string) => h[k.toLowerCase()] ?? null } }) as unknown as Response;
+
+describe("offsetFrom", () => {
+  it("reads the Date header against the middle of the round trip", () => {
+    // Sent at 10:00:00.000, answered at 10:00:00.400 on the phone; the server said 10:05:00 (whole seconds).
+    const sent = Date.parse("2026-11-21T10:00:00.000Z");
+    const offset = offsetFrom({ sent, received: sent + 400, date: "Sat, 21 Nov 2026 10:05:00 GMT" });
+    // 10:05:00.500 (the half second the header drops) minus 10:00:00.200.
+    expect(offset).toBe(5 * 60_000 + 300);
+  });
+
+  it("adds the Age a cache held the answer for", () => {
+    const sent = Date.parse("2026-11-21T10:00:00.000Z");
+    expect(offsetFrom({ sent, received: sent, date: "Sat, 21 Nov 2026 09:59:00 GMT", age: "60" })).toBe(500);
+  });
+
+  it("falls back on a missing, unreadable or absurd header", () => {
+    const sent = Date.now();
+    expect(offsetFrom({ sent, received: sent + 10, date: null })).toBeNull();
+    expect(offsetFrom({ sent, received: sent + 10, date: "yesterday-ish" })).toBeNull();
+    expect(offsetFrom({ sent, received: sent + 10, date: "Mon, 01 Jan 2024 00:00:00 GMT" })).toBeNull();
+    expect(offsetFrom({ sent, received: sent - 10, date: new Date(sent).toUTCString() })).toBeNull();
+  });
+});
+
+describe("measureServerOffset", () => {
+  it("asks the same origin once, with HEAD and no cache, and keeps the answer", async () => {
+    let t = Date.parse("2026-11-21T10:00:00.000Z");
+    const now = () => t;
+    const doFetch = vi.fn(async (_url: string, _init?: RequestInit) => {
+      t += 200;
+      return headers({ date: "Sat, 21 Nov 2026 10:02:00 GMT" });
+    });
+    const offset = await measureServerOffset(doFetch, now);
+    expect(offset).toBe(2 * 60_000 + 400);
+    expect(doFetch).toHaveBeenCalledTimes(1);
+    const [url, init] = doFetch.mock.calls[0];
+    expect(url.startsWith(`${window.location.origin}/`)).toBe(true);
+    expect(init).toMatchObject({ method: "HEAD", cache: "no-store", credentials: "same-origin" });
+    await measureServerOffset(doFetch, now);
+    expect(doFetch).toHaveBeenCalledTimes(1);
+    vi.spyOn(Date, "now").mockReturnValue(1_000_000);
+    expect(serverNow()).toBe(1_000_000 + offset);
+  });
+
+  it("uses the phone's clock when the request fails", async () => {
+    const offset = await measureServerOffset(async () => {
+      throw new Error("offline");
+    });
+    expect(offset).toBe(0);
+    vi.spyOn(Date, "now").mockReturnValue(42);
+    expect(serverNow()).toBe(42);
+  });
+});
+
+describe("the minute tick", () => {
+  it("is due at the next minute boundary, or a sooner mark", () => {
+    const t = Date.parse("2026-11-21T10:00:30.000Z");
+    expect(nextTickAt(t)).toBe(Date.parse("2026-11-21T10:01:00.000Z"));
+    expect(nextTickAt(t, [t + 5_000, t - 5_000])).toBe(t + 5_000);
+    expect(nextTickAt(t, [t + 120_000])).toBe(Date.parse("2026-11-21T10:01:00.000Z"));
+  });
+});
diff --git a/src/lib/portal/clock.ts b/src/lib/portal/clock.ts
new file mode 100644
index 0000000..15a36f5
--- /dev/null
+++ b/src/lib/portal/clock.ts
@@ -0,0 +1,131 @@
+import { useEffect, useState } from "react";
+import { MINUTE } from "./dropPhase";
+
+/*
+  The drop clock keeps the server's time, not the phone's. A phone set five
+  minutes fast would otherwise open the bud before the shop does, and one set
+  a day wrong would count to the wrong day. One same-origin HEAD request per
+  visit reads the host's Date header (plus Age, when a cache answered) and
+  sets it against the middle of the round trip; the difference is the offset
+  every countdown adds to Date.now(). No answer, no header, or a nonsense one
+  (more than a week out) means the phone's own clock, which is right for
+  nearly everyone.
+
+  The minute tick that drives the countdown is one timer, set for the next
+  minute boundary (or the next phase change, if sooner), and re-read when the
+  tab comes back: no animation loop, nothing running between minutes.
+*/
+
+const MAX_OFFSET_MS = 7 * 24 * 60 * MINUTE;
+const PROBE_TIMEOUT_MS = 4000;
+
+export type Probe = {
+  /** Device time the request went out and the answer came back. */
+  sent: number;
+  received: number;
+  /** The answer's Date header (an HTTP date, whole seconds). */
+  date: string | null;
+  /** The answer's Age header (seconds a cache held it), if any. */
+  age?: string | null;
+};
+
+/** The server's clock minus the device's, in ms, or null when the answer cannot tell. */
+export const offsetFrom = ({ sent, received, date, age }: Probe): number | null => {
+  if (!date || !(received >= sent)) return null;
+  const stamped = Date.parse(date);
+  if (Number.isNaN(stamped)) return null;
+  const held = Number(age);
+  // The header drops the milliseconds: on average the true time is half a second on.
+  const server = stamped + 500 + (Number.isFinite(held) && held > 0 ? held * 1000 : 0);
+  const offset = server - (sent + (received - sent) / 2);
+  return Math.abs(offset) > MAX_OFFSET_MS ? null : Math.round(offset);
+};
+
+let offsetMs = 0;
+let measuring: Promise<number> | null = null;
+
+type Fetcher = (input: string, init?: RequestInit) => Promise<Response>;
+
+/** Reads the offset once per page visit; resolves to 0 (the device's clock) on any failure. */
+export const measureServerOffset = (doFetch: Fetcher = (input, init) => fetch(input, init), now: () => number = Date.now): Promise<number> => {
+  if (measuring) return measuring;
+  measuring = (async () => {
+    try {
+      const controller = typeof AbortController === "function" ? new AbortController() : null;
+      const timer = window.setTimeout(() => controller?.abort(), PROBE_TIMEOUT_MS);
+      const sent = now();
+      const res = await doFetch(`${window.location.origin}/favicon.ico?clock=${sent}`, {
+        method: "HEAD",
+        cache: "no-store",
+        credentials: "same-origin",
+        signal: controller?.signal,
+      });
+      const received = now();
+      window.clearTimeout(timer);
+      offsetMs = offsetFrom({ sent, received, date: res.headers.get("date"), age: res.headers.get("age") }) ?? 0;
+    } catch {
+      offsetMs = 0;
+    }
+    return offsetMs;
+  })();
+  return measuring;
+};
+
+/** The server's time now (the device's, until the offset is known). */
+export const serverNow = (): number => Date.now() + offsetMs;
+
+/** Sets the offset as if measured: for tests, and for a page that already knows it. */
+export const primeServerClock = (offset = 0): void => {
+  offsetMs = offset;
+  measuring = Promise.resolve(offset);
+};
+
+/** Forgets the measurement (tests). */
+export const resetServerClock = (): void => {
+  offsetMs = 0;
+  measuring = null;
+};
+
+/** When the next tick is due: the next minute boundary, or the next boundary in `marks`, whichever is first. */
+export const nextTickAt = (now: number, marks: readonly number[] = []): number => {
+  const minute = Math.floor(now / MINUTE) * MINUTE + MINUTE;
+  return marks.reduce((at, m) => (m > now && m < at ? m : at), minute);
+};
+
+/**
+ * The server's time, re-read on every minute boundary and at each of
+ * `marks` (a drop's opening, its petal thresholds), and when the tab is shown
+ * again. `enabled` false leaves the clock alone (nothing to count to).
+ */
+export const useServerNow = (marks: readonly number[] = [], enabled = true): number => {
+  const [now, setNow] = useState(serverNow);
+  const key = marks.join(",");
+
+  useEffect(() => {
+    if (!enabled) return;
+    let timer = 0;
+    let live = true;
+    const list = key ? key.split(",").map(Number) : [];
+    const tick = () => {
+      window.clearTimeout(timer);
+      if (!live) return;
+      const t = serverNow();
+      setNow(t);
+      // A few ms past the boundary, so the next read lands on the new minute.
+      timer = window.setTimeout(tick, Math.max(20, nextTickAt(t, list) - t + 15));
+    };
+    tick();
+    measureServerOffset().then(() => live && tick());
+    const onVisible = () => {
+      if (document.visibilityState !== "hidden") tick();
+    };
+    document.addEventListener("visibilitychange", onVisible);
+    return () => {
+      live = false;
+      window.clearTimeout(timer);
+      document.removeEventListener("visibilitychange", onVisible);
+    };
+  }, [key, enabled]);
+
+  return now;
+};
