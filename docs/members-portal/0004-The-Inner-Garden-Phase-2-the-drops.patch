+import { WHATSAPP_NUMBER } from "@/data/jewellery";
+
+/*
+  The drops' WhatsApp messages and the name of a piece the shop has not
+  listed yet. A reserve is a question a person answers, never a booking.
+*/
+
+/** "verdant-pear-drop-huggies" → "Verdant Pear Drop Huggies", for a piece the shop has not listed yet. */
+export const nameFromHandle = (handle: string) => handle.split("-").filter(Boolean).map((w) => w[0].toUpperCase() + w.slice(1)).join(" ");
+
+export const whatsAppAbout = (name: string, dropTitle: string, handle: string, ask: "arriving" | "soldout" | "reserve") => {
+  const line =
+    ask === "reserve"
+      ? `I'd like to ask about reserving the "${name}" from the ${dropTitle} drop.`
+      : ask === "arriving"
+        ? `I'm looking at the ${dropTitle} drop. When will the "${name}" be on the shop?`
+        : `The "${name}" from the ${dropTitle} drop shows sold out. Could you tell me if it will come back?`;
+  return `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hello Naira Flore, ${line}\n\nhttps://nairaflore.com/jewellery/${handle}`)}`;
+};
