+/*
+  THE DROP MANIFEST. Written by the owner; empty until the first drop is set.
+
+  While it is empty the portal says so plainly: "No drop is open right now"
+  and New in the garden, with no made-up drop and no placeholder countdown.
+  Add a drop here and it lights up everywhere at once: a sealed bud in every
+  member's garden, the Bloom Clock on /members/drops, its own room at
+  /members/drops/<id>, and later its pressed flower in the Vault.
+
+  One entry, for example (every time in Indian time, written with +05:30):
+
+    {
+      id: "verdant",                       // the room's address: /members/drops/verdant
+      title: "Verdant",
+      species: "teal bud",                 // one of the six garden species below
+      accent: "#2F6B4F",                   // the flower's colour (petals only, never buttons)
+      story: ["Three lines at most.", "Each one short.", "No prices, no counts."],
+      membersFrom: "2026-11-21T20:00:00+05:30", // members see it first from here
+      everyoneFrom: "2026-11-23T20:00:00+05:30", // and the shop opens to everyone here
+      handles: ["verdant-pear-drop-huggies", "verdant-pear-pendant-necklace"],
+      leadHandle: "verdant-pear-pendant-necklace",
+      cutoutUrl: "https://cdn.shopify.com/…/verdant-cut.webp", // optional: a transparent cut-out (about 132:172)
+      teaser: { imageUrl: "https://cdn.shopify.com/…/teaser.jpg", public: false },
+      reservable: ["verdant-pear-pendant-necklace"], // may be reserved on WhatsApp before the drop opens
+      // movedFrom: "2026-11-14T20:00:00+05:30",    // only if the date moved: the old opening, shown struck through
+    }
+
+  What the portal promises with it, and what it never does:
+  - The countdown runs only to membersFrom. When that time has passed but the
+    pieces are not yet on the shop, the room reads "Opening shortly · ask on
+    WhatsApp", never a negative or a reset clock.
+  - Members "see it first": product links stay open, so the wording is a
+    first look, never a claim that the shop is closed to everyone else.
+  - Prices, compare-at prices and Available / Sold out come from the shop,
+    live. Nothing here carries a price or a quantity.
+  - The teaser image ships in the page's code, so it is a soft first look:
+    anyone reading the code can find it.
+  - "Reserve on WhatsApp" is a conversation: a person confirms it, and no
+    payment is taken for unreleased pieces.
+
+  A drop rests in the Vault 14 days after it opens to everyone.
+*/
+
+/** The six species of the garden (src/lib/portal/species.ts), by name. */
+export const DROP_SPECIES = ["rose", "wild five", "jasmine star", "marigold", "camellia", "teal bud"] as const;
+export type DropSpecies = (typeof DROP_SPECIES)[number];
+
+export type Drop = {
+  /** Lower-case letters, digits and hyphens: the room's address. */
+  id: string;
+  title: string;
+  species: DropSpecies;
+  /** A #RRGGBB colour, used only inside the drop's flower and its petals. */
+  accent: string;
+  /** At most three short lines. */
+  story: readonly string[];
+  /** ISO time with +05:30: members see the drop from here. */
+  membersFrom: string;
+  /** ISO time with +05:30, never before membersFrom: the shop opens to everyone here. */
+  everyoneFrom: string;
+  /** The Shopify handles of the drop's pieces. */
+  handles: readonly string[];
+  /** The piece that rises from the box. One of `handles`. */
+  leadHandle: string;
+  /** A transparent cut-out of the lead piece; without one the box lifts its shop photo. */
+  cutoutUrl?: string;
+  /** The rub-the-petals image; `public` lets the name and date show on the signed-out gate. */
+  teaser?: { imageUrl: string; public: boolean };
+  /** Handles that may be reserved on WhatsApp before the drop opens. */
+  reservable?: readonly string[];
+  /** The earlier membersFrom, when the drop was moved: shown struck through. */
+  movedFrom?: string;
+};
+
+export const DROPS: readonly Drop[] = [];
