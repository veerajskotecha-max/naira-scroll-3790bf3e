+      expect(f.delay + f.duration).toBeLessThanOrEqual(BURST_MS);
+      expect(f.keyframes[0].opacity).toBe(0);
+      expect(f.keyframes[f.keyframes.length - 1].opacity).toBe(0);
+      for (const k of f.keyframes) expect(Object.keys(k).sort()).toEqual(["offset", "opacity", "transform"]);
