+import { useMemo } from "react";
+import type { Drop } from "@/lib/portal/drops";
+import { googleCalendarUrl, icsHref, REMINDER_MINUTES, type CalendarEvent } from "@/lib/portal/ics";
+import { outlineButton, textLink } from "./styles";
+
+/*
+  "Add to my calendar": Google Calendar's own add-event page first, since it
+  is a plain link and opens inside Instagram's browser too; then the .ics
+  file (Apple Calendar, Outlook) with a reminder 30 minutes before. Inside
+  Instagram or Facebook's browser a file download goes nowhere, so the .ics
+  is not offered there. (The check is spelt out here rather than borrowed
+  from lib/portal/inAppBrowser, which Auth also imports: shared by two
+  routes, it would be split into a chunk of its own and change Auth's.)
+*/
+
+const IN_APP = /\bInstagram\b|\bFB(AN|AV)\b|FB_IAB|\[FB/i;
+
+const CalendarButton = ({ drop }: { drop: Drop }) => {
+  const event = useMemo<CalendarEvent>(
+    () => ({
+      uid: `drop-${drop.id}`,
+      title: `Naira Flore: ${drop.title} opens, a first look in the Inner Garden`,
+      start: drop.membersFrom,
+      minutes: 60,
+      details: "Members of the Inner Garden see the drop first. Prices and availability are on the shop when it opens.",
+      url: `https://nairaflore.com/members/drops/${drop.id}`,
+    }),
+    [drop.id, drop.title, drop.membersFrom],
+  );
+  const inApp = typeof navigator !== "undefined" && IN_APP.test(navigator.userAgent ?? "");
+  return (
+    <div className="ig-cal">
+      <a className={outlineButton} href={googleCalendarUrl(event)} target="_blank" rel="noopener noreferrer">
+        Add to my calendar
+      </a>
+      {!inApp && (
+        <a className={textLink} href={icsHref(event)} download={`naira-drop-${drop.id}.ics`}>
+          Or a .ics file, reminder {REMINDER_MINUTES} min before
+        </a>
+      )}
+    </div>
+  );
+};
+
+export default CalendarButton;
