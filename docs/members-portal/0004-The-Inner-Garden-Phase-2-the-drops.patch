+import type { ReactNode, Ref } from "react";
+import { FlowerGlyph } from "./FlowerGlyph";
+import "./herbarium.css";
+
+/*
+  A herbarium sheet in a thin gold frame: a pressed drop flower held by two
+  slips of vellum, labelled like a specimen ("Drop 01 · Verdant · pressed
+  21 Nov"). A drop she did not press is the same frame, gently empty, with
+  the flower's outline faint where it would lie: "This one bloomed in
+  October". Never a word about what she did not do, never a count.
+*/
+
+type Props = {
+  species: number;
+  accent: string;
+  /** Filled with her pressed flower, or the gentle empty frame. */
+  pressed: boolean;
+  /** "Drop 01 · Verdant" */
+  title: string;
+  /** "pressed 21 Nov", or "This one bloomed in October". */
+  note: string;
+  /** The flower's height in px. */
+  size?: number;
+  className?: string;
+  frameRef?: Ref<HTMLElement>;
+  children?: ReactNode;
+};
+
+const HerbariumFrame = ({ species, accent, pressed, title, note, size = 150, className = "", frameRef, children }: Props) => (
+  <figure ref={frameRef} className={`ig-herb${pressed ? "" : " is-empty"} ${className}`}>
+    <div className="ig-herb-sheet">
+      <svg className="ig-herb-frame" aria-hidden>
+        <rect x="0" y="0" width="100%" height="100%" pathLength={1} />
+        <rect x="3.5%" y="2.8%" width="93%" height="94.4%" pathLength={1} className="ig-herb-fine" />
+      </svg>
+      <div className="ig-herb-flower">
+        <FlowerGlyph species={species} accent={accent} state={pressed ? "pressed" : "line"} size={size} />
+        {pressed && (
+          <>
+            <span className="ig-herb-tape ig-herb-tape--a" />
+            <span className="ig-herb-tape ig-herb-tape--b" />
+          </>
+        )}
+      </div>
+      {children}
+    </div>
+    <figcaption className="ig-herb-label">
+      <span>{title}</span>
+      <span className="ig-herb-note">{note}</span>
+    </figcaption>
+  </figure>
+);
+
+export default HerbariumFrame;
