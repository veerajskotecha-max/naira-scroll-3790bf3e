 /** A petal's transform in a head of radius `r` at angle `deg`, base at the centre. */
 export const petalTransform = (deg: number, r: number) => `rotate(${deg}) translate(0 ${-r * 0.04}) scale(${(r / 74).toFixed(4)}) translate(-20 -77)`;
+
+/** `hex` mixed towards `toward` by `t` (0 = hex, 1 = toward): a drop accent's paler petals. */
+export const mixHex = (hex: string, toward: string, t: number): string => {
+  const read = (h: string) => {
+    const n = Number.parseInt(h.slice(1, 7), 16);
+    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+  };
+  const a = read(hex);
+  const b = read(toward);
+  return `#${a.map((v, i) => Math.round(v + (b[i] - v) * t).toString(16).padStart(2, "0")).join("")}`;
+};
+
+/** The ivory the garden is drawn on, for paling a flower colour. */
+export const PAPER = "#FBF3EC";
+
+/* The Bloom Clock's bud (components/portal/FlowerGlyph). */
+/** Where each petal rests while the bud is shut, and where it turns to when it opens. */
+export const BUD_CLOSED: readonly string[] = ["rotate(-15deg) scale(.64,.94)", "rotate(15deg) scale(.64,.94)", "rotate(-8deg) scale(.7,.97)", "rotate(8deg) scale(.7,.97)", "rotate(0deg) scale(.76,1)"];
+export const BUD_OPEN: readonly string[] = ["rotate(-72deg) scale(1,1)", "rotate(72deg) scale(1,1)", "rotate(-144deg) scale(1,1)", "rotate(144deg) scale(1,1)", "rotate(0deg) scale(1,1)"];
