+import { Link } from "react-router-dom";
+import { BED } from "@/lib/portal/gardenLayout";
+import { BudGlyph } from "./FlowerGlyph";
+
+/*
+  The next drop, waiting in her garden: a sealed bud on a tall stem in the
+  back row, its petals opening on the same clock as the Bloom Clock (one at
+  7 days, 3 days, 1 day and 1 hour, the last at the opening). It is a link
+  into the drop's room, and it grows in with the back row of the bed (it
+  wears the first band's class, so the garden's bloom-in lifts it too).
+*/
+
+type Props = {
+  to: string;
+  species: number;
+  accent: string;
+  open: number;
+  /** "21 Nov" */
+  day: string;
+  /** The whole thing in words: title and opening. */
+  label: string;
+  /** Stem base in the bed's 390 x 560 view. */
+  x?: number;
+  y?: number;
+};
+
+const W = 62;
+const H = (W * 160) / 128;
+
+const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
+
+const DropBud = ({ to, species, accent, open, day, label, x = 304, y = 300 }: Props) => (
+  <div className="ig-band ig-dropbud-band" data-band="0" style={{ transformOrigin: `50% ${pct(y, BED.h)}` }}>
+    <Link
+      to={to}
+      className="ig-dropbud"
+      aria-label={label}
+      style={{ left: pct(x - W / 2, BED.w), top: pct(y - H - 18, BED.h), width: pct(W, BED.w) }}
+    >
+      <span className="ig-dropbud-day">Opens {day}</span>
+      <BudGlyph species={species} accent={accent} open={open} size={W} />
+    </Link>
+  </div>
+);
+
+export default DropBud;
diff --git a/src/components/portal/DropPieceCard.tsx b/src/components/portal/DropPieceCard.tsx
new file mode 100644
index 0000000..2a638ab
--- /dev/null
+++ b/src/components/portal/DropPieceCard.tsx
@@ -0,0 +1,208 @@
+import { useEffect, useMemo, useRef, useState, type CSSProperties, type Ref } from "react";
+import { Link } from "react-router-dom";
+import type { JewelPiece } from "@/data/jewellery";
+import { nameFromHandle, whatsAppAbout } from "@/lib/portal/dropWords";
+import { buyableValues, cartLineFor, choices, choose, findVariant, initialChoice, sizeOption } from "@/lib/variants";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { MONTH_OPTION, shownName, variantForMonth } from "@/lib/portal/stones";
+import type { BagLine } from "./MemberContext";
+import type { ShopState } from "./useDropShop";
+import { BudGlyph } from "./FlowerGlyph";
+import { eyebrow, outlineButton, primaryButton, textLink } from "./styles";
+
+/*
+  One piece of a drop, as the shop sells it right now. Everything shown is
+  the listing's own, live: the photo, the name, the ₹ price and compare-at of
+  the chosen variant, and Available or Sold out from Shopify. Her month is
+  already chosen where the piece comes in months; a size is hers to choose.
+  Add to bag and Buy now go through the shop's own bag.
+
+  A piece the drop lists but the shop does not show yet is "Arriving · ask on
+  WhatsApp", a conversation, never a dead button. A sold-out piece is Sold
+  out, with WhatsApp to ask; nothing here counts stock or hurries her.
+*/
+
+type Props = {
+  handle: string;
+  piece: JewelPiece | undefined;
+  status: ShopState;
+  /** Her birth month, 1 to 12, for a piece sold in months. */
+  month: number | null;
+  dropTitle: string;
+  /** The drop's flower, drawn as a closed bud where a piece's photo is not there yet. */
+  bud?: { species: number; accent: string };
+  preview?: boolean;
+  onAdd: (line: BagLine) => Promise<boolean>;
+  onBuy: (line: BagLine) => Promise<void>;
+  cardRef?: Ref<HTMLElement>;
+  style?: CSSProperties;
+};
+
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
+
+const startingChoice = (piece: JewelPiece, month: number | null) => {
+  let chosen = initialChoice(piece);
+  const size = sizeOption(piece);
+  // A size is hers to choose (her fit is Phase 3): never assumed.
+  if (size) chosen = Object.fromEntries(Object.entries(chosen).filter(([name]) => name !== size));
+  const monthly = choices(piece).find((o) => o.name === MONTH_OPTION);
+  const hers = monthly && month ? variantForMonth(piece, month) : undefined;
+  if (hers) chosen = choose(piece, chosen, MONTH_OPTION, hers.options[MONTH_OPTION]);
+  return chosen;
+};
+
+const DropPieceCard = ({ handle, piece, status, month, dropTitle, bud, preview = false, onAdd, onBuy, cardRef, style }: Props) => {
+  const [chosen, setChosen] = useState<Record<string, string>>(() => (piece ? startingChoice(piece, month) : {}));
+  const [adding, setAdding] = useState<"idle" | "busy" | "done">("idle");
+  const live = useRef(true);
+  useEffect(
+    () => () => {
+      live.current = false;
+    },
+    [],
+  );
+  // The live listing arrives after the first paint: start from her month then.
+  const key = piece ? `${piece.handle}:${piece.variants?.length ?? 0}` : "";
+  useEffect(() => {
+    if (piece) setChosen(startingChoice(piece, month));
+    // Only when the listing itself (or her month) changes.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [key, month]);
+
+  const opts = useMemo(() => (piece ? choices(piece) : []), [piece]);
+  const variant = piece && piece.variants?.length ? findVariant(piece, chosen) : undefined;
+  const needsChoice = Boolean(piece?.variants?.length) && !variant;
+
+  if (!piece) {
+    const name = nameFromHandle(handle);
+    return (
+      <article ref={cardRef} className="ig-piece ig-piece--quiet" style={style}>
+        <span className="ig-piece-photo ig-piece-photo--blank" aria-hidden>
+          {bud && <BudGlyph species={bud.species} accent={bud.accent} open={0} size={44} stem={false} />}
+        </span>
+        <div className="ig-piece-body">
+          <h3 className="ig-piece-name">{name}</h3>
+          {status === "loading" ? (
+            <p className="ig-fineprint" role="status">
+              Reading today's price from the shop…
+            </p>
+          ) : status === "offline" ? (
+            <>
+              <p className="ig-fineprint">We couldn't reach the shop just now.</p>
+              <Link className={textLink} to={`/jewellery/${handle}`}>
+                See the piece
+              </Link>
+            </>
+          ) : (
+            <a className={textLink} href={whatsAppAbout(name, dropTitle, handle, "arriving")} target="_blank" rel="noopener noreferrer">
+              Arriving · ask on WhatsApp
+            </a>
+          )}
+        </div>
+      </article>
+    );
+  }
+
+  const price = variant?.price ?? piece.price;
+  const compare = variant ? variant.compareAtPrice : piece.compareAtPrice;
+  const available = variant ? variant.availableForSale : piece.availableForSale;
+  const image = variant?.image ?? piece.cover ?? piece.image;
+  const line = () => cartLineFor(piece, variant);
+
+  const add = async () => {
+    if (needsChoice || !available) return;
+    setAdding("busy");
+    let ok = false;
+    try {
+      ok = await onAdd(line());
+    } catch {
+      ok = false;
+    }
+    if (live.current) setAdding(ok ? "done" : "idle");
+  };
+
+  return (
+    <article ref={cardRef} className="ig-piece" style={style}>
+      {/* The name links to the piece too: this one is for a tap, not a second stop for a screen reader. */}
+      <Link to={`/jewellery/${piece.handle}`} className="ig-piece-photo" tabIndex={-1} aria-hidden>
+        {image && (
+          <img
+            src={shopifyImage(image, 360)}
+            srcSet={shopifySrcSet(image, [240, 360, 480]) || undefined}
+            sizes="(min-width: 768px) 220px, 38vw"
+            width={360}
+            height={360}
+            loading="lazy"
+            decoding="async"
+            alt=""
+          />
+        )}
+      </Link>
+      <div className="ig-piece-body">
+        <p className={eyebrow}>{piece.category}</p>
+        <h3 className="ig-piece-name">
+          <Link to={`/jewellery/${piece.handle}`}>{piece.name}</Link>
+        </h3>
+        <p className="ig-price">
+          <span>{rupees(price)}</span>
+          {compare && compare > price ? <s>{rupees(compare)}</s> : null}
+          <span className={available ? "ig-stock" : "ig-stock ig-stock--out"}>{needsChoice ? "" : available ? "Available" : "Sold out"}</span>
+        </p>
+        {opts.map((o) => {
+          const buyable = buyableValues(piece, o.name, chosen);
+          const id = `ig-${piece.handle}-${o.name}`.replace(/[^a-z0-9-]/gi, "-");
+          return (
+            <label key={o.name} className="ig-piece-opt" htmlFor={id}>
+              <span>{o.name}</span>
+              <select
+                id={id}
+                value={chosen[o.name] ?? ""}
+                onChange={(e) => {
+                  setChosen(choose(piece, chosen, o.name, e.target.value));
+                  setAdding("idle");
+                }}
+              >
+                {chosen[o.name] === undefined && (
+                  <option value="" disabled>
+                    Choose your {o.name.toLowerCase()}
+                  </option>
+                )}
+                {o.values.map((v) => (
+                  <option key={v} value={v}>
+                    {shownName(v)}
+                    {buyable[v] ? "" : " (sold out)"}
+                  </option>
+                ))}
+              </select>
+            </label>
+          );
+        })}
+        {needsChoice ? (
+          <button type="button" className={primaryButton} disabled>
+            Choose your {(sizeOption(piece) ?? opts.find((o) => chosen[o.name] === undefined)?.name ?? "option").toLowerCase()}
+          </button>
+        ) : available ? (
+          <div className="ig-piece-actions">
+            <button type="button" className={primaryButton} onClick={add} disabled={adding === "busy"}>
+              {adding === "busy" ? "Adding…" : "Add to bag"}
+            </button>
+            <button type="button" className={outlineButton} onClick={() => void onBuy(line()).catch(() => undefined)}>
+              Buy now
+            </button>
+          </div>
+        ) : (
+          <a className={textLink} href={whatsAppAbout(piece.name, dropTitle, piece.handle, "soldout")} target="_blank" rel="noopener noreferrer">
+            Ask on WhatsApp
+          </a>
+        )}
+        {adding === "done" && (
+          <p className="ig-fineprint" role="status">
+            {preview ? "Preview only: nothing was added to a bag." : "In your bag."}
+          </p>
+        )}
+      </div>
+    </article>
+  );
+};
+
+export default DropPieceCard;
diff --git a/src/components/portal/DropUnbox.tsx b/src/components/portal/DropUnbox.tsx
new file mode 100644
index 0000000..b61ccc1
--- /dev/null
+++ b/src/components/portal/DropUnbox.tsx
@@ -0,0 +1,161 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import type { Drop } from "@/lib/portal/drops";
+import { ballisticFlights, BURST_MS, MAX_BURST } from "@/lib/portal/petalPaths";
+import { PAPER, mixHex } from "@/lib/portal/species";
+import { EASE_DRAWER, EASE_REVEAL, cue, play, settled, stillMotion, type Cue } from "@/lib/portal/motion";
+import DropBox from "./DropBox";
+import { PEEK_POSE, REST_POSE, drawerTransforms, poseTransform } from "@/lib/portal/boxPose";
+import { PETAL_HUE } from "./PetalSymbols";
+import { quietButton } from "./styles";
+
+/*
+  THE UNBOXING, once per drop on this device. The Naira box turns to face
+  her, its drawer slides out, the drop's lead piece rises from the velvet and
+  a glint crosses it; at the same moment up to 24 flat petals in the drop's
+  colour are thrown up out of the drawer on worked-out arcs and are gone by
+  1.6 s. Then the pieces unfold below (the room staggers them 60 ms apart).
+
+  Every animation, petals included, is made at once when the page has
+  settled and starts on its own delay, so nothing is built mid-flight; at the
+  end the box is redrawn open and the animations are let go. A tap on Skip
+  ends it at once. Under reduced motion, or on a later visit, the box is
+  simply open.
+*/
+
+type Props = {
+  drop: Drop;
+  /** The cut-out (drop.cutoutUrl) or the lead piece's shop photo. */
+  piece?: { src: string; cutout: boolean };
+  /** Play the ritual (first visit, motion allowed); otherwise the box is shown open. */
+  ritual: boolean;
+  /** The pieces may unfold now. */
+  onUnfold: () => void;
+  size?: number;
+};
+
+const SVG = "http://www.w3.org/2000/svg";
+
+/* When each part of the ritual starts, in ms from the start. */
+const AT = { turn: 200, drawer: 850, rise: 1250, glint: 1950, petals: 1900, unfold: 2300, rest: 3500 };
+
+const DropUnbox = ({ drop, piece, ritual, onUnfold, size = 156 }: Props) => {
+  const [playing, setPlaying] = useState(ritual && !stillMotion());
+  const parts = {
+    lift: useRef<HTMLDivElement>(null),
+    box: useRef<HTMLDivElement>(null),
+    gleam: useRef<HTMLDivElement>(null),
+    riser: useRef<HTMLDivElement>(null),
+    glint: useRef<HTMLDivElement>(null),
+    front: useRef<HTMLDivElement>(null),
+    tray: useRef<HTMLDivElement>(null),
+    left: useRef<HTMLDivElement>(null),
+    right: useRef<HTMLDivElement>(null),
+  };
+  const stage = useRef<HTMLDivElement>(null);
+  const petalLayer = useRef<HTMLDivElement>(null);
+  const flights = useMemo(() => ballisticFlights(MAX_BURST, { seed: drop.id, spread: size * 0.95, lift: size * 1.15 }), [drop.id, size]);
+  const unfold = useRef(onUnfold);
+  unfold.current = onUnfold;
+  const end = useRef<() => void>(() => {});
+
+  useEffect(() => {
+    if (!playing) {
+      unfold.current();
+      return;
+    }
+    let alive = true;
+    const anims: Animation[] = [];
+    const cues: Cue[] = [];
+    const petals: Element[] = [];
+    let unfolded = false;
+    const letUnfold = () => {
+      if (unfolded) return;
+      unfolded = true;
+      unfold.current();
+    };
+    const finish = () => {
+      if (!alive) return;
+      alive = false;
+      cues.forEach((c) => c.cancel());
+      anims.forEach((a) => a.cancel());
+      petals.forEach((p) => p.remove());
+      letUnfold();
+      setPlaying(false);
+    };
+    end.current = finish;
+
+    const run = (el: Element | null, keyframes: Keyframe[], options: KeyframeAnimationOptions) => {
+      const a = play(el, keyframes, { fill: "both", ...options });
+      if (a) anims.push(a);
+      return a;
+    };
+
+    settled().then(() => {
+      if (!alive) return;
+      run(parts.box.current, [{ transform: poseTransform(REST_POSE) }, { transform: poseTransform(PEEK_POSE) }], { duration: 800, delay: AT.turn, easing: EASE_REVEAL });
+      const shut = drawerTransforms(size, 0);
+      const out = drawerTransforms(size, 1);
+      (["front", "tray", "left", "right"] as const).forEach((k) =>
+        run(parts[k].current, [{ transform: shut[k] }, { transform: out[k] }], { duration: 560, delay: AT.drawer, easing: EASE_DRAWER }),
+      );
+      run(parts.riser.current, [{ transform: "translateY(100%)" }, { transform: "translateY(0%)" }], { duration: 760, delay: AT.rise, easing: EASE_REVEAL });
+      run(parts.glint.current, [{ opacity: 0, transform: "scale(.2) rotate(0deg)" }, { opacity: 1, transform: "scale(1) rotate(45deg)", offset: 0.4 }, { opacity: 0, transform: "scale(.3) rotate(90deg)" }], { duration: 720, delay: AT.glint, easing: "ease-out", fill: "none" });
+      run(parts.gleam.current, [{ transform: "translateX(-160%) skewX(-18deg)" }, { transform: "translateX(330%) skewX(-18deg)" }], { duration: 900, delay: AT.glint + 200, easing: "cubic-bezier(0.45, 0, 0.2, 1)", fill: "none" });
+      run(parts.lift.current, [{ transform: "translateY(0)" }, { transform: `translateY(${-size * 0.05}px)` }, { transform: "translateY(0)" }], { duration: 1400, delay: AT.rise, easing: "ease-in-out", fill: "none" });
+
+      // The petals, thrown from the open drawer: made now, each on its own delay.
+      const layer = petalLayer.current;
+      if (layer) {
+        const tint = mixHex(drop.accent, PAPER, 0.45);
+        flights.forEach((f) => {
+          const svg = document.createElementNS(SVG, "svg");
+          svg.setAttribute("viewBox", "0 0 20 20");
+          svg.setAttribute("aria-hidden", "true");
+          svg.setAttribute("class", "ig-petal");
+          svg.style.cssText = `left:50%;top:58%;width:${f.size}px;height:${f.size}px;opacity:0;color:${f.tone ? tint : drop.accent}`;
+          const use = document.createElementNS(SVG, "use");
+          use.setAttribute("href", `#${PETAL_HUE}`);
+          svg.appendChild(use);
+          layer.appendChild(svg);
+          petals.push(svg);
+          const a = play(svg, f.keyframes, { duration: f.duration, delay: AT.petals + f.delay, easing: "linear", fill: "both" });
+          if (a) {
+            anims.push(a);
+            a.onfinish = () => svg.remove();
+          }
+        });
+        // Whatever is left is gone 1.6 s after the burst.
+        cues.push(cue(stage.current, AT.petals + BURST_MS, () => petals.forEach((p) => p.remove())));
+      }
+      cues.push(cue(stage.current, AT.unfold, letUnfold));
+      cues.push(cue(stage.current, AT.rest, finish));
+    });
+
+    return () => {
+      if (!alive) return;
+      alive = false;
+      cues.forEach((c) => c.cancel());
+      anims.forEach((a) => a.cancel());
+      petals.forEach((p) => p.remove());
+    };
+    // Once, when the room opens on it.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const open = !playing;
+  return (
+    <div ref={stage} className={`ig-unbox${playing ? " is-playing" : ""}`}>
+      <div className="ig-unbox-stage" style={{ width: size * 1.75, height: size * 1.55 }}>
+        <DropBox size={size} pose={open ? PEEK_POSE : REST_POSE} open={open ? 1 : 0} raised={open} piece={piece} parts={parts} />
+        <div ref={petalLayer} className="ig-unbox-petals" aria-hidden />
+      </div>
+      {playing && (
+        <button type="button" className={`${quietButton} ig-unbox-skip`} onClick={() => end.current()}>
+          Skip
+        </button>
+      )}
+    </div>
+  );
+};
+
+export default DropUnbox;
