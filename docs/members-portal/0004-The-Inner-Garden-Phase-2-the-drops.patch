+++ b/src/components/portal/PetalReveal.tsx
@@ -0,0 +1,174 @@
+import { useCallback, useEffect, useRef, useState, type PointerEvent as ReactPointerEvent } from "react";
+import type { Drop } from "@/lib/portal/drops";
+import { speciesIndex } from "@/lib/portal/dropPhase";
+import { paintPetals } from "@/lib/portal/petalCanvas";
+import { BRUSH_RADIUS, REVEAL_AT, RubMask, SAMPLE_EVERY } from "@/lib/portal/rubMask";
+import { hasDropFlag, setDropFlag } from "@/lib/portal/safeStorage";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { shopifyImage } from "@/lib/shopifyImage";
+import { BudGlyph } from "./FlowerGlyph";
+import { burstPetals } from "./PetalBurst";
+import { PETAL_HUE, PETAL_SPARK } from "./PetalSymbols";
+import { quietButton } from "./styles";
+
+/*
+  RUB THE PETALS. The drop's teaser lies under a drift of its own petals,
+  painted once on a 2D canvas (device pixels capped at 2). A fingertip wipes
+  them away with a 28 px brush (destination-out); the strokes are stamped on
+  a 64 x 64 mask too, and every 8th move the mask is read: at 55% cleared,
+  the rest of the petals fade away in 400 ms and a few let go.
+
+  "Reveal" does the same in one tap, for a keyboard, a screen reader or
+  anyone who would rather not rub. Under reduced motion the canvas is never
+  made: the petals are a still drawing and Reveal lifts them. Either way the
+  end is the same: the teaser shown, and this device remembering it.
+  Everyone uncovers the same piece; there is no lottery.
+*/
+
+type Props = {
+  drop: Drop;
+  imageUrl: string;
+  /** What the teaser shows, spoken once it is uncovered. */
+  alt: string;
+};
+
+const PetalReveal = ({ drop, imageUrl, alt }: Props) => {
+  const [revealed, setRevealed] = useState(() => hasDropFlag("revealed", drop.id));
+  const [rubbing, setRubbing] = useState(false);
+  const [calm] = useState(stillMotion);
+  const wrapRef = useRef<HTMLDivElement>(null);
+  const canvasRef = useRef<HTMLCanvasElement>(null);
+  const ctxRef = useRef<CanvasRenderingContext2D | null>(null);
+  const mask = useRef<RubMask | null>(null);
+  const moves = useRef(0);
+  const last = useRef<{ x: number; y: number } | null>(null);
+  const box = useRef<DOMRect | null>(null);
+  const done = useRef(revealed);
+
+  const finish = useCallback(
+    (how: "rub" | "button") => {
+      if (done.current) return;
+      done.current = true;
+      setDropFlag("revealed", drop.id);
+      const canvas = canvasRef.current;
+      const fade = how === "rub" ? play(canvas, [{ opacity: 1 }, { opacity: 0 }], { duration: 400, easing: EASE_REVEAL, fill: "forwards" }) : null;
+      if (how === "rub" && last.current) {
+        burstPetals(wrapRef.current, last.current.x, last.current.y, { count: 12, spread: 110, ids: [PETAL_HUE, PETAL_HUE, PETAL_SPARK], color: drop.accent });
+      }
+      if (fade) fade.onfinish = () => setRevealed(true);
+      else setRevealed(true);
+    },
+    [drop.id, drop.accent],
+  );
+
+  // The petals are painted once, at the card's size.
+  useEffect(() => {
+    if (revealed || calm) return;
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    const rect = canvas.getBoundingClientRect();
+    const w = rect.width || canvas.clientWidth || 320;
+    const h = rect.height || canvas.clientHeight || 320;
+    const dpr = Math.min(2, window.devicePixelRatio || 1);
+    canvas.width = Math.round(w * dpr);
+    canvas.height = Math.round(h * dpr);
+    let ctx: CanvasRenderingContext2D | null = null;
+    try {
+      ctx = canvas.getContext("2d");
+    } catch {
+      ctx = null;
+    }
+    if (!ctx) return; // no canvas here: Reveal still lifts the petals
+    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
+    paintPetals(ctx, w, h, drop);
+    ctx.globalCompositeOperation = "destination-out";
+    ctx.lineCap = "round";
+    ctx.lineJoin = "round";
+    ctx.lineWidth = BRUSH_RADIUS * 2;
+    ctxRef.current = ctx;
+    mask.current = new RubMask(w, h);
+    // Painted once per drop; a change of drop is a new card.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [revealed, calm, drop.id]);
+
+  const at = (e: ReactPointerEvent) => {
+    const r = box.current;
+    return r ? { x: e.clientX - r.left, y: e.clientY - r.top } : { x: 0, y: 0 };
+  };
+
+  const onDown = (e: ReactPointerEvent<HTMLCanvasElement>) => {
+    const ctx = ctxRef.current;
+    if (!ctx || done.current) return;
+    box.current = e.currentTarget.getBoundingClientRect();
+    try {
+      e.currentTarget.setPointerCapture(e.pointerId);
+    } catch {
+      /* capture is a nicety */
+    }
+    const p = at(e);
+    last.current = p;
+    ctx.beginPath();
+    ctx.arc(p.x, p.y, BRUSH_RADIUS, 0, Math.PI * 2);
+    ctx.fill();
+    mask.current?.stamp(p.x, p.y);
+    if (!rubbing) setRubbing(true);
+  };
+
+  const onMove = (e: ReactPointerEvent<HTMLCanvasElement>) => {
+    const ctx = ctxRef.current;
+    const from = last.current;
+    if (!ctx || !from || done.current) return;
+    const p = at(e);
+    ctx.beginPath();
+    ctx.moveTo(from.x, from.y);
+    ctx.lineTo(p.x, p.y);
+    ctx.stroke();
+    mask.current?.line(from.x, from.y, p.x, p.y);
+    last.current = p;
+    moves.current += 1;
+    if (moves.current % SAMPLE_EVERY === 0 && (mask.current?.coverage() ?? 0) >= REVEAL_AT) finish("rub");
+  };
+
+  const onUp = () => {
+    if (!done.current) last.current = null;
+  };
+
+  const src = shopifyImage(imageUrl, 720);
+  return (
+    <div className="ig-reveal-wrap">
+      <div ref={wrapRef} className={`ig-reveal${revealed ? " is-revealed" : ""}`}>
+        <img className="ig-reveal-img" src={src} alt={revealed ? alt : ""} aria-hidden={revealed ? undefined : true} width={720} height={720} decoding="async" />
+        {!revealed && !calm && (
+          <canvas
+            ref={canvasRef}
+            className="ig-reveal-canvas"
+            aria-hidden
+            onPointerDown={onDown}
+            onPointerMove={onMove}
+            onPointerUp={onUp}
+            onPointerCancel={onUp}
+          />
+        )}
+        {!revealed && calm && (
+          <div className="ig-reveal-cover" aria-hidden>
+            <BudGlyph species={speciesIndex(drop.species)} accent={drop.accent} open={0} size={120} />
+          </div>
+        )}
+        {!revealed && !rubbing && (
+          <p className="ig-reveal-hint" aria-hidden>
+            {calm ? "Under the petals" : "Rub the petals"}
+          </p>
+        )}
+      </div>
+      {revealed ? (
+        <p className="ig-fineprint ig-reveal-note">A first look. Everyone uncovers the same piece; there is no lottery.</p>
+      ) : (
+        <button type="button" className={quietButton} onClick={() => finish("button")}>
+          Reveal
+        </button>
+      )}
+    </div>
+  );
+};
+
+export default PetalReveal;
