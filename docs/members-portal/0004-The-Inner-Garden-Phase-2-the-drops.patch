diff --git a/src/components/portal/PressFlower.tsx b/src/components/portal/PressFlower.tsx
new file mode 100644
index 0000000..54413c9
--- /dev/null
+++ b/src/components/portal/PressFlower.tsx
@@ -0,0 +1,120 @@
+import { useLayoutEffect, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import type { Drop } from "@/lib/portal/drops";
+import { speciesIndex } from "@/lib/portal/dropPhase";
+import { formatIstDay } from "@/lib/portal/ist";
+import { EASE_BLOOM, EASE_DRAWER, EASE_REVEAL, cue, play, stillMotion, type Cue } from "@/lib/portal/motion";
+import { FlowerGlyph } from "./FlowerGlyph";
+import HerbariumFrame from "./HerbariumFrame";
+import { burstPetals } from "./PetalBurst";
+import { PETAL_HUE, PETAL_SPARK } from "./PetalSymbols";
+import { primaryButton, textLink } from "./styles";
+
+/*
+  PRESS YOUR FLOWER. Once a drop has opened, its flower stands in an empty
+  herbarium frame. A tap presses it: the flower turns a quarter and squashes
+  flat (scaleY 0.08, 700 ms), then lies pressed in the frame as the gold
+  frame draws itself and its label appears: "Drop 01 · Verdant · pressed
+  21 Nov". The same flower is planted in her garden. It is for joy: not
+  points, never redeemable, and nothing is unlocked by it. Under reduced
+  motion it is simply pressed.
+*/
+
+type Props = {
+  drop: Drop;
+  /** "01" */
+  number: string;
+  /** The IST day she pressed it ("2026-11-21"), "" if unknown, or null if not yet. */
+  pressedOn: string | null;
+  onPress: () => void;
+};
+
+const dayLabel = (day: string) => (day ? formatIstDay(`${day}T12:00:00+05:30`) : null);
+
+const PressFlower = ({ drop, number, pressedOn, onPress }: Props) => {
+  const species = speciesIndex(drop.species);
+  const [pressing, setPressing] = useState(false);
+  const justPressed = useRef(false);
+  const flowerRef = useRef<HTMLDivElement>(null);
+  const frameRef = useRef<HTMLElement>(null);
+  const cueRef = useRef<Cue | null>(null);
+  const pressed = pressedOn !== null && !pressing;
+
+  const press = () => {
+    if (pressedOn !== null || pressing) return;
+    if (stillMotion()) {
+      onPress();
+      return;
+    }
+    setPressing(true);
+    const flower = flowerRef.current;
+    play(flower, [{ transform: "rotate(0deg) scale(1, 1)" }, { transform: "rotate(90deg) scale(1, .08)", offset: 0.82 }, { transform: "rotate(90deg) scale(.96, .06)", opacity: 0.4 }], {
+      duration: 700,
+      easing: EASE_DRAWER,
+      fill: "forwards",
+    });
+    cueRef.current = cue(flower, 700, () => {
+      justPressed.current = true;
+      setPressing(false);
+      onPress();
+    });
+  };
+
+  useLayoutEffect(() => () => cueRef.current?.cancel(), []);
+
+  // Just pressed: it settles flat in the frame, the frame draws, a few petals let go.
+  useLayoutEffect(() => {
+    if (!pressed || !justPressed.current) return;
+    justPressed.current = false;
+    const frame = frameRef.current;
+    play(frame?.querySelector(".ig-herb-flower svg"), [{ transform: "rotate(-90deg) scale(1, .08)", opacity: 0.4 }, { transform: "none", opacity: 1 }], { duration: 560, easing: EASE_BLOOM, fill: "backwards" });
+    frame?.querySelectorAll(".ig-herb-frame rect").forEach((rect, i) => play(rect, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 760, delay: 80 + i * 120, easing: EASE_REVEAL, fill: "backwards" }));
+    play(frame?.querySelector(".ig-herb-label"), [{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 420, delay: 380, easing: EASE_REVEAL, fill: "backwards" });
+    const sheet = frame?.querySelector(".ig-herb-sheet");
+    if (sheet) {
+      const box = sheet.getBoundingClientRect();
+      burstPetals(sheet as HTMLElement, box.width / 2, box.height * 0.42, { count: 12, spread: 120, ids: [PETAL_HUE, PETAL_HUE, PETAL_SPARK], color: drop.accent, delay: 200 });
+    }
+  }, [pressed, drop.accent]);
+
+  const label = `Drop ${number} · ${drop.title}`;
+  const day = pressedOn ? dayLabel(pressedOn) : null;
+  return (
+    <section className="ig-section ig-press" aria-labelledby={`ig-press-${drop.id}`}>
+      <h2 id={`ig-press-${drop.id}`} className="ig-h2">
+        Press your flower
+      </h2>
+      <div className="ig-press-stage">
+        <HerbariumFrame
+          frameRef={frameRef}
+          species={species}
+          accent={drop.accent}
+          pressed={pressed}
+          title={label}
+          note={pressed ? (day ? `pressed ${day}` : "pressed") : "waiting to be pressed"}
+          className={pressed ? "" : "is-waiting"}
+        >
+          {!pressed && (
+            <div ref={flowerRef} className="ig-press-bloom">
+              <FlowerGlyph species={species} accent={drop.accent} state="bloom" size={170} />
+            </div>
+          )}
+        </HerbariumFrame>
+      </div>
+      {pressed ? (
+        <p className="ig-fineprint ig-press-note" role="status">
+          Pressed and planted in your garden. <Link className={textLink} to="/members">See it growing</Link>
+        </p>
+      ) : (
+        <>
+          <button type="button" className={primaryButton} onClick={press} disabled={pressing}>
+            {pressing ? "Pressing…" : "Press your flower"}
+          </button>
+          <p className="ig-fineprint ig-press-note">Kept in your Vault and planted in your garden. For joy: not points, never redeemable.</p>
+        </>
+      )}
+    </section>
+  );
+};
+
+export default PressFlower;
