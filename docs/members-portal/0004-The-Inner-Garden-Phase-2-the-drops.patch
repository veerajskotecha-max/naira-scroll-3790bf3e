+import { describe, expect, it } from "vitest";
+import { buildIcs, escapeIcsText, foldIcsLine, googleCalendarUrl, icsHref, utcStamp, type CalendarEvent } from "./ics";
+
+/* "Add to my calendar": the Google link must open Google's own add-event
+   page with the right instant, and the .ics must be a valid VEVENT at the
+   right UTC time, with text escaped and a reminder 30 minutes before. */
+
+const event: CalendarEvent = {
+  uid: "drop-verdant",
+  title: "Naira Flore: Verdant opens, a first look; in the garden",
+  start: "2026-11-21T20:00:00+05:30",
+  minutes: 60,
+  details: "Line one\nLine two, with a comma\\and a backslash",
+  url: "https://nairaflore.com/members/drops/verdant",
+};
+const stamp = Date.parse("2026-11-05T01:02:03Z");
+
+describe("the .ics", () => {
+  const ics = buildIcs(event, stamp);
+  const lines = ics.split("\r\n");
+
+  it("is a calendar with one VEVENT, in CRLF lines", () => {
+    expect(ics.endsWith("\r\n")).toBe(true);
+    expect(ics.replace(/\r\n/g, "")).not.toMatch(/\n/);
+    expect(lines[0]).toBe("BEGIN:VCALENDAR");
+    expect(lines).toContain("VERSION:2.0");
+    expect(lines.filter((l) => l === "BEGIN:VEVENT")).toHaveLength(1);
+    expect(lines.filter((l) => l === "END:VEVENT")).toHaveLength(1);
+    expect(lines[lines.length - 2]).toBe("END:VCALENDAR");
+    expect(lines).toContain("UID:drop-verdant@nairaflore.com");
+    expect(lines).toContain("DTSTAMP:20261105T010203Z");
+  });
+
+  it("converts 8:00 pm IST to 14:30 UTC", () => {
+    expect(lines).toContain("DTSTART:20261121T143000Z");
+    expect(lines).toContain("DTEND:20261121T153000Z");
+    expect(utcStamp(Date.parse("2026-12-01T00:00:00+05:30"))).toBe("20261130T183000Z");
+  });
+
+  it("escapes commas, semicolons, backslashes and newlines", () => {
+    expect(escapeIcsText("a,b;c\\d\ne")).toBe("a\\,b\\;c\\\\d\\ne");
+    const unfolded = ics.replace(/\r\n /g, "");
+    expect(unfolded).toContain("SUMMARY:Naira Flore: Verdant opens\\, a first look\\; in the garden");
+    expect(unfolded).toContain("DESCRIPTION:Line one\\nLine two\\, with a comma\\\\and a backslash");
+  });
+
+  it("reminds her 30 minutes before", () => {
+    const alarm = lines.slice(lines.indexOf("BEGIN:VALARM"), lines.indexOf("END:VALARM") + 1);
+    expect(alarm).toContain("ACTION:DISPLAY");
+    expect(alarm).toContain("TRIGGER:-PT30M");
+    expect(lines.indexOf("BEGIN:VALARM")).toBeGreaterThan(lines.indexOf("BEGIN:VEVENT"));
+    expect(lines.indexOf("END:VALARM")).toBeLessThan(lines.indexOf("END:VEVENT"));
+  });
+
+  it("folds long lines at 75 octets without splitting a character", () => {
+    const long = `DESCRIPTION:${"₹ · ".repeat(40)}`;
+    const folded = foldIcsLine(long).split("\r\n");
+    expect(folded.length).toBeGreaterThan(1);
+    for (const part of folded) expect(new TextEncoder().encode(part).length).toBeLessThanOrEqual(75);
+    expect(folded.slice(1).every((p) => p.startsWith(" "))).toBe(true);
+    expect(folded.map((p, i) => (i ? p.slice(1) : p)).join("")).toBe(long);
+    for (const l of lines) expect(new TextEncoder().encode(l).length).toBeLessThanOrEqual(75);
+  });
+
+  it("can be opened as a link", () => {
+    expect(icsHref(event, stamp).startsWith("data:text/calendar;charset=utf-8,BEGIN%3AVCALENDAR")).toBe(true);
+  });
+});
+
+describe("the Google Calendar link", () => {
+  it("opens Google's add-event page at the same instant", () => {
+    const url = new URL(googleCalendarUrl(event));
+    expect(url.origin + url.pathname).toBe("https://calendar.google.com/calendar/render");
+    expect(url.searchParams.get("action")).toBe("TEMPLATE");
+    expect(url.searchParams.get("text")).toBe(event.title);
+    expect(url.searchParams.get("dates")).toBe("20261121T143000Z/20261121T153000Z");
+    expect(url.searchParams.get("ctz")).toBe("Asia/Kolkata");
+    expect(url.searchParams.get("details")).toContain("https://nairaflore.com/members/drops/verdant");
+  });
+});
