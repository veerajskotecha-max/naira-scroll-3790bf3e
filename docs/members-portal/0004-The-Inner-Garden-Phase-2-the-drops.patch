--- /dev/null
+++ b/src/components/portal/BloomClock.tsx
@@ -0,0 +1,151 @@
+import { useEffect, useLayoutEffect, useRef } from "react";
+import type { Drop } from "@/lib/portal/drops";
+import { PETAL_WORDS, countdown, countdownWords, msUntil, petalsOpen, speciesIndex, timeOf } from "@/lib/portal/dropPhase";
+import { formatIstOpening } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion, useAmbient } from "@/lib/portal/motion";
+import { BudGlyph } from "./FlowerGlyph";
+import { BUD_CLOSED, BUD_OPEN } from "@/lib/portal/species";
+import { burstPetals } from "./PetalBurst";
+import { PETAL_HUE, PETAL_SPARK } from "./PetalSymbols";
+import "./bloomclock.css";
+
+/*
+  THE BLOOM CLOCK. The next drop is a sealed bud whose five petals open on a
+  real clock in Indian time: one at 7 days, one at 3 days, one at 1 day, one
+  at 1 hour, and the last as the drop opens. A petal that opens while she is
+  watching turns out from the bud (700 ms, from its base) as its colour comes
+  in, with a few petals let go; the ones already open are drawn open.
+
+  The digits are days, hours and minutes, re-read on each minute boundary
+  from the server's clock (lib/portal/clock): a changed digit rolls in from
+  above (250 ms), the rest stay still. A screen reader hears the same time in
+  words, politely. It never counts below zero; past the opening the room
+  turns to the open drop. The bud's sway is this screen's one ambient loop,
+  and rests off screen, on a hidden tab and after 20 s untouched. Under
+  reduced motion it is a still drawing with plain digits.
+*/
+
+type Props = {
+  drop: Drop;
+  /** The large clock (the drops page and the room), or a smaller one. */
+  size?: number;
+};
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+const Digit = ({ value, unit }: { value: string; unit: string }) => {
+  const ref = useRef<HTMLSpanElement>(null);
+  const first = useRef(true);
+  useLayoutEffect(() => {
+    if (first.current) {
+      first.current = false;
+      return;
+    }
+    if (stillMotion()) return;
+    play(ref.current, [{ transform: "translateY(-75%)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }], { duration: 250, easing: EASE_REVEAL });
+  }, [value]);
+  return (
+    <span className="ig-bc-unit">
+      <span className="ig-bc-num">
+        <span ref={ref} className="ig-bc-roll">
+          {value}
+        </span>
+      </span>
+      <span className="ig-bc-word">{unit}</span>
+    </span>
+  );
+};
+
+const BloomClock = ({ drop, size = 230 }: Props) => {
+  const opens = timeOf(drop.membersFrom);
+  const now = useServerNow([opens - 7 * 86_400_000, opens - 3 * 86_400_000, opens - 86_400_000, opens - 3_600_000, opens]);
+  const left = msUntil(drop, now);
+  const open = petalsOpen(left);
+  const { days, hours, minutes } = countdown(left);
+  const artRef = useRef<HTMLDivElement>(null);
+  const swayRef = useRef<HTMLDivElement>(null);
+  const shown = useRef(open);
+  const calm = stillMotion();
+  const active = useAmbient(artRef, !calm);
+
+  // A petal that opens while she watches turns out from the bud.
+  useLayoutEffect(() => {
+    const from = shown.current;
+    shown.current = open;
+    if (open <= from || calm) return;
+    const root = artRef.current;
+    for (let k = from; k < open; k++) {
+      const petal = root?.querySelector(`.ig-bud-petal[data-k="${k}"]`);
+      play(petal, [{ transform: BUD_CLOSED[k] }, { transform: BUD_OPEN[k] }], { duration: 700, easing: EASE_BLOOM, fill: "backwards" });
+      play(petal?.querySelector(".ig-bud-colour"), [{ opacity: 0 }, { opacity: 1 }], { duration: 520, delay: 120, easing: EASE_REVEAL, fill: "backwards" });
+    }
+    root?.querySelectorAll(".ig-bud-dial ellipse").forEach((mark, k) => {
+      if (k >= from && k < open) play(mark, [{ opacity: 0.2 }, { opacity: 1 }], { duration: 500, delay: 420, easing: EASE_REVEAL, fill: "backwards" });
+    });
+    if (open >= 5) play(root?.querySelector(".ig-bud-core"), [{ transform: "scale(0)", opacity: 0 }, { transform: "scale(1)", opacity: 1 }], { duration: 600, delay: 300, easing: EASE_BLOOM, fill: "backwards" });
+    if (root) {
+      const box = root.getBoundingClientRect();
+      burstPetals(root, box.width / 2, box.width * 0.42, { count: 8, spread: 80, ids: [PETAL_HUE, PETAL_HUE, PETAL_SPARK], color: drop.accent, size: [8, 14], delay: 260 });
+    }
+  }, [open, calm, drop.accent]);
+
+  // The bud breathes: this screen's one ambient loop.
+  const sway = useRef<Animation | null>(null);
+  useEffect(() => {
+    if (calm) return;
+    const a = play(swayRef.current, [{ transform: "rotate(-1.6deg)" }, { transform: "rotate(1.6deg)" }], {
+      duration: 4600,
+      iterations: Infinity,
+      direction: "alternate",
+      easing: "ease-in-out",
+    });
+    a?.pause();
+    sway.current = a;
+    return () => a?.cancel();
+  }, [calm]);
+  useEffect(() => {
+    const a = sway.current;
+    if (!a) return;
+    if (active) a.play();
+    else a.pause();
+  }, [active]);
+
+  const when = formatIstOpening(drop.membersFrom);
+  return (
+    <figure className="ig-bc" style={{ ["--ig-accent" as string]: drop.accent }}>
+      <div ref={artRef} className="ig-bc-art" style={{ width: size }}>
+        <div ref={swayRef} className="ig-bc-sway">
+          <BudGlyph species={speciesIndex(drop.species)} accent={drop.accent} open={open} size={size} dial />
+        </div>
+      </div>
+      <figcaption className="ig-bc-cap">
+        {drop.movedFrom ? (
+          <p className="ig-bc-when">
+            <s>{formatIstOpening(drop.movedFrom)}</s>
+            <span>Moved to {when}</span>
+          </p>
+        ) : (
+          <p className="ig-bc-when">Opens {when}</p>
+        )}
+        <p className="ig-bc-digits" aria-hidden>
+          <Digit value={pad(days)} unit={days === 1 ? "day" : "days"} />
+          <Digit value={pad(hours)} unit="hrs" />
+          <Digit value={pad(minutes)} unit="min" />
+        </p>
+        <p className="sr-only" aria-live="polite">
+          {countdownWords(left)}
+        </p>
+        <ol className="ig-bc-steps" aria-label="A petal opens at each of these">
+          {PETAL_WORDS.map((w, k) => (
+            <li key={w} className={k < open ? "is-open" : undefined}>
+              {w}
+            </li>
+          ))}
+        </ol>
+      </figcaption>
+    </figure>
+  );
+};
+
+export default BloomClock;
