+import { describe, expect, it } from "vitest";
+import { DROPS, DROP_SPECIES, type Drop } from "./drops";
+import { dropPhase, dropProblems, type LiveState } from "./dropPhase";
+import { SPECIES } from "./species";
+import { FIXTURE_PREFIX, PREVIEW_DROP_STATES, readPreviewDrops } from "./previewDrops";
+
+/* The owner writes the manifest by hand. Every entry must be one the portal
+   can show honestly: IST times written with +05:30, members first (never
+   after everyone), a species from the garden's six, a real lead piece. The
+   manifest ships empty; the development fixtures obey the same rules. */
+
+describe("the drop manifest", () => {
+  it("ships empty until the owner sets the first drop", () => {
+    expect(DROPS).toEqual([]);
+  });
+
+  it("holds only drops the portal can show", () => {
+    expect(DROPS.flatMap(dropProblems)).toEqual([]);
+  });
+
+  it("has unique ids", () => {
+    expect(new Set(DROPS.map((d) => d.id)).size).toBe(DROPS.length);
+  });
+
+  it("names the garden's six species, in the garden's order", () => {
+    expect([...DROP_SPECIES]).toEqual(SPECIES.map((s) => s.name));
+  });
+});
+
+const good: Drop = {
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
