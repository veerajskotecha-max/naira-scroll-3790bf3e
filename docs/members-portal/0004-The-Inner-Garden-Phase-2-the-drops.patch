+import { useEffect, useMemo, useRef } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import HerbariumFrame from "@/components/portal/HerbariumFrame";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, textLink } from "@/components/portal/styles";
+import { byOpening, dropNumber, speciesIndex, timeOf, VAULT_AFTER_MS } from "@/lib/portal/dropPhase";
+import { formatIstDay, istMonthName } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import "./vault.css";
+
+/*
+  /members/vault: every drop that has bloomed, newest first, as a wall of
+  herbarium frames. One she pressed holds her flower and the day she pressed
+  it; one she did not is the same frame, gently empty: "This one bloomed in
+  October". Each opens to its room: the story, and its pieces with live
+  Available / Sold out. Pressed flowers are keepsakes for joy, never points.
+*/
+
+const Vault = () => {
+  const { drops, pressed } = useMember();
+  const marks = useMemo(() => drops.map((d) => timeOf(d.everyoneFrom) + VAULT_AFTER_MS), [drops]);
+  const now = useServerNow(marks, drops.length > 0);
+  const kept = useMemo(() => byOpening(drops).filter((d) => now >= timeOf(d.everyoneFrom) + VAULT_AFTER_MS).reverse(), [drops, now]);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  return (
+    <PortalShell title="The Vault" description="The Vault: past drops in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-vault">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            The <em>Vault</em>
+          </h1>
+          <p className="ig-lede">Every drop that has bloomed, pressed and kept. Newest first.</p>
+        </div>
+        {kept.length === 0 ? (
+          <section className="ig-section ig-vault-empty">
+            <p className="ig-fineprint">Nothing is in the Vault yet. When a drop has bloomed, its flower is kept here.</p>
+            <Link className={textLink} to="/members/drops">
+              See the drops
+            </Link>
+          </section>
+        ) : (
+          <ul className="ig-wall">
+            {kept.map((d) => {
+              const mine = pressed.find((p) => p.id === d.id);
+              return (
+                <li key={d.id}>
+                  <Link to={`/members/drops/${d.id}`} className="ig-wall-link">
+                    <HerbariumFrame
+                      species={speciesIndex(d.species)}
+                      accent={d.accent}
+                      pressed={Boolean(mine)}
+                      title={`Drop ${dropNumber(d, drops)} · ${d.title}`}
+                      note={mine ? (mine.on ? `pressed ${formatIstDay(`${mine.on}T12:00:00+05:30`)}` : "pressed") : `This one bloomed in ${istMonthName(d.membersFrom)}`}
+                      size={130}
+                    />
+                  </Link>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+        <p className="ig-fineprint ig-vault-joy">Pressed flowers are keepsakes for joy. Not points, never redeemable.</p>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Vault;
