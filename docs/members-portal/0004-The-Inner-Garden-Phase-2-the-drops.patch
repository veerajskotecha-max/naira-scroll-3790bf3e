+  it("opens the main fixture at &dropAt, so a petal can be watched opening", () => {
+    const preview = readPreviewDrops("?drop=sealed&dropAt=2026-11-06T02:00:00Z", now)!;
+    expect(preview.drops.find((d) => d.id.endsWith("fleur"))!.membersFrom).toBe("2026-11-06T07:30:00+05:30");
