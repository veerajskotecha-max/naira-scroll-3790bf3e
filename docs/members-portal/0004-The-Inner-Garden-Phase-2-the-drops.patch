+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Drop } from "@/lib/portal/drops";
+import { MASK, REVEAL_AT, RubMask, SAMPLE_EVERY } from "@/lib/portal/rubMask";
+import { hasDropFlag } from "@/lib/portal/safeStorage";
+import PetalReveal from "./PetalReveal";
+
+/* Rub the petals: a fingertip wipes the drop's petals off its teaser, and
+   "Reveal" does the same in one tap. Both end in exactly the same place.
+   Under reduced motion the canvas is never made. The 64 x 64 coverage mask
+   is read at most once every 8 moves. */
+
+const drop: Drop = {
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
+  accent: "#2F6B4F",
+  story: [],
+  membersFrom: "2026-11-21T20:00:00+05:30",
+  everyoneFrom: "2026-11-23T20:00:00+05:30",
+  handles: ["a"],
+  leadHandle: "a",
+};
+const IMAGE = "https://cdn.shopify.com/s/files/1/0680/9606/5698/files/teaser.jpg?v=1";
+
+/* jsdom has no canvas and no PointerEvent: a 2D context that records, and a
+   pointer event that carries its coordinates. */
+const ctx = () => {
+  const calls: string[] = [];
+  const rec = (name: string) => vi.fn(() => void calls.push(name));
+  return {
+    calls,
+    context: {
+      setTransform: rec("setTransform"),
+      fillRect: rec("fillRect"),
+      save: rec("save"),
+      restore: rec("restore"),
+      translate: rec("translate"),
+      rotate: rec("rotate"),
+      scale: rec("scale"),
+      fill: rec("fill"),
+      stroke: rec("stroke"),
+      beginPath: rec("beginPath"),
+      moveTo: rec("moveTo"),
+      lineTo: rec("lineTo"),
+      arc: rec("arc"),
+    } as unknown as CanvasRenderingContext2D,
+  };
+};
+
+beforeAll(() => {
+  if (!("PointerEvent" in window)) {
+    class FakePointerEvent extends MouseEvent {
+      pointerId: number;
+      constructor(type: string, init: PointerEventInit = {}) {
+        super(type, init);
+        this.pointerId = init.pointerId ?? 1;
+      }
+    }
+    Object.defineProperty(window, "PointerEvent", { value: FakePointerEvent, configurable: true });
+  }
+});
+
+const setReducedMotion = (reduce: boolean) => {
+  window.matchMedia = ((query: string) => ({
+    matches: reduce && query.includes("reduce"),
+    media: query,
+    onchange: null,
+    addListener: () => {},
+    removeListener: () => {},
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    dispatchEvent: () => false,
+  })) as typeof window.matchMedia;
+};
+
+let painter: ReturnType<typeof ctx>;
+beforeEach(() => {
+  window.localStorage.clear();
+  setReducedMotion(false);
+  painter = ctx();
+  vi.spyOn(HTMLCanvasElement.prototype, "getContext").mockImplementation((() => painter.context) as never);
+});
+afterEach(() => {
+  cleanup();
+  vi.restoreAllMocks();
+});
+
+/* Rubs a zigzag over the whole 320 x 320 card (jsdom lays nothing out, so the card falls back to 320). */
+const rubAll = (canvas: Element) => {
+  fireEvent.pointerDown(canvas, { clientX: 8, clientY: 8, pointerId: 1 });
+  let moves = 0;
+  for (let row = 0; row <= 10 && document.querySelector(".ig-reveal-canvas"); row++) {
+    for (let i = 0; i <= 10; i++) {
+      const x = row % 2 ? 320 - i * 32 : i * 32;
+      fireEvent.pointerMove(canvas, { clientX: x, clientY: row * 32, pointerId: 1 });
+      moves++;
+    }
+  }
+  fireEvent.pointerUp(canvas, { pointerId: 1 });
+  return moves;
+};
+
+describe("rub the petals", () => {
+  it("paints the drop's petals over the teaser and wipes them with destination-out", () => {
+    const { container } = render(<PetalReveal drop={drop} imageUrl={IMAGE} alt="A first look: Verdant Pendant" />);
+    const canvas = container.querySelector(".ig-reveal-canvas")!;
+    expect(canvas).not.toBeNull();
+    expect(painter.calls).toContain("fillRect");
+    expect(painter.context.globalCompositeOperation).toBe("destination-out");
+    expect(painter.context.lineWidth).toBe(56);
+    expect(screen.getByText("Rub the petals")).toBeInTheDocument();
+    // Hidden from a screen reader until it is uncovered.
+    expect(container.querySelector(".ig-reveal-img")!.getAttribute("alt")).toBe("");
+  });
+
+  it("lifts the rest of the petals once enough is rubbed away, and remembers it", () => {
+    const { container } = render(<PetalReveal drop={drop} imageUrl={IMAGE} alt="A first look: Verdant Pendant" />);
+    const moves = rubAll(container.querySelector(".ig-reveal-canvas")!);
+    expect(container.querySelector(".ig-reveal-canvas")).toBeNull();
+    expect(moves).toBeLessThan(121);
+    expect(screen.getByRole("img", { name: "A first look: Verdant Pendant" })).toBeInTheDocument();
+    expect(hasDropFlag("revealed", drop.id)).toBe(true);
+  });
+
+  it("ends in exactly the same place with the Reveal button", () => {
+    const rubbed = render(<PetalReveal drop={drop} imageUrl={IMAGE} alt="A first look: Verdant Pendant" />);
+    rubAll(rubbed.container.querySelector(".ig-reveal-canvas")!);
+    const afterRub = rubbed.container.innerHTML;
+    cleanup();
+    window.localStorage.clear();
+    const tapped = render(<PetalReveal drop={drop} imageUrl={IMAGE} alt="A first look: Verdant Pendant" />);
+    fireEvent.click(screen.getByRole("button", { name: "Reveal" }));
+    expect(tapped.container.innerHTML).toBe(afterRub);
+    expect(hasDropFlag("revealed", drop.id)).toBe(true);
+    expect(screen.getByText(/Everyone uncovers the same piece; there is no lottery/)).toBeInTheDocument();
+  });
+
+  it("reads the coverage mask at most once every 8 moves", () => {
+    const coverage = vi.spyOn(RubMask.prototype, "coverage");
+    const { container } = render(<PetalReveal drop={drop} imageUrl={IMAGE} alt="x" />);
+    const canvas = container.querySelector(".ig-reveal-canvas")!;
+    fireEvent.pointerDown(canvas, { clientX: 20, clientY: 20, pointerId: 1 });
+    // 41 small moves in one corner: never enough to reveal.
+    for (let i = 0; i < 41; i++) fireEvent.pointerMove(canvas, { clientX: 20 + (i % 4), clientY: 20, pointerId: 1 });
+    expect(container.querySelector(".ig-reveal-canvas")).not.toBeNull();
+    expect(coverage).toHaveBeenCalledTimes(Math.floor(41 / SAMPLE_EVERY));
+  });
+
+  it("never makes the canvas under reduced motion; Reveal lifts the petals", () => {
+    setReducedMotion(true);
+    const getContext = HTMLCanvasElement.prototype.getContext as unknown as ReturnType<typeof vi.fn>;
+    const { container } = render(<PetalReveal drop={drop} imageUrl={IMAGE} alt="A first look: Verdant Pendant" />);
+    expect(container.querySelector("canvas")).toBeNull();
+    expect(getContext).not.toHaveBeenCalled();
+    expect(container.querySelector(".ig-reveal-cover")).not.toBeNull();
+    fireEvent.click(screen.getByRole("button", { name: "Reveal" }));
+    expect(container.querySelector(".ig-reveal-cover")).toBeNull();
+    expect(screen.getByRole("img", { name: "A first look: Verdant Pendant" })).toBeInTheDocument();
+  });
+
+  it("shows the teaser at once to a device that has already uncovered it", () => {
+    window.localStorage.setItem("naira-portal", JSON.stringify({ revealed: { verdant: true } }));
+    const { container } = render(<PetalReveal drop={drop} imageUrl={IMAGE} alt="A first look: Verdant Pendant" />);
+    expect(container.querySelector("canvas")).toBeNull();
+    expect(screen.queryByRole("button", { name: "Reveal" })).toBeNull();
+  });
+
+  it("still works where the phone has no 2D canvas, through Reveal", () => {
+    vi.spyOn(HTMLCanvasElement.prototype, "getContext").mockReturnValue(null);
+    const { container } = render(<PetalReveal drop={drop} imageUrl={IMAGE} alt="A first look: Verdant Pendant" />);
+    fireEvent.pointerDown(container.querySelector(".ig-reveal-canvas")!, { clientX: 5, clientY: 5 });
+    fireEvent.click(screen.getByRole("button", { name: "Reveal" }));
+    expect(container.querySelector("canvas")).toBeNull();
+  });
+});
+
+describe("the coverage mask", () => {
+  it("is 64 x 64 and counts each cleared cell once", () => {
+    const m = new RubMask(320, 320);
+    expect(m.cells).toHaveLength(MASK * MASK);
+    m.stamp(160, 160, 28);
+    const once = m.coverage();
+    m.stamp(160, 160, 28);
+    expect(m.coverage()).toBe(once);
+    // A 28 px circle on a 320 px card is about 2.4% of it.
+    expect(once).toBeGreaterThan(0.02);
+    expect(once).toBeLessThan(0.03);
+  });
+
+  it("reaches the reveal threshold under a full sweep", () => {
+    const m = new RubMask(320, 320);
+    for (let y = 0; y <= 320; y += 40) m.line(0, y, 320, y);
+    expect(m.coverage()).toBeGreaterThanOrEqual(REVEAL_AT);
+  });
+});
