+import type { Drop } from "./drops";
+import { SPECIES, PAPER, mixHex } from "./species";
+import { speciesIndex } from "./dropPhase";
+import { hashString, mulberry32 } from "./gardenLayout";
+
+/* The drift of a drop's own petals that covers its teaser (components/portal/PetalReveal). */
+
+const PETALS = 120;
+
+/** The drop's petals over the whole card: seeded by the drop, so every phone shows the same drift. */
+export const paintPetals = (ctx: CanvasRenderingContext2D, w: number, h: number, drop: Drop) => {
+  const s = SPECIES[speciesIndex(drop.species)];
+  const rand = mulberry32(hashString(`petals:${drop.id}`));
+  const tones = [drop.accent, mixHex(drop.accent, PAPER, 0.3), mixHex(drop.accent, PAPER, 0.55), "#FFF6EA", "#FFBDA8", mixHex(drop.accent, "#1A1614", 0.12)];
+  ctx.fillStyle = mixHex(drop.accent, PAPER, 0.78);
+  ctx.fillRect(0, 0, w, h);
+  const petal = typeof Path2D === "function" ? new Path2D(s.d) : null;
+  if (!petal) return;
+  const unit = Math.max(w, h) / 360;
+  for (let i = 0; i < PETALS; i++) {
+    const x = -20 + rand() * (w + 40);
+    const y = -20 + rand() * (h + 40);
+    const k = (0.42 + rand() * 0.5) * unit;
+    ctx.save();
+    ctx.translate(x, y);
+    ctx.rotate(rand() * Math.PI * 2);
+    ctx.scale(k, k);
+    ctx.translate(-20, -40);
+    ctx.fillStyle = tones[Math.floor(rand() * tones.length)];
+    ctx.fill(petal);
+    if (rand() < 0.3) {
+      ctx.lineWidth = 0.9 / k;
+      ctx.strokeStyle = "rgba(176, 132, 58, 0.55)";
+      ctx.stroke(petal);
+    }
+    ctx.restore();
+  }
+};
