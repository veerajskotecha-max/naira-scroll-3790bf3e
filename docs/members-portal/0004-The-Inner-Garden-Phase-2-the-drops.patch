+++ b/src/lib/portal/newIn.ts
@@ -0,0 +1,85 @@
+import { useQuery } from "@tanstack/react-query";
+import type { JewelPiece } from "@/data/jewellery";
+import { DAY } from "./dropPhase";
+import { formatIstDay } from "./ist";
+
+/*
+  New in the garden: the Naira Petite pieces the shop has published in the
+  last 14 days, newest first, each dated as it arrived ("Arrived 3 Nov").
+  The shop's shared catalogue query does not ask for publishedAt, and is left
+  exactly as it is: this is the portal's own small query (handles and dates
+  only), joined by handle to the shared live catalogue for the photo, the
+  name, the live price and Available / Sold out.
+
+  It posts to the Storefront API itself, with the shop's public Storefront
+  address and token (newIn.test checks they are lib/shopify's own): reaching
+  for lib/shopify's request helper would add an export to the entry chunk
+  every page downloads.
+*/
+
+export const STOREFRONT_URL = "https://nc5eti-gp.myshopify.com/api/2025-07/graphql.json";
+export const STOREFRONT_TOKEN = "0f6fd83502924ac437a5d19180bb08c3";
+
+export const NEW_IN_QUERY = `
+  query PortalNewIn {
+    products(first: 30, sortKey: CREATED_AT, reverse: true, query: "vendor:'Naira Petite'") {
+      edges {
+        node {
+          handle
+          publishedAt
+          availableForSale
+        }
+      }
+    }
+  }
+`;
+
+export const FRESH_DAYS = 14;
+export const MAX_SHOOTS = 12;
+
+export type NewInNode = { handle: string; publishedAt: string; availableForSale: boolean };
+export type Shoot = { piece: JewelPiece; publishedAt: string; arrived: string };
+
+type Answer = { data: { products: { edges: { node: NewInNode }[] } } };
+
+export const fetchNewIn = async (): Promise<NewInNode[]> => {
+  const res = await fetch(STOREFRONT_URL, {
+    method: "POST",
+    headers: { "Content-Type": "application/json", "X-Shopify-Storefront-Access-Token": STOREFRONT_TOKEN },
+    body: JSON.stringify({ query: NEW_IN_QUERY }),
+  });
+  if (!res.ok) throw new Error(`Shopify answered ${res.status}`);
+  const answer = (await res.json()) as Answer & { errors?: { message: string }[] };
+  if (answer.errors?.length) throw new Error(answer.errors.map((e) => e.message).join(", "));
+  return answer.data.products.edges.map((e) => e.node);
+};
+
+/**
+ * The pieces published in the last FRESH_DAYS before `now`, newest first,
+ * joined to the live catalogue. A handle the catalogue does not carry (not
+ * jewellery, or not live) is left out rather than shown half-known.
+ */
+export const freshShoots = (nodes: readonly NewInNode[], now: number, catalogue: readonly JewelPiece[], limit = MAX_SHOOTS): Shoot[] => {
+  const byHandle = new Map(catalogue.map((p) => [p.handle, p]));
+  const from = now - FRESH_DAYS * DAY;
+  const seen = new Set<string>();
+  return nodes
+    .filter((n) => {
+      const t = Date.parse(n.publishedAt);
+      return t >= from && t <= now && byHandle.has(n.handle);
+    })
+    .sort((a, b) => Date.parse(b.publishedAt) - Date.parse(a.publishedAt))
+    .filter((n) => (seen.has(n.handle) ? false : (seen.add(n.handle), true)))
+    .slice(0, limit)
+    .map((n) => ({ piece: byHandle.get(n.handle) as JewelPiece, publishedAt: n.publishedAt, arrived: `Arrived ${formatIstDay(n.publishedAt)}` }));
+};
+
+export const useNewIn = (enabled = true) =>
+  useQuery({
+    queryKey: ["portal", "new-in"],
+    queryFn: fetchNewIn,
+    enabled,
+    staleTime: 5 * 60_000,
+    refetchOnWindowFocus: false,
+    retry: 1,
+  });
