@@ -0,0 +1,164 @@
+/* A drop's room: rub the petals, the unboxing, the pieces and the press.
+   Imported only by DropRoom.tsx. Motion is transform and opacity only. */
+
+.ig-room {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 0.5rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-room-back { align-self: flex-start; margin-bottom: 0.4rem; text-decoration: none; }
+.ig-room-story {
+  max-width: 26rem;
+  margin: 0.35rem auto 0;
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 1.08rem;
+  line-height: 1.5;
+  color: rgb(var(--nf-ink-rgb) / 0.74);
+}
+.ig-room-clock { display: flex; flex-direction: column; align-items: center; }
+.ig-room-kept { display: flex; justify-content: center; }
+.ig-room-kept .ig-herb { width: min(76%, 280px); }
+
+/* rub the petals */
+.ig-reveal-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
+.ig-reveal {
+  position: relative;
+  width: 100%;
+  aspect-ratio: 1;
+  overflow: hidden;
+  border: 1px solid var(--ig-gold-line);
+  background: var(--nf-surface-raised);
+}
+.ig-reveal-img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.ig-reveal-canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; }
+.ig-reveal-cover { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; background: var(--ig-vellum); }
+.ig-reveal-hint {
+  position: absolute;
+  left: 50%;
+  bottom: 14px;
+  margin: 0;
+  padding: 6px 12px;
+  transform: translateX(-50%);
+  border: 1px solid var(--ig-gold-line);
+  background: rgb(var(--nf-ivory-rgb) / 0.9);
+  font-family: var(--nf-font-label);
+  font-size: 10px;
+  letter-spacing: var(--nf-track-24);
+  text-transform: uppercase;
+  white-space: nowrap;
+  pointer-events: none;
+}
+.ig-reveal-note { text-align: center; }
+
+/* the unboxing */
+.ig-unbox { position: relative; display: flex; flex-direction: column; align-items: center; margin-top: 1.4rem; overflow-x: clip; }
+.ig-unbox-stage { position: relative; display: flex; justify-content: center; padding-top: 30px; }
+.ig-unbox-petals { position: absolute; inset: 0; overflow: visible; pointer-events: none; }
+.ig-unbox-skip { position: absolute; top: 0; right: 0; }
+.ig-box { position: relative; user-select: none; }
+.ig-box-3d { transform-style: preserve-3d; }
+.ig-box-shadow {
+  position: absolute;
+  background: radial-gradient(ellipse at center, rgb(26 22 20 / 0.22), rgb(26 22 20 / 0) 68%);
+  pointer-events: none;
+}
+.ig-box-card {
+  position: absolute;
+  inset: 0;
+  display: block;
+  padding: 6%;
+  border: 1px solid rgb(var(--nf-gold-rgb) / 0.8);
+  background: #fffaf5;
+}
+.ig-box-card img { display: block; width: 100%; height: 100%; object-fit: cover; }
+
+/* the pieces */
+.ig-pieces { display: grid; gap: 0.9rem; width: 100%; }
+.ig-piece {
+  display: grid;
+  grid-template-columns: 38% 1fr;
+  gap: 0.9rem;
+  padding: 0.75rem;
+  border: 1px solid var(--ig-line);
+  background: var(--ig-vellum);
+  text-align: left;
+}
+.ig-piece-photo { display: block; align-self: start; aspect-ratio: 1; overflow: hidden; background: var(--nf-surface-raised); }
+.ig-piece-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.ig-piece-photo--blank { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--nf-surface-raised), rgb(var(--nf-gold-rgb) / 0.12)); }
+.ig-piece-body { display: flex; flex-direction: column; align-items: flex-start; gap: 0.45rem; min-width: 0; }
+.ig-piece-name { margin: 0; font-family: var(--nf-font-editorial); font-weight: 400; font-size: 1.25rem; line-height: 1.2; }
+.ig-piece-name a { color: inherit; text-decoration: none; }
+.ig-piece .ig-price { justify-content: flex-start; font-size: 15px; }
+.ig-piece-opt { display: flex; flex-direction: column; gap: 0.2rem; width: 100%; }
+.ig-piece-opt span {
+  font-family: var(--nf-font-label);
+  font-size: 9.5px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.62);
+}
+.ig-piece-opt select {
+  width: 100%;
+  height: 40px;
+  padding: 0 0.5rem;
+  border: 1px solid rgb(var(--nf-ink-rgb) / 0.25);
+  border-radius: 0;
+  background: var(--nf-ivory);
+  font-family: var(--nf-font-label);
+  font-size: 14px;
+  color: var(--nf-ink);
+}
+.ig-piece-actions { display: flex; flex-direction: column; gap: 0.4rem; width: 100%; }
+.ig-piece .ig-btn { height: 44px; font-size: 10.5px; }
+
+/* reserve, kinds, arriving */
+.ig-reserve { margin: 0.8rem 0 0; padding: 0; list-style: none; }
+.ig-reserve li {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  justify-content: space-between;
+  gap: 0 1rem;
+  padding: 0.3rem 0;
+  border-bottom: 1px solid var(--ig-line);
+  font-family: var(--nf-font-editorial);
+  font-size: 1.12rem;
+}
+.ig-kinds { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1rem; }
+.ig-kind {
+  min-height: 40px;
+  padding: 0 0.9rem;
+  border: 1px solid var(--ig-line);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 10.5px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.75);
+  cursor: pointer;
+}
+.ig-kind[aria-pressed="true"] { border-color: var(--nf-accent-strong); background: var(--ig-vellum); color: var(--nf-ink); }
+.ig-arriving { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-arriving > .ig-h2 { border: 0; margin: 0.6rem 0 0; padding: 0; }
+
+/* press your flower */
+.ig-press { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-press > .ig-h2 { align-self: stretch; text-align: left; }
+.ig-press-stage { width: min(72%, 270px); margin-bottom: 1.1rem; }
+.ig-herb.is-waiting .ig-herb-flower { opacity: 0; }
+.ig-press .ig-herb.is-waiting .ig-herb-sheet { background: var(--ig-vellum); }
+.ig-press-bloom { position: absolute; inset: 11% 0; display: flex; justify-content: center; transform-origin: 50% 62%; }
+.ig-press-bloom svg { display: block; height: 100%; width: auto; overflow: visible; }
+.ig-press-note { max-width: 22rem; }
+
+@media (min-width: 768px) {
+  .ig-room { padding-top: 1.25rem; }
+  .ig-pieces { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .ig-piece { grid-template-columns: 1fr; }
+}
diff --git a/src/pages/members/drops.css b/src/pages/members/drops.css
new file mode 100644
index 0000000..c36d240
--- /dev/null
+++ b/src/pages/members/drops.css
@@ -0,0 +1,89 @@
+/* /members/drops: the drop calendar and New in the garden. Imported only by
+   Drops.tsx, so it ships in that room's own stylesheet. */
+
+.ig-drops {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-story {
+  max-width: 26rem;
+  margin: 0.2rem auto 0;
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 1.08rem;
+  line-height: 1.5;
+  color: rgb(var(--nf-ink-rgb) / 0.74);
+}
+
+/* the open drop */
+.ig-open-drop {
+  display: flex;
+  align-items: center;
+  gap: 0.9rem;
+  width: 100%;
+  margin-top: 1.8rem;
+  padding: 0.9rem 1rem;
+  border: 1px solid var(--ig-gold-line);
+  outline: 1px solid rgb(var(--nf-gold-rgb) / 0.28);
+  outline-offset: -7px;
+  background: var(--ig-vellum);
+  color: inherit;
+  text-align: left;
+  text-decoration: none;
+}
+.ig-open-art { flex: none; display: flex; }
+.ig-open-text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
+.ig-open-title { font-family: var(--nf-font-editorial); font-size: 1.7rem; line-height: 1.1; }
+.ig-open-story { font-family: var(--nf-font-editorial); font-style: italic; font-size: 1rem; line-height: 1.4; color: rgb(var(--nf-ink-rgb) / 0.72); }
+
+/* the next drop */
+.ig-next { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-next > .ig-h2 { align-self: stretch; text-align: left; }
+.ig-next-title {
+  display: flex;
+  flex-direction: column;
+  gap: 0.2rem;
+  margin: 1.4rem 0 0.2rem;
+  font-family: var(--nf-font-editorial);
+  font-size: 1.9rem;
+  line-height: 1.1;
+}
+
+/* nothing set yet */
+.ig-none { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-none > .ig-h2 { border: 0; padding: 0; margin: 0.9rem 0 0; }
+.ig-none-frame {
+  display: flex;
+  justify-content: center;
+  width: 132px;
+  padding: 1.1rem 0 0.6rem;
+  border: 1px solid var(--ig-gold-line);
+  outline: 1px solid rgb(var(--nf-gold-rgb) / 0.25);
+  outline-offset: -7px;
+}
+.ig-none-frame svg { opacity: 0.55; }
+
+/* new in the garden */
+.ig-shoots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem 0.75rem; margin: 1rem 0 0; padding: 0; list-style: none; }
+.ig-shoot-card { display: flex; flex-direction: column; gap: 0.3rem; color: inherit; text-decoration: none; }
+.ig-shoot-photo { display: block; aspect-ratio: 1; overflow: hidden; background: var(--nf-surface-raised); }
+.ig-shoot-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.ig-shoot-when { display: flex; align-items: flex-end; gap: 0.3rem; margin-top: 0.15rem; }
+.ig-shoot { flex: none; width: 13px; height: 22px; }
+.ig-shoot path { fill: none; stroke: var(--nf-accent-strong); stroke-width: 1.1; stroke-dasharray: 1 1; }
+.ig-shoot path + path { fill: rgb(153 180 175 / 0.35); }
+.ig-shoot-name { font-family: var(--nf-font-editorial); font-size: 1.08rem; line-height: 1.25; }
+.ig-shoot-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.15rem 0.45rem; font-family: var(--nf-font-label); font-size: 13px; }
+.ig-shoot-price s { font-size: 11.5px; color: rgb(var(--nf-ink-rgb) / 0.6); }
+
+.ig-vault-link { width: 100%; margin-top: 2.5rem; text-align: left; }
+
+@media (min-width: 768px) {
+  .ig-drops { padding-top: 2rem; }
+  .ig-shoots { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
