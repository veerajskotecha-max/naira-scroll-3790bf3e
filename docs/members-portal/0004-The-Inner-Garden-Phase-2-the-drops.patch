+import { mulberry32, hashString } from "./gardenLayout";
+
+/*
+  The unboxing's petals: at most 24 flat petals in the drop's colour, thrown
+  up out of the open drawer and falling back under gravity. Each flight is
+  worked out before the box opens (a seeded ballistic arc sampled into eight
+  WAAPI keyframes of transform and opacity), so the moment it starts costs
+  nothing but starting it. Every flight ends, and its node is removed, by
+  1.6 s from the burst.
+*/
+
+export const MAX_BURST = 24;
+export const BURST_MS = 1600;
+
+export type Flight = {
+  keyframes: Keyframe[];
+  duration: number;
+  delay: number;
+  /** Petal size in px. */
+  size: number;
+  /** 0 = the accent, 1 = its paler tint. */
+  tone: 0 | 1;
+};
+
+type Options = {
+  /** How far the petals fly out, in px. */
+  spread?: number;
+  /** How high the fastest is thrown, in px. */
+  lift?: number;
+  seed?: string;
+};
+
+const STEPS = 8;
+
+export const ballisticFlights = (count: number, { spread = 150, lift = 190, seed = "naira" }: Options = {}): Flight[] => {
+  const n = Math.max(0, Math.min(MAX_BURST, Math.floor(count)));
+  const rand = mulberry32(hashString(seed));
+  const flights: Flight[] = [];
+  for (let i = 0; i < n; i++) {
+    const delay = Math.round(rand() * 140);
+    const duration = Math.round(1050 + rand() * (BURST_MS - 1050 - delay - 20));
+    const T = duration / 1000;
+    // Up and out of the drawer, in a fan: -150° to -30° from the horizontal.
+    const angle = ((-150 + (i / Math.max(1, n - 1)) * 120 + (rand() - 0.5) * 18) * Math.PI) / 180;
+    const speed = 0.62 + rand() * 0.38;
+    // The fastest petal tops out at `lift` 40% of the way through, and falls past where it began.
+    const g = (12.5 * lift) / (T * T);
+    const vy = Math.sin(angle) * Math.sqrt(2 * g * lift) * speed;
+    const vx = (Math.cos(angle) * spread * speed) / (T * 0.7);
+    const spin = (rand() < 0.5 ? -1 : 1) * (240 + rand() * 420);
+    const sway = 6 + rand() * 10;
+    const keyframes: Keyframe[] = [];
+    for (let k = 0; k <= STEPS; k++) {
+      const f = k / STEPS;
+      const t = f * T;
+      const drag = 1 - 0.35 * f; // air takes the sideways speed off
+      const x = vx * t * drag + Math.sin(f * Math.PI * 2) * sway;
+      const y = vy * t + 0.5 * g * t * t;
+      const opacity = f === 0 ? 0 : f < 0.12 ? 1 : f > 0.78 ? Math.max(0, 1 - (f - 0.78) / 0.22) : 1;
+      keyframes.push({
+        transform: `translate(-50%,-50%) translate(${x.toFixed(1)}px,${y.toFixed(1)}px) rotate(${(spin * f).toFixed(0)}deg) scale(${f === 0 ? 0.4 : 1})`,
+        opacity: Number(opacity.toFixed(2)),
+        offset: f,
+      });
+    }
+    flights.push({ keyframes, duration, delay, size: Math.round(10 + rand() * 9), tone: rand() < 0.6 ? 0 : 1 });
+  }
+  return flights;
+};
