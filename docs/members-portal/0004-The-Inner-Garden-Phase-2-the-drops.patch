+import { afterEach, describe, expect, it, vi } from "vitest";
+import { PRODUCTS_QUERY, SHOPIFY_STOREFRONT_TOKEN, SHOPIFY_STOREFRONT_URL } from "@/lib/shopify";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { FRESH_DAYS, MAX_SHOOTS, NEW_IN_QUERY, STOREFRONT_TOKEN, STOREFRONT_URL, fetchNewIn, freshShoots, type NewInNode } from "./newIn";
+
+/* New in the garden: the pieces published in the last 14 days, dated as
+   they arrived in India, joined to the live catalogue. Its own small query;
+   the shop's shared catalogue query is not touched. */
+
+afterEach(() => vi.restoreAllMocks());
+
+const now = Date.parse("2026-11-05T06:30:00Z"); // 12:00 IST, 5 Nov
+const [a, b, c] = jewellerySnapshot;
+const node = (handle: string, publishedAt: string): NewInNode => ({ handle, publishedAt, availableForSale: true });
+
+describe("freshShoots", () => {
+  it("keeps the last 14 days, newest first, dated in IST", () => {
+    const shoots = freshShoots(
+      [node(a.handle, "2026-11-02T21:10:00Z"), node(b.handle, "2026-11-04T06:33:00Z"), node(c.handle, "2026-10-20T10:00:00Z")],
+      now,
+      jewellerySnapshot,
+    );
+    expect(shoots.map((s) => s.piece.handle)).toEqual([b.handle, a.handle]);
+    // 21:10 UTC on 2 Nov is 02:40 on 3 Nov in India.
+    expect(shoots[1].arrived).toBe("Arrived 3 Nov");
+    expect(shoots[0].arrived).toBe("Arrived 4 Nov");
+  });
+
+  it("draws the line at exactly 14 days", () => {
+    const edge = new Date(now - FRESH_DAYS * 86_400_000).toISOString();
+    const before = new Date(now - FRESH_DAYS * 86_400_000 - 1).toISOString();
+    expect(freshShoots([node(a.handle, edge), node(b.handle, before)], now, jewellerySnapshot).map((s) => s.piece.handle)).toEqual([a.handle]);
+  });
+
+  it("leaves out a handle the live catalogue does not carry, and anything not yet published", () => {
+    expect(freshShoots([node("not-in-the-shop", "2026-11-04T00:00:00Z"), node(a.handle, "2026-11-06T00:00:00Z")], now, jewellerySnapshot)).toEqual([]);
+  });
+
+  it("shows at most 12, each once", () => {
+    const many = jewellerySnapshot.slice(0, 20).map((p, i) => node(p.handle, new Date(now - i * 3_600_000).toISOString()));
+    const shoots = freshShoots([...many, many[0]], now, jewellerySnapshot);
+    expect(shoots).toHaveLength(MAX_SHOOTS);
+    expect(new Set(shoots.map((s) => s.piece.handle)).size).toBe(MAX_SHOOTS);
+  });
+});
+
+describe("the portal's own query", () => {
+  it("asks only for the newest Naira Petite handles and their dates", () => {
+    expect(NEW_IN_QUERY).toMatch(/products\(first: 30, sortKey: CREATED_AT, reverse: true, query: "vendor:'Naira Petite'"\)/);
+    expect(NEW_IN_QUERY).toMatch(/handle\s+publishedAt\s+availableForSale/);
+    expect(NEW_IN_QUERY).not.toMatch(/price|variants|images/);
+  });
+
+  it("leaves the shop's shared catalogue query as it was", () => {
+    expect(PRODUCTS_QUERY).not.toMatch(/publishedAt|PortalNewIn/);
+    expect(PRODUCTS_QUERY).not.toBe(NEW_IN_QUERY);
+  });
+
+  it("posts to the shop's own Storefront address with its own public token", async () => {
+    expect(STOREFRONT_URL).toBe(SHOPIFY_STOREFRONT_URL);
+    expect(STOREFRONT_TOKEN).toBe(SHOPIFY_STOREFRONT_TOKEN);
+    const fetchMock = vi.spyOn(globalThis, "fetch").mockResolvedValue(
+      new Response(JSON.stringify({ data: { products: { edges: [{ node: node("x", "2026-11-04T00:00:00Z") }] } } }), { status: 200 }),
+    );
+    expect(await fetchNewIn()).toEqual([node("x", "2026-11-04T00:00:00Z")]);
+    const [url, init] = fetchMock.mock.calls[0] as [string, RequestInit];
+    expect(url).toBe(SHOPIFY_STOREFRONT_URL);
+    expect(init.method).toBe("POST");
+    expect((init.headers as Record<string, string>)["X-Shopify-Storefront-Access-Token"]).toBe(SHOPIFY_STOREFRONT_TOKEN);
+    expect(JSON.parse(String(init.body)).query).toBe(NEW_IN_QUERY);
+  });
+
+  it("fails loudly on an error answer, so the room says it could not reach the shop", async () => {
+    vi.spyOn(globalThis, "fetch").mockResolvedValue(new Response("{}", { status: 500 }));
+    await expect(fetchNewIn()).rejects.toThrow(/500/);
+  });
+});
