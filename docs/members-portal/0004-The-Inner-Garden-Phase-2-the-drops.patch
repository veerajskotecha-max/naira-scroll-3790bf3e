@@ -0,0 +1,134 @@
+import { useEffect, useMemo, useRef } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import BloomClock from "@/components/portal/BloomClock";
+import CalendarButton from "@/components/portal/CalendarButton";
+import NewInGarden from "@/components/portal/NewInGarden";
+import { BudGlyph, FlowerGlyph } from "@/components/portal/FlowerGlyph";
+import { useMember } from "@/components/portal/MemberContext";
+import { useDropShop } from "@/components/portal/useDropShop";
+import { eyebrow, textLink } from "@/components/portal/styles";
+import { byOpening, dropNumber, dropPhase, phaseBoundaries, speciesIndex, timeOf, VAULT_AFTER_MS, type DropPhase } from "@/lib/portal/dropPhase";
+import { useServerNow } from "@/lib/portal/clock";
+import type { Drop } from "@/lib/portal/drops";
+import "./drops.css";
+
+/*
+  /members/drops: the drop calendar. The drop that is open (if any), as an
+  open flower and a way into its room; the next drop as its sealed bud on the
+  Bloom Clock, with its opening in Indian time and "Add to my calendar"; then
+  New in the garden. With no drop set, it says so: "No drop is open right
+  now. The next one will bloom here." No counts of any kind, and no clock
+  running to nothing.
+*/
+
+const OPEN_WORDS: Partial<Record<DropPhase, string>> = {
+  members: "Open now · a first look",
+  public: "Now on the shop",
+  arriving: "Opening shortly · ask on WhatsApp",
+};
+
+const OpenDrop = ({ drop, phase, number }: { drop: Drop; phase: DropPhase; number: string }) => (
+  <Link to={`/members/drops/${drop.id}`} className="ig-open-drop">
+    <span className="ig-open-art" aria-hidden>
+      <FlowerGlyph species={speciesIndex(drop.species)} accent={drop.accent} state="bloom" size={112} />
+    </span>
+    <span className="ig-open-text">
+      <span className={eyebrow}>
+        Drop {number} · {OPEN_WORDS[phase]}
+      </span>
+      <span className="ig-open-title">{drop.title}</span>
+      {drop.story[0] && <span className="ig-open-story">{drop.story[0]}</span>}
+      <span className="ig-card-more">{phase === "arriving" ? "See the room →" : "Enter the drop →"}</span>
+    </span>
+  </Link>
+);
+
+const Drops = () => {
+  const { drops } = useMember();
+  const ordered = useMemo(() => byOpening(drops), [drops]);
+  const marks = useMemo(() => phaseBoundaries(drops), [drops]);
+  const now = useServerNow(marks, drops.length > 0);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const opened = ordered.filter((d) => now >= timeOf(d.membersFrom) && now < timeOf(d.everyoneFrom) + VAULT_AFTER_MS).reverse();
+  const next = ordered.find((d) => now < timeOf(d.membersFrom));
+  const vaulted = ordered.some((d) => now >= timeOf(d.everyoneFrom) + VAULT_AFTER_MS);
+  const shop = useDropShop(opened.length > 0);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  // A drop is waiting: fetch its room's code while she reads.
+  useEffect(() => {
+    if (!next && !opened.length) return;
+    const t = window.setTimeout(() => void import("./DropRoom").catch(() => undefined), 1200);
+    return () => window.clearTimeout(t);
+  }, [next, opened.length]);
+
+  return (
+    <PortalShell title="Drops" description="Drops in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-drops">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            The <em>drops</em>
+          </h1>
+          <p className="ig-lede">A first look at every new drop, on a real clock in Indian time.</p>
+        </div>
+
+        {opened.map((d) => (
+          <OpenDrop key={d.id} drop={d} phase={dropPhase(d, now, shop.live)} number={dropNumber(d, drops)} />
+        ))}
+
+        {next ? (
+          <section className="ig-section ig-next" aria-labelledby="ig-next">
+            <h2 id="ig-next" className="ig-h2">
+              {next.movedFrom ? "The next drop, moved" : "The next drop"}
+            </h2>
+            <BloomClock drop={next} />
+            <p className="ig-next-title">
+              <span className={eyebrow}>Drop {dropNumber(next, drops)}</span>
+              <span>{next.title}</span>
+            </p>
+            {next.story.map((line) => (
+              <p key={line} className="ig-story">
+                {line}
+              </p>
+            ))}
+            <CalendarButton drop={next} />
+            <Link className={textLink} to={`/members/drops/${next.id}`}>
+              Its room: rub the petals for a first look
+            </Link>
+          </section>
+        ) : (
+          !opened.length && (
+            <section className="ig-section ig-none" aria-labelledby="ig-none">
+              <div className="ig-none-frame" aria-hidden>
+                <BudGlyph species={4} accent="#E5B9A4" open={0} size={74} />
+              </div>
+              <h2 id="ig-none" className="ig-h2">
+                No drop is open right now
+              </h2>
+              <p className="ig-fineprint">The next one will bloom here, with its date in Indian time as soon as it is set.</p>
+            </section>
+          )
+        )}
+
+        <NewInGarden />
+
+        {vaulted && (
+          <Link to="/members/vault" className="ig-card-link ig-vault-link">
+            <span className="ig-card-text">
+              <span className={eyebrow}>The Vault</span>
+              <span className="ig-card-title">Every drop, pressed and kept</span>
+              <span className="ig-card-more">Open the Vault →</span>
+            </span>
+          </Link>
+        )}
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Drops;
