+    expect(container.querySelector(".ig-press .ig-herb-label")!.textContent).toBe("Drop 01 · Verdantpressed 21 Nov");
+    expect(JSON.parse(window.localStorage.getItem("naira-portal")!).pressedLocal).toEqual(["verdant"]);
+    // At most 12 petals let go, gone when their flight ends.
+    expect(container.querySelectorAll(".ig-press .ig-petal").length).toBeLessThanOrEqual(12);
