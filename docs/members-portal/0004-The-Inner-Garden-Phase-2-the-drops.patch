 };
+
+/* ── her pressed drop flowers ───────────────────────────
+   Each drop she pressed is planted in the middle row, in its own species
+   and colour, at a place seeded from her id and the drop's, so it stands in
+   the same spot on every visit. Newest are kept when the bed is full. */
+
+export type PressedFlower = { id: string; species: number; accent: string };
+
+export const plantPressed = (seedText: string, pressed: readonly PressedFlower[], room: number): Plant[] =>
+  pressed.slice(Math.max(0, pressed.length - Math.max(0, room))).map((f, i) => {
+    const rand = mulberry32(hashString(`${seedText || "naira"}:${f.id}`));
+    const x = Math.round(52 + rand() * (BED.w - 104));
+    const y = Math.round(384 + rand() * 56);
+    return {
+      id: `drop-${f.id}`,
+      kind: "drop",
+      row: 1,
+      x,
+      y,
+      scale: 0.98,
+      flip: rand() < 0.5,
+      species: f.species,
+      tone: 0,
+      stem: (i % 3) as 0 | 1 | 2,
+      sway: false,
+      band: bandOf(y),
+      swayDur: SWAY_S,
+      swayPhase: windPhase(x, rand()),
+      accent: f.accent,
+    };
+  });
