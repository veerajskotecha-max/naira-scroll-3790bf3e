+describe("the development preview drops", () => {
+  const now = Date.parse("2026-11-05T02:00:00Z");
+
+  it.each(PREVIEW_DROP_STATES.map((s) => [s]))("&drop=%s is a well-formed fixture in that state", (state) => {
+    const preview = readPreviewDrops(`?portalPreview=1&drop=${state}`, now)!;
+    expect(preview).not.toBeNull();
+    for (const d of preview.drops) {
+      expect(dropProblems(d)).toEqual([]);
+      expect(d.id.startsWith(FIXTURE_PREFIX)).toBe(true);
+      expect(d.title).toMatch(/\(preview\)$/);
+      expect(d.story[0]).toMatch(/not a real release/);
+    }
+    const main = preview.drops.find((d) => d.id === `${FIXTURE_PREFIX}fleur`)!;
+    const unlisted = new Set(preview.unlisted);
+    const live = (h: string): LiveState => (unlisted.has(h) ? "unlisted" : "available");
+    expect(dropPhase(main, now, live)).toBe(state);
