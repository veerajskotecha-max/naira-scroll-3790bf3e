+import { useEffect, useMemo, useRef } from "react";
+import { Link } from "react-router-dom";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { freshShoots, useNewIn } from "@/lib/portal/newIn";
+import { serverNow } from "@/lib/portal/clock";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { eyebrow } from "./styles";
+
+/*
+  NEW IN THE GARDEN: what the shop has published in the last 14 days, as
+  fresh shoots, each dated the day it arrived ("Arrived 3 Nov") in Indian
+  time. Photo, name, live ₹ price and Available / Sold out all come from the
+  shop's live catalogue; the dates from the portal's own small query. When
+  the section first comes into view each shoot's gold stem draws itself up.
+*/
+
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
+
+const Shoot = () => (
+  <svg className="ig-shoot" viewBox="0 0 24 40" aria-hidden>
+    <path d="M12 39C12 30 11.5 22 12 12" pathLength={1} />
+    <path d="M12 26C8 25 5 22 4.5 17.5C8.5 18 11 21 12 26Z" pathLength={1} />
+    <path d="M12 18C16 17 19 14 19.5 9.5C15.5 10 13 13 12 18Z" pathLength={1} />
+  </svg>
+);
+
+const NewInGarden = () => {
+  const { data, isError, isLoading: dating } = useNewIn();
+  const { jewellery, isLive, isLoading } = useLiveJewellery();
+  const shoots = useMemo(() => (data && isLive ? freshShoots(data, serverNow(), jewellery) : []), [data, isLive, jewellery]);
+  const listRef = useRef<HTMLUListElement>(null);
+  const grown = useRef(false);
+
+  // The stems draw up once, the first time the shoots are on screen.
+  useEffect(() => {
+    const list = listRef.current;
+    if (!list || grown.current || !shoots.length || stillMotion() || typeof IntersectionObserver === "undefined") return;
+    const io = new IntersectionObserver(([entry]) => {
+      if (!entry.isIntersecting) return;
+      io.disconnect();
+      grown.current = true;
+      list.querySelectorAll(".ig-shoot path").forEach((path, i) =>
+        play(path, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 640, delay: Math.floor(i / 3) * 60 + (i % 3) * 140, easing: EASE_REVEAL, fill: "backwards" }),
+      );
+    }, { threshold: 0.15 });
+    io.observe(list);
+    return () => io.disconnect();
+  }, [shoots.length]);
+
+  const waiting = (dating || isLoading) && !shoots.length && !isError;
+  return (
+    <section className="ig-section ig-newin" aria-labelledby="ig-newin">
+      <h2 id="ig-newin" className="ig-h2">
+        New in the garden
+      </h2>
+      <p className="ig-fineprint">Pieces the shop has added in the last two weeks, newest first.</p>
+      {waiting ? (
+        <p className="ig-fineprint" role="status">
+          Reading the newest pieces from the shop…
+        </p>
+      ) : isError || (!isLive && !isLoading) ? (
+        <p className="ig-fineprint">We couldn't reach the shop just now. <Link className="ig-link" to="/jewellery">See the shop</Link></p>
+      ) : shoots.length === 0 ? (
+        <p className="ig-fineprint">Nothing new in the last two weeks. The next pieces will grow here.</p>
+      ) : (
+        <ul ref={listRef} className="ig-shoots">
+          {shoots.map(({ piece, arrived }) => {
+            const image = piece.cover ?? piece.image;
+            return (
+              <li key={piece.handle}>
+                <Link to={`/jewellery/${piece.handle}`} className="ig-shoot-card">
+                  <span className="ig-shoot-photo">
+                    {image && (
+                      <img
+                        src={shopifyImage(image, 360)}
+                        srcSet={shopifySrcSet(image, [240, 360, 480]) || undefined}
+                        sizes="(min-width: 768px) 180px, 44vw"
+                        width={360}
+                        height={360}
+                        loading="lazy"
+                        decoding="async"
+                        alt=""
+                      />
+                    )}
+                  </span>
+                  <span className="ig-shoot-when">
+                    <Shoot />
+                    <span className={eyebrow}>{arrived}</span>
+                  </span>
+                  <span className="ig-shoot-name">{piece.name}</span>
+                  <span className="ig-shoot-price">
+                    {rupees(piece.price)}
+                    {piece.compareAtPrice && piece.compareAtPrice > piece.price ? <s>{rupees(piece.compareAtPrice)}</s> : null}
+                    <span className={piece.availableForSale ? "ig-stock" : "ig-stock ig-stock--out"}>{piece.availableForSale ? "Available" : "Sold out"}</span>
+                  </span>
+                </Link>
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </section>
+  );
+};
+
+export default NewInGarden;
