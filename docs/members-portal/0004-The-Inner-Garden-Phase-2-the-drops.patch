@@ -0,0 +1,58 @@
+/*
+  How much of the petal layer has been rubbed away, without reading a pixel
+  back from the canvas (a read-back stalls the GPU on a phone). Every brush
+  stroke is stamped onto a 64 x 64 grid of the card as well; the share of
+  cells cleared is the coverage. The caller samples it every 8th move, and at
+  55% the rest of the petals fall away.
+*/
+
+export const MASK = 64;
+export const SAMPLE_EVERY = 8;
+export const REVEAL_AT = 0.55;
+/** The brush, in CSS px: a 28 px radius, a petal's width under a fingertip. */
+export const BRUSH_RADIUS = 28;
+
+export class RubMask {
+  readonly cells = new Uint8Array(MASK * MASK);
+  private cleared = 0;
+
+  constructor(
+    private readonly width: number,
+    private readonly height: number,
+  ) {}
+
+  /** Clears every cell whose centre lies within `r` of (x, y), in CSS px on the card. */
+  stamp(x: number, y: number, r: number = BRUSH_RADIUS): void {
+    if (!(this.width > 0 && this.height > 0)) return;
+    const cw = this.width / MASK;
+    const ch = this.height / MASK;
+    const x0 = Math.max(0, Math.floor((x - r) / cw));
+    const x1 = Math.min(MASK - 1, Math.floor((x + r) / cw));
+    const y0 = Math.max(0, Math.floor((y - r) / ch));
+    const y1 = Math.min(MASK - 1, Math.floor((y + r) / ch));
+    const r2 = r * r;
+    for (let gy = y0; gy <= y1; gy++) {
+      const dy = (gy + 0.5) * ch - y;
+      for (let gx = x0; gx <= x1; gx++) {
+        const dx = (gx + 0.5) * cw - x;
+        if (dx * dx + dy * dy > r2) continue;
+        const i = gy * MASK + gx;
+        if (!this.cells[i]) {
+          this.cells[i] = 1;
+          this.cleared++;
+        }
+      }
+    }
+  }
+
+  /** Stamps along a stroke from one point to the next, every half radius. */
+  line(ax: number, ay: number, bx: number, by: number, r: number = BRUSH_RADIUS): void {
+    const steps = Math.max(1, Math.ceil(Math.hypot(bx - ax, by - ay) / (r / 2)));
+    for (let s = 1; s <= steps; s++) this.stamp(ax + ((bx - ax) * s) / steps, ay + ((by - ay) * s) / steps, r);
+  }
+
+  /** The share of the card rubbed clear, 0 to 1. */
+  coverage(): number {
+    return this.cleared / (MASK * MASK);
+  }
+}
