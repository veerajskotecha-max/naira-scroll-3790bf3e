+    ["an accent that is not a colour", { accent: "green" }, /accent must be a #RRGGBB colour/],
+    ["an id with spaces", { id: "Petite Fleur" }, /id must be lower-case/],
+    ["a moved date written badly", { movedFrom: "14 Nov" }, /movedFrom must be written in IST/],
+  ])("catches %s", (_what, over, message) => {
+    expect(dropProblems({ ...good, ...over } as Drop).join("\n")).toMatch(message);
+  });
