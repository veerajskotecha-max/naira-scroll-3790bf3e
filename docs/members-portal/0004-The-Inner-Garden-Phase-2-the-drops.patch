index 0000000..fefa7a5
--- /dev/null
+++ b/src/lib/portal/ics.ts
@@ -0,0 +1,100 @@
+/*
+  "Add to my calendar". A Google Calendar template link comes first: it is an
+  ordinary link, so it works inside Instagram's in-app browser, where a file
+  download goes nowhere. The .ics file is the second way, for Apple Calendar
+  and Outlook, with a reminder 30 minutes before.
+
+  Times are written in UTC (…Z), converted from the owner's +05:30, so every
+  calendar shows the opening in its own zone without needing IST's zone data.
+  Text is escaped as RFC 5545 asks (backslash, semicolon, comma, newline) and
+  long lines are folded at 75 octets without splitting a character.
+*/
+
+export type CalendarEvent = {
+  /** Stable for the drop, so adding it twice updates one event. */
+  uid: string;
+  title: string;
+  /** ISO start time (the drop's membersFrom). */
+  start: string;
+  minutes?: number;
+  details?: string;
+  url?: string;
+};
+
+export const REMINDER_MINUTES = 30;
+const DOMAIN = "nairaflore.com";
+
+/** "20261121T143000Z" */
+export const utcStamp = (ms: number): string => new Date(ms).toISOString().replace(/\.\d{3}Z$/, "Z").replace(/[-:]/g, "");
+
+const span = (event: CalendarEvent) => {
+  const start = Date.parse(event.start);
+  return { start, end: start + (event.minutes ?? 60) * 60_000 };
+};
+
+export const escapeIcsText = (text: string): string =>
+  text.replace(/\\/g, "\\\\").replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\r?\n/g, "\\n");
+
+const octets = (ch: string) => {
+  const c = ch.codePointAt(0) ?? 0;
+  return c < 0x80 ? 1 : c < 0x800 ? 2 : c < 0x10000 ? 3 : 4;
+};
+
+/** Folds one content line at 75 octets (continuations begin with a space). */
+export const foldIcsLine = (line: string): string => {
+  const parts: string[] = [];
+  let current = "";
+  let size = 0;
+  for (const ch of line) {
+    const n = octets(ch);
+    const limit = parts.length ? 74 : 75; // a continuation's leading space counts
+    if (size + n > limit) {
+      parts.push(current);
+      current = "";
+      size = 0;
+    }
+    current += ch;
+    size += n;
+  }
+  parts.push(current);
+  return parts.join("\r\n ");
+};
+
+export const buildIcs = (event: CalendarEvent, stampMs: number = Date.now()): string => {
+  const { start, end } = span(event);
+  const lines = [
+    "BEGIN:VCALENDAR",
+    "VERSION:2.0",
+    "PRODID:-//Naira Flore//The Inner Garden//EN",
+    "CALSCALE:GREGORIAN",
+    "METHOD:PUBLISH",
+    "BEGIN:VEVENT",
+    `UID:${event.uid}@${DOMAIN}`,
+    `DTSTAMP:${utcStamp(stampMs)}`,
+    `DTSTART:${utcStamp(start)}`,
+    `DTEND:${utcStamp(end)}`,
+    `SUMMARY:${escapeIcsText(event.title)}`,
+    ...(event.details ? [`DESCRIPTION:${escapeIcsText(event.details)}`] : []),
+    ...(event.url ? [`URL:${event.url}`] : []),
+    "BEGIN:VALARM",
+    "ACTION:DISPLAY",
+    `DESCRIPTION:${escapeIcsText(event.title)}`,
+    `TRIGGER:-PT${REMINDER_MINUTES}M`,
+    "END:VALARM",
+    "END:VEVENT",
+    "END:VCALENDAR",
+  ];
+  return `${lines.map(foldIcsLine).join("\r\n")}\r\n`;
+};
+
+/** The .ics as a link a phone can open or save. */
+export const icsHref = (event: CalendarEvent, stampMs?: number): string =>
+  `data:text/calendar;charset=utf-8,${encodeURIComponent(buildIcs(event, stampMs))}`;
+
+export const googleCalendarUrl = (event: CalendarEvent): string => {
+  const { start, end } = span(event);
+  const details = [event.details, event.url].filter(Boolean).join("\n\n");
+  const q = new URLSearchParams({ action: "TEMPLATE", text: event.title, dates: `${utcStamp(start)}/${utcStamp(end)}`, ctz: "Asia/Kolkata" });
+  if (details) q.set("details", details);
+  return `https://calendar.google.com/calendar/render?${q.toString()}`;
+};
