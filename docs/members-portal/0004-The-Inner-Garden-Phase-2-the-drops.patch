@@ -60,3 +60,55 @@ export const formatIstDate = (iso: string | null | undefined): string | null =>
   const p = istParts(at);
   return `${p.day} ${MONTHS[p.month - 1]} ${p.year}`;
 };
+
+/* ── drop times ─────────────────────────────────────────
+   A drop opens at a time the owner wrote in Indian time ("2026-11-21T20:00:00+05:30").
+   Everything below reads an instant as it falls in India, whatever zone the
+   phone is set to. */
+
+const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+const MONTHS_LONG = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
+
+const parse = (at: string | number | Date): Date | null => {
+  const d = at instanceof Date ? at : new Date(at);
+  return Number.isNaN(d.getTime()) ? null : d;
+};
+
+/** "8:00 pm", "12:30 am": the clock in IST, as it is said in India. */
+export const istClock = (at: string | number | Date): string | null => {
+  const d = parse(at);
+  if (!d) return null;
+  const { hour, minute } = istParts(d);
+  const h12 = hour % 12 === 0 ? 12 : hour % 12;
+  return `${h12}:${pad(minute)} ${hour < 12 ? "am" : "pm"}`;
+};
+
+/** "Fri 21 Nov · 8:00 pm IST": when a drop opens. */
+export const formatIstOpening = (at: string | number | Date): string | null => {
+  const d = parse(at);
+  if (!d) return null;
+  const p = istParts(d);
+  const weekday = WEEKDAYS[new Date(d.getTime() + IST_OFFSET_MS).getUTCDay()];
+  return `${weekday} ${p.day} ${MONTHS[p.month - 1]} · ${istClock(d)} IST`;
+};
+
+/** "21 Nov": the IST day of an instant (pressed on, arrived on). */
+export const formatIstDay = (at: string | number | Date): string | null => {
+  const d = parse(at);
+  if (!d) return null;
+  const p = istParts(d);
+  return `${p.day} ${MONTHS[p.month - 1]}`;
+};
+
+/** "October": the IST month an instant falls in (the month a drop bloomed). */
+export const istMonthName = (at: string | number | Date): string | null => {
+  const d = parse(at);
+  return d ? MONTHS_LONG[istParts(d).month - 1] : null;
+};
+
+/** "2026-11-21T20:00:00+05:30": an instant written as the owner writes drop times. */
+export const toIstIso = (ms: number): string => {
+  const p = istParts(new Date(ms));
+  const s = new Date(ms + IST_OFFSET_MS).getUTCSeconds();
+  return `${p.year}-${pad(p.month)}-${pad(p.day)}T${pad(p.hour)}:${pad(p.minute)}:${pad(s)}+05:30`;
+};
