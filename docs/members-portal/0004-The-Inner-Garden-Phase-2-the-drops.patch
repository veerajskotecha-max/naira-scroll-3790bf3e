+import type { Drop } from "./drops";
+import { DAY, MINUTE } from "./dropPhase";
+import { istParts, toIstIso } from "./ist";
+
+/*
+  DEVELOPMENT ONLY: PREVIEW DROPS, NOT REAL RELEASES.
+
+  The real manifest (drops.ts) ships empty until the owner gives the first
+  drop. To see the drop rooms in every state on this machine, the preview
+  member (preview.ts, itself behind import.meta.env.DEV and localhost) can
+  stand in these fixtures:
+
+    /members/drops?portalPreview=1&drop=sealed     the bud on its Bloom Clock
+    &drop=moved      the date moved: the old one struck through
+    &drop=members    open for a first look (the unboxing on the first visit)
+    &drop=public     now on the shop
+    &drop=arriving   the time has passed but its pieces are not on the shop
+                     (simulated by treating them as unlisted)
+    &drop=vault      the drop has bloomed and rests in the Vault
+    &dropAt=<ISO>    open the main fixture at this time instead (sealed and
+                     moved only), to watch a petal open at its threshold
+    &unlisted=<handle>  treat one piece as not on the shop yet ("Arriving")
+
+  Every piece is a real, published Naira Petite listing read from the live
+  shop (16 handles checked against the Storefront on 5 Nov 2026), so the
+  rooms show real photos and live prices. The titles and stories say they
+  are previews. Nothing here reaches a production build: the only way in is
+  preview.ts, which a production build drops (the build check greps dist for
+  "fixture-drop" and "portalPreview").
+*/
+
+export const FIXTURE_PREFIX = "fixture-drop-";
+export const PREVIEW_DROP_STATES = ["sealed", "moved", "members", "public", "arriving", "vault"] as const;
+export type PreviewDropState = (typeof PREVIEW_DROP_STATES)[number];
+
+/** 8:00 pm IST on the day `days` from `now`, as an instant. */
+const eveningAfter = (now: number, days: number): number => {
+  const p = istParts(new Date(now + days * DAY));
+  // 20:00 IST is 14:30 UTC on the same calendar day.
+  return Date.UTC(p.year, p.month - 1, p.day, 14, 30);
+};
+
+const roundMinute = (ms: number) => Math.round(ms / MINUTE) * MINUTE;
+
+const FLEUR_HANDLES = [
+  "clover-garland-necklace",
+  "clover-garland-bracelet",
+  "petite-heart-trio-necklace",
+  "birthstone-heart-necklace",
+  "riviere-classique-necklace",
+  "orb-cable-cuff",
+];
+
+const fleur = (membersFrom: number, everyoneFrom: number, movedFrom?: number): Drop => ({
+  id: `${FIXTURE_PREFIX}fleur`,
+  title: "Petite Fleur (preview)",
+  species: "camellia",
+  accent: "#D9837B",
