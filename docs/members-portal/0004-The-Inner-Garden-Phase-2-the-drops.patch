+    expect(container.querySelector(".ig-unbox")).toBeNull();
+    expect(screen.getAllByRole("link", { name: "Arriving · ask on WhatsApp" })).toHaveLength(verdant.handles.length);
+  });
+});
+
+describe("a drop in the Vault", () => {
+  beforeEach(() => manifest.drops.push(verdant));
+
+  it("is a gentle empty frame when she did not press it", async () => {
+    vi.useFakeTimers({ now: Date.parse("2026-12-20T06:30:00Z") });
+    const { container } = await visit("/members/vault");
+    expect(screen.getByText("This one bloomed in November")).toBeInTheDocument();
