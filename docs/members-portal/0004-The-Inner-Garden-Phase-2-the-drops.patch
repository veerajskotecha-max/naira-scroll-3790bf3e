+import { readPortal, writePortal } from "./safeStorage";
+
+/*
+  Her pressed flowers, one for each drop she pressed: kept on this device for
+  now (Phase 3 moves the ids into her account's metadata, at most 24). They
+  are for joy only. They plant a flower in her garden and fill a frame in the
+  Vault; they are not points, never ranked or compared, and unlock nothing.
+*/
+
+export const MAX_PRESSED = 24;
+
+export type Pressed = { id: string; /** IST day it was pressed, "2026-11-21" (empty if unknown). */ on: string };
+
+const DAY = /^\d{4}-\d{2}-\d{2}$/;
+
+export const readPressed = (): Pressed[] => {
+  const store = readPortal();
+  const ids = Array.isArray(store.pressedLocal) ? store.pressedLocal.filter((id): id is string => typeof id === "string" && id.length > 0) : [];
+  const on = store.pressedOn && typeof store.pressedOn === "object" ? store.pressedOn : {};
+  return [...new Set(ids)].map((id) => ({ id, on: typeof on[id] === "string" && DAY.test(on[id]) ? on[id] : "" }));
+};
+
+/** Presses a drop's flower on `day` (once: pressing again keeps the first day). Oldest are let go past 24. */
+export const pressDrop = (id: string, day: string): Pressed[] => {
+  const list = readPressed();
+  if (list.some((p) => p.id === id)) return list;
+  const next = [...list, { id, on: day }].slice(-MAX_PRESSED);
+  writePortal({
+    pressedLocal: next.map((p) => p.id),
+    pressedOn: Object.fromEntries(next.filter((p) => p.on).map((p) => [p.id, p.on])),
+  });
+  return next;
+};
