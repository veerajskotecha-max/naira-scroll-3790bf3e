+import { act, cleanup, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Drop } from "@/lib/portal/drops";
+import { DAY, HOUR, MINUTE } from "@/lib/portal/dropPhase";
+import { primeServerClock, resetServerClock } from "@/lib/portal/clock";
+import BloomClock from "./BloomClock";
+
+/* The Bloom Clock: five petals that open at 7 days, 3 days, 1 day, 1 hour
+   and the opening, exactly on time, and digits that change only as a minute
+   boundary passes, with the same time in words for a screen reader. */
+
+const drop: Drop = {
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
+  accent: "#2F6B4F",
+  story: [],
+  membersFrom: "2026-11-21T20:00:00+05:30",
+  everyoneFrom: "2026-11-23T20:00:00+05:30",
+  handles: ["a"],
+  leadHandle: "a",
+};
+const opens = Date.parse(drop.membersFrom);
+
+const openPetals = (c: HTMLElement) => c.querySelectorAll(".ig-bud-petal[data-open]").length;
+const digits = (c: HTMLElement) => [...c.querySelectorAll(".ig-bc-roll")].map((d) => d.textContent).join(":");
+
+beforeEach(() => {
+  primeServerClock(0);
+});
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  resetServerClock();
+});
+
+describe("the Bloom Clock", () => {
+  it("says when it opens, in IST", () => {
+    vi.useFakeTimers({ now: opens - 2 * DAY });
+    render(<BloomClock drop={drop} />);
+    expect(screen.getByText("Opens Sat 21 Nov · 8:00 pm IST")).toBeInTheDocument();
+  });
+
+  it.each([
+    [7 * DAY, 1],
+    [3 * DAY, 2],
+    [DAY, 3],
+    [HOUR, 4],
+    [0, 5],
+  ])("opens petal %#: none early, exactly at %i ms before the opening", (threshold, k) => {
+    vi.useFakeTimers({ now: opens - threshold - 1000 });
+    const { container } = render(<BloomClock drop={drop} />);
+    expect(openPetals(container)).toBe(k - 1);
+    act(() => void vi.advanceTimersByTime(999));
+    expect(openPetals(container)).toBe(k - 1);
+    act(() => void vi.advanceTimersByTime(60));
+    expect(openPetals(container)).toBe(k);
+    // The dial's mark for it fills too.
+    const marks = [...container.querySelectorAll(".ig-bud-dial ellipse")].filter((m) => m.getAttribute("fill") !== "none");
+    expect(marks).toHaveLength(k);
+  });
+
+  it("changes its digits only as a minute boundary passes", () => {
+    // 2 days, 5 hours, 40 minutes and 30 seconds to go: shown as 41 minutes.
+    const start = opens - (2 * DAY + 5 * HOUR + 40 * MINUTE + 30_000);
+    vi.useFakeTimers({ now: start });
+    const { container } = render(<BloomClock drop={drop} />);
+    expect(digits(container)).toBe("02:05:41");
+    act(() => void vi.advanceTimersByTime(29_000));
+    expect(digits(container)).toBe("02:05:41");
+    act(() => void vi.advanceTimersByTime(1_100));
+    expect(digits(container)).toBe("02:05:40");
+    act(() => void vi.advanceTimersByTime(59_000));
+    expect(digits(container)).toBe("02:05:40");
+    act(() => void vi.advanceTimersByTime(1_000));
+    expect(digits(container)).toBe("02:05:39");
+  });
+
+  it("tells a screen reader the same time, politely", () => {
+    vi.useFakeTimers({ now: opens - (2 * DAY + 5 * HOUR) });
+    const { container } = render(<BloomClock drop={drop} />);
+    const live = container.querySelector("[aria-live]")!;
+    expect(live.getAttribute("aria-live")).toBe("polite");
+    expect(live).toHaveTextContent("Opens in 2 days and 5 hours.");
+    expect(container.querySelector(".ig-bc-digits")!.getAttribute("aria-hidden")).toBe("true");
+  });
+
+  it("never counts below zero", () => {
+    vi.useFakeTimers({ now: opens + HOUR });
+    const { container } = render(<BloomClock drop={drop} />);
+    expect(digits(container)).toBe("00:00:00");
+    expect(openPetals(container)).toBe(5);
+  });
+
+  it("shows a moved date struck through beside the new one", () => {
+    vi.useFakeTimers({ now: opens - 2 * DAY });
+    const { container } = render(<BloomClock drop={{ ...drop, movedFrom: "2026-11-14T20:00:00+05:30" }} />);
+    expect(container.querySelector("s")).toHaveTextContent("Sat 14 Nov · 8:00 pm IST");
+    expect(screen.getByText("Moved to Sat 21 Nov · 8:00 pm IST")).toBeInTheDocument();
+  });
+
+  /* Two timers only: the minute tick, set for the next boundary, and the
+     sway's 20 s rest. No animation-frame loop counts the seconds. */
+  it("runs no clock loop between minutes", () => {
+    vi.useFakeTimers({ now: opens - 2 * DAY - 30_000 });
+    const raf = vi.spyOn(window, "requestAnimationFrame");
+    render(<BloomClock drop={drop} />);
+    expect(vi.getTimerCount()).toBe(2);
+    act(() => void vi.advanceTimersByTime(10_000));
+    expect(vi.getTimerCount()).toBe(2);
+    expect(raf).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/components/portal/BloomClock.tsx b/src/components/portal/BloomClock.tsx
new file mode 100644
