diff --git a/src/components/portal/DropBox.tsx b/src/components/portal/DropBox.tsx
new file mode 100644
index 0000000..7a70dc3
--- /dev/null
+++ b/src/components/portal/DropBox.tsx
@@ -0,0 +1,165 @@
+import type { CSSProperties, Ref } from "react";
+import printSm from "@/assets/naira-box-print-sm.webp";
+import { COLOURS, PEEK_POSE, SLOT, boxGeometry, drawerTransforms, poseTransform, type BoxPose } from "@/lib/portal/boxPose";
+
+/*
+  The Naira gift box in CSS 3D, for the drop's unboxing: the portal's own
+  copy of the bag's box (components/giftbox/NairaBoxCSS). Importing that one
+  would share lib/nairaBox/config with the footer's three.js box and split
+  it into a new chunk every shop page then fetches, so its proportions and
+  colours are repeated here. Faces are divs; the compositor does the
+  perspective and the motion (transform and opacity only, no blur).
+
+  One convex box, every face turned out: the open drawer is the same box
+  made longer, its pulled-out part drawn through fixed windows (the velvet
+  tray on top, the two sides) whose contents slide back under the sleeve as
+  it closes. The piece stands in the cushion's slot, turned to face her, and
+  rises out of a window whose foot is the slot.
+*/
+
+export type BoxParts = {
+  lift?: Ref<HTMLDivElement>;
+  box?: Ref<HTMLDivElement>;
+  gleam?: Ref<HTMLDivElement>;
+  riser?: Ref<HTMLDivElement>;
+  glint?: Ref<HTMLDivElement>;
+  front?: Ref<HTMLDivElement>;
+  tray?: Ref<HTMLDivElement>;
+  left?: Ref<HTMLDivElement>;
+  right?: Ref<HTMLDivElement>;
+};
+
+type Props = {
+  size: number;
+  pose: BoxPose;
+  /** 0 shut, 1 open. */
+  open: number;
+  /** The piece is up out of its slot. */
+  raised: boolean;
+  /** A transparent cut-out (stands as it is), or a shop photo (shown as a small card). */
+  piece?: { src: string; cutout: boolean };
+  parts?: BoxParts;
+};
+
+const face = (w: number, h: number, W: number, H: number, transform: string, style: CSSProperties = {}): CSSProperties => ({
+  position: "absolute",
+  boxSizing: "border-box",
+  width: w,
+  height: h,
+  left: (W - w) / 2,
+  top: (H - h) / 2,
+  transform,
+  backfaceVisibility: "hidden",
+  WebkitBackfaceVisibility: "hidden",
+  ...style,
+});
+
+const fill: CSSProperties = { position: "absolute", inset: 0 };
+
+const GLINT =
+  "radial-gradient(circle, rgb(255 255 255) 0 7%, rgb(255 255 255 / 0) 32%), " +
+  "linear-gradient(90deg, transparent 47%, rgb(255 255 255 / 0.95) 50%, transparent 53%), " +
+  "linear-gradient(0deg, transparent 47%, rgb(255 255 255 / 0.95) 50%, transparent 53%)";
+const GLINT_FADE = "radial-gradient(circle, #000 0 22%, transparent 68%)";
+
+const DropBox = ({ size, pose, open, raised, piece, parts = {} }: Props) => {
+  const { W, D, H, travel: E } = boxGeometry(size);
+  const rim = `${Math.max(1, size * 0.012)}px solid ${COLOURS.rim}`;
+  const wall = Math.max(1.5, size * 0.03);
+  const drawer = drawerTransforms(size, open);
+  const pulledOut = `translateZ(${D / 2 + E / 2}px)`;
+  // A cut-out stands as the bag's ring does; a shop photo is a small card in the slot.
+  const pieceW = W * (piece?.cutout ? 0.48 : 0.36);
+  const pieceH = piece?.cutout ? pieceW * (172 / 132) : pieceW * 1.2;
+
+  return (
+    <div className="ig-box" style={{ width: W, height: H + size * 0.36, perspective: size * 5.1, perspectiveOrigin: "50% 28%" }} aria-hidden>
+      <div className="ig-box-shadow" style={{ top: H + size * 0.2, left: -W * 0.125, width: W * 1.25, height: size * 0.2 }} />
+      <div ref={parts.lift} className="ig-box-3d" style={fill}>
+        <div ref={parts.box} className="ig-box-3d" style={{ position: "absolute", left: 0, top: size * 0.12, width: W, height: H, transform: poseTransform(pose) }}>
+          {/* Sleeve: lid, base, sides, back; open at the front. */}
+          <div style={face(W, D, W, H, `rotateX(90deg) translateZ(${H / 2}px)`, { background: "linear-gradient(140deg, #F2DED8 0%, #E6CCC5 55%, #DDBFB8 100%)", overflow: "hidden", border: rim })}>
+            <img src={printSm} alt="" draggable={false} style={{ position: "absolute", left: "19%", width: "62%", top: "34%", opacity: 0.86 }} />
+            <div
+              ref={parts.gleam}
+              style={{ position: "absolute", inset: "-20% 0", width: "45%", background: "linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 250 244 / 0.62), rgb(255 255 255 / 0))", transform: "translateX(-160%) skewX(-18deg)" }}
+            />
+          </div>
+          <div style={face(W, D, W, H, `rotateX(-90deg) translateZ(${H / 2}px)`, { background: COLOURS.cardDeep })} />
+          <div style={face(D, H, W, H, `rotateY(90deg) translateZ(${W / 2}px)`, { background: "linear-gradient(180deg, #C8A69F, #B9968F)", borderTop: rim, borderLeft: rim })} />
+          <div style={face(D, H, W, H, `rotateY(-90deg) translateZ(${W / 2}px)`, { background: "linear-gradient(180deg, #D8B8B1, #CBA9A2)", borderTop: rim, borderRight: rim })} />
+          <div style={face(W, H, W, H, `rotateY(180deg) translateZ(${D / 2}px)`, { background: COLOURS.cardDeep })} />
+
+          {/* The pulled-out part of the drawer, through its three windows. */}
+          <div style={face(W, E, W, H, `${pulledOut} rotateX(90deg) translateZ(${H / 2}px)`, { overflow: "hidden" })}>
+            <div ref={parts.tray} style={{ ...fill, transform: drawer.tray, background: COLOURS.rim }}>
+              <div style={{ position: "absolute", left: wall, right: wall, top: 0, bottom: wall, background: `radial-gradient(ellipse at 50% 58%, #2E2527 0%, ${COLOURS.velvet} 70%)` }}>
+                <div style={{ ...fill, background: "linear-gradient(180deg, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0) 32%)" }} />
+                <div style={{ position: "absolute", left: 0, right: 0, top: `${(SLOT - 0.18) * 100}%`, height: "36%", background: "linear-gradient(180deg, #4A3C3F 0%, #2B2224 45%, #1A1415 100%)" }}>
+                  <div style={{ position: "absolute", left: "18%", right: "18%", top: "48%", height: Math.max(1, size * 0.02), background: "rgb(0 0 0 / 0.75)" }} />
+                </div>
+              </div>
+            </div>
+          </div>
+          <div style={face(E, H, W, H, `${pulledOut} rotateY(90deg) translateZ(${W / 2}px)`, { overflow: "hidden" })}>
+            <div ref={parts.right} style={{ ...fill, transform: drawer.right, background: "linear-gradient(180deg, #C2A09A, #B3918A)", borderTop: rim }} />
+          </div>
+          <div style={face(E, H, W, H, `${pulledOut} rotateY(-90deg) translateZ(${W / 2}px)`, { overflow: "hidden" })}>
+            <div ref={parts.left} style={{ ...fill, transform: drawer.left, background: "linear-gradient(180deg, #D2B1AA, #C5A39C)", borderTop: rim }} />
+          </div>
+
+          {/* The piece, in the cushion's slot, turned to face her. */}
+          {piece && (
+            <div
+              style={{
+                position: "absolute",
+                left: (W - pieceW) / 2,
+                top: H / 2 - pieceH,
+                width: pieceW,
+                height: pieceH,
+                overflow: "hidden",
+                transformOrigin: "50% 100%",
+                transform: `translate3d(0, ${-H / 2}px, ${D / 2 + E * SLOT}px) rotateY(${-PEEK_POSE.turn}deg) rotateX(${-PEEK_POSE.tilt}deg)`,
+                backfaceVisibility: "hidden",
+                WebkitBackfaceVisibility: "hidden",
+              }}
+            >
+              <div ref={parts.riser} style={{ ...fill, transform: raised ? "translateY(0%)" : "translateY(100%)" }}>
+                {piece.cutout ? (
+                  <img src={piece.src} alt="" draggable={false} style={{ display: "block", width: "100%", height: "100%" }} />
+                ) : (
+                  <span className="ig-box-card">
+                    <img src={piece.src} alt="" draggable={false} />
+                  </span>
+                )}
+                <div
+                  ref={parts.glint}
+                  style={{
+                    position: "absolute",
+                    left: "50%",
+                    top: "16%",
+                    width: pieceW * 0.7,
+                    height: pieceW * 0.7,
+                    marginLeft: -pieceW * 0.35,
+                    marginTop: -pieceW * 0.35,
+                    background: GLINT,
+                    maskImage: GLINT_FADE,
+                    WebkitMaskImage: GLINT_FADE,
+                    opacity: 0,
+                  }}
+                />
+              </div>
+            </div>
+          )}
+
+          {/* The drawer's front panel, with its pull tab. */}
+          <div ref={parts.front} style={face(W, H, W, H, drawer.front, { background: "linear-gradient(180deg, #D1AEA7 0%, #C6A39C 100%)", border: rim })}>
+            <span style={{ position: "absolute", left: "43%", width: "14%", bottom: "8%", height: Math.max(1.5, size * 0.035), background: "#EEDDD7" }} />
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default DropBox;
