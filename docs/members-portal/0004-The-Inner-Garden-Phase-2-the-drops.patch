+  everyoneFrom: toIstIso(everyoneFrom),
+  handles: FLEUR_HANDLES,
+  leadHandle: "clover-garland-necklace",
+  // The listing's own macro photo of the clovers, from the live shop.
+  teaser: { imageUrl: "https://cdn.shopify.com/s/files/1/0680/9606/5698/files/76f93c90-06e6-4260-aa22-fc9c14b84bfa.jpg?v=1793699214", public: false },
+  reservable: ["clover-garland-necklace", "petite-heart-trio-necklace"],
+  ...(movedFrom ? { movedFrom: toIstIso(movedFrom) } : {}),
+});
+
+/* Two earlier previews, so the Vault has a wall: one with a sold-out piece. */
+const carre = (now: number): Drop => ({
+  id: `${FIXTURE_PREFIX}carre`,
+  title: "Carré (preview)",
+  species: "marigold",
+  accent: "#C9963E",
+  story: ["A preview drop, made for development: not a real release.", "Square-cut colour for the wrist."],
+  membersFrom: toIstIso(eveningAfter(now, -40)),
+  everyoneFrom: toIstIso(eveningAfter(now, -38)),
+  handles: ["amethyst-carre-bracelet", "champagne-carre-bracelet", "sapphire-carre-bracelet", "blush-carre-bracelet", "watch-link-strap-bracelet"],
+  leadHandle: "sapphire-carre-bracelet",
+});
+
+const prism = (now: number): Drop => ({
+  id: `${FIXTURE_PREFIX}prism`,
+  title: "Prism (preview)",
+  species: "teal bud",
+  accent: "#4F8A90",
+  story: ["A preview drop, made for development: not a real release.", "Pear drops that catch the light."],
+  membersFrom: toIstIso(eveningAfter(now, -66)),
+  everyoneFrom: toIstIso(eveningAfter(now, -64)),
+  handles: ["prism-pear-drop-hoops", "prism-pear-drop-necklace", "lotus-pear-drop-studs", "solitaire-drop-huggies"],
+  leadHandle: "prism-pear-drop-necklace",
+});
+
+export type PreviewDrops = { drops: Drop[]; unlisted: string[] };
+
+export const readPreviewDrops = (search: string, now: number = Date.now()): PreviewDrops | null => {
+  const q = new URLSearchParams(search);
+  const state = q.get("drop") as PreviewDropState | null;
+  if (!state || !(PREVIEW_DROP_STATES as readonly string[]).includes(state)) return null;
+  const at = Date.parse(q.get("dropAt") ?? "");
+  const sealedAt = Number.isNaN(at) ? eveningAfter(now, 2) : roundMinute(at);
+  let main: Drop;
+  switch (state) {
+    case "sealed":
+      main = fleur(sealedAt, sealedAt + 2 * DAY);
+      break;
+    case "moved":
+      main = fleur(Number.isNaN(at) ? eveningAfter(now, 9) : sealedAt, (Number.isNaN(at) ? eveningAfter(now, 9) : sealedAt) + 2 * DAY, Number.isNaN(at) ? eveningAfter(now, 2) : sealedAt - 7 * DAY);
+      break;
+    case "members":
+    case "arriving": {
+      const opened = roundMinute(now - 20 * MINUTE);
+      main = fleur(opened, opened + 2 * DAY);
+      break;
+    }
+    case "public":
+      main = fleur(eveningAfter(now, -3), eveningAfter(now, -1));
+      break;
+    case "vault":
+    default:
+      main = fleur(eveningAfter(now, -18), eveningAfter(now, -16));
+  }
+  const masked = state === "arriving" ? [...FLEUR_HANDLES] : [];
+  const one = q.get("unlisted");
+  if (one && !masked.includes(one)) masked.push(one);
+  return { drops: [prism(now), carre(now), main], unlisted: masked };
+};
