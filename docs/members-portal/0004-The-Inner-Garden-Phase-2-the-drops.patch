+import { BUD_CLOSED, BUD_OPEN, SPECIES, PAPER, mixHex, petalTransform } from "@/lib/portal/species";
+import { LEAF_SAGE } from "@/lib/portal/brandFlower";
+
+/*
+  A drop's flower, drawn from the garden's six species in three states:
+  - line:    a gold hairline drawing (every stroke has pathLength=1, so it
+             can draw itself in with stroke-dashoffset);
+  - bloom:   flat colour in the drop's accent, as it grows in her garden;
+  - pressed: the same flower laid flat and a little faded, for its frame.
+
+  And its bud for the Bloom Clock: five petals around one base, folded shut
+  until the clock opens them one by one (at 7 days, 3 days, 1 day, 1 hour
+  and the opening). Each petal turns about the base on the compositor, and
+  its colour comes in by opacity, never by repainting a fill.
+
+  No stylesheet of its own: the garden, the clock and the frames all use it.
+*/
+
+type GlyphState = "line" | "bloom" | "pressed";
+
+type GlyphProps = {
+  species: number;
+  accent: string;
+  state: GlyphState;
+  /** Rendered height in px. */
+  size: number;
+  className?: string;
+  /** Spoken name; decorative when absent. */
+  label?: string;
+};
+
+const GOLD = "var(--nf-accent)";
+const GOLD_DEEP = "var(--nf-accent-strong)";
+
+const STEM = "M0 12C-3-22 4-58 0-90";
+const LEAF_L = "M-1-28C-14-30-25-40-27-55C-13-51-4-43-1-28Z";
+const LEAF_R = "M1-52C14-54 24-63 26-77C13-74 4-66 1-52Z";
+
+export const FlowerGlyph = ({ species, accent, state, size, className = "", label }: GlyphProps) => {
+  const s = SPECIES[species] ?? SPECIES[1];
+  const pressed = state === "pressed";
+  const line = state === "line";
+  const petal = pressed ? mixHex(accent, PAPER, 0.28) : accent;
+  const inner = mixHex(accent, PAPER, pressed ? 0.62 : 0.5);
+  const leaf = pressed ? mixHex(LEAF_SAGE, PAPER, 0.22) : LEAF_SAGE;
+  const stroke = line || pressed ? GOLD_DEEP : "none";
+  const fill = (c: string) => (line ? "none" : c);
+  const hair = { stroke, strokeWidth: line ? 1.1 : 0.7, vectorEffect: "non-scaling-stroke" as const, pathLength: 1 };
+  return (
+    <svg
+      viewBox="-60 -150 120 166"
+      width={Math.round((size * 120) / 166)}
+      height={size}
+      className={`ig-glyph ${className}`}
+      role={label ? "img" : undefined}
+      aria-label={label}
+      aria-hidden={label ? undefined : true}
+    >
+      <g transform={pressed ? "rotate(-9 0 -40)" : undefined}>
+        <path d={STEM} fill="none" stroke={line ? GOLD_DEEP : leaf} strokeWidth={line ? 1.1 : 2} vectorEffect={line ? "non-scaling-stroke" : undefined} strokeLinecap="round" pathLength={1} />
+        <path d={LEAF_L} fill={fill(leaf)} {...hair} />
+        <path d={LEAF_R} fill={fill(leaf)} {...hair} />
+        <g transform="translate(0 -104)">
+          {Array.from({ length: s.petals }, (_, i) => (
+            <path key={i} d={s.d} transform={petalTransform((i * 360) / s.petals, 42)} fill={fill(petal)} {...hair} />
+          ))}
+          {s.inner > 0 &&
+            Array.from({ length: s.petals }, (_, i) => (
+              <path key={`i${i}`} d={s.d} transform={petalTransform(180 / s.petals + (i * 360) / s.petals, 42 * s.inner)} fill={fill(inner)} {...hair} />
+            ))}
+          <circle r="7" fill={line ? "none" : s.core} stroke={line ? GOLD_DEEP : "none"} strokeWidth={line ? 1.1 : 0} vectorEffect="non-scaling-stroke" pathLength={1} />
+          {!line && <circle r="2.6" cx="-1.8" cy="-1.8" fill="#FFF8EE" />}
+        </g>
+      </g>
+    </svg>
+  );
+};
+
+/* ── the bud ───────────────────────────────────────────── */
+
+
+/* CSS transforms on SVG groups turn about the drawing's own origin, which is the petals' base. */
+const PIVOT = { transformBox: "view-box", transformOrigin: "0 0" } as const;
+
+type BudProps = {
+  species: number;
+  accent: string;
+  /** Petals open, 0 to 5. */
+  open: number;
+  /** Rendered width in px. */
+  size: number;
+  className?: string;
+  /** Draws the stem and its leaf below the bud. */
+  stem?: boolean;
+  /** The clock's face: a dotted gold ring with a mark where each petal will lie, filled as it opens. */
+  dial?: boolean;
+};
+
+/* Where each petal comes to rest, in degrees from upright: the dial's marks. */
+const OPEN_DEG = [-72, 72, -144, 144, 0];
+
+export const BudGlyph = ({ species, accent, open, size, className = "", stem = true, dial = false }: BudProps) => {
+  const s = SPECIES[species] ?? SPECIES[1];
+  const pale = mixHex(accent, PAPER, 0.5);
+  const edge = dial ? 76 : 64;
+  const width = edge * 2;
+  const height = edge + (stem ? 96 : 60);
+  return (
+    <svg viewBox={`${-edge} ${-edge} ${width} ${height}`} width={size} height={Math.round((size * height) / width)} className={`ig-bud ${className}`} aria-hidden>
+      {dial && (
+        <g className="ig-bud-dial">
+          <circle r="64" fill="none" stroke={GOLD} strokeWidth="1" strokeDasharray="0.5 4" strokeLinecap="round" vectorEffect="non-scaling-stroke" />
+          {OPEN_DEG.map((deg, k) => {
+            const a = (deg * Math.PI) / 180;
+            const x = (Math.sin(a) * 70).toFixed(2);
+            const y = (-Math.cos(a) * 70).toFixed(2);
+            return (
+              <ellipse key={deg} cx={x} cy={y} rx="2.6" ry="4.4" transform={`rotate(${deg} ${x} ${y})`} fill={k < open ? accent : "none"} stroke={GOLD_DEEP} strokeWidth=".8" vectorEffect="non-scaling-stroke" />
+            );
+          })}
+        </g>
+      )}
+      {stem && (
+        <g className="ig-bud-stem">
+          <path d="M0 6C-3 34 3 62 0 94" fill="none" stroke={LEAF_SAGE} strokeWidth="2.4" strokeLinecap="round" />
+          <path d="M-1 58C-15 56-26 46-29 32C-14 35-5 44-1 58Z" fill={LEAF_SAGE} />
+        </g>
+      )}
+      {BUD_OPEN.map((to, k) => {
+        const isOpen = k < open;
+        return (
+          <g key={k} className="ig-bud-petal" data-k={k} data-open={isOpen ? "" : undefined} style={{ ...PIVOT, transform: isOpen ? to : BUD_CLOSED[k] }}>
+            <path d={s.d} transform={petalTransform(0, 56)} fill={pale} stroke={GOLD} strokeWidth=".8" vectorEffect="non-scaling-stroke" />
+            {isOpen && <path className="ig-bud-colour" d={s.d} transform={petalTransform(0, 56)} fill={accent} />}
+            <path d={s.d} transform={petalTransform(0, 56)} fill="none" stroke={GOLD_DEEP} strokeOpacity=".7" strokeWidth=".8" vectorEffect="non-scaling-stroke" />
+            <path d="M0-9C-1-20 1-30 0-40" fill="none" stroke={GOLD_DEEP} strokeOpacity=".32" strokeWidth=".7" vectorEffect="non-scaling-stroke" />
+          </g>
+        );
+      })}
+      <g className="ig-bud-sepals">
+        <path d="M0 8C-9 6-19-3-22-17C-12-13-4-6 0 8Z" fill={LEAF_SAGE} />
+        <path d="M0 8C9 6 19-3 22-17C12-13 4-6 0 8Z" fill={LEAF_SAGE} />
+      </g>
+      {open >= 5 && (
+        <g className="ig-bud-core" style={PIVOT}>
+          <circle r="9" fill={s.core} stroke={GOLD_DEEP} strokeWidth=".8" vectorEffect="non-scaling-stroke" />
+          <circle r="3" cx="-2.4" cy="-2.4" fill="#FFF8EE" />
+        </g>
+      )}
+    </svg>
+  );
+};
