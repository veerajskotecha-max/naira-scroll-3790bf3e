+    // Every ₹ on the page is one of the live catalogue's prices.
+    const live = new Set(shop.jewellery.flatMap((p) => { const j = p as JewelPiece; return [j.price, j.compareAtPrice, ...(j.variants ?? []).flatMap((v) => [v.price, v.compareAtPrice])]; }).filter(Boolean).map((n) => `₹${(n as number).toLocaleString("en-IN")}`));
+    for (const shown of container.textContent!.match(/₹[\d,]+/g) ?? []) expect(live.has(shown)).toBe(true);
