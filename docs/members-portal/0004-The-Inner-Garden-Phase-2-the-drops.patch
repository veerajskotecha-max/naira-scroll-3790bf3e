+import { useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import { Link, Navigate, useParams } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import BloomClock from "@/components/portal/BloomClock";
+import CalendarButton from "@/components/portal/CalendarButton";
+import PetalReveal from "@/components/portal/PetalReveal";
+import DropUnbox from "@/components/portal/DropUnbox";
+import DropPieceCard from "@/components/portal/DropPieceCard";
+import { nameFromHandle, whatsAppAbout } from "@/lib/portal/dropWords";
+import PressFlower from "@/components/portal/PressFlower";
+import HerbariumFrame from "@/components/portal/HerbariumFrame";
+import { FlowerGlyph } from "@/components/portal/FlowerGlyph";
+import { useMember } from "@/components/portal/MemberContext";
+import { useDropShop } from "@/components/portal/useDropShop";
+import { eyebrow, quietButton, textLink } from "@/components/portal/styles";
+import { dropNumber, dropPhase, phaseBoundaries, speciesIndex, type DropPhase } from "@/lib/portal/dropPhase";
+import { formatIstDay, formatIstOpening, istMonthName } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { hasDropFlag, setDropFlag } from "@/lib/portal/safeStorage";
+import { monthOfBirthday } from "@/lib/portal/stones";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { shopifyImage } from "@/lib/shopifyImage";
+import "./droproom.css";
+
+/*
+  /members/drops/:dropId: one drop's room, which changes with its phase.
+  - sealed (or moved): its story, Rub the petals for a first look, the Bloom
+    Clock and the calendar, and WhatsApp for the pieces the owner lets be
+    reserved.
+  - members: the unboxing on her first visit here, then the pieces (live
+    price, Available / Sold out, Add to bag and Buy now, her month already
+    chosen), then Press your flower.
+  - public: the same, labelled "Now on the shop", with the box shown open.
+  - arriving: the time has passed but the pieces are not on the shop yet:
+    "Opening shortly · ask on WhatsApp", never a clock below zero.
+  - vault: the archive: her pressed flower (or a gentle empty frame), the
+    story and the pieces with live availability, by kind.
+*/
+
+const EYEBROW: Record<DropPhase, string> = {
+  sealed: "a first look soon",
+  moved: "the date has moved",
+  members: "open · a first look",
+  public: "now on the shop",
+  arriving: "opening shortly",
+  vault: "from the Vault",
+};
+
+const KINDS = ["Necklaces", "Earrings", "Bracelets", "Rings"] as const;
+
+const DropRoom = () => {
+  const { dropId = "" } = useParams();
+  const { drops, profile, pressed, press, addToBag, buyNow, preview } = useMember();
+  const drop = drops.find((d) => d.id === dropId);
+  const marks = useMemo(() => (drop ? phaseBoundaries([drop]) : []), [drop]);
+  const now = useServerNow(marks, Boolean(drop));
+  const shop = useDropShop(Boolean(drop));
+  const phase = drop ? dropPhase(drop, now, shop.live) : null;
+  const month = monthOfBirthday(profile?.birthday);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const gridRef = useRef<HTMLDivElement>(null);
+  const [kind, setKind] = useState<string>("All");
+  /* Decided once, the first time the room shows the drop open to members (as
+     she arrives, or as the clock opens it in front of her): the unboxing is
+     for her first time here, with motion. */
+  const ritualRef = useRef<boolean | null>(null);
+  if (ritualRef.current === null && phase === "members") ritualRef.current = !hasDropFlag("unboxed", dropId) && !stillMotion();
+  const ritual = ritualRef.current === true;
+  const [unfolded, setUnfolded] = useState(false);
+  const unfoldedOnce = useRef(false);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, [dropId]);
+
+  useEffect(() => {
+    if (ritual) setDropFlag("unboxed", dropId);
+  }, [ritual, dropId]);
+
+  // After the unboxing, the pieces unfold one after another.
+  useLayoutEffect(() => {
+    if (!unfolded || unfoldedOnce.current) return;
+    unfoldedOnce.current = true;
+    if (!ritual) return;
+    gridRef.current?.querySelectorAll(".ig-piece").forEach((card, i) =>
+      play(card, [{ opacity: 0, transform: "translateY(14px)" }, { opacity: 1, transform: "none" }], { duration: 460, delay: i * 60, easing: EASE_REVEAL, fill: "backwards" }),
+    );
+  }, [unfolded, ritual]);
+
+  if (!drop || !phase) return <Navigate to="/members/drops" replace />;
+
+  const number = dropNumber(drop, drops);
+  const species = speciesIndex(drop.species);
+  const lead = shop.pieceOf(drop.leadHandle);
+  const mine = pressed.find((p) => p.id === drop.id);
+  const open = phase === "members" || phase === "public" || phase === "arriving";
+  const kinds = KINDS.filter((k) => drop.handles.some((h) => shop.pieceOf(h)?.category === k));
+  const shown = phase === "vault" && kind !== "All" ? drop.handles.filter((h) => shop.pieceOf(h)?.category === kind) : drop.handles;
+  const unboxPiece = drop.cutoutUrl
+    ? { src: drop.cutoutUrl, cutout: true }
+    : lead
+      ? { src: shopifyImage(lead.cover ?? lead.image, 360), cutout: false }
+      : undefined;
+
+  const grid = (
+    <div ref={gridRef} className="ig-pieces">
+      {shown.map((handle) => (
+        <DropPieceCard
+          key={handle}
+          handle={handle}
+          piece={shop.pieceOf(handle)}
+          status={shop.status}
+          month={month}
+          dropTitle={drop.title}
+          bud={{ species, accent: drop.accent }}
+          preview={preview}
+          onAdd={addToBag}
+          onBuy={buyNow}
+        />
+      ))}
+    </div>
+  );
+
+  return (
+    <PortalShell title={drop.title} description={`${drop.title}, a drop in the Inner Garden, Naira Flore's members' portal.`}>
+      <div className="ig-room" style={{ ["--ig-accent" as string]: drop.accent }}>
+        <Link to="/members/drops" className={`${quietButton} ig-room-back`}>
+          ← All drops
+        </Link>
+        <div className="ig-head">
+          <p className={eyebrow}>
+            Drop {number} · {EYEBROW[phase]}
+          </p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            <em>{drop.title}</em>
+          </h1>
+          {drop.story.map((line) => (
+            <p key={line} className="ig-room-story">
+              {line}
+            </p>
+          ))}
+        </div>
+
+        {(phase === "sealed" || phase === "moved") && (
+          <>
+            {drop.teaser?.imageUrl && (
+              <section className="ig-section" aria-labelledby="ig-teaser">
+                <h2 id="ig-teaser" className="ig-h2">
+                  A first look
+                </h2>
+                <PetalReveal drop={drop} imageUrl={drop.teaser.imageUrl} alt={lead ? `A first look: ${lead.name}` : `A first look at ${drop.title}`} />
+              </section>
+            )}
+            <section className="ig-section ig-room-clock" aria-label="When it opens">
+              <BloomClock drop={drop} />
+              <CalendarButton drop={drop} />
+            </section>
+            {Boolean(drop.reservable?.length) && (
+              <section className="ig-section" aria-labelledby="ig-reserve">
+                <h2 id="ig-reserve" className="ig-h2">
+                  Reserve on WhatsApp
+                </h2>
+                <p className="ig-fineprint">Ask before it opens and a person replies to confirm. Nothing is taken from you for a piece that is not out yet.</p>
+                <ul className="ig-reserve">
+                  {(drop.reservable ?? []).map((h) => {
+                    const name = shop.pieceOf(h)?.name ?? nameFromHandle(h);
+                    return (
+                      <li key={h}>
+                        <span>{name}</span>
+                        <a className={textLink} href={whatsAppAbout(name, drop.title, h, "reserve")} target="_blank" rel="noopener noreferrer">
+                          Reserve on WhatsApp
+                        </a>
+                      </li>
+                    );
+                  })}
+                </ul>
+              </section>
+            )}
+          </>
+        )}
+
+        {open && (
+          <>
+            {phase === "arriving" ? (
+              <section className="ig-section ig-arriving" aria-labelledby="ig-arriving">
+                <FlowerGlyph species={species} accent={drop.accent} state="bloom" size={150} />
+                <h2 id="ig-arriving" className="ig-h2">
+                  Opening shortly
+                </h2>
+                <p className="ig-fineprint">
+                  Its time came {formatIstOpening(drop.membersFrom)}, and its pieces are on their way to the shop. Ask us on WhatsApp in the meantime.
+                </p>
+              </section>
+            ) : shop.status === "loading" && !drop.cutoutUrl ? (
+              <p className="ig-lede ig-wait" role="status">
+                Opening the box…
+              </p>
+            ) : (
+              <DropUnbox drop={drop} piece={unboxPiece} ritual={ritual} onUnfold={() => setUnfolded(true)} />
+            )}
+            <section className="ig-section" aria-labelledby="ig-pieces">
+              <h2 id="ig-pieces" className="ig-h2">
+                {phase === "public" ? "Now on the shop" : phase === "arriving" ? "The pieces" : "The pieces · a first look"}
+              </h2>
+              {(unfolded || phase === "arriving" || !ritual) && grid}
+            </section>
+            {phase !== "arriving" && <PressFlower drop={drop} number={number} pressedOn={mine ? mine.on : null} onPress={() => press(drop.id)} />}
+          </>
+        )}
+
+        {phase === "vault" && (
+          <>
+            <section className="ig-section ig-room-kept" aria-label="Your pressed flower">
+              <HerbariumFrame
+                species={species}
+                accent={drop.accent}
+                pressed={Boolean(mine)}
+                title={`Drop ${number} · ${drop.title}`}
+                note={mine ? (mine.on ? `pressed ${formatIstDay(`${mine.on}T12:00:00+05:30`)}` : "pressed") : `This one bloomed in ${istMonthName(drop.membersFrom)}`}
+                size={190}
+              />
+            </section>
+            <section className="ig-section" aria-labelledby="ig-pieces">
+              <h2 id="ig-pieces" className="ig-h2">
+                Its pieces, as the shop has them now
+              </h2>
+              {kinds.length > 1 && (
+                <div className="ig-kinds" role="group" aria-label="Show">
+                  {["All", ...kinds].map((k) => (
+                    <button key={k} type="button" className="ig-kind" aria-pressed={kind === k} onClick={() => setKind(k)}>
+                      {k}
+                    </button>
+                  ))}
+                </div>
+              )}
+              {grid}
+            </section>
+          </>
+        )}
+      </div>
+    </PortalShell>
+  );
+};
+
+export default DropRoom;
