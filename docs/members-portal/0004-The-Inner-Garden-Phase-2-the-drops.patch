+});
+
+/* Nothing in the portal sits above the z-40 tier: the bag drawer (z-50) opens over all of it. */
+describe("layers", () => {
+  it("keeps every portal z-index at 40 or below", () => {
+    const src = resolve(__dirname, "../..");
+    const css = (dir: string): string[] =>
+      readdirSync(dir, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? css(join(dir, e.name)) : /\.(css|tsx)$/.test(e.name) && !/\.test\./.test(e.name) ? [join(dir, e.name)] : []));
+    const values = ["pages/members", "components/portal"].flatMap((d) => css(join(src, d))).flatMap((f) => [...readFileSync(f, "utf8").matchAll(/z-index:\s*(\d+)|zIndex:\s*(\d+)/g)].map((m) => Number(m[1] ?? m[2])));
