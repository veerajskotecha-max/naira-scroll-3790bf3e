+    expect(arriving.getAttribute("href")).toMatch(/^https:\/\/wa\.me\//);
+    expect(arriving.closest("article")!.textContent).toContain("Verdant Pear Drop Huggies");
+  });
+
+  it("presses her flower into a labelled frame and plants it in her garden", async () => {
+    vi.useFakeTimers({ now: opens + 20 * 60_000 });
+    Element.prototype.animate = animate as never;
+    window.localStorage.setItem("naira-portal", JSON.stringify({ doorsDay: "x", seedSeen: true, unboxed: { verdant: true } }));
+    const { container } = await visit("/members/drops/verdant");
+    fireEvent.click(screen.getByRole("button", { name: "Press your flower" }));
