@@ -0,0 +1,41 @@
+import { useMemo } from "react";
+import type { JewelPiece } from "@/data/jewellery";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import type { LiveLookup, LiveState } from "@/lib/portal/dropPhase";
+import { useMember } from "./MemberContext";
+
+/*
+  The drops read the shop through the site's shared live catalogue (one
+  cache with the shop pages, so a piece is never fetched twice). Only what
+  Shopify answered counts: until it has, a piece has no price and no stock
+  word; the bundled first-paint copy of the catalogue is never shown as a
+  price here.
+*/
+
+export type ShopState = "loading" | "ready" | "offline";
+
+export type DropShop = {
+  /** Each handle as the shop shows it, or null until the shop has answered. */
+  live: LiveLookup;
+  pieceOf: (handle: string) => JewelPiece | undefined;
+  status: ShopState;
+};
+
+export const useDropShop = (enabled = true): DropShop => {
+  const { jewellery, isLive, isLoading } = useLiveJewellery(enabled);
+  const { unlisted } = useMember();
+  return useMemo(() => {
+    // Development preview only: pieces it treats as not yet on the shop.
+    const masked = new Set(unlisted);
+    const byHandle = new Map<string, JewelPiece>(isLive ? jewellery.filter((p) => !masked.has(p.handle)).map((p) => [p.handle, p]) : []);
+    const stateOf = (handle: string): LiveState => {
+      const piece = byHandle.get(handle);
+      return !piece ? "unlisted" : piece.availableForSale ? "available" : "soldout";
+    };
+    return {
+      live: isLive ? stateOf : null,
+      pieceOf: (handle: string) => byHandle.get(handle),
+      status: isLive ? "ready" : isLoading && enabled ? "loading" : "offline",
+    };
+  }, [jewellery, isLive, isLoading, unlisted, enabled]);
+};
