new file mode 100644
index 0000000..4958f53
--- /dev/null
+++ b/src/components/portal/ShopWatch.test.tsx
@@ -0,0 +1,51 @@
+import { act, cleanup, render } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+/* While a drop waits on its pieces, the shared catalogue is asked again: at
+   once, then every 40 s, ten times at most, by mounting a fresh reader of the
+   same cache (React Query refetches it once it is 30 s old). */
+
+const reads = vi.hoisted(() => ({ mounts: 0 }));
+vi.mock("@/hooks/useLiveJewellery", async () => {
+  const { useEffect } = await import("react");
+  return {
+    useLiveJewellery: () => {
+      useEffect(() => {
+        reads.mounts += 1;
+      }, []);
+      return { jewellery: [], isLive: true, isLoading: false };
+    },
+  };
+});
+
+import ShopWatch, { WATCH_EVERY_MS, WATCH_TRIES } from "./ShopWatch";
+
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  reads.mounts = 0;
+});
+
+describe("ShopWatch", () => {
+  it("asks nothing while the drop is not waiting on its pieces", () => {
+    vi.useFakeTimers();
+    render(<ShopWatch active={false} />);
+    act(() => void vi.advanceTimersByTime(10 * WATCH_EVERY_MS));
+    expect(reads.mounts).toBe(0);
+  });
+
+  it("asks at once, then every 40 s, ten more times at most", () => {
+    vi.useFakeTimers();
+    const view = render(<ShopWatch active={false} />);
+    view.rerender(<ShopWatch active />);
+    expect(reads.mounts).toBe(1);
+    act(() => void vi.advanceTimersByTime(WATCH_EVERY_MS));
+    expect(reads.mounts).toBe(2);
+    for (let i = 0; i < 30; i++) act(() => void vi.advanceTimersByTime(WATCH_EVERY_MS));
+    expect(reads.mounts).toBe(1 + WATCH_TRIES);
+    // The pieces arrived: the watch stops.
+    view.rerender(<ShopWatch active={false} />);
+    for (let i = 0; i < 5; i++) act(() => void vi.advanceTimersByTime(WATCH_EVERY_MS));
+    expect(reads.mounts).toBe(1 + WATCH_TRIES);
+  });
+});
diff --git a/src/components/portal/ShopWatch.tsx b/src/components/portal/ShopWatch.tsx
new file mode 100644
index 0000000..4a00679
--- /dev/null
+++ b/src/components/portal/ShopWatch.tsx
@@ -0,0 +1,39 @@
+import { useEffect, useState } from "react";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+
+/*
+  A drop's pieces go onto the shop by hand, about when it opens. The shared
+  catalogue is re-read only every 5 minutes, or when the tab regains focus
+  (which Instagram's browser seldom reports), so a member who watched the
+  Bloom Clock reach zero could read "Opening shortly" for minutes after the
+  pieces were up. While a drop is waiting on its pieces this asks again: at
+  once, then every 40 s, at most 10 times, never on a hidden tab. Each ask is
+  a fresh reader of the same cached catalogue, which React Query fetches
+  again once it is over 30 s old: no new request, no second copy of the shop.
+*/
+
+export const WATCH_EVERY_MS = 40_000;
+export const WATCH_TRIES = 10;
+
+const Reader = () => {
+  useLiveJewellery(true);
+  return null;
+};
+
+const ShopWatch = ({ active }: { active: boolean }) => {
+  const [tick, setTick] = useState(0);
+  useEffect(() => {
+    if (!active) return;
+    let tries = 0;
+    const t = window.setInterval(() => {
+      if (document.visibilityState === "hidden") return;
+      tries += 1;
+      setTick((n) => n + 1);
+      if (tries >= WATCH_TRIES) window.clearInterval(t);
+    }, WATCH_EVERY_MS);
+    return () => window.clearInterval(t);
+  }, [active]);
+  return active ? <Reader key={tick} /> : null;
+};
+
+export default ShopWatch;
