+/** "tonight · 8 pm", "today · 11:30 am", "tomorrow · 8 pm", else "21 Nov": when a drop opens, as one would say it in India. */
+export const istOpensWhen = (at: string | number | Date, now: number): string | null => {
+  const d = parse(at);
+  if (!d) return null;
+  const { hour, minute } = istParts(d);
+  const clock = `${hour % 12 === 0 ? 12 : hour % 12}${minute ? `:${pad(minute)}` : ""} ${hour < 12 ? "am" : "pm"}`;
+  const day = istDayKey(d);
+  if (day === istDayKey(new Date(now))) return `${hour >= 17 ? "tonight" : "today"} · ${clock}`;
+  if (day === istDayKey(new Date(now + 86_400_000))) return `tomorrow · ${clock}`;
+  return formatIstDay(d);
+};
