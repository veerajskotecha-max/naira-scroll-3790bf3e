index 0000000..7b4550b
--- /dev/null
+++ b/src/lib/portal/wishlistSync.ts
@@ -0,0 +1,96 @@
+import type { JewelPiece } from "@/data/jewellery";
+import type { WishlistItem } from "@/contexts/WishlistContext";
+import { MAX_SAVED } from "./memberMeta";
+
+/*
+  The Jewel drawer: the hearts on this phone (the shop's own wishlist, kept by
+  WishlistContext, untouched) and the pieces saved to her account
+  (naira.saved, at most 24 handles), kept as one list.
+
+  A three-way merge against what the two last agreed on this phone (`base`),
+  so a piece taken out in one place is not put back by the other:
+    - a piece in either list is kept;
+    - a piece both held at the last sync that this phone has since dropped
+      (its heart tapped off on the shop) leaves the account too;
+    - one the account has since dropped (taken out of the drawer on another
+      phone) leaves this phone too.
+  On a new phone `base` is empty, so it is simply both lists together.
+  Oldest first, nothing twice, the newest 24 kept. Once the shop's live
+  catalogue has answered, a handle it no longer carries is let go quietly
+  (never before: an unreachable shop is not a reason to forget anything).
+
+  The shop's hearts have no limit and her account keeps 24, so some hearts on
+  this phone may not fit in the drawer. Those are `spill`: they stay hearted
+  here, are never put back into the account by a later merge (which would
+  push another piece out, and then that one, for ever), and are never taken
+  off this phone for not fitting. Only a heart new to this phone (not in
+  `base`, not spilled) joins the drawer as its newest piece. So the plan is
+  a fixed point: once its saved list is written and its agreed list and
+  spill kept, the same lists plan nothing more.
+*/
+
+export type SyncPlan = {
+  /** Her saved handles, oldest first: what the account should hold. */
+  saved: string[];
+  /** Hearts to take off this phone (taken out of the drawer on another phone). */
+  removeFromDevice: string[];
+  /** Saved on her account but not hearted on this phone. */
+  missingOnDevice: string[];
+  /** What both will hold once the plan is done: the next `base`. */
+  agreed: string[];
+  /** Hearts on this phone the drawer has no room for: left as they are, the next `spill`. */
+  spill: string[];
+};
+
+/** The handles of this phone's jewellery hearts (an apparel heart is not the drawer's). */
+export const deviceHandles = (items: readonly WishlistItem[]): string[] => {
+  const out: string[] = [];
+  for (const item of items) if (item.kind !== "apparel" && item.id && !out.includes(item.id)) out.push(item.id);
+  return out;
+};
+
+export const mergeSaved = (
+  device: readonly string[],
+  account: readonly string[],
+  base: readonly string[],
+  catalogue: ReadonlySet<string> | null,
+  spilled: readonly string[] = [],
+): SyncPlan => {
+  const had = new Set(base);
+  const onDevice = new Set(device);
+  const onAccount = new Set(account);
+  // A spilled heart counts only while it is still hearted here.
+  const spill = new Set(spilled.filter((h) => onDevice.has(h)));
+  const droppedHere = new Set([...had].filter((h) => !onDevice.has(h)));
+  const droppedThere = new Set([...had].filter((h) => !onAccount.has(h) && !spill.has(h)));
+  const gone = (h: string) => droppedHere.has(h) || droppedThere.has(h) || (catalogue !== null && !catalogue.has(h));
+
+  // Her account's pieces, then the hearts new to this phone (the newest).
+  const fresh = device.filter((h) => !onAccount.has(h) && !had.has(h) && !spill.has(h));
+  const order: string[] = [];
+  for (const h of [...account, ...fresh]) if (!order.includes(h)) order.push(h);
+  const saved = order.filter((h) => !gone(h)).slice(-MAX_SAVED);
+  const keep = new Set(saved);
+  const removeFromDevice = device.filter((h) => droppedThere.has(h));
+  const missingOnDevice = saved.filter((h) => !onDevice.has(h));
+  const agreed = saved.filter((h) => onDevice.has(h));
+  const nextSpill = device.filter((h) => !keep.has(h) && !gone(h));
+  return { saved, removeFromDevice, missingOnDevice, agreed, spill: nextSpill };
+};
+
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
+
+/**
+ * Hearts for this phone, built from the live catalogue as the shop's own
+ * heart builds them (name, live price, photo, variant): only for pieces the
+ * shop still carries. On a new phone these go in through the wishlist's own
+ * toggleItem, one at a time, when she asks for them.
+ */
+export const heartsFor = (handles: readonly string[], catalogue: readonly JewelPiece[]): WishlistItem[] => {
+  const byHandle = new Map(catalogue.map((p) => [p.handle, p]));
+  return handles.flatMap((h) => {
+    const piece = byHandle.get(h);
+    if (!piece) return [];
+    return [{ id: piece.handle, name: piece.name, price: rupees(piece.price), image: piece.cover ?? piece.image, kind: "jewellery" as const, variantId: piece.variantId, amount: piece.price }];
+  });
+};
