+import { useLayoutEffect, useMemo, useRef } from "react";
+import { BED } from "@/lib/portal/gardenLayout";
+import { useConfirmed } from "@/lib/portal/checkouts";
+import { rosesInFront } from "@/lib/portal/goldRoses";
+import { formatIstDate } from "@/lib/portal/ist";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion, useAmbientLoop } from "@/lib/portal/motion";
+import { hasDropFlag, setDropFlag } from "@/lib/portal/safeStorage";
+
+/*
+  Her gold-leaf roses (Phase 5): a chunk of its own, fetched once the
+  garden's Doors have gone. One rose for each order the shop's webhook
+  confirmed (member_orders status 'completed'; never a checkout she only
+  started), in her bed's front row (lib/portal/goldRoses), and the same
+  roses in words for "What's growing", each dated with its own order's
+  time. Nothing here counts them.
+
+  A rose grows once on this device: its stem, veins and the swirl of its
+  petals draw in gold (stroke-dashoffset), the leaves and the head open
+  after (opacity, and a small bloom in transform). A one-shot, never a loop.
+  It waits, undrawn (paused at its first frame), until the front row is in
+  view above the garden path: the row stands at the soil, often below the
+  fold or under the path on a phone, and a growth played there would be
+  marked grown unseen. Once in view it joins the bed's one ambient loop
+  until it has grown (so it waits while the garden rests, off screen or on
+  a hidden tab), then leaves it; "grown" is set only when it has played to
+  its end. That one look is the bed's own business (an observer that
+  disconnects at once, never a loop). After that, and under reduced motion
+  or Data Saver, it is still art.
+
+  Her rows are read once a visit, ids and order times only (useConfirmed,
+  under the existing row security); the development preview member's
+  stand-in rows are used instead, and Supabase is never asked.
+*/
+
+type Props = { part: "bed"; seed: string; nairaX: number; stoneX: number } | { part: "words" };
+
+/* Art colours, inside the drawing only. */
+const GOLD = "#C99A4C";
+const GOLD_DEEP = "#B0843A";
+const GOLD_LEAF = "#DDB46A";
+
+/* Their fill, stroke, dashes and transform origin are in members.css (.ig-rose-line, .ig-rose-bloom), with the layer's pointer-events. */
+const LINE = { className: "ig-rose-line", pathLength: 1 };
+const BLOOM = { className: "ig-rose-bloom" };
+
+/* Once an animation has played to its end (never on a cancel). */
+const whenDone = (a: Animation, fn: () => void) => void a.finished?.then(fn, () => undefined);
+
+/** One rose, its stem base at 0,0 (the soil), about 60 high: gold lines that draw, and leaves and a head that open. */
+const Rose = () => (
+  <>
+    <path {...LINE} d="M0 0C-1.6-12 1.8-26 .4-38" strokeWidth="1.1" />
+    <path {...BLOOM} d="M-.4-12C-5-13-9-17-10-21C-5-21-1.5-17-.4-12ZM.6-22C5-23 8.6-27 9.6-31C5-31 1.4-27 .6-22Z" fill={GOLD_LEAF} stroke={GOLD_DEEP} strokeWidth=".5" />
+    <path {...LINE} d="M-.4-12C-4-14-7-17-9-20M.6-22C4-24 7-27 9-30" strokeWidth=".4" />
+    <g transform="translate(.4 -36)">
+      <g {...BLOOM}>
+        <path d="M-1 0C-7 0-11-4-11-9C-11-13-8-15-5-14C-6-10-5-5-1 0ZM1 0C7 0 11-4 11-9C11-13 8-15 5-14C6-10 5-5 1 0Z" fill={GOLD} stroke={GOLD_DEEP} strokeWidth=".5" />
+        <path d="M-6-12C-6-17-2-20 0-20C2-20 6-17 6-12C6-6 3-3 0-3C-3-3-6-6-6-12Z" fill={GOLD_LEAF} stroke={GOLD_DEEP} strokeWidth=".5" />
+        <path d="M-8-8C-5-4-2-3 0-3C2-3 5-4 8-8C8-3 5 0 0 0C-5 0-8-3-8-8Z" fill={GOLD} stroke={GOLD_DEEP} strokeWidth=".5" />
+        <path d="M6-19l1 2 2 .4-2 .6-1 2-1-2-2-.6 2-.4Z" fill="#FFF6EA" />
+      </g>
+      <path {...LINE} d="M-2-12C-2-15 2-16 3-13C4-10 0-9-1-11C-2-12 0-14 1-13" strokeWidth=".6" />
+    </g>
+  </>
+);
+
+const RoseBed = ({ seed, nairaX, stoneX }: { seed: string; nairaX: number; stoneX: number }) => {
+  const orders = useConfirmed();
+  const roses = useMemo(() => rosesInFront(seed, orders, nairaX, stoneX), [seed, orders, nairaX, stoneX]);
+  const ref = useRef<SVGSVGElement>(null);
+  const loop = useAmbientLoop();
+
+  // Grows once on this device, in view and with the bed's attention: the lines draw, then the leaves and the head open. Then it stands.
+  useLayoutEffect(() => {
+    const root = ref.current;
+    if (!root || !roses.length || stillMotion()) return;
+    const made: Animation[] = [];
+    const leaving: (() => void)[] = [];
+    let first: Element | undefined;
+    let k = 0;
+    // The layer's children are the roses, in order.
+    roses.forEach(({ id }, i) => {
+      const rose = root.children[i];
+      if (!rose || hasDropFlag("grown", id)) return;
+      first ??= rose;
+      const delay = 120 + k++ * 180;
+      const grow = (selector: string, keyframes: Keyframe[], after: number, easing: string) =>
+        rose.querySelectorAll(selector).forEach((el) => {
+          const a = play(el, keyframes, { duration: after ? 700 : 900, delay: delay + after, easing, fill: "backwards" });
+          if (a) made.push(a);
+        });
+      grow(".ig-rose-line", [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], 0, EASE_REVEAL);
+      grow(".ig-rose-bloom", [{ opacity: 0, transform: "scale(.25)" }, { opacity: 1, transform: "none" }], 560, EASE_BLOOM);
+      const last = made[made.length - 1];
+      if (last) whenDone(last, () => setDropFlag("grown", id));
+    });
+    // On the bed's loop (resting with it), each leaving it once it has played: a one-shot never replays.
+    const start = () =>
+      made.forEach((a) => {
+        const leave = loop ? loop.join([a]) : (a.play(), () => undefined);
+        leaving.push(leave);
+        whenDone(a, leave);
+      });
+    // Held undrawn until the row (every rose stands on the same soil) is half in view above the garden path
+    // (members.css .ig-nav: about 59 px, sticky at the bottom; the page sets no viewport-fit, so no safe-area inset).
+    let io: IntersectionObserver | null = null;
+    if (first && window.IntersectionObserver) {
+      made.forEach((a) => a.pause());
+      const seen = new IntersectionObserver(
+        ([e]) => {
+          if (e.isIntersecting) {
+            seen.disconnect();
+            start();
+          }
+        },
+        { rootMargin: "0px 0px -72px", threshold: 0.5 },
+      );
+      seen.observe(first);
+      io = seen;
+    } else start();
+    return () => {
+      if (io) io.disconnect();
+      leaving.forEach((leave) => leave());
+      made.forEach((a) => a.cancel());
+    };
+  }, [roses, loop]);
+
+  if (!roses.length) return null;
+  return (
+    <svg ref={ref} viewBox={`0 0 ${BED.w} ${BED.h}`} className="ig-bed-ground ig-bed-roses" aria-hidden>
+      {roses.map((r) => (
+        <g key={r.id} className="ig-rose" transform={`translate(${r.x} ${r.y}) scale(${r.flip ? -1.25 : 1.25} 1.25)`}>
+          <Rose />
+        </g>
+      ))}
+    </svg>
+  );
+};
+
+/* The roses in words, newest first: each its own line, with its own order's day. */
+const RoseWords = () => {
+  const orders = useConfirmed();
+  return (
+    <>
+      {orders.map((o) => (
+        <li key={o.id} data-clarity-mask="true">
+          <strong>A gold-leaf rose</strong>
+          {`, for the order placed ${formatIstDate(o.confirmedAt)}.`}
+        </li>
+      ))}
+    </>
+  );
+};
+
+const GoldRose = (props: Props) => (props.part === "words" ? <RoseWords /> : <RoseBed {...props} />);
+
+export default GoldRose;
