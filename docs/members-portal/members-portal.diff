+++ b/src/components/portal/PressFlower.tsx
@@ -0,0 +1,178 @@
+import { useLayoutEffect, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import type { Drop } from "@/lib/portal/drops";
+import { speciesIndex } from "@/lib/portal/dropPhase";
+import { formatIstDay } from "@/lib/portal/ist";
+import { EASE_IN, EASE_REVEAL, cue, play, stillMotion, type Cue } from "@/lib/portal/motion";
+import { FlowerGlyph } from "./FlowerGlyph";
+import HerbariumFrame from "./HerbariumFrame";
+import { burstPetals } from "./PetalBurst";
+import { PETAL_HUE, PETAL_SPARK } from "./PetalSymbols";
+import { eyebrow, primaryButton, textLink } from "./styles";
+
+/*
+  PRESS YOUR FLOWER. Once a drop has opened, its flower stands in a waiting
+  herbarium sheet (only the fine inner rule drawn). A tap presses it, in
+  700 ms: the flower lies down on its side (a quarter turn, drawn in a
+  little so it stays on the sheet), then a sheet of pressing paper comes
+  down over it and it goes flat beneath (to 0.06 of its depth) and pale. The paper holds a moment and lifts: under it lies the pressed
+  specimen, fading in as the gold frame draws itself around it once and its
+  label appears: "Drop 01 · Verdant · pressed 21 Nov". The same flower is
+  planted in her garden and kept in her Vault. It is for joy: not points,
+  never redeemable, and nothing is unlocked by it. Under reduced motion it
+  is simply pressed. Transform, opacity and stroke-dashoffset only; the
+  section keeps its height, so nothing below it jumps.
+*/
+
+type Props = {
+  drop: Drop;
+  /** "01" */
+  number: string;
+  /** The IST day she pressed it ("2026-11-21"), "" if unknown, or null if not yet. */
+  pressedOn: string | null;
+  onPress: () => void;
+};
+
+const dayLabel = (day: string) => (day ? formatIstDay(`${day}T12:00:00+05:30`) : null);
+
+const PRESS_MS = 700;
+const EASE_TURN = "cubic-bezier(0.45, 0, 0.2, 1)";
+
+/* The pressing paper: made at the tap, inside the frame's fine rule, and taken away once it has lifted. */
+const makePlate = (sheet: Element | null | undefined) => {
+  if (!sheet) return null;
+  const wrap = document.createElement("div");
+  wrap.setAttribute("aria-hidden", "true");
+  wrap.style.cssText = "position:absolute;left:3.5%;right:3.5%;top:2.8%;bottom:2.8%;overflow:hidden;pointer-events:none";
+  const plate = document.createElement("div");
+  plate.style.cssText = "position:absolute;inset:0;background:#FFF8F0;border-bottom:1px solid rgb(176 132 58 / .6);box-shadow:0 10px 18px -14px rgb(122 90 40 / .5);transform:translateY(-102%)";
+  wrap.appendChild(plate);
+  sheet.appendChild(wrap);
+  return { wrap, plate };
+};
+
+const PressFlower = ({ drop, number, pressedOn, onPress }: Props) => {
+  const species = speciesIndex(drop.species);
+  const [pressing, setPressing] = useState(false);
+  const justPressed = useRef(false);
+  const sectionRef = useRef<HTMLElement>(null);
+  const flowerRef = useRef<HTMLDivElement>(null);
+  const frameRef = useRef<HTMLElement>(null);
+  const cueRef = useRef<Cue | null>(null);
+  const plateRef = useRef<{ wrap: HTMLElement; plate: HTMLElement } | null>(null);
+  const pressed = pressedOn !== null && !pressing;
+
+  const press = () => {
+    if (pressedOn !== null || pressing) return;
+    if (stillMotion()) {
+      onPress();
+      return;
+    }
+    setPressing(true);
+    // It lies down (a quarter turn), then goes flat and pale under the paper.
+    play(
+      flowerRef.current,
+      [
+        { offset: 0, transform: "rotate(0deg) scale(1, 1)", opacity: 1, easing: EASE_TURN },
+        { offset: 0.45, transform: "rotate(90deg) scale(.72, .72)", opacity: 1, easing: EASE_IN },
+        { offset: 0.75, transform: "rotate(90deg) scale(.06, .72)", opacity: 0.8, easing: "ease-out" },
+        { offset: 1, transform: "rotate(90deg) scale(.045, .7)", opacity: 0.4 },
+      ],
+      { duration: PRESS_MS, easing: "linear", fill: "forwards" },
+    );
+    const made = makePlate(frameRef.current?.querySelector(".ig-herb-sheet"));
+    plateRef.current = made;
+    play(made?.plate, [{ transform: "translateY(-102%)" }, { transform: "translateY(0)" }], { duration: 210, delay: PRESS_MS * 0.45, easing: EASE_IN, fill: "both" });
+    // The timer rides on the section, never on the flower: its own opacity is the press's to animate.
+    cueRef.current = cue(sectionRef.current, PRESS_MS, () => {
+      justPressed.current = true;
+      setPressing(false);
+      onPress();
+    });
+  };
+
+  useLayoutEffect(
+    () => () => {
+      cueRef.current?.cancel();
+      plateRef.current?.wrap.remove();
+    },
+    [],
+  );
+
+  // Just pressed: the paper lifts off the pressed specimen, the frame draws once, a few petals let go.
+  useLayoutEffect(() => {
+    if (!pressed || !justPressed.current) return;
+    justPressed.current = false;
+    const frame = frameRef.current;
+    const made = plateRef.current;
+    if (made) {
+      const lift = play(made.plate, [{ transform: "translateY(0)" }, { transform: "translateY(-102%)" }], { duration: 320, delay: 120, easing: EASE_REVEAL, fill: "both" });
+      if (lift) lift.onfinish = () => made.wrap.remove();
+      else made.wrap.remove();
+      plateRef.current = lift ? made : null;
+    }
+    play(frame?.querySelector(".ig-herb-flower"), [{ opacity: 0, transform: "scale(1.03)" }, { opacity: 1, transform: "none" }], { duration: 420, delay: 160, easing: EASE_REVEAL, fill: "backwards" });
+    play(frame?.querySelector(".ig-herb-frame rect"), [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 760, delay: 200, easing: EASE_REVEAL, fill: "backwards" });
+    play(frame?.querySelector(".ig-herb-label"), [{ opacity: 0, transform: "translateY(6px)" }, { opacity: 1, transform: "none" }], { duration: 420, delay: 380, easing: EASE_REVEAL, fill: "backwards" });
+    const sheet = frame?.querySelector(".ig-herb-sheet");
+    if (sheet) {
+      const box = sheet.getBoundingClientRect();
+      burstPetals(sheet as HTMLElement, box.width / 2, box.height * 0.42, { count: 12, spread: 120, ids: [PETAL_HUE, PETAL_HUE, PETAL_SPARK], color: drop.accent, delay: 300 });
+    }
+  }, [pressed, drop.accent]);
+
+  const label = `Drop ${number} · ${drop.title}`;
+  const day = pressedOn ? dayLabel(pressedOn) : null;
+  return (
+    <section ref={sectionRef} className="ig-section ig-press" aria-labelledby={`ig-press-${drop.id}`}>
+      <h2 id={`ig-press-${drop.id}`} className="ig-h2">
+        Press your flower
+      </h2>
+      <div className="ig-press-stage">
+        <HerbariumFrame
+          frameRef={frameRef}
+          species={species}
+          accent={drop.accent}
+          pressed={pressed}
+          waiting={!pressed}
+          title={label}
+          note={pressed ? (day ? `pressed ${day}` : "pressed") : "waiting to be pressed"}
+          className={pressed ? "" : "is-waiting"}
+        >
+          {!pressed && (
+            <div ref={flowerRef} className="ig-press-bloom">
+              <FlowerGlyph species={species} accent={drop.accent} state="bloom" size={170} />
+            </div>
+          )}
+        </HerbariumFrame>
+      </div>
+      {/* Pressed or not, a 50 px line and a two-line note: the section keeps its height. */}
+      {pressed ? (
+        <>
+          <p className={eyebrow} role="status" style={{ display: "flex", alignItems: "center", justifyContent: "center", minHeight: 50, margin: 0 }}>
+            Pressed and planted in your garden
+          </p>
+          <p className="ig-fineprint ig-press-note">
+            <Link className={textLink} to="/members">
+              See it growing
+            </Link>{" "}
+            or find it in{" "}
+            <Link className={textLink} to="/members/vault">
+              your Vault
+            </Link>
+            . For joy: not points, never redeemable.
+          </p>
+        </>
+      ) : (
+        <>
+          <button type="button" className={primaryButton} onClick={press} disabled={pressing}>
+            {pressing ? "Pressing…" : "Press your flower"}
+          </button>
+          <p className="ig-fineprint ig-press-note">Kept in your Vault and planted in your garden. For joy: not points, never redeemable.</p>
+        </>
+      )}
+    </section>
+  );
+};
+
+export default PressFlower;
diff --git a/src/components/portal/RingSizer.tsx b/src/components/portal/RingSizer.tsx
new file mode 100644
index 0000000..7ad18d0
--- /dev/null
+++ b/src/components/portal/RingSizer.tsx
@@ -0,0 +1,257 @@
+import { useCallback, useEffect, useLayoutEffect, useRef, useState, type KeyboardEvent, type PointerEvent as ReactPointerEvent } from "react";
+import type { UsSize } from "@/lib/portal/memberMeta";
+import { readPortal, writePortal } from "@/lib/portal/safeStorage";
+import { CIRCLE_STOPS_MM, calibrationFor, currentScreenKey, matchForStop, outsideSizeWhatsApp, pinchStop, stopWords } from "@/lib/portal/sizer";
+import { stillMotion } from "@/lib/portal/motion";
+import CardCalibrate from "./CardCalibrate";
+import { primaryButton, quietButton } from "./styles";
+import "./sizer.css";
+
+/*
+  The ring sizer, its own chunk, fetched when she taps "Measure on this
+  screen". First the card (once per screen: the calibration is kept on this
+  device for this screen's size and pixel ratio), then a ring she already
+  wears laid on the circle: she moves the gold handle (or pinches the circle,
+  or taps Smaller / Larger) and the circle steps through the shop's chart,
+  US 5 to 9, with a stop past each end for a size the shop does not sell.
+  The circle is one drawing scaled with transform, so the steps stay smooth;
+  under reduced motion it simply changes size. While she drags, the handle is
+  moved by a transform written straight to it (no layout is read after the
+  first touch) and React renders only when the circle steps to another size,
+  seven times across the whole track, so a slow phone keeps up with her thumb.
+*/
+
+type Props = {
+  onKeep: (us: UsSize) => void;
+  onCancel: () => void;
+  /** When the card cannot be measured on this screen: the thread, or the size she knows. */
+  onOtherWay?: (way: "thread" | "known") => void;
+};
+
+const STOPS = CIRCLE_STOPS_MM.length;
+const START = 2; // US 6, the size most rings open on
+/* The circle's drawn diameter in px, before scaling. The svg's viewBox spans
+   exactly the circle (2r = 100 units across 100 px), so a stop is drawn at
+   exactly its chart diameter; overflow: visible keeps the stroke's outer half. */
+const BASE = 100;
+const R = 50;
+
+const Circle = ({ pxPerMm, onKeep, onRecalibrate }: { pxPerMm: number; onKeep: (us: UsSize) => void; onRecalibrate: () => void }) => {
+  const [stop, setStop] = useState(START);
+  const [track, setTrack] = useState(280);
+  const [dragging, setDragging] = useState(false);
+  // Spoken only for Smaller and Larger: the slider speaks its own value as she moves it.
+  const [said, setSaid] = useState("");
+  const trackRef = useRef<HTMLDivElement>(null);
+  const thumbRef = useRef<HTMLDivElement>(null);
+  /* A drag in progress: the pointer, and the track's box read once as it began
+     (so a move reads no layout). The handle follows her thumb by a style
+     write of its own; React renders only when the circle steps to a new size. */
+  const drag = useRef<{ id: number; left: number; width: number } | null>(null);
+  const stopRef = useRef(stop);
+  stopRef.current = stop;
+  const pinch = useRef(new Map<number, { x: number; y: number }>());
+  const pinchFrom = useRef<{ d: number; stop: number } | null>(null);
+  const still = stillMotion();
+
+  useLayoutEffect(() => {
+    const el = trackRef.current;
+    if (!el) return;
+    const measure = () => setTrack(el.clientWidth || 280);
+    measure();
+    window.addEventListener("resize", measure);
+    return () => window.removeEventListener("resize", measure);
+  }, []);
+
+  const mm = CIRCLE_STOPS_MM[stop];
+  const scale = (mm * pxPerMm) / BASE;
+  const m = matchForStop(stop);
+  const restAt = (stop / (STOPS - 1)) * track;
+
+  // At rest the handle sits on its size's tick (and glides there when she lets go).
+  useLayoutEffect(() => {
+    if (!dragging && thumbRef.current) thumbRef.current.style.transform = `translateX(${restAt.toFixed(1)}px)`;
+  }, [dragging, restAt]);
+
+  const stepTo = (next: number) => {
+    if (next !== stopRef.current) {
+      stopRef.current = next;
+      setStop(next);
+    }
+  };
+
+  /* The handle follows her thumb; the circle steps to the nearest size. */
+  const follow = (clientX: number) => {
+    const d = drag.current;
+    if (!d || !d.width || !Number.isFinite(clientX)) return;
+    const x = Math.max(0, Math.min(d.width, clientX - d.left));
+    if (thumbRef.current) thumbRef.current.style.transform = `translateX(${x.toFixed(1)}px)`;
+    stepTo(Math.round((x / d.width) * (STOPS - 1)));
+  };
+  const onTrackDown = (e: ReactPointerEvent<HTMLDivElement>) => {
+    const rect = e.currentTarget.getBoundingClientRect();
+    drag.current = { id: e.pointerId, left: rect.left, width: rect.width };
+    try {
+      e.currentTarget.setPointerCapture(e.pointerId);
+    } catch {
+      /* capture is a nicety */
+    }
+    setDragging(true);
+    follow(e.clientX);
+  };
+  const onTrackMove = (e: ReactPointerEvent<HTMLDivElement>) => {
+    if (drag.current?.id === e.pointerId) follow(e.clientX);
+  };
+  const onTrackUp = (e: ReactPointerEvent<HTMLDivElement>) => {
+    if (drag.current?.id !== e.pointerId) return;
+    drag.current = null;
+    setDragging(false);
+  };
+  const onKey = (e: KeyboardEvent<HTMLDivElement>) => {
+    if (e.key === "ArrowRight" || e.key === "ArrowUp") setStop((s) => Math.min(STOPS - 1, s + 1));
+    else if (e.key === "ArrowLeft" || e.key === "ArrowDown") setStop((s) => Math.max(0, s - 1));
+    else if (e.key === "Home") setStop(0);
+    else if (e.key === "End") setStop(STOPS - 1);
+    else return;
+    e.preventDefault();
+  };
+
+  /* Two fingers on the circle: it grows and shrinks with them, one size for each 36 px of spread (lib/portal/sizer pinchStop). */
+  const onStageDown = (e: ReactPointerEvent<HTMLDivElement>) => {
+    pinch.current.set(e.pointerId, { x: e.clientX, y: e.clientY });
+    if (pinch.current.size === 2) {
+      const [a, b] = [...pinch.current.values()];
+      pinchFrom.current = { d: Math.hypot(a.x - b.x, a.y - b.y), stop: stopRef.current };
+    }
+  };
+  const onStageMove = (e: ReactPointerEvent<HTMLDivElement>) => {
+    const at = pinch.current.get(e.pointerId);
+    if (!at) return;
+    at.x = e.clientX;
+    at.y = e.clientY;
+    const from = pinchFrom.current;
+    if (pinch.current.size !== 2 || !from || !from.d) return;
+    const [a, b] = [...pinch.current.values()];
+    stepTo(pinchStop(from.stop, from.d, Math.hypot(a.x - b.x, a.y - b.y)));
+  };
+  const onStageUp = (e: ReactPointerEvent<HTMLDivElement>) => {
+    pinch.current.delete(e.pointerId);
+    if (pinch.current.size < 2) pinchFrom.current = null;
+  };
+
+  return (
+    <div className="ig-sz">
+      <p className="ig-fineprint">Lay a ring that fits you well on the circle. Move the gold handle until the circle sits just inside the ring.</p>
+      <div className="ig-sz-stage" onPointerDown={onStageDown} onPointerMove={onStageMove} onPointerUp={onStageUp} onPointerCancel={onStageUp} aria-hidden>
+        <div className={`ig-sz-ring${still ? " is-still" : ""}`} style={{ transform: `scale(${scale.toFixed(4)})` }}>
+          <svg viewBox={`${-R} ${-R} ${2 * R} ${2 * R}`} width={BASE} height={BASE}>
+            <circle r={R} className="ig-sz-fill" />
+            <circle r={R} className="ig-sz-line" />
+          </svg>
+        </div>
+        <span className="ig-sz-cross" />
+      </div>
+      <p className="ig-sz-read" aria-hidden>
+        {stopWords(stop)}
+      </p>
+      <p className="sr-only" role="status">
+        {said}
+      </p>
+      <div className="ig-sz-row">
+        <button type="button" className="ig-sz-step" onClick={() => {
+            const next = Math.max(0, stop - 1);
+            setStop(next);
+            setSaid(stopWords(next));
+          }} disabled={stop === 0} aria-label="Smaller">
+          −
+        </button>
+        <div
+          ref={trackRef}
+          className="ig-sz-track"
+          onPointerDown={onTrackDown}
+          onPointerMove={onTrackMove}
+          onPointerUp={onTrackUp}
+          onPointerCancel={onTrackUp}
+        >
+          {CIRCLE_STOPS_MM.map((_, i) => (
+            <span key={i} className="ig-sz-tick" style={{ left: `${(i / (STOPS - 1)) * 100}%` }} aria-hidden />
+          ))}
+          <div
+            ref={thumbRef}
+            className={`ig-sz-thumb${dragging || still ? "" : " is-resting"}`}
+            role="slider"
+            tabIndex={0}
+            aria-label="Ring size"
+            aria-valuemin={0}
+            aria-valuemax={STOPS - 1}
+            aria-valuenow={stop}
+            aria-valuetext={stopWords(stop)}
+            onKeyDown={onKey}
+          >
+            <span aria-hidden />
+          </div>
+        </div>
+        <button type="button" className="ig-sz-step" onClick={() => {
+            const next = Math.min(STOPS - 1, stop + 1);
+            setStop(next);
+            setSaid(stopWords(next));
+          }} disabled={stop === STOPS - 1} aria-label="Larger">
+          +
+        </button>
+      </div>
+      {m.kind === "size" ? (
+        <>
+          <button type="button" className={primaryButton} onClick={() => onKeep(m.us)}>
+            Keep US {m.us}
+          </button>
+          <p className="ig-sz-guide">A guide, not a guarantee</p>
+        </>
+      ) : (
+        <>
+          <p className="ig-fineprint">The shop's rings run from US 5 to US 9. Tell us your size on WhatsApp, and we'll tell you honestly what we can do.</p>
+          <a className={primaryButton} href={outsideSizeWhatsApp(m.kind === "below" ? "smaller than US 5 on the sizer" : "larger than US 9 on the sizer")} target="_blank" rel="noopener noreferrer">
+            Ask us on WhatsApp
+          </a>
+        </>
+      )}
+      <button type="button" className={quietButton} onClick={onRecalibrate}>
+        Measure the card again
+      </button>
+    </div>
+  );
+};
+
+const RingSizer = ({ onKeep, onCancel, onOtherWay }: Props) => {
+  const [key] = useState(currentScreenKey);
+  const [pxPerMm, setPxPerMm] = useState<number | null>(() => calibrationFor(readPortal().cardCal, key));
+  const [calibrating, setCalibrating] = useState(pxPerMm === null);
+  const rootRef = useRef<HTMLDivElement>(null);
+
+  // Each step opens at the top of the screen, its step line just under the header.
+  useEffect(() => {
+    rootRef.current?.focus({ preventScroll: true });
+    rootRef.current?.scrollIntoView?.({ block: "start" });
+  }, [calibrating]);
+
+  return (
+    <div ref={rootRef} className="ig-sizer" tabIndex={-1} aria-label={calibrating ? "Measure a card" : "Match a ring"} role="group">
+      <p className="ig-eyebrow">{calibrating ? "Step 1 of 2 · a card" : "Step 2 of 2 · your ring"}</p>
+      {calibrating || pxPerMm === null ? (
+        <CardCalibrate
+          initial={pxPerMm}
+          onDone={(value) => {
+            writePortal({ cardCal: { key, pxPerMm: value } });
+            setPxPerMm(value);
+            setCalibrating(false);
+          }}
+          onCancel={pxPerMm === null ? onCancel : () => setCalibrating(false)}
+          onOtherWay={onOtherWay}
+        />
+      ) : (
+        <Circle pxPerMm={pxPerMm} onKeep={onKeep} onRecalibrate={() => setCalibrating(true)} />
+      )}
+    </div>
+  );
+};
+
+export default RingSizer;
diff --git a/src/components/portal/SeedCeremony.tsx b/src/components/portal/SeedCeremony.tsx
new file mode 100644
index 0000000..161fed3
--- /dev/null
+++ b/src/components/portal/SeedCeremony.tsx
@@ -0,0 +1,216 @@
+import { useCallback, useLayoutEffect, useRef } from "react";
+import type { Stone } from "@/lib/portal/stones";
+import { FLOWER_ASPECT, FLOWER_BASE_X } from "@/lib/portal/brandFlower";
+import { EASE_BLOOM, EASE_IN, play, stillMotion } from "@/lib/portal/motion";
+import FlowerDraw, { drawFlower } from "./FlowerDraw";
+import { StonePlant } from "./StoneArt";
+import { burstPetals } from "./PetalBurst";
+import { PETAL_HUE, PETAL_SPARK } from "./PetalSymbols";
+
+/*
+  The seed ceremony, on her first visit to Your stone, and her stone is the
+  heart of it: a seed falls to where it will grow, the gold soil line runs
+  out from where it lands, the Naira flower draws itself small behind, and
+  her stone's bud rises at the front, beats twice like a heart, and opens
+  around the heart-cut stone in her month's colour with a glint and a few
+  petals. Skip is always there.
+
+  After the first time (or under reduced motion) the stage is simply drawn.
+  When she gives her birthday later, the bud opens then, in view, with its
+  petals: a bloom for something she did. Only for that (`celebrate`): a
+  profile that merely arrives late opens nothing.
+*/
+
+const W = 390;
+const H = 320;
+const SOIL = 282;
+const NAIRA = { x: 106, h: 150 };
+const STONE = { x: 222, h: 232 };
+const STONE_W = (STONE.h * 80) / 170;
+/* The head's centre in the stage: the head is the top 80 of the plant's 170. */
+const HEAD_Y = SOIL - STONE.h + (STONE.h * 40) / 170;
+const BURST_IDS = [PETAL_HUE, PETAL_SPARK, PETAL_HUE, PETAL_HUE, PETAL_SPARK, PETAL_HUE, PETAL_SPARK];
+
+const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
+
+type Props = {
+  stone: Stone | null;
+  playing: boolean;
+  onDone: () => void;
+  /** She has just given her birthday: open the bud when it arrives. */
+  celebrate?: boolean;
+};
+
+/** The bud beats twice, then opens: outer petals, inner petals, the heart, the glint. */
+const openHead = (root: HTMLElement | null, delay: number): Animation[] => {
+  if (!root) return [];
+  const beat = 380;
+  const at = delay + beat;
+  const out: (Animation | null)[] = [
+    play(
+      root.querySelector(".ig-stone-budcap"),
+      [
+        { opacity: 1, transform: "scale(1)" },
+        { opacity: 1, transform: "scale(1.06, 1.08)", offset: 0.22 },
+        { opacity: 1, transform: "scale(.97, .95)", offset: 0.42 },
+        { opacity: 1, transform: "scale(1.08, 1.1)", offset: 0.66 },
+        { opacity: 1, transform: "scale(1)", offset: 0.82 },
+        { opacity: 0, transform: "scale(1.3)" },
+      ],
+      { duration: beat + 160, delay, easing: "ease-in-out", fill: "backwards" },
+    ),
+    play(root.querySelector(".ig-stone-outer"), [{ transform: "scale(0) rotate(-70deg)" }, { transform: "none" }], { duration: 720, delay: at, easing: EASE_BLOOM, fill: "backwards" }),
+    play(root.querySelector(".ig-stone-inner"), [{ transform: "scale(0) rotate(50deg)" }, { transform: "none" }], { duration: 640, delay: at + 160, easing: EASE_BLOOM, fill: "backwards" }),
+    play(
+      root.querySelector(".ig-stone-heart"),
+      [{ transform: "scale(0)" }, { transform: "scale(1.15)", offset: 0.6 }, { transform: "scale(1)" }],
+      { duration: 420, delay: at + 260, easing: "ease-out", fill: "backwards" },
+    ),
+    play(
+      root.querySelector(".ig-glint"),
+      [
+        { opacity: 0, transform: "scale(0) rotate(0deg)" },
+        { opacity: 1, transform: "scale(1.5) rotate(45deg)", offset: 0.5 },
+        { opacity: 1, transform: "scale(1) rotate(90deg)" },
+      ],
+      { duration: 640, delay: at + 520, easing: "ease-out", fill: "backwards" },
+    ),
+  ];
+  return out.filter((a): a is Animation => Boolean(a));
+};
+
+/* Petals in her hue and a few gold sparks, from the opened head. */
+const burstFrom = (root: HTMLElement | null, stone: Stone, delay: number) =>
+  root
+    ? burstPetals(root, (STONE.x / W) * root.offsetWidth, (HEAD_Y / H) * root.offsetHeight, {
+        count: 14,
+        spread: 96,
+        delay,
+        ids: BURST_IDS,
+        color: stone.hue,
+        size: [10, 17],
+      })
+    : [];
+
+const SeedCeremony = ({ stone, playing, onDone, celebrate = false }: Props) => {
+  const rootRef = useRef<HTMLDivElement>(null);
+  const seedRef = useRef<HTMLDivElement>(null);
+  const nairaRef = useRef<HTMLDivElement>(null);
+  const stoneRef = useRef<HTMLDivElement>(null);
+  const anims = useRef<Animation[]>([]);
+  const timer = useRef(0);
+  const ended = useRef(!playing);
+  const hadStone = useRef(Boolean(stone));
+
+  const end = useCallback(() => {
+    if (ended.current) return;
+    ended.current = true;
+    window.clearTimeout(timer.current);
+    anims.current.forEach((a) => {
+      try {
+        a.finish();
+      } catch {
+        a.cancel();
+      }
+    });
+    onDone();
+  }, [onDone]);
+
+  useLayoutEffect(() => {
+    if (!playing) return;
+    ended.current = false;
+    const list: Animation[] = [];
+    anims.current = list;
+    const keep = (a: Animation | null) => a && list.push(a);
+    const root = rootRef.current;
+    keep(
+      play(
+        seedRef.current,
+        [
+          { transform: "translateY(-230px)", opacity: 0, easing: "cubic-bezier(.5,0,.9,.4)" },
+          { opacity: 1, offset: 0.12 },
+          { transform: "translateY(0)", offset: 0.7, easing: "ease-out" },
+          { transform: "translateY(-8px)", offset: 0.82, easing: EASE_IN },
+          { transform: "translateY(0)", opacity: 1, offset: 0.92 },
+          { transform: "translateY(4px) scale(.4)", opacity: 0 },
+        ],
+        { duration: 1250, delay: 150, fill: "both" },
+      ),
+    );
+    // The soil runs out both ways from where the seed lands.
+    root?.querySelectorAll(".ig-seed-soil").forEach((line) => keep(play(line, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 560, delay: 1000, easing: "ease-out", fill: "backwards" })));
+    list.push(...drawFlower(nairaRef.current, { delay: 1150, duration: 900 }));
+    keep(play(stoneRef.current, [{ transform: "scale(.2, 0)", opacity: 0 }, { transform: "none", opacity: 1 }], { duration: 640, delay: 1450, easing: EASE_BLOOM, fill: "backwards" }));
+    if (stone) {
+      list.push(...openHead(stoneRef.current, 2080));
+      list.push(...burstFrom(root, stone, 2700));
+    }
+    timer.current = window.setTimeout(end, stone ? 3600 : 2600);
+    return () => {
+      window.clearTimeout(timer.current);
+      if (!ended.current) {
+        ended.current = true;
+        list.forEach((a) => a.cancel());
+      }
+    };
+    // Played once, as mounted.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  // Her birthday given here and saved: the bud opens now, in view, before the frame paints.
+  useLayoutEffect(() => {
+    const was = hadStone.current;
+    hadStone.current = Boolean(stone);
+    if (!stone || was || !celebrate) return;
+    const root = rootRef.current;
+    if (!root) return;
+    root.dataset.bloomed = "";
+    if (stillMotion()) return;
+    const box = root.getBoundingClientRect();
+    const inView = box.top >= 0 && box.bottom <= window.innerHeight;
+    if (!inView) root.scrollIntoView?.({ block: "center", behavior: "smooth" });
+    const delay = inView ? 80 : 480;
+    const list = [...openHead(stoneRef.current, delay), ...burstFrom(root, stone, delay + 620)];
+    return () => list.forEach((a) => a.finish());
+  }, [stone, celebrate]);
+
+  const nairaW = NAIRA.h * FLOWER_ASPECT;
+  return (
+    <div ref={rootRef} className="ig-seed">
+      <svg viewBox={`0 0 ${W} ${H}`} className="ig-seed-ground" aria-hidden>
+        <path className="ig-seed-soil" d={`M${STONE.x} ${SOIL}H34`} pathLength={1} strokeDasharray="1 1" />
+        <path className="ig-seed-soil" d={`M${STONE.x} ${SOIL}H${W - 34}`} pathLength={1} strokeDasharray="1 1" />
+      </svg>
+      <div
+        className="ig-seed-naira"
+        ref={nairaRef}
+        style={{ left: pct(NAIRA.x - nairaW * FLOWER_BASE_X, W), top: pct(SOIL - 3 - NAIRA.h, H), width: pct(nairaW, W), height: pct(NAIRA.h, H) }}
+        aria-hidden
+      >
+        <FlowerDraw height={NAIRA.h} />
+      </div>
+      {playing && (
+        <div ref={seedRef} className="ig-seed-drop" style={{ left: pct(STONE.x - 6, W), top: pct(SOIL - 17, H) }} aria-hidden>
+          <svg viewBox="0 0 12 17">
+            <path d="M6 0C10 5 12 9 12 11.5A6 6 0 0 1 0 11.5C0 9 2 5 6 0Z" fill="var(--nf-blush)" stroke="var(--nf-accent-strong)" strokeWidth=".9" />
+          </svg>
+        </div>
+      )}
+      <div
+        ref={stoneRef}
+        className="ig-seed-stone"
+        style={{ left: pct(STONE.x - STONE_W / 2, W), top: pct(SOIL - STONE.h, H), width: pct(STONE_W, W), height: pct(STONE.h, H) }}
+        aria-hidden
+      >
+        <StonePlant stone={stone} />
+      </div>
+      {playing && (
+        <button type="button" className="ig-skip" onClick={end}>
+          Skip
+        </button>
+      )}
+    </div>
+  );
+};
+
+export default SeedCeremony;
diff --git a/src/components/portal/ShareCard.tsx b/src/components/portal/ShareCard.tsx
new file mode 100644
index 0000000..2731603
--- /dev/null
+++ b/src/components/portal/ShareCard.tsx
@@ -0,0 +1,199 @@
+import { useCallback, useEffect, useMemo, useRef, useState, type RefObject } from "react";
+import { primaryButton, quietButton } from "./styles";
+import { CARD_FILE, cardLayout, cardTexts, composeArtSvg, renderCard, shareMode, type CardInput } from "@/lib/portal/shareCard";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+
+/*
+  The card's renderer: a chunk of its own inside the card's room (with
+  lib/portal/shareCard), fetched once the room has painted. It draws the
+  1080 x 1920 PNG from the art on screen, lays it over the frame as the
+  preview (what she sees is the file she shares), and offers it:
+
+  - "Share your card", where the phone can share a file
+    (navigator.share({ files })); "Open the image" beside it, to save it
+    instead;
+  - otherwise, and always inside Instagram's or Facebook's own browser,
+    "Open the image": the picture on a view of its own, to press and hold
+    and save, with a way back.
+
+  It draws again (a moment after the last change) when she adds or takes
+  off her name or picks another flower. Drawing happens on a still page,
+  never during an animation; how long it took is kept on the picture
+  (data-ms) for the room's checks.
+*/
+
+type Props = {
+  /** The art on screen: her garden's SVG, or the pressed flower's. */
+  source: RefObject<SVGSVGElement>;
+  input: CardInput;
+};
+
+type Drawn = { url: string; blob: Blob; ms: number };
+
+const canShareFiles = (file: File): boolean => {
+  try {
+    return typeof navigator.share === "function" && typeof navigator.canShare === "function" && navigator.canShare({ files: [file] });
+  } catch {
+    return false;
+  }
+};
+
+const asDataUrl = (blob: Blob): Promise<string> =>
+  new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result));
+    reader.onerror = () => reject(reader.error);
+    reader.readAsDataURL(blob);
+  });
+
+/** The card in words, for a screen reader: what it shows, as drawn. */
+const describe = (input: CardInput): string => {
+  const t = cardTexts(input);
+  return ["Your garden card: the NAIRA wordmark, The Inner Garden", t.title, input.art === "flower" ? t.line ?? "a pressed flower" : "your garden", input.art === "garden" && t.line ? `${t.line}, in your month's colour` : null]
+    .filter(Boolean)
+    .join(", ");
+};
+
+const ShareCard = ({ source, input }: Props) => {
+  const [drawn, setDrawn] = useState<Drawn | null>(null);
+  const [failed, setFailed] = useState(false);
+  const [open, setOpen] = useState<string | null>(null);
+  const [note, setNote] = useState<string | null>(null);
+  const imgRef = useRef<HTMLImageElement>(null);
+  const openRef = useRef<HTMLHeadingElement>(null);
+  const backTo = useRef<HTMLButtonElement | null>(null);
+  const made = useRef<string | null>(null);
+  const key = JSON.stringify(input);
+
+  // Draw (again), a moment after the last change.
+  useEffect(() => {
+    let live = true;
+    const timer = window.setTimeout(async () => {
+      const art = source.current;
+      if (!art) return;
+      try {
+        const layout = cardLayout(input);
+        const defs = document.querySelector(".ig-sprite defs");
+        const svg = composeArtSvg(art, defs, layout.art.w, layout.art.h);
+        const { blob, ms } = await renderCard(input, svg);
+        if (!live) return;
+        if (made.current) URL.revokeObjectURL(made.current);
+        made.current = URL.createObjectURL(blob);
+        setDrawn({ url: made.current, blob, ms: Math.round(ms) });
+        setFailed(false);
+      } catch {
+        if (live) setFailed(true);
+      }
+    }, 120);
+    return () => {
+      live = false;
+      window.clearTimeout(timer);
+    };
+    // The input is read through its key.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [key, source]);
+
+  // Leaving the room lets the picture go.
+  useEffect(
+    () => () => {
+      if (made.current) URL.revokeObjectURL(made.current);
+    },
+    [],
+  );
+
+  // The finished picture settles over the frame.
+  useEffect(() => {
+    if (drawn && !stillMotion()) play(imgRef.current, [{ opacity: 0 }, { opacity: 1 }], { duration: 320, easing: EASE_REVEAL });
+  }, [drawn]);
+
+  const file = useMemo(() => (drawn ? new File([drawn.blob], CARD_FILE, { type: "image/png" }) : null), [drawn]);
+  const mode = useMemo(() => shareMode(navigator.userAgent, file ? canShareFiles(file) : false), [file]);
+
+  const openImage = useCallback(async (from: HTMLButtonElement | null) => {
+    if (!drawn) return;
+    backTo.current = from;
+    setNote(null);
+    try {
+      setOpen(await asDataUrl(drawn.blob));
+    } catch {
+      setOpen(drawn.url);
+    }
+  }, [drawn]);
+
+  const share = async (from: HTMLButtonElement | null) => {
+    if (!file) return;
+    setNote(null);
+    try {
+      await navigator.share({ files: [file], title: "My garden" });
+    } catch (error) {
+      // She closed the share sheet: nothing to say. Anything else: the picture, to save instead.
+      if ((error as Error | undefined)?.name === "AbortError") return;
+      await openImage(from);
+      setNote("This phone would not share the picture, so here it is to save instead.");
+    }
+  };
+
+  const close = useCallback(() => {
+    setOpen(null);
+    setNote(null);
+    window.setTimeout(() => backTo.current?.focus(), 0);
+  }, []);
+
+  useEffect(() => {
+    if (!open) return;
+    openRef.current?.focus();
+    const key = (e: KeyboardEvent) => {
+      if (e.key === "Escape") close();
+    };
+    document.addEventListener("keydown", key);
+    return () => document.removeEventListener("keydown", key);
+  }, [open, close]);
+
+  const alt = describe(input);
+
+  return (
+    <>
+      {drawn && <img ref={imgRef} className="ig-cardroom-png" src={drawn.url} alt={alt} data-ms={drawn.ms} width={1080} height={1920} />}
+      <div className="ig-cardroom-actions">
+        {failed ? (
+          <p className="ig-error" role="alert">
+            This phone could not draw the card. Try again in a moment.
+          </p>
+        ) : !drawn ? (
+          <p className="ig-cardroom-status" role="status">
+            Drawing your card…
+          </p>
+        ) : mode === "share" ? (
+          <>
+            <button type="button" className={primaryButton} onClick={(e) => void share(e.currentTarget)}>
+              Share your card
+            </button>
+            <button type="button" className={quietButton} onClick={(e) => void openImage(e.currentTarget)}>
+              Open the image
+            </button>
+          </>
+        ) : (
+          <button type="button" className={primaryButton} onClick={(e) => void openImage(e.currentTarget)}>
+            Open the image
+          </button>
+        )}
+        {note && !open && <p className="ig-fineprint">{note}</p>}
+      </div>
+      {open && (
+        <div className="ig-cardroom-open" role="dialog" aria-modal="true" aria-labelledby="ig-cardroom-open-h">
+          <h2 id="ig-cardroom-open-h" ref={openRef} tabIndex={-1} className="ig-h2">
+            Your garden card
+          </h2>
+          {note && <p className="ig-fineprint">{note}</p>}
+          <p className="ig-fineprint">Press and hold the picture, then choose to save it to your photos.</p>
+          <img className="ig-cardroom-big" src={open} alt={alt} width={1080} height={1920} />
+          <button type="button" className={quietButton} onClick={close}>
+            Back to your card
+          </button>
+        </div>
+      )}
+    </>
+  );
+};
+
+export default ShareCard;
