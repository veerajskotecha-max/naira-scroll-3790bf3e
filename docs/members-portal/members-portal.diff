+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import { useCart } from "@/contexts/CartContext";
+import type { Drop } from "@/lib/portal/drops";
+import { ballisticFlights, BURST_MS, MAX_BURST } from "@/lib/portal/petalPaths";
+import { BUD_CLOSED, BUD_OPEN, PAPER, mixHex } from "@/lib/portal/species";
+import { speciesIndex } from "@/lib/portal/dropPhase";
+import { BudGlyph } from "./FlowerGlyph";
+import { EASE_BLOOM, EASE_DRAWER, EASE_REVEAL, cue, play, settled, stillMotion, type Cue } from "@/lib/portal/motion";
+import DropBox from "./DropBox";
+import { PEEK_POSE, REST_POSE, drawerTransforms, poseTransform } from "@/lib/portal/boxPose";
+import { PETAL_HUE, PETAL_SPARK } from "./PetalSymbols";
+import { quietButton } from "./styles";
+import BloomField, { FIELD_WAIT_MS } from "./BloomField";
+import { choreographyNow, spectacleAllowed, type Choreography } from "@/lib/portal/spectacle";
+import { probeWanted } from "@/lib/portal/tier";
+
+/*
+  THE UNBOXING, once per drop on this device. It opens on the bud she has
+  watched on the Bloom Clock, four petals open: the last one turns out, the
+  bud gives way, and the Naira box rises where it stood. The box turns to
+  face her, its drawer slides out, the drop's lead piece rises from the velvet and
+  a glint crosses it; at the same moment up to 24 flat petals in the drop's
+  colour (three of them gold glints) are thrown up out of the drawer on
+  worked-out arcs and are gone by 1.6 s. Then the pieces unfold below (the
+  room staggers them 60 ms apart; they were laid out, hidden, before the box
+  turned, so nothing below moves and no render lands mid-burst).
+
+  On a Tier 2 phone (lib/portal/tier) two things join it, neither moving
+  any of the above: the Bloom Field, a 6 s fall of the brand's flower in
+  the drop's colour over the screen (components/portal/BloomField), and,
+  once the drop room's gsap choreography is in (lib/portal/unboxGsap), the
+  petals thrown under Physics2D instead of on worked-out arcs, at the same
+  moment, as many, gone by the same 1.6 s (if it is still on its way as the
+  box starts, the petals are made as ever and which hand throws them is
+  settled 0.2 s before the burst, and their sweep is timed from that throw).
+  The field is prepared before anything moves: the opening holds its first
+  move until it is ready, for at most FIELD_WAIT_MS (the stage is still
+  empty then), so its setup never lands mid-opening. Without either (Tier
+  1, reduced motion, a chunk that did not arrive) it is exactly as above,
+  with no wait.
+
+  Every animation, petals included, is made at once when the page has
+  settled and starts on its own delay, so nothing is built mid-flight. At
+  the end the box is redrawn open first and the animations are let go only
+  after that commit, so not one frame shows it shut again. A tap on Skip
+  ends it at once. Under reduced motion, or on a later visit, the box is
+  simply open.
+*/
+
+type Props = {
+  drop: Drop;
+  /** The cut-out (drop.cutoutUrl) or the lead piece's shop photo. */
+  piece?: { src: string; cutout: boolean };
+  /** Play the ritual (first visit, motion allowed); otherwise the box is shown open. */
+  ritual: boolean;
+  /** The pieces may unfold now. */
+  onUnfold: () => void;
+  size?: number;
+};
+
+const SVG = "http://www.w3.org/2000/svg";
+
+/* When each part of the ritual starts, in ms from the start: the bud's last petal, then the box. */
+const BUD = { petal: 120, out: 560 };
+const PRE = 650;
+/* On Tier 2 with the choreography still arriving, the petals' hand is chosen this long before the burst. */
+const PETAL_LEAD = 200;
+const AT = { turn: PRE + 200, drawer: PRE + 850, rise: PRE + 1250, glint: PRE + 1950, petals: PRE + 1900, unfold: PRE + 2300, rest: PRE + 3500 };
+
+/* While the Bloom Field lives: the bag opening over it ends the fall (its slide-in is the moment that matters). */
+const BagOpens = ({ onOpen }: { onOpen: () => void }) => {
+  const { isDrawerOpen } = useCart();
+  useEffect(() => {
+    if (isDrawerOpen) onOpen();
+  }, [isDrawerOpen, onOpen]);
+  return null;
+};
+
+const DropUnbox = ({ drop, piece, ritual, onUnfold, size = 156 }: Props) => {
+  // Where the Web Animations API is missing (an old WebView) the box is simply open: nothing would move.
+  const [playing, setPlaying] = useState(() => ritual && !stillMotion() && typeof document.documentElement.animate === "function");
+  // The Bloom Field rides with the ritual on a Tier 2 phone, and outlasts it (its fall is 6 s).
+  const [field, setField] = useState(() => playing && spectacleAllowed());
+  const [skipped, setSkipped] = useState(false);
+  // The opening has begun (after the field's preparation, or without it): the fall starts with it, told in the same task.
+  const fieldGo = useRef<() => void>(() => {});
+  const [bagOpened, setBagOpened] = useState(false);
+  const onBagOpen = useCallback(() => setBagOpened(true), []);
+  // The field's word that it is ready (or gone): the opening's hold lets go.
+  const fieldReady = useRef<() => void>(() => {});
+  const fieldSaid = useRef(false);
+  const releaseHold = useCallback(() => {
+    fieldSaid.current = true;
+    fieldReady.current();
+  }, []);
+  const parts = {
+    lift: useRef<HTMLDivElement>(null),
+    box: useRef<HTMLDivElement>(null),
+    gleam: useRef<HTMLDivElement>(null),
+    riser: useRef<HTMLDivElement>(null),
+    glint: useRef<HTMLDivElement>(null),
+    rule: useRef<SVGRectElement>(null),
+    front: useRef<HTMLDivElement>(null),
+    tray: useRef<HTMLDivElement>(null),
+    left: useRef<HTMLDivElement>(null),
+    right: useRef<HTMLDivElement>(null),
+  };
+  const stage = useRef<HTMLDivElement>(null);
+  const petalLayer = useRef<HTMLDivElement>(null);
+  const budRef = useRef<HTMLDivElement>(null);
+  const flights = useMemo(() => ballisticFlights(MAX_BURST, { seed: drop.id, spread: size * 0.95, lift: size * 1.15 }), [drop.id, size]);
+  const unfold = useRef(onUnfold);
+  unfold.current = onUnfold;
+  const end = useRef<() => void>(() => {});
+  // Held past the ritual's end until the open box is committed (see below).
+  const anims = useRef<Animation[]>([]);
+  const petals = useRef<Element[]>([]);
+  const thrown = useRef<(() => void) | null>(null);
+  const letGo = () => {
+    anims.current.forEach((a) => a.cancel());
+    thrown.current?.();
+    petals.current.forEach((p) => p.remove());
+    anims.current = [];
+    petals.current = [];
+    thrown.current = null;
+  };
+
+  // The box is drawn open now: only then are the animations holding it open let go.
+  useLayoutEffect(() => {
+    if (!playing) letGo();
+    // While the bud has the stage, the box waits unseen (its rise holds it from then on).
+    const box = stage.current?.querySelector<HTMLElement>(".ig-box");
+    if (box) box.style.opacity = playing ? "0" : "";
+  }, [playing]);
+
+  useEffect(() => {
+    if (!playing) {
+      unfold.current();
+      return;
+    }
+    let alive = true;
+    const cues: Cue[] = [];
+    let unfolded = false;
+    const letUnfold = () => {
+      if (unfolded) return;
+      unfolded = true;
+      unfold.current();
+    };
+    const finish = () => {
+      if (!alive) return;
+      alive = false;
+      cues.forEach((c) => c.cancel());
+      letUnfold();
+      setPlaying(false);
+    };
+    end.current = finish;
+
+    const run = (el: Element | null, keyframes: Keyframe[], options: KeyframeAnimationOptions) => {
+      const a = play(el, keyframes, { fill: "both", ...options });
+      if (a) anims.current.push(a);
+      return a;
+    };
+
+    // On Tier 2, held (the stage still) until the field is prepared, or FIELD_WAIT_MS.
+    let holdTimer = 0;
+    const hold = field
+      ? new Promise<void>((resolve) => {
+          fieldReady.current = resolve;
+          if (fieldSaid.current) resolve();
+          // The development preview's &probe=0 (a software-GL machine) waits for it, so its look can be seen.
+          holdTimer = window.setTimeout(resolve, probeWanted() ? FIELD_WAIT_MS : 15_000);
+        })
+      : null;
+    Promise.all([settled(), hold]).then(() => {
+      window.clearTimeout(holdTimer);
+      if (!alive) return;
+      if (field) fieldGo.current();
+      // The bud from the Bloom Clock: its last petal turns out and takes its colour, then it gives way to the box.
+      const bud = budRef.current;
+      const last = bud?.querySelector('.ig-bud-petal[data-k="4"]') ?? null;
+      const budMs = BUD.out + 420;
+      run(
+        bud,
+        [
+          { offset: 0, opacity: 0, transform: "scale(.94)" },
+          { offset: 160 / budMs, opacity: 1, transform: "scale(1)" },
+          { offset: BUD.out / budMs, opacity: 1, transform: "scale(1)", easing: EASE_REVEAL },
+          { offset: 1, opacity: 0, transform: "scale(.6)" },
+        ],
+        { duration: budMs, easing: "linear" },
+      );
+      run(last, [{ transform: BUD_CLOSED[4] }, { transform: BUD_OPEN[4] }], { duration: 520, delay: BUD.petal, easing: EASE_BLOOM, fill: "backwards" });
+      run(last?.querySelector(".ig-bud-colour") ?? null, [{ opacity: 0 }, { opacity: 1 }], { duration: 420, delay: BUD.petal + 100, easing: EASE_REVEAL, fill: "backwards" });
+      run(bud?.querySelector(".ig-bud-core") ?? null, [{ opacity: 0, transform: "scale(0)" }, { opacity: 1, transform: "scale(1)" }], { duration: 420, delay: BUD.petal + 260, easing: EASE_BLOOM, fill: "backwards" });
+      run(stage.current?.querySelector(".ig-box") ?? null, [{ opacity: 0, transform: "translateY(24px)" }, { opacity: 1, transform: "translateY(0)" }], { duration: 520, delay: BUD.out + 60, easing: EASE_REVEAL });
+      run(parts.box.current, [{ transform: poseTransform(REST_POSE) }, { transform: poseTransform(PEEK_POSE) }], { duration: 800, delay: AT.turn, easing: EASE_REVEAL });
+      const shut = drawerTransforms(size, 0);
+      const out = drawerTransforms(size, 1);
+      (["front", "tray", "left", "right"] as const).forEach((k) =>
+        run(parts[k].current, [{ transform: shut[k] }, { transform: out[k] }], { duration: 560, delay: AT.drawer, easing: EASE_DRAWER }),
+      );
+      run(parts.riser.current, [{ transform: "translateY(100%)" }, { transform: "translateY(0%)" }], { duration: 760, delay: AT.rise, easing: EASE_REVEAL });
+      run(parts.glint.current, [{ opacity: 0, transform: "scale(.2) rotate(0deg)" }, { opacity: 1, transform: "scale(1) rotate(45deg)", offset: 0.4 }, { opacity: 0, transform: "scale(.3) rotate(90deg)" }], { duration: 720, delay: AT.glint, easing: "ease-out", fill: "none" });
+      run(parts.gleam.current, [{ transform: "translateX(-160%) skewX(-18deg)" }, { transform: "translateX(330%) skewX(-18deg)" }], { duration: 900, delay: AT.glint + 200, easing: "cubic-bezier(0.45, 0, 0.2, 1)", fill: "none" });
+      run(parts.lift.current, [{ transform: "translateY(0)" }, { transform: `translateY(${-size * 0.05}px)` }, { transform: "translateY(0)" }], { duration: 1400, delay: AT.rise, easing: "ease-in-out", fill: "none" });
+      // A shop photo rises as a framed specimen: its inner gold rule draws once it is up.
+      run(parts.rule.current, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 700, delay: AT.rise + 560, easing: EASE_REVEAL });
+
+      // The petals, thrown from the open drawer: made now, each on its own delay.
+      const layer = petalLayer.current;
+      if (layer) {
+        const tint = mixHex(drop.accent, PAPER, 0.45);
+        const petal = (i: number, size: number, tone: 0 | 1) => {
+          const svg = document.createElementNS(SVG, "svg");
+          svg.setAttribute("viewBox", "0 0 20 20");
+          svg.setAttribute("aria-hidden", "true");
+          svg.setAttribute("class", "ig-petal");
+          svg.style.cssText = `left:50%;top:58%;width:${size}px;height:${size}px;opacity:0;color:${tone ? tint : drop.accent}`;
+          const use = document.createElementNS(SVG, "use");
+          // Three in every 24 are gold glints: jewellery, not confetti.
+          use.setAttribute("href", `#${i % 8 === 3 ? PETAL_SPARK : PETAL_HUE}`);
+          svg.appendChild(use);
+          layer.appendChild(svg);
+          petals.current.push(svg);
+          return svg;
+        };
+        // Today's arcs, `delay` ms from now, on the petals given (or made now).
+        const arcs = (nodes: readonly Element[] | null, delay: number) =>
+          flights.forEach((f, i) => {
+            const svg = nodes?.[i] ?? petal(i, f.size, f.tone);
+            const a = play(svg, f.keyframes, { duration: f.duration, delay: delay + f.delay, easing: "linear", fill: "both" });
+            if (a) {
+              anims.current.push(a);
+              a.onfinish = () => svg.remove();
+            }
+          });
+        // Tier 2, its choreography in: the same throw under Physics2D (today's arcs if it declines).
+        const throwWith = (choreo: Choreography, nodes: readonly Element[] | null, delay: number) => {
+          const throws = choreo.physicsThrows(nodes?.length ?? MAX_BURST, { seed: drop.id, spread: size * 0.95, lift: size * 1.15 });
+          const made = nodes ?? throws.map((t, i) => petal(i, t.size, t.tone));
+          thrown.current = choreo.throwPetals(made, throws, delay);
+          if (!thrown.current) arcs(made, delay);
+        };
+        // Whatever is left is gone 1.6 s after the burst: timed from the throw itself, so a late throw still flies in full.
+        const sweep = (after: number) => cues.push(cue(stage.current, after, () => petals.current.forEach((p) => p.remove())));
+        const choreo = choreographyNow();
+        if (choreo) {
+          throwWith(choreo, null, AT.petals);
+          sweep(AT.petals + BURST_MS);
+        } else if (spectacleAllowed()) {
+          // Tier 2, its choreography still on its way: the petals are made now, unseen, and which hand throws them is settled just before the burst.
+          const nodes = flights.map((f, i) => petal(i, f.size, f.tone));
+          cues.push(
+            cue(stage.current, AT.petals - PETAL_LEAD, () => {
+              if (!alive) return;
+              const late = choreographyNow();
+              if (late) throwWith(late, nodes, PETAL_LEAD);
+              else arcs(nodes, PETAL_LEAD);
+              sweep(PETAL_LEAD + BURST_MS);
+            }),
+          );
+        } else {
+          arcs(null, AT.petals);
+          sweep(AT.petals + BURST_MS);
+        }
+      }
+      cues.push(cue(stage.current, AT.unfold, letUnfold));
+      cues.push(cue(stage.current, AT.rest, finish));
+    });
+
+    return () => {
+      alive = false;
+      window.clearTimeout(holdTimer);
+      cues.forEach((c) => c.cancel());
+      letGo();
+    };
+    // Once, when the room opens on it.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const open = !playing;
+  return (
+    <div ref={stage} className={`ig-unbox${playing ? " is-playing" : ""}`}>
+      <div className="ig-unbox-stage" style={{ width: size * 1.75, height: size * 1.55 }}>
+        <DropBox size={size} pose={open ? PEEK_POSE : REST_POSE} open={open ? 1 : 0} raised={open} piece={piece} parts={parts} />
+        {playing && (
+          <div ref={budRef} aria-hidden style={{ position: "absolute", left: 0, right: 0, top: size * 0.06, display: "flex", justifyContent: "center", transformOrigin: "50% 60%", pointerEvents: "none", opacity: 0 }}>
+            <BudGlyph species={speciesIndex(drop.species)} accent={drop.accent} open={5} size={size * 0.72} />
+          </div>
+        )}
+        <div ref={petalLayer} className="ig-unbox-petals" aria-hidden />
+      </div>
+      {playing && (
+        <button
+          type="button"
+          className={`${quietButton} ig-unbox-skip`}
+          onClick={() => {
+            setSkipped(true);
+            end.current();
+            // The button goes with the ritual: her focus goes on to the pieces, never to the page's top.
+            document.getElementById("ig-pieces")?.focus({ preventScroll: true });
+          }}
+        >
+          Skip
+        </button>
+      )}
+      {field && (
+        <BloomField
+          accent={drop.accent}
+          seed={drop.id}
+          anchor={stage}
+          go={fieldGo}
+          stop={skipped || bagOpened}
+          onReady={releaseHold}
+          onGone={() => {
+            releaseHold();
+            setField(false);
+          }}
+        />
+      )}
+      {field && <BagOpens onOpen={onBagOpen} />}
+    </div>
+  );
+};
+
+export default DropUnbox;
