@@ -0,0 +1,62 @@
+import { cleanup, render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+/*
+  /account's "My jewel box" counts what her Jewel drawer keeps too: the
+  hearts on this phone, and the pieces saved to her account (on another
+  phone) that this one has no heart for, with the way to her drawer.
+  Supabase is a stand-in; nothing reaches the live project.
+*/
+
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => <footer /> }));
+const state = vi.hoisted(() => ({
+  member: {
+    user: { id: "u-ananya", email: "ananya.r@example.com", user_metadata: { full_name: "Ananya", naira: { v: 1, saved: ["a-ring", "b-studs", "c-chain"] } } },
+    profile: { id: "u-ananya", full_name: "Ananya", phone: null, birthday: null, city: null, ad_matching_consent: false },
+    loading: false,
+    session: null,
+    refreshProfile: async () => {},
+    signOut: async () => {},
+  },
+  wishlist: { items: [{ id: "a-ring", name: "A ring", price: "x", image: "" }], totalItems: 1, setDrawerOpen: () => {} },
+}));
+vi.mock("@/contexts/AuthContext", () => ({ useAuth: () => state.member }));
+vi.mock("@/contexts/WishlistContext", () => ({ useWishlist: () => state.wishlist }));
+vi.mock("@/integrations/supabase/client", () => ({
+  supabase: { from: () => ({ select: () => ({ order: async () => ({ data: [], error: null }) }) }) },
+}));
+
+import Account from "./Account";
+
+const open = () =>
+  render(
+    <MemoryRouter>
+      <Account />
+    </MemoryRouter>,
+  );
+
+afterEach(cleanup);
+
+describe("My jewel box", () => {
+  it("counts the hearts here and the pieces her account keeps from another phone, and leads to her drawer", () => {
+    open();
+    expect(screen.getByText("1 piece is waiting in your box. 2 more pieces saved on your account are in your Jewel drawer.")).toBeInTheDocument();
+    expect(screen.getByRole("link", { name: "YOUR JEWEL DRAWER →" })).toHaveAttribute("href", "/members/drawer");
+  });
+
+  it("says only what is there when every saved piece is hearted here", () => {
+    state.wishlist = { ...state.wishlist, items: ["a-ring", "b-studs", "c-chain"].map((id) => ({ id, name: id, price: "x", image: "" })), totalItems: 3 };
+    open();
+    expect(screen.getByText("3 pieces are waiting in your box.")).toBeInTheDocument();
+    expect(screen.queryByRole("link", { name: /JEWEL DRAWER/ })).toBeNull();
+  });
+
+  it("counts her drawer on a phone with no hearts at all", () => {
+    state.wishlist = { ...state.wishlist, items: [], totalItems: 0 };
+    open();
+    expect(screen.getByText("3 pieces saved on your account are in your Jewel drawer.")).toBeInTheDocument();
+    expect(screen.queryByText(/Nothing saved yet/)).toBeNull();
+  });
+});
diff --git a/src/pages/Auth.test.tsx b/src/pages/Auth.test.tsx
new file mode 100644
index 0000000..0db4a6b
--- /dev/null
+++ b/src/pages/Auth.test.tsx
@@ -0,0 +1,343 @@
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/*
+  Sign-in hardening (Phase 3). Supabase is mocked throughout: nothing here
+  reaches the live project. The page is read the way a member meets it, at
+  the address her email link opened.
+*/
+
+const SESSION_USER = { id: "u-1", email: "ananya.r@example.com", user_metadata: {} };
+const SESSION = { user: SESSION_USER, access_token: "t" };
+
+const auth = vi.hoisted(() => ({
+  state: {
+    session: null as unknown,
+    user: null as unknown,
+    profile: null as unknown,
+    loading: false,
+    refreshProfile: vi.fn(async () => {}),
+    signOut: async () => {},
+  },
+}));
+vi.mock("@/contexts/AuthContext", () => ({ useAuth: () => auth.state }));
+
+const sb = vi.hoisted(() => {
+  const listeners: ((event: string, session: unknown) => void)[] = [];
+  return {
+    listeners,
+    onAuthStateChange: vi.fn((cb: (event: string, session: unknown) => void) => {
+      listeners.push(cb);
+      return { data: { subscription: { unsubscribe: () => listeners.splice(listeners.indexOf(cb), 1) } } };
+    }),
+    signUp: vi.fn(),
+    signInWithPassword: vi.fn(),
+    resetPasswordForEmail: vi.fn(),
+    updateUser: vi.fn(),
+    signInWithOtp: vi.fn(),
+    verifyOtp: vi.fn(),
+    upsert: vi.fn(async () => ({ error: null })),
+    maybeSingle: vi.fn(async () => ({ data: null, error: null })),
+  };
+});
+vi.mock("@/integrations/supabase/client", () => ({
+  supabase: {
+    auth: {
+      onAuthStateChange: sb.onAuthStateChange,
+      signUp: sb.signUp,
+      signInWithPassword: sb.signInWithPassword,
+      resetPasswordForEmail: sb.resetPasswordForEmail,
+      updateUser: sb.updateUser,
+      signInWithOtp: sb.signInWithOtp,
+      verifyOtp: sb.verifyOtp,
+    },
+    from: () => ({ upsert: sb.upsert, select: () => ({ eq: () => ({ maybeSingle: sb.maybeSingle }) }) }),
+  },
+}));
+vi.mock("@/integrations/lovable/index", () => ({ lovable: { auth: { signInWithOAuth: vi.fn() } } }));
+const pixel = vi.hoisted(() => ({ trackPixel: vi.fn() }));
+vi.mock("@/lib/pixel", () => pixel);
+const list = vi.hoisted(() => ({ joinInnerCircle: vi.fn(async () => ({ ok: true, already: false })) }));
+vi.mock("@/lib/innerCircle", () => list);
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => <footer /> }));
+
+import Auth from "./Auth";
+
+const tree = (path: string) => (
+  <MemoryRouter initialEntries={[path]}>
+    <Routes>
+      <Route path="/auth" element={<Auth />} />
+      <Route path="/members" element={<p>members room</p>} />
+      <Route path="/account" element={<p>account room</p>} />
+    </Routes>
+  </MemoryRouter>
+);
+
+const visit = (path: string) => {
+  window.history.replaceState(null, "", path);
+  const view = render(tree(path));
+  /* AuthContext re-rendering its consumers, as the real provider does when
+     the session changes (the mock's state is read on every render). */
+  return { ...view, contextChanged: () => view.rerender(tree(path)) };
+};
+
+const type = (label: string, value: string) => fireEvent.change(screen.getByLabelText(label), { target: { value } });
+const heading = () => screen.getByRole("heading", { level: 1 }).textContent;
+
+beforeEach(() => {
+  auth.state = { ...auth.state, session: null, user: null, profile: null, loading: false, refreshProfile: vi.fn(async () => {}) };
+  sb.listeners.length = 0;
+  for (const fn of [sb.signUp, sb.signInWithPassword, sb.resetPasswordForEmail, sb.updateUser, sb.signInWithOtp, sb.verifyOtp]) fn.mockReset();
+  sb.upsert.mockClear();
+  sb.maybeSingle.mockReset();
+  sb.maybeSingle.mockResolvedValue({ data: null, error: null });
+  pixel.trackPixel.mockClear();
+  list.joinInnerCircle.mockClear();
+});
+afterEach(() => {
+  cleanup();
+  window.history.replaceState(null, "", "/");
+});
+
+describe("a password-reset link", () => {
+  it("lands on the new-password form, not on ?next=, when the address carries our mark", () => {
+    auth.state = { ...auth.state, session: SESSION, user: SESSION_USER };
+    visit("/auth?recovery=1&next=%2Fmembers");
+    expect(heading()).toBe("Choose a new password.");
+    expect(screen.getByLabelText("New password")).toBeInTheDocument();
+    expect(screen.queryByText("members room")).toBeNull();
+  });
+
+  it("turns to the new-password form on PASSWORD_RECOVERY, before the hop to ?next= can fire", () => {
+    const page = visit("/auth?next=%2Fmembers");
+    expect(heading()).toBe("Welcome back.");
+    expect(sb.onAuthStateChange).toHaveBeenCalled();
+    // AuthContext takes the session in the same moment Supabase names the event.
+    act(() => {
+      auth.state = { ...auth.state, session: SESSION, user: SESSION_USER };
+      for (const listener of [...sb.listeners]) listener("PASSWORD_RECOVERY", SESSION);
+      page.contextChanged();
+    });
+    expect(heading()).toBe("Choose a new password.");
+    expect(screen.getByLabelText("New password")).toBeInTheDocument();
+    expect(screen.queryByText("members room")).toBeNull();
+  });
+
+  it("still sends an ordinary sign-in on to ?next=", async () => {
+    const page = visit("/auth?next=%2Fmembers");
+    act(() => {
+      auth.state = { ...auth.state, session: SESSION, user: SESSION_USER };
+      for (const listener of [...sb.listeners]) listener("SIGNED_IN", SESSION);
+      page.contextChanged();
+    });
+    expect(await screen.findByText("members room")).toBeInTheDocument();
+  });
+
+  it("checks the new password, shows it on request, and saves it with updateUser", async () => {
+    auth.state = { ...auth.state, session: SESSION, user: SESSION_USER };
+    sb.updateUser.mockResolvedValue({ data: { user: SESSION_USER }, error: null });
+    visit("/auth?recovery=1&next=%2Fmembers");
+
+    type("New password", "abc");
+    type("New password, again", "abc");
+    fireEvent.click(screen.getByRole("button", { name: /save my new password/i }));
