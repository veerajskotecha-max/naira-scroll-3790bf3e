+                  href={WHATSAPP_URL}
+                  target="_blank"
+                  rel="noopener noreferrer"
+                  onClick={handOff(() => preorderWhatsAppUrl({ name: piece.name, handle: piece.handle, priceLabel: price !== undefined ? rupees(price) : undefined, choice: name }))}
