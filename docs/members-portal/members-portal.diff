+}
+.ig-curtain { position: absolute; inset: 0; background: var(--nf-sage); will-change: transform; }
+.ig-tassel { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); }
+.ig-doors-stage {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 1.1rem;
+  padding: 96px 16px 0;
+}
+.ig-doors-stage { will-change: transform; }
+.ig-doors .ig-gate { width: min(84vw, 380px); perspective: 900px; }
+.ig-doors .ig-leaf { will-change: transform, opacity; }
+/* The flower draws at full size, then rests in the latch at .38, a key. */
+.ig-doors-key {
