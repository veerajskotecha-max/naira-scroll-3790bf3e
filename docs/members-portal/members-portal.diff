+++ b/src/lib/portal/stoneLight.test.ts
@@ -0,0 +1,236 @@
+import { describe, expect, it } from "vitest";
+import {
+  CENTRE,
+  EDGE,
+  GIRDLE_POINTS,
+  MAX_LIGHT_PETALS,
+  POSES,
+  REST,
+  SETTLE_MS,
+  SWEEP_MS,
+  cut,
+  dot,
+  dragToLight,
+  facetLight,
+  facetOpacities,
+  girdle,
+  glintAt,
+  keyToLight,
+  lightDir,
+  lowPass,
+  nextPose,
+  petalPlan,
+  petalPose,
+  pointsAttr,
+  restingAfter,
+  settleAt,
+  sweepAt,
+  tiltToLight,
+} from "./stoneLight";
+
+/* Stone Light's model: the heart's own outline cut into 24 to 36 facets,
+   light that facets catch one by one, petals that stay inside the panel
+   at every angle, and the inputs (drag, keys, tilt) as light. */
+
+const lights = Array.from({ length: 41 }, (_, i) => ({ x: -1 + i * 0.05, y: Math.sin(i) * 1 }));
+
+describe("the cut", () => {
+  it("samples the heart's own outline from its point, the cleft halfway round", () => {
+    const g = girdle();
+    expect(g).toHaveLength(GIRDLE_POINTS);
+    expect(g[0][0]).toBeCloseTo(12, 5);
+    expect(g[0][1]).toBeCloseTo(20.5, 5);
+    // The outline is symmetric, so halfway round by arc length is the cleft (12, 4.6).
+    expect(g[8][0]).toBeCloseTo(12, 1);
+    expect(g[8][1]).toBeCloseTo(4.6, 1);
+    // Mirror pairs: the left lobe's points mirror the right's.
+    for (let k = 1; k < 8; k++) {
+      expect(g[k][0] + g[16 - k][0]).toBeCloseTo(24, 1);
+      expect(g[k][1]).toBeCloseTo(g[16 - k][1], 1);
+    }
+  });
+
+  it("has one table, eight stars, eight kites and sixteen upper girdle facets: 33, between 24 and 36", () => {
+    const { facets } = cut();
+    expect(facets.length).toBeGreaterThanOrEqual(24);
+    expect(facets.length).toBeLessThanOrEqual(36);
+    const kinds = facets.reduce<Record<string, number>>((n, f) => ({ ...n, [f.kind]: (n[f.kind] ?? 0) + 1 }), {});
+    expect(kinds).toEqual({ table: 1, star: 8, kite: 8, girdle: 16 });
+  });
+
+  it("gives every facet a unit normal facing her, the table's straight at her and the crown's leaning out", () => {
+    for (const f of cut().facets) {
+      expect(Math.hypot(...f.normal)).toBeCloseTo(1, 6);
+      expect(f.normal[2]).toBeGreaterThan(0);
+      if (f.kind === "table") expect(f.normal).toEqual([0, 0, 1]);
+      else {
+        // A crown facet leans out from the stone's centre, toward its own side.
+        const cx = f.points.reduce((s, p) => s + p[0], 0) / f.points.length - CENTRE[0];
+        const cy = CENTRE[1] - f.points.reduce((s, p) => s + p[1], 0) / f.points.length;
+        expect(f.normal[0] * cx + f.normal[1] * cy).toBeGreaterThan(0);
+        expect(f.normal[2]).toBeLessThan(0.99);
+      }
+    }
+  });
+
+  it("stays inside the heart's box, with four claws and a pavilion seen through the table", () => {
+    const { facets, claws, pavilion } = cut();
+    for (const f of facets) for (const [x, y] of f.points) expect(x >= 0 && x <= 24 && y >= 0 && y <= 22).toBe(true);
+    expect(claws).toHaveLength(4);
+    expect(pavilion.length).toBeGreaterThan(4);
+    expect(pointsAttr([[1, 2.345]])).toBe("1.00,2.35");
+  });
+});
+
+describe("the light", () => {
+  it("is a unit direction, high in front of her as it passes, swinging with x and y", () => {
+    const d = lightDir({ x: 0, y: 0 });
+    expect(Math.hypot(...d)).toBeCloseTo(1, 9);
+    expect(d[0]).toBeCloseTo(0, 9);
+    expect(d[2]).toBeGreaterThan(0.95);
+    expect(lightDir({ x: 1, y: 0 })[0]).toBeGreaterThan(0.7);
+    expect(lightDir({ x: 0, y: 1 })[1]).toBeGreaterThan(0.5);
+    // Held at the ends of its swing.
+    expect(lightDir({ x: 3, y: 0 })).toEqual(lightDir({ x: 1, y: 0 }));
+  });
+
+  it("lights the table when it faces her, and lets it go as it turns", () => {
+    expect(facetLight([0, 0, 1], { x: 0, y: 0 })).toBeGreaterThan(0.5);
+    expect(facetLight([0, 0, 1], { x: 1, y: 0 })).toBeLessThan(0.2);
+  });
+
+  it("makes facets catch and lose it one by one as it swings: each peaks somewhere, and they peak at different angles", () => {
+    const peaks = cut().facets.map((f) => {
+      let best = -2;
+      let at = 0;
+      for (const l of lights) {
+        const v = facetLight(f.normal, { x: l.x, y: 0 });
+        if (v > best) [best, at] = [v, l.x];
+      }
+      return { best, at };
+    });
+    const bright = peaks.filter((p) => p.best > 0.5);
+    expect(bright.length).toBeGreaterThan(8);
+    expect(new Set(bright.map((p) => p.at.toFixed(2))).size).toBeGreaterThan(4);
+    for (const l of lights) for (const v of facetOpacities(l)) expect(v >= 0 && v <= 0.92).toBe(true);
+  });
+
+  it("slides the glint across the table with the light", () => {
+    const left = glintAt({ x: -1, y: 0 });
+    const right = glintAt({ x: 1, y: 0 });
+    expect(right.x).toBeGreaterThan(left.x);
+    const table = cut().table;
+    for (const g of [left, right]) {
+      expect(g.x).toBeGreaterThan(Math.min(...table.map((p) => p[0])));
+      expect(g.x).toBeLessThan(Math.max(...table.map((p) => p[0])));
+      expect(g.opacity).toBeGreaterThan(0);
+      expect(g.opacity).toBeLessThanOrEqual(1);
+    }
+  });
+});
+
+describe("the light petals", () => {
+  it("are at most 18 flowers and hearts in four tones, the same on every phone", () => {
+    const plan = petalPlan();
+    expect(plan).toHaveLength(MAX_LIGHT_PETALS);
+    expect(petalPlan(40)).toHaveLength(MAX_LIGHT_PETALS);
+    expect(petalPlan()).toEqual(plan);
+    expect(new Set(plan.map((p) => p.kind))).toEqual(new Set(["flower", "heart"]));
+    expect(new Set(plan.map((p) => p.tone))).toEqual(new Set([0, 1, 2, 3]));
+  });
+
+  it("skate the other way from the light, turning as they go", () => {
+    for (const p of petalPlan()) {
+      const a = petalPose(p, { x: -1, y: 0 });
+      const b = petalPose(p, { x: 1, y: 0 });
+      expect(b.x).toBeLessThan(a.x);
+      expect(b.rot).not.toBe(a.rot);
+    }
+  });
+
+  it("keep every petal's box inside the panel at every light, turned any way", () => {
+    const aspect = 380 / 358;
+    for (const p of petalPlan()) {
+      // A turned square's box is at most √2 its side.
+      const half = (p.size * Math.SQRT2) / 2;
+      for (const l of [...lights, { x: -1, y: -1 }, { x: 1, y: 1 }, { x: -1, y: 1 }, { x: 1, y: -1 }]) {
+        const at = petalPose(p, l);
+        expect(at.x - half).toBeGreaterThanOrEqual(EDGE / 4);
+        expect(at.x + half).toBeLessThanOrEqual(1 - EDGE / 4);
+        expect(at.y - half / aspect).toBeGreaterThanOrEqual(0);
+        expect(at.y + half / aspect).toBeLessThanOrEqual(1);
+        // Never dimmer than 0.45: on ink a dimmer petal reads as dust.
+        expect(at.opacity).toBeGreaterThanOrEqual(0.45);
+        expect(at.opacity).toBeLessThanOrEqual(1);
+      }
+    }
+  });
+});
+
+describe("turning it", () => {
+  it("turns with a horizontal drag, a full swing across a little over half the panel", () => {
+    expect(dragToLight({ x: 0, y: 0.1 }, 0, 358)).toEqual({ x: 0, y: 0.1 });
+    expect(dragToLight({ x: 0, y: 0 }, 358 * 0.55, 358).x).toBeCloseTo(1, 6);
+    expect(dragToLight({ x: 0.5, y: 0 }, 2000, 358).x).toBe(1);
+    expect(dragToLight({ x: 0.5, y: 0 }, -2000, 358).x).toBe(-1);
+  });
+
+  it("turns with the arrow keys and ignores the others", () => {
+    expect(keyToLight({ x: 0, y: 0 }, "ArrowRight")!.x).toBeGreaterThan(0);
+    expect(keyToLight({ x: 0, y: 0 }, "ArrowLeft")!.x).toBeLessThan(0);
+    expect(keyToLight({ x: 0, y: 0 }, "ArrowUp")!.y).toBeGreaterThan(0);
+    expect(keyToLight({ x: 0, y: 0 }, "ArrowDown")!.y).toBeLessThan(0);
+    expect(keyToLight({ x: 1, y: 0 }, "ArrowRight")!.x).toBe(1);
+    expect(keyToLight({ x: 0, y: 0 }, "Enter")).toBeNull();
+  });
+
+  it("steps through four poses, holding at either end", () => {
+    expect(POSES).toHaveLength(4);
+    expect(POSES).toContainEqual(REST);
+    expect(nextPose(POSES[0], 1)).toEqual(POSES[1]);
+    expect(nextPose(POSES[3], 1)).toEqual(POSES[3]);
+    expect(nextPose(POSES[0], -1)).toEqual(POSES[0]);
+    expect(nextPose(REST, -1)).toEqual(POSES[1]);
+  });
+
+  it("reads a tilt of 30° as a full swing, held beyond, against how she held it, swapped on its side", () => {
+    const rest = { beta: 40, gamma: 0 };
+    expect(tiltToLight({ beta: 40, gamma: 15 }, rest)).toEqual({ x: 0.5, y: -0 });
+    expect(tiltToLight({ beta: 40, gamma: 80 }, rest).x).toBe(1);
+    expect(tiltToLight({ beta: 70, gamma: 0 }, rest).y).toBe(-1);
+    // Landscape: the toward-and-away tilt now turns it across.
+    expect(tiltToLight({ beta: 55, gamma: 0 }, rest, 90).x).toBeCloseTo(0.5, 6);
+    expect(tiltToLight({ beta: 55, gamma: 0 }, rest, -90).x).toBeCloseTo(-0.5, 6);
+    expect(tiltToLight({ beta: 40, gamma: 15 }, rest, 180).x).toBeCloseTo(-0.5, 6);
+  });
+
+  it("smooths a reading's jitter with a low-pass filter", () => {
+    let l = { x: 0, y: 0 };
+    l = lowPass(l, { x: 1, y: -1 });
+    expect(l.x).toBeGreaterThan(0);
+    expect(l.x).toBeLessThan(0.3);
+    for (let i = 0; i < 60; i++) l = lowPass(l, { x: 1, y: -1 });
+    expect(l.x).toBeCloseTo(1, 3);
+    expect(l.y).toBeCloseTo(-1, 3);
+  });
+
+  it("settles within 1.2 s of letting go, coasting a little with a flick and never past the swing", () => {
+    expect(SETTLE_MS).toBeLessThanOrEqual(1200);
+    const to = restingAfter({ x: 0.9, y: 0 }, 0.01);
+    expect(to.x).toBe(1);
+    expect(restingAfter({ x: 0, y: 0 }, 0).x).toBe(0);
+    expect(Math.abs(restingAfter({ x: 0, y: 0 }, 1).x)).toBeLessThanOrEqual(0.4);
+    const from = { x: -0.5, y: 0.2 };
+    expect(settleAt(from, to, 0)).toEqual(from);
+    expect(settleAt(from, to, SETTLE_MS)).toEqual(to);
+    expect(settleAt(from, to, SETTLE_MS * 3)).toEqual(to);
+  });
+
+  it("sweeps for the preview and comes to rest where it began", () => {
+    expect(sweepAt(SWEEP_MS)).toEqual(REST);
+    const xs = Array.from({ length: 30 }, (_, i) => sweepAt((i / 29) * SWEEP_MS).x);
+    expect(Math.min(...xs)).toBeLessThan(-0.3);
+    expect(Math.max(...xs)).toBeGreaterThan(0.3);
+    expect(dot([1, 0, 0], [0, 1, 0])).toBe(0);
+  });
+});
