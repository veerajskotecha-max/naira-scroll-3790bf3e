+import type { Drop } from "./drops";
+import { MINUTE, PETAL_THRESHOLDS_MS, msUntil, petalsOpen, timeOf } from "./dropPhase";
+
+/*
+  The Bloom Clock's countdown, in numbers and in words: only the clock (in
+  a drop's own room) reads it, so it is kept apart from dropPhase.ts, which
+  the garden home needs for its first paint.
+*/
+
+/** The clock's five petals, as they are named under it. */
+export const PETAL_WORDS: readonly string[] = ["7 days", "3 days", "1 day", "1 hour", "Opening"];
+
+export type Countdown = { days: number; hours: number; minutes: number };
+
+/**
+ * Days, hours and minutes left, counted in whole minutes rounded up, so the
+ * digits change only as a minute boundary passes and read 0 only at the
+ * opening itself. Never negative.
+ */
+export const countdown = (msLeft: number): Countdown => {
+  const total = Math.ceil(Math.max(0, msLeft) / MINUTE);
+  return { days: Math.floor(total / 1440), hours: Math.floor((total % 1440) / 60), minutes: total % 60 };
+};
+
+const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
+
+/** "Opens in 2 days and 5 hours": the clock in words, for a screen reader. */
+export const countdownWords = (msLeft: number): string => {
+  const { days, hours, minutes } = countdown(msLeft);
+  if (days + hours + minutes === 0) return "Opening now.";
+  if (days > 0) return hours ? `Opens in ${plural(days, "day")} and ${plural(hours, "hour")}.` : `Opens in ${plural(days, "day")}.`;
+  if (hours > 0) return minutes ? `Opens in ${plural(hours, "hour")} and ${plural(minutes, "minute")}.` : `Opens in ${plural(hours, "hour")}.`;
+  return `Opens in ${plural(minutes, "minute")}.`;
+};
+
+/**
+ * The same, as a screen reader is told it unprompted: only as an hour turns
+ * (a day or more out: days and hours; within the day: hours), then every
+ * five minutes in the last hour and every minute in the last five. Read in
+ * full, the clock says countdownWords; this is what it announces.
+ */
+export const countdownLiveWords = (msLeft: number): string => {
+  const { days, hours, minutes } = countdown(msLeft);
+  if (days > 0 || hours > 0) return countdownWords(Math.ceil(Math.max(0, msLeft) / MINUTE) * MINUTE - minutes * MINUTE);
+  if (minutes > 5) return `Opens in ${Math.ceil(minutes / 5) * 5} minutes.`;
+  return countdownWords(msLeft);
+};
+
+/** When the clock's next petal opens (at 7 days, 3 days, 1 day and 1 hour), or null once only the opening is left. */
+export const nextPetalAt = (drop: Drop, now: number): number | null => {
+  const k = petalsOpen(msUntil(drop, now));
+  return k < PETAL_THRESHOLDS_MS.length - 1 ? timeOf(drop.membersFrom) - PETAL_THRESHOLDS_MS[k] : null;
+};
