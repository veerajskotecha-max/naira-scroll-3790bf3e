+      setChosen(g);
+    }
+    return saved;
+  };
+
+  const edit = (before: Gift) => (after: Gift): SaveAnswer => {
+    if (sameGift(before, after)) {
+      setEditing(null);
+      return { ok: true };
+    }
+    if (gifts.some((g) => !sameGift(g, before) && sameGift(g, after))) return { ok: false, message: "That date is already in your ledger." };
