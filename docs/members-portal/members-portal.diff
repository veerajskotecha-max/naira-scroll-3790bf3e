@@ -0,0 +1,62 @@
+/*
+  Written in your sky (Phase 6): for each month's birth flower (the twelve
+  drawings in BirthFlowers.tsx, stones.ts naming them), the stars she traces
+  it by, and where the drawing sits.
+
+  - stars: 6 to 8 points on the flower's own line, in the order she joins
+    them, in the night sheet's units (a 358 x 358 square). Each is 56 units
+    or more from every other, and 28 or more from the sheet's edge, so a
+    star's 56-unit target is 44 CSS px or more even on a 320 px phone.
+  - sheet: the drawing's 40 x 64 sheet into the night sheet: x, y, scale.
+  - sky: the same drawing inside the garden bed's arch (its 390 x 560
+    view), left of the moon and above the next drop's bud, for SkyLayer to
+    rest it in her night sky once it is written: x, y, scale.
+
+  Worked out once from the drawings (each star a point on the path, the
+  points spread as far apart as they go, joined in the shortest tour from
+  the stem's foot) and pinned here; starFlowers.test holds every rule
+  above. A pure table: only the star sheet and the sky read it, both chunks
+  of their own, so it never rides in the garden's first paint.
+*/
+
+export type StarFlower = {
+  stars: readonly (readonly [number, number])[];
+  sheet: readonly [number, number, number];
+  sky: readonly [number, number, number];
+};
+
+export const SHEET = 358;
+
+export const STAR_FLOWERS: readonly StarFlower[] = [
+  //  1 · carnation
+  { stars: [[179, 328], [181, 260], [226, 210], [191, 119], [236, 67], [179, 30], [126, 78], [125, 179]], sheet: [69.12, -18.59, 5.5], sky: [64.91, 118.88, 1.256] },
+  //  2 · violet
+  { stars: [[179, 328], [134, 254], [176, 178], [215, 103], [203, 30], [144, 35], [128, 92]], sheet: [70.13, -15.42, 5.45], sky: [65.15, 119.62, 1.244] },
+  //  3 · daffodil
+  { stars: [[173, 328], [173, 240], [174, 164], [239, 181], [210, 104], [174, 30], [119, 62], [119, 126]], sheet: [71.6, 7.21, 5.09], sky: [65.48, 124.78, 1.162] },
+  //  4 · daisy
+  { stars: [[179, 328], [179, 253], [178, 179], [179, 111], [113, 96], [179, 30], [245, 96]], sheet: [78, 9.83, 5.05], sky: [66.94, 125.37, 1.153] },
+  //  5 · lily of the valley
+  { stars: [[176, 328], [129, 277], [180, 230], [110, 218], [116, 156], [209, 122], [248, 30]], sheet: [59.05, -41.71, 5.87], sky: [62.64, 113.65, 1.339] },
+  //  6 · rose
+  { stars: [[179, 328], [181, 261], [229, 213], [204, 132], [130, 175], [130, 85], [200, 30]], sheet: [64.4, -33.01, 5.73], sky: [63.84, 115.6, 1.308] },
+  //  7 · larkspur
+  { stars: [[177, 328], [215, 243], [144, 179], [206, 169], [203, 106], [177, 30]], sheet: [79.34, 21.21, 4.87], sky: [67.26, 128.0, 1.111] },
+  //  8 · gladiolus
+  { stars: [[192, 314], [195, 257], [200, 199], [144, 221], [154, 164], [208, 142], [228, 33]], sheet: [92.02, 15.57, 4.96], sky: [70.17, 126.73, 1.131] },
+  //  9 · aster
+  { stars: [[179, 328], [192, 254], [181, 179], [179, 114], [114, 105], [179, 30], [244, 105]], sheet: [78, 9.83, 5.05], sky: [66.94, 125.37, 1.153] },
+  // 10 · marigold
+  { stars: [[179, 328], [180, 253], [178, 178], [173, 116], [114, 98], [191, 30], [238, 109]], sheet: [78.6, 11.6, 5.02], sky: [67.05, 125.75, 1.147] },
+  // 11 · chrysanthemum
+  { stars: [[179, 328], [179, 253], [180, 179], [178, 110], [112, 97], [179, 30], [246, 97]], sheet: [79.6, 14.99, 4.97], sky: [67.34, 126.61, 1.133] },
+  // 12 · narcissus
+  { stars: [[183, 328], [184, 241], [181, 178], [219, 127], [218, 55], [157, 30], [147, 115], [118, 184]], sheet: [76.78, -6.41, 5.31], sky: [66.69, 121.72, 1.211] },
+];
+
+/** Her month's table (1 to 12), or null. */
+export const starFlowerFor = (month: number | null | undefined): StarFlower | null =>
+  month && Number.isInteger(month) && month >= 1 && month <= 12 ? STAR_FLOWERS[month - 1] : null;
+
+/** A star of the sheet, in the drawing's own 40 x 64 units (to place it in the sky). */
+export const onDrawing = ([x, y]: readonly [number, number], [tx, ty, s]: StarFlower["sheet"]): [number, number] => [(x - tx) / s, (y - ty) / s];
