+          fire.push((hit) => cb([{ isIntersecting: hit } as IntersectionObserverEntry], this as unknown as IntersectionObserver));
+        }
+        observe() {}
+        disconnect() {}
+        unobserve() {}
+        takeRecords() {
+          return [];
+        }
+      },
+    );
+    try {
+      spotIn();
+      expect(animated).toHaveLength(0);
+      act(() => fire[0](true));
+      expect(animated).toHaveLength(1);
+      const settle = animated[0] as unknown as { keyframes: Keyframe[]; options: KeyframeAnimationOptions };
+      for (const k of settle.keyframes) for (const p of Object.keys(k)) expect(p).toMatch(PROPS);
+      expect(settle.options.iterations ?? 1).toBe(1);
+      expect(window.localStorage.getItem("naira-portal")).toMatch(/"spot":\{"seen":true\}/);
+      // Never again on this phone.
+      cleanup();
+      animated.length = 0;
+      fire.length = 0;
+      spotIn();
+      expect(fire).toHaveLength(0);
+      expect(animated).toHaveLength(0);
+    } finally {
+      vi.unstubAllGlobals();
+    }
+  });
+
+  it("under reduced motion, animates nothing: the print and the line are there at once", () => {
+    setReducedMotion(true);
+    const { container } = spotIn();
+    fireEvent.click(screen.getByRole("button", { name: WORDS.petal }));
+    expect(animated).toHaveLength(0);
+    expect(container.querySelector(".ig-petal-layer")).toBeNull();
+    expect(screen.getByRole("img", { name: WORDS.printPetal })).toBeInTheDocument();
+    expect(document.activeElement).toBe(screen.getByRole("status"));
+  });
+
+  it("starts no loop: no timer, no frame callback, no endless animation", () => {
+    const code = readFileSync(resolve(src, "components/portal/PetalSpot.tsx"), "utf8");
+    expect(code).not.toMatch(/setInterval|requestAnimationFrame|Infinity|iterations/);
+  });
+});
+
+/* ── in each of her five rooms ─────────────────────── */
+
+const signIn = (naira: Record<string, unknown> = {}) => {
+  const user = { id: USER_ID, email: "meera@example.com", created_at: "2026-11-01T05:00:00Z", user_metadata: { full_name: "Meera Iyer", naira: { v: 1, seen: { last: today }, ...naira } } };
+  sb.meta = { ...user.user_metadata };
+  auth.state = { user, profile: { id: USER_ID, full_name: "Meera Iyer", birthday: "1998-07-02", phone: null, city: null }, loading: false, session: null, refreshProfile: async () => {}, signOut: async () => {} };
+};
+const visit = (path: string) =>
+  render(
+    <MemoryRouter initialEntries={[path]}>
+      <Routes>
+        <Route path="/members/*" element={<MembersRoute />} />
+      </Routes>
+    </MemoryRouter>,
+  );
+
+const ROOMS: [string, string, string][] = [
+  ["/members/drops", "drops", "New in the garden"],
+  ["/members/drawer", "drawer", "Your pieces"],
+  ["/members/fit", "fit", "Rings in your size, in stock now"],
+  ["/members/gifts", "gifts", "Your dates"],
+  ["/members/care", "care", "Your pieces"],
+];
+
+/* No ancestor between the piece and its section holds a price or another button. */
+const clearOfPieces = (spot: HTMLElement) => {
+  for (let el = spot.parentElement; el && !el.classList.contains("ig-section"); el = el.parentElement) {
+    expect(el.querySelector(".ig-price, .ig-shoot-price")).toBeNull();
+    expect([...el.querySelectorAll("button")].filter((b) => b !== spot)).toEqual([]);
+  }
+  expect(spot.closest("a, li, article, label")).toBeNull();
+};
+
+describe("Gathered in her rooms", () => {
+  beforeEach(() => {
+    shop.jewellery = catalogue;
+    shop.isLive = true;
+    shop.isLoading = false;
+    newIn.data = [];
+    sb.calls = 0;
+    sb.getUser.mockReset();
+    sb.updateUser.mockReset();
+    sb.getUser.mockImplementation(async () => ({ data: { user: { id: USER_ID, user_metadata: sb.meta } }, error: null }));
+    sb.updateUser.mockImplementation(async ({ data }: { data: Record<string, unknown> }) => {
+      sb.meta = { ...sb.meta, ...data };
+      return { data: { user: { id: USER_ID, user_metadata: sb.meta } }, error: null };
+    });
+  });
+
+  it.each(ROOMS)("%s: one piece at the end of its heading, in an empty room", async (path, key, heading) => {
+    signIn();
+    const { container } = visit(path);
+    const spot = await screen.findByRole("button", { name: key === "fit" ? WORDS.stem : WORDS.petal });
+    expect(container.querySelectorAll(".ig-spot")).toHaveLength(1);
+    expect(spot.dataset.piece).toBe(key);
+    expect(spot.parentElement?.querySelector("h2")?.textContent).toBe(heading);
+    clearOfPieces(spot);
+  });
+
+  it.each(ROOMS)("%s: and in a room full of pieces, clear of every price and Add button", async (path, key) => {
+    const ring = catalogue.find((p) => p.category === "Rings" && p.availableForSale);
+    signIn({ saved: catalogue.slice(0, 4).map((p) => p.handle), ring: { us: 7, how: "k", at: "2026-11-04" }, gifts: ["03141Mum"] });
+    newIn.data = catalogue.slice(0, 3).map((p) => ({ handle: p.handle, publishedAt: new Date().toISOString(), availableForSale: true }));
+    expect(ring).toBeDefined();
+    const { container } = visit(path);
+    const spot = await screen.findByRole("button", { name: key === "fit" ? WORDS.stem : WORDS.petal });
+    if (key !== "gifts") await waitFor(() => expect(container.querySelectorAll(".ig-price, .ig-shoot-price, .ig-care-card").length).toBeGreaterThan(0));
+    clearOfPieces(spot);
+  });
+
+  it("writes one bit to her account, once, through the writer", async () => {
+    signIn({ p: 1 << BITS.gifts });
+    visit("/members/care");
+    fireEvent.click(await screen.findByRole("button", { name: WORDS.petal }));
+    await waitFor(() => expect(sb.updateUser).toHaveBeenCalledTimes(1), { timeout: 2500 });
+    const written = sb.updateUser.mock.calls[0][0] as { data: { naira: Naira } };
+    expect(written.data.naira.p).toBe((1 << BITS.gifts) | (1 << BITS.care));
+    await new Promise((r) => setTimeout(r, 900));
+    expect(sb.updateUser).toHaveBeenCalledTimes(1);
+  });
+
+  it("for the preview member, logs the one write and never reaches Supabase", async () => {
+    const info = vi.spyOn(console, "info").mockImplementation(() => {});
+    window.history.replaceState(null, "", "/members/drawer?portalPreview=1&name=Ananya&hunt=1");
+    try {
+      signIn();
+      visit("/members/drawer");
+      fireEvent.click(await screen.findByRole("button", { name: WORDS.petal }));
+      await waitFor(() => expect(info.mock.calls.filter((c) => String(c[0]).includes("not written: user_metadata.naira"))).toHaveLength(1), { timeout: 2500 });
+      const logged = info.mock.calls.find((c) => String(c[0]).includes("not written: user_metadata.naira"))?.[1] as { p?: number };
+      expect(logged.p).toBe(3);
+      await new Promise((r) => setTimeout(r, 900));
+      expect(info.mock.calls.filter((c) => String(c[0]).includes("not written: user_metadata.naira"))).toHaveLength(1);
+      expect(sb.updateUser).not.toHaveBeenCalled();
+    } finally {
+      window.history.replaceState(null, "", "/");
+      info.mockRestore();
+    }
