+import { cleanup, fireEvent, render } from "@testing-library/react";
+import { useRef } from "react";
+import { afterEach, beforeAll, describe, expect, it, vi } from "vitest";
+import { MAX_BLOOMS, loadGardenTouch, useTapBloom } from "./useTapBloom";
+import { MAX_PETALS, burstPetals } from "./PetalBurst";
+
+/* The shop's tap-bloom listened on window, so two on one page both answered
+   every tap, and it bloomed under reduced motion. The portal's listens only
+   on its own element, keeps five blooms at most and stays still for anyone
+   who asked for less motion. */
+const Bed = () => {
+  const ref = useRef<HTMLDivElement>(null);
+  useTapBloom(ref);
+  return (
+    <div ref={ref} data-testid="bed">
+      <button type="button">a control</button>
+    </div>
+  );
+};
+
+const reduce = (on: boolean) => {
+  window.matchMedia = ((q: string) => ({ matches: on && q.includes("reduce"), media: q, addEventListener() {}, removeEventListener() {}, addListener() {}, removeListener() {}, onchange: null, dispatchEvent: () => false })) as typeof window.matchMedia;
+};
+
+afterEach(() => {
+  cleanup();
+  reduce(false);
+  vi.restoreAllMocks();
+});
+
+describe("useTapBloom", () => {
+  // The flowers are a chunk of their own (gardenTouch), fetched as a bed mounts: here, in before the first tap.
+  beforeAll(async () => {
+    await loadGardenTouch();
+  });
+
+  it("keeps at most five blooms alive", () => {
+    const { getByTestId } = render(<Bed />);
+    const bed = getByTestId("bed");
+    for (let i = 0; i < 9; i++) fireEvent.pointerDown(bed, { clientX: 10 + i, clientY: 10, button: 0 });
+    expect(bed.querySelectorAll(".ig-bloom").length).toBe(MAX_BLOOMS);
+  });
+
+  it("listens on its own element, never on window", () => {
+    const spy = vi.spyOn(window, "addEventListener");
+    render(<Bed />);
+    expect(spy.mock.calls.filter(([type]) => type === "pointerdown")).toEqual([]);
+  });
+
+  it("leaves taps on controls alone", () => {
+    const { getByTestId, getByRole } = render(<Bed />);
+    fireEvent.pointerDown(getByRole("button"), { button: 0 });
+    expect(getByTestId("bed").querySelectorAll(".ig-bloom")).toHaveLength(0);
+  });
+
+  it("blooms nothing under reduced motion", () => {
+    reduce(true);
+    const { getByTestId } = render(<Bed />);
+    fireEvent.pointerDown(getByTestId("bed"), { button: 0 });
+    expect(getByTestId("bed").querySelectorAll(".ig-bloom")).toHaveLength(0);
+  });
+});
+
+describe("burstPetals", () => {
+  it("never throws more than 24 petals, and none under reduced motion", () => {
+    const layer = document.createElement("div");
+    const animate = vi.fn(() => ({ onfinish: null, oncancel: null }) as unknown as Animation);
+    (HTMLElement.prototype as unknown as { animate: unknown }).animate = animate;
+    (SVGElement.prototype as unknown as { animate: unknown }).animate = animate;
+    burstPetals(layer, 0, 0, { count: 200 });
+    expect(layer.querySelectorAll(".ig-petal")).toHaveLength(MAX_PETALS);
+    reduce(true);
+    const quiet = document.createElement("div");
+    burstPetals(quiet, 0, 0, { count: 10 });
+    expect(quiet.childElementCount).toBe(0);
+    delete (HTMLElement.prototype as unknown as { animate?: unknown }).animate;
+    delete (SVGElement.prototype as unknown as { animate?: unknown }).animate;
+  });
+});
diff --git a/src/components/portal/useTapBloom.ts b/src/components/portal/useTapBloom.ts
new file mode 100644
index 0000000..afcf94e
--- /dev/null
+++ b/src/components/portal/useTapBloom.ts
@@ -0,0 +1,108 @@
+import { useCallback, useEffect, useRef, type RefObject } from "react";
+import { stillMotion } from "@/lib/portal/motion";
+
+/*
+  Every tap blooms. The shop's tap-to-bloom (RingAtelierBackdrop) listens on
+  window, so two on a page both answered every tap; this one listens only on
+  the element it is given (the garden bed, the gate), and only there does a
+  flower open. At most five alive, each removed when it has opened and
+  faded. A 10 ms tick on phones that can. Nothing under reduced motion.
+
+  The flowers themselves (their drawing and motion) are gardenTouch.ts, a
+  chunk of its own: it is fetched the moment a bed or gate that can bloom
+  mounts, so the first paint never carries it, and a tap that comes before
+  it has arrived blooms as soon as it does.
+*/
+
+export const MAX_BLOOMS = 5;
+
+type Touch = typeof import("./gardenTouch");
+let touch: Touch | null = null;
+let loading: Promise<Touch> | null = null;
+
+/** Fetches the garden's touch code, once; a failed fetch is tried again on the next ask. */
+export const loadGardenTouch = (): Promise<Touch> =>
+  (loading ??= import("./gardenTouch").then(
+    (m) => (touch = m),
+    (error: unknown) => {
+      loading = null;
+      throw error;
+    },
+  ));
+
+/** Runs `act` with the touch code: at once when it is in, or as soon as it arrives (and not at all if it cannot be fetched). */
+export const withTouch = (act: (t: Touch) => void): void => {
+  if (touch) act(touch);
+  else loadGardenTouch().then(act, () => {});
+};
+
+type Options = {
+  /** A tap on one of her own plants: return true to answer it instead of a bloom. */
+  onSpecial?: (target: Element, event: PointerEvent) => boolean;
+};
+
+/**
+ * Wires the taps, and returns `bloomAt(clientX, clientY)` for a bloom the
+ * page opens itself (the one that shows her the garden can be tapped).
+ */
+export const useTapBloom = (rootRef: RefObject<HTMLElement>, enabled = true, options: Options = {}) => {
+  const alive = useRef<HTMLElement[]>([]);
+  const last = useRef(-1);
+  const special = useRef(options.onSpecial);
+  special.current = options.onSpecial;
+
+  const bloomAt = useCallback(
+    (clientX: number, clientY: number, vibrate = false) => {
+      const root = rootRef.current;
+      if (!root || !enabled || stillMotion()) return;
+      const box = root.getBoundingClientRect();
+      const x = clientX - box.left;
+      const y = clientY - box.top;
+      withTouch((t) => {
+        // Gone (another room, or the gate opened) before the flowers arrived: nothing to bloom on.
+        if (!root.isConnected) return;
+        const list = alive.current;
+        const { node, species } = t.openBloom(root, x, y, last.current, (gone) => {
+          const i = list.indexOf(gone);
+          if (i >= 0) list.splice(i, 1);
+        });
+        last.current = species;
+        list.push(node);
+        while (list.length > MAX_BLOOMS) list.shift()?.remove();
+      });
+      if (vibrate) {
+        try {
+          navigator.vibrate?.(10);
+        } catch {
+          /* not allowed here: no tick */
+        }
+      }
+    },
+    [rootRef, enabled],
+  );
+
+  useEffect(() => {
+    const root = rootRef.current;
+    if (!root || !enabled || stillMotion()) return;
+    const list = alive.current;
+    // Fetched now, so her first tap need not wait for it.
+    loadGardenTouch().catch(() => {});
+
+    const onDown = (e: PointerEvent) => {
+      if (e.button > 0) return;
+      const target = e.target as Element | null;
+      if (target?.closest?.("a,button,input,select,textarea,label")) return;
+      if (target && special.current?.(target, e)) return;
+      bloomAt(e.clientX, e.clientY, true);
+    };
+
+    root.addEventListener("pointerdown", onDown);
+    return () => {
+      root.removeEventListener("pointerdown", onDown);
+      list.forEach((n) => n.remove());
+      list.length = 0;
+    };
+  }, [rootRef, enabled, bloomAt]);
+
+  return bloomAt;
+};
