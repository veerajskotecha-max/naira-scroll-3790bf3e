+++ b/supabase/functions/order-bloom/index.ts
@@ -0,0 +1,105 @@
+/**
+ * order-bloom: Shopify's orders/create webhook, for the Inner Garden.
+ *
+ * When an order is placed, the checkout a signed-in member started for it
+ * (her member_orders row, which the bag writes as it hands her to payment)
+ * is marked as an order: status 'completed' and completed_at, the order's
+ * own time. Those two existing columns are the only thing it ever writes;
+ * it creates, removes and returns no row. The Order Desk then lists that
+ * row under "Orders", and a gold-leaf rose dated with it grows in her
+ * garden's front row; every other row stays a checkout she started.
+ *
+ * NOT DEPLOYED, AND INERT WITHOUT ITS SECRET. Merging this to main may let
+ * Lovable deploy it (Lovable deploys supabase/functions on publish). Without
+ * the ORDER_BLOOM_WEBHOOK_SECRET secret it does nothing at all: every request
+ * gets 401 before its body is read, and nothing is read from or written to
+ * the database. (Its own name, so that no secret another integration set
+ * can switch it on unasked; a blank or short value counts as unset.) To
+ * switch it on, the owner (after approving it):
+ *   1. creates the Shopify webhook (Settings, Notifications, Webhooks:
+ *      Order creation, JSON) pointing at this function's address;
+ *   2. sets ORDER_BLOOM_WEBHOOK_SECRET to the signing key Shopify shows
+ *      there;
+ *   3. has the function deployed with JWT verification off
+ *      (supabase/config.toml [functions.order-bloom] verify_jwt = false),
+ *      since Shopify sends no Supabase token: the HMAC check is its
+ *      authentication;
+ *   4. confirms that Fastrr (Shiprocket checkout) orders carry the cart
+ *      token, or they can only ever match by the cautious email rule.
+ *
+ * What it cannot see, for the owner to know:
+ *   - The bag notes a checkout only on its own Checkout tap, signed in, and
+ *     a failed note is never retried; Buy now notes none. Such an order
+ *     matches a row only when the row's pieces agree with it, else nothing.
+ *   - An order paid under another email than her sign-in email stays a
+ *     checkout when the cart was shared (a phone, a passed-on link): that
+ *     is the one sign another person paid.
+ *   - orders/create only: an order cancelled or refused at the door after
+ *     it was placed keeps its "Order" and its rose (Track Order shows its
+ *     status). Handling orders/cancelled would need another write, which
+ *     this function does not make.
+ *   - Until an owner-approved migration makes the database refuse browser
+ *     rows that say 'completed', a member can mark her own rows so, for her
+ *     own eyes; this function never writes one member's order onto another
+ *     member's row.
+ *
+ * All of its logic is in ./bloom.ts (no Deno globals there, so the shop's
+ * vitest suite tests it): the HMAC check (base64 HMAC-SHA256 of the raw
+ * body, constant-time compare), the matching rule (tokens first, then email
+ * under a conservative rule, written out there), idempotent retries, and
+ * logs that carry outcome codes only, never personal data.
+ *
+ * No CORS: nothing in a browser calls it. The service-role key never leaves
+ * this function.
+ */
+import { createClient } from "npm:@supabase/supabase-js@2";
+import { TooLarge, handleWebhook, supabaseStore, type Db } from "./bloom.ts";
+
+/** The raw body, read chunk by chunk and abandoned past `max` bytes (a chunked request carries no content-length). */
+const readCapped = async (req: Request, max: number): Promise<ArrayBuffer> => {
+  const reader = req.body?.getReader();
+  if (!reader) return new ArrayBuffer(0);
+  const parts: Uint8Array[] = [];
+  let size = 0;
+  for (;;) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    size += value.byteLength;
+    if (size > max) {
+      await reader.cancel().catch(() => undefined);
+      throw new TooLarge();
+    }
+    parts.push(value);
+  }
+  const out = new Uint8Array(size);
+  let at = 0;
+  for (const part of parts) {
+    out.set(part, at);
+    at += part.byteLength;
+  }
+  return out.buffer;
+};
+
+Deno.serve(async (req) => {
+  const result = await handleWebhook(
+    {
+      method: req.method,
+      header: (name) => req.headers.get(name),
+      body: (max) => readCapped(req, max),
+    },
+    {
+      secret: Deno.env.get("ORDER_BLOOM_WEBHOOK_SECRET"),
+      store: () => {
+        const url = Deno.env.get("SUPABASE_URL");
+        const key = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
+        if (!url || !key) return null;
+        return supabaseStore(createClient(url, key, { auth: { persistSession: false, autoRefreshToken: false } }) as unknown as Db);
+      },
+      log: (event) => console.info(`order-bloom ${event}`),
+    },
+  );
+  return new Response(JSON.stringify(result.body), {
+    status: result.status,
+    headers: { "Content-Type": "application/json", "Cache-Control": "no-store" },
+  });
+});
