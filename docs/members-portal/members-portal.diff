@@ -0,0 +1,140 @@
+import { act, cleanup, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Drop } from "@/lib/portal/drops";
+import { DAY, HOUR, MINUTE } from "@/lib/portal/dropPhase";
+import { primeServerClock, resetServerClock } from "@/lib/portal/clock";
+import BloomClock from "./BloomClock";
+
+/* The Bloom Clock: five petals that open at 7 days, 3 days, 1 day, 1 hour
+   and the opening, exactly on time, and digits that change only as a minute
+   boundary passes, with the same time in words for a screen reader. */
+
+const drop: Drop = {
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
+  accent: "#2F6B4F",
+  story: [],
+  membersFrom: "2026-11-21T20:00:00+05:30",
+  everyoneFrom: "2026-11-23T20:00:00+05:30",
+  handles: ["a"],
+  leadHandle: "a",
+};
+const opens = Date.parse(drop.membersFrom);
+
+const openPetals = (c: HTMLElement) => c.querySelectorAll(".ig-bud-petal[data-open]").length;
+const digits = (c: HTMLElement) => [...c.querySelectorAll(".ig-bc-roll")].map((d) => d.textContent).join(":");
+
+beforeEach(() => {
+  primeServerClock(0);
+});
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  resetServerClock();
+});
+
+describe("the Bloom Clock", () => {
+  it("says when it opens, in IST", () => {
+    vi.useFakeTimers({ now: opens - 2 * DAY });
+    render(<BloomClock drop={drop} />);
+    expect(screen.getByText("Opens Sat 21 Nov · 8:00 pm IST")).toBeInTheDocument();
+  });
+
+  it.each([
+    [7 * DAY, 1],
+    [3 * DAY, 2],
+    [DAY, 3],
+    [HOUR, 4],
+    [0, 5],
+  ])("opens petal %#: none early, exactly at %i ms before the opening", (threshold, k) => {
+    vi.useFakeTimers({ now: opens - threshold - 1000 });
+    const { container } = render(<BloomClock drop={drop} />);
+    expect(openPetals(container)).toBe(k - 1);
+    act(() => void vi.advanceTimersByTime(999));
+    expect(openPetals(container)).toBe(k - 1);
+    act(() => void vi.advanceTimersByTime(60));
+    expect(openPetals(container)).toBe(k);
+    // The dial's mark for it fills too.
+    const marks = [...container.querySelectorAll(".ig-bud-dial ellipse")].filter((m) => m.getAttribute("fill") !== "none");
+    expect(marks).toHaveLength(k);
+  });
+
+  it("changes its digits only as a minute boundary passes", () => {
+    // 2 days, 5 hours, 40 minutes and 30 seconds to go: shown as 41 minutes.
+    const start = opens - (2 * DAY + 5 * HOUR + 40 * MINUTE + 30_000);
+    vi.useFakeTimers({ now: start });
+    const { container } = render(<BloomClock drop={drop} />);
+    expect(digits(container)).toBe("02:05:41");
+    act(() => void vi.advanceTimersByTime(29_000));
+    expect(digits(container)).toBe("02:05:41");
+    act(() => void vi.advanceTimersByTime(1_100));
+    expect(digits(container)).toBe("02:05:40");
+    act(() => void vi.advanceTimersByTime(59_000));
+    expect(digits(container)).toBe("02:05:40");
+    act(() => void vi.advanceTimersByTime(1_000));
+    expect(digits(container)).toBe("02:05:39");
+  });
+
+  it("tells a screen reader the same time, politely", () => {
+    vi.useFakeTimers({ now: opens - (2 * DAY + 5 * HOUR) });
+    const { container } = render(<BloomClock drop={drop} />);
+    const live = container.querySelector("[aria-live]")!;
+    expect(live.getAttribute("aria-live")).toBe("polite");
+    expect(live).toHaveTextContent("Opens in 2 days and 5 hours.");
+    expect(container.querySelector(".ig-bc-digits")!.getAttribute("aria-hidden")).toBe("true");
+  });
+
+  /* Announced only as an hour turns (then every 5 minutes in the last hour),
+     never once a minute; read in full, it has the minutes too. */
+  it("tells a screen reader of the time unprompted only as an hour turns", () => {
+    // 5 h 32 min to go, less a second (so every step below lands just past a minute boundary).
+    vi.useFakeTimers({ now: opens - (5 * HOUR + 32 * MINUTE) + 1000 });
+    const { container } = render(<BloomClock drop={drop} />);
+    const live = container.querySelector("[aria-live]")!;
+    expect(live).toHaveTextContent("Opens in 5 hours.");
+    expect(screen.getByText("Opens in 5 hours and 32 minutes.")).toBeInTheDocument();
+    act(() => void vi.advanceTimersByTime(20 * MINUTE));
+    expect(live).toHaveTextContent("Opens in 5 hours.");
+    expect(screen.getByText("Opens in 5 hours and 12 minutes.")).toBeInTheDocument();
+    act(() => void vi.advanceTimersByTime(13 * MINUTE));
+    expect(live).toHaveTextContent("Opens in 4 hours.");
+    // In the last hour: every five minutes, then every minute.
+    act(() => void vi.advanceTimersByTime(4 * HOUR + 36 * MINUTE));
+    expect(live).toHaveTextContent("Opens in 25 minutes.");
+    act(() => void vi.advanceTimersByTime(19 * MINUTE));
+    expect(live).toHaveTextContent("Opens in 4 minutes.");
+  });
+
+  it("says when the next petal opens, in IST", () => {
+    vi.useFakeTimers({ now: opens - 2 * DAY });
+    render(<BloomClock drop={drop} />);
+    expect(screen.getByText("The next petal opens Fri 20 Nov · 8:00 pm IST")).toBeInTheDocument();
+  });
+
+  it("never counts below zero", () => {
+    vi.useFakeTimers({ now: opens + HOUR });
+    const { container } = render(<BloomClock drop={drop} />);
+    expect(digits(container)).toBe("00:00:00");
+    expect(openPetals(container)).toBe(5);
+  });
+
+  it("shows a moved date struck through beside the new one", () => {
+    vi.useFakeTimers({ now: opens - 2 * DAY });
+    const { container } = render(<BloomClock drop={{ ...drop, movedFrom: "2026-11-14T20:00:00+05:30" }} />);
+    expect(container.querySelector("s")).toHaveTextContent("Sat 14 Nov · 8:00 pm IST");
+    expect(screen.getByText("Moved to Sat 21 Nov · 8:00 pm IST")).toBeInTheDocument();
+  });
+
+  /* Two timers only: the minute tick, set for the next boundary, and the
+     sway's 20 s rest. No animation-frame loop counts the seconds. */
+  it("runs no clock loop between minutes", () => {
+    vi.useFakeTimers({ now: opens - 2 * DAY - 30_000 });
+    const raf = vi.spyOn(window, "requestAnimationFrame");
+    render(<BloomClock drop={drop} />);
+    expect(vi.getTimerCount()).toBe(2);
+    act(() => void vi.advanceTimersByTime(10_000));
+    expect(vi.getTimerCount()).toBe(2);
+    expect(raf).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/components/portal/BloomClock.tsx b/src/components/portal/BloomClock.tsx
new file mode 100644
index 0000000..bb70ed7
--- /dev/null
+++ b/src/components/portal/BloomClock.tsx
@@ -0,0 +1,155 @@
+import { useEffect, useLayoutEffect, useRef } from "react";
+import type { Drop } from "@/lib/portal/drops";
+import { msUntil, petalsOpen, speciesIndex, timeOf } from "@/lib/portal/dropPhase";
+import { PETAL_WORDS, countdown, countdownLiveWords, countdownWords, nextPetalAt } from "@/lib/portal/countdown";
+import { formatIstOpening } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion, useAmbient } from "@/lib/portal/motion";
+import { BudGlyph } from "./FlowerGlyph";
+import { BUD_CLOSED, BUD_OPEN } from "@/lib/portal/species";
+import { burstPetals } from "./PetalBurst";
+import { PETAL_HUE, PETAL_SPARK } from "./PetalSymbols";
+import "./bloomclock.css";
+
+/*
+  THE BLOOM CLOCK. The next drop is a sealed bud whose five petals open on a
+  real clock in Indian time: one at 7 days, one at 3 days, one at 1 day, one
+  at 1 hour, and the last as the drop opens. A petal that opens while she is
+  watching turns out from the bud (700 ms, from its base) as its colour comes
+  in, with a few petals let go; the ones already open are drawn open.
+
+  The digits are days, hours and minutes, re-read on each minute boundary
+  from the server's clock (lib/portal/clock): a changed digit rolls in from
+  above (250 ms), the rest stay still. A screen reader hears the same time in
+  words, politely. It never counts below zero; past the opening the room
+  turns to the open drop. The bud's sway is this screen's one ambient loop,
+  and rests off screen, on a hidden tab and after 20 s untouched. Under
+  reduced motion it is a still drawing with plain digits.
+*/
+
+type Props = {
+  drop: Drop;
+  /** The large clock (the drops page and the room), or a smaller one. */
+  size?: number;
+};
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+const Digit = ({ value, unit }: { value: string; unit: string }) => {
+  const ref = useRef<HTMLSpanElement>(null);
+  const first = useRef(true);
+  useLayoutEffect(() => {
+    if (first.current) {
+      first.current = false;
+      return;
+    }
+    if (stillMotion()) return;
+    play(ref.current, [{ transform: "translateY(-75%)", opacity: 0 }, { transform: "translateY(0)", opacity: 1 }], { duration: 250, easing: EASE_REVEAL });
+  }, [value]);
+  return (
+    <span className="ig-bc-unit">
+      <span className="ig-bc-num">
+        <span ref={ref} className="ig-bc-roll">
+          {value}
+        </span>
+      </span>
+      <span className="ig-bc-word">{unit}</span>
+    </span>
+  );
+};
+
+const BloomClock = ({ drop, size = 230 }: Props) => {
+  const opens = timeOf(drop.membersFrom);
+  const now = useServerNow([opens - 7 * 86_400_000, opens - 3 * 86_400_000, opens - 86_400_000, opens - 3_600_000, opens]);
+  const left = msUntil(drop, now);
+  const open = petalsOpen(left);
+  const { days, hours, minutes } = countdown(left);
+  const artRef = useRef<HTMLDivElement>(null);
+  const swayRef = useRef<HTMLDivElement>(null);
+  const shown = useRef(open);
+  const calm = stillMotion();
+  const active = useAmbient(artRef, !calm);
+
+  // A petal that opens while she watches turns out from the bud.
+  useLayoutEffect(() => {
+    const from = shown.current;
+    shown.current = open;
+    if (open <= from || calm) return;
+    const root = artRef.current;
+    for (let k = from; k < open; k++) {
+      const petal = root?.querySelector(`.ig-bud-petal[data-k="${k}"]`);
+      play(petal, [{ transform: BUD_CLOSED[k] }, { transform: BUD_OPEN[k] }], { duration: 700, easing: EASE_BLOOM, fill: "backwards" });
+      play(petal?.querySelector(".ig-bud-colour"), [{ opacity: 0 }, { opacity: 1 }], { duration: 520, delay: 120, easing: EASE_REVEAL, fill: "backwards" });
+    }
+    root?.querySelectorAll(".ig-bud-dial ellipse").forEach((mark, k) => {
+      if (k >= from && k < open) play(mark, [{ opacity: 0.2 }, { opacity: 1 }], { duration: 500, delay: 420, easing: EASE_REVEAL, fill: "backwards" });
+    });
+    if (open >= 5) play(root?.querySelector(".ig-bud-core"), [{ transform: "scale(0)", opacity: 0 }, { transform: "scale(1)", opacity: 1 }], { duration: 600, delay: 300, easing: EASE_BLOOM, fill: "backwards" });
+    if (root) {
+      const box = root.getBoundingClientRect();
+      burstPetals(root, box.width / 2, box.width * 0.42, { count: 8, spread: 80, ids: [PETAL_HUE, PETAL_HUE, PETAL_SPARK], color: drop.accent, size: [8, 14], delay: 260 });
+    }
+  }, [open, calm, drop.accent]);
+
+  // The bud breathes: this screen's one ambient loop.
+  const sway = useRef<Animation | null>(null);
+  useEffect(() => {
+    if (calm) return;
+    const a = play(swayRef.current, [{ transform: "rotate(-1.6deg)" }, { transform: "rotate(1.6deg)" }], {
+      duration: 4600,
+      iterations: Infinity,
+      direction: "alternate",
+      easing: "ease-in-out",
+    });
+    a?.pause();
+    sway.current = a;
+    return () => a?.cancel();
+  }, [calm]);
+  useEffect(() => {
+    const a = sway.current;
+    if (!a) return;
+    if (active) a.play();
+    else a.pause();
+  }, [active]);
+
+  const when = formatIstOpening(drop.membersFrom);
+  const nextAt = nextPetalAt(drop, now);
+  return (
+    <figure className="ig-bc" style={{ ["--ig-accent" as string]: drop.accent }}>
+      <div ref={artRef} className="ig-bc-art" style={{ width: size }}>
+        <div ref={swayRef} className="ig-bc-sway">
+          <BudGlyph species={speciesIndex(drop.species)} accent={drop.accent} open={open} size={size} dial />
+        </div>
+      </div>
+      <figcaption className="ig-bc-cap">
+        {drop.movedFrom ? (
+          <p className="ig-bc-when">
+            <s>{formatIstOpening(drop.movedFrom)}</s>
+            <span>Moved to {when}</span>
+          </p>
+        ) : (
+          <p className="ig-bc-when">Opens {when}</p>
+        )}
+        <p className="ig-bc-digits" aria-hidden>
+          <Digit value={pad(days)} unit={days === 1 ? "day" : "days"} />
+          <Digit value={pad(hours)} unit="hrs" />
+          <Digit value={pad(minutes)} unit="min" />
+        </p>
+        <p className="sr-only">{countdownWords(left)}</p>
+        <p className="sr-only" aria-live="polite">
+          {countdownLiveWords(left)}
+        </p>
+        <ol className="ig-bc-steps" aria-label="A petal opens at each of these">
+          {PETAL_WORDS.map((w, k) => (
+            <li key={w} className={k < open ? "is-open" : undefined}>
+              {w}
+            </li>
+          ))}
+        </ol>
+        {nextAt !== null && <p className="ig-fineprint">The next petal opens {formatIstOpening(nextAt)}</p>}
+      </figcaption>
+    </figure>
+  );
+};
+
+export default BloomClock;
diff --git a/src/components/portal/BloomField.test.tsx b/src/components/portal/BloomField.test.tsx
new file mode 100644
index 0000000..d41e3c5
--- /dev/null
+++ b/src/components/portal/BloomField.test.tsx
@@ -0,0 +1,317 @@
+import { act, cleanup, render } from "@testing-library/react";
+import { createRef, type MutableRefObject } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/* The Bloom Field's component, with its scene stood in: nothing on Tier 1;
+   on Tier 2 a canvas laid over the screen once the room has painted,
+   prepared and held unseen until the opening begins (go), and never mounted
+   or started once the opening has begun without it; put away (the scene
+   disposed, the canvas gone) when the fall ends, when it is skipped, when
+   the room is left, or when the probe finds the phone slow. */
+
+const scene = vi.hoisted(() => ({
+  options: null as null | { colours: string[]; seed: string; probe?: boolean; onEnd: (why: "done" | "slow" | "lost") => void; onStart?: () => void; onReady?: () => void },
+  handle: { pause: vi.fn(), resume: vi.fn(), dispose: vi.fn() },
+  throws: false,
+  delay: 0,
+}));
+const loadBloomScene = vi.hoisted(() => vi.fn());
+vi.mock("@/lib/portal/spectacle", () => ({ loadBloomScene }));
+
+import BloomField from "./BloomField";
+import { forceTier, portalTier, resetTier } from "@/lib/portal/tier";
+
+const mountBloomField = vi.fn((_canvas: HTMLCanvasElement, options: NonNullable<typeof scene.options>) => {
+  if (scene.throws) throw new Error("no context");
+  scene.options = options;
+  return scene.handle;
+});
+
+/* A capable phone, so a demotion is what puts it on Tier 1. */
+const capable = () => {
+  Object.defineProperty(navigator, "connection", { configurable: true, value: { saveData: false, effectiveType: "4g" } });
+  Object.defineProperty(navigator, "deviceMemory", { configurable: true, value: 8 });
+  (window as unknown as Record<string, unknown>).WebGLRenderingContext = function WebGLRenderingContext() {};
+};
+
+const idle = () => act(async () => void vi.advanceTimersByTime(5));
+const field = () => document.body.querySelector<HTMLCanvasElement>("canvas.ig-bloomfield");
+
+const show = (stop = false) => {
+  const anchor = createRef<HTMLDivElement>();
+  const onGone = vi.fn();
+  const onReady = vi.fn();
+  const go: MutableRefObject<() => void> = { current: () => {} };
+  const now = { stop };
+  const el = () => (
+    <div ref={anchor}>
+      <BloomField accent="#2F6B4F" seed="verdant" anchor={anchor} go={go} stop={now.stop} onReady={onReady} onGone={onGone} />
+    </div>
+  );
+  const view = render(el());
+  return {
+    ...view,
+    onGone,
+    onReady,
+    anchor,
+    again: (s: boolean) => {
+      now.stop = s;
+      view.rerender(el());
+    },
+    /* The opening begins: the unboxing tells the field in the same task. */
+    begin: () => act(() => go.current()),
+  };
+};
+/* The scene says it is prepared (compiled, its unseen frame drawn). */
+const prepared = () => act(() => scene.options!.onReady!());
+/* Mounted, prepared, and the opening begun: the fall may run. */
+const running = async () => {
+  const shown = show();
+  await idle();
+  prepared();
+  shown.begin();
+  return shown;
+};
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  resetTier();
+  scene.options = null;
+  scene.throws = false;
+  scene.delay = 0;
+  Object.values(scene.handle).forEach((f) => f.mockClear());
+  mountBloomField.mockClear();
+  loadBloomScene.mockReset();
+  loadBloomScene.mockImplementation(() => new Promise((resolve) => setTimeout(() => resolve({ mountBloomField }), scene.delay)));
+  window.matchMedia = ((query: string) => ({ matches: false, media: query, addEventListener() {}, removeEventListener() {} })) as unknown as typeof window.matchMedia;
+  Object.defineProperty(document, "visibilityState", { configurable: true, value: "visible" });
+});
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  resetTier();
+  delete (navigator as Navigator & { connection?: unknown }).connection;
+  delete (navigator as Navigator & { deviceMemory?: number }).deviceMemory;
+  delete (window as unknown as Record<string, unknown>).WebGLRenderingContext;
+});
+
+describe("the Bloom Field", () => {
+  it("makes nothing on Tier 1, and asks for no scene", async () => {
+    forceTier(1);
+    const { onGone } = show();
+    await idle();
+    expect(loadBloomScene).not.toHaveBeenCalled();
+    expect(field()).toBeNull();
+    expect(onGone).toHaveBeenCalledTimes(1);
+  });
+
+  it("asks for the scene only once the room has painted, then lays a canvas over the screen that takes no tap", async () => {
+    forceTier(2);
+    const { onReady, begin } = show();
+    expect(loadBloomScene).not.toHaveBeenCalled();
+    await idle();
+    expect(loadBloomScene).toHaveBeenCalledTimes(1);
+    const canvas = field()!;
+    expect(canvas).not.toBeNull();
+    expect(canvas.getAttribute("aria-hidden")).toBe("true");
+    expect(canvas.parentElement).toBe(document.body);
+    expect(scene.options).toMatchObject({ colours: ["#2F6B4F", expect.stringMatching(/^#[0-9a-f]{6}$/i)], seed: "verdant", probe: true });
+    // Prepared before the opening, and held: nothing falls until it begins.
+    expect(scene.handle.pause).toHaveBeenCalled();
+    expect(onReady).not.toHaveBeenCalled();
+    prepared();
+    expect(onReady).toHaveBeenCalledTimes(1);
+    expect(scene.handle.resume).not.toHaveBeenCalled();
+    begin();
+    expect(scene.handle.resume).toHaveBeenCalledTimes(1);
+    act(() => scene.options!.onStart!());
+    expect(canvas.classList.contains("is-on")).toBe(true);
+  });
+
+  it("fades and puts everything away once the fall is done", async () => {
+    forceTier(2);
+    const { onGone } = await running();
+    const canvas = field()!;
+    act(() => scene.options!.onStart!());
+    act(() => scene.options!.onEnd("done"));
+    expect(canvas.classList.contains("is-on")).toBe(false);
+    expect(scene.handle.dispose).not.toHaveBeenCalled();
+    await act(async () => void vi.advanceTimersByTime(400));
+    expect(scene.handle.dispose).toHaveBeenCalledTimes(1);
+    expect(field()).toBeNull();
+    expect(onGone).toHaveBeenCalledTimes(1);
+    expect(portalTier()).toBe(2);
+  });
+
+  it("goes back to Tier 1 for the visit when the probe finds the phone slow", async () => {
+    capable();
+    expect(portalTier()).toBe(2);
+    await running();
+    const canvas = field()!;
+    act(() => scene.options!.onStart!());
+    act(() => scene.options!.onEnd("slow"));
+    // It fades (its flowers do not vanish mid-air), then goes.
+    expect(canvas.classList.contains("is-on")).toBe(false);
+    expect(scene.handle.dispose).not.toHaveBeenCalled();
+    await act(async () => void vi.advanceTimersByTime(400));
+    expect(scene.handle.dispose).toHaveBeenCalledTimes(1);
+    expect(field()).toBeNull();
+    expect(portalTier()).toBe(1);
+  });
+
+  it("is put away at once when she leaves the room", async () => {
+    forceTier(2);
+    const { unmount } = show();
+    await idle();
+    expect(field()).not.toBeNull();
+    unmount();
+    expect(scene.handle.dispose).toHaveBeenCalledTimes(1);
+    expect(field()).toBeNull();
+  });
+
+  it("goes at once when its context is lost: nothing is left to fade", async () => {
+    capable();
+    await running();
+    act(() => scene.options!.onStart!());
+    act(() => scene.options!.onEnd("lost"));
+    expect(scene.handle.dispose).toHaveBeenCalledTimes(1);
+    expect(field()).toBeNull();
+    expect(portalTier()).toBe(1);
+  });
+
+  it("goes with the ritual when she skips", async () => {
+    forceTier(2);
+    const { again, onGone } = await running();
+    act(() => scene.options!.onStart!());
+    again(true);
+    await act(async () => void vi.advanceTimersByTime(400));
+    expect(scene.handle.dispose).toHaveBeenCalledTimes(1);
+    expect(onGone).toHaveBeenCalledTimes(1);
+  });
+
+  it("is never mounted mid-opening: a scene not here when the opening began stays away", async () => {
+    capable();
+    scene.delay = 2500;
+    const { onGone, onReady, begin } = show();
+    await act(async () => void vi.advanceTimersByTime(900));
+    begin();
+    await act(async () => void vi.advanceTimersByTime(2000));
+    expect(mountBloomField).not.toHaveBeenCalled();
+    expect(field()).toBeNull();
+    expect(onGone).toHaveBeenCalledTimes(1);
+    // The hold is let go, and the network's lateness is not the phone's: Tier 2 holds.
+    expect(onReady).toHaveBeenCalled();
+    expect(portalTier()).toBe(2);
+  });
+
+  it("never mounts a scene that arrives too late in the wait to be prepared in it", async () => {
+    capable();
+    scene.delay = 600;
+    const { onGone, onReady } = show();
+    await act(async () => void vi.advanceTimersByTime(700));
+    expect(mountBloomField).not.toHaveBeenCalled();
+    expect(field()).toBeNull();
+    expect(onGone).toHaveBeenCalledTimes(1);
+    expect(onReady).toHaveBeenCalled();
+    expect(portalTier()).toBe(2);
+  });
+
+  it("is never started mid-opening: one not prepared when the opening began is put away, and the phone keeps Tier 1", async () => {
+    capable();
+    const { onGone, begin } = show();
+    await idle();
+    expect(field()).not.toBeNull();
+    begin();
+    expect(scene.handle.resume).not.toHaveBeenCalled();
+    expect(scene.handle.dispose).toHaveBeenCalledTimes(1);
+    expect(field()).toBeNull();
+    expect(onGone).toHaveBeenCalledTimes(1);
+    expect(portalTier()).toBe(1);
+  });
+
+  it("is put away when it has not drawn 1.8 s after the opening began (the box off screen then)", async () => {
+    capable();
+    const { onGone } = await running();
+    await act(async () => void vi.advanceTimersByTime(1900));
+    expect(scene.handle.dispose).toHaveBeenCalledTimes(1);
+    expect(onGone).toHaveBeenCalledTimes(1);
+    expect(portalTier()).toBe(2);
+  });
+
+  it("pauses, unseen, on a hidden tab, and goes on when she is back", async () => {
+    forceTier(2);
+    await running();
+    const canvas = field()!;
+    scene.handle.pause.mockClear();
+    scene.handle.resume.mockClear();
+    Object.defineProperty(document, "visibilityState", { configurable: true, value: "hidden" });
+    act(() => void document.dispatchEvent(new Event("visibilitychange")));
+    expect(scene.handle.pause).toHaveBeenCalled();
+    expect(canvas.classList.contains("is-away")).toBe(true);
+    Object.defineProperty(document, "visibilityState", { configurable: true, value: "visible" });
+    act(() => void document.dispatchEvent(new Event("visibilitychange")));
+    expect(scene.handle.resume).toHaveBeenCalled();
+    expect(canvas.classList.contains("is-away")).toBe(false);
+  });
+
+  it("pauses, unseen, while the box is off screen, and goes on when it is back", async () => {
+    forceTier(2);
+    let seen: ((entries: { isIntersecting: boolean }[]) => void) | null = null;
+    const observed: Element[] = [];
+    vi.stubGlobal(
+      "IntersectionObserver",
+      class {
+        constructor(cb: (entries: { isIntersecting: boolean }[]) => void) {
+          seen = cb;
+        }
+        observe(el: Element) {
+          observed.push(el);
+        }
+        disconnect() {}
+      },
+    );
+    const { anchor } = await running();
+    const canvas = field()!;
+    scene.handle.pause.mockClear();
+    scene.handle.resume.mockClear();
+    expect(observed).toEqual([anchor.current]);
+    act(() => seen!([{ isIntersecting: false }]));
+    expect(scene.handle.pause).toHaveBeenCalled();
+    expect(canvas.classList.contains("is-away")).toBe(true);
+    act(() => seen!([{ isIntersecting: true }]));
+    expect(scene.handle.resume).toHaveBeenCalled();
+    expect(canvas.classList.contains("is-away")).toBe(false);
+    vi.unstubAllGlobals();
+  });
+
+  it("is put away when paused for 10 s", async () => {
+    forceTier(2);
+    const { onGone } = await running();
+    act(() => scene.options!.onStart!());
+    Object.defineProperty(document, "visibilityState", { configurable: true, value: "hidden" });
+    act(() => void document.dispatchEvent(new Event("visibilitychange")));
+    await act(async () => void vi.advanceTimersByTime(10_100));
+    expect(scene.handle.dispose).toHaveBeenCalledTimes(1);
+    expect(onGone).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps Tier 1 when the browser cannot make a WebGL context", async () => {
+    capable();
+    scene.throws = true;
+    const { onGone } = show();
+    await idle();
+    expect(field()).toBeNull();
+    expect(onGone).toHaveBeenCalledTimes(1);
+    expect(portalTier()).toBe(1);
+  });
+
+  it("keeps Tier 1 when the scene could not arrive", async () => {
+    capable();
+    loadBloomScene.mockImplementation(() => Promise.resolve(null));
+    const { onGone } = show();
+    await idle();
+    expect(mountBloomField).not.toHaveBeenCalled();
+    expect(field()).toBeNull();
+    expect(onGone).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/src/components/portal/BloomField.tsx b/src/components/portal/BloomField.tsx
new file mode 100644
index 0000000..8ac3898
--- /dev/null
+++ b/src/components/portal/BloomField.tsx
@@ -0,0 +1,226 @@
+import { useEffect, useRef, type MutableRefObject, type RefObject } from "react";
+import { demoteTier, portalTier, probeWanted } from "@/lib/portal/tier";
+import { whenIdle } from "@/lib/portal/lazyRoom";
+import { PAPER, mixHex } from "@/lib/portal/species";
+import { loadBloomScene, type BloomFieldHandle } from "@/lib/portal/spectacle";
+
+/*
+  THE BLOOM FIELD over the unboxing (Tier 2 only; lib/portal/scene draws
+  it). Laid over today's opening without moving any of it: the box, its
+  petals and the pieces keep their own timing, and on Tier 1 nothing here
+  is made at all.
+
+  Its cost comes before the opening moves, never during it. As the room
+  shows the unboxing (after its first paint, an idle callback, and only on
+  a capable phone) the scene is fetched (asked for ahead by the room) and
+  prepared, unseen: the renderer and the room's light, the shaders, one
+  hidden frame. The unboxing holds its first move until the field says it
+  is ready (onReady), for at most FIELD_WAIT_MS, while nothing on the stage
+  moves; then the opening begins and tells the field at once, in the same
+  task (go, a ref the field fills), and the fall begins with it. A field
+  not ready by then is put away there and then, before its unseen frame
+  could land mid-opening (a phone that took that long to prepare it keeps
+  Tier 1 for the visit); one whose scene arrives too late in the wait to be
+  prepared in it (MOUNT_BY_MS) is never mounted; and one not drawn LATE_MS
+  after the opening began is put away: the fall is for the opening, never
+  after.
+
+  The canvas is fixed, pointer-events none, at z-index 37: under the room's
+  own words (38, so the title and story are never crossed), the garden path
+  (39), the header and the bag (50); it never takes a tap. The flowers fall
+  for 6 s; then the canvas fades and everything is put away, the WebGL
+  context with it. A phone the probe finds too slow fades it too.
+
+  The fall pauses, unseen, while the box is off screen or the tab is hidden,
+  and goes on when it is back; paused for 10 s, it is put away. Skip ends
+  it with the ritual, and so does the bag opening over it (the drop room
+  passes that in as `stop` as well). Leaving the room puts it away at once.
+*/
+
+type Props = {
+  accent: string;
+  seed: string;
+  /** The unboxing's stage: the fall runs while it is on screen. */
+  anchor: RefObject<Element>;
+  /** Filled by the field: the unboxing calls it, in the very task its opening begins (the fall starts then, if it is ready). */
+  go: MutableRefObject<() => void>;
+  /** Skip was tapped, or the bag opened: the fall goes. */
+  stop: boolean;
+  /** Prepared and ready to fall at once, or never to be: the opening need not wait for it. */
+  onReady: () => void;
+  /** It is over and put away, or was never started: unmount it. */
+  onGone: () => void;
+};
+
+/** The most the opening waits for the field to be prepared. */
+export const FIELD_WAIT_MS = 900;
+/** Later in the wait than this, a scene that has only just arrived is not mounted: its setup would outrun the wait. */
+const MOUNT_BY_MS = FIELD_WAIT_MS - 400;
+const LATE_MS = 1800;
+const PAUSED_MAX_MS = 10_000;
+const FADE_MS = 320;
+
+const BloomField = ({ accent, seed, anchor, go, stop, onReady, onGone }: Props) => {
+  const gone = useRef(onGone);
+  gone.current = onGone;
+  const readyFn = useRef(onReady);
+  readyFn.current = onReady;
+  const endRef = useRef<() => void>(() => {});
+
+  useEffect(() => {
+    let cancelled = false;
+    let finished = false;
+    let started = false;
+    let going = false;
+    let prepared = false;
+    let canvas: HTMLCanvasElement | null = null;
+    let handle: BloomFieldHandle | null = null;
+    let io: IntersectionObserver | null = null;
+    let onScreen = true;
+    let pausedFor = 0;
+    let fadeTimer = 0;
+    let lateTimer = 0;
+    const shown = Date.now();
+
+    const putAway = () => {
+      window.clearTimeout(pausedFor);
+      window.clearTimeout(fadeTimer);
+      window.clearTimeout(lateTimer);
+      io?.disconnect();
+      document.removeEventListener("visibilitychange", onVisibility);
+      handle?.dispose();
+      handle = null;
+      canvas?.remove();
+      canvas = null;
+    };
+    // The canvas fades (opacity only), then everything is let go.
+    const finish = (fade: boolean) => {
+      if (finished) return;
+      finished = true;
+      readyFn.current();
+      if (fade && canvas?.classList.contains("is-on")) {
+        canvas.classList.remove("is-on");
+        handle?.pause();
+        fadeTimer = window.setTimeout(() => {
+          putAway();
+          if (!cancelled) gone.current();
+        }, FADE_MS);
+        return;
+      }
+      putAway();
+      if (!cancelled) gone.current();
+    };
+    endRef.current = () => finish(true);
+
+    const sync = () => {
+      if (!handle || finished) return;
+      // Held, prepared and unseen, until the opening begins.
+      if (!going) {
+        handle.pause();
+        return;
+      }
+      const showing = onScreen && document.visibilityState !== "hidden";
+      canvas?.classList.toggle("is-away", !showing);
+      window.clearTimeout(pausedFor);
+      if (showing) handle.resume();
+      else {
+        handle.pause();
+        pausedFor = window.setTimeout(() => finish(false), PAUSED_MAX_MS);
+      }
+    };
+    function onVisibility() {
+      sync();
+    }
+
+    // The opening begins: the fall now, if it is ready; else never.
+    go.current = () => {
+      if (going || finished) return;
+      going = true;
+      if (!prepared) {
+        // Prepared too slowly for the opening (the scene was mounted): Tier 1 for the rest of her visit.
+        if (handle) demoteTier();
+        finish(false);
+        return;
+      }
+      lateTimer = window.setTimeout(() => {
+        if (!started) finish(false);
+      }, LATE_MS);
+      sync();
+    };
+
+    if (portalTier() !== 2) {
+      finish(false);
+      return;
+    }
+    const cancelIdle = whenIdle(() => {
+      void loadBloomScene().then((mod) => {
+        if (cancelled || finished) return;
+        // Not here in time to be prepared before the opening: it is not mounted mid-opening (the preview's &probe=0 waits for it).
+        if (!mod || going || (probeWanted() && Date.now() - shown > MOUNT_BY_MS)) {
+          finish(false);
+          return;
+        }
+        canvas = document.createElement("canvas");
+        canvas.className = "ig-bloomfield";
+        canvas.setAttribute("aria-hidden", "true");
+        document.body.appendChild(canvas);
+        try {
+          handle = mod.mountBloomField(canvas, {
+            colours: [accent, mixHex(accent, PAPER, 0.38)],
+            seed,
+            probe: probeWanted(),
+            onReady: () => {
+              prepared = true;
+              if (!going) readyFn.current();
+              sync();
+            },
+            onStart: () => {
+              started = true;
+              canvas?.classList.add("is-on");
+            },
+            onEnd: (why) => {
+              // Too slow for this phone, or the context was lost: Tier 1 for the rest of her visit.
+              if (why !== "done") demoteTier();
+              // A finished fall and a slow phone's both fade; a lost context has nothing left to show.
+              finish(why !== "lost");
+            },
+          });
+        } catch {
+          // A browser with WebGL that cannot make a context: the art stays as it is.
+          demoteTier();
+          finish(false);
+          return;
+        }
+        // Held until the opening begins.
+        handle.pause();
+        document.addEventListener("visibilitychange", onVisibility);
+        const stage = anchor.current;
+        if (stage && typeof IntersectionObserver !== "undefined") {
+          io = new IntersectionObserver(([entry]) => {
+            onScreen = entry.isIntersecting;
+            sync();
+          });
+          io.observe(stage);
+        }
+        sync();
+      });
+    });
+
+    return () => {
+      cancelled = true;
+      cancelIdle();
+      finished = true;
+      putAway();
+    };
+    // Once, as the room shows the unboxing.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  useEffect(() => {
+    if (stop) endRef.current();
+  }, [stop]);
+
+  return null;
+};
+
+export default BloomField;
diff --git a/src/components/portal/BudGlyph.tsx b/src/components/portal/BudGlyph.tsx
new file mode 100644
index 0000000..4924ded
--- /dev/null
+++ b/src/components/portal/BudGlyph.tsx
@@ -0,0 +1,88 @@
+import { BUD_CLOSED, BUD_OPEN, SPECIES, PAPER, mixHex, petalTransform } from "@/lib/portal/species";
+import { LEAF_SAGE } from "@/lib/portal/brandFlower";
+
+/*
+  A drop's bud for the Bloom Clock and the garden: five petals around one
+  base, folded shut until the clock opens them one by one (at 7 days,
+  3 days, 1 day, 1 hour and the opening). Each petal turns about the base on
+  the compositor, and its colour comes in by opacity, never by repainting a
+  fill. The full flower (line, bloom, pressed) is FlowerGlyph.tsx; this is
+  apart from it so the garden home, which draws only buds, never carries it.
+
+  No stylesheet of its own: the garden, the clock and the drop rooms all use it.
+*/
+
+const GOLD = "var(--nf-accent)";
+const GOLD_DEEP = "var(--nf-accent-strong)";
+
+/* CSS transforms on SVG groups turn about the drawing's own origin, which is the petals' base. */
+const PIVOT = { transformBox: "view-box", transformOrigin: "0 0" } as const;
+
+type BudProps = {
+  species: number;
+  accent: string;
+  /** Petals open, 0 to 5. */
+  open: number;
+  /** Rendered width in px. */
+  size: number;
+  className?: string;
+  /** Draws the stem and its leaf below the bud. */
+  stem?: boolean;
+  /** The clock's face: a dotted gold ring with a mark where each petal will lie, filled as it opens. */
+  dial?: boolean;
+};
+
+/* Where each petal comes to rest, in degrees from upright: the dial's marks. */
+const OPEN_DEG = [-62, 62, -31, 31, 0];
+
+export const BudGlyph = ({ species, accent, open, size, className = "", stem = true, dial = false }: BudProps) => {
+  const s = SPECIES[species] ?? SPECIES[1];
+  const pale = mixHex(accent, PAPER, 0.5);
+  const edge = dial ? 76 : 64;
+  const width = edge * 2;
+  const height = edge + (stem ? 96 : 60);
+  return (
+    <svg viewBox={`${-edge} ${-edge} ${width} ${height}`} width={size} height={Math.round((size * height) / width)} className={`ig-bud ${className}`} aria-hidden>
+      {dial && (
+        <g className="ig-bud-dial">
+          <circle r="64" fill="none" stroke={GOLD} strokeWidth="1" strokeDasharray="0.5 4" strokeLinecap="round" vectorEffect="non-scaling-stroke" />
+          {OPEN_DEG.map((deg, k) => {
+            const a = (deg * Math.PI) / 180;
+            const x = (Math.sin(a) * 70).toFixed(2);
+            const y = (-Math.cos(a) * 70).toFixed(2);
+            return (
+              <ellipse key={deg} cx={x} cy={y} rx="2.6" ry="4.4" transform={`rotate(${deg} ${x} ${y})`} fill={k < open ? accent : "none"} stroke={GOLD_DEEP} strokeWidth=".8" vectorEffect="non-scaling-stroke" />
+            );
+          })}
+        </g>
+      )}
+      {stem && (
+        <g className="ig-bud-stem">
+          <path d="M0 6C-3 34 3 62 0 94" fill="none" stroke={LEAF_SAGE} strokeWidth="2.4" strokeLinecap="round" />
+          <path d="M-1 58C-15 56-26 46-29 32C-14 35-5 44-1 58Z" fill={LEAF_SAGE} />
+        </g>
+      )}
+      {BUD_OPEN.map((to, k) => {
+        const isOpen = k < open;
+        return (
+          <g key={k} className="ig-bud-petal" data-k={k} data-open={isOpen ? "" : undefined} style={{ ...PIVOT, transform: isOpen ? to : BUD_CLOSED[k] }}>
+            <path d={s.d} transform={petalTransform(0, 56)} fill={pale} stroke={GOLD} strokeWidth=".8" vectorEffect="non-scaling-stroke" />
+            {isOpen && <path className="ig-bud-colour" d={s.d} transform={petalTransform(0, 56)} fill={accent} />}
+            <path d={s.d} transform={petalTransform(0, 56)} fill="none" stroke={GOLD_DEEP} strokeOpacity=".7" strokeWidth=".8" vectorEffect="non-scaling-stroke" />
+            <path d="M0-9C-1-20 1-30 0-40" fill="none" stroke={GOLD_DEEP} strokeOpacity=".32" strokeWidth=".7" vectorEffect="non-scaling-stroke" />
+          </g>
+        );
+      })}
+      <g className="ig-bud-sepals">
+        <path d="M0 8C-9 6-19-3-22-17C-12-13-4-6 0 8Z" fill={LEAF_SAGE} />
+        <path d="M0 8C9 6 19-3 22-17C12-13 4-6 0 8Z" fill={LEAF_SAGE} />
+      </g>
+      {open >= 5 && (
+        <g className="ig-bud-core" style={PIVOT}>
+          <circle r="9" fill={s.core} stroke={GOLD_DEEP} strokeWidth=".8" vectorEffect="non-scaling-stroke" />
+          <circle r="3" cx="-2.4" cy="-2.4" fill="#FFF8EE" />
+        </g>
+      )}
+    </svg>
+  );
+};
