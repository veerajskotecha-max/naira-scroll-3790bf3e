+import { Component, Suspense, type ReactNode } from "react";
+import { act, cleanup, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { lazyRoom } from "./lazyRoom";
+
+/* A room fetched ahead must open at once once it is in: React.lazy would
+   still show its fallback for a frame, the flash this exists to avoid. */
+
+const Room = ({ name }: { name: string }) => <h1>{name}</h1>;
+
+class Boundary extends Component<{ children: ReactNode }, { error: string | null }> {
+  state = { error: null as string | null };
+  static getDerivedStateFromError(e: unknown) {
+    return { error: e instanceof Error ? e.message : String(e) };
+  }
+  render() {
+    return this.state.error ? <p role="alert">{this.state.error}</p> : this.props.children;
+  }
+}
+
+const deferred = <T,>() => {
+  let resolve!: (v: T) => void;
+  let reject!: (e: unknown) => void;
+  const promise = new Promise<T>((res, rej) => {
+    resolve = res;
+    reject = rej;
+  });
+  return { promise, resolve, reject };
+};
+
+afterEach(cleanup);
+
+describe("lazyRoom", () => {
+  it("waits on its fallback only while the chunk is on its way, and opens at once after", async () => {
+    const chunk = deferred<{ default: typeof Room }>();
+    const load = vi.fn(() => chunk.promise);
+    const Lazy = lazyRoom(load);
+    const first = render(
+      <Suspense fallback={<p>Opening the room…</p>}>
+        <Lazy name="Your stone" />
+      </Suspense>,
+    );
+    expect(screen.getByText("Opening the room…")).toBeInTheDocument();
+    expect(Lazy.isLoaded()).toBe(false);
+    await act(async () => chunk.resolve({ default: Room }));
+    expect(screen.getByRole("heading", { name: "Your stone" })).toBeInTheDocument();
+    first.unmount();
+
+    // Fetched once; and once in, a new visit never shows the fallback, not even for a frame.
+    const fallback = vi.fn(() => <p>Opening the room…</p>);
+    const Fallback = () => fallback();
+    render(
+      <Suspense fallback={<Fallback />}>
+        <Lazy name="Your stone" />
+      </Suspense>,
+    );
+    expect(screen.getByRole("heading", { name: "Your stone" })).toBeInTheDocument();
+    expect(fallback).not.toHaveBeenCalled();
+    expect(Lazy.isLoaded()).toBe(true);
+    await Lazy.preload();
+    expect(load).toHaveBeenCalledTimes(1);
+  });
+
+  it("opens at once when it was fetched ahead of its first visit", async () => {
+    const Lazy = lazyRoom(async () => ({ default: Room }));
+    await Lazy.preload();
+    render(
+      <Suspense fallback={<p>Opening the room…</p>}>
+        <Lazy name="Ahead" />
+      </Suspense>,
+    );
+    expect(screen.getByRole("heading", { name: "Ahead" })).toBeInTheDocument();
+    expect(screen.queryByText("Opening the room…")).toBeNull();
+  });
+
+  it("hands a chunk her visit could not fetch to the error boundary, once, and asks again only when told to", async () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const load = vi.fn().mockRejectedValueOnce(new Error("chunk failed")).mockResolvedValue({ default: Room });
+    const Lazy = lazyRoom<{ name: string }>(load);
+    render(
+      <Boundary>
+        <Suspense fallback={<p>Opening the room…</p>}>
+          <Lazy name="Later" />
+        </Suspense>
+      </Boundary>,
+    );
+    expect(await screen.findByRole("alert")).toHaveTextContent("chunk failed");
+    // React's own retry of the failed render fetched nothing more: no loop of fetches.
+    expect(load).toHaveBeenCalledTimes(1);
+    cleanup();
+    await Lazy.preload();
+    render(
+      <Suspense fallback={<p>Opening the room…</p>}>
+        <Lazy name="Later" />
+      </Suspense>,
+    );
+    expect(screen.getByRole("heading", { name: "Later" })).toBeInTheDocument();
+    expect(load).toHaveBeenCalledTimes(2);
+    vi.restoreAllMocks();
+  });
+
+  it("never lets a fetch made ahead that failed stand in for her visit: opening the room asks again", async () => {
+    const load = vi.fn().mockRejectedValueOnce(new Error("offline a moment")).mockResolvedValue({ default: Room });
+    const Lazy = lazyRoom<{ name: string }>(load);
+    await Lazy.preload();
+    expect(Lazy.isLoaded()).toBe(false);
+    render(
+      <Boundary>
+        <Suspense fallback={<p>Opening the room…</p>}>
+          <Lazy name="Again" />
+        </Suspense>
+      </Boundary>,
+    );
+    expect(await screen.findByRole("heading", { name: "Again" })).toBeInTheDocument();
+    expect(screen.queryByRole("alert")).toBeNull();
+    expect(load).toHaveBeenCalledTimes(2);
+  });
+
+  it("treats a module that arrives without its room as a failure, never a blank room", async () => {
+    vi.spyOn(console, "error").mockImplementation(() => {});
+    const Lazy = lazyRoom<{ name: string }>(async () => undefined as unknown as { default: typeof Room });
+    render(
+      <Boundary>
+        <Suspense fallback={<p>Opening the room…</p>}>
+          <Lazy name="Nothing" />
+        </Suspense>
+      </Boundary>,
+    );
+    expect(await screen.findByRole("alert")).toBeInTheDocument();
+    vi.restoreAllMocks();
+  });
+});
