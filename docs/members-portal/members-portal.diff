+++ b/src/lib/portal/fit.ts
@@ -0,0 +1,166 @@
+import type { JewelPiece, JewelVariant } from "@/data/jewellery";
+import { adjustableSizes, isAdjustableRing } from "@/data/ringFit";
+import { cartLineFor, choiceNeeded, choices, findVariant, initialChoice, sizeOption } from "@/lib/variants";
+import type { BagLine } from "@/components/portal/MemberContext";
+import type { Metal, UsSize } from "./memberMeta";
+import { MONTH_OPTION, variantForMonth } from "./stonePiece";
+import { familyOf } from "./family";
+
+/*
+  Whether a piece fits her, read the way its product page sells it:
+  - a ring Shopify sells in sizes fits when the variant in her size (and her
+    metal, where it comes in both) is available;
+  - an open-back ring adjusts to every size it offers (data/ringFit, the
+    product page's own list and Shopify's "Adjustable" tag), so it fits when
+    the piece is available and her size is one of them; her size rides on
+    the bag line as a note, as the product page sends it;
+  - a closed ring sold one way is stocked in US 6 (the product page offers
+    US 5 and 7 as pre-orders on WhatsApp), so it fits only a US 6.
+  Availability is only Shopify's availableForSale; nothing here counts stock.
+
+  Gold or silver is the listing's own (familyOf, ./family).
+*/
+
+const METAL_WORD: Record<Exclude<Metal, "b">, RegExp> = { g: /gold/i, s: /silver|rhodium/i };
+
+/** The option that carries the metal ("Metal", "Colour"), when the piece comes in both. */
+const metalOption = (piece: JewelPiece) => choices(piece).find((o) => /metal|colou?r|finish|tone/i.test(o.name) && o.values.some((v) => /gold|silver|rhodium/i.test(v)))?.name;
+
+/** Whether a piece comes in her metal: one of its variants, or the listing itself. */
+export const inMetal = (piece: JewelPiece, metal: Metal | undefined): boolean => {
+  if (!metal || metal === "b") return true;
+  const option = metalOption(piece);
+  if (option) return (piece.options?.find((o) => o.name === option)?.values ?? []).some((v) => METAL_WORD[metal].test(v));
+  return familyOf(piece) === (metal === "g" ? "gold" : "silver");
+};
+
+export type RingKind = "sized" | "adjustable" | "fixed";
+
+export type Fit = {
+  kind: RingKind | "none";
+  /** Her size can be bought now. */
+  fits: boolean;
+  /** The US sizes that can be bought now ("5", "7"), in the shop's order. */
+  sizesLeft: string[];
+  /** The variant a bag line takes for her (her size, her metal, her month). */
+  variant?: JewelVariant;
+  /** Her size as the bag line's note, for a ring sold one way ("US 6"). */
+  note?: string;
+};
+
+export const ringKind = (piece: JewelPiece): RingKind | "none" => {
+  if (piece.category !== "Rings") return sizeOption(piece) ? "sized" : "none";
+  if (sizeOption(piece)) return "sized";
+  return isAdjustableRing(piece) ? "adjustable" : "fixed";
+};
+
+/** The variant she would take: her metal and month where it has them, else the page's opening choice. */
+const preferredChoice = (piece: JewelPiece, metal: Metal | undefined, month: number | null): Record<string, string> => {
+  let chosen = initialChoice(piece);
+  const mo = metalOption(piece);
+  if (mo && metal && metal !== "b") {
+    const value = piece.options?.find((o) => o.name === mo)?.values.find((v) => METAL_WORD[metal].test(v));
+    if (value) chosen = { ...chosen, [mo]: value };
+  }
+  if (month && chosen[MONTH_OPTION] !== undefined) {
+    const hers = variantForMonth(piece, month);
+    if (hers) chosen = { ...chosen, [MONTH_OPTION]: hers.options[MONTH_OPTION] };
+  }
+  return chosen;
+};
+
+const FIXED_STOCKED = ["6"];
+
+export const fitFor = (piece: JewelPiece, us: UsSize | null | undefined, metal?: Metal, month: number | null = null): Fit => {
+  const kind = ringKind(piece);
+  const size = us ? String(us) : null;
+  const chosen = preferredChoice(piece, metal, month);
+  if (kind === "sized") {
+    const name = sizeOption(piece) as string;
+    const values = piece.options?.find((o) => o.name === name)?.values ?? [];
+    const variants = piece.variants ?? [];
+    // The sizes the shop has in her metal where it has one, else in any.
+    const mo = metalOption(piece);
+    const either = !mo || !metal || metal === "b";
+    const sameMetal = (v: JewelVariant) => either || v.options[mo as string] === chosen[mo as string];
+    const sizesLeft = values.filter((value) => variants.some((v) => v.availableForSale && v.options[name] === value && sameMetal(v)));
+    const exact = size ? findVariant(piece, { ...chosen, [name]: size }) : undefined;
+    const anyMetal = size ? variants.find((v) => v.availableForSale && v.options[name] === size) : undefined;
+    const variant = exact?.availableForSale ? exact : either ? anyMetal : undefined;
+    return { kind, fits: Boolean(variant), sizesLeft, variant };
+  }
+  const variant = piece.variants?.length ? findVariant(piece, chosen) : undefined;
+  const available = variant ? variant.availableForSale : piece.availableForSale;
+  if (kind === "adjustable") {
+    const sizes = available ? adjustableSizes(piece.handle) : [];
+    return { kind, fits: Boolean(size && sizes.includes(size)), sizesLeft: sizes, variant, note: size ? `US ${size}` : undefined };
+  }
+  if (kind === "fixed") {
+    const sizes = available ? FIXED_STOCKED : [];
+    return { kind, fits: Boolean(size && sizes.includes(size)), sizesLeft: sizes, variant, note: size ? `US ${size}` : undefined };
+  }
+  return { kind: "none", fits: available, sizesLeft: [], variant };
+};
+
+/** Her bag line for a piece that fits: her size (as a variant, or as the note a ring sold one way carries), metal and month. */
+export const fittedLine = (piece: JewelPiece, fit: Fit): BagLine => ({
+  ...cartLineFor(piece, fit.variant),
+  ...(fit.note && (fit.kind === "adjustable" || fit.kind === "fixed") ? { size: fit.note } : {}),
+});
+
+export type FittedRing = { piece: JewelPiece; fit: Fit };
+
+/**
+ * "Rings in your size, in stock now" and the open-back rings that adjust to
+ * her: only what Shopify says is available, in her metal (or both).
+ */
+export const ringsFor = (catalogue: readonly JewelPiece[], us: UsSize, metal?: Metal): { sized: FittedRing[]; adjustable: FittedRing[] } => {
+  const sized: FittedRing[] = [];
+  const adjustable: FittedRing[] = [];
+  for (const piece of catalogue) {
+    if (piece.category !== "Rings" || !inMetal(piece, metal)) continue;
+    const fit = fitFor(piece, us, metal);
+    if (!fit.fits) continue;
+    (fit.kind === "adjustable" ? adjustable : sized).push({ piece, fit });
+  }
+  return { sized, adjustable };
+};
+
+export type Preset = {
+  fit: Fit;
+  /** The bag line with her size, metal and month already chosen; null when a choice is still hers to make. */
+  line: BagLine | null;
+  /** What she still has to choose (on the piece's page), when `line` is null. */
+  needs: "size" | "month" | null;
+  price: number;
+  compareAtPrice?: number;
+  available: boolean;
+};
+
+/** A piece as it would go in her bag: her size, metal and month chosen where the shop sells it that way, nothing guessed. */
+export const presetFor = (piece: JewelPiece, us: UsSize | null | undefined, metal?: Metal, month: number | null = null): Preset => {
+  const fit = fitFor(piece, us, metal, month);
+  const v = fit.variant;
+  const price = v?.price ?? piece.price;
+  const compareAtPrice = v ? v.compareAtPrice : piece.compareAtPrice;
+  const available = fit.kind === "sized" ? Boolean(v?.availableForSale) || (!us && fit.sizesLeft.length > 0) : v ? v.availableForSale : piece.availableForSale;
+  const needed = choiceNeeded(piece);
+  let needs: Preset["needs"] = null;
+  if (fit.kind !== "none") needs = us ? null : "size";
+  else if (needed === "size") needs = "size";
+  else if (needed === "month" && !month) needs = "month";
+  const line = needs || !available || (fit.kind !== "none" && !fit.fits) ? null : fittedLine(piece, fit);
+  return { fit, line, needs, price, compareAtPrice, available };
+};
+
+const sizeList = (sizes: readonly string[]) => sizes.map((s) => `US ${s}`).join(", ");
+
+/** The fit line's words: a lead ("In your size") and the rest ("US 6", or the sizes the shop has now). Never a promise that it fits her finger: her size is a guide. */
+export const fitWords = (fit: Fit, us: number | null | undefined): { lead: string | null; rest: string | null } => {
+  const left = fit.sizesLeft;
+  if (fit.kind === "none" && !left.length) return { lead: null, rest: null };
+  if (us && fit.fits) return { lead: fit.kind === "adjustable" ? "Adjusts to your size" : "In your size", rest: `US ${us}` };
+  if (fit.kind === "adjustable") return { lead: null, rest: left.length ? `Adjusts from US ${left[0]} to ${left[left.length - 1]}` : null };
+  if (!left.length) return { lead: null, rest: null };
+  return { lead: null, rest: us ? `Not in US ${us} just now. Available in ${sizeList(left)}` : `Available in ${sizeList(left)}` };
+};
