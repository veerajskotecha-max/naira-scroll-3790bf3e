+
+const GardenHome = () => {
+  const member = useMember();
+  const { user, firstName, doorsPlayed, markDoorsPlayed, drops, naira, arrival, month, firstVisit, arrivalProfile, garden: overrides } = member;
+  // The sky in India now, today's festival row (the owner's table), and the atelier's notes.
