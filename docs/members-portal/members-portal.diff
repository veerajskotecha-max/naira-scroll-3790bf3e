+import { Suspense, lazy, useCallback, useEffect, useLayoutEffect, useMemo, useState, type ReactElement } from "react";
+import { Navigate, Route, Routes, useLocation } from "react-router-dom";
+import { useAuth } from "@/contexts/AuthContext";
+import { useCart } from "@/contexts/CartContext";
+import { getSupabase } from "@/integrations/supabase/lazy";
+import { MemberProvider, firstNameOf, type BagLine, type Member, type SaveResult } from "@/components/portal/MemberContext";
+import { logPreviewWrite, previewHost, readPreviewMember } from "@/lib/portal/preview";
+import { DROPS } from "@/lib/portal/drops";
+import { claimPressed, pressDrop, readPressed, type Pressed } from "@/lib/portal/pressed";
+import { istDayKey } from "@/lib/portal/ist";
+import { serverNow } from "@/lib/portal/clock";
+import { HOUR, inMembersWindow, timeOf } from "@/lib/portal/dropPhase";
+import { hasDropFlag, readPortal, writePortal } from "@/lib/portal/safeStorage";
+import { firstVisit as isFirstVisit, mergePressed, pressInto, sinceFor, touchSeen } from "@/lib/portal/memberMeta";
+import { monthOfBirthday } from "@/lib/portal/stones";
+import { useMemberMeta } from "@/lib/portal/useMemberMeta";
+import type { ArrivalActions, JoinFn } from "@/lib/portal/arrival";
+import { lazyRoom, whenIdle } from "@/lib/portal/lazyRoom";
+import PortalShell from "@/components/portal/PortalShell";
+import Gate from "./Gate";
+import GardenHome from "./GardenHome";
+import "./members.css";
+
+/* The drop rooms are their own chunks, each with its own stylesheet, fetched
+   when she opens one: the garden and her stone never carry them. */
+const Drops = lazy(() => import("./Drops"));
+const DropRoom = lazy(() => import("./DropRoom"));
+const Vault = lazy(() => import("./Vault"));
+/* Phase 3's rooms, the same way: her fit (with the ring sizer a further
+   chunk of its own), the Jewel drawer and the Herbarium. */
+const Fit = lazy(() => import("./Fit"));
+const Drawer = lazy(() => import("./Drawer"));
+const Herbarium = lazy(() => import("./Herbarium"));
+/* Phase 4's rooms, each its own chunk with its own stylesheet: the gift
+   ledger, the Order Desk, Care and her garden card (its renderer a further
+   chunk of its own). */
+const Gifts = lazy(() => import("./Gifts"));
+const Orders = lazy(() => import("./Orders"));
+const Care = lazy(() => import("./Care"));
+const Card = lazy(() => import("./Card"));
+/* Your stone (its seed ceremony and specimen card) too: the garden home
+   needs none of it for its first paint. It is fetched ahead, so the tab and
+   the garden's card open it without a wait: at once when she arrives at it
+   (alongside her sign-in), otherwise once the garden has settled, after the
+   Doors. */
+const Stone = lazyRoom(() => import("./Stone"));
+const STONE_AHEAD_MS = 2500;
+const AT_STONE = /^\/members\/stone\/?$/;
+
+const NO_HANDLES: readonly string[] = [];
+
+/* The arrival repair's writes (lib/portal/arrival) are made only from its
+   card, on her first visit, so they ride in the card's chunk: each action
+   fetches them at its first call, which only the card makes (and by then the
+   card's own chunk has brought them in). */
+const onFirstCall = (load: () => Promise<ArrivalActions>): ArrivalActions => {
+  let actions: Promise<ArrivalActions> | null = null;
+  const get = () =>
+    (actions ??= load().catch((error: unknown) => {
+      actions = null;
+      throw error;
+    }));
+  return {
+    hasOwnSignup: (userId) => get().then((a) => a.hasOwnSignup(userId)),
+    join: (input) => get().then((a) => a.join(input)),
+    saveConsent: (userId, yes) => get().then((a) => a.saveConsent(userId, yes)),
+  };
+};
+
+/* The shop's own insert (lib/innerCircle), named only for the owner's switch
+   (ARRIVAL_JOIN_TELLS_META): fetched, with the parser it checks an email
+   with, at its first call, so her garden never downloads it to say nothing. */
+const joinInnerCircle: JoinFn = (input) => import("@/lib/innerCircle").then((m) => m.joinInnerCircle(input));
+
+const RoomWait = () => (
+  <PortalShell title="The Inner Garden" description="The Inner Garden, Naira Flore's members' portal.">
+    <p className="ig-lede ig-wait" role="status">
+      Opening the room…
+    </p>
+  </PortalShell>
+);
+
+const room = (node: ReactElement) => <Suspense fallback={<RoomWait />}>{node}</Suspense>;
+
+/*
+  /members/* — The Inner Garden. One lazy, noindexed route (Disallowed in
+  robots.txt, kept out of scripts/routes.ts and the sitemap, left out of the
+  shopper telemetry). While sign-in is still being read the gate stays closed,
+  never flashing the signed-out page at a member; signed out, the Gate; signed
+  in, her rooms.
+
+  Signed in is not yet enough: the sign-in answers before her profile row
+  does, and her birthday and name live there. Until that row has been read
+  once (or PROFILE_WAIT_MS has passed, so a slow network never keeps her
+  out), the gate stays closed too. Otherwise her garden would open on a bud
+  that then turns into her stone, and Your stone would ask for a birthday she
+  has already given.
+
+  In development only, on this machine, ?portalPreview=1 stands in a member
+  (see lib/portal/preview.ts), and &drop=… a preview drop in any state. The check sits behind import.meta.env.DEV,
+  which a production build replaces with false, so the preview is not in the
+  build.
+*/
+
+export const PROFILE_WAIT_MS = 2500;
+
+/*
+  The shop's global stylesheet sets overflow-x: hidden on html and body, which
+  makes body its own scroll container: position: sticky then never sticks,
+  and the garden path would only ever appear at the end of a page. While the
+  portal is open, a small style of its own sets both to clip (no scroll
+  container, the same "no sideways scroll"), as the product page does for its
+  sticky column; leaving removes it. A style element rather than inline
+  styles, because the shop's own scroll locks reset body's inline overflow.
+  The global stylesheet itself is untouched.
+*/
+const STICKY_ROOM = "@supports (overflow-x: clip) { html, body { overflow-x: clip; } }";
+const useStickyRoom = () => {
+  useLayoutEffect(() => {
+    const style = document.createElement("style");
+    style.setAttribute("data-ig-room", "");
+    style.textContent = STICKY_ROOM;
+    document.head.appendChild(style);
+    return () => style.remove();
+  }, []);
+};
+
+const MembersRoute = () => {
+  useStickyRoom();
+  const { pathname } = useLocation();
+  const [arrivedAtStone] = useState(() => AT_STONE.test(pathname));
+  /* Arriving at her stone, the gate stays closed until its room is in, so
+     it opens as it always has (the gate, then her stone), never on
+     "Opening the room…" between. */
+  const [stoneIn, setStoneIn] = useState(() => !arrivedAtStone || Stone.isLoaded());
+  useEffect(() => {
+    if (!arrivedAtStone) return;
+    let live = true;
+    void Stone.preload().then(() => {
+      if (live) setStoneIn(true);
+    });
+    return () => {
+      live = false;
+    };
+  }, [arrivedAtStone]);
+  const auth = useAuth();
+  const { addItem, setDrawerOpen, buyNow: cartBuyNow, isLoading: bagBusy } = useCart();
+  const [preview, setPreview] = useState(() =>
+    import.meta.env.DEV && previewHost(window.location.hostname) ? readPreviewMember(window.location.search) : null,
+  );
+  const [doorsPlayed, setDoorsPlayed] = useState(false);
+  const markDoorsPlayed = useCallback(() => setDoorsPlayed(true), []);
+
+  const user = preview?.user ?? auth.user;
+  const profile = preview ? preview.profile : auth.profile;
+  const { refreshProfile } = auth;
+  const memberId = user?.id;
+  const previewDrops = preview ? preview.drops : null;
+  const previewGarden = preview ? preview.garden : null;
+  const drops = previewDrops?.drops ?? DROPS;
+
+  /* Her account's memory (user_metadata.naira). The preview member's lives in
+     memory and is printed to the console instead of written. */
+  const meta = useMemberMeta(user, import.meta.env.DEV && preview ? (naira) => logPreviewWrite("user_metadata.naira", naira) : null);
+  const { naira, change: changeMeta, problem: metaProblem, retry: retryMeta } = meta;
+
+  // The day each flower was pressed, kept on this device; the flowers themselves are in her account.
+  const [devicePressed, setDevicePressed] = useState<Pressed[]>(() => readPressed(memberId));
+  const pressed = useMemo(() => {
+    const days = new Map(devicePressed.map((p) => [p.id, p.on]));
+    // One pressed here that her account has not taken (yet) still shows: a press is never left half-done on screen.
+    const ids = [...naira.pressed, ...devicePressed.map((p) => p.id).filter((id) => !naira.pressed.includes(id))];
+    return ids.map((id) => ({ id, on: days.get(id) ?? "" }));
+  }, [naira.pressed, devicePressed]);
+
+  /* Once per sign-in, as she arrives: the day she was last here (for "Since
+     you were last here"), whether this is her first signed-in visit (the
+     arrival repair's one day; a reload on this phone that day still is),
+     today's visit (written at most once an IST day), and the flowers pressed
+     on this phone before Phase 3, moved into her account. */
+  const [since, setSince] = useState<string | null>(null);
+  const [firstVisit, setFirstVisit] = useState(false);
+  useLayoutEffect(() => {
+    if (!memberId) return;
+    const today = istDayKey(new Date(serverNow()));
+    const store = readPortal();
+    const local = store.lastVisitLocal?.u === memberId ? store.lastVisitLocal : null;
+    const from = sinceFor(naira.seen?.last, today, local);
+    const first = isFirstVisit(naira.seen?.last, today, local?.first);
+    setSince(from);
+    setFirstVisit(first);
+    writePortal({ lastVisitLocal: { u: memberId, day: today, since: from, ...(first ? { first: today } : {}) } });
+    const onDevice = readPressed(memberId);
+    setDevicePressed(onDevice);
+    const moving = onDevice.map((p) => p.id).filter((id) => !naira.pressed.includes(id));
+    // Two changes, so a move her account cannot take never holds back today's visit.
+    changeMeta(touchSeen(today));
+    if (moving.length) {
+      changeMeta(mergePressed(moving));
+      claimPressed(memberId);
+    }
+    // On arrival only, for each member.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [memberId]);
+
+  const press = useCallback(
+    (dropId: string) => {
+      const now = serverNow();
+      const drop = drops.find((d) => d.id === dropId);
+      // Pressed only in its members' window, so a filled Herbarium frame means she opened it while it was members' first.
+      if (!drop || !inMembersWindow(drop, now)) return;
+      setDevicePressed(pressDrop(dropId, istDayKey(new Date(now)), memberId));
+      // Front Row: she opened it in its first hour (on this phone), or presses it within that hour.
+      const early = now < timeOf(drop.membersFrom) + HOUR || hasDropFlag("early", dropId);
+      changeMeta(pressInto(dropId, early));
+    },
+    [memberId, drops, changeMeta],
+  );
+
+  // Her profile, read once for this sign-in before her rooms open.
+  const uid = auth.user?.id ?? null;
+  const profileId = auth.profile?.id ?? null;
+  const [profileRead, setProfileRead] = useState<string | null>(null);
+  const profileReady = Boolean(preview) || !uid || profileId === uid || profileRead === uid;
+  useEffect(() => {
+    if (profileReady || !uid) return;
+    let live = true;
+    const settle = () => {
+      if (live) setProfileRead(uid);
+    };
+    const ceiling = window.setTimeout(settle, PROFILE_WAIT_MS);
+    // No row yet (a new member) reads as null and still lets her in.
+    refreshProfile().then(settle, settle);
+    return () => {
+      live = false;
+      window.clearTimeout(ceiling);
+    };
+  }, [profileReady, uid, refreshProfile]);
+
+  const saveBirthday = useCallback(
+    async (birthday: string): Promise<SaveResult> => {
+      if (!user) return { ok: false, message: "Please sign in again." };
+      if (import.meta.env.DEV && preview) {
+        logPreviewWrite("profiles.birthday", { id: user.id, birthday });
+        setPreview({ ...preview, profile: { ...preview.profile, birthday } });
+        return { ok: true };
+      }
+      try {
+        const supabase = await getSupabase();
+        // Her own row, through the same row security Account's details form uses.
+        const { error } = await supabase.from("profiles").upsert({ id: user.id, birthday } as never);
+        if (error) return { ok: false, message: "We couldn't save your birthday. Please try again." };
+        await refreshProfile();
+        return { ok: true };
+      } catch {
+        return { ok: false, message: "We couldn't reach your account. Please try again." };
+      }
+    },
+    [user, preview, refreshProfile],
+  );
+
+  /* Her profile as it was when her rooms opened: the arrival repair decides
+     what to ask from this, so a birthday she saves this visit (which moves
+     her row's updated_at) never takes a question away mid-visit. */
+  const roomsOpen = Boolean(user) && (Boolean(preview) || (!auth.loading && profileReady));
+  const [opened, setOpened] = useState<{ u: string; profile: typeof profile } | null>(null);
+  if (roomsOpen && memberId && opened?.u !== memberId) setOpened({ u: memberId, profile });
+  const arrivalProfile = opened && opened.u === memberId ? opened.profile : profile;
+
+  // Her month: her birthday's, or the month alone she kept.
+  const month = monthOfBirthday(profile?.birthday) ?? naira.month ?? null;
+
+  /* The arrival repair (on the garden home, after the Doors): her own list
+     row and her own profile row, or, for the preview member, console lines
+     instead of writes. The list row goes in through the portal's own quiet
+     copy of the insert, which tells Meta nothing, until the owner approves
+     the shop's Lead and Subscribe events for it (ARRIVAL_JOIN_TELLS_META). */
+  const previewing = Boolean(preview);
+  const arrival = useMemo<ArrivalActions>(
+    () =>
+      import.meta.env.DEV && previewing
+        ? onFirstCall(() => import("@/lib/portal/arrival").then(({ previewArrivalActions }) => previewArrivalActions(logPreviewWrite)))
+        : onFirstCall(() =>
+            import("@/lib/portal/arrival").then(({ ARRIVAL_JOIN_TELLS_META, joinListQuietly, liveArrivalActions }) =>
+              liveArrivalActions(ARRIVAL_JOIN_TELLS_META ? joinInnerCircle : joinListQuietly, refreshProfile),
+            ),
+          ),
+    [previewing, refreshProfile],
+  );
+
+  /* The bag never throws: when Shopify refuses (sold out a moment ago, a
+     timeout) addItem answers null and the open bag says why. So the card
+     says "In your bag." only on a real add. */
+  const addToBag = useCallback(
+    async (line: BagLine): Promise<boolean> => {
+      if (import.meta.env.DEV && preview) {
+        logPreviewWrite("bag line", line);
+        return true;
+      }
+      setDrawerOpen(true);
+      try {
+        return Boolean(await addItem(line));
+      } catch {
+        return false;
+      }
+    },
+    [preview, addItem, setDrawerOpen],
+  );
+
+  const buyNow = useCallback(
+    async (line: BagLine): Promise<void> => {
+      if (import.meta.env.DEV && preview) {
+        logPreviewWrite("buy now (no checkout opened)", line);
+        return;
+      }
+      try {
+        await cartBuyNow(line);
+      } catch {
+        /* the bag says why */
+      }
+    },
+    [preview, cartBuyNow],
+  );
+
+  // Her stone, fetched once her rooms are open and the Doors have had their time.
+  useEffect(() => (roomsOpen ? whenIdle(() => void Stone.preload(), STONE_AHEAD_MS) : undefined), [roomsOpen]);
+
+  const member = useMemo<Member | null>(
+    () =>
+      user
+        ? {
+            user,
+            profile,
+            firstName: firstNameOf(profile, user) || "friend",
+            preview: Boolean(preview),
+            saveBirthday,
+            addToBag,
+            buyNow,
+            bagBusy: Boolean(bagBusy),
+            doorsPlayed,
+            markDoorsPlayed,
+            drops,
+            unlisted: previewDrops?.unlisted ?? NO_HANDLES,
+            checkoutsPreview: preview?.checkouts ?? null,
+            pressed,
+            press,
+            naira,
+            changeMeta,
+            metaProblem,
+            retryMeta,
+            since,
+            month,
+            firstVisit,
+            arrivalProfile,
+            arrival,
+            garden: previewGarden,
+          }
+        : null,
+    [user, profile, preview, saveBirthday, addToBag, buyNow, bagBusy, doorsPlayed, markDoorsPlayed, drops, previewDrops, pressed, press, naira, changeMeta, metaProblem, retryMeta, since, month, firstVisit, arrivalProfile, arrival, previewGarden],
+  );
+
+  if (!preview && (auth.loading || !profileReady)) return <Gate loading />;
+  if (!member) return <Gate />;
+  if (!stoneIn) return <Gate loading />;
+
+  return (
+    <MemberProvider value={member}>
+      <Routes>
+        <Route index element={<GardenHome />} />
+        <Route path="stone" element={room(<Stone />)} />
+        <Route path="drops" element={room(<Drops />)} />
+        <Route path="drops/:dropId" element={room(<DropRoom />)} />
+        <Route path="vault" element={room(<Vault />)} />
+        <Route path="fit" element={room(<Fit />)} />
+        <Route path="drawer" element={room(<Drawer />)} />
+        <Route path="herbarium" element={room(<Herbarium />)} />
+        <Route path="gifts" element={room(<Gifts />)} />
+        <Route path="orders" element={room(<Orders />)} />
+        <Route path="care" element={room(<Care />)} />
+        <Route path="card" element={room(<Card />)} />
+        <Route path="*" element={<Navigate to="/members" replace />} />
+      </Routes>
+    </MemberProvider>
+  );
+};
+
+export default MembersRoute;
