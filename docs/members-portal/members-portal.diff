index 0000000..7dc1ff7
--- /dev/null
+++ b/src/components/portal/SinceLastVisit.tsx
@@ -0,0 +1,104 @@
+import { useMemo } from "react";
+import { Link } from "react-router-dom";
+import type { JewelPiece } from "@/data/jewellery";
+import { sinceShoots, useNewIn } from "@/lib/portal/newIn";
+import { serverNow } from "@/lib/portal/clock";
+import { formatIstDay } from "@/lib/portal/ist";
+import { presetFor } from "@/lib/portal/fit";
+import type { Metal, UsSize } from "@/lib/portal/memberMeta";
+import type { BagLine } from "./MemberContext";
+import PieceCard from "./PieceCard";
+import KeptNote from "./KeptNote";
+import { quietButton } from "./styles";
+
+/*
+  SINCE YOU WERE LAST HERE: the pieces the shop published after the day she
+  last came (her account remembers the day, written at most once a day),
+  newest first, each dated as it arrived. The dates come from the portal's
+  own small query (New in the garden's); price and stock from the live
+  catalogue. On her first visit there is no "last time", and it says so.
+  On a second phone the same day her account already says today (it keeps
+  the day, not the visit before it), so there is nothing to count from: it
+  says she was here earlier today, never that this is her first visit.
+*/
+
+type Props = {
+  since: string | null;
+  /** Her first signed-in visit; with no `since` otherwise, she was here earlier today (another phone). */
+  firstVisit: boolean;
+  catalogue: JewelPiece[];
+  live: boolean;
+  us: UsSize | null;
+  metal: Metal | undefined;
+  month: number | null;
+  saved: readonly string[];
+  preview: boolean;
+  bagBusy: boolean;
+  onAdd: (line: BagLine) => Promise<boolean>;
+  onKeep: (handle: string) => void;
+  /** Pieces kept this visit, with what was let go to make room (or ""). */
+  kept: Readonly<Record<string, string>>;
+};
+
+const SinceLastVisit = ({ since, firstVisit, catalogue, live, us, metal, month, saved, preview, bagBusy, onAdd, onKeep, kept }: Props) => {
+  const { data, isError, isLoading } = useNewIn(Boolean(since));
+  const shoots = useMemo(() => (since && data && live ? sinceShoots(data, since, serverNow(), catalogue) : []), [since, data, live, catalogue]);
+  const day = since ? formatIstDay(`${since}T12:00:00+05:30`) : null;
+
+  return (
+    <section className="ig-section" aria-labelledby="ig-since">
+      <h2 id="ig-since" className="ig-h2">
+        Since you were last here
+      </h2>
+      {!since ? (
+        <p className="ig-fineprint">
+          {firstVisit
+            ? "This is your first visit to the garden. From your next, the pieces added since will gather here."
+            : "You were here earlier today. The pieces the shop adds after today will gather here."}
+        </p>
+      ) : isLoading && !shoots.length ? (
+        <p className="ig-fineprint" role="status">
+          Reading the newest pieces from the shop…
+        </p>
+      ) : isError || !live ? (
+        <p className="ig-fineprint">
+          We couldn't reach the shop just now.{" "}
+          <Link className="ig-link" to="/jewellery">
+            See the shop
+          </Link>
+        </p>
+      ) : shoots.length === 0 ? (
+        <p className="ig-fineprint">Nothing added to the shop after {day}, when you were last here. New pieces will gather here.</p>
+      ) : (
+        <>
+          <p className="ig-fineprint">Added to the shop after {day}, when you were last here. Newest first.</p>
+          <ul className="ig-pcs">
+            {shoots.map(({ piece, arrived }) => (
+              <li key={piece.handle}>
+                <PieceCard
+                  piece={piece}
+                  preset={presetFor(piece, us, metal, month)}
+                  note={arrived}
+                  extra={(named) =>
+                    saved.includes(piece.handle) ? (
+                      <KeptNote handle={piece.handle} name={piece.name} fresh={piece.handle in kept} note={kept[piece.handle]} />
+                    ) : (
+                      <button type="button" className={quietButton} onClick={() => onKeep(piece.handle)} aria-describedby={named}>
+                        Keep in my drawer
+                      </button>
+                    )
+                  }
+                  preview={preview}
+                  bagBusy={bagBusy}
+                  onAdd={onAdd}
+                />
+              </li>
+            ))}
+          </ul>
+        </>
+      )}
+    </section>
+  );
+};
+
+export default SinceLastVisit;
diff --git a/src/components/portal/SkyLayer.tsx b/src/components/portal/SkyLayer.tsx
