+
+  it("keeps one id for one date, so adding it twice updates one event", () => {
+    expect(giftDayEvent(gift("Mum", 3, 14), now).uid).toBe(giftDayEvent(gift("Mum", 3, 14), now + 86_400_000 * 40).uid);
+    expect(giftDayEvent(gift("Mum", 3, 14), now).uid).not.toBe(giftDayEvent(gift("Mom", 3, 14), now).uid);
+    expect(giftDayEvent(gift("माँ", 3, 14), now).uid).toMatch(/^gift-0314-[0-9a-f]+$/);
+  });
+});
+
+describe("picks within her budget", () => {
+  const catalogue = jewellerySnapshot as JewelPiece[];
+
+  it("gives nothing before the live shop has answered", () => {
+    expect(picksWithin(catalogue, false, 2500)).toEqual([]);
+  });
+
+  it("gives three in-stock pieces at or under the band, never the stone necklace, rings last", () => {
+    const picks = picksWithin(catalogue, true, 1000);
+    expect(picks).toHaveLength(3);
+    for (const p of picks) {
+      expect(p.availableForSale).toBe(true);
