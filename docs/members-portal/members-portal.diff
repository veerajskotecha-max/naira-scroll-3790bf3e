+import { useMemo } from "react";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { useWishlist } from "@/contexts/WishlistContext";
+import { speciesIndex } from "@/lib/portal/dropPhase";
+import { familyOf } from "@/lib/portal/family";
+import { readPortal } from "@/lib/portal/safeStorage";
+import { deviceHandles, mergeSaved } from "@/lib/portal/wishlistSync";
+import type { SavedSprig } from "@/lib/portal/gardenLayout";
+import { useMember } from "./MemberContext";
+
+/*
+  Her own plants in her garden, as the garden home draws them and her garden
+  card draws them too, so the card is her garden: a flower for each drop she
+  pressed, and a sprig for each piece in her drawer, its tip gold or silver
+  as the listing is (the shop's own words, from the catalogue already read or
+  the copy the site ships, never a fresh 70 KB read just for a colour).
+
+  Her drawer is laid out as the drawer itself would lay it: her account's
+  pieces and this phone's hearts as one list (the same merge, read only: the
+  drawer writes it, once the shop has answered), so a heart tapped on the
+  shop sprouts here before she has opened the drawer.
+*/
+
+export type GardenFlower = { id: string; species: number; accent: string; title: string; on: string };
+
+export const useGardenPlants = (): { flowers: GardenFlower[]; sprigs: SavedSprig[] } => {
+  const { user, drops, pressed, naira } = useMember();
+  const flowers = useMemo(
+    () =>
+      pressed.flatMap((p) => {
+        const d = drops.find((x) => x.id === p.id);
+        return d ? [{ id: d.id, species: speciesIndex(d.species), accent: d.accent, title: d.title, on: p.on }] : [];
+      }),
+    [pressed, drops],
+  );
+  const { jewellery, isLive } = useLiveJewellery(false);
+  const { items: hearts } = useWishlist();
+  const drawer = useMemo(() => {
+    const kept = readPortal().savedSync;
+    const mine = kept && kept.u === user.id;
+    const list = (x: unknown) => (Array.isArray(x) ? x.filter((h): h is string => typeof h === "string") : []);
+    const catalogue = isLive ? new Set(jewellery.map((p) => p.handle)) : null;
+    return mergeSaved(deviceHandles(hearts), naira.saved, mine ? list(kept.h) : [], catalogue, mine ? list(kept.x) : []).saved;
+  }, [hearts, naira.saved, user.id, isLive, jewellery]);
+  const sprigs = useMemo(() => {
+    const byHandle = new Map(jewellery.map((p) => [p.handle, p]));
+    return drawer.map((h) => ({ id: h, silver: familyOf(byHandle.get(h) ?? { name: h, handle: h, materials: "" }) === "silver" }));
+  }, [drawer, jewellery]);
+  return { flowers, sprigs };
+};
