+import { describe, expect, it } from "vitest";
+import { readPreviewGarden } from "./previewGarden";
+
+/* The garden's development fixtures: each switch alone, and nothing without one. */
+describe("the garden's preview switches", () => {
+  it("is null without a switch", () => {
+    expect(readPreviewGarden("?portalPreview=1&name=Ananya")).toBeNull();
+  });
+
+  it("plays Stone Light's scripted sweep only for &tilt=sweep", () => {
+    expect(readPreviewGarden("?portalPreview=1&tilt=sweep")).toEqual({ tilt: "sweep" });
+    expect(readPreviewGarden("?portalPreview=1&tilt=1")).toBeNull();
+  });
+
+  it("opens the Vanity with three real firm-length necklaces only for &look=1", async () => {
+    const look = readPreviewGarden("?portalPreview=1&look=1")?.look ?? [];
+    expect(look).toHaveLength(3);
+    const { jewellery } = await import("@/data/jewellery");
+    const { jewellerySnapshot } = await import("@/data/jewellerySnapshot");
+    const { lengthOf } = await import("./vanity");
+    for (const h of look) {
+      const p = [...jewellery, ...jewellerySnapshot].find((x) => x.handle === h);
+      expect(p?.category, h).toBe("Necklaces");
+      expect(lengthOf(p!), h).not.toBeNull();
+    }
+    expect(readPreviewGarden("?portalPreview=1&look=2")).toBeNull();
+  });
+
+  it("keeps the earlier switches", () => {
+    expect(readPreviewGarden("?hour=night")).toEqual({ hour: "night" });
+    expect(readPreviewGarden("?hour=noon")).toBeNull();
+    expect(readPreviewGarden("?note=1")?.notes?.length).toBe(2);
+    const season = readPreviewGarden("?season=diwali", new Date("2026-11-06T06:00:00Z"))?.seasons?.[0];
+    expect(season).toMatchObject({ dressing: "diwali", start: "2026-11-05", end: "2026-11-07" });
+  });
+});
