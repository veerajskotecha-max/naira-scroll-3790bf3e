index 0000000..3a12dd1
--- /dev/null
+++ b/src/lib/portal/shareCard.ts
@@ -0,0 +1,430 @@
+import { WORDMARK, WORDMARK_FLOWER } from "@/lib/nairaFlower/wordmark";
+import { FLOWER_ASPECT, FLOWER_PETALS, FLOWER_STEM } from "./brandFlower";
+
+/*
+  Her garden card: a 1080 x 1920 PNG (a phone's story size), drawn on her
+  phone with canvas 2D, never on a server and never on the animation path
+  (the card's room has no ambient motion, and nothing else animates while
+  it draws). On it: the still NAIRA wordmark (the header's own paths), "The
+  Inner Garden", her garden as its SVG (the same seed and planting as her
+  bed) or a pressed drop flower on a herbarium sheet, her stone's name as the
+  listing words it ("July · Ruby", in her month's colour) and the shop's
+  address.
+
+  What it never carries: a member number, a count of anything, a date, or
+  her name unless she turns it on. Every word drawn passes through
+  cardTexts(), which drops any line with a digit in it, so not even a drop
+  or a name with a number in it can put one on the card.
+
+  Sharing: navigator.share({ files }) where the phone can share a file;
+  otherwise, and always inside Instagram's and Facebook's own browsers
+  (which neither share files nor download them), the image opens in a view
+  of its own to be pressed and held and saved.
+
+  This module is only ever reached from the card's renderer (ShareCard.tsx),
+  a chunk of its own inside the card's room.
+*/
+
+export const CARD = { w: 1080, h: 1920 } as const;
+/* The gold frame: an outer hairline and a fine inner rule, as the herbarium sheets are framed. */
+export const FRAME = { outer: 48, inner: 66 } as const;
+
+export type CardArt = "garden" | "flower";
+
+export type CardInput = {
+  art: CardArt;
+  /** Her first name, only when she has turned it on. */
+  name: string | null;
+  /** Her stone as the listing names it ("July · Ruby"), when her month is known. */
+  stone: string | null;
+  /** The pressed flower's drop ("Verdant"), for a flower card. */
+  flower?: string | null;
+};
+
+export type CardFont = "label" | "display" | "italic";
+export type CardText = {
+  text: string;
+  /** Centre x and baseline y, in card px. */
+  x: number;
+  y: number;
+  size: number;
+  font: CardFont;
+  color: string;
+  /** Letter spacing, in em. */
+  tracking: number;
+  /** The widest it may be drawn; it is set smaller to fit. */
+  maxWidth: number;
+};
+export type Box = { x: number; y: number; w: number; h: number };
+export type CardLayout = { texts: CardText[]; art: Box; wordmark: Box; frame: { outer: Box; inner: Box } };
+
+export const INK = "#1A1614";
+export const IVORY = "#FBF3EC";
+const GOLD = "#C99A4C";
+const GOLD_DEEP = "#B0843A";
+const GOLD_TEXT = "#80612A";
+const SAGE = "#99B4AF";
+const BLUSH = "#FFBDA8";
+const VELLUM = "#FFF8F5";
+
+const FONT_FAMILY: Record<CardFont, string> = {
+  label: "Jost, Inter, sans-serif",
+  display: "'Cormorant Garamond', Georgia, serif",
+  italic: "'Cormorant Garamond', Georgia, serif",
+};
+export const fontOf = (font: CardFont, size: number) => `${font === "italic" ? "italic " : ""}400 ${size}px ${FONT_FAMILY[font]}`;
+
+/** A line fit to be drawn: trimmed, at most 32 characters, and never one with a digit in it (null then). */
+export const cleanLine = (text: string | null | undefined): string | null => {
+  // Any run of spaces or control characters becomes one space.
+  const t = [...(text ?? "")].map((c) => (c.charCodeAt(0) < 32 || c.charCodeAt(0) === 127 ? " " : c)).join("").replace(/\s+/g, " ").trim();
+  if (!t || t.length > 32 || /\d/.test(t)) return null;
+  return t;
+};
+
+/** "Ananya's garden": her name, with the right possessive. */
+const gardenOf = (name: string) => `${name}’${/s$/i.test(name) ? "" : "s"} garden`;
+
+/** Every word the card will carry, in order (cardLayout places them). */
+export const cardTexts = (input: CardInput): { eyebrow: string; title: string | null; caption: string | null; line: string | null; site: string } => {
+  const name = cleanLine(input.name);
+  const stone = cleanLine(input.stone);
+  const flower = cleanLine(input.flower);
+  const isFlower = input.art === "flower";
+  return {
+    eyebrow: "THE INNER GARDEN",
+    title: name ? gardenOf(name) : null,
+    caption: isFlower ? (flower ? "A PRESSED FLOWER" : null) : stone ? "IN YOUR MONTH’S COLOUR" : null,
+    line: isFlower ? (flower ? `The ${flower} flower` : null) : stone,
+    site: "NAIRAFLORE.COM",
+  };
+};
+
+const GARDEN_ASPECT = 390 / 560;
+const SHEET_ASPECT = 4 / 5;
+
+/** Where everything sits on the card. `measure` (canvas measureText, in tests an estimate) sets each line's size to fit its width. */
+export const cardLayout = (input: CardInput, measure?: (text: string, font: CardFont, size: number, tracking: number) => number): CardLayout => {
+  const t = cardTexts(input);
+  const inner = FRAME.inner;
+  const width = CARD.w - inner * 2 - 64;
+  const cx = CARD.w / 2;
+  const fit = (text: string, font: CardFont, size: number, tracking: number): number => {
+    if (!measure) return size;
+    let s = size;
+    while (s > 18 && measure(text, font, s, tracking) > width) s -= 2;
+    return s;
+  };
+  const line = (text: string, y: number, size: number, font: CardFont, color: string, tracking = 0): CardText => ({
+    text,
+    x: cx,
+    y,
+    size: fit(text, font, size, tracking),
+    font,
+    color,
+    tracking,
+    maxWidth: width,
+  });
+
+  const wordmarkW = 380;
+  const wordmark: Box = { x: cx - wordmarkW / 2, y: 150, w: wordmarkW, h: (wordmarkW * WORDMARK.height) / WORDMARK.width };
+  const texts: CardText[] = [line(t.eyebrow, 300, 26, "label", GOLD_TEXT, 0.28)];
+  if (t.title) texts.push(line(t.title, 388, 68, "italic", INK));
+
+  // The art fills what is left between the words, at its own shape.
+  const top = t.title ? 432 : 350;
+  const bottom = t.caption || t.line ? 1608 : 1700;
+  const room = bottom - top;
+  const aspect = input.art === "flower" ? SHEET_ASPECT : GARDEN_ASPECT;
+  let h = room;
+  let w = h * aspect;
+  if (w > width) {
+    w = width;
+    h = w / aspect;
+  }
+  const art: Box = { x: cx - w / 2, y: top + (room - h) / 2, w, h };
+
+  if (t.caption) texts.push(line(t.caption, 1676, 24, "label", GOLD_TEXT, 0.28));
+  if (t.line) texts.push(line(t.line, 1748, 58, "display", INK));
+  texts.push(line(t.site, 1822, 22, "label", "rgb(26 22 20 / 0.72)", 0.32));
+
+  return {
+    texts,
+    art,
+    wordmark,
+    frame: {
+      outer: { x: FRAME.outer, y: FRAME.outer, w: CARD.w - FRAME.outer * 2, h: CARD.h - FRAME.outer * 2 },
+      inner: { x: inner, y: inner, w: CARD.w - inner * 2, h: CARD.h - inner * 2 },
+    },
+  };
+};
+
+/* ── the art, as an SVG of its own ──────────────────── */
+
+/* The colours the garden's drawing names as tokens, and the few classes it
+   draws with (members.css's own rules, checked against it by test): an SVG
+   drawn as an image sees neither the page's variables nor its stylesheet. */
+export const ART_TOKENS: Record<string, string> = {
+  "--nf-accent-strong": GOLD_DEEP,
+  "--nf-accent": GOLD,
+  "--nf-blush": BLUSH,
+  "--nf-ivory": IVORY,
+  "--nf-ink": INK,
+  "--nf-sage": SAGE,
+  "--nf-gold-text": GOLD_TEXT,
+  "--ig-vellum": VELLUM,
+};
+export const ART_CSS = [
+  ".ig-soil{fill:none;stroke:#C99A4C;stroke-width:1}",
+  ".ig-arbour-line{fill:none;stroke:#C99A4C;stroke-width:1.2;opacity:0.85}",
+  ".ig-arbour-line--fine{stroke-width:0.7;opacity:0.55}",
+  ".ig-arbour-tick{stroke:#C99A4C;stroke-width:0.8;opacity:0.6}",
+  ".ig-stone-budcap{opacity:0}",
+  "svg{overflow:visible}",
+].join("");
+
+const tokenised = (markup: string) => markup.replace(/var\((--[\w-]+)\)/g, (whole, name: string) => ART_TOKENS[name] ?? whole);
+
+/**
+ * One standalone SVG document from the art on screen: its drawing, the
+ * page's shared symbols it stamps (the garden's stems and heads), the token
+ * colours written out and the classes it needs, at `w` x `h` px.
+ */
+export const composeArtSvg = (art: SVGSVGElement, defs: Element | null, w: number, h: number): string => {
+  const xml = new XMLSerializer();
+  const inner = Array.from(art.childNodes, (n) => xml.serializeToString(n)).join("");
+  const symbols = defs ? Array.from(defs.childNodes, (n) => xml.serializeToString(n)).join("") : "";
+  const viewBox = art.getAttribute("viewBox") ?? `0 0 ${w} ${h}`;
+  return tokenised(
+    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="${viewBox}" width="${Math.round(w)}" height="${Math.round(h)}"><style>${ART_CSS}</style><defs>${symbols}</defs>${inner}</svg>`,
+  );
+};
+
+/* ── sharing ────────────────────────────────────────── */
+
+/* Instagram's and Facebook's own browsers: spelt out as CalendarButton does
+   (lib/portal/inAppBrowser is shared with Auth, and a third importer would
+   split it into a chunk Auth then fetches); shareCard.test holds the two to
+   the same answers. */
+const IN_APP = /\bInstagram\b|\bFB(AN|AV)\b|FB_IAB|\[FB/i;
+
+export type ShareMode = "share" | "open";
+
+/** How the card leaves her phone: a file share where it can, otherwise (and always in an in-app browser) the open-image view. */
+export const shareMode = (userAgent: string | null | undefined, canShareFiles: boolean): ShareMode =>
+  IN_APP.test(userAgent ?? "") ? "open" : canShareFiles ? "share" : "open";
+
+export const CARD_FILE = "naira-garden-card.png";
+
+/* ── drawing ────────────────────────────────────────── */
+
+type Ctx = Pick<
+  CanvasRenderingContext2D,
+  | "fillStyle"
+  | "strokeStyle"
+  | "lineWidth"
+  | "globalAlpha"
+  | "font"
+  | "textAlign"
+  | "textBaseline"
+  | "fillRect"
+  | "strokeRect"
+  | "fillText"
+  | "measureText"
+  | "save"
+  | "restore"
+  | "translate"
+  | "scale"
+  | "rotate"
+  | "fill"
+  | "drawImage"
+>;
+
+/** Text with its letters spaced (canvas letterSpacing is not on every phone yet), centred on x. */
+const drawTracked = (ctx: Ctx, t: CardText) => {
+  ctx.font = fontOf(t.font, t.size);
+  ctx.fillStyle = t.color;
+  ctx.textBaseline = "alphabetic";
+  const gap = t.tracking * t.size;
+  if (!gap) {
+    ctx.textAlign = "center";
+    ctx.fillText(t.text, t.x, t.y, t.maxWidth);
+    return;
+  }
+  ctx.textAlign = "left";
+  const chars = [...t.text];
+  const widths = chars.map((c) => ctx.measureText(c).width);
+  const total = widths.reduce((s, w) => s + w, 0) + gap * (chars.length - 1);
+  let x = t.x - total / 2;
+  chars.forEach((c, i) => {
+    ctx.fillText(c, x, t.y);
+    x += widths[i] + gap;
+  });
+};
+
+const wordmarkPaths = () => {
+  const letters = new Path2D(WORDMARK.d);
+  const flower = [FLOWER_STEM, ...FLOWER_PETALS].map((d) => new Path2D(d));
+  return { letters, flower };
+};
+
+/** The still wordmark as the header draws it: NAIRA in sage, the flower standing as its I in blush. */
+const drawWordmark = (ctx: Ctx, box: Box) => {
+  const { letters, flower } = wordmarkPaths();
+  const k = box.w / WORDMARK.width;
+  ctx.save();
+  ctx.translate(box.x, box.y);
+  ctx.scale(k, k);
+  ctx.fillStyle = SAGE;
+  ctx.fill(letters);
+  const F = WORDMARK_FLOWER;
+  ctx.translate(F.cx - (FLOWER_ASPECT / 2) * F.height, F.cy - F.height / 2);
+  ctx.scale(F.height, F.height);
+  ctx.fillStyle = BLUSH;
+  flower.forEach((p) => ctx.fill(p));
+  ctx.restore();
+};
+
+/** The herbarium sheet a pressed flower lies on: vellum in a fine gold frame, two slips of tape. */
+const drawSheet = (ctx: Ctx, box: Box) => {
+  ctx.fillStyle = VELLUM;
+  ctx.fillRect(box.x, box.y, box.w, box.h);
+  ctx.strokeStyle = GOLD_DEEP;
+  ctx.lineWidth = 2.5;
+  ctx.strokeRect(box.x, box.y, box.w, box.h);
+  ctx.globalAlpha = 0.5;
+  ctx.strokeStyle = GOLD;
+  ctx.lineWidth = 1.5;
+  ctx.strokeRect(box.x + box.w * 0.035, box.y + box.h * 0.028, box.w * 0.93, box.h * 0.944);
+  ctx.globalAlpha = 1;
+};
+
+const drawTape = (ctx: Ctx, box: Box) => {
+  const slips: [number, number, number, number][] = [
+    [0.37, 0.62, 0.26, -8],
+    [0.18, 0.44, 0.2, 14],
+  ];
+  for (const [l, t, w, deg] of slips) {
+    ctx.save();
+    ctx.translate(box.x + box.w * l, box.y + box.h * t);
+    ctx.rotate((deg * Math.PI) / 180);
+    ctx.globalAlpha = 0.82;
+    ctx.fillStyle = "#FFFAF4";
+    ctx.fillRect(0, 0, box.w * w, box.h * 0.05);
+    ctx.globalAlpha = 1;
+    ctx.restore();
+  }
+};
+
+/** A Naira flower in place of art that could not be drawn (a phone that would not paint the SVG). */
+const drawFallbackFlower = (ctx: Ctx, box: Box) => {
+  const h = Math.min(box.h * 0.7, box.w / FLOWER_ASPECT);
+  ctx.save();
+  ctx.translate(box.x + box.w / 2 - (h * FLOWER_ASPECT) / 2, box.y + (box.h - h) / 2);
+  ctx.scale(h, h);
+  [FLOWER_STEM, ...FLOWER_PETALS].forEach((d, i) => {
+    ctx.fillStyle = i === 0 ? "#8FAAA4" : "#F7AE98";
+    ctx.fill(new Path2D(d));
+  });
+  ctx.restore();
+};
+
+/** Draws the whole card onto a 1080 x 1920 context. `art` is the art's image, or null to draw the Naira flower instead. */
+export const drawCard = (ctx: Ctx, input: CardInput, layout: CardLayout, art: CanvasImageSource | null): void => {
+  ctx.fillStyle = IVORY;
+  ctx.fillRect(0, 0, CARD.w, CARD.h);
+  const { outer, inner } = layout.frame;
+  ctx.strokeStyle = GOLD_DEEP;
+  ctx.lineWidth = 3;
+  ctx.strokeRect(outer.x, outer.y, outer.w, outer.h);
+  ctx.globalAlpha = 0.55;
+  ctx.strokeStyle = GOLD;
+  ctx.lineWidth = 1.5;
+  ctx.strokeRect(inner.x, inner.y, inner.w, inner.h);
+  ctx.globalAlpha = 1;
+  drawWordmark(ctx, layout.wordmark);
+  const flower = input.art === "flower";
+  if (flower) drawSheet(ctx, layout.art);
+  if (art) {
+    if (flower) {
+      const b = layout.art;
+      const h = b.h * 0.78;
+      const w = (h * 120) / 166;
+      ctx.drawImage(art, b.x + (b.w - w) / 2, b.y + (b.h - h) / 2, w, h);
+      drawTape(ctx, b);
+    } else {
+      ctx.drawImage(art, layout.art.x, layout.art.y, layout.art.w, layout.art.h);
+    }
+  } else drawFallbackFlower(ctx, layout.art);
+  layout.texts.forEach((t) => drawTracked(ctx, t));
+};
+
+/* ── on the phone ───────────────────────────────────── */
+
+const fontsReady = async (layout: CardLayout) => {
+  const fonts = (document as Document & { fonts?: FontFaceSet }).fonts;
+  if (!fonts?.load) return;
+  const wanted = [...new Set(layout.texts.map((t) => fontOf(t.font, t.size)))];
+  await Promise.race([Promise.all(wanted.map((f) => fonts.load(f).catch(() => []))), new Promise((r) => window.setTimeout(r, 1200))]);
+};
+
+const loadImage = (src: string): Promise<HTMLImageElement> =>
+  new Promise((resolve, reject) => {
+    const img = new Image();
+    img.decoding = "async";
+    img.onload = () => resolve(img);
+    img.onerror = () => reject(new Error("The card's art did not load."));
+    img.src = src;
+  });
+
+const toBlob = (canvas: HTMLCanvasElement): Promise<Blob> =>
+  new Promise((resolve, reject) => {
+    try {
+      canvas.toBlob((b) => (b ? resolve(b) : reject(new Error("The card could not be made."))), "image/png");
+    } catch (error) {
+      reject(error);
+    }
+  });
+
+export type RenderedCard = { blob: Blob; ms: number; artDrawn: boolean };
+
+/**
+ * Draws the card from the art's standalone SVG (composeArtSvg) and hands back
+ * its PNG. A phone that will not paint the SVG onto the canvas (or will not
+ * let the canvas be read after) gets the card with the Naira flower instead.
+ */
+const newCanvas = () => {
+  const canvas = document.createElement("canvas");
+  canvas.width = CARD.w;
+  canvas.height = CARD.h;
+  const ctx = canvas.getContext("2d");
+  if (!ctx) throw new Error("This phone cannot draw the card.");
+  return { canvas, ctx };
+};
+
+export const renderCard = async (input: CardInput, artSvg: string): Promise<RenderedCard> => {
+  const start = performance.now();
+  const { canvas, ctx } = newCanvas();
+  const measure = (text: string, font: CardFont, size: number, tracking: number) => {
+    ctx.font = fontOf(font, size);
+    return ctx.measureText(text).width + tracking * size * Math.max(0, [...text].length - 1);
+  };
+  await fontsReady(cardLayout(input));
+  // Measured with the fonts in, so a long name is set to fit.
+  const layout = cardLayout(input, measure);
+  let image: HTMLImageElement | null = null;
+  try {
+    image = await loadImage(`data:image/svg+xml;charset=utf-8,${encodeURIComponent(artSvg)}`);
+  } catch {
+    image = null;
+  }
+  drawCard(ctx, input, layout, image);
+  try {
+    return { blob: await toBlob(canvas), ms: performance.now() - start, artDrawn: Boolean(image) };
+  } catch {
+    // A phone that will not let a canvas be read once the SVG is on it: a fresh one, with the Naira flower.
+    const again = newCanvas();
+    drawCard(again.ctx, input, layout, null);
+    return { blob: await toBlob(again.canvas), ms: performance.now() - start, artDrawn: false };
+  }
+};
