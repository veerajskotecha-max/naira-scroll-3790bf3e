@@ -0,0 +1,151 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { SILENT_MS, motionOffered, startMotion } from "./motionSensor";
+
+/* Her phone's tilt, only after her tap: iOS's permission asked inside the
+   click, a refusal or a silent second handing back to the drag, nothing
+   listening before or after, and the listener off while she is away. */
+
+type Api = { requestPermission?: () => Promise<string> };
+const w = window as unknown as Record<string, unknown>;
+
+const listeners = () => vi.mocked(window.addEventListener).mock.calls.filter(([type]) => type === "deviceorientation");
+const removed = () => vi.mocked(window.removeEventListener).mock.calls.filter(([type]) => type === "deviceorientation");
+const tilt = (beta: number | null, gamma: number | null) => {
+  const e = new Event("deviceorientation") as Event & { beta: number | null; gamma: number | null };
+  Object.assign(e, { beta, gamma });
+  window.dispatchEvent(e);
+};
+
+const device = ({ api = {} as Api | null, coarse = true, reduce = false } = {}) => {
+  if (api) w.DeviceOrientationEvent = Object.assign(function DeviceOrientationEvent() {}, api);
+  else delete w.DeviceOrientationEvent;
+  window.matchMedia = ((query: string) => ({ matches: (query.includes("coarse") && coarse) || (query.includes("reduce") && reduce), media: query, addEventListener() {}, removeEventListener() {} })) as unknown as typeof window.matchMedia;
+};
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  vi.spyOn(window, "addEventListener");
+  vi.spyOn(window, "removeEventListener");
+});
+afterEach(() => {
+  vi.useRealTimers();
+  vi.restoreAllMocks();
+  delete w.DeviceOrientationEvent;
+});
+
+describe("the tilt", () => {
+  it("is offered only where the sensor's event exists, on a phone, with motion allowed", () => {
+    device();
+    expect(motionOffered()).toBe(true);
+    device({ api: null });
+    expect(motionOffered()).toBe(false);
+    device({ coarse: false });
+    expect(motionOffered()).toBe(false);
+    device({ reduce: true });
+    expect(motionOffered()).toBe(false);
+  });
+
+  it("listens to nothing before her tap", () => {
+    device();
+    expect(listeners()).toHaveLength(0);
+  });
+
+  it("asks iOS's permission at once, inside the tap, before anything waits", () => {
+    const requestPermission = vi.fn(() => Promise.resolve("granted"));
+    device({ api: { requestPermission } });
+    startMotion({ onReading: vi.fn(), onEnd: vi.fn() });
+    // Called synchronously: the click is still the user's gesture.
+    expect(requestPermission).toHaveBeenCalledTimes(1);
+  });
+
+  it("passes readings on once granted, and keeps listening while they come", async () => {
+    device({ api: { requestPermission: () => Promise.resolve("granted") } });
+    const onReading = vi.fn();
+    const onEnd = vi.fn();
+    startMotion({ onReading, onEnd });
+    await vi.advanceTimersByTimeAsync(0);
+    expect(listeners()).toHaveLength(1);
+    tilt(40, 12);
+    tilt(null, 3);
+    expect(onReading).toHaveBeenCalledTimes(1);
+    expect(onReading).toHaveBeenCalledWith({ beta: 40, gamma: 12 });
+    await vi.advanceTimersByTimeAsync(SILENT_MS * 3);
+    expect(onEnd).not.toHaveBeenCalled();
+  });
+
+  it("hands back to the drag when refused, with no listener left", async () => {
+    device({ api: { requestPermission: () => Promise.resolve("denied") } });
+    const onEnd = vi.fn();
+    startMotion({ onReading: vi.fn(), onEnd });
+    await vi.advanceTimersByTimeAsync(0);
+    expect(onEnd).toHaveBeenCalledWith("denied");
+    expect(listeners()).toHaveLength(0);
+  });
+
+  it("hands back to the drag when the permission prompt fails", async () => {
+    device({ api: { requestPermission: () => Promise.reject(new Error("not allowed")) } });
+    const onEnd = vi.fn();
+    startMotion({ onReading: vi.fn(), onEnd });
+    await vi.advanceTimersByTimeAsync(0);
+    expect(onEnd).toHaveBeenCalledWith("denied");
+  });
+
+  it("hands back to the drag when no reading arrives within a second (a laptop), and stops listening", async () => {
+    device();
+    const onEnd = vi.fn();
+    startMotion({ onReading: vi.fn(), onEnd });
+    await vi.advanceTimersByTimeAsync(SILENT_MS - 10);
+    expect(onEnd).not.toHaveBeenCalled();
+    await vi.advanceTimersByTimeAsync(20);
+    expect(onEnd).toHaveBeenCalledWith("silent");
+    expect(listeners()).toHaveLength(1);
+    expect(removed()).toHaveLength(1);
+  });
+
+  it("takes its listener off while paused and puts it back on resume, without asking again", async () => {
+    const requestPermission = vi.fn(() => Promise.resolve("granted"));
+    device({ api: { requestPermission } });
+    const onReading = vi.fn();
+    const handle = startMotion({ onReading, onEnd: vi.fn() });
+    await vi.advanceTimersByTimeAsync(0);
+    tilt(10, 10);
+    handle.pause();
+    expect(removed()).toHaveLength(1);
+    tilt(20, 20);
+    expect(onReading).toHaveBeenCalledTimes(1);
+    handle.resume();
+    await vi.advanceTimersByTimeAsync(0);
+    expect(listeners()).toHaveLength(2);
+    tilt(30, 30);
+    expect(onReading).toHaveBeenCalledTimes(2);
+    expect(requestPermission).toHaveBeenCalledTimes(1);
+    handle.stop();
+    tilt(40, 40);
+    expect(onReading).toHaveBeenCalledTimes(2);
+    handle.resume();
+    await vi.advanceTimersByTimeAsync(0);
+    expect(listeners()).toHaveLength(2);
+  });
+
+  it("counts its silent second only while listened to: granted while asleep, it waits for her to wake it", async () => {
+    let grant!: (state: string) => void;
+    device({ api: { requestPermission: () => new Promise<string>((r) => (grant = r)) } });
+    const onReading = vi.fn();
+    const onEnd = vi.fn();
+    const handle = startMotion({ onReading, onEnd });
+    // She left it idle while iOS's prompt was up: asleep before the grant.
+    handle.pause();
+    grant("granted");
+    await vi.advanceTimersByTimeAsync(SILENT_MS * 3);
+    expect(onEnd).not.toHaveBeenCalled();
+    expect(listeners()).toHaveLength(0);
+    // Woken, it listens, and a reading arrives: the light follows.
+    handle.resume();
+    await vi.advanceTimersByTimeAsync(0);
+    expect(listeners()).toHaveLength(1);
+    tilt(10, 10);
+    await vi.advanceTimersByTimeAsync(SILENT_MS * 2);
+    expect(onReading).toHaveBeenCalledTimes(1);
+    expect(onEnd).not.toHaveBeenCalled();
+  });
+});
