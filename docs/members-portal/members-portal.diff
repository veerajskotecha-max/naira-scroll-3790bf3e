+/*
+  Six flat petals for the portal's bursts, redrawn from the homepage's petal
+  artwork without its gradients or drop-shadows (each of those was a paint
+  cost on every frame). Defined once per page and stamped with <use>.
+*/
+
+export const PETAL_IDS = ["ig-petal-0", "ig-petal-1", "ig-petal-2", "ig-petal-3", "ig-petal-4", "ig-petal-5"] as const;
+/** A petal in whatever colour its <svg> carries (her stone's hue). */
+export const PETAL_HUE = "ig-petal-hue";
+/** The gold four-point sparkle. */
+export const PETAL_SPARK = PETAL_IDS[5];
+
+const PetalSymbols = () => (
+  <>
+    <symbol id="ig-petal-0" viewBox="0 0 20 20">
+      <path d="M10 4C12 1.5 17 2.5 17.5 7C18 12 14 17.5 10 18C6 17.5 2 12 2.5 7C3 2.5 8 1.5 10 4Z" fill="#FFBDA8" />
+    </symbol>
+    <symbol id="ig-petal-1" viewBox="0 0 20 20">
+      <path d="M10 1C14.5 6 14.5 14 10 19C5.5 14 5.5 6 10 1Z" fill="#F3D9C6" />
+    </symbol>
+    <symbol id="ig-petal-2" viewBox="0 0 20 20">
+      <path d="M2 17C4 8.5 10 3 18 2C17 10.5 11.5 16.5 2 17Z" fill="#AEBDB6" />
+    </symbol>
+    <symbol id="ig-petal-3" viewBox="0 0 20 20">
+      {[0, 72, 144, 216, 288].map((a) => (
+        <ellipse key={a} cx="10" cy="5.6" rx="3" ry="4.4" fill="#FFF6EA" transform={`rotate(${a} 10 10)`} />
+      ))}
+      <circle cx="10" cy="10" r="2.2" fill="#E8C88A" />
+    </symbol>
+    <symbol id="ig-petal-4" viewBox="0 0 20 20">
+      <path d="M10 2C13 7 15 10 15 13A5 5 0 0 1 5 13C5 10 7 7 10 2Z" fill="#F0BCA8" />
+    </symbol>
+    <symbol id="ig-petal-5" viewBox="0 0 20 20">
+      <path d="M10 2L11.6 10L10 18L8.4 10Z" fill="#C99A4C" />
+    </symbol>
+    <symbol id="ig-petal-hue" viewBox="0 0 20 20">
+      <path d="M10 2C14.5 5 16.5 10 10 18C3.5 10 5.5 5 10 2Z" fill="currentColor" />
+    </symbol>
+  </>
+);
+
+export default PetalSymbols;
