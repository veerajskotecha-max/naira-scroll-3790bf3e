+      <path d={FLAME} fill="#F2B544" />
+      <path d={FLAME_IN} fill="#FFF3C9" />
+    </svg>
+    <svg viewBox="0 0 30 13" style={{ position: "absolute", left: 0, bottom: 0, width: "100%", height: "42%", overflow: "visible" }} aria-hidden>
+      <path d={BOWL} fill={CLAY} stroke={RIM} strokeWidth=".8" strokeLinejoin="round" />
+      <path d="M6 5.5C10 7.4 20 7.4 24 5.5" fill="none" stroke={RIM} strokeWidth=".6" opacity=".7" />
+    </svg>
+  </div>
+);
+
+const FLICKER: Keyframe[] = [
+  { transform: "scale(1, 1)", opacity: 0.92 },
+  { transform: "scale(0.9, 1.08)", opacity: 1, offset: 0.3 },
+  { transform: "scale(1.05, 0.95)", opacity: 0.84, offset: 0.66 },
+  { transform: "scale(0.96, 1.04)", opacity: 1 },
+];
+
+/* ── the monsoon ────────────────────────────────────── */
+
+const RAIN_DROPS = 18;
+const SLANT_DEG = 12;
+type Drop = { x: number; y: number; len: number; dur: number; phase: number };
+const rainFor = (seed: string): Drop[] => {
+  const rand = mulberry32(hashString(`${seed || "naira"}:rain`));
+  return Array.from({ length: RAIN_DROPS }, (_, i) => ({
+    x: 20 + ((i + rand()) * (BED.w - 10)) / RAIN_DROPS,
+    y: 40 + rand() * 460,
+    len: 26 + rand() * 20,
+    dur: Math.round(1100 + rand() * 600),
+    phase: rand(),
+  }));
+};
+
+/* ── Holi ───────────────────────────────────────────── */
+
+const GULAL = ["#E98AA8", "#F2B04A", "#8CC5A0", "#8FB4E8", "#B39AD9"];
+const PATCHES = [
+  { x: 64, y: 512, w: 54, c: 0 },
+  { x: 126, y: 518, w: 40, c: 1 },
+  { x: 206, y: 514, w: 48, c: 2 },
+  { x: 268, y: 519, w: 36, c: 3 },
+  { x: 330, y: 513, w: 52, c: 4 },
+];
+const PUFF_DOTS = 6;
+const MAX_PUFF_DOTS = 24;
+
+const glow = (hex: string, alpha: number) => {
+  const n = Number.parseInt(hex.slice(1), 16);
+  return `radial-gradient(closest-side, rgb(${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255} / ${alpha}), rgb(${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255} / 0))`;
+};
+
+/* A puff's cloud holds its colour for a beat before it drifts and fades (never a front-loaded fade), and
+   opens out past the fingertip and the tap bloom drawn over the same spot. */
+const PUFF_EASE = "cubic-bezier(0.2, 0.6, 0.3, 1)";
+
+/** A puff of colour at (x, y) in the layer's own box: six soft dots that open out and fade, each removed when it has. */
+const puffAt = (layer: HTMLElement, x: number, y: number, alive: HTMLElement[]) => {
+  const first = Math.floor(Math.random() * GULAL.length);
+  for (let i = 0; i < PUFF_DOTS; i++) {
+    const dot = document.createElement("span");
+    const size = Math.round(28 + Math.random() * 18);
+    dot.setAttribute("aria-hidden", "true");
+    dot.style.cssText = `position:absolute;left:${x - size / 2}px;top:${y - size / 2}px;width:${size}px;height:${size}px;pointer-events:none;will-change:transform,opacity;background:${glow(GULAL[(first + (i % 3)) % GULAL.length], 0.9)}`;
+    layer.appendChild(dot);
+    alive.push(dot);
+    while (alive.length > MAX_PUFF_DOTS) alive.shift()?.remove();
+    const angle = (i / PUFF_DOTS) * Math.PI * 2 + Math.random() * 0.6;
+    const dist = 30 + Math.random() * 26;
+    const dx = Math.cos(angle) * dist;
+    const dy = Math.sin(angle) * dist - 8;
+    const a = play(
+      dot,
+      [
+        { transform: "translate(0px, 0px) scale(0.6)", opacity: 0.9 },
+        { transform: `translate(${(dx * 0.55).toFixed(1)}px, ${(dy * 0.55).toFixed(1)}px) scale(1.25)`, opacity: 0.85, offset: 0.3 },
+        { transform: `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) scale(1.7)`, opacity: 0 },
+      ],
+      { duration: 1300 + Math.random() * 200, easing: PUFF_EASE, fill: "forwards" },
+    );
+    const gone = () => {
+      dot.remove();
+      const k = alive.indexOf(dot);
+      if (k >= 0) alive.splice(k, 1);
+    };
+    if (a) {
+      a.onfinish = gone;
+      a.oncancel = gone;
+    } else gone();
+  }
+};
+
+const FestivalDressing = ({ dressing, seed, night = false }: Props) => {
+  const rootRef = useRef<HTMLDivElement>(null);
+  const loop = useAmbientLoop();
+  const calm = stillMotion();
+  const diyas = useMemo(() => {
+    if (dressing !== "diwali") return [];
+    const { naira, stone } = layoutGarden(seed);
+    return DIYA_SPOTS.filter((x) => [naira.x, stone.x].every((stem) => Math.abs(stem - x) >= 30));
+  }, [dressing, seed]);
+  const rain = useMemo(() => (dressing === "monsoon" ? rainFor(seed) : []), [dressing, seed]);
+  const rainTone = night ? "244 235 226" : "104 130 126";
+
+  // Diwali: the garland draws itself, once, as it arrives; then its flowers open along it (set before its first paint, so it never shows hung first).
+  useLayoutEffect(() => {
+    const root = rootRef.current;
+    if (!root || calm || dressing !== "diwali") return;
+    const out: (Animation | null)[] = [play(root.querySelector("[data-thread]"), [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 1400, easing: "cubic-bezier(0.45, 0, 0.25, 1)", fill: "backwards" })];
+    root.querySelectorAll("[data-marigold]").forEach((head, i) =>
+      out.push(play(head, [{ opacity: 0 }, { opacity: 1 }], { duration: 360, delay: 500 + i * 45, easing: EASE_BLOOM, fill: "backwards" })),
+    );
+    return () => out.forEach((a) => a?.cancel());
+  }, [calm, dressing]);
+
+  // The flames and the rain: on the bed's one loop, or still without one.
+  useEffect(() => {
+    const root = rootRef.current;
+    if (!root || calm || !loop) return;
+    const list: Animation[] = [];
+    root.querySelectorAll<HTMLElement>("[data-flame]").forEach((flame, i) => {
+      const a = play(flame, FLICKER, { duration: 1100 + i * 130, iterations: Infinity, direction: "alternate", easing: "ease-in-out" });
+      if (a) list.push(a);
+    });
+    const height = root.getBoundingClientRect().height || BED.h;
+    const fall = height + 80;
+    const drift = -fall * Math.tan((SLANT_DEG * Math.PI) / 180);
+    root.querySelectorAll<HTMLElement>("[data-rain]").forEach((drop, i) => {
+      const d = rain[i];
+      if (!d) return;
+      // From above the bed to below it, wherever the drop hangs when still.
+      const from = -40 - (d.y / BED.h) * height;
+      const a = play(
+        drop,
+        [
+          { transform: `translate(0px, ${from.toFixed(1)}px) rotate(${SLANT_DEG}deg)`, opacity: 0 },
+          { opacity: 0.85, offset: 0.1 },
+          { opacity: 0.85, offset: 0.85 },
+          { transform: `translate(${drift.toFixed(1)}px, ${(from + fall).toFixed(1)}px) rotate(${SLANT_DEG}deg)`, opacity: 0 },
+        ],
+        { duration: d.dur, iterations: Infinity, easing: "linear" },
+      );
+      if (!a) return;
+      a.currentTime = d.phase * d.dur;
+      list.push(a);
+    });
+    const leave = loop.join(list);
+    return () => {
+      leave();
+      list.forEach((a) => a.cancel());
+    };
+  }, [calm, loop, rain]);
+
+  // Holi: a tap on the garden puffs colour where it lands (the bloom opens there too).
+  useEffect(() => {
+    const root = rootRef.current;
+    const bed = root?.closest<HTMLElement>(".ig-bed");
+    if (!root || !bed || calm || dressing !== "holi") return;
+    const alive: HTMLElement[] = [];
+    const onDown = (e: PointerEvent) => {
+      if (e.button > 0) return;
+      if ((e.target as Element | null)?.closest?.("a,button,input,select,textarea,label")) return;
+      const box = root.getBoundingClientRect();
+      puffAt(root, e.clientX - box.left, e.clientY - box.top, alive);
+    };
+    bed.addEventListener("pointerdown", onDown);
+    return () => {
+      bed.removeEventListener("pointerdown", onDown);
+      alive.forEach((n) => n.remove());
+      alive.length = 0;
+    };
+  }, [calm, dressing]);
+
+  return (
+    <div ref={rootRef} className="ig-festival" data-dressing={dressing} style={LAYER} aria-hidden>
+      {dressing === "diwali" && (
+        <>
+          <Garland />
+          {diyas.map((x) => (
+            <Diya key={x} x={x} />
+          ))}
+        </>
+      )}
+      {dressing === "monsoon" && (
+        <>
+          {rain.map((d, i) => (
+            <span
+              key={i}
+              data-rain=""
+              style={{
+                position: "absolute",
+                left: pct(d.x, BED.w),
+                // Still, each drop hangs where it falls; moving, its flight crosses the whole bed.
+                top: pct(d.y, BED.h),
+                width: 1,
+                height: pct(d.len, BED.h),
+                background: `linear-gradient(rgb(${rainTone} / 0), rgb(${rainTone} / 0.75))`,
+                transform: `rotate(${SLANT_DEG}deg)`,
+                opacity: 0.6,
+                willChange: calm ? undefined : "transform, opacity",
+              }}
+            />
+          ))}
+          <svg viewBox={`0 0 ${BED.w} ${BED.h}`} style={ART} aria-hidden>
+            {[78, 188, 312].map((x) => (
+              <ellipse key={x} cx={x} cy={BED.soil + 2} rx="9" ry="2.2" fill="none" stroke={RIM} strokeWidth=".6" opacity=".55" />
+            ))}
+          </svg>
+        </>
+      )}
+      {dressing === "holi" &&
+        PATCHES.map((p) => (
+          <span
+            key={p.x}
+            style={{
+              position: "absolute",
+              left: pct(p.x - p.w / 2, BED.w),
+              top: pct(p.y - 9, BED.h),
+              width: pct(p.w, BED.w),
+              height: pct(18, BED.h),
+              background: glow(GULAL[p.c], 0.55),
+            }}
+          />
+        ))}
+    </div>
+  );
+};
+
+export default FestivalDressing;
