--- /dev/null
+++ b/src/lib/auth/password.ts
@@ -0,0 +1,15 @@
+/*
+  The rules for a password she chooses (registering, or after a reset link).
+  Six is Supabase's default minimum and what registering has always asked
+  for; 72 is where its hashing stops reading.
+*/
+export const PASSWORD_MIN = 6;
+export const PASSWORD_MAX = 72;
+
+/** Why a new password cannot be saved yet, or null when it can. */
+export const newPasswordProblem = (password: string, confirm: string): string | null => {
+  if (password.length < PASSWORD_MIN) return `Please use at least ${PASSWORD_MIN} characters.`;
+  if (password.length > PASSWORD_MAX) return `Please use ${PASSWORD_MAX} characters or fewer.`;
+  if (password !== confirm) return "The two passwords don't match.";
+  return null;
+};
diff --git a/src/lib/auth/signupChoices.test.ts b/src/lib/auth/signupChoices.test.ts
new file mode 100644
index 0000000..6a571c5
--- /dev/null
+++ b/src/lib/auth/signupChoices.test.ts
@@ -0,0 +1,95 @@
+import { describe, expect, it, vi } from "vitest";
+import { carryOverPatch, carrySignupChoices, savedSinceSignup, signupData } from "./signupChoices";
+
+const MADE = "2026-11-05T04:10:00.123456+00:00";
+const LATER = "2026-11-06T09:00:00.5+00:00";
+const NOW = new Date("2026-11-07T00:00:00Z");
+
+describe("signupData", () => {
+  it("carries her name and her answer, with the time of a yes", () => {
+    expect(signupData(" Ananya ", true, NOW)).toEqual({
+      full_name: "Ananya",
+      ad_matching_consent: true,
+      ad_matching_consent_at: NOW.toISOString(),
+    });
+    expect(signupData("", false, NOW)).toEqual({ full_name: null, ad_matching_consent: false, ad_matching_consent_at: null });
+  });
+});
+
+describe("carryOverPatch", () => {
+  const yes = { full_name: "Ananya", ad_matching_consent: true, ad_matching_consent_at: "2026-11-05T04:09:00.000Z" };
+
+  it("copies a sign-up yes into a profile the account has only just made", () => {
+    expect(carryOverPatch(yes, { full_name: "Ananya", ad_matching_consent: false, created_at: MADE, updated_at: MADE }, NOW)).toEqual({
+      ad_matching_consent: true,
+      ad_matching_consent_at: "2026-11-05T04:09:00.000Z",
+    });
+    expect(carryOverPatch(yes, null, NOW)).toEqual({
+      full_name: "Ananya",
+      ad_matching_consent: true,
+      ad_matching_consent_at: "2026-11-05T04:09:00.000Z",
+    });
+  });
+
+  it("never ticks anything she did not tick", () => {
+    expect(carryOverPatch({ ad_matching_consent: false, ad_matching_consent_at: null }, null, NOW)).toBeNull();
+    expect(carryOverPatch({ full_name: "Ananya" }, null, NOW)).toBeNull();
+    expect(carryOverPatch(null, null, NOW)).toBeNull();
+    expect(carryOverPatch({ ad_matching_consent: "yes" }, null, NOW)).toBeNull();
+  });
+
+  it("leaves alone a profile she has saved since, and one that already says yes", () => {
+    expect(savedSinceSignup({ created_at: MADE, updated_at: LATER })).toBe(true);
+    expect(carryOverPatch(yes, { ad_matching_consent: false, created_at: MADE, updated_at: LATER }, NOW)).toBeNull();
+    expect(carryOverPatch(yes, { ad_matching_consent: true, created_at: MADE, updated_at: MADE }, NOW)).toBeNull();
+  });
+
+  it("dates the yes now when the account kept no time for it", () => {
+    expect(carryOverPatch({ ad_matching_consent: true }, { created_at: MADE, updated_at: MADE }, NOW)).toEqual({
+      ad_matching_consent: true,
+      ad_matching_consent_at: NOW.toISOString(),
+    });
+  });
+});
+
+describe("carrySignupChoices", () => {
+  const client = (row: unknown, readError: unknown = null, writeError: unknown = null) => {
+    const upsert = vi.fn(async () => ({ error: writeError }));
+    const maybeSingle = vi.fn(async () => ({ data: row, error: readError }));
+    const from = vi.fn(() => ({ select: () => ({ eq: () => ({ maybeSingle }) }), upsert }));
+    return { from, upsert, maybeSingle, sb: { from } as never };
+  };
+  const member = { id: "u1", user_metadata: { ad_matching_consent: true, ad_matching_consent_at: "2026-11-05T04:09:00.000Z" } };
+
+  it("asks nothing of the server for a member who did not say yes", async () => {
+    const c = client(null);
+    expect(await carrySignupChoices(c.sb, { id: "u1", user_metadata: { full_name: "Ananya" } })).toBe(false);
+    expect(c.from).not.toHaveBeenCalled();
+  });
+
+  it("writes the yes once, to her own row", async () => {
+    const c = client({ ad_matching_consent: false, created_at: MADE, updated_at: MADE });
+    expect(await carrySignupChoices(c.sb, member)).toBe(true);
+    // It marks the row itself, so the copy is once even where the database has no updated_at trigger.
+    expect(c.upsert).toHaveBeenCalledWith({ id: "u1", ad_matching_consent: true, ad_matching_consent_at: "2026-11-05T04:09:00.000Z", updated_at: expect.any(String) });
+  });
+
+  it("never ticks her yes back on after she has said no on /account, trigger or no trigger", async () => {
+    // The copy wrote updated_at; then her "no" on /account (which also writes updated_at) stands.
+    const carried = (c: ReturnType<typeof client>) => (c.upsert.mock.calls[0] as unknown as [Record<string, unknown>])[0].updated_at as string;
+    const first = client({ ad_matching_consent: false, created_at: MADE, updated_at: MADE });
+    await carrySignupChoices(first.sb, member);
+    const withdrawn = client({ ad_matching_consent: false, ad_matching_consent_at: null, created_at: MADE, updated_at: carried(first) });
+    expect(await carrySignupChoices(withdrawn.sb, member)).toBe(false);
+    expect(withdrawn.upsert).not.toHaveBeenCalled();
+  });
+
+  it("writes nothing once the row has moved on, or when the server cannot be read", async () => {
+    const moved = client({ ad_matching_consent: false, created_at: MADE, updated_at: LATER });
+    expect(await carrySignupChoices(moved.sb, member)).toBe(false);
+    expect(moved.upsert).not.toHaveBeenCalled();
+    const offline = client(null, { message: "Failed to fetch" });
+    expect(await carrySignupChoices(offline.sb, member)).toBe(false);
+    expect(offline.upsert).not.toHaveBeenCalled();
+  });
+});
diff --git a/src/lib/auth/signupChoices.ts b/src/lib/auth/signupChoices.ts
new file mode 100644
index 0000000..444425a
--- /dev/null
+++ b/src/lib/auth/signupChoices.ts
@@ -0,0 +1,100 @@
+import type { supabase as Client } from "@/integrations/supabase/client";
+
+/*
+  Her name and her ad-matching answer, from the moment she registers.
+
+  With "Confirm email" on, signUp returns no session, so the profile write
+  that used to follow it was refused by row security and her answer to the
+  consent box was lost. Both now travel in signUp's options.data, which
+  Supabase keeps on the account (user_metadata) through the confirmation
+  email. The database trigger already copies full_name into her profile row
+  when the account is made; her consent is copied by carrySignupChoices the
+  first time she is signed in on /auth, where the confirmation link lands
+  (only Auth calls it).
+
+  It is copied once, and only while her profile row is as the account made
+  it (updated_at still equals created_at). Anything she has saved since, on
+  /account or in the garden, is her later word and stands. Only a "yes" is
+  copied: "no" is what an untouched profile already says. Nothing is ever
+  ticked that she did not tick.
+
+  "Once" does not lean on the database's updated_at trigger: the copy, and
+  every other write the site makes to her row (Account's form, the arrival
+  repair), sends updated_at itself, so a later "no" on /account can never be
+  overturned by this copy at her next sign-in, trigger or no trigger.
+*/
+
+export type SignupData = {
+  full_name: string | null;
+  ad_matching_consent: boolean;
+  ad_matching_consent_at: string | null;
+};
+
+export const signupData = (name: string | undefined, adConsent: boolean, now = new Date()): SignupData => ({
+  full_name: name?.trim() ? name.trim().slice(0, 80) : null,
+  ad_matching_consent: adConsent,
+  ad_matching_consent_at: adConsent ? now.toISOString() : null,
+});
+
+export type ProfileRow = {
+  full_name?: string | null;
+  ad_matching_consent?: boolean | null;
+  ad_matching_consent_at?: string | null;
+  created_at?: string | null;
+  updated_at?: string | null;
+};
+
+export type ProfilePatch = { full_name?: string; ad_matching_consent?: true; ad_matching_consent_at?: string };
+
+const time = (iso: unknown): number => (typeof iso === "string" ? Date.parse(iso) : NaN);
+
+/** True once anything has been saved to her row after the account made it. */
+export const savedSinceSignup = (row: ProfileRow | null): boolean => {
+  if (!row) return false;
+  const made = time(row.created_at);
+  const changed = time(row.updated_at);
+  return Number.isFinite(made) && Number.isFinite(changed) && changed !== made;
+};
+
+/** The profile fields still to copy from her sign-up, or null when there is nothing to do. */
+export const carryOverPatch = (
+  meta: Record<string, unknown> | null | undefined,
+  row: ProfileRow | null,
+  now = new Date(),
+): ProfilePatch | null => {
+  if (!meta || meta.ad_matching_consent !== true) return null;
+  if (row?.ad_matching_consent === true || savedSinceSignup(row)) return null;
+  const at = time(meta.ad_matching_consent_at);
+  const patch: ProfilePatch = {
+    ad_matching_consent: true,
+    ad_matching_consent_at: Number.isFinite(at) ? new Date(at).toISOString() : now.toISOString(),
+  };
+  const name = typeof meta.full_name === "string" ? meta.full_name.trim().slice(0, 80) : "";
+  if (name && !row?.full_name) patch.full_name = name;
+  return patch;
+};
+
+type Member = { id: string; user_metadata?: Record<string, unknown> | null };
+
+/**
+ * Copies a sign-up "yes" into her profile if it has not reached it yet.
+ * Resolves true only when something was written. Never throws.
+ */
+export const carrySignupChoices = async (client: typeof Client, user: Member): Promise<boolean> => {
+  const meta = user.user_metadata ?? null;
+  if (!meta || meta.ad_matching_consent !== true) return false; // the usual case: no request at all
+  try {
+    const { data, error } = await client
+      .from("profiles")
+      .select("full_name, ad_matching_consent, ad_matching_consent_at, created_at, updated_at")
+      .eq("id", user.id)
+      .maybeSingle();
+    if (error) return false;
+    const patch = carryOverPatch(meta, (data as ProfileRow | null) ?? null);
+    if (!patch) return false;
+    const { error: writeError } = await client.from("profiles").upsert({ id: user.id, ...patch, updated_at: new Date().toISOString() } as never);
+    return !writeError;
+  } catch {
+    return false;
+  }
+};
