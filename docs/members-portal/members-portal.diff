+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const db = vi.hoisted(() => ({
+  rows: [] as unknown[],
+  selectError: null as unknown,
+  upsertError: null as unknown,
+  calls: [] as unknown[][],
+}));
+vi.mock("@/integrations/supabase/lazy", () => ({
+  getSupabase: async () => ({
+    from: (table: string) => ({
+      select: (cols: string) => ({
+        eq: (col: string, value: string) => ({
+          limit: async (n: number) => {
+            db.calls.push(["select", table, cols, col, value, n]);
+            return { data: db.selectError ? null : db.rows, error: db.selectError };
+          },
+        }),
+      }),
+      upsert: async (row: unknown) => {
+        db.calls.push(["upsert", table, row]);
+        return { error: db.upsertError };
+      },
+    }),
+  }),
+}));
+
+import {
+  ARRIVAL_JOIN_TELLS_META,
+  ARRIVAL_SOURCE,
+  arrivalNeeds,
+  changedSinceMade,
+  consentAnswered,
+  liveArrivalActions,
+  markOffered,
+  previewArrivalActions,
+  wasOffered,
+} from "./arrival";
+import { PORTAL_KEY, readPortal, writePortal } from "./safeStorage";
+
+const ANANYA = { id: "u-ananya", email: "ananya.r@example.com", user_metadata: {} };
+const MEERA = { id: "u-meera", email: "meera@example.com", user_metadata: {} };
+const untouched = { ad_matching_consent: false, ad_matching_consent_at: null };
+
+beforeEach(() => {
+  window.localStorage.clear();
+  db.rows = [];
+  db.selectError = null;
+  db.upsertError = null;
+  db.calls = [];
+});
+
+describe("consentAnswered", () => {
+  it("reads a yes, a dated answer, or the answer she gave when registering", () => {
+    expect(consentAnswered(ANANYA, { ad_matching_consent: true })).toBe(true);
+    expect(consentAnswered(ANANYA, { ad_matching_consent: false, ad_matching_consent_at: "2026-11-01T00:00:00Z" })).toBe(true);
+    expect(consentAnswered({ ...ANANYA, user_metadata: { ad_matching_consent: false } }, untouched)).toBe(true);
+    expect(consentAnswered({ ...ANANYA, user_metadata: { ad_matching_consent: true } }, untouched)).toBe(true);
+  });
+
+  it("finds a Google sign-up, or one whose answer was lost at confirmation, never asked", () => {
+    expect(consentAnswered(ANANYA, untouched)).toBe(false);
+    expect(consentAnswered({ ...ANANYA, user_metadata: { full_name: "Ananya", avatar_url: "x" } }, untouched)).toBe(false);
+    // A row exactly as the sign-up trigger made it: never changed since.
+    const made = "2026-11-01T04:00:00.123456+00:00";
+    expect(consentAnswered(ANANYA, { ...untouched, created_at: made, updated_at: made })).toBe(false);
+  });
+
+  it("counts a no saved on /account (no consent date, but her row changed since it was made) as answered", () => {
+    const saidNo = { ad_matching_consent: false, ad_matching_consent_at: null, created_at: "2026-11-01T04:00:00+00:00", updated_at: "2026-11-03T09:30:00+00:00" };
+    expect(changedSinceMade(saidNo)).toBe(true);
+    expect(consentAnswered(ANANYA, saidNo)).toBe(true);
+    // Unreadable dates prove nothing.
+    expect(changedSinceMade({ ...saidNo, updated_at: "soon" })).toBe(false);
+    expect(changedSinceMade(null)).toBe(false);
+  });
+});
+
+describe("what this device has offered", () => {
+  it("remembers each need per member, beside the portal's other device flags", () => {
+    writePortal({ seedSeen: true });
+    expect(wasOffered(ANANYA.id, "join")).toBe(false);
+    markOffered(ANANYA.id, ["join"]);
+    expect(wasOffered(ANANYA.id, "join")).toBe(true);
+    expect(wasOffered(ANANYA.id, "consent")).toBe(false);
+    expect(wasOffered(MEERA.id, "join")).toBe(false);
+    markOffered(ANANYA.id, ["consent"]);
+    expect(wasOffered(ANANYA.id, "join")).toBe(true);
+    expect(readPortal().seedSeen).toBe(true);
+  });
+
+  it("reads a broken store as nothing offered", () => {
+    window.localStorage.setItem(PORTAL_KEY, JSON.stringify({ arrival: ["nonsense"] }));
+    expect(wasOffered(ANANYA.id, "join")).toBe(false);
+    window.localStorage.setItem(PORTAL_KEY, "{not json");
+    expect(wasOffered(ANANYA.id, "consent")).toBe(false);
+  });
+});
+
+describe("arrivalNeeds", () => {
+  const actions = liveArrivalActions(vi.fn(), async () => {});
+
+  it("offers the list when she has no row of her own, asking with her own account id", async () => {
+    expect(await arrivalNeeds(ANANYA, untouched, actions.hasOwnSignup)).toEqual({ join: true, consent: true });
+    expect(db.calls[0]).toEqual(["select", "inner_circle_signups", "id", "user_id", ANANYA.id, 1]);
+  });
+
+  it("offers nothing she already has", async () => {
+    db.rows = [{ id: "row-1" }];
+    expect(await arrivalNeeds(ANANYA, { ad_matching_consent: true }, actions.hasOwnSignup)).toEqual({ join: false, consent: false });
+  });
+
+  it("offers each need at most once for her on this device", async () => {
+    markOffered(ANANYA.id, ["join", "consent"]);
+    expect(await arrivalNeeds(ANANYA, untouched, actions.hasOwnSignup)).toEqual({ join: false, consent: false });
+    expect(db.calls).toEqual([]);
+    expect(await arrivalNeeds(MEERA, untouched, actions.hasOwnSignup)).toEqual({ join: true, consent: true });
+  });
+
+  it("offers nothing it is unsure of: no list check, no profile read, no email", async () => {
+    db.selectError = { message: "Failed to fetch" };
+    expect((await arrivalNeeds(ANANYA, untouched, actions.hasOwnSignup)).join).toBe(false);
+    expect((await arrivalNeeds(ANANYA, null, actions.hasOwnSignup)).consent).toBe(false);
+    db.selectError = null;
+    expect((await arrivalNeeds({ ...ANANYA, email: null }, untouched, actions.hasOwnSignup)).join).toBe(false);
+  });
+});
+
+describe("the writes", () => {
+  it("joins the list through the join it is handed, with the arrival source", async () => {
+    const join = vi.fn(async () => ({ ok: true as const, already: true }));
+    const actions = liveArrivalActions(join, async () => {});
+    expect(await actions.join({ email: ANANYA.email, userId: ANANYA.id })).toEqual({ ok: true, already: true });
+    expect(join).toHaveBeenCalledWith({ email: ANANYA.email, name: undefined, source: "members-arrival", userId: ANANYA.id });
+    expect(ARRIVAL_SOURCE.length).toBeLessThanOrEqual(40);
+    // Lead and Subscribe stay unsent from the portal until the owner approves them (MembersRoute hands in the quiet join).
+    expect(ARRIVAL_JOIN_TELLS_META).toBe(false);
+  });
+
+  it("writes her answer to her own profile row as /account does, then refreshes it", async () => {
+    const refresh = vi.fn(async () => {});
+    const actions = liveArrivalActions(vi.fn(), refresh);
+    expect(await actions.saveConsent(ANANYA.id, true)).toEqual({ ok: true });
+    const [, table, row] = db.calls[0] as [string, string, Record<string, unknown>];
+    expect(table).toBe("profiles");
+    expect(row).toMatchObject({ id: ANANYA.id, ad_matching_consent: true });
+    expect(Date.parse(row.ad_matching_consent_at as string)).not.toBeNaN();
+    expect(Date.parse(row.updated_at as string)).not.toBeNaN();
+    expect(refresh).toHaveBeenCalled();
+    // A no: no consent date, and updated_at, so it counts as answered.
+    expect(await actions.saveConsent(ANANYA.id, false)).toEqual({ ok: true });
+    const [, , no] = db.calls[1] as [string, string, Record<string, unknown>];
+    expect(no).toMatchObject({ id: ANANYA.id, ad_matching_consent: false, ad_matching_consent_at: null });
+    expect(Date.parse(no.updated_at as string)).not.toBeNaN();
+  });
+
+  it("says when the profile would not take it", async () => {
+    db.upsertError = { message: "denied" };
+    const refresh = vi.fn(async () => {});
+    expect(await liveArrivalActions(vi.fn(), refresh).saveConsent(ANANYA.id, true)).toEqual({ ok: false, message: expect.stringMatching(/try again/) });
+    expect(refresh).not.toHaveBeenCalled();
+  });
+
+  it("logs every preview write and makes none", async () => {
+    const log = vi.fn();
+    const preview = previewArrivalActions(log);
+    expect(await preview.hasOwnSignup(ANANYA.id)).toBe(false);
+    expect(await preview.join({ email: ANANYA.email, userId: ANANYA.id })).toEqual({ ok: true, already: false });
+    expect(await preview.saveConsent(ANANYA.id, true)).toEqual({ ok: true });
+    expect(log).toHaveBeenCalledTimes(2);
+    expect(log.mock.calls[0][1]).toMatchObject({ source: "members-arrival" });
+    expect(db.calls).toEqual([]);
+  });
+});
diff --git a/src/lib/portal/arrival.ts b/src/lib/portal/arrival.ts
new file mode 100644
index 0000000..9bceb1d
--- /dev/null
+++ b/src/lib/portal/arrival.ts
@@ -0,0 +1,203 @@
+import { getSupabase } from "@/integrations/supabase/lazy";
+import { readPortal, writePortal, type PortalStore } from "./safeStorage";
+
+/*
+  Arrival repair: two things a member can be missing on her first signed-in
+  visit to the garden, each offered once and never again.
+
+  - The Inner Circle list. Signing up with Google never added her to it (only
+    the email form did). If she has no list row of her own, one "Join the
+    list" tap adds her with source "members-arrival". A row she made before
+    she had an account (user_id empty, so row security hides it from her)
+    answers the insert with 23505, which joinInnerCircle already reads as
+    "already on the list".
+
+  - Her ad-matching answer. Google sign-ups were never asked, and before
+    Phase 3 an email sign-up's answer was lost at the confirmation step. If
+    neither her profile nor her account records an answer, the consent box
+    is shown once, UNTICKED. "Save my choice" writes what she chose: ticked,
+    her yes; unticked, her no (with the time, so it counts as answered).
+    A "no" saved on /account leaves no consent date, but it does leave her
+    row changed since it was made (updated_at later than created_at, kept by
+    the database's trigger), and that counts as answered too. That reading
+    is exact for the shop's own writes: every one of them writes her answer
+    with it (consentWriters.test holds them to it), but the portal's
+    birthday save, and that one comes after the question is decided (from
+    her profile as her rooms opened, on her first visit only). Only a change
+    made outside the shop's code, in the database itself, is read as an
+    answer she did not give; the box is then not shown, which errs on the
+    side of not asking.
+
+  "Once" is per member: the card is offered only on her first signed-in
+  visit (her account had no visit day as she arrived, lib/portal/memberMeta
+  firstVisit; a reload that same day on the same phone is still that visit),
+  and her account keeps nothing about it. This device also remembers what it
+  showed her (in the naira-portal store, keyed by her account id, so another
+  member on the same phone is still asked), and the check against her row
+  and profile means a need already met is never offered at all. Nothing is
+  pre-ticked, and nothing comes back after "No, thank you".
+
+  The list join tells Meta nothing until the owner approves: the shop's
+  joinInnerCircle sends Lead and Subscribe (pixel and CAPI) on a join, and
+  from the portal that would be a new source of events. So the portal joins
+  through its own copy of that insert, joinListQuietly (the same row, the
+  same 23505 answer, no events), and lib/innerCircle is left exactly as the
+  shop has it. Once the owner approves, ARRIVAL_JOIN_TELLS_META = true makes
+  MembersRoute hand in the shop's joinInnerCircle instead.
+
+  The writes are handed in (ArrivalActions), so the development preview can
+  log them instead.
+*/
+
+export const ARRIVAL_SOURCE = "members-arrival";
+export const ARRIVAL_JOIN_TELLS_META = false;
+
+export type ArrivalNeed = "join" | "consent";
+export type ArrivalNeeds = Record<ArrivalNeed, boolean>;
+
+export type JoinOutcome = { ok: true; already: boolean } | { ok: false; message: string };
+export type SaveOutcome = { ok: true } | { ok: false; message: string };
+
+/** The shape of lib/innerCircle's joinInnerCircle. */
+export type JoinFn = (input: { email: string; name?: string; source?: string; userId?: string | null }) => Promise<JoinOutcome>;
+
+export type ArrivalActions = {
+  /** Whether a list row with her account id exists. Throws when it cannot tell. */
+  hasOwnSignup: (userId: string) => Promise<boolean>;
+  join: (input: { email: string; name?: string; userId: string }) => Promise<JoinOutcome>;
+  /** Writes her answer to ad matching, yes or no (her own profile row). */
+  saveConsent: (userId: string, yes: boolean) => Promise<SaveOutcome>;
+};
+
+export type ArrivalUser = { id: string; email?: string | null; user_metadata?: Record<string, unknown> | null };
+export type ArrivalProfile = {
+  ad_matching_consent?: boolean | null;
+  ad_matching_consent_at?: string | null;
+  created_at?: string | null;
+  updated_at?: string | null;
+} | null;
+
+/** Her row has been changed since it was made: the database's trigger moves updated_at on every update. */
+export const changedSinceMade = (profile: ArrivalProfile): boolean => {
+  const made = Date.parse(profile?.created_at ?? "");
+  const changed = Date.parse(profile?.updated_at ?? "");
+  return Number.isFinite(made) && Number.isFinite(changed) && changed > made;
+};
+
+/**
+ * Whether she has ever answered the consent box: a yes in her profile, a
+ * date it was given, the answer she gave when registering (kept on her
+ * account since Phase 3, and copied to her profile on her first sign-in), or
+ * a row she has changed since it was made (a "no" saved on /account).
+ */
+export const consentAnswered = (user: ArrivalUser, profile: ArrivalProfile): boolean =>
+  profile?.ad_matching_consent === true ||
+  Boolean(profile?.ad_matching_consent_at) ||
+  typeof user.user_metadata?.ad_matching_consent === "boolean" ||
+  changedSinceMade(profile);
+
+/* ── this device's memory of what was offered ─────────────────────────── */
+
+type Offered = NonNullable<PortalStore["arrival"]>[string];
+
+const offeredMap = (): Record<string, Offered> => {
+  const map = readPortal().arrival;
+  return map && typeof map === "object" && !Array.isArray(map) ? map : {};
+};
+
+export const wasOffered = (userId: string, need: ArrivalNeed): boolean => offeredMap()[userId]?.[need] === true;
+
+export const markOffered = (userId: string, needs: readonly ArrivalNeed[]): boolean => {
+  if (!needs.length) return true;
+  const map = offeredMap();
+  const own = { ...map[userId] };
+  for (const need of needs) own[need] = true;
+  return writePortal({ arrival: { ...map, [userId]: own } });
+};
+
+/**
+ * What to offer her on her first visit. Each need counts only if this device
+ * has not shown it to her before and her account does not already meet it.
+ * A list check that fails (offline) offers nothing for the list this time.
+ */
+export const arrivalNeeds = async (user: ArrivalUser, profile: ArrivalProfile, hasOwnSignup: ArrivalActions["hasOwnSignup"]): Promise<ArrivalNeeds> => {
+  const offered = (need: ArrivalNeed) => wasOffered(user.id, need);
+  /* No profile read (a slow network let her in without it): her answer is
+     unknown, so the box is not shown rather than asked again by mistake. */
+  const consent = !offered("consent") && profile !== null && !consentAnswered(user, profile);
+  let join = false;
+  if (user.email && !offered("join")) {
+    try {
+      join = !(await hasOwnSignup(user.id));
+    } catch {
+      join = false;
+    }
+  }
+  return { join, consent };
+};
+
+/* ── the writes ───────────────────────────────────────────────────────── */
+
+const SAVE_FAILED = "We couldn't save that just now. Please try again.";
+const JOIN_FAILED = "Something went wrong. Please try again.";
+const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
+
+/**
+ * The shop's list insert (lib/innerCircle's joinInnerCircle), copied for the
+ * portal without its Meta Lead and Subscribe events: the same row, the same
+ * limits, and a duplicate (23505, the unique index on lower(email)) read as
+ * already on the list. Her email comes from her own account.
+ */
+export const joinListQuietly: JoinFn = async ({ email, name, source = ARRIVAL_SOURCE, userId = null }) => {
+  const address = email.trim();
+  if (!EMAIL.test(address) || address.length > 255) return { ok: false, message: "Please enter a valid email address" };
+  const named = (name ?? "").trim();
+  if (named.length > 80) return { ok: false, message: "Name must be less than 80 characters" };
+  try {
+    const supabase = await getSupabase();
+    const { error } = await supabase.from("inner_circle_signups").insert({ email: address, name: named || null, phone: null, source, user_id: userId });
+    if (error) return error.code === "23505" ? { ok: true, already: true } : { ok: false, message: JOIN_FAILED };
+    return { ok: true, already: false };
+  } catch {
+    return { ok: false, message: JOIN_FAILED };
+  }
+};
+
+/** The real writes: her own list row through `join` (joinListQuietly until the owner approves Meta's events), her own profile row for her answer. */
+export const liveArrivalActions = (join: JoinFn, refreshProfile: () => Promise<void>): ArrivalActions => ({
+  hasOwnSignup: async (userId) => {
+    const supabase = await getSupabase();
+    const { data, error } = await supabase.from("inner_circle_signups").select("id").eq("user_id", userId).limit(1);
+    if (error) throw error;
+    return (data?.length ?? 0) > 0;
+  },
+  join: ({ email, name, userId }) => join({ email, name, source: ARRIVAL_SOURCE, userId }),
+  saveConsent: async (userId, yes) => {
+    try {
+      const supabase = await getSupabase();
+      const now = new Date().toISOString();
+      // As /account saves it: a yes with its time, a no with none; updated_at marks it answered either way.
+      const { error } = await supabase
+        .from("profiles")
+        .upsert({ id: userId, ad_matching_consent: yes, ad_matching_consent_at: yes ? now : null, updated_at: now } as never);
+      if (error) return { ok: false, message: SAVE_FAILED };
+      await refreshProfile();
+      return { ok: true };
+    } catch {
+      return { ok: false, message: SAVE_FAILED };
+    }
+  },
+});
+
+/** The development preview's stand-ins: every write is logged, none is made. */
+export const previewArrivalActions = (log: (what: string, detail: unknown) => void): ArrivalActions => ({
+  hasOwnSignup: async () => false,
+  join: async ({ email, name, userId }) => {
+    log("inner_circle_signups", { email, name, source: ARRIVAL_SOURCE, user_id: userId });
+    return { ok: true, already: false };
+  },
+  saveConsent: async (userId, yes) => {
+    log("profiles.ad_matching_consent", { id: userId, ad_matching_consent: yes });
+    return { ok: true };
+  },
+});
