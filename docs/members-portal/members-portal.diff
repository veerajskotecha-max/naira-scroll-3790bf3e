+    expect(screen.getByRole("heading", { name: "Opening shortly" })).toBeInTheDocument();
+    expect(view.container.querySelector(".ig-unbox")).toBeNull();
+    cleanup();
+    // Then the shop cannot be reached: one quiet line, no box, no card per piece.
+    shop.jewellery = [necklace, other, soldOut];
+    shop.isLive = false;
+    (shop as { isLoading?: boolean }).isLoading = false;
+    view = await visit("/members/drops/verdant");
+    expect(view.container.querySelector(".ig-unbox")).toBeNull();
+    expect(view.container.querySelectorAll(".ig-piece")).toHaveLength(0);
+    expect(screen.getAllByText(/We couldn't reach the shop just now/)).toHaveLength(1);
+    expect(screen.getByRole("link", { name: "See the pieces on the shop" }).getAttribute("href")).toBe("/jewellery");
+    cleanup();
+    expect(JSON.parse(window.localStorage.getItem("naira-portal")!).unboxed).toBeUndefined();
+    // With the pieces live, the unboxing plays.
+    shop.isLive = true;
+    delete (shop as { isLoading?: boolean }).isLoading;
+    view = await visit("/members/drops/verdant");
+    expect(view.container.querySelector(".ig-unbox.is-playing")).not.toBeNull();
+  });
+
+  it("opens checkout once for a double tap on Buy now, and waits while the bag is busy", async () => {
+    vi.useFakeTimers({ now: opens + 20 * 60_000 });
+    setReducedMotion(true);
+    let release: () => void = () => {};
+    cart.buyNow.mockImplementationOnce(() => new Promise<void>((r) => (release = r)));
+    await visit("/members/drops/verdant");
+    const card = screen.getByRole("link", { name: other.name }).closest("article")!;
+    const buy = () => card.querySelectorAll("button")[1] as HTMLButtonElement;
+    fireEvent.click(buy());
+    fireEvent.click(buy());
+    await flush();
+    expect(cart.buyNow).toHaveBeenCalledTimes(1);
+    expect(buy()).toHaveTextContent("Opening checkout…");
+    expect(buy().disabled).toBe(true);
+    expect((card.querySelectorAll("button")[0] as HTMLButtonElement).disabled).toBe(true);
+    await act(async () => release());
+    await flush();
+    expect(buy().disabled).toBe(false);
+    cleanup();
+    // The bag is busy with Shopify (an add on its way): Buy now waits for it.
+    cart.isLoading = true;
+    await visit("/members/drops/verdant");
+    const busyCard = screen.getByRole("link", { name: other.name }).closest("article")!;
+    expect((busyCard.querySelectorAll("button")[1] as HTMLButtonElement).disabled).toBe(true);
+    cart.isLoading = false;
+  });
+
+  it("offers her flower only in the members' window: once everyone sees it, a pressed flower stays and no new one is offered", async () => {
+    const everyone = Date.parse("2026-11-23T20:00:00+05:30");
+    vi.useFakeTimers({ now: everyone + 60 * 60_000 });
+    setReducedMotion(true);
+    window.localStorage.setItem("naira-portal", JSON.stringify({ doorsDay: "x", seedSeen: true, unboxed: { verdant: true } }));
+    await visit("/members/drops/verdant");
+    expect(screen.getByText("Drop 01 · now on the shop")).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Press your flower" })).toBeNull();
+    expect(JSON.parse(window.localStorage.getItem("naira-portal")!).pressedLocal).toBeUndefined();
+    cleanup();
+    // Pressed in its window, then visited once it is everyone's: her flower is still there, pressed.
+    vi.setSystemTime(opens + 20 * 60_000);
+    await visit("/members/drops/verdant");
+    fireEvent.click(screen.getByRole("button", { name: "Press your flower" }));
+    await flush();
+    cleanup();
+    vi.setSystemTime(everyone + 60 * 60_000);
+    const { container } = await visit("/members/drops/verdant");
+    expect(screen.queryByRole("button", { name: "Press your flower" })).toBeNull();
+    expect(container.querySelector(".ig-press .ig-herb-label")!.textContent).toBe("Drop 01 · Verdantpressed 21 Nov");
+  });
+
+  it("says when everyone else sees it, and keeps a pressed flower in the Vault at once", async () => {
+    vi.useFakeTimers({ now: opens + 20 * 60_000 });
+    setReducedMotion(true);
+    await visit("/members/drops/verdant");
+    expect(screen.getByText("Yours to see first. We share it with everyone Mon 23 Nov · 8:00 pm IST.")).toBeInTheDocument();
+    fireEvent.click(screen.getByRole("button", { name: "Press your flower" }));
+    await flush();
+    cleanup();
+    const { container } = await visit("/members/vault");
+    expect(screen.queryByText(/Nothing is in the Vault yet/)).toBeNull();
+    expect(container.querySelector(".ig-wall .ig-herb.is-empty")).toBeNull();
+    expect(screen.getByRole("link", { name: /Drop 01 · Verdant/ }).getAttribute("href")).toBe("/members/drops/verdant");
+  });
+
+  it("reads 'Opening shortly' when the time has passed but nothing is on the shop, never a clock below zero", async () => {
+    vi.useFakeTimers({ now: opens + 20 * 60_000 });
+    setReducedMotion(true);
+    shop.jewellery = [];
+    const { container } = await visit("/members/drops/verdant");
+    expect(screen.getByRole("heading", { name: "Opening shortly" })).toBeInTheDocument();
+    expect(container.querySelector(".ig-bc")).toBeNull();
+    expect(container.querySelector(".ig-unbox")).toBeNull();
+    expect(screen.getAllByRole("link", { name: "Arriving · ask on WhatsApp" })).toHaveLength(verdant.handles.length);
+  });
+});
+
+describe("a drop in the Vault", () => {
+  beforeEach(() => manifest.drops.push(verdant));
+
+  it("is a gentle empty frame when she did not press it", async () => {
+    vi.useFakeTimers({ now: Date.parse("2026-12-20T06:30:00Z") });
+    const { container } = await visit("/members/vault");
+    expect(screen.getByText("This one bloomed in November")).toBeInTheDocument();
+    expect(container.querySelector(".ig-herb.is-empty")).not.toBeNull();
+    expect(container.textContent).not.toMatch(BANNED);
+  });
+
+  it("holds her pressed flower when she did", async () => {
+    vi.useFakeTimers({ now: Date.parse("2026-12-20T06:30:00Z") });
+    window.localStorage.setItem("naira-portal", JSON.stringify({ pressedLocal: ["verdant"], pressedOn: { verdant: "2026-11-21" } }));
+    const { container } = await visit("/members/vault");
+    expect(screen.getByText("pressed 21 Nov")).toBeInTheDocument();
+    expect(container.querySelector(".ig-herb.is-empty")).toBeNull();
+  });
+});
+
+describe("the unboxing's petals", () => {
+  it("are at most 24, and every flight ends by 1.6 s", () => {
+    expect(ballisticFlights(200)).toHaveLength(MAX_BURST);
+    for (const f of ballisticFlights(24, { seed: "verdant" })) {
+      expect(f.delay + f.duration).toBeLessThanOrEqual(BURST_MS);
+      expect(f.keyframes[0].opacity).toBe(0);
+      expect(f.keyframes[f.keyframes.length - 1].opacity).toBe(0);
+      for (const k of f.keyframes) expect(Object.keys(k).sort()).toEqual(["offset", "opacity", "transform"]);
+    }
+  });
+
+  it("are the same arcs for a drop on every phone", () => {
+    expect(ballisticFlights(24, { seed: "verdant" })).toEqual(ballisticFlights(24, { seed: "verdant" }));
+  });
+});
+
+/* Nothing in the portal sits above the z-40 tier: the bag drawer (z-50) opens over all of it. */
+describe("layers", () => {
+  it("keeps every portal z-index at 40 or below", () => {
+    const src = resolve(__dirname, "../..");
+    const css = (dir: string): string[] =>
+      readdirSync(dir, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? css(join(dir, e.name)) : /\.(css|tsx)$/.test(e.name) && !/\.test\./.test(e.name) ? [join(dir, e.name)] : []));
+    const values = ["pages/members", "components/portal"].flatMap((d) => css(join(src, d))).flatMap((f) => [...readFileSync(f, "utf8").matchAll(/z-index:\s*(\d+)|zIndex:\s*(\d+)/g)].map((m) => Number(m[1] ?? m[2])));
+    expect(values.length).toBeGreaterThan(0);
+    expect(Math.max(...values)).toBeLessThanOrEqual(40);
+  });
+});
