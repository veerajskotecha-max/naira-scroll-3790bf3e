+++ b/src/components/portal/GardenLayers.test.tsx
@@ -0,0 +1,301 @@
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { MemberProvider, type GardenOverrides, type Member } from "./MemberContext";
+import { readNaira } from "@/lib/portal/memberMeta";
+import { istDayKey } from "@/lib/portal/ist";
+import { NIGHT_GROUND, NIGHT_INK } from "@/lib/portal/sky";
+import type { AtelierNote } from "@/lib/portal/notes";
+import type { Dressing } from "@/lib/portal/seasons";
+
+/*
+  The garden's hours, festivals and notes on the garden home (Phase 4):
+  the night's ground at first paint and its layers after it; nothing fetched
+  by day, with no festival row or note; one ambient loop for the sway and
+  every layer; still art under reduced motion.
+*/
+
+vi.mock("@/contexts/WishlistContext", () => ({ useWishlist: () => ({ items: [] }) }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => null }));
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => ({ jewellery: [], isLive: false, isLoading: false }) }));
+
+import GardenHome from "@/pages/members/GardenHome";
+
+const setReducedMotion = (reduce: boolean) => {
+  window.matchMedia = ((query: string) => ({
+    matches: reduce && query.includes("reduce"),
+    media: query,
+    onchange: null,
+    addListener: () => {},
+    removeListener: () => {},
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    dispatchEvent: () => false,
+  })) as typeof window.matchMedia;
+};
+
+/* WAAPI in jsdom: each animation recorded with its element, and whether it is playing. */
+type Fake = { el: Element; keyframes: Keyframe[]; options: KeyframeAnimationOptions; playing: boolean; cancelled: boolean };
+const animations: Fake[] = [];
+const animate = function (this: Element, keyframes: Keyframe[], options: KeyframeAnimationOptions) {
+  const rec: Fake = { el: this, keyframes, options: options ?? {}, playing: true, cancelled: false };
+  animations.push(rec);
+  return {
+    onfinish: null,
+    oncancel: null,
+    currentTime: 0,
+    playState: "running",
+    finished: Promise.resolve(),
+    play: () => {
+      rec.playing = true;
+    },
+    pause: () => {
+      rec.playing = false;
+    },
+    finish: () => {},
+    cancel: () => {
+      rec.cancelled = true;
+      rec.playing = false;
+    },
+  } as unknown as Animation;
+};
+const ambient = () => animations.filter((a) => a.options.iterations === Infinity && !a.cancelled);
+const on = (selector: string) => ambient().filter((a) => a.el.matches(selector));
+
+/* Every IntersectionObserver made, so the screen's loops can be counted. */
+let observers: { cb: (e: { isIntersecting: boolean }[]) => void }[] = [];
+class FakeObserver {
+  constructor(public cb: (e: { isIntersecting: boolean }[]) => void) {
+    observers.push(this);
+  }
+  observe() {}
+  disconnect() {}
+}
+
+const today = istDayKey();
+const row = (dressing: Dressing) => ({ id: `t-${dressing}`, start: today, end: today, dressing });
+const NOTE: AtelierNote = { id: "first", from: "2026-01-01", title: "On pressing flowers", body: ["A line from the atelier."], flower: "jasmine star", accent: "#E8C88A" };
+
+const member = (garden: GardenOverrides | null, over: Partial<Member> = {}): Member => ({
+  user: { id: "u-1", email: "ananya@example.com", created_at: "2026-11-04T05:00:00Z", user_metadata: {} } as unknown as Member["user"],
+  profile: { id: "u-1", full_name: "Ananya", birthday: "1999-07-14", phone: null, city: null },
+  firstName: "Ananya",
+  preview: false,
+  saveBirthday: async () => ({ ok: true }),
+  addToBag: async () => true,
+  buyNow: async () => {},
+  bagBusy: false,
+  doorsPlayed: true,
+  markDoorsPlayed: () => {},
+  drops: [],
+  unlisted: [],
+  pressed: [],
+  press: () => {},
+  naira: readNaira(null),
+  changeMeta: () => ({ ok: true }),
+  metaProblem: null,
+  retryMeta: () => {},
+  since: null,
+  month: 7,
+  firstVisit: false,
+  arrivalProfile: null,
+  arrival: { hasOwnSignup: async () => true, join: async () => ({ ok: true, already: true }), saveConsent: async () => ({ ok: true }) },
+  garden,
+  ...over,
+});
+
+const home = (garden: GardenOverrides | null) =>
+  render(
+    <MemoryRouter>
+      <MemberProvider value={member(garden)}>
+        <GardenHome />
+      </MemberProvider>
+    </MemoryRouter>,
+  );
+
+beforeEach(() => {
+  window.localStorage.clear();
+  animations.length = 0;
+  observers = [];
+  (Element.prototype as unknown as { animate: unknown }).animate = animate;
+  vi.stubGlobal("IntersectionObserver", FakeObserver);
+  setReducedMotion(false);
+});
+afterEach(() => {
+  cleanup();
+  delete (Element.prototype as unknown as { animate?: unknown }).animate;
+  vi.unstubAllGlobals();
+  vi.useRealTimers();
+  setReducedMotion(false);
+});
+
+describe("garden hours on the garden home", () => {
+  /* First in the file: the sky's chunk has not been fetched yet. */
+  it("lays the night's ink and its labels at first paint, and brings the moon and fireflies after it", async () => {
+    const { container } = home({ hour: "night" });
+    const bed = container.querySelector<HTMLElement>(".ig-bed")!;
+    expect(bed.dataset.sky).toBe("night");
+    expect(bed.style.background).toMatch(/rgb\(26, 22, 20\)|#1A1614/i);
+    const label = container.querySelector<HTMLElement>(".ig-bed-label--naira")!;
+    expect(label.style.color).toBe("rgb(251, 243, 236)");
+    expect(label.querySelector("span")!.style.color).toBe("rgb(201, 154, 76)");
+    expect(NIGHT_GROUND).toBe("#1A1614");
+    expect(NIGHT_INK.text).toBe("#FBF3EC");
+    // Not in the first paint: the sky is a chunk of its own, fetched after it.
+    expect(container.querySelector(".ig-sky")).toBeNull();
+    await waitFor(() => expect(container.querySelectorAll("[data-firefly]")).toHaveLength(12));
+    expect(container.querySelector('.ig-sky[data-part="back"] circle')).not.toBeNull();
+    // Said in words too.
+    expect(screen.getByText("The night garden")).toBeInTheDocument();
+  });
+
+  it("draws and fetches nothing over the ivory day, with no festival row and no note", async () => {
+    const { container } = home({ hour: "day" });
+    await new Promise((r) => setTimeout(r, 80));
+    const bed = container.querySelector<HTMLElement>(".ig-bed")!;
+    expect(bed.dataset.sky).toBe("day");
+    expect(bed.style.background).toBe("");
+    expect(container.querySelector(".ig-sky, .ig-festival")).toBeNull();
+    expect(screen.queryByRole("heading", { name: "From the atelier" })).toBeNull();
+  });
+
+  it("keeps the dawn and the golden hour's washes high above the labels", async () => {
+    for (const hour of ["dawn", "golden"] as const) {
+      const { container, unmount } = home({ hour });
+      await waitFor(() => expect(container.querySelector(`.ig-sky[data-hour="${hour}"]`)).not.toBeNull());
+      const wash = container.querySelector<SVGRectElement>('.ig-sky[data-part="back"] rect')!;
+      expect(Number(wash.getAttribute("height"))).toBeLessThanOrEqual(400);
+      expect(container.querySelector<HTMLElement>(".ig-bed")!.style.background).toBe("");
+      unmount();
+    }
+  });
+
+  it("runs the fireflies, the rain and the flames on the bed's one loop, resting with the sway", async () => {
+    const { container } = home({ hour: "night", seasons: [row("monsoon")] });
+    await waitFor(() => expect(container.querySelectorAll("[data-firefly]")).toHaveLength(12));
+    await waitFor(() => expect(container.querySelectorAll("[data-rain]").length).toBeGreaterThan(0));
+    // One observer on the screen: the bed's. The layers watch nothing of their own.
+    expect(observers).toHaveLength(1);
+    const flies = on("[data-firefly]");
+    const rain = on("[data-rain]");
+    const sway = on(".ig-sway");
+    expect(flies).toHaveLength(12);
+    expect(rain.length).toBeGreaterThan(0);
+    expect(sway.length).toBeGreaterThan(0);
+    const all = [...flies, ...rain, ...sway];
+    // Off screen until the bed is seen: all of them rest.
+    expect(all.every((a) => !a.playing)).toBe(true);
+    act(() => observers[0].cb([{ isIntersecting: true }]));
+    expect(all.every((a) => a.playing)).toBe(true);
+    act(() => observers[0].cb([{ isIntersecting: false }]));
+    expect(all.every((a) => !a.playing)).toBe(true);
+  });
+
+  it("lets the whole garden rest after 20 s untouched, and wakes it on a touch", async () => {
+    // The chunks are in by now: the layers render with the garden.
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    const { container } = home({ hour: "night", seasons: [row("diwali")] });
+    expect(container.querySelectorAll("[data-firefly]")).toHaveLength(12);
+    expect(container.querySelectorAll("[data-flame]").length).toBeGreaterThan(0);
+    act(() => observers[0].cb([{ isIntersecting: true }]));
+    const loop = [...on("[data-firefly]"), ...on("[data-flame]"), ...on(".ig-sway")];
+    expect(loop.every((a) => a.playing)).toBe(true);
+    act(() => {
+      vi.advanceTimersByTime(20_000);
+    });
+    expect(loop.every((a) => !a.playing)).toBe(true);
+    act(() => {
+      window.dispatchEvent(new Event("pointerdown"));
+    });
+    expect(loop.every((a) => a.playing)).toBe(true);
+  });
+
+  it("is still art under reduced motion: fireflies glowing where they are, rain where it falls, flames lit, the garland hung", async () => {
+    setReducedMotion(true);
+    for (const dressing of ["diwali", "monsoon", "holi"] as const) {
+      animations.length = 0;
+      const { container, unmount } = home({ hour: "night", seasons: [row(dressing)] });
+      await waitFor(() => expect(container.querySelector(".ig-festival")).not.toBeNull());
+      expect(container.querySelectorAll("[data-firefly]")).toHaveLength(12);
+      for (const fly of container.querySelectorAll<HTMLElement>("[data-firefly]")) expect(Number(fly.style.opacity)).toBeGreaterThan(0.5);
+      if (dressing === "diwali") {
+        expect(container.querySelectorAll("[data-marigold]").length).toBeGreaterThan(10);
+        expect(container.querySelectorAll("[data-flame]").length).toBeGreaterThan(0);
+      }
+      if (dressing === "monsoon") for (const drop of container.querySelectorAll<HTMLElement>("[data-rain]")) expect(Number(drop.style.opacity)).toBeGreaterThan(0);
+      if (dressing === "holi") {
+        fireEvent.pointerDown(container.querySelector(".ig-bed")!, { clientX: 100, clientY: 200 });
+        expect(container.querySelectorAll(".ig-festival > span").length).toBe(5);
+      }
+      // Nothing moves at all.
+      expect(animations).toHaveLength(0);
+      unmount();
+    }
+  });
+});
+
+describe("festival dressings", () => {
+  it("wears none without a row for today", async () => {
+    const yesterday = istDayKey(new Date(Date.now() - 2 * 86_400_000));
+    const { container } = home({ hour: "day", seasons: [{ id: "past", start: yesterday, end: yesterday, dressing: "diwali" }] });
+    await new Promise((r) => setTimeout(r, 80));
+    expect(container.querySelector(".ig-festival")).toBeNull();
+  });
+
+  it("hangs Diwali's garland and draws its thread, and lights diyas clear of her two plants", async () => {
+    const { container } = home({ hour: "golden", seasons: [row("diwali")] });
+    await waitFor(() => expect(container.querySelector('.ig-festival[data-dressing="diwali"]')).not.toBeNull());
+    const thread = animations.find((a) => a.el.matches("[data-thread]"));
+    expect(thread?.keyframes).toEqual([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }]);
+    expect(container.querySelectorAll("[data-flame]").length).toBeGreaterThanOrEqual(3);
+    expect(screen.getByText("Diyas and a marigold garland")).toBeInTheDocument();
+    // Only transform, opacity and stroke-dashoffset move.
+    for (const a of animations) for (const k of a.keyframes) for (const prop of Object.keys(k)) expect(["transform", "opacity", "strokeDashoffset", "offset", "easing"]).toContain(prop);
+  });
+
+  it("puffs colour where she taps for Holi, never more than 24 at once", async () => {
+    const { container } = home({ hour: "day", seasons: [row("holi")] });
+    await waitFor(() => expect(container.querySelector('.ig-festival[data-dressing="holi"]')).not.toBeNull());
+    const bed = container.querySelector(".ig-bed")!;
+    const patches = container.querySelectorAll(".ig-festival > span").length;
+    fireEvent.pointerDown(bed, { clientX: 120, clientY: 300 });
+    expect(container.querySelectorAll(".ig-festival > span").length - patches).toBe(6);
+    for (let i = 0; i < 10; i++) fireEvent.pointerDown(bed, { clientX: 100 + i, clientY: 300 });
+    expect(container.querySelectorAll(".ig-festival > span").length - patches).toBeLessThanOrEqual(24);
+  });
+});
+
+describe("notes from the atelier", () => {
+  it("shows a pressed flower for each note, and unfolds it on a tap", async () => {
+    home({ hour: "day", notes: [NOTE] });
+    const button = await screen.findByRole("button", { name: /On pressing flowers/ });
+    expect(screen.getByRole("heading", { name: "From the atelier" })).toBeInTheDocument();
+    expect(button).toHaveAttribute("aria-expanded", "false");
+    expect(screen.queryByText("A line from the atelier.")).toBeNull();
+    fireEvent.click(button);
+    expect(button).toHaveAttribute("aria-expanded", "true");
+    expect(screen.getByText("A line from the atelier.")).toBeInTheDocument();
+    fireEvent.click(button);
+    expect(screen.queryByText("A line from the atelier.")).toBeNull();
+  });
+});
+
+/* No layer starts a loop, an observer or a timer of its own: they join the bed's. */
+describe("one ambient loop per screen", () => {
+  it("leaves every timer, frame callback and observer to the bed", () => {
+    const src = resolve(__dirname);
+    for (const file of ["SkyLayer.tsx", "FestivalDressing.tsx"]) {
+      const text = readFileSync(resolve(src, file), "utf8");
+      expect(text, file).not.toMatch(/useAmbient\(|requestAnimationFrame|IntersectionObserver\(|setInterval|setTimeout|addEventListener\("visibilitychange"/);
+      expect(text, file).toMatch(/useAmbientLoop\(\)/);
+      expect(text, file).toMatch(/loop\.join\(/);
+    }
+    const bed = readFileSync(resolve(src, "GardenBed.tsx"), "utf8");
+    expect(bed.match(/useAmbient\(/g)).toHaveLength(1);
+    expect(bed).toMatch(/const loop = useLoop\(active\);/);
+    expect(bed).toMatch(/<AmbientLoopContext\.Provider value=\{loop\}>/);
+  });
+});
