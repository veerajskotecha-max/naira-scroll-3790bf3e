+import { Suspense, useRef } from "react";
+import { useLocation } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import GateIronwork from "@/components/portal/GateIronwork";
+import GardenBed from "@/components/portal/GardenBed";
+import FlowerDraw from "@/components/portal/FlowerDraw";
+import { useTapBloom } from "@/components/portal/useTapBloom";
+import { eyebrow } from "@/components/portal/styles";
+import { DROPS } from "@/lib/portal/drops";
+import { lazyRoom } from "@/lib/portal/lazyRoom";
+
+/*
+  The gate, for anyone not signed in, and (closed, with no sign-in prompt)
+  while sign-in is still being read, so a member never sees the signed-out
+  page flash before her garden. Plain promises only, and only for rooms that
+  are built: nothing about prices, codes or perks the shop has not made.
+
+  The closed gate (the garden behind its ironwork, the name) is drawn here,
+  in the route's own chunk: every visit opens on it. What only a visitor who
+  is not signed in reads (the way in, the promises, the list's form and
+  WhatsApp) is GateWelcome.tsx, a chunk of its own; until it is in, the gate
+  keeps saying "Opening the gate…", as it does while sign-in is read.
+*/
+
+/* Each promise is shown once its room is open, never before. The drop rooms
+   were built in Phase 2, but a first look and a pressed flower are promised
+   only once the owner has set a drop (the manifest ships empty). Your fit
+   and the Jewel drawer opened in Phase 3. */
+// eslint-disable-next-line react-refresh/only-export-components -- read by the copy test and the welcome
+export const PROMISES: readonly { text: string; live: boolean }[] = [
+  { text: "A garden of your own, planted the day you join", live: true },
+  { text: "Your birthstone heart in your month's colour, one tap away", live: true },
+  { text: "A first look at each new drop", live: DROPS.length > 0 },
+  { text: "Your ring size and saved pieces, kept on every phone", live: true },
+  { text: "A pressed flower for every drop", live: DROPS.length > 0 },
+];
+
+const GateWelcome = lazyRoom(() => import("./GateWelcome"));
+
+const Gate = ({ loading = false }: { loading?: boolean }) => {
+  const { pathname } = useLocation();
+  const sceneRef = useRef<HTMLDivElement>(null);
+  useTapBloom(sceneRef, !loading);
+  const opening = (
+    <p className="ig-lede" role="status">
+      Opening the gate…
+    </p>
+  );
+
+  return (
+    <PortalShell
+      title="The Inner Garden"
+      description="The Inner Garden: the members' side of Naira Flore's Inner Circle."
+      nav={false}
+    >
+      <section className="ig-gate-page">
+        <div ref={sceneRef} className="ig-gate-scene">
+          <GardenBed seed="naira-flore-gate" stone={null} still className="ig-bed--behind" />
+          <GateIronwork
+            tone="ivory"
+            label="A closed gold garden gate, the Naira flower at its latch"
+            latch={<FlowerDraw height={64} />}
+          />
+        </div>
+        <p className={eyebrow}>Naira Flore members</p>
+        <h1 className="ig-h1">
+          The Inner <em>Garden</em>
+        </h1>
+        {loading ? (
+          opening
+        ) : (
+          <Suspense fallback={opening}>
+            <GateWelcome pathname={pathname} />
+          </Suspense>
+        )}
+      </section>
+    </PortalShell>
+  );
+};
+
+export default Gate;
diff --git a/src/pages/members/GateWelcome.tsx b/src/pages/members/GateWelcome.tsx
new file mode 100644
