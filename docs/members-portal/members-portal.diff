+import { describe, expect, it } from "vitest";
+import { googleBlockedNote, inAppBrowser } from "./inAppBrowser";
+
+/* Google refuses sign-in inside embedded browsers (disallowed_useragent), and
+   about half the shop's visits arrive in Instagram's. There, /auth shows a
+   note instead of a Google button that can only fail. */
+const UA = {
+  instagramAndroid:
+    "Mozilla/5.0 (Linux; Android 13; SM-A536E Build/TP1A.220624.014; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/119.0.6045.163 Mobile Safari/537.36 Instagram 309.0.0.40.113 Android (33/13; 450dpi; 1080x2177; samsung; SM-A536E; a53x; s5e8825; en_IN; 541635863)",
+  instagramIos:
+    "Mozilla/5.0 (iPhone; CPU iPhone OS 17_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Instagram 307.0.0.17.111 (iPhone14,5; iOS 17_1; en_IN; en-IN; scale=3.00; 1170x2532; 532277014)",
+  facebookIos:
+    "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 [FBAN/FBIOS;FBAV/437.0.0.36.111;FBBV/545519536;FBDV/iPhone14,5;FBMD/iPhone;FBSN/iOS;FBSV/17.0;FBSS/3;FBCR/;FBID/phone;FBLC/en_US;FBOP/80]",
+  facebookAndroid:
+    "Mozilla/5.0 (Linux; Android 12; RMX3363 Build/RKQ1.211119.001; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/118.0.5993.111 Mobile Safari/537.36 [FB_IAB/FB4A;FBAV/438.0.0.33.118;]",
+  chromeAndroid:
+    "Mozilla/5.0 (Linux; Android 10; K) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36",
+  safariIos:
+    "Mozilla/5.0 (iPhone; CPU iPhone OS 17_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.1 Mobile/15E148 Safari/604.1",
+};
+
+describe("inAppBrowser", () => {
+  it("knows Instagram's browser on both phones", () => {
+    expect(inAppBrowser(UA.instagramAndroid)).toBe("Instagram");
+    expect(inAppBrowser(UA.instagramIos)).toBe("Instagram");
+  });
+
+  it("knows Facebook's (FBAN on iOS, FBAV on Android)", () => {
+    expect(inAppBrowser(UA.facebookIos)).toBe("Facebook");
+    expect(inAppBrowser(UA.facebookAndroid)).toBe("Facebook");
+  });
+
+  it("leaves real browsers alone, so Google stays on offer there", () => {
+    expect(inAppBrowser(UA.chromeAndroid)).toBeNull();
+    expect(inAppBrowser(UA.safariIos)).toBeNull();
+    expect(inAppBrowser("")).toBeNull();
+    expect(inAppBrowser(undefined)).toBeNull();
+  });
+
+  it("says what to do instead", () => {
+    expect(googleBlockedNote("Instagram")).toBe(
+      "Google sign-in doesn't open inside Instagram. Use your email, or open this page in your browser.",
+    );
+  });
+});
diff --git a/src/lib/portal/inAppBrowser.ts b/src/lib/portal/inAppBrowser.ts
new file mode 100644
index 0000000..6e89712
--- /dev/null
+++ b/src/lib/portal/inAppBrowser.ts
@@ -0,0 +1,19 @@
+/*
+  Instagram's and Facebook's in-app browsers. About half the shop's visits
+  arrive in Instagram's, and Google refuses its sign-in inside embedded
+  browsers (disallowed_useragent), so there the Google button can only fail.
+  Instagram puts "Instagram" in its user agent; Facebook's apps add FBAN
+  (iOS) or FBAV (Android).
+*/
+
+export type InAppBrowser = "Instagram" | "Facebook" | null;
+
+export const inAppBrowser = (userAgent: string | null | undefined): InAppBrowser => {
+  const ua = userAgent ?? "";
+  if (/\bInstagram\b/i.test(ua)) return "Instagram";
+  if (/\bFB(AN|AV)\b|FB_IAB|\[FB/i.test(ua)) return "Facebook";
+  return null;
+};
+
+export const googleBlockedNote = (app: Exclude<InAppBrowser, null>) =>
+  `Google sign-in doesn't open inside ${app}. Use your email, or open this page in your browser.`;
diff --git a/src/lib/portal/isolation.test.ts b/src/lib/portal/isolation.test.ts
new file mode 100644
index 0000000..85feb9d
--- /dev/null
+++ b/src/lib/portal/isolation.test.ts
@@ -0,0 +1,351 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+
+/*
+  The portal must cost the shop nothing. A portal module imported by the
+  product page, the bag or the header would ride in their download; a shop
+  module imported for the first time by the portal and one other route would
+  be split by Rollup into a new chunk the shop then fetches. So:
+  - only pageCode.ts reaches the portal's route, and only Auth.tsx borrows
+    one portal helper (the in-app browser check);
+  - the product page, bag, checkout and header import nothing of the portal;
+  - portal code imports only what already sits in the main or shared chunks.
+*/
+
+const src = resolve(__dirname, "../..");
+const files = (dir: string): string[] =>
+  readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
+    e.isDirectory() ? files(join(dir, e.name)) : /\.(tsx?|css)$/.test(e.name) ? [join(dir, e.name)] : [],
+  );
+const all = files(src).map((f) => relative(src, f).split("\\").join("/"));
+const isTest = (f: string) => /\.test\.tsx?$/.test(f);
+const isPortal = (f: string) => /^(pages\/members|components\/portal|lib\/portal)\//.test(f);
+
+const IMPORT = /(?:import|export)\s[^'";]*?from\s*["']([^"']+)["']|import\s*\(\s*["']([^"']+)["']\s*\)|import\s+["']([^"']+)["']/g;
+const importsOf = (f: string) =>
+  [...readFileSync(join(src, f), "utf8").matchAll(IMPORT)].map((m) => m[1] ?? m[2] ?? m[3]);
+
+/* Where an import lands, as a path under src (or the bare package name). */
+const target = (from: string, spec: string) => {
+  if (spec.startsWith("@/")) return spec.slice(2);
+  if (spec.startsWith(".")) {
+    const parts = from.split("/").slice(0, -1);
+    for (const seg of spec.split("/")) {
+      if (seg === "..") parts.pop();
+      else if (seg !== ".") parts.push(seg);
+    }
+    return parts.join("/");
+  }
+  return spec;
+};
+
+const reachesPortal = (t: string) => /^(pages\/members|components\/portal|lib\/portal)(\/|$)/.test(t);
+
+describe("the portal's isolation", () => {
+  it("finds the portal and the shop", () => {
+    expect(all.filter(isPortal).length).toBeGreaterThan(20);
+    expect(all).toContain("pages/JewelDetailNext.tsx");
+  });
+
+  it("is reached only from pageCode.ts, plus Auth's in-app browser check", () => {
+    const outside = all
+      .filter((f) => !isPortal(f) && !isTest(f))
+      .flatMap((f) => importsOf(f).map((spec) => [f, target(f, spec)] as const))
+      .filter(([, t]) => reachesPortal(t))
+      .map(([f, t]) => `${f} -> ${t.replace(/\.tsx?$/, "")}`);
+    expect(outside.sort()).toEqual(["pageCode.ts -> pages/members/MembersRoute", "pages/Auth.tsx -> lib/portal/inAppBrowser"]);
+  });
+
+  it("is never imported by the product page, the bag, checkout or the header", () => {
+    const shop = all.filter(
+      (f) =>
+        !isTest(f) &&
+        (/^pages\/(JewelDetailNext|ProductDetail)/.test(f) ||
+          /^components\/(cart|checkout)\//.test(f) ||
+          /^contexts\/CartContext/.test(f) ||
+          /^components\/(Header|Navbar|CartDrawer)/.test(f)),
+    );
+    expect(shop.length).toBeGreaterThan(5);
+    const offenders = shop.flatMap((f) => importsOf(f).filter((s) => reachesPortal(target(f, s))).map((s) => `${f}: ${s}`));
+    expect(offenders).toEqual([]);
+  });
+
+  /* Each of these is already in the main bundle or an existing shared chunk
+     (checked against the build: index, PageSEO, Footer, JoinInnerCircleForm,
+     shopifyImage, background_image_flora, query). Anything new needs the same
+     check, and so does a new name from one of them: a binding of the entry
+     chunk that no lazy chunk imported before becomes a new export of it. The one asset is the gift box's small lid print, which nothing
+     else ships, so it lands in the drop room alone.
+     Phase 3 adds two, both in the entry chunk with the names the portal uses
+     already exported to the product page's chunk: data/ringFit
+     (isAdjustableRing, adjustableSizes) and contexts/WishlistContext
+     (useWishlist). The size chart (data/ringSizing), the pairing rows
+     (lib/pairings) and the lookalikes (data/lookalikes) ride in the product
+     page's own chunk, so the portal keeps copies (lib/portal/sizer, laidOut,
+     lookalikes, family), each checked against its original by test.
+     The arrival repair joins the list through its own quiet copy of the
+     insert (lib/portal/arrival), and names lib/innerCircle's joinInnerCircle
+     only for the owner's switch: already the shared chunk the gate's
+     JoinInnerCircleForm, /innercircle and Auth load, under a name it
+     already exports, and itself unchanged.
+     Phase 4 adds one: lib/nairaFlower/wordmark (the header's NAIRA paths,
+     in the entry chunk), read only by the garden card's renderer
+     (lib/portal/shareCard, inside ShareCard's own chunk) for the still
+     wordmark on the card. The module is unchanged and no other chunk is
+     made; the entry chunk exports its one binding to the renderer. */
+  const ALLOWED = new Set([
+    "@tanstack/react-query",
+    "assets/naira-box-print-sm.webp",
+    "react",
+    "react-router-dom",
+    "@supabase/supabase-js",
+    "contexts/AuthContext",
+    "contexts/CartContext",
+    "hooks/useLiveJewellery",
+    "lib/variants",
+    "data/jewellery",
+    "lib/nairaFlower/outline",
+    "components/PageSEO",
+    "components/Footer",
+    "components/members/JoinInnerCircleForm",
+    "lib/shopifyImage",
+    "integrations/supabase/lazy",
+    "data/ringFit",
+    "contexts/WishlistContext",
+    "lib/innerCircle",
+    "lib/nairaFlower/wordmark",
+  ]);
+
+  /* The originals the portal copies stay out of its code (tests compare against them). */
+  it("copies the product page's size chart and pairing rows rather than importing them", () => {
+    const borrowed = all
+      .filter((f) => isPortal(f) && !isTest(f))
+      .flatMap((f) => importsOf(f).filter((s) => /data\/ringSizing|lib\/pairings|data\/lookalikes/.test(target(f, s))).map((s) => `${f}: ${s}`));
+    expect(borrowed).toEqual([]);
+  });
+
+  it("imports only modules the shop already ships, or its own", () => {
+    const offenders = all
+      .filter((f) => isPortal(f) && !isTest(f))
+      .flatMap((f) => importsOf(f).map((spec) => [f, target(f, spec)] as const))
+      .filter(([, t]) => !reachesPortal(t) && !ALLOWED.has(t))
+      .map(([f, t]) => `${f}: ${t}`);
+    expect(offenders).toEqual([]);
+  });
+
+  /* lucide icons all compile into the "ui" chunk every page downloads, so a
+     new icon here would grow every page; the portal draws its own. */
+  it("brings in no icon library and none of the shop's invented social proof", () => {
+    const bad = all
+      .filter((f) => isPortal(f) && !isTest(f))
+      .flatMap((f) => importsOf(f).filter((s) => /lucide|FomoPopup|JewelTrustStrip|dailySold|framer-motion|lottie|gsap|three/.test(s)).map((s) => `${f}: ${s}`));
+    expect(bad).toEqual([]);
+  });
+
+  /* The development preview member must never reach a production build:
+     only MembersRoute may use it, and every use sits behind
+     import.meta.env.DEV (which the build replaces with false, so Rollup drops
+     the module). The build check also greps dist for "portalPreview". */
+  it("keeps the preview member behind import.meta.env.DEV", () => {
+    const users = all.filter((f) => !isTest(f) && f !== "lib/portal/preview.ts" && importsOf(f).some((s) => /lib\/portal\/preview$|\.\/preview$/.test(target(f, s)) || /portal\/preview$/.test(s)));
+    expect(users).toEqual(["pages/members/MembersRoute.tsx"]);
+    const lines = readFileSync(join(src, users[0]), "utf8").split("\n");
+    const calls = lines.flatMap((line, i) => (/\b(readPreviewMember|logPreviewWrite|previewHost|previewArrivalActions)\(/.test(line) ? [i] : []));
+    expect(calls.length).toBeGreaterThanOrEqual(4);
+    for (const i of calls) {
+      const context = lines.slice(Math.max(0, i - 3), i + 1).join("\n");
+      expect(context, `line ${i + 1}: ${lines[i].trim()}`).toMatch(/import\.meta\.env\.DEV/);
+    }
+  });
+
+  /* The arrival repair's preview stand-ins log instead of writing: only the
+     route picks them, behind the same check as the preview member. */
+  it("keeps the arrival repair's preview stand-ins behind the preview member", () => {
+    const users = all.filter((f) => !isTest(f) && f !== "lib/portal/arrival.ts" && /\bpreviewArrivalActions\b/.test(readFileSync(join(src, f), "utf8")));
+    expect(users).toEqual(["pages/members/MembersRoute.tsx"]);
+  });
+
+  /* Asked once, in one place: the garden home, on her first visit, after the Doors. */
+  it("mounts the arrival repair once, on the garden home, never over the Doors", () => {
+    const users = all.filter((f) => !isTest(f) && importsOf(f).some((s) => /ArrivalRepair$/.test(s)));
+    expect(users).toEqual(["pages/members/GardenHome.tsx"]);
+    const home = readFileSync(join(src, "pages/members/GardenHome.tsx"), "utf8");
+    expect(home.match(/<ArrivalRepair\b/g)).toHaveLength(1);
+    // On her first signed-in visit only (memberMeta firstVisit), and never over the Doors.
+    expect(home).toMatch(/\{firstVisit && !doors && <ArrivalRepair /);
+  });
+
+  /* The preview drops are fixtures for this machine only: reached through
+     preview.ts alone (itself behind import.meta.env.DEV), never by a room. */
+  it("keeps the preview drops behind the preview member", () => {
+    const users = all.filter((f) => !isTest(f) && f !== "lib/portal/previewDrops.ts" && importsOf(f).some((s) => /previewDrops$/.test(target(f, s))));
+    expect(users).toEqual(["lib/portal/preview.ts"]);
+  });
+
+  /* The garden's preview fixtures (hours, festival rows, notes) likewise: through preview.ts alone. */
+  it("keeps the garden's preview fixtures behind the preview member", () => {
+    const users = all.filter((f) => !isTest(f) && f !== "lib/portal/previewGarden.ts" && importsOf(f).some((s) => /previewGarden$/.test(target(f, s))));
+    expect(users).toEqual(["lib/portal/preview.ts"]);
+  });
+
+  /* The garden card's renderer is a chunk of its own inside the card's room: only it reads lib/portal/shareCard (and the wordmark). */
+  it("draws the garden card in a chunk of its own", () => {
+    const readers = all.filter((f) => !isTest(f) && importsOf(f).some((s) => /portal\/shareCard$|\.\/shareCard$/.test(s)));
+    expect(readers).toEqual(["components/portal/ShareCard.tsx"]);
+    const wordmark = all.filter((f) => isPortal(f) && !isTest(f) && importsOf(f).some((s) => /nairaFlower\/wordmark$/.test(target(f, s))));
+    expect(wordmark).toEqual(["lib/portal/shareCard.ts"]);
+    const card = readFileSync(join(src, "pages/members/Card.tsx"), "utf8");
+    expect(card).toMatch(/lazyRoom\(\(\) => import\("@\/components\/portal\/ShareCard"\)\)/);
+    expect(card).not.toMatch(/^import ShareCard/m);
+    // The garden home fetches its layers the same way, never statically.
+    const home = readFileSync(join(src, "pages/members/GardenHome.tsx"), "utf8");
+    for (const layer of ["SkyLayer", "FestivalDressing", "AtelierNote"]) {
+      expect(home).toMatch(new RegExp(`lazyRoom\\(\\(\\) => import\\("@/components/portal/${layer}"\\)\\)`));
+      expect(home).not.toMatch(new RegExp(`^import ${layer}`, "m"));
+    }
+  });
+
+  /* The bag's gift box shares lib/nairaBox/config with the footer's three.js
+     box: importing it would split that module into a new chunk every shop
+     page fetches. The drop room draws its own copy. */
+  it("draws its own gift box rather than borrowing the bag's", () => {
+    const borrowed = all
+      .filter((f) => isPortal(f) && !isTest(f))
+      .flatMap((f) => importsOf(f).filter((s) => /components\/giftbox|lib\/nairaBox/.test(target(f, s))).map((s) => `${f}: ${s}`));
+    expect(borrowed).toEqual([]);
+  });
+
+  /* The drop rooms, Phase 3's rooms and Your stone are lazy sub-routes, each
+     with its own stylesheet, so the garden home never downloads them (her
+     stone is fetched ahead, after the Doors, through lazyRoom); the ring
+     sizer is a further chunk inside Your fit. */
+  it("loads each room on demand, with a stylesheet of its own", () => {
+    const route = readFileSync(join(src, "pages/members/MembersRoute.tsx"), "utf8");
+    for (const room of ["Drops", "DropRoom", "Vault", "Fit", "Drawer", "Herbarium", "Stone", "Gifts", "Orders", "Care", "Card"]) {
+      expect(route).toMatch(new RegExp(`(lazy|lazyRoom)\\(\\(\\) => import\\("\\./${room}"\\)\\)`));
+      expect(route).not.toMatch(new RegExp(`^import ${room} from`, "m"));
+    }
+    const fit = readFileSync(join(src, "pages/members/Fit.tsx"), "utf8");
+    expect(fit).toMatch(/lazy\(\(\) => import\("@\/components\/portal\/RingSizer"\)\)/);
+    expect(fit).not.toMatch(/^import RingSizer/m);
+    expect(all.filter((f) => !isTest(f) && importsOf(f).some((s) => /RingSizer$/.test(s)))).toEqual(["pages/members/Fit.tsx"]);
+    const sheets: Record<string, string> = {
+      "drops.css": "pages/members/Drops.tsx",
+      "droproom.css": "pages/members/DropRoom.tsx",
+      "vault.css": "pages/members/Vault.tsx",
+      "fit.css": "pages/members/Fit.tsx",
+      "drawer.css": "pages/members/Drawer.tsx",
+      "herbarium-room.css": "pages/members/Herbarium.tsx",
+      "stone.css": "pages/members/Stone.tsx",
+      "card.css": "pages/members/Card.tsx",
+      "sizer.css": "components/portal/RingSizer.tsx",
+      "piececard.css": "components/portal/PieceCard.tsx",
+      "gifts.css": "pages/members/Gifts.tsx",
+      "orders.css": "pages/members/Orders.tsx",
+      "care.css": "pages/members/Care.tsx",
+      "ask.css": "components/portal/AskAtelier.tsx",
+    };
+    for (const [sheet, owner] of Object.entries(sheets)) {
+      const importers = all.filter((f) => importsOf(f).some((s) => s.endsWith(`/${sheet}`)));
+      expect(importers).toEqual([owner]);
+    }
+    for (const f of all.filter((f) => /^(pages\/members\/(GardenHome|Gate|MembersRoute)|components\/portal\/(GardenBed|DropBud|BudGlyph|DoorsOpen|GateIronwork|PortalShell|PortalNav))\.tsx$/.test(f))) {
+      expect(importsOf(f).filter((s) => /\.css$/.test(s) && !/members\.css$/.test(s)), f).toEqual([]);
+    }
+  });
+
+  /* The garden home's first paint (the route, the gate, the garden and the
+     Doors) carries only what it draws. Followed through static imports
+     (import() and import type are left out, as the build leaves them out of
+     the route's chunk), it never reaches a room, the arrival repair's card
+     and writes, what a touch on the garden does, the petal burst, the Bloom
+     Clock's countdown, the drop rooms' full flower, the More row's tabs, the
+     changes her other rooms make, the stone's listing or the gate's welcome
+     for a visitor not signed in (with the list's form and the shop's
+     lib/innerCircle, whose email parser alone is some 24 KB gzipped). Each
+     is its own chunk, fetched when it is needed or just ahead of it. */
+  it("keeps what the garden home's first paint never draws out of the route's chunk", () => {
+    const STATIC = /(?:^|\n)\s*(?:import|export)\s+(?!type\b)[^'";]*?from\s*["']([^"']+)["']|(?:^|\n)\s*import\s+["']([^"']+)["']/g;
+    const resolve = (t: string) => [t, `${t}.ts`, `${t}.tsx`, `${t}/index.ts`, `${t}/index.tsx`].find((c) => all.includes(c));
+    const reached = new Set<string>();
+    const shop = new Set<string>();
+    const walk = (f: string) => {
+      if (reached.has(f)) return;
+      reached.add(f);
+      for (const m of readFileSync(join(src, f), "utf8").matchAll(STATIC)) {
+        const to = target(f, m[1] ?? m[2]);
+        const next = resolve(to);
+        if (next && isPortal(next) && /\.tsx?$/.test(next)) walk(next);
+        else shop.add(to);
+      }
+    };
+    walk("pages/members/MembersRoute.tsx");
+    for (const drawn of ["pages/members/GardenHome.tsx", "pages/members/Gate.tsx", "components/portal/GardenBed.tsx", "components/portal/DoorsOpen.tsx", "components/portal/PortalNav.tsx"]) {
+      expect(reached, drawn).toContain(drawn);
+    }
+    const kept = [
+      "pages/members/Stone.tsx",
+      "components/portal/StoneCard.tsx",
+      "components/portal/SeedCeremony.tsx",
+      "components/portal/ArrivalRepair.tsx",
+      "lib/portal/arrival.ts",
+      "components/portal/gardenTouch.ts",
+      "components/portal/PetalBurst.ts",
+      "lib/portal/countdown.ts",
+      "components/portal/FlowerGlyph.tsx",
+      "components/portal/PortalMore.tsx",
+      "lib/portal/roomChanges.ts",
+      "lib/portal/stonePiece.ts",
+      "components/portal/HeartStone.tsx",
+      "pages/members/GateWelcome.tsx",
+      // Phase 4's rooms and what only they draw.
+      "pages/members/Gifts.tsx",
+      "pages/members/Orders.tsx",
+      "pages/members/Care.tsx",
+      "components/portal/GiftRing.tsx",
+      "components/portal/OccasionForm.tsx",
+      "components/portal/BirthFlowers.tsx",
+      "components/portal/CareRitual.tsx",
+      "components/portal/AskAtelier.tsx",
+      "components/portal/useCheckouts.ts",
+      "lib/portal/gifts.ts",
+      "lib/portal/whatsapp.ts",
+      "lib/portal/care.ts",
+      "lib/portal/checkouts.ts",
+      // Phase 4: the sky, a festival's dressing and the atelier's notes, after first paint and only when wanted; the card's room and its renderer.
+      "components/portal/SkyLayer.tsx",
+      "components/portal/FestivalDressing.tsx",
+      "components/portal/AtelierNote.tsx",
+      "pages/members/Card.tsx",
+      "components/portal/ShareCard.tsx",
+      "lib/portal/shareCard.ts",
+    ];
+    expect(kept.filter((f) => reached.has(f))).toEqual([]);
+    expect([...shop].filter((t) => /^(lib\/innerCircle|components\/members\/JoinInnerCircleForm)$/.test(t))).toEqual([]);
+  });
+
+  /* "!name" is Tailwind's important modifier: a variable called after a
+     utility, negated in portal code, puts an !important copy of that utility
+     into the global stylesheet. The names are written backwards here, since
+     Tailwind reads this file too. */
+  it("adds nothing to the global stylesheet through a negated utility name", () => {
+    const names = "neddih kcolb xelf dirg enilni stnetnoc elbat citats dexif etulosba evitaler ykcits elbisiv elbisivni espalloc etacnurt cilati enilrednu esacreppu esacrewol ezilatipac etalosi mrofsnart retlif rulb worg knirhs redrob wodahs gnir eniltuo dednuor reniatnoc noitisnart"
+      .split(" ")
+      .map((w) => [...w].reverse().join(""));
+    const utility = new RegExp(`(^|[^\\w.!])!(${names.join("|")})\\b`);
+    const hits = all.filter((f) => isPortal(f) && utility.test(readFileSync(join(src, f), "utf8")));
+    expect(hits).toEqual([]);
+  });
+
+  /* Tailwind scans every source file, tests included: the bare CSS keyword
+     for an accelerating curve, written as a string anywhere in portal code,
+     adds a utility to the global stylesheet every page downloads. Portal
+     code spells its curves out (EASE_IN in motion.ts). The keyword is built
+     here from parts, so this test does not add it either. */
+  it("adds nothing to the global stylesheet through easing keywords", () => {
+    const keyword = new RegExp(`["'\`]${["ease", "in"].join("-")}["'\`]`);
+    const hits = all.filter((f) => isPortal(f) && keyword.test(readFileSync(join(src, f), "utf8")));
+    expect(hits).toEqual([]);
+  });
+});
