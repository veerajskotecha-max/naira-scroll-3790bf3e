+    expect(refreshProfile).toHaveBeenCalledTimes(1);
+
+    auth.state = { ...auth.state, profile: { id: member.id, full_name: "Priya Kapoor", birthday: "1999-07-14", phone: null, city: null } };
+    await act(async () => answer());
+    // Your stone is a room of its own, fetched while the gate was closed.
+    expect(await screen.findByRole("heading", { level: 1, name: /Your stone/ })).toBeInTheDocument();
+    expect(screen.queryByLabelText("When is your birthday?")).toBeNull();
+    expect(screen.getByRole("button", { name: /^July · Ruby\. Turn the card over/ })).toBeInTheDocument();
+    expect(container.querySelector(".ig-seed")?.hasAttribute("data-bloomed")).toBe(false);
