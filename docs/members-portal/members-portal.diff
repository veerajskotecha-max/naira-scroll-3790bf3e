+import { afterEach, describe, expect, it, vi } from "vitest";
+import { GOOGLE_CALENDAR_URL, WHATSAPP_URL, openOut, quietMetaClicks, saveFile } from "./handOff";
+
+/*
+  The hand-offs: a link names only the bare address, the filled one is
+  opened at the tap with the opener cut, a file made at the tap is saved
+  through a link never on the page, and Meta's automatic click events are
+  off while the portal is open and back on as she leaves.
+*/
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  delete (window as { fbq?: unknown }).fbq;
+});
+
+describe("handing off", () => {
+  it("names only the bare addresses", () => {
+    expect(WHATSAPP_URL).toBe("https://wa.me/919561557935");
+    expect(GOOGLE_CALENDAR_URL).toBe("https://calendar.google.com/calendar/r");
+  });
+
+  it("opens the filled address in a new tab, its opener cut", () => {
+    const tab = { opener: window as unknown };
+    const open = vi.fn(() => tab as Window);
+    window.open = open as typeof window.open;
+    openOut("https://wa.me/919561557935?text=Hello");
+    expect(open).toHaveBeenCalledWith("https://wa.me/919561557935?text=Hello", "_blank");
+    expect(tab.opener).toBeNull();
+  });
+
+  it("saves a file through a link that is never on the page", () => {
+    let made: Blob | null = null;
+    URL.createObjectURL = vi.fn((b: Blob) => {
+      made = b;
+      return "blob:x";
+    }) as typeof URL.createObjectURL;
+    URL.revokeObjectURL = vi.fn();
+    const clicked: HTMLAnchorElement[] = [];
+    vi.spyOn(HTMLAnchorElement.prototype, "click").mockImplementation(function (this: HTMLAnchorElement) {
+      clicked.push(this);
+    });
+    saveFile("BEGIN:VCALENDAR", "a.ics", "text/calendar");
+    expect(clicked).toHaveLength(1);
+    expect(clicked[0].isConnected).toBe(false);
+    expect(clicked[0].download).toBe("a.ics");
+    expect((made as Blob | null)?.type).toBe("text/calendar");
+  });
+
+  it("turns Meta's automatic click events off while the portal is open, and back on after", () => {
+    const fbq = vi.fn();
+    window.fbq = fbq;
+    const leave = quietMetaClicks();
+    expect(fbq).toHaveBeenLastCalledWith("set", "autoConfig", false);
+    leave();
+    expect(fbq).toHaveBeenLastCalledWith("set", "autoConfig", true);
+    // It never sends an event.
+    expect(fbq.mock.calls.every((c) => c[0] === "set")).toBe(true);
+  });
+});
diff --git a/src/lib/portal/handOff.ts b/src/lib/portal/handOff.ts
new file mode 100644
index 0000000..1aa08a1
--- /dev/null
+++ b/src/lib/portal/handOff.ts
@@ -0,0 +1,68 @@
+import type { MouseEvent } from "react";
+import { WHATSAPP_NUMBER } from "@/data/jewellery";
+
+/*
+  Leaving the portal for WhatsApp, Google Calendar or a calendar file,
+  without her words riding on the link.
+
+  The shop's session analytics (Clarity) and Meta's pixel both watch every
+  click on the page and keep the clicked link's full address. A link whose
+  href carries her message (her email, size, metal, stone, saved pieces) or
+  a gift date (its name, day and budget) would hand those words to them at
+  the tap, whatever the page masks. So each such link names only the bare
+  address (https://wa.me/<number>, Google Calendar's own page), and the
+  address with her words in it is built and opened from the tap itself;
+  a calendar file is made from the tap and saved through a link that is
+  never on the page. Long-press "open in new tab" opens the bare address:
+  the accepted cost.
+
+  The shop's own WhatsApp Contact event (PixelEvents, unchanged) still sees
+  a wa.me link and still carries the page's path only.
+
+  This module rides in the portal's own chunk (MembersRoute imports it for
+  quietMetaClicks), so no room fetches a chunk for it.
+*/
+
+export const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}`;
+export const GOOGLE_CALENDAR_URL = "https://calendar.google.com/calendar/r";
+
+/** Opens an address in a new tab, the opener cut; where the phone will not open one, here instead. */
+export const openOut = (url: string): void => {
+  // Not "noopener" as a feature: window.open then returns null, which would also navigate this tab.
+  const w = window.open(url, "_blank");
+  if (w) w.opener = null;
+  else window.location.href = url;
+};
+
+/** A hand-off link's click: the address with her words, built at the tap. */
+export const handOff =
+  (build: () => string) =>
+  (e: MouseEvent<HTMLAnchorElement>): void => {
+    e.preventDefault();
+    openOut(build());
+  };
+
+/** Saves a file made at the tap (a calendar's .ics), through a link that is never on the page. */
+export const saveFile = (text: string, name: string, type: string): void => {
+  const url = URL.createObjectURL(new Blob([text], { type }));
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = name;
+  a.rel = "noopener";
+  a.click();
+  window.setTimeout(() => URL.revokeObjectURL(url), 60_000);
+};
+
+/*
+  Meta's automatic events ("Track events automatically without code", on
+  for the shop's pixel) send a tapped button's words and a tapped link's
+  address. Inside the portal every screen is hers, so while it is open they
+  are switched off (fbq's own 'autoConfig' setting, which sends nothing),
+  and switched back on as she leaves, so the shop is as it was. It adds no
+  event and only ever sends less. FOR THE OWNER: the same switch can be
+  turned off for the whole shop in Events Manager.
+*/
+export const quietMetaClicks = (): (() => void) => {
+  window.fbq?.("set", "autoConfig", false);
+  return () => window.fbq?.("set", "autoConfig", true);
+};
