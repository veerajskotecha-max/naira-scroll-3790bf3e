+import { describe, expect, it } from "vitest";
+import type { JewelPiece } from "@/data/jewellery";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { familyOf as shopFamilyOf } from "@/lib/pairings";
+import { familyOf } from "./family";
+import { fitFor, fitWords, fittedLine, presetFor, ringsFor } from "./fit";
+
+/* Whether a ring fits her, read as its product page sells it; only Shopify's
+   availableForSale, never a count. */
+
+const base = (over: Partial<JewelPiece>): JewelPiece =>
+  ({
+    handle: "test-ring",
+    name: "Test Ring",
+    category: "Rings",
+    sku: "T",
+    number: "1",
+    price: 999,
+    priceLabel: "₹999",
+    variantId: "gid://shopify/ProductVariant/1",
+    availableForSale: true,
+    image: "https://cdn.shopify.com/a.jpg",
+    blurb: "",
+    materials: "PVD 18K gold coated",
+    ...over,
+  }) as JewelPiece;
+
+const sized = base({
+  handle: "linked-trio-ring",
+  name: "Linked Trio Ring",
+  options: [
+    { name: "Metal", values: ["Gold", "Silver"] },
+    { name: "Size", values: ["5", "6", "7", "8"] },
+  ],
+  variants: [
+    ...["5", "6", "7", "8"].map((s) => ({ id: `g${s}`, title: `Gold / ${s}`, availableForSale: s !== "6", price: 1099, options: { Metal: "Gold", Size: s } })),
+    ...["5", "6", "7", "8"].map((s) => ({ id: `s${s}`, title: `Silver / ${s}`, availableForSale: true, price: 1099, options: { Metal: "Silver", Size: s } })),
+  ],
+});
+const adjustable = base({ handle: "cushion-halo-ring", name: "Cushion Halo Ring", materials: "Rhodium coated" });
+const fixed = base({ handle: "chevron-whisper-ring", name: "Chevron Whisper Ring" });
+const soldOutAdjustable = base({ handle: "golden-duet-ring", name: "Golden Duet Ring", availableForSale: false });
+const necklace = base({ handle: "birthstone-heart-necklace", name: "Birthstone Heart Necklace", category: "Necklaces" });
+
+describe("fit", () => {
+  it("a ring sold in sizes fits when her size can be bought in her metal", () => {
+    expect(fitFor(sized, 7, "g")).toMatchObject({ kind: "sized", fits: true, variant: { id: "g7" } });
+    // Gold US 6 is sold out: in gold she is told the sizes left, never shown silver as gold.
+    const gold6 = fitFor(sized, 6, "g");
+    expect(gold6.fits).toBe(false);
+    expect(gold6.sizesLeft).toEqual(["5", "7", "8"]);
+    expect(fitWords(gold6, 6).rest).toBe("Not in US 6 just now. Available in US 5, US 7, US 8");
+    // Either metal: the silver US 6.
+    expect(fitFor(sized, 6, "b")).toMatchObject({ fits: true, variant: { id: "s6" } });
+    expect(fitFor(sized, 9, "b").fits).toBe(false);
+  });
+
+  it("an open-back ring adjusts to US 5 to 9 and carries her size as the bag line's note", () => {
+    const fit = fitFor(adjustable, 8);
+    expect(fit).toMatchObject({ kind: "adjustable", fits: true, sizesLeft: ["5", "6", "7", "8", "9"], note: "US 8" });
+    expect(fittedLine(adjustable, fit)).toMatchObject({ id: "cushion-halo-ring", size: "US 8" });
+    expect(fitWords(fit, 8)).toEqual({ lead: "Adjusts to your size", rest: "US 8" });
+    expect(fitFor(soldOutAdjustable, 6)).toMatchObject({ fits: false, sizesLeft: [] });
+  });
+
+  it("a closed ring sold one way fits a US 6 only, as its page stocks it", () => {
+    expect(fitFor(fixed, 6)).toMatchObject({ kind: "fixed", fits: true, note: "US 6" });
+    expect(fitFor(fixed, 7)).toMatchObject({ fits: false, sizesLeft: ["6"] });
+  });
+
+  it("lists the rings in her size and the open-back ones apart, in her metal", () => {
+    const { sized: inSize, adjustable: adjusts } = ringsFor([sized, adjustable, fixed, soldOutAdjustable, necklace], 7, "b");
+    expect(inSize.map((r) => r.piece.handle)).toEqual(["linked-trio-ring"]);
+    expect(adjusts.map((r) => r.piece.handle)).toEqual(["cushion-halo-ring"]);
+    expect(ringsFor([sized, adjustable], 7, "s").adjustable.map((r) => r.piece.handle)).toEqual(["cushion-halo-ring"]);
+    expect(ringsFor([sized, adjustable], 7, "g").adjustable).toEqual([]);
+  });
+
+  it("never guesses a size or a month: the choice stays hers", () => {
+    expect(presetFor(sized, null, "g")).toMatchObject({ line: null, needs: "size" });
+    expect(presetFor(adjustable, null)).toMatchObject({ line: null, needs: "size" });
+    expect(presetFor(adjustable, 6).line).toMatchObject({ size: "US 6" });
+    expect(presetFor(necklace, 6).line).toMatchObject({ id: "birthstone-heart-necklace" });
+    expect(presetFor(necklace, 6).line).not.toHaveProperty("size");
+  });
+
+  it("chooses her month on a piece sold in months, and waits for her birthday otherwise", () => {
+    const hearts = jewellerySnapshot.find((p) => p.handle === "birthstone-heart-necklace") as JewelPiece;
+    expect(hearts).toBeTruthy();
+    expect(presetFor(hearts, null, undefined, null)).toMatchObject({ line: null, needs: "month" });
+    const july = presetFor(hearts, null, undefined, 7);
+    expect(july.line?.selectedOptions?.find((o) => o.name === "Month")?.value).toMatch(/^July/);
+  });
+
+  it("reads gold or silver exactly as the shop's own familyOf does", () => {
+    for (const piece of jewellerySnapshot) expect(familyOf(piece), piece.handle).toBe(shopFamilyOf(piece));
+  });
+});
