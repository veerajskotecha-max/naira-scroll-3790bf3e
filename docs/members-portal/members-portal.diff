+import { cleanup, render, screen, waitFor, within } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { MemberProvider, type Member } from "./MemberContext";
+import { readNaira } from "@/lib/portal/memberMeta";
+import { layoutGarden } from "@/lib/portal/gardenLayout";
+import { checkoutOf, confirmedOf, ROSES_SHOWN, type Checkout } from "@/lib/portal/checkouts";
+import { NAIRA_CLEAR, NAIRA_LEAVES, ROSE_GAP, ROSE_ROW, STONE_CLEAR, rosesInFront } from "@/lib/portal/goldRoses";
+import { hasDropFlag, writePortal } from "@/lib/portal/safeStorage";
+import { stoneForMonth } from "@/lib/portal/stones";
+
+/*
+  Phase 5's gold-leaf roses: one in her garden's front row for each order
+  the shop's webhook confirmed (never a checkout she only started), dated
+  with that order's own day in "What's growing", never counted; a chunk of
+  its own fetched after the Doors; it grows once (a one-shot on the bed's
+  loop), then stands; still art under reduced motion. Supabase is a
+  stand-in here: nothing leaves the test.
+*/
+
+vi.mock("@/contexts/WishlistContext", () => ({ useWishlist: () => ({ items: [] }) }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => null }));
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => ({ jewellery: [], isLive: false, isLoading: false }) }));
+
+const sb = vi.hoisted(() => ({
+  rows: [] as Record<string, unknown>[],
+  reads: [] as { table: string; columns: string; eq: [string, unknown][] }[],
+  writes: [] as string[],
+}));
+vi.mock("@/integrations/supabase/lazy", () => ({
+  getSupabase: vi.fn(async () => ({
+    from: (table: string) => {
+      const read = { table, columns: "", eq: [] as [string, unknown][] };
+      const q = {
+        select: (columns: string) => {
+          read.columns = columns;
+          sb.reads.push(read);
+          return q;
+        },
+        eq: (col: string, value: unknown) => {
+          read.eq.push([col, value]);
+          return q;
+        },
+        order: () => q,
+        limit: () => Promise.resolve({ data: sb.rows, error: null }),
+        insert: () => (sb.writes.push("insert"), Promise.resolve({ error: null })),
+        update: () => (sb.writes.push("update"), q),
+        upsert: () => (sb.writes.push("upsert"), Promise.resolve({ error: null })),
+        delete: () => (sb.writes.push("delete"), q),
+      };
+      return q;
+    },
+  })),
+}));
+
+import GardenHome from "@/pages/members/GardenHome";
+import GardenBed from "./GardenBed";
+
+const USER = "4c1f0a52-7e7e-4c55-9a51-000000000001";
+
+const setReducedMotion = (reduce: boolean) => {
+  window.matchMedia = ((query: string) => ({
+    matches: reduce && query.includes("reduce"),
+    media: query,
+    onchange: null,
+    addListener: () => {},
+    removeListener: () => {},
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    dispatchEvent: () => false,
+  })) as typeof window.matchMedia;
+};
+
+/* WAAPI in jsdom: each animation recorded with its element; `finished` settles when the test says so. */
+type Fake = { el: Element; keyframes: Keyframe[]; options: KeyframeAnimationOptions; playing: boolean; cancelled: boolean; done: () => void };
+const animations: Fake[] = [];
+const animate = function (this: Element, keyframes: Keyframe[], options: KeyframeAnimationOptions) {
+  let done = () => {};
+  const finished = new Promise<void>((r) => (done = r));
+  const rec: Fake = { el: this, keyframes, options: options ?? {}, playing: true, cancelled: false, done: () => done() };
+  animations.push(rec);
+  return {
+    currentTime: 0,
+    finished,
+    play: () => void (rec.playing = true),
+    pause: () => void (rec.playing = false),
+    finish: () => done(),
+    cancel: () => {
+      rec.cancelled = true;
+      rec.playing = false;
+    },
+  } as unknown as Animation;
+};
+const roseAnimations = () => animations.filter((a) => a.el.closest(".ig-bed-roses"));
+
+const confirmed = (id: string, at: string, items: Checkout["items"] = []): Checkout => ({ id, createdAt: at, confirmedAt: at, items });
+const started = (id: string, at: string): Checkout => ({ id, createdAt: at, items: [{ name: "Toggle Link Chain", quantity: 1, size: null }] });
+
+const member = (over: Partial<Member> = {}): Member => ({
+  user: { id: USER, email: "ananya@example.com", created_at: "2026-11-01T05:00:00Z", user_metadata: {} } as unknown as Member["user"],
+  profile: { id: USER, full_name: "Ananya", birthday: "1999-07-14", phone: null, city: null },
+  firstName: "Ananya",
+  preview: false,
+  saveBirthday: async () => ({ ok: true }),
+  addToBag: async () => true,
+  buyNow: async () => {},
+  bagBusy: false,
+  doorsPlayed: true,
+  markDoorsPlayed: () => {},
+  drops: [],
+  unlisted: [],
+  pressed: [],
+  press: () => {},
+  naira: readNaira(null),
+  changeMeta: () => ({ ok: true }),
+  savedSync: { h: [], x: [] },
+  keepSavedSync: () => {},
+  metaProblem: null,
+  retryMeta: () => {},
+  since: null,
+  month: 7,
+  firstVisit: false,
+  arrivalProfile: null,
+  arrival: { hasOwnSignup: async () => true, join: async () => ({ ok: true, already: true }), saveConsent: async () => ({ ok: true }) },
+  garden: null,
+  ...over,
+});
+
+const home = (over: Partial<Member> = {}) =>
+  render(
+    <MemoryRouter>
+      <MemberProvider value={member(over)}>
+        <GardenHome />
+      </MemberProvider>
+    </MemoryRouter>,
+  );
+
+const PREVIEW_ROWS = [
+  confirmed("order-b", "2026-11-04T12:26:00Z", [{ name: "Woven Gold Hoops", quantity: 1, size: null }]),
+  started("checkout-c", "2026-11-03T14:10:00Z"),
+  confirmed("order-a", "2026-10-12T15:09:00Z"),
+];
+
+const growing = (container: HTMLElement) => {
+  const heading = screen.getByRole("heading", { name: "What's growing" });
+  return within(heading.closest("section") as HTMLElement);
+};
+
+beforeEach(() => {
+  window.localStorage.clear();
+  animations.length = 0;
+  sb.rows = [];
+  sb.reads = [];
+  sb.writes = [];
+  (Element.prototype as unknown as { animate: unknown }).animate = animate;
+  setReducedMotion(false);
+});
+afterEach(() => {
+  cleanup();
+  delete (Element.prototype as unknown as { animate?: unknown }).animate;
+  setReducedMotion(false);
