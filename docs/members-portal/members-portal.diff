@@ -0,0 +1,28 @@
+import { useEffect, useState } from "react";
+import { readCheckouts, type Checkout } from "@/lib/portal/checkouts";
+import { useMember } from "./MemberContext";
+
+/*
+  Her checkouts as the Order Desk and Care read them: her own rows, once a
+  visit to the room. The development preview member's stand-in rows (null
+  in production) are shown instead, and Supabase is never asked.
+*/
+
+export type CheckoutsState = { rows: Checkout[] | null; failed: boolean };
+
+export const useCheckouts = (): CheckoutsState => {
+  const { user, checkoutsPreview } = useMember();
+  const [state, setState] = useState<CheckoutsState>(() => ({ rows: checkoutsPreview ? [...checkoutsPreview] : null, failed: false }));
+  useEffect(() => {
+    if (checkoutsPreview) return;
+    let live = true;
+    readCheckouts(user.id).then(
+      (rows) => live && setState({ rows, failed: false }),
+      () => live && setState({ rows: [], failed: true }),
+    );
+    return () => {
+      live = false;
+    };
+  }, [user.id, checkoutsPreview]);
+  return state;
+};
