+++ b/src/components/portal/MemberContext.tsx
@@ -0,0 +1,102 @@
+import { createContext, useContext, type ReactNode } from "react";
+import type { User } from "@supabase/supabase-js";
+import type { MemberProfile } from "@/contexts/AuthContext";
+import type { CartItem } from "@/contexts/CartContext";
+import type { Drop } from "@/lib/portal/drops";
+import type { Pressed } from "@/lib/portal/pressed";
+import type { MetaResult, Naira, Updater } from "@/lib/portal/memberMeta";
+import type { ArrivalActions } from "@/lib/portal/arrival";
+import type { Checkout } from "@/lib/portal/checkouts";
+import type { SkyHour } from "@/lib/portal/sky";
+import type { SeasonRow } from "@/lib/portal/seasons";
+import type { AtelierNote } from "@/lib/portal/notes";
+
+/*
+  The signed-in member as the portal's screens see her, with the only writes
+  the portal makes: her birthday (profiles.birthday, her own row, under the
+  existing row security), a bag line or a Buy now (the shared CartContext, so
+  the bag itself is untouched), her account's memory (user_metadata.naira:
+  her ring size and metal, saved pieces, pressed flowers, her month, the day
+  she was last here; see lib/portal/memberMeta), and the arrival repair's two
+  (the Inner Circle list, her ad-matching answer; see lib/portal/arrival),
+  each only on her own tap. MembersRoute supplies the real ones, or the development
+  preview's console-only stand-ins.
+*/
+
+export type SaveResult = { ok: true } | { ok: false; message: string };
+export type BagLine = Omit<CartItem, "quantity" | "lineId">;
+
+/** Development preview only (lib/portal/previewGarden): the sky's hour, festival rows and notes in place of the clock's and the owner's. */
+export type GardenOverrides = {
+  hour?: SkyHour;
+  seasons?: readonly SeasonRow[];
+  notes?: readonly AtelierNote[];
+};
+
+export type Member = {
+  user: User;
+  profile: MemberProfile | null;
+  firstName: string;
+  preview: boolean;
+  saveBirthday: (birthday: string) => Promise<SaveResult>;
+  /** True only when the shop really took the piece (the bag says why when it did not). */
+  addToBag: (line: BagLine) => Promise<boolean>;
+  /** Straight to checkout with this one piece, as the product page's Buy now. */
+  buyNow: (line: BagLine) => Promise<void>;
+  /** The bag is talking to Shopify: Buy now waits, so one tap never pays for two. */
+  bagBusy: boolean;
+  /** The Doors play once per portal visit, however often she returns to the garden. */
+  doorsPlayed: boolean;
+  markDoorsPlayed: () => void;
+  /** The drop manifest (empty until the owner sets a drop; the preview's fixtures in development). */
+  drops: readonly Drop[];
+  /** Development preview only: handles treated as not yet on the shop. Always empty in production. */
+  unlisted: readonly string[];
+  /** Development preview only: stand-in checkout rows, so the Order Desk and Care never ask Supabase for the preview member. Always null in production. */
+  checkoutsPreview?: readonly Checkout[] | null;
+  /** Her pressed flowers, oldest first. */
+  pressed: readonly Pressed[];
+  press: (dropId: string) => void;
+  /** Her account's memory, as it stands on screen (written to her account soon after each change). */
+  naira: Naira;
+  changeMeta: (update: Updater) => MetaResult;
+  /** The last write did not reach her account; `retryMeta` tries again. */
+  metaProblem: string | null;
+  retryMeta: () => void;
+  /** The IST day she was last here before today ("2026-11-02"); null on her first visit, and on a second phone the day her account already says today. */
+  since: string | null;
+  /** Her birth month, 1 to 12: her profile's birthday first, else the month alone she kept (naira.month); null when neither. */
+  month: number | null;
+  /** Her first signed-in visit (her account had no visit day as she arrived): the arrival repair's one day. */
+  firstVisit: boolean;
+  /** Her profile as it was read when her rooms opened, so a change she makes this visit never changes what the arrival repair asks. */
+  arrivalProfile: MemberProfile | null;
+  /** The arrival repair's reads and writes (her list row, her ad-matching answer); console-only in the preview. */
+  arrival: ArrivalActions;
+  /** Development preview only: the garden's hour, dressings and notes to see each one. Always null in production. */
+  garden?: GardenOverrides | null;
+};
+
+const MemberContext = createContext<Member | null>(null);
+
+export const MemberProvider = ({ value, children }: { value: Member; children: ReactNode }) => (
+  <MemberContext.Provider value={value}>{children}</MemberContext.Provider>
+);
+
+// eslint-disable-next-line react-refresh/only-export-components -- the hook lives beside its provider
+export const useMember = (): Member => {
+  const member = useContext(MemberContext);
+  if (!member) throw new Error("useMember must be used inside the members portal");
+  return member;
+};
+
+const capitalise = (word: string) => (word ? word[0].toUpperCase() + word.slice(1) : word);
+
+/** Her first name: the profile's, then the sign-in's, then her email's (ananya.r@… → Ananya). */
+// eslint-disable-next-line react-refresh/only-export-components -- shared by the route and its tests
+export const firstNameOf = (profile: MemberProfile | null, user: User | null): string => {
+  const named = profile?.full_name || (user?.user_metadata?.full_name as string | undefined) || "";
+  if (named.trim()) return named.trim().split(/\s+/)[0].slice(0, 40);
+  const local = (user?.email ?? "").split("@")[0].split(/[._\d+-]+/).filter(Boolean)[0] ?? "";
+  return capitalise(local.slice(0, 40));
+};
