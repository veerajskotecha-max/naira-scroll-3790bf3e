+import { useLayoutEffect, useMemo, useRef } from "react";
+import { bandLabel, giftDay, whenSaid, yearFraction, MONTHS_SHORT, nextOn, type Gift } from "@/lib/portal/gifts";
+import { istParts } from "@/lib/portal/ist";
+import { stoneForMonth } from "@/lib/portal/stones";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { StoneHead } from "./StoneArt";
+
+/*
+  The gift ledger's twelve-month ring: a gold hairline round the year,
+  January at the top, each of her dates a small stone flower in its month's
+  colour on a short gold stem from its day on the ring, today a blush mark,
+  and the next date to come ringed in gold. Each flower is a 44 px button
+  (the ring scales down to a 320 px phone and its targets do not); dates too
+  close to sit side by side are eased apart round the ring, their stems
+  still at their own days. The list below the ring says
+  the same in words, for a screen reader and for anyone who would rather read it.
+
+  The hairline draws itself in once (stroke-dashoffset) and the gold ring
+  fades up; under reduced motion or Data Saver both are simply there. No
+  loop runs here.
+*/
+
+const C = 180;
+/** The ring's hairline, and the round just inside it where the flowers sit, each on a short stem from its day. */
+export const RING_R = 140;
+export const FLOWER_R = 118;
+/** Centre to centre, in the ring's own units (a 360 px ring is 1:1): enough that on a 320 px phone, where the ring is 288 px, two flowers' 44 px targets still do not overlap. */
+export const RING_GAP = 56;
+/** The narrowest ring drawn (a 320 px phone less its 16 px gutters). */
+export const RING_MIN_PX = 288;
+const LABEL_R = 163;
+/** The least turn between two flowers that keeps them RING_GAP apart. */
+const MIN_TURN = (2 * Math.asin(RING_GAP / 2 / FLOWER_R)) / (2 * Math.PI);
+
+/** A flower's place, and its day's dot on the ring that its stem runs to. */
+export type Place = { x: number; y: number; dot: { x: number; y: number } };
+
+const onRing = (fraction: number, r: number) => {
+  const a = fraction * 2 * Math.PI - Math.PI / 2;
+  return { x: C + r * Math.cos(a), y: C + r * Math.sin(a) };
+};
+
+/**
+ * Where each date's flower sits, in the order of `gifts`: at its day, or,
+ * when dates fall too close to sit side by side, eased apart round the ring
+ * (neighbours pushed apart equally, the order of the year kept) until each
+ * has its 44 px. Eight dates need less than half the round, so they always fit.
+ */
+// eslint-disable-next-line react-refresh/only-export-components -- the ring's geometry, read by its test
+export const ringPlaces = (gifts: readonly Gift[]): Place[] => {
+  const items = gifts.map((g, i) => ({ i, day: yearFraction(g), turn: yearFraction(g) })).sort((a, b) => a.day - b.day || a.i - b.i);
+  for (let pass = 0; pass < 400 && items.length > 1; pass++) {
+    let moved = false;
+    for (let k = 0; k < items.length; k++) {
+      const p = items[k];
+      const q = items[(k + 1) % items.length];
+      const gap = q.turn - p.turn + (k === items.length - 1 ? 1 : 0);
+      if (gap < MIN_TURN - 1e-6) {
+        const push = (MIN_TURN - gap) / 2 + 1e-6;
+        p.turn -= push;
+        q.turn += push;
+        moved = true;
+      }
+    }
+    if (!moved) break;
+  }
+  const out: Place[] = new Array(gifts.length);
+  for (const item of items) out[item.i] = { ...onRing(item.turn, FLOWER_R), dot: onRing(item.day, RING_R) };
+  return out;
+};
+
+type Props = {
+  gifts: readonly Gift[];
+  /** The date to come soonest (-1 with none). */
+  next: number;
+  selected: number;
+  now: number;
+  onSelect: (index: number) => void;
+};
+
+const pct = (n: number) => `${((n / (2 * C)) * 100).toFixed(3)}%`;
+
+const GiftRing = ({ gifts, next, selected, now, onSelect }: Props) => {
+  const places = useMemo(() => ringPlaces(gifts), [gifts]);
+  const ringRef = useRef<SVGCircleElement>(null);
+  const haloRef = useRef<SVGGElement>(null);
+  const today = istParts(new Date(now));
+  const mark = onRing(yearFraction({ m: today.month, d: today.day }), RING_R);
+  const nextGift = gifts[next];
+
+  // The hairline draws itself in, once.
+  useLayoutEffect(() => {
+    if (stillMotion()) return;
+    play(ringRef.current, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 1100, easing: EASE_REVEAL, fill: "backwards" });
+  }, []);
+  // The gold ring round the next date fades up whenever the next date changes.
+  useLayoutEffect(() => {
+    if (stillMotion() || next < 0) return;
+    play(haloRef.current, [{ opacity: 0, transform: "scale(0.6)" }, { opacity: 1, transform: "none" }], { duration: 700, delay: 500, easing: EASE_REVEAL, fill: "backwards" });
+  }, [next, nextGift?.n, nextGift?.m, nextGift?.d]);
+
+  return (
+    <div className="ig-gring">
+      <svg className="ig-gring-art" viewBox={`0 0 ${2 * C} ${2 * C}`} aria-hidden>
+        <circle ref={ringRef} className="ig-gring-line" cx={C} cy={C} r={RING_R} pathLength={1} />
+        <circle className="ig-gring-line ig-gring-line--fine" cx={C} cy={C} r={RING_R + 5} />
+        {MONTHS_SHORT.map((name, i) => {
+          const tick0 = onRing(i / 12, RING_R - 4);
+          const tick1 = onRing(i / 12, RING_R + 9);
+          const label = onRing((i + 0.5) / 12, LABEL_R);
+          return (
+            <g key={name}>
+              <line className="ig-gring-tick" x1={tick0.x} y1={tick0.y} x2={tick1.x} y2={tick1.y} />
+              <text className="ig-gring-month" x={label.x} y={label.y} textAnchor="middle" dominantBaseline="central">
+                {name}
+              </text>
+            </g>
+          );
+        })}
+        {places.map((p, i) => (
+          <g key={i} className={i === next ? "ig-gring-stem is-next" : "ig-gring-stem"}>
+            <line x1={p.dot.x} y1={p.dot.y} x2={p.x} y2={p.y} />
+            <circle cx={p.dot.x} cy={p.dot.y} r="2.2" />
+          </g>
+        ))}
+        <path className="ig-gring-today" d={`M${mark.x} ${mark.y - 5}L${mark.x + 3.4} ${mark.y}L${mark.x} ${mark.y + 5}L${mark.x - 3.4} ${mark.y}Z`} />
+      </svg>
+
+      {nextGift && (
+        <p className="ig-gring-centre" aria-hidden>
+          <span className="ig-gring-next">Next</span>
+          <span className="ig-gring-name">{nextGift.n}</span>
+          <span className="ig-gring-when">
+            {giftDay(nextGift)} · {whenSaid(nextOn(nextGift, now).days)}
+          </span>
+        </p>
+      )}
+
+      <ul className="ig-gring-flowers">
+        {gifts.map((g, i) => {
+          const p = places[i];
+          const isNext = i === next;
+          const stone = stoneForMonth(g.m);
+          const days = nextOn(g, now).days;
+          return (
+            <li key={`${g.n}-${g.m}-${g.d}-${g.b}`} style={{ left: pct(p.x), top: pct(p.y) }}>
+              <button
+                type="button"
+                className={`ig-gring-flower${isNext ? " is-next" : ""}`}
+                aria-pressed={i === selected}
+                aria-label={`${g.n}, ${giftDay(g)}, ${bandLabel(g.b).toLowerCase()}${isNext ? `. The next to come, ${whenSaid(days)}` : ""}`}
+                onClick={() => onSelect(i)}
+              >
+                <svg viewBox="-22 -22 44 44" width="44" height="44" aria-hidden>
+                  {isNext && (
+                    <g ref={haloRef}>
+                      <circle className="ig-gring-halo" r="20" />
+                      <circle className="ig-gring-halo ig-gring-halo--fine" r="16.5" />
+                    </g>
+                  )}
+                  <StoneHead stone={stone} size={isNext ? 30 : 26} x={isNext ? -15 : -13} y={isNext ? -15 : -13} />
+                </svg>
+              </button>
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+};
+
+export default GiftRing;
