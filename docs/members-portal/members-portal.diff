+            <p className="ig-fineprint" role="alert">
+              {metaProblem} It is kept here and will be saved to your account.{" "}
+              <button type="button" className={quietButton} onClick={retryMeta}>
+                Try again
+              </button>
+            </p>
+          )}
+          <p className="ig-fineprint">
+            A guide, not a guarantee: fingers change with the season and the time of day. Between two sizes?{" "}
+            <a className="ig-link" href={betweenSizesWhatsApp()} target="_blank" rel="noopener noreferrer">
+              Ask us before you order
+            </a>
+          </p>
+        </section>
+
+        <section className="ig-section" aria-labelledby="ig-metal">
+          <h2 id="ig-metal" className="ig-h2">
+            Your metal
+          </h2>
+          <div className="ig-ways" role="group" aria-labelledby="ig-metal">
+            {METALS.map((m) => (
+              <button
+                key={m.id}
+                type="button"
+                className="ig-way"
+                aria-pressed={metal === m.id}
+                onClick={() => {
+                  // Her metal again: no preference.
+                  changeMeta(metal === m.id ? forgetMetal : keepMetal(m.id));
+                  setChanged(true);
+                }}
+              >
+                {m.label}
+              </button>
+            ))}
+          </div>
+          <p className="ig-fineprint">
+            Gold and silver as each listing names its finish: PVD 18K gold coated, 18K gold tone plated, or rhodium coated. Tap your metal again for no preference.
+          </p>
+        </section>
+
+        <section className="ig-section" aria-labelledby="ig-rings">
+          <h2 id="ig-rings" className="ig-h2">
+            Rings in your size, in stock now
+          </h2>
+          {ring === undefined ? (
+            <p className="ig-fineprint">Keep your size above, and the rings in your size gather here.</p>
+          ) : !isLive ? (
+            isLoading ? (
+              <p className="ig-fineprint" role="status">
+                Reading the rings from the shop…
+              </p>
+            ) : (
+              <p className="ig-fineprint">
+                We couldn't reach the shop just now.{" "}
+                <Link className="ig-link" to="/jewellery">
+                  See the shop
+                </Link>
+              </p>
+            )
+          ) : (
+            <>
+              {rings && rings.sized.length > 0 ? (
+                <>
+                  <ul className="ig-pcs">
+                    {(allRings ? rings.sized : rings.sized.slice(0, FIRST_RINGS)).map(({ piece, fit }) => (
+                      <li key={piece.handle}>
+                        <PieceCard piece={piece} preset={presetFor(piece, ring.us, metal, month)} note={<FitsYou fit={fit} us={ring.us} />} preview={preview} bagBusy={bagBusy} onAdd={addToBag} />
+                      </li>
+                    ))}
+                  </ul>
+                  {!allRings && rings.sized.length > FIRST_RINGS && (
+                    <button type="button" className={`${quietButton} ig-fit-all`} onClick={() => setAllRings(true)}>
+                      Show every ring in US {ring.us}
+                    </button>
+                  )}
+                </>
+              ) : (
+                <p className="ig-fineprint">
+                  No ring is in US {ring.us}
+                  {metal === "g" ? " in gold" : metal === "s" ? " in silver" : ""} right now.{" "}
+                  <a className="ig-link" href={ringInSizeWhatsApp(ring.us)} target="_blank" rel="noopener noreferrer">
+                    Ask us on WhatsApp
+                  </a>
+                </p>
+              )}
+              {rings && rings.adjustable.length > 0 && (
+                <>
+                  <h3 className="ig-fit-h3">Open-back rings that adjust to your size</h3>
+                  <ul className="ig-pcs">
+                    {rings.adjustable.map(({ piece, fit }) => (
+                      <li key={piece.handle}>
+                        <PieceCard piece={piece} preset={presetFor(piece, ring.us, metal, month)} note={<FitsYou fit={fit} us={ring.us} />} preview={preview} bagBusy={bagBusy} onAdd={addToBag} />
+                      </li>
+                    ))}
+                  </ul>
+                </>
+              )}
+            </>
+          )}
+        </section>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Fit;
