@@ -0,0 +1,68 @@
+import { istParts } from "./ist";
+
+/*
+  Garden hours. The sky over her garden keeps Indian time, as the greeting
+  does: dawn mist from five, the ivory day from half past seven, the golden
+  hour from half past four in the afternoon and the night garden from half
+  past six, on ink, with twelve slow gold fireflies. No owner data and no
+  time-zone tables: IST is UTC + 5:30 all year (ist.ts).
+
+  The sky is only ever weather. It never dims or droops a plant, and it says
+  nothing about when she was last here: an absence costs nothing.
+
+  The night's ground and the label colours are painted by the bed itself at
+  first paint (a style, no chunk), so the garden never opens on ivory and
+  turns dark; the moon, stars and fireflies (SkyLayer.tsx) are a chunk of
+  their own, fetched after first paint, and never fetched by day.
+*/
+
+export type SkyHour = "dawn" | "day" | "golden" | "night";
+
+/** Where each hour starts, in minutes after IST midnight. Night runs on past midnight to dawn. */
+export const SKY_FROM = { dawn: 5 * 60, day: 7 * 60 + 30, golden: 16 * 60 + 30, night: 18 * 60 + 30 } as const;
+
+const ORDER: readonly SkyHour[] = ["dawn", "day", "golden", "night"];
+
+const minuteOfIstDay = (at: Date) => {
+  const { hour, minute } = istParts(at);
+  return hour * 60 + minute;
+};
+
+const asDate = (at: Date | number) => (at instanceof Date ? at : new Date(at));
+
+/** The garden's hour at `at`, in India. */
+export const skyHour = (at: Date | number = Date.now()): SkyHour => {
+  const m = minuteOfIstDay(asDate(at));
+  if (m >= SKY_FROM.night || m < SKY_FROM.dawn) return "night";
+  if (m >= SKY_FROM.golden) return "golden";
+  if (m >= SKY_FROM.day) return "day";
+  return "dawn";
+};
+
+/** The instant (ms) the sky next changes after `at`: the start of the following hour, in IST. */
+export const nextSkyChange = (at: Date | number = Date.now()): number => {
+  const d = asDate(at);
+  const now = d.getTime();
+  const m = minuteOfIstDay(d);
+  const startOfMinute = now - (now % 60_000);
+  const next = ORDER.map((h) => SKY_FROM[h]).find((from) => from > m);
+  const minutesAhead = next === undefined ? 24 * 60 - m + SKY_FROM.dawn : next - m;
+  return startOfMinute + minutesAhead * 60_000;
+};
+
+/** Whether this hour draws anything over the garden (the ivory day draws nothing, and fetches nothing). */
+export const skyDraws = (hour: SkyHour): boolean => hour !== "day";
+
+/* The night garden's ground and the words that stand on it, each held to
+   4.5:1 or more against the ground by sky.test. Flower and firefly colours
+   are art, inside the drawing only. */
+export const NIGHT_GROUND = "#1A1614";
+export const NIGHT_INK = {
+  /** The bed's labels ("Planted" day, her stone's name). */
+  text: "#FBF3EC",
+  /** Their small gold captions over them. */
+  caption: "#C99A4C",
+} as const;
+
+/* The fireflies: twelve, never more, and slow. */
+export const FIREFLIES = 12;
