@@ -0,0 +1,175 @@
+import { WHATSAPP_NUMBER } from "@/data/jewellery";
+import type { UsSize } from "./memberMeta";
+
+/*
+  Your fit: the sums behind the ring sizer, the thread and "I know my size".
+
+  The sizes are the site's own chart (src/data/ringSizing.ts, the one the
+  product page's size guide prints), copied here because that file ships in
+  the product page's chunk and importing it would split it out of there;
+  sizer.test checks the two stay the same. A US size is matched by its inner
+  diameter (the sizer) or its circumference (the thread), to the nearest
+  size; halfway past either end of US 5 to 9 it is outside what the shop
+  sells, and the answer is a conversation on WhatsApp.
+
+  A phone's CSS pixel has no fixed length, so the sizer first measures one:
+  a bank card (ISO/IEC 7810 ID-1, 85.60 x 53.98 mm) held to the screen gives
+  pixels per millimetre, kept on this device for this screen's size and
+  pixel ratio. It is a guide, not a guarantee.
+*/
+
+export const RING_CHART: readonly { us: UsSize; diameterMm: number; circumferenceMm: number }[] = [
+  { us: 5, diameterMm: 15.7, circumferenceMm: 49.3 },
+  { us: 6, diameterMm: 16.5, circumferenceMm: 51.9 },
+  { us: 7, diameterMm: 17.3, circumferenceMm: 54.4 },
+  { us: 8, diameterMm: 18.1, circumferenceMm: 56.9 },
+  { us: 9, diameterMm: 19.0, circumferenceMm: 59.7 },
+];
+
+export const US_SIZES: readonly UsSize[] = RING_CHART.map((r) => r.us);
+
+/** The card's two edges, in millimetres. */
+export const CARD_MM = { long: 85.6, short: 53.98 } as const;
+export type CardEdge = keyof typeof CARD_MM;
+
+/** A phone's CSS pixels per millimetre fall well inside this; a calibration outside it is a slip of the finger. */
+export const PX_PER_MM_RANGE = [3, 9] as const;
+
+/** Pixels per millimetre, from the card edge's length on screen in CSS px; null when it cannot be a real card. */
+export const pxPerMmFrom = (edgePx: number, edge: CardEdge = "long"): number | null => {
+  const ratio = edgePx / CARD_MM[edge];
+  return Number.isFinite(ratio) && ratio >= PX_PER_MM_RANGE[0] && ratio <= PX_PER_MM_RANGE[1] ? ratio : null;
+};
+
+/*
+  Where the card lies on the calibration stage, which runs edge to edge
+  across the screen: its top-left corner 8 px in from the screen's left edge
+  (and, on the short side, 56 px down, leaving a band above the card for the
+  grip and the nudges). The line can travel only as far as the stage, so the
+  stage is also the limit of what can be measured.
+*/
+export const CAL_LEFT = 8;
+export const CAL_TOP = { long: 8, short: 56 } as const;
+
+/** How far the line can travel on a stage this size, in CSS px. */
+export const calRoomMax = (edge: CardEdge, stageW: number, stageH: number): number =>
+  edge === "long" ? stageH - CAL_TOP.long - 2 : stageW - CAL_LEFT - 2;
+
+/**
+ * The line is held at the stage's edge, short of the real card: the card
+ * reaches past this screen. Only the stage's own limit counts (at 9 px per mm
+ * the reading is genuine, just a dense screen).
+ */
+export const atRoomLimit = (edgePx: number, edge: CardEdge, roomMaxPx: number): boolean =>
+  roomMaxPx < PX_PER_MM_RANGE[1] * CARD_MM[edge] && edgePx >= roomMaxPx - 0.5;
+
+/**
+ * Pixels per millimetre from the line, or null when it cannot be trusted: no
+ * real card (outside 3 to 9 px per mm), or the line stopped at the stage's
+ * edge, where a card longer than the screen would read too small and every
+ * circle after it would be drawn too small with it.
+ */
+export const calibrationFrom = (edgePx: number, edge: CardEdge, roomMaxPx: number): number | null =>
+  atRoomLimit(edgePx, edge, roomMaxPx) ? null : pxPerMmFrom(edgePx, edge);
+
+export const pxToMm = (px: number, pxPerMm: number): number => px / pxPerMm;
+export const mmToPx = (mm: number, pxPerMm: number): number => mm * pxPerMm;
+
+/** This screen, as the calibration is kept: "390x844@3". A new phone, or a new screen, measures again. */
+export const screenKey = (w: number, h: number, dpr: number): string => `${Math.round(w)}x${Math.round(h)}@${Math.round(dpr * 100) / 100}`;
+
+export const currentScreenKey = (): string => {
+  try {
+    return screenKey(window.screen.width, window.screen.height, window.devicePixelRatio || 1);
+  } catch {
+    return "unknown";
+  }
+};
+
+export type Calibration = { key: string; pxPerMm: number };
+
+/** The kept calibration, if it was made on this screen. */
+export const calibrationFor = (kept: unknown, key: string): number | null => {
+  if (!kept || typeof kept !== "object") return null;
+  const { key: k, pxPerMm } = kept as Partial<Calibration>;
+  return k === key && typeof pxPerMm === "number" && pxPerMm >= PX_PER_MM_RANGE[0] && pxPerMm <= PX_PER_MM_RANGE[1] ? pxPerMm : null;
+};
+
+export type SizeMatch = { kind: "size"; us: UsSize; index: number } | { kind: "below" } | { kind: "above" };
+
+/* Halfway to the next size past either end is still that end; further is outside the chart. */
+const match = (mm: number, key: "diameterMm" | "circumferenceMm"): SizeMatch => {
+  const values = RING_CHART.map((r) => r[key]);
+  const first = values[0];
+  const last = values[values.length - 1];
+  if (!Number.isFinite(mm)) return { kind: "below" };
+  if (mm < first - (values[1] - first) / 2) return { kind: "below" };
+  if (mm > last + (last - values[values.length - 2]) / 2) return { kind: "above" };
+  let index = 0;
+  values.forEach((v, i) => {
+    if (Math.abs(v - mm) < Math.abs(values[index] - mm)) index = i;
+  });
+  return { kind: "size", us: RING_CHART[index].us, index };
+};
+
+/** The nearest US size to a ring's inner diameter. */
+export const sizeForDiameter = (mm: number): SizeMatch => match(mm, "diameterMm");
+/** The nearest US size to a finger's circumference (the thread). */
+export const sizeForCircumference = (mm: number): SizeMatch => match(mm, "circumferenceMm");
+
+/* ── the on-screen circle ───────────────────────────── */
+
+/**
+ * The circle steps through the chart: one stop smaller than US 5 and one
+ * larger than US 9 stand for "outside the chart". Its stops, in mm.
+ */
+export const CIRCLE_STOPS_MM: readonly number[] = [15.0, ...RING_CHART.map((r) => r.diameterMm), 19.9];
+
+/** The stop for a diameter in mm (0 = smaller than US 5, 6 = larger than US 9). */
+export const stopForDiameter = (mm: number): number => {
+  const m = sizeForDiameter(mm);
+  return m.kind === "below" ? 0 : m.kind === "above" ? CIRCLE_STOPS_MM.length - 1 : m.index + 1;
+};
+
+export const matchForStop = (stop: number): SizeMatch => {
+  if (stop <= 0) return { kind: "below" };
+  if (stop >= CIRCLE_STOPS_MM.length - 1) return { kind: "above" };
+  return { kind: "size", us: RING_CHART[stop - 1].us, index: stop - 1 };
+};
+
+/**
+ * Two fingers on the circle: each PINCH_PX_PER_STOP of spread (or squeeze)
+ * moves it one size, from the size it held when the pinch began. Following
+ * the fingers' ratio instead leapt across the chart (the sizes are about 5%
+ * apart, so a 24% spread went from US 6 past US 9).
+ */
+export const PINCH_PX_PER_STOP = 36;
+export const pinchStop = (fromStop: number, fromDistance: number, distance: number): number => {
+  if (!Number.isFinite(fromDistance) || !Number.isFinite(distance)) return fromStop;
+  const next = fromStop + Math.round((distance - fromDistance) / PINCH_PX_PER_STOP);
+  return Math.max(0, Math.min(CIRCLE_STOPS_MM.length - 1, next));
+};
+
+/** "US 6 · 16.5 mm across", for the slider's spoken value and the label. */
+export const stopWords = (stop: number): string => {
+  const m = matchForStop(stop);
+  if (m.kind === "below") return "Smaller than US 5";
+  if (m.kind === "above") return "Larger than US 9";
+  return `US ${m.us} · ${RING_CHART[m.index].diameterMm.toFixed(1)} mm across`;
+};
+
+/* ── outside the chart ──────────────────────────────── */
+
+/** WhatsApp, for a size the shop does not sell: a person helps, nothing is promised. */
+export const outsideSizeWhatsApp = (detail?: string): string =>
+  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
+    `Hello Naira Flore, my ring size seems to be outside US 5 to 9${detail ? ` (${detail})` : ""}. Could you help me find a ring that fits?`,
+  )}`;
+
+/** WhatsApp, for a ring that sits between two sizes: a person helps her choose. */
+export const betweenSizesWhatsApp = (): string =>
+  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Hello Naira Flore, my ring size seems to be between two sizes. Could you help me choose?")}`;
+
+/** WhatsApp, for a ring in her size that the shop does not show right now. */
+export const ringInSizeWhatsApp = (us: number): string =>
+  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(`Hello Naira Flore, I'm looking for a ring in US ${us}. Could you help me find one?`)}`;
