+import { FLOWER_ASPECT, FLOWER_BASE_X, FLOWER_PETALS, FLOWER_STEM, LEAF_SAGE, PETAL_BLUSH } from "@/lib/portal/brandFlower";
+
+/*
+  Gathered's drawing at the crown of her garden's arbour (Phase 6), shared by
+  the crown's own chunk (PetalCrown) and her garden card (Card), and by
+  nothing in the garden's first paint.
+
+  The Naira flower stands with its stem's foot on the arch's crown
+  (gardenLayout's ARCH, whose top is at 195, 78), 60 units tall, where the
+  small five-petal flower GardenBed's Arbour draws stood until the first
+  piece came home. Each piece she found stands in its own place in that
+  shape.
+*/
+
+export const CROWN_H = 60;
+export const CROWN_W = CROWN_H * FLOWER_ASPECT;
+export const CROWN_AT = { x: 195 - FLOWER_BASE_X * CROWN_W, y: 79 - CROWN_H, h: CROWN_H } as const;
+/** The flower's own 0.6868 x 1 view, placed at the crown in the bed's 390 x 560 view. */
+export const CROWN_PLACE = `translate(${CROWN_AT.x.toFixed(2)} ${CROWN_AT.y.toFixed(2)}) scale(${CROWN_H})`;
+
+/* Art colours, inside the drawing only. A thin gold-leaf edge and a soft glow: at a phone's 38 x 55 px, anything heavier swamps the sage stem. */
+export const GOLD = "#C99A4C";
+export const GOLD_LEAF = "#DDB46A";
+export const HAIR = 0.8 / CROWN_H;
+export const EDGE = 1 / CROWN_H;
+export const GLOW = 2.2 / CROWN_H;
+
+const PARTS = [FLOWER_STEM, ...FLOWER_PETALS];
+
+/** The whole Naira flower at the crown, edged in gold leaf, still: her garden card's, once all five pieces are home. */
+export const CrownStill = () => (
+  <g transform={CROWN_PLACE} className="ig-crown-still">
+    <g fill="none" stroke={GOLD_LEAF} strokeOpacity=".35" strokeWidth={GLOW} strokeLinejoin="round">
+      {PARTS.map((d, i) => (
+        <path key={i} d={d} />
+      ))}
+    </g>
+    {PARTS.map((d, i) => (
+      <path key={i} d={d} fill={i ? PETAL_BLUSH : LEAF_SAGE} stroke="var(--nf-accent-strong)" strokeWidth={HAIR} strokeLinejoin="round" />
+    ))}
+    <g fill="none" stroke={GOLD} strokeWidth={EDGE} strokeLinejoin="round">
+      {PARTS.map((d, i) => (
+        <path key={i} d={d} />
+      ))}
+    </g>
+  </g>
+);
