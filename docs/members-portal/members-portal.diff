+import { describe, expect, it } from "vitest";
+import { confirmRedirect, readAuthLanding, recoveryRedirect } from "./landing";
+
+const ORIGIN = "https://nairaflore.com";
+
+describe("readAuthLanding", () => {
+  it("knows a reset link by our own mark, before Supabase has read it", () => {
+    expect(readAuthLanding(`${ORIGIN}/auth?recovery=1&next=%2Fmembers`)).toEqual({ recovery: true, linkError: null });
+  });
+
+  it("knows a reset link by Supabase's type=recovery too", () => {
+    expect(readAuthLanding(`${ORIGIN}/auth#access_token=x&refresh_token=y&expires_in=3600&token_type=bearer&type=recovery`).recovery).toBe(true);
+  });
+
+  it("reads an ordinary visit as a sign-in", () => {
+    expect(readAuthLanding(`${ORIGIN}/auth?next=%2Fmembers`)).toEqual({ recovery: false, linkError: null });
+    expect(readAuthLanding(`${ORIGIN}/auth#type=signup`)).toEqual({ recovery: false, linkError: null });
+  });
+
+  it("says plainly when a reset link has expired or was used", () => {
+    const landing = readAuthLanding(
+      `${ORIGIN}/auth?recovery=1#error=access_denied&error_code=otp_expired&error_description=Email+link+is+invalid+or+has+expired`,
+    );
+    expect(landing.recovery).toBe(true);
+    expect(landing.linkError).toMatch(/reset link has expired or has already been used/);
+  });
+
+  it("says so for an expired confirmation link, and for the code flow's query errors", () => {
+    expect(readAuthLanding(`${ORIGIN}/auth?next=%2Fmembers#error=access_denied&error_code=otp_expired`).linkError).toMatch(
+      /email link has expired/,
+    );
+    expect(readAuthLanding(`${ORIGIN}/auth?error=server_error&error_description=Something+broke`).linkError).toMatch(/didn't work/);
+  });
+
+  it("survives an address it cannot parse", () => {
+    expect(readAuthLanding("not a url")).toEqual({ recovery: false, linkError: null });
+  });
+});
+
+describe("the email links' return addresses", () => {
+  it("sends a reset link back to /auth, marked, with next kept", () => {
+    expect(recoveryRedirect(ORIGIN, "/members")).toBe(`${ORIGIN}/auth?recovery=1&next=%2Fmembers`);
+    expect(recoveryRedirect(ORIGIN, "/account")).toBe(`${ORIGIN}/auth?recovery=1`);
+  });
+
+  it("sends a confirmation link through /auth on its way to next", () => {
+    expect(confirmRedirect(ORIGIN, "/members/stone")).toBe(`${ORIGIN}/auth?next=%2Fmembers%2Fstone`);
+    expect(confirmRedirect(ORIGIN, "/account")).toBe(`${ORIGIN}/auth`);
+  });
+});
diff --git a/src/lib/auth/landing.ts b/src/lib/auth/landing.ts
new file mode 100644
index 0000000..1d86def
--- /dev/null
+++ b/src/lib/auth/landing.ts
@@ -0,0 +1,63 @@
+import { authPath } from "./next";
+
+/*
+  What an email link brought her to /auth for, read from the address she
+  landed on, at the first render.
+
+  A password-reset link is sent back to /auth?recovery=1, so the page knows
+  at once that it must ask for a new password: the session the link carries
+  arrives through AuthContext like any sign-in, and without that mark the
+  page would hop straight on to ?next=. (Supabase also fires
+  PASSWORD_RECOVERY, which Auth listens for too, but that event can come
+  after the session has already reached the page.) Supabase's own
+  "type=recovery" in the address fragment counts as well, while it is still
+  there.
+
+  The link's tokens are left in the address for supabase-js to read and
+  clear, as on the shop today: moving them out before any analytics script
+  loads would need a script in index.html, the shell of every page, and
+  that is the owner's call, not the Auth chunk's.
+
+  A link that has expired or was already used comes back with error_code /
+  error_description in the fragment (or the query, for the code flow).
+  Supabase leaves those in the address, so they are read here and said
+  plainly instead of a sign-in form that pretends nothing happened.
+*/
+
+export type AuthLanding = { recovery: boolean; linkError: string | null };
+
+const params = (raw: string) => new URLSearchParams(raw.replace(/^[#?]/, ""));
+
+export const linkProblem = (code: string | null, description: string | null, recovery: boolean): string => {
+  const expired = code === "otp_expired" || /expired|invalid/i.test(description ?? "");
+  if (recovery) {
+    return expired
+      ? "This reset link has expired or has already been used. Ask for a new one below."
+      : "This reset link didn't work. Ask for a new one below.";
+  }
+  return expired
+    ? "That email link has expired or has already been used. Sign in below, or ask for a new link."
+    : "That email link didn't work. Please sign in below.";
+};
+
+export const readAuthLanding = (href: string): AuthLanding => {
+  let url: URL;
+  try {
+    url = new URL(href);
+  } catch {
+    return { recovery: false, linkError: null };
+  }
+  const hash = params(url.hash);
+  const query = url.searchParams;
+  const pick = (key: string) => hash.get(key) ?? query.get(key);
+  const recovery = query.get("recovery") === "1" || pick("type") === "recovery";
+  const code = pick("error_code");
+  const failed = Boolean(code || pick("error") || pick("error_description"));
+  return { recovery, linkError: failed ? linkProblem(code, pick("error_description"), recovery) : null };
+};
+
+/** Where a reset email sends her: back to /auth, marked as a recovery, with ?next= kept. */
+export const recoveryRedirect = (origin: string, next: string): string => `${origin}${authPath(next, { recovery: "1" })}`;
+
+/** Where a confirmation email sends her: through /auth, which carries her sign-up choices over, then on to ?next=. */
+export const confirmRedirect = (origin: string, next: string): string => `${origin}${authPath(next)}`;
