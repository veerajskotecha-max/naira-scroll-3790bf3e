+import { cleanup, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { MemberProvider, type Member } from "./MemberContext";
+import { META_CAP_BYTES, bytesOf, readNaira, type Updater } from "@/lib/portal/memberMeta";
+import { STARS } from "@/lib/portal/petals";
+import { SHEET, STAR_FLOWERS } from "@/lib/portal/starFlowers";
+
+/*
+  Written in your sky (Phase 6): after dark, with her month known, a square
+  of night under her garden where she traces her month's flower. Each way
+  completes it on its own (taps, a drag, "Join the next star", "Draw it for
+  me"); only the next star is in the tab order; Escape returns to "Look
+  up"; the flower draws once, at most 12 petals open, and her account
+  keeps one bit. Never fetched by day; nothing loops; under reduced motion
+  nothing animates.
+*/
+
+const fetched = vi.hoisted(() => ({ sheet: 0 }));
+vi.mock("./StarSheet", async (importActual) => {
+  fetched.sheet++;
+  return importActual();
+});
+vi.mock("@/contexts/WishlistContext", () => ({ useWishlist: () => ({ items: [] }) }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => null }));
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => ({ jewellery: [], isLive: false, isLoading: false }) }));
+vi.mock("@/integrations/supabase/lazy", () => ({
+  getSupabase: vi.fn(async () => {
+    const q = { select: () => q, eq: () => q, order: () => q, limit: () => Promise.resolve({ data: [], error: null }) };
+    return { from: () => q };
+  }),
+}));
+
+import SkyLayer from "./SkyLayer";
+import GardenHome from "@/pages/members/GardenHome";
+
+const USER = "4c1f0a52-7e7e-4c55-9a51-000000000001";
+const src = resolve(__dirname, "../..");
+const JULY = STAR_FLOWERS[6];
+
+const setReducedMotion = (reduce: boolean) => {
+  window.matchMedia = ((query: string) => ({
+    matches: reduce && query.includes("reduce"),
+    media: query,
+    onchange: null,
+    addListener: () => {},
+    removeListener: () => {},
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    dispatchEvent: () => false,
+  })) as typeof window.matchMedia;
+};
+
+type Fake = { el: Element; keyframes: Keyframe[]; options: KeyframeAnimationOptions };
+const animations: Fake[] = [];
+const animate = function (this: Element, keyframes: Keyframe[], options: KeyframeAnimationOptions) {
+  animations.push({ el: this, keyframes, options: options ?? {} });
+  return { currentTime: 0, finished: Promise.resolve(), onfinish: null, oncancel: null, play: () => {}, pause: () => {}, finish: () => {}, cancel: () => {}, playState: "running" } as unknown as Animation;
+};
+
+const member = (over: Partial<Member> = {}): Member => ({
+  user: { id: USER, email: "ananya@example.com", created_at: "2026-11-01T05:00:00Z", user_metadata: {} } as unknown as Member["user"],
+  profile: { id: USER, full_name: "Ananya", birthday: "1999-07-14", phone: null, city: null },
+  firstName: "Ananya",
+  preview: false,
+  saveBirthday: async () => ({ ok: true }),
+  addToBag: async () => true,
+  buyNow: async () => {},
+  bagBusy: false,
+  doorsPlayed: true,
+  markDoorsPlayed: () => {},
+  drops: [],
+  unlisted: [],
+  pressed: [],
+  press: () => {},
+  naira: readNaira(null),
+  changeMeta: () => ({ ok: true }),
+  savedSync: { h: [], x: [] },
+  keepSavedSync: () => {},
+  metaProblem: null,
+  retryMeta: () => {},
+  since: null,
+  month: 7,
+  firstVisit: false,
+  arrivalProfile: null,
+  arrival: { hasOwnSignup: async () => true, join: async () => ({ ok: true, already: true }), saveConsent: async () => ({ ok: true }) },
+  garden: { hour: "night" },
+  checkoutsPreview: [],
+  ...over,
+});
+
+/* Imported only once the garden has asked for it (the first describe below checks it never does by day). */
+let StarSheet: (typeof import("./StarSheet"))["default"];
+const sheet = (over: Partial<Member> = {}, onClose = () => {}) =>
+  render(
+    <MemoryRouter>
+      <MemberProvider value={member(over)}>
+        <StarSheet month={7} onClose={onClose} />
+      </MemberProvider>
+    </MemoryRouter>,
+  );
+
+/* jsdom has no PointerEvent: a mouse event that carries its pointer's id. */
+if (typeof window.PointerEvent === "undefined") {
+  class FakePointerEvent extends MouseEvent {
+    pointerId: number;
+    constructor(type: string, init: PointerEventInit = {}) {
+      super(type, init);
+      this.pointerId = init.pointerId ?? 1;
+    }
+  }
+  (window as unknown as { PointerEvent: unknown }).PointerEvent = FakePointerEvent;
+}
+
+/* jsdom lays nothing out: the sky as it stands at 390 px (358 square), from the page's corner. */
+let box: ReturnType<typeof vi.spyOn>;
+const sky = () => document.querySelector(".ig-stars-sky") as SVGSVGElement;
+const at = ([x, y]: readonly [number, number]) => ({ clientX: x, clientY: y, pointerId: 1 });
+
+beforeEach(() => {
+  window.localStorage.clear();
+  animations.length = 0;
+  (Element.prototype as unknown as { animate: unknown }).animate = animate;
+  setReducedMotion(false);
+  box = vi.spyOn(Element.prototype, "getBoundingClientRect").mockImplementation(() => ({ left: 0, top: 0, width: SHEET, height: SHEET, right: SHEET, bottom: SHEET, x: 0, y: 0, toJSON: () => ({}) }) as DOMRect);
+});
+afterEach(() => {
+  cleanup();
+  box.mockRestore();
+  delete (Element.prototype as unknown as { animate?: unknown }).animate;
+  setReducedMotion(false);
+});
