+/* /members/card: her garden card. Imported only by Card.tsx. Radius 0; the finished picture fades in (opacity) and nothing else moves. */
+
+.ig-cardroom {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-cardroom .ig-lede { text-wrap: balance; }
+
+/* The card's shape at phone size, its art painted at once; the finished PNG is laid over it. */
+.ig-cardroom-stage { position: relative; display: flex; flex-direction: column; align-items: center; width: 100%; margin-top: 1.5rem; }
+.ig-cardroom-paper,
+.ig-cardroom-png { width: min(100%, 300px); aspect-ratio: 9 / 16; }
+.ig-cardroom-paper {
+  position: relative;
+  background: var(--nf-ivory);
+  box-shadow: 0 18px 34px -26px rgb(122 90 40 / 0.6), 0 0 0 1px var(--ig-line);
+}
+.ig-cardroom-paper::before,
+.ig-cardroom-paper::after { content: ""; position: absolute; pointer-events: none; }
+.ig-cardroom-paper::before { inset: 2.5%; border: 1px solid var(--nf-accent-strong); }
+.ig-cardroom-paper::after { inset: 3.4%; border: 1px solid var(--ig-gold-line); }
+.ig-cardroom-art { position: absolute; left: 9.4%; top: 18.2%; width: 81.2%; height: 65.6%; overflow: visible; }
+.ig-cardroom-art--flower { left: 22%; top: 26%; width: 56%; height: 45%; }
+.ig-cardroom-png {
+  position: absolute;
+  top: 0;
+  left: 50%;
+  display: block;
+  height: auto;
+  transform: translateX(-50%);
+  -webkit-touch-callout: default;
+}
+.ig-cardroom-status {
+  margin: 1.1rem 0 0;
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.64);
+}
+.ig-cardroom-actions { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; width: 100%; margin-top: 1.25rem; }
+.ig-cardroom-actions .ig-cardroom-status { margin-top: 0; }
+/* While a new picture is drawn: the old one dimmed, its buttons waiting, a line saying so (its room kept, so nothing jumps). */
+.ig-cardroom-png.is-stale { opacity: 0.55; }
+.ig-cardroom-actions [aria-disabled="true"] { opacity: 0.55; cursor: progress; }
+.ig-cardroom-redraw { min-height: 1.5em; }
+
+/* Her choices: the art, and her name (off until she adds it). */
+.ig-cardroom-choices { display: flex; flex-direction: column; gap: 1rem; width: 100%; max-width: 360px; margin-top: 1.75rem; text-align: left; }
+.ig-cardroom-pick { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; border: 0; }
+.ig-cardroom-pick legend { width: 100%; margin-bottom: 0.6rem; }
+.ig-cardroom-chip { position: relative; display: inline-flex; }
+.ig-cardroom-chip input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
+.ig-cardroom-chip span {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 0.9rem;
+  border: 1px solid var(--ig-gold-line);
+  background: var(--ig-vellum);
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: var(--nf-ink);
+}
+.ig-cardroom-chip input:checked + span { border-color: var(--nf-ink); background: var(--nf-ink); color: var(--nf-ivory); }
+.ig-cardroom-chip input:focus-visible + span { outline: 1px solid var(--nf-accent-strong); outline-offset: 3px; }
+.ig-cardroom-toggle {
+  display: flex;
+  align-items: center;
+  gap: 0.7rem;
+  min-height: 44px;
+  font-family: var(--nf-font-editorial);
+  font-size: 1.12rem;
+  cursor: pointer;
+}
+.ig-cardroom-toggle input { flex: none; width: 20px; height: 20px; margin: 0; accent-color: var(--nf-accent-strong); }
+.ig-cardroom-toggle em { color: var(--nf-gold-text); }
+
+/* The open image: the picture alone, to press and hold and save. Under the header (z-50) and the bag; above the garden path. */
+.ig-cardroom-open {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.6rem;
+  padding: 123px 16px 2rem;
+  overflow-y: auto;
+  background: var(--nf-ivory);
+  text-align: center;
+}
+.ig-cardroom-open .ig-h2:focus { outline: none; }
+.ig-cardroom-big {
+  display: block;
+  width: min(100%, 420px, (100svh - 280px) * 0.5625);
+  height: auto;
+  box-shadow: 0 0 0 1px var(--ig-line);
+  -webkit-touch-callout: default;
+  user-select: auto;
+}
+
+@media (min-width: 768px) {
+  .ig-cardroom { padding-top: 2rem; }
+  .ig-cardroom-open { padding-top: 144px; }
+}
