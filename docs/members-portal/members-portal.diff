+import { describe, expect, it } from "vitest";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { STONES, isPlausibleBirthday, monthOfBirthday, stoneForBirthday } from "./stones";
+import { BIRTHSTONE_HANDLE, MONTH_OPTION, variantForMonth } from "./stonePiece";
+
+/* The specimen card opens the Birthstone Heart Necklace on her month. If our
+   twelve names drifted from the listing's ("June · Light Amethyst", not
+   "June · Alexandrite"), the card would open on no variant, or the wrong one,
+   and Add to bag would carry a stone she did not choose. */
+const necklace = jewellerySnapshot.find((p) => p.handle === BIRTHSTONE_HANDLE)!;
+
+describe("her stone, as the shop sells it", () => {
+  it("finds the necklace and its twelve Month variants in the shop's data", () => {
+    expect(necklace).toBeTruthy();
+    expect(necklace.options?.find((o) => o.name === MONTH_OPTION)?.values).toHaveLength(12);
+  });
+
+  it.each(STONES.map((s) => [s.month, s.variant]))("month %i preselects the listing's own variant, %s", (month, name) => {
+    const variant = variantForMonth(necklace, month);
+    expect(variant?.options[MONTH_OPTION]).toBe(name);
+    // Exactly the snapshot's value for that month, in the listing's order.
+    expect(necklace.options!.find((o) => o.name === MONTH_OPTION)!.values[month - 1]).toBe(name);
+  });
+
+  it("keeps the shop's own name if a stone is renamed", () => {
+    const renamed = {
+      ...necklace,
+      variants: necklace.variants!.map((v) =>
+        v.options[MONTH_OPTION] === "July · Ruby" ? { ...v, options: { [MONTH_OPTION]: "July · Crimson" } } : v,
+      ),
+    };
+    expect(variantForMonth(renamed, 7)?.options[MONTH_OPTION]).toBe("July · Crimson");
+  });
+
+  it("reads the month from the birthday text itself, never through a time zone", () => {
+    expect(monthOfBirthday("1999-07-14")).toBe(7);
+    expect(monthOfBirthday("2001-01-01")).toBe(1);
+    expect(monthOfBirthday("2001-12-31")).toBe(12);
+    expect(monthOfBirthday(null)).toBeNull();
+    expect(monthOfBirthday("14/07/1999")).toBeNull();
+    expect(stoneForBirthday("1999-10-03")?.variant).toBe("October · Rose");
+  });
+
+  it("accepts only real, past birthdays", () => {
+    const today = new Date("2026-11-05T00:00:00Z");
+    expect(isPlausibleBirthday("1999-07-14", today)).toBe(true);
+    expect(isPlausibleBirthday("1999-02-30", today)).toBe(false);
+    expect(isPlausibleBirthday("2027-01-01", today)).toBe(false);
+    expect(isPlausibleBirthday("1850-01-01", today)).toBe(false);
+  });
+
+  it("never names a stone as a real gemstone on its own: each name is the listing's month pairing", () => {
+    for (const s of STONES) expect(s.variant.startsWith(`${s.monthName} · `)).toBe(true);
+  });
+});
diff --git a/src/lib/portal/stones.ts b/src/lib/portal/stones.ts
new file mode 100644
index 0000000..6dd3a4d
--- /dev/null
+++ b/src/lib/portal/stones.ts
@@ -0,0 +1,84 @@
+/*
+  Her stone, as the shop sells it. The Birthstone Heart Necklace's "Month"
+  option names each variant "January · Garnet" … "December · Blue Zircon";
+  `variant` below must equal those names exactly (stones.test reads the
+  snapshot), so the card opens on the variant she can actually buy. The
+  stones are cubic zirconia in each month's colour, so the portal says "in
+  your month's colour" and never calls them garnets or rubies on their own.
+
+  `hue` is sampled from each variant's own photo and drawn only inside
+  flowers and petals, never on buttons or text. `flower` is the traditional
+  birth flower for the month.
+
+  The listing itself (its handle, its Month option, the variant for a month
+  and its own words for the stone) is stonePiece.ts: only the rooms that show
+  the piece read it, and the garden home draws just her stone's colour.
+*/
+
+export type Stone = {
+  month: number;
+  monthName: string;
+  stone: string;
+  variant: string;
+  hue: string;
+  /** A lighter tint of the hue for inner petals. */
+  tint: string;
+  flower: string;
+};
+
+const row = (month: number, monthName: string, stone: string, hue: string, tint: string, flower: string): Stone => ({
+  month,
+  monthName,
+  stone,
+  variant: `${monthName} · ${stone}`,
+  hue,
+  tint,
+  flower,
+});
+
+export const STONES: readonly Stone[] = [
+  row(1, "January", "Garnet", "#8C1C2C", "#C7707A", "Carnation"),
+  row(2, "February", "Amethyst", "#8A5DB5", "#C4A8DE", "Violet"),
+  row(3, "March", "Aquamarine", "#7DBBD0", "#C3E2EC", "Daffodil"),
+  row(4, "April", "Crystal", "#DCE5EB", "#F6F9FB", "Daisy"),
+  row(5, "May", "Emerald", "#1F8A55", "#8CC9A8", "Lily of the valley"),
+  row(6, "June", "Light Amethyst", "#C9AEDD", "#E9DCF2", "Rose"),
+  row(7, "July", "Ruby", "#C20E3A", "#EC8AA0", "Larkspur"),
+  row(8, "August", "Peridot", "#8DB52A", "#CBE08C", "Gladiolus"),
+  row(9, "September", "Sapphire", "#23509E", "#8EA9DA", "Aster"),
+  row(10, "October", "Rose", "#EE9FBA", "#F9D6E2", "Marigold"),
+  row(11, "November", "Topaz", "#E0950F", "#F3CC83", "Chrysanthemum"),
+  row(12, "December", "Blue Zircon", "#1C9FBC", "#90D3E2", "Narcissus"),
+];
+
+/** 1–12 from a profiles.birthday DATE ("1999-07-14"), or null. Read from the
+    string itself: parsing it as a Date would shift it a day in some zones. */
+export const monthOfBirthday = (birthday: string | null | undefined): number | null => {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(birthday ?? "");
+  if (!m) return null;
+  const month = Number(m[2]);
+  return month >= 1 && month <= 12 ? month : null;
+};
+
+export const stoneForMonth = (month: number | null | undefined): Stone | null =>
+  month && month >= 1 && month <= 12 ? STONES[month - 1] : null;
+
+export const stoneForBirthday = (birthday: string | null | undefined): Stone | null =>
+  stoneForMonth(monthOfBirthday(birthday));
+
+/** A valid birthday a member could have: a real date, not in the future, after 1900. */
+export const isPlausibleBirthday = (value: string, today: Date = new Date()): boolean => {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+  if (!m) return false;
+  const [y, mo, d] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  const at = new Date(Date.UTC(y, mo - 1, d));
+  if (at.getUTCFullYear() !== y || at.getUTCMonth() !== mo - 1 || at.getUTCDate() !== d) return false;
+  return y >= 1900 && at.getTime() <= today.getTime();
+};
+
+/**
+ * A variant name for display ("July · Ruby"), held together on one line: a
+ * phone otherwise breaks it at the middot. Display only; matching always
+ * uses the shop's exact string.
+ */
+export const shownName = (name: string): string => name.replace(/ · /g, "\u00a0·\u00a0");
diff --git a/src/lib/portal/tier.test.ts b/src/lib/portal/tier.test.ts
