+import { findPiece, keepStars } from "./petals";
+import { addGift, applyPatch, forgetMetal, forgetMonth, keepMetal, keepMonth, keepRing, restoreHandle, saveHandle, unsaveHandle } from "./roomChanges";
+
+/*
+  Her account's memory (user_metadata.naira): namespaced, read-modify-write,
+  never more than 1.2 KB, a null deletes, writes debounced, today's visit
+  written at most once an IST day.
+*/
+
+const handles = (n: number, prefix = "piece") => Array.from({ length: n }, (_, i) => `${prefix}-with-a-longer-handle-${String(i).padStart(2, "0")}`);
+
+/* What GoTrue does with metadata: a sign-in through Google merges the
+   provider's claims into user_metadata one top-level key at a time (a null
+   deletes that key), and updateUser({ data }) merges the same way. */
+const gotrueMerge = (meta: Record<string, unknown>, updates: Record<string, unknown>) => {
+  const next = { ...meta };
+  for (const [k, v] of Object.entries(updates)) {
+    if (v === null) delete next[k];
+    else next[k] = v;
+  }
+  return next;
+};
+
+afterEach(() => {
+  vi.useRealTimers();
+});
+
+describe("reading her naira", () => {
+  it("starts empty for a new member and keeps what is valid", () => {
+    expect(readNaira(undefined)).toEqual({ v: 1, saved: [], pressed: [], front: [], gifts: [] });
+    const n = readNaira({ v: 1, ring: { us: 6, how: "s", at: "2026-11-05" }, metal: "g", saved: ["woven-gold-hoops", "woven-gold-hoops", "Bad Handle!"], pressed: ["verdant"], front: ["verdant", "never-pressed"] });
+    expect(n.ring).toEqual({ us: 6, how: "s", at: "2026-11-05" });
+    expect(n.saved).toEqual(["woven-gold-hoops"]);
+    expect(n.front).toEqual(["verdant"]);
+  });
+
+  it("leaves out a ring outside US 5 to 9 rather than trusting it", () => {
+    expect(readNaira({ ring: { us: 11, how: "k", at: "2026-11-05" } }).ring).toBeUndefined();
+    expect(readNaira({ ring: { us: 7, how: "x", at: "2026-11-05" } }).ring).toBeUndefined();
+  });
+
+  it("keeps keys a later version wrote, untouched, through every change", () => {
+    const later = { v: 1, saved: ["a-piece"], wishes: { colour: "teal" }, x: 3 };
+    const changed = keepMetal("s")(readNaira(later));
+    expect(changed.wishes).toEqual({ colour: "teal" });
+    expect(changed.x).toBe(3);
+    expect(compactNaira(changed)).toMatchObject({ wishes: { colour: "teal" }, x: 3, metal: "s", saved: ["a-piece"] });
+  });
+});
+
+describe("namespaced, so a Google sign-in cannot clobber it", () => {
+  it("survives the provider re-merging its claims on every sign-in", () => {
+    const naira = compactNaira(keepRing(7, "t", "2026-11-05")(readNaira(null)));
+    const meta = { full_name: "Ananya Rao", naira };
+    const afterGoogle = gotrueMerge(meta, {
+      iss: "https://accounts.google.com",
+      sub: "1234",
+      name: "Ananya R",
+      full_name: "Ananya R",
+      avatar_url: "https://lh3.googleusercontent.com/a",
+      picture: "https://lh3.googleusercontent.com/a",
+      email: "ananya@example.com",
+      email_verified: true,
+      phone_verified: false,
+      provider_id: "1234",
+    });
+    expect(afterGoogle.naira).toEqual(naira);
+    expect(readNaira(afterGoogle.naira).ring).toEqual({ us: 7, how: "t", at: "2026-11-05" });
+  });
+
+  it("writes only its own key, so her name and picture are never sent back", async () => {
+    const save = vi.fn(async (_n: Naira) => {});
+    const w = createMetaWriter({ load: async () => readNaira(null), save });
+    w.queue(keepMetal("b"));
+    await w.flush();
+    expect(save).toHaveBeenCalledTimes(1);
+    const payload = { data: { naira: compactNaira(save.mock.calls[0][0]) } };
+    expect(Object.keys(payload.data)).toEqual(["naira"]);
+    const merged = gotrueMerge({ full_name: "Ananya Rao", avatar_url: "x" }, payload.data);
+    expect(merged.full_name).toBe("Ananya Rao");
+    expect(merged.avatar_url).toBe("x");
+  });
+});
+
+describe("changes", () => {
+  it("deletes a key with null and ignores undefined", () => {
+    const n = keepRing(6, "k", "2026-11-05")(keepMetal("g")(readNaira(null)));
+    const out = applyPatch(n, { ring: null, metal: undefined });
+    expect(out.ring).toBeUndefined();
+    expect(out.metal).toBe("g");
+    expect("ring" in compactNaira(out)).toBe(false);
+  });
+
+  it("saves a piece once, newest last, and takes it out", () => {
+    let n = readNaira(null);
+    n = saveHandle("a")(n);
+    n = saveHandle("b")(n);
+    n = saveHandle("a")(n);
+    expect(n.saved).toEqual(["a", "b"]);
+    expect(unsaveHandle("a")(n).saved).toEqual(["b"]);
+  });
+
+  it("presses a flower once, adds Front Row only in its first hour, and keeps front inside pressed", () => {
+    let n = readNaira(null);
+    n = pressInto("verdant", true)(n);
+    n = pressInto("verdant", false)(n);
+    n = pressInto("carre", false)(n);
+    expect(n.pressed).toEqual(["verdant", "carre"]);
+    expect(n.front).toEqual(["verdant"]);
+    const many = mergePressed(handles(30, "drop"))(n);
+    expect(many.pressed).toHaveLength(24);
+    expect(many.front.every((id) => many.pressed.includes(id))).toBe(true);
+  });
+
+  it("moves the device's pressed flowers in without pressing any twice", () => {
+    const n = mergePressed(["verdant", "carre", "verdant"])(pressInto("verdant", true)(readNaira(null)));
+    expect(n.pressed).toEqual(["verdant", "carre"]);
+    expect(n.front).toEqual(["verdant"]);
+  });
+});
+
+describe("the 1.2 KB cap", () => {
+  it("lets the oldest saved handles go first, and stays at 1.2 KB or less", () => {
+    let n = mergePressed(handles(24, "drop-id"))(readNaira(null));
+    n = { ...n, saved: handles(24) };
+    expect(bytesOf(n)).toBeGreaterThan(META_CAP_BYTES);
+    const fitted = fitToCap(n);
+    expect(fitted.ok).toBe(true);
+    if (fitted.ok === false) return;
+    expect(bytesOf(fitted.naira)).toBeLessThanOrEqual(META_CAP_BYTES);
+    expect(JSON.stringify(compactNaira(fitted.naira)).length).toBeLessThanOrEqual(META_CAP_BYTES);
+    expect(fitted.trimmed[0]).toBe(handles(24)[0]);
+    // The newest are kept.
+    expect(fitted.naira.saved.at(-1)).toBe(handles(24)[23]);
+    expect(fitted.naira.pressed).toHaveLength(24);
+  });
+
+  it("refuses what still cannot fit once nothing saved is left to let go", () => {
+    const n = { ...readNaira(null), note: "x".repeat(1300) } as Naira;
+    const fitted = fitToCap(n);
+    expect(fitted.ok).toBe(false);
+  });
+
+  it("keeps a full member (24 saved, 24 pressed, a ring, eight gifts) under the cap by trimming saved only", () => {
+    let n = mergePressed(handles(24, "d"))(keepRing(6, "s", "2026-11-05")(readNaira(null)));
+    n = { ...n, saved: handles(24, "h"), gifts: Array.from({ length: MAX_GIFTS }, (_, i) => ({ n: `Name ${i}`, m: 1 + i, d: 10, b: 1500 as const })) };
+    const fitted = fitToCap(n);
+    expect(fitted.ok).toBe(true);
+    if (fitted.ok === false) return;
+    expect(fitted.naira.gifts).toHaveLength(MAX_GIFTS);
+    expect(fitted.naira.pressed).toHaveLength(24);
+    expect(bytesOf(fitted.naira)).toBeLessThanOrEqual(META_CAP_BYTES);
+  });
+
+  it("never trims a gift silently: a ninth is refused with a message", () => {
+    let n = readNaira(null);
+    for (let i = 0; i < MAX_GIFTS; i++) {
+      const r = addGift({ n: `G${i}`, m: 3, d: 4, b: 1000 }, n);
+      expect(r.ok).toBe(true);
+      if (r.ok) n = r.naira;
+    }
+    const ninth = addGift({ n: "One more", m: 5, d: 6, b: 2500 }, n);
+    expect(ninth.ok).toBe(false);
+    if (ninth.ok === false) expect(ninth.message).toMatch(/Eight dates/);
+    expect(n.gifts).toHaveLength(MAX_GIFTS);
+  });
+});
+
+describe("Phase 3's own keys", () => {
+  it("keeps only the newest six Front Row marks, always inside pressed", () => {
+    let n = readNaira(null);
+    for (let i = 0; i < 10; i++) n = pressInto(`drop-${i}`, true)(n);
+    expect(n.front).toHaveLength(MAX_FRONT);
+    expect(n.front.at(-1)).toBe("drop-9");
+    expect(n.front.every((id) => n.pressed.includes(id))).toBe(true);
+    expect(readNaira({ v: 1, pressed: n.pressed, front: n.pressed }).front).toHaveLength(MAX_FRONT);
+  });
+
+  it("keeps only the plan's shape: a visit day and nothing about the arrival questions", () => {
+    const n = touchSeen("2026-11-05")(readNaira({ v: 1, seen: { last: "2026-10-20" } }));
+    expect(n.seen).toEqual({ last: "2026-11-05" });
+    expect(readNaira({ v: 1, seen: { last: "2026-11-05", prev: "2026-10-20" } }).seen).toEqual({ last: "2026-11-05" });
+    const keys = Object.keys(compactNaira(keepMonth(7)(keepMetal("g")(keepRing(6, "k", "2026-11-05")(saveHandle("a-piece")(pressInto("drop-a", true)(n)))))));
+    expect(keys.sort()).toEqual(["front", "metal", "month", "pressed", "ring", "saved", "seen", "v"]);
+  });
+
+  it("keeps her month alone, 1 to 12, and forgets it", () => {
+    const n = keepMonth(7)(readNaira(null));
+    expect(n.month).toBe(7);
+    expect(keepMonth(7)(n)).toBe(n);
+    for (const bad of [0, 13, 2.5, NaN]) expect(keepMonth(bad)(n)).toBe(n);
+    expect(forgetMonth(n).month).toBeUndefined();
+    const none = readNaira(null);
+    expect(forgetMonth(none)).toBe(none);
+    expect(readNaira({ v: 1, month: 14 }).month).toBeUndefined();
+  });
+
+  it("puts a piece taken out back where it was", () => {
+    const n = { ...readNaira(null), saved: ["a-piece", "c-piece"] };
+    expect(restoreHandle("b-piece", 1)(n).saved).toEqual(["a-piece", "b-piece", "c-piece"]);
+    expect(restoreHandle("a-piece", 1)(n)).toBe(n);
+  });
+
+  it("forgets her metal: no preference", () => {
+    const n = keepMetal("g")(readNaira(null));
+    expect(forgetMetal(n).metal).toBeUndefined();
+    const none = readNaira(null);
+    expect(forgetMetal(none)).toBe(none);
+  });
+
+  it("measures bytes without ever throwing, even on a broken character", () => {
+    const n = { ...readNaira(null), note: "a\uD800b" } as Naira;
+    expect(() => bytesOf(n)).not.toThrow();
+    expect(bytesOf({ ...readNaira(null), note: "मीरा" } as Naira)).toBe(JSON.stringify({ v: 1, note: "" }).length + 12);
