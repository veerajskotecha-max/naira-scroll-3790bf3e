+import { afterEach, describe, expect, it } from "vitest";
+import { META_CAP_BYTES, MAX_FRONT, MAX_GIFTS, bytesOf, compactNaira, fitToCap, mergePressed, pressInto, readNaira, touchSeen, type Gift, type Naira } from "./memberMeta";
+import { keepMetal, keepMonth, keepRing } from "./roomChanges";
+import { BITS, PIECES, STARS, WHOLE, crownSaid, findPiece, fitsOnAccount, forgetVisit, foundThisVisit, freshFinds, keepStars, noteFound, pieceOf, piecesFound, playOf, pressedIn, roomsHolding, roomsSaid, WORDS } from "./petals";
+
+/*
+  Play's one integer on her account (naira.p): a play write only ever adds
+  its bit, onto her account's fresh copy; never clears one; never passes the
+  1.2 KB cap, so it never trims a saved piece to make room.
+*/
+
+afterEach(() => forgetVisit());
+
+/* Her account at its fullest: everything Phase 3 and 4 keep, at its longest, and as many long saved handles as the cap lets stand. */
+const fullest = (): Naira => {
+  const ids = Array.from({ length: 24 }, (_, i) => `drop-${String(i).padStart(2, "0")}-xxxxxxxxxxxx`.slice(0, 20));
+  let n = mergePressed(ids)(keepRing(9, "s", "2026-11-05")(readNaira(null)));
+  for (const id of ids.slice(-MAX_FRONT)) n = pressInto(id, true)(n);
+  n = touchSeen("2026-11-05")(keepMonth(12)(keepMetal("b")(n)));
+  const gifts = Array.from({ length: MAX_GIFTS }, (_, i): Gift => ({ n: "म".repeat(12), m: 10 + (i % 3), d: 20 + i, b: 2500 }));
+  return { ...n, gifts };
+};
+
+describe("the play number's bits", () => {
+  it("are pinned: Drops 0, the Drawer 1, Your fit 2, Gifts 3, Care 4, the stars 5", () => {
+    expect(BITS).toEqual({ drops: 0, drawer: 1, fit: 2, gifts: 3, care: 4, stars: 5 });
+    expect(PIECES.map((p) => [p.key, p.bit])).toEqual([
+      ["drops", 0],
+      ["drawer", 1],
+      ["fit", 2],
+      ["gifts", 3],
+      ["care", 4],
+    ]);
+    expect(WHOLE).toBe(31);
+    expect(STARS).toBe(32);
+    // Four petals and the stem, each of the brand flower's parts once.
+    expect(PIECES.map((p) => p.part).sort()).toEqual([0, 1, 2, 3, "stem"]);
+    expect(pieceOf("fit").part).toBe("stem");
+  });
+});
+
+describe("findPiece", () => {
+  it("sets only its bit, and never clears one", () => {
+    const n = readNaira(null);
+    for (const piece of PIECES) {
+      const after = findPiece(piece.bit)(n);
+      expect(playOf(after)).toBe(1 << piece.bit);
+    }
+    const some = { ...readNaira(null), p: 0b100101 };
+    expect(playOf(findPiece(BITS.drawer)(some))).toBe(0b100111);
+  });
+
+  it("ignores any bit outside 0 to 4 (the stars are keepStars' alone)", () => {
+    const n = readNaira(null);
+    for (const bad of [-1, 5, 6, 31, 2.5, NaN]) expect(findPiece(bad)(n)).toBe(n);
+  });
+
+  it("ORs onto the account's fresh copy, keeping another phone's finds", () => {
+    const fromAnotherPhone = readNaira({ v: 1, p: (1 << BITS.gifts) | STARS });
+    const after = findPiece(BITS.drops)(fromAnotherPhone);
+    expect(playOf(after)).toBe((1 << BITS.gifts) | STARS | 1);
+    expect(compactNaira(after).p).toBe(41);
+  });
+
+  it("returns the very same object when the bit is already set, so nothing is written", () => {
+    const n = readNaira({ v: 1, p: 1 << BITS.care });
+    expect(findPiece(BITS.care)(n)).toBe(n);
+  });
+
+  it("returns the very same object when the write would pass the cap: on a full account, every saved handle stays", () => {
+    // The fullest Phase 4 account (1,177 B), and one saved handle long enough to leave less than the 6 bytes ,"p":1 needs.
+    const base = fullest();
+    const length = Array.from({ length: 40 }, (_, i) => i + 1).find((l) => bytesOf({ ...base, saved: ["h".repeat(l)] }) > META_CAP_BYTES - 6) as number;
+    const full = { ...base, saved: ["h".repeat(length)] };
+    expect(bytesOf(full)).toBeLessThanOrEqual(META_CAP_BYTES);
+    expect(bytesOf({ ...full, p: 1 })).toBeGreaterThan(META_CAP_BYTES);
+    for (const piece of PIECES) expect(findPiece(piece.bit)(full)).toBe(full);
+    expect(keepStars(full)).toBe(full);
+    // And the room knows it beforehand, so its words can say the find is for this visit only.
+    for (const piece of PIECES) expect(fitsOnAccount(full, piece.bit)).toBe(false);
+    expect(fitsOnAccount(full, BITS.stars)).toBe(false);
+    expect(fitsOnAccount(base, BITS.drops)).toBe(true);
+    // A bit already on her account always fits (nothing is written).
+    // The writer's own cap pass then has nothing to trim: her saved piece stays.
+    expect(fitToCap(findPiece(BITS.fit)(full))).toMatchObject({ ok: true, trimmed: [] });
+  });
+
+  it("with 24 saved handles on a full account, a find never trims one", () => {
+    const n = { ...readNaira(null), saved: Array.from({ length: 24 }, (_, i) => `piece-${i}`) };
+    let after = n;
+    for (const piece of PIECES) after = findPiece(piece.bit)(after);
+    after = keepStars(after);
+    expect(playOf(after)).toBe(63);
+    expect(after.saved).toEqual(n.saved);
+    expect(fitToCap(after)).toMatchObject({ ok: true, trimmed: [] });
+  });
+});
+
+describe("keepStars", () => {
+  it("sets bit five alone, once, by the same rules", () => {
+    const n = readNaira({ v: 1, p: 3 });
+    const after = keepStars(n);
+    expect(playOf(after)).toBe(35);
+    expect(keepStars(after)).toBe(after);
+  });
+});
+
+describe("this visit's memory", () => {
+  const U = "u-1";
+  it("shows a find as found for this visit, even one her account had no room for", () => {
+    const n = readNaira(null);
+    expect(piecesFound(n, U)).toBe(0);
+    noteFound(U, BITS.gifts);
+    expect(piecesFound(n, U)).toBe(1 << BITS.gifts);
+    expect(piecesFound(readNaira({ v: 1, p: 1 | STARS }), U)).toBe(1 | (1 << BITS.gifts));
+    noteFound(U, BITS.stars);
+    expect(piecesFound(n, U)).toBe(1 << BITS.gifts);
+  });
+
+  it("presses each fresh find in once", () => {
+    noteFound(U, BITS.drops);
+    noteFound(U, BITS.care);
+    expect(freshFinds(U)).toBe(1 | (1 << BITS.care));
+    pressedIn(U, 1);
+    expect(freshFinds(U)).toBe(1 << BITS.care);
+    pressedIn(U, freshFinds(U));
+    expect(freshFinds(U)).toBe(0);
+  });
+
+  it("is hers alone: another member signing in on the same tab starts with nothing found", () => {
+    noteFound("a", BITS.drops);
+    noteFound("a", BITS.drawer);
+    expect(piecesFound(readNaira(null), "b")).toBe(0);
+    expect(foundThisVisit("b")).toBe(0);
+    expect(freshFinds("b")).toBe(0);
+    // And when the first signs in again, her visit has started afresh too: nothing of the other's carries over.
+    noteFound("b", BITS.care);
+    expect(piecesFound(readNaira(null), "a")).toBe(0);
+  });
+
+  it("never holds a bit above the stars: her account reads only 1 to 63", () => {
+    const n = readNaira({ v: 1, p: 64 | 5 });
+    expect(playOf(n)).toBe(0);
+    expect(piecesFound(n, U)).toBe(0);
+    expect(playOf(findPiece(BITS.drawer)(n))).toBe(2);
+    expect(playOf(keepStars(findPiece(BITS.care)(readNaira({ v: 1, p: 15 }))))).toBe(63);
+  });
+});
+
+describe("words", () => {
+  it("names the rooms in words, never a number", () => {
+    expect(roomsSaid(0b00001)).toBe("Drops");
+    expect(roomsSaid(0b00011)).toBe("Drops and the drawer");
+    expect(roomsSaid(0b10101)).toBe("Drops, your fit and Care");
+    expect(crownSaid(0b00011)).toBe("The Naira flower at the arbour's crown, gathered from Drops and the drawer.");
+    // Whole only for this visit when her account could not keep every piece.
+    expect(crownSaid(WHOLE, 0b01111)).toBe("The Naira flower at the arbour's crown, whole for this visit: gathered from Drops, the drawer, your fit, Gifts and Care.");
+    expect(crownSaid(WHOLE | STARS)).toBe("The Naira flower at the arbour's crown, whole again, edged in gold leaf: gathered from Drops, the drawer, your fit, Gifts and Care.");
+    for (let bits = 1; bits <= 63; bits++) expect(crownSaid(bits)).not.toMatch(/\d/);
+    expect(roomsHolding(0b01011).map((p) => p.key)).toEqual(["fit", "care"]);
+    expect(roomsHolding(WHOLE)).toEqual([]);
+    for (const text of Object.values(WORDS)) expect(text).not.toMatch(/\d/);
+    expect(WORDS.keptNote).toMatch(/For joy, not points, never redeemable\./);
+  });
+});
+
+describe("the preview member's play switches (development only)", () => {
+  it("sets the lowest N pieces with hunt, and the stars with stars=1", async () => {
+    const { readPreviewMember } = await import("./preview");
+    const naira = (q: string) => readNaira(readPreviewMember(`?portalPreview=1${q}`)?.user.user_metadata.naira);
+    expect(naira("").p).toBeUndefined();
+    expect(naira("&hunt=0").p).toBeUndefined();
+    expect(naira("&hunt=2").p).toBe(3);
+    expect(naira("&hunt=5").p).toBe(WHOLE);
+    expect(naira("&hunt=6").p).toBeUndefined();
+    expect(naira("&stars=1").p).toBe(STARS);
+    expect(naira("&hunt=5&stars=1").p).toBe(63);
+  });
+});
