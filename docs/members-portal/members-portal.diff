+  const stone = stoneForMonth(gift.m);
+  const variant = variantForMonth(piece, gift.m);
+  const [adding, setAdding] = useState<"idle" | "busy" | "done">("idle");
+  const live = useRef(true);
+  useEffect(
+    () => () => {
+      live.current = false;
+    },
+    [],
+  );
+  useEffect(() => setAdding("idle"), [gift.m]);
+  if (!stone) return null;
+  const name = variant?.options[MONTH_OPTION] ?? stone.variant;
+  const add = async () => {
+    if (!piece || !variant || adding === "busy") return;
+    setAdding("busy");
+    let ok = false;
+    try {
+      ok = await onAdd(cartLineFor(piece, variant));
+    } catch {
+      ok = false;
+    }
+    if (live.current) setAdding(ok ? "done" : "idle");
+  };
+  return (
+    <div className="ig-gstone">
+      <HeartStone stone={stone} size={34} className="ig-gstone-heart" />
+      <div className="ig-gstone-body">
+        <h3 className="ig-gcard-h3">Gift her stone</h3>
+        <p className="ig-fineprint">
+          The Birthstone Heart Necklace in {MONTHS_LONG[gift.m - 1]}'s colour: {shownName(name)}.
+        </p>
+        {status === "loading" && (
+          <p className="ig-fineprint" role="status">
+            Reading today's price from the shop…
+          </p>
+        )}
+        {status === "offline" && <p className="ig-fineprint">We couldn't reach the shop just now.</p>}
+        {(status === "missing" || (status === "ready" && !variant)) && <p className="ig-fineprint">This month isn't in the shop right now.</p>}
+        {status === "ready" && piece && variant && (
+          <>
+            <p className="ig-price ig-gstone-price">
+              <span>{rupees(variant.price)}</span>
+              {variant.compareAtPrice && variant.compareAtPrice > variant.price ? <s>{rupees(variant.compareAtPrice)}</s> : null}
