index 0000000..f7576b6
--- /dev/null
+++ b/src/components/portal/FestivalDressing.tsx
@@ -0,0 +1,330 @@
+import { useEffect, useLayoutEffect, useMemo, useRef, type CSSProperties } from "react";
+import { BED, hashString, layoutGarden, mulberry32 } from "@/lib/portal/gardenLayout";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion, useAmbientLoop } from "@/lib/portal/motion";
+import type { Dressing } from "@/lib/portal/seasons";
+
+/*
+  A festival's dressing over her garden, only on the days the owner's table
+  (seasons.ts) gives it, and a chunk of its own fetched after the garden's
+  first paint; with no row for today it is never fetched.
+
+  - diwali:  a marigold garland hung along the arbour that draws itself
+             (its thread by stroke-dashoffset, then its flowers), and diyas
+             on the soil whose flames flicker;
+  - monsoon: rain in fine hairlines over the bed, and still rings where it
+             lands;
+  - holi:    soft colour on the ground, and a puff of colour where she taps
+             the garden (never more than 24 puffs at once, each removed when
+             it fades).
+
+  The flames and the rain join the bed's one ambient loop (motion.ts), so
+  they rest with the sway; the garland's drawing and the puffs are one-off
+  answers. Under reduced motion or Data Saver every dressing is still art:
+  the garland hung, the flames lit, the rain drawn where it falls, the
+  colour on the ground, and no puffs. Only transform, opacity and
+  stroke-dashoffset move. Festival colours are art, inside the drawing only.
+*/
+
+type Props = {
+  dressing: Dressing;
+  /** Her id: the bed's seed (the diyas stand clear of her two plants' stems, the rain falls the same each visit). */
+  seed: string;
+  /** The night garden: the rain is drawn pale on the ink. */
+  night?: boolean;
+};
+
+const LAYER: CSSProperties = { position: "absolute", inset: 0, pointerEvents: "none" };
+const ART: CSSProperties = { position: "absolute", inset: 0, width: "100%", height: "100%", overflow: "visible" };
+const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
+
+/* ── Diwali ─────────────────────────────────────────── */
+
+const MARIGOLD = ["#E8892B", "#F2B83A", "#EDA032"];
+const THREAD = "#B0843A";
+const LEAF = "#8FAAA4";
+const CLAY = "#B4622F";
+const RIM = "#C99A4C";
+
+type Pt = [number, number];
+/* The arbour's inner arch (GardenBed's ARBOUR_INNER), as two cubic curves. */
+const ARCH: [Pt, Pt, Pt, Pt][] = [
+  [[30, 216], [30, 140], [108, 88], [195, 88]],
+  [[195, 88], [282, 88], [360, 140], [360, 216]],
+];
+const cubic = ([a, b, c, d]: [Pt, Pt, Pt, Pt], t: number): Pt => {
+  const u = 1 - t;
+  return [0, 1].map((k) => u * u * u * a[k] + 3 * u * u * t * b[k] + 3 * u * t * t * c[k] + t * t * t * d[k]) as Pt;
+};
+const quad = (a: Pt, c: Pt, b: Pt, t: number): Pt => [0, 1].map((k) => (1 - t) * (1 - t) * a[k] + 2 * (1 - t) * t * c[k] + t * t * b[k]) as Pt;
+
+/* Five knots along the arch, a swag between each two, and a short tassel from each knot. */
+const KNOTS: Pt[] = [cubic(ARCH[0], 0.3), cubic(ARCH[0], 0.68), [195, 88], cubic(ARCH[1], 0.32), cubic(ARCH[1], 0.7)];
+const SAG = 18;
+const SWAGS = KNOTS.slice(1).map((b, i) => {
+  const a = KNOTS[i];
+  const c: Pt = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2 + SAG * 2];
+  return { a, c, b };
+});
+const GARLAND = `M${KNOTS[0][0].toFixed(1)} ${KNOTS[0][1].toFixed(1)}${SWAGS.map(({ c, b }) => `Q${c[0].toFixed(1)} ${c[1].toFixed(1)} ${b[0].toFixed(1)} ${b[1].toFixed(1)}`).join("")}`;
+const HEADS: { at: Pt; size: number }[] = [
+  ...KNOTS.map((k) => ({ at: k, size: 16 })),
+  ...SWAGS.flatMap(({ a, c, b }) => [0.17, 0.33, 0.5, 0.67, 0.83].map((t) => ({ at: quad(a, c, b, t), size: 14 }))),
+  ...KNOTS.map((k) => ({ at: [k[0], k[1] + 21] as Pt, size: 11 })),
+].sort((p, q) => p.at[0] - q.at[0]);
+
+const Garland = () => (
+  <svg viewBox={`0 0 ${BED.w} ${BED.h}`} style={ART} aria-hidden>
+    <path data-thread="" d={GARLAND} fill="none" stroke={THREAD} strokeWidth="1" pathLength={1} strokeDasharray="1 1" />
+    {KNOTS.map(([x, y], i) => (
+      <g key={i}>
+        <path d={`M${x.toFixed(1)} ${y.toFixed(1)}V${(y + 20).toFixed(1)}`} stroke={THREAD} strokeWidth=".7" />
+        <ellipse cx={(x - 4).toFixed(1)} cy={(y + 26).toFixed(1)} rx="2.2" ry="5" transform={`rotate(18 ${(x - 4).toFixed(1)} ${(y + 26).toFixed(1)})`} fill={LEAF} />
+      </g>
+    ))}
+    {HEADS.map(({ at: [x, y], size }, i) => (
+      <use
+        key={i}
+        data-marigold=""
+        href="#ig-head-3"
+        x={(x - size / 2).toFixed(1)}
+        y={(y - size / 2).toFixed(1)}
+        width={size}
+        height={size}
+        style={{ color: MARIGOLD[i % MARIGOLD.length] }}
+      />
+    ))}
+  </svg>
+);
+
+const DIYA_SPOTS = [46, 92, 200, 300, 346];
+const DIYA_W = 30;
+const DIYA_TOP = BED.soil - 30;
+const FLAME = "M15 1C19.5 6.5 20 11.5 15 18C10 11.5 10.5 6.5 15 1Z";
+const FLAME_IN = "M15 6C17.2 9 17.4 12 15 15.6C12.6 12 12.8 9 15 6Z";
+const BOWL = "M1 1H29C27.5 8.5 22 12 15 12C8 12 2.5 8.5 1 1Z";
+
+const Diya = ({ x }: { x: number }) => (
+  <div style={{ position: "absolute", left: pct(x - DIYA_W / 2, BED.w), top: pct(DIYA_TOP, BED.h), width: pct(DIYA_W, BED.w), height: pct(31, BED.h) }}>
+    <span style={{ position: "absolute", left: "-30%", right: "-30%", top: "-28%", height: "90%", background: "radial-gradient(closest-side, rgb(246 198 107 / 0.42), rgb(246 198 107 / 0))" }} />
+    <svg data-flame="" viewBox="0 0 30 19" style={{ position: "absolute", left: 0, top: 0, width: "100%", height: "60%", overflow: "visible", transformOrigin: "50% 100%" }} aria-hidden>
+      <path d={FLAME} fill="#F2B544" />
+      <path d={FLAME_IN} fill="#FFF3C9" />
+    </svg>
+    <svg viewBox="0 0 30 13" style={{ position: "absolute", left: 0, bottom: 0, width: "100%", height: "42%", overflow: "visible" }} aria-hidden>
+      <path d={BOWL} fill={CLAY} stroke={RIM} strokeWidth=".8" strokeLinejoin="round" />
+      <path d="M6 5.5C10 7.4 20 7.4 24 5.5" fill="none" stroke={RIM} strokeWidth=".6" opacity=".7" />
+    </svg>
+  </div>
+);
+
+const FLICKER: Keyframe[] = [
+  { transform: "scale(1, 1)", opacity: 0.92 },
+  { transform: "scale(0.9, 1.08)", opacity: 1, offset: 0.3 },
+  { transform: "scale(1.05, 0.95)", opacity: 0.84, offset: 0.66 },
+  { transform: "scale(0.96, 1.04)", opacity: 1 },
+];
+
+/* ── the monsoon ────────────────────────────────────── */
+
+const RAIN_DROPS = 18;
+const SLANT_DEG = 12;
+type Drop = { x: number; y: number; len: number; dur: number; phase: number };
+const rainFor = (seed: string): Drop[] => {
+  const rand = mulberry32(hashString(`${seed || "naira"}:rain`));
+  return Array.from({ length: RAIN_DROPS }, (_, i) => ({
+    x: 20 + ((i + rand()) * (BED.w - 10)) / RAIN_DROPS,
+    y: 40 + rand() * 460,
+    len: 26 + rand() * 20,
+    dur: Math.round(1100 + rand() * 600),
+    phase: rand(),
+  }));
+};
+
+/* ── Holi ───────────────────────────────────────────── */
+
+const GULAL = ["#E98AA8", "#F2B04A", "#8CC5A0", "#8FB4E8", "#B39AD9"];
+const PATCHES = [
+  { x: 64, y: 512, w: 54, c: 0 },
+  { x: 126, y: 518, w: 40, c: 1 },
+  { x: 206, y: 514, w: 48, c: 2 },
+  { x: 268, y: 519, w: 36, c: 3 },
+  { x: 330, y: 513, w: 52, c: 4 },
+];
+const PUFF_DOTS = 6;
+const MAX_PUFF_DOTS = 24;
+
+const glow = (hex: string, alpha: number) => {
+  const n = Number.parseInt(hex.slice(1), 16);
+  return `radial-gradient(closest-side, rgb(${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255} / ${alpha}), rgb(${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255} / 0))`;
+};
+
+/** A puff of colour at (x, y) in the layer's own box: six soft dots that open out and fade, each removed when it has. */
+const puffAt = (layer: HTMLElement, x: number, y: number, alive: HTMLElement[]) => {
+  const first = Math.floor(Math.random() * GULAL.length);
+  for (let i = 0; i < PUFF_DOTS; i++) {
+    const dot = document.createElement("span");
+    const size = Math.round(22 + Math.random() * 18);
+    dot.setAttribute("aria-hidden", "true");
+    dot.style.cssText = `position:absolute;left:${x - size / 2}px;top:${y - size / 2}px;width:${size}px;height:${size}px;pointer-events:none;will-change:transform,opacity;background:${glow(GULAL[(first + (i % 3)) % GULAL.length], 0.9)}`;
+    layer.appendChild(dot);
+    alive.push(dot);
+    while (alive.length > MAX_PUFF_DOTS) alive.shift()?.remove();
+    const angle = (i / PUFF_DOTS) * Math.PI * 2 + Math.random() * 0.6;
+    const dist = 22 + Math.random() * 28;
+    const a = play(
+      dot,
+      [
+        { transform: "translate(0px, 0px) scale(0.35)", opacity: 0.9 },
+        { transform: `translate(${(Math.cos(angle) * dist).toFixed(1)}px, ${(Math.sin(angle) * dist - 8).toFixed(1)}px) scale(1.5)`, opacity: 0 },
+      ],
+      { duration: 1000 + Math.random() * 300, easing: EASE_REVEAL, fill: "forwards" },
+    );
+    const gone = () => {
+      dot.remove();
+      const k = alive.indexOf(dot);
+      if (k >= 0) alive.splice(k, 1);
+    };
+    if (a) {
+      a.onfinish = gone;
+      a.oncancel = gone;
+    } else gone();
+  }
+};
+
+const FestivalDressing = ({ dressing, seed, night = false }: Props) => {
+  const rootRef = useRef<HTMLDivElement>(null);
+  const loop = useAmbientLoop();
+  const calm = stillMotion();
+  const diyas = useMemo(() => {
+    if (dressing !== "diwali") return [];
+    const { naira, stone } = layoutGarden(seed);
+    return DIYA_SPOTS.filter((x) => [naira.x, stone.x].every((stem) => Math.abs(stem - x) >= 30));
+  }, [dressing, seed]);
+  const rain = useMemo(() => (dressing === "monsoon" ? rainFor(seed) : []), [dressing, seed]);
+  const rainTone = night ? "244 235 226" : "104 130 126";
+
+  // Diwali: the garland draws itself, once, as it arrives; then its flowers open along it (set before its first paint, so it never shows hung first).
+  useLayoutEffect(() => {
+    const root = rootRef.current;
+    if (!root || calm || dressing !== "diwali") return;
+    const out: (Animation | null)[] = [play(root.querySelector("[data-thread]"), [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 1400, easing: "cubic-bezier(0.45, 0, 0.25, 1)", fill: "backwards" })];
+    root.querySelectorAll("[data-marigold]").forEach((head, i) =>
+      out.push(play(head, [{ opacity: 0 }, { opacity: 1 }], { duration: 360, delay: 500 + i * 45, easing: EASE_BLOOM, fill: "backwards" })),
+    );
+    return () => out.forEach((a) => a?.cancel());
+  }, [calm, dressing]);
+
+  // The flames and the rain: on the bed's one loop, or still without one.
+  useEffect(() => {
+    const root = rootRef.current;
+    if (!root || calm || !loop) return;
+    const list: Animation[] = [];
+    root.querySelectorAll<HTMLElement>("[data-flame]").forEach((flame, i) => {
+      const a = play(flame, FLICKER, { duration: 1100 + i * 130, iterations: Infinity, direction: "alternate", easing: "ease-in-out" });
+      if (a) list.push(a);
+    });
+    const height = root.getBoundingClientRect().height || BED.h;
+    const fall = height + 80;
+    const drift = -fall * Math.tan((SLANT_DEG * Math.PI) / 180);
+    root.querySelectorAll<HTMLElement>("[data-rain]").forEach((drop, i) => {
+      const d = rain[i];
+      if (!d) return;
+      // From above the bed to below it, wherever the drop hangs when still.
+      const from = -40 - (d.y / BED.h) * height;
+      const a = play(
+        drop,
+        [
+          { transform: `translate(0px, ${from.toFixed(1)}px) rotate(${SLANT_DEG}deg)`, opacity: 0 },
+          { opacity: 0.85, offset: 0.1 },
+          { opacity: 0.85, offset: 0.85 },
+          { transform: `translate(${drift.toFixed(1)}px, ${(from + fall).toFixed(1)}px) rotate(${SLANT_DEG}deg)`, opacity: 0 },
+        ],
+        { duration: d.dur, iterations: Infinity, easing: "linear" },
+      );
+      if (!a) return;
+      a.currentTime = d.phase * d.dur;
+      list.push(a);
+    });
+    const leave = loop.join(list);
+    return () => {
+      leave();
+      list.forEach((a) => a.cancel());
+    };
+  }, [calm, loop, rain]);
+
+  // Holi: a tap on the garden puffs colour where it lands (the bloom opens there too).
+  useEffect(() => {
+    const root = rootRef.current;
+    const bed = root?.closest<HTMLElement>(".ig-bed");
+    if (!root || !bed || calm || dressing !== "holi") return;
+    const alive: HTMLElement[] = [];
+    const onDown = (e: PointerEvent) => {
+      if (e.button > 0) return;
+      if ((e.target as Element | null)?.closest?.("a,button,input,select,textarea,label")) return;
+      const box = root.getBoundingClientRect();
+      puffAt(root, e.clientX - box.left, e.clientY - box.top, alive);
+    };
+    bed.addEventListener("pointerdown", onDown);
+    return () => {
+      bed.removeEventListener("pointerdown", onDown);
+      alive.forEach((n) => n.remove());
+      alive.length = 0;
+    };
+  }, [calm, dressing]);
+
+  return (
+    <div ref={rootRef} className="ig-festival" data-dressing={dressing} style={LAYER} aria-hidden>
+      {dressing === "diwali" && (
+        <>
+          <Garland />
+          {diyas.map((x) => (
+            <Diya key={x} x={x} />
+          ))}
+        </>
+      )}
+      {dressing === "monsoon" && (
+        <>
+          {rain.map((d, i) => (
+            <span
+              key={i}
+              data-rain=""
+              style={{
+                position: "absolute",
+                left: pct(d.x, BED.w),
+                // Still, each drop hangs where it falls; moving, its flight crosses the whole bed.
+                top: pct(d.y, BED.h),
+                width: 1,
+                height: pct(d.len, BED.h),
+                background: `linear-gradient(rgb(${rainTone} / 0), rgb(${rainTone} / 0.75))`,
+                transform: `rotate(${SLANT_DEG}deg)`,
+                opacity: 0.6,
+                willChange: calm ? undefined : "transform, opacity",
+              }}
+            />
+          ))}
+          <svg viewBox={`0 0 ${BED.w} ${BED.h}`} style={ART} aria-hidden>
+            {[78, 188, 312].map((x) => (
+              <ellipse key={x} cx={x} cy={BED.soil + 2} rx="9" ry="2.2" fill="none" stroke={RIM} strokeWidth=".6" opacity=".55" />
+            ))}
+          </svg>
+        </>
+      )}
+      {dressing === "holi" &&
+        PATCHES.map((p) => (
+          <span
+            key={p.x}
+            style={{
+              position: "absolute",
+              left: pct(p.x - p.w / 2, BED.w),
+              top: pct(p.y - 9, BED.h),
+              width: pct(p.w, BED.w),
+              height: pct(18, BED.h),
+              background: glow(GULAL[p.c], 0.42),
+            }}
+          />
+        ))}
+    </div>
+  );
+};
+
+export default FestivalDressing;
