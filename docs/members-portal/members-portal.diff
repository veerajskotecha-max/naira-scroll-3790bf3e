+import { Suspense, useEffect, useRef, useState, type CSSProperties } from "react";
+import { Link, useLocation } from "react-router-dom";
+import { lazyRoom, whenIdle } from "@/lib/portal/lazyRoom";
+
+/*
+  The garden path: the portal's own bar, sticky at the foot of the screen
+  while she is in it and resting above the footer at the end. (The shop's
+  global overflow-x: hidden on html and body would make body the scroller
+  and leave sticky doing nothing; MembersRoute swaps it for clip while the
+  portal is open, as the product page does for its sticky column.) It sits in the
+  z-40 tier, under the bag's z-50, so an open bag always covers it. Rooms
+  join as they are built, never as "coming soon": the Drops tab also lights
+  for a drop's own room and the Vault.
+
+  Five tabs fit a 320 px phone with every target 44 px or more: Garden,
+  Stone, Drops, Drawer and More, which lifts a second row of the same tabs
+  (Your fit, the Herbarium, Gifts, the Vanity, Your card, Care, the Order
+  desk and Account) above the bar, four to a line, each 80 x 58 px or more at 320 px.
+  The row is placed with
+  inline styles, so the shared members.css does not grow; it rises with
+  transform and opacity only, and closes on Escape, on a tap elsewhere and
+  when she goes to another room. Its tabs (PortalMore.tsx) are a chunk of
+  their own, fetched as soon as the bar is idle after its first paint, so the
+  rooms beyond the five never ride in it; opened before they have arrived,
+  the row rises the moment they do.
+  Plain Links with aria-current: the shop never uses NavLink, and importing
+  it here would add an export to the vendor chunk every page downloads.
+*/
+
+const GardenIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    {[0, 72, 144, 216, 288].map((a) => (
+      <ellipse key={a} cx="12" cy="6.2" rx="2.6" ry="3.8" transform={`rotate(${a} 12 10)`} className="ig-nav-petal" />
+    ))}
+    <circle cx="12" cy="10" r="1.7" className="ig-nav-core" />
+    <path d="M12 14V22M12 18C10 16.5 8 16.5 7 17.5M12 20C14 18.5 16 18.5 17 19.5" className="ig-nav-line" />
+  </svg>
+);
+
+const StoneIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    <path d="M12 20C6.5 15.6 3.5 12.4 3.5 8.9 3.5 6.3 5.5 4.5 7.8 4.5 9.6 4.5 11.1 5.5 12 7 12.9 5.5 14.4 4.5 16.2 4.5 18.5 4.5 20.5 6.3 20.5 8.9 20.5 12.4 17.5 15.6 12 20Z" className="ig-nav-petal" />
+    <path d="M12 7V20M4 9.5H20M7.8 4.5L12 9.5 16.2 4.5" className="ig-nav-line" />
+  </svg>
+);
+
+const DropsIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    <path d="M12 3.5C15.6 6.6 16.4 10.6 12 15C7.6 10.6 8.4 6.6 12 3.5Z" className="ig-nav-petal" />
+    <path d="M12 15C10.6 12.4 10.4 9 12 5.6M12 15C13.4 12.4 13.6 9 12 5.6" className="ig-nav-line" />
+    <path d="M12 15V21.5M12 15C9.8 15.2 7.6 13.8 6.8 11.6M12 15C14.2 15.2 16.4 13.8 17.2 11.6" className="ig-nav-line" />
+  </svg>
+);
+
+const DrawerIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    <path d="M4 9.5H20V20H4Z" className="ig-nav-line" />
+    <path d="M4 14.5H20M10.5 17.2H13.5" className="ig-nav-line" />
+    <path d="M12 9.5C9.6 8.6 8.6 6.6 9.6 5.2 10.5 4 11.6 4.6 12 5.6 12.4 4.6 13.5 4 14.4 5.2 15.4 6.6 14.4 8.6 12 9.5Z" className="ig-nav-petal" />
+  </svg>
+);
+
+const MoreIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    {[6, 12, 18].map((x) => (
+      <circle key={x} cx={x} cy="12" r="1.7" className="ig-nav-petal" />
+    ))}
+  </svg>
+);
+
+export type Room = { to: string; label: string; icon: JSX.Element; also?: RegExp };
+
+const ROOMS: readonly Room[] = [
+  { to: "/members", label: "Garden", icon: <GardenIcon /> },
+  { to: "/members/stone", label: "Stone", icon: <StoneIcon /> },
+  { to: "/members/drops", label: "Drops", icon: <DropsIcon />, also: /^\/members\/(drops\/.+|vault)$/ },
+  { to: "/members/drawer", label: "Drawer", icon: <DrawerIcon /> },
+];
+
+/* The More row's rooms, in its order (PortalMore.tsx draws their tabs). */
+export const MORE_PATHS = ["/members/fit", "/members/herbarium", "/members/gifts", "/members/vanity", "/members/card", "/members/care", "/members/orders", "/account"] as const;
+const PortalMore = lazyRoom(() => import("./PortalMore"));
+
+export const Tab = ({ room, here, style }: { room: Room; here: string; style?: CSSProperties }) => {
+  const exact = here === room.to;
+  const current = exact || Boolean(room.also?.test(here));
+  return (
+    <li style={style}>
+      <Link to={room.to} className={`ig-nav-link${current ? " is-here" : ""}`} aria-current={exact ? "page" : current ? "true" : undefined}>
+        {room.icon}
+        <span>{room.label}</span>
+      </Link>
+    </li>
+  );
+};
+
+const PortalNav = () => {
+  const here = useLocation().pathname.replace(/\/+$/, "") || "/";
+  const [open, setOpen] = useState(false);
+  const navRef = useRef<HTMLElement>(null);
+  const moreRef = useRef<HTMLButtonElement>(null);
+  const inMore = (MORE_PATHS as readonly string[]).includes(here);
+
+  // Its tabs, fetched once the bar has painted.
+  useEffect(() => whenIdle(() => void PortalMore.preload()), []);
+
+  // Another room closes it.
+  useEffect(() => setOpen(false), [here]);
+
+  useEffect(() => {
+    if (!open) return;
+    const away = (e: Event) => {
+      if (!navRef.current?.contains(e.target as Node)) setOpen(false);
+    };
+    const key = (e: KeyboardEvent) => {
+      if (e.key !== "Escape") return;
+      // From inside the row, focus goes back to More, never to the page's top.
+      const within = Boolean(document.getElementById("ig-nav-more")?.contains(document.activeElement));
+      setOpen(false);
+      if (within) moreRef.current?.focus();
+    };
+    document.addEventListener("pointerdown", away);
+    document.addEventListener("keydown", key);
+    return () => {
+      document.removeEventListener("pointerdown", away);
+      document.removeEventListener("keydown", key);
+    };
+  }, [open]);
+
+  return (
+    <nav ref={navRef} className="ig-nav" aria-label="Your garden">
+      <ul>
+        {ROOMS.map((room) => (
+          <Tab key={room.to} room={room} here={here} />
+        ))}
+        <li>
+          <button
+            ref={moreRef}
+            type="button"
+            className={`ig-nav-link${inMore || open ? " is-here" : ""}`}
+            style={{ width: "100%", border: 0, background: "none", cursor: "pointer" }}
+            aria-expanded={open}
+            aria-controls="ig-nav-more"
+            aria-current={inMore ? "true" : undefined}
+            onClick={() => setOpen((o) => !o)}
+          >
+            <MoreIcon />
+            <span>More</span>
+          </button>
+        </li>
+      </ul>
+      {/* After the bar in the page, so Tab goes from More straight into the row it opened; drawn above it. */}
+      {open && (
+        <Suspense fallback={null}>
+          <PortalMore here={here} />
+        </Suspense>
+      )}
+    </nav>
+  );
+};
+
+export default PortalNav;
