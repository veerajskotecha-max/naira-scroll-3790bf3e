@@ -0,0 +1,371 @@
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import { Link, Navigate, useParams } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import BloomClock from "@/components/portal/BloomClock";
+import CalendarButton from "@/components/portal/CalendarButton";
+import PetalReveal from "@/components/portal/PetalReveal";
+import DropUnbox from "@/components/portal/DropUnbox";
+import DropPieceCard from "@/components/portal/DropPieceCard";
+import { nameFromHandle, whatsAppAbout } from "@/lib/portal/dropWords";
+import PressFlower from "@/components/portal/PressFlower";
+import HerbariumFrame from "@/components/portal/HerbariumFrame";
+import { BudGlyph } from "@/components/portal/FlowerGlyph";
+import ShopWatch from "@/components/portal/ShopWatch";
+import { useMember } from "@/components/portal/MemberContext";
+import { useDropShop } from "@/components/portal/useDropShop";
+import { eyebrow, quietButton, textLink } from "@/components/portal/styles";
+import { HOUR, dropNumber, dropPhase, phaseBoundaries, speciesIndex, timeOf, type DropPhase } from "@/lib/portal/dropPhase";
+import { formatIstDay, formatIstOpening, istMonthName } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { hasDropFlag, setDropFlag } from "@/lib/portal/safeStorage";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { choreographyNow, loadBloomScene, loadChoreography, spectacleAllowed } from "@/lib/portal/spectacle";
+import { whenIdle } from "@/lib/portal/lazyRoom";
+import { shopifyImage } from "@/lib/shopifyImage";
+import "./droproom.css";
+
+/*
+  /members/drops/:dropId: one drop's room, which changes with its phase.
+  - sealed (or moved): its story, Rub the petals for a first look, the Bloom
+    Clock and the calendar, and WhatsApp for the pieces the owner lets be
+    reserved.
+  - members: the unboxing on her first visit here, then the pieces (live
+    price, Available / Sold out, Add to bag and Buy now, her month already
+    chosen), then Press your flower (only in this window, so a filled
+    Herbarium frame means she opened it while it was members' first). The unboxing waits for the shop's
+    answer (an "Opening shortly" or unreachable shop never uses it up) and
+    counts as seen only once its pieces unfold.
+  - public: the same, labelled "Now on the shop", with the box shown open;
+    a flower she pressed is shown, and no new one is offered.
+  - arriving: the time has passed but the pieces are not on the shop yet:
+    "Opening shortly · ask on WhatsApp", never a clock below zero. The shop
+    is asked again every 40 s meanwhile (components/portal/ShopWatch).
+  While the shop is still answering, or cannot be reached, the pieces are
+  one quiet line, never a card each.
+  - vault: the archive: her pressed flower (or a gentle empty frame), the
+    story and the pieces with live availability, by kind.
+
+  On a Tier 2 phone (lib/portal/tier), a room that will unbox (decided once
+  the shop has answered: never for a drop that turns out "opening shortly")
+  fetches the Bloom Field's scene and the gsap choreography at once (an
+  idle callback); when the pieces unfold, those whose place is in view come
+  out of the box (Flip). Under reduced motion, Data Saver or on Tier 1
+  neither is ever fetched.
+
+  A piece whose place is below the fold (under the garden path, on most
+  phones) does not unfold unseen: it waits, hidden, and rises in place as
+  she scrolls to it (an observer, with a timed re-check; without one, at
+  once), on every tier.
+*/
+
+/* What a card's top must clear to count as in view at the unfold: the garden path (about 59 px) and a little more. */
+const PATH_CLEAR = 84;
+const RISE: Keyframe[] = [{ opacity: 0, transform: "translateY(14px)" }, { opacity: 1, transform: "none" }];
+
+/**
+ * The pieces that were below the fold rise as she reaches them, each once,
+ * hidden until then (an inline opacity, set before the browser paints).
+ * Returns their stop, which shows every one still waiting.
+ */
+const riseInView = (cards: readonly HTMLElement[], rise: (card: HTMLElement, i: number) => void): (() => void) => {
+  if (!cards.length) return () => undefined;
+  if (typeof IntersectionObserver === "undefined") {
+    cards.forEach(rise);
+    return () => undefined;
+  }
+  const waiting = new Set(cards);
+  const show = (list: readonly HTMLElement[]) =>
+    list.forEach((card, i) => {
+      if (!waiting.delete(card)) return;
+      io.unobserve(card);
+      card.style.opacity = "";
+      rise(card, i);
+    });
+  const io = new IntersectionObserver((entries) => show(entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement)), {
+    threshold: 0.15,
+    rootMargin: "0px 0px -10% 0px",
+  });
+  // An observer can miss its first word (a layout still settling): anything already in view is shown on a re-check.
+  const check = () => show([...waiting].filter((c) => c.getBoundingClientRect().top < window.innerHeight - PATH_CLEAR));
+  const timers = [350, 1100].map((ms) => window.setTimeout(check, ms));
+  cards.forEach((card) => {
+    card.style.opacity = "0";
+    io.observe(card);
+  });
+  return () => {
+    io.disconnect();
+    timers.forEach((t) => window.clearTimeout(t));
+    waiting.forEach((card) => (card.style.opacity = ""));
+    waiting.clear();
+  };
+};
+
+const EYEBROW: Record<DropPhase, string> = {
+  sealed: "a first look soon",
+  moved: "the date has moved",
+  members: "open · a first look",
+  public: "now on the shop",
+  arriving: "opening shortly",
+  vault: "from the Vault",
+};
+
+const KINDS = ["Necklaces", "Earrings", "Bracelets", "Rings"] as const;
+
+const DropRoom = () => {
+  const { dropId = "" } = useParams();
+  const { drops, month, pressed, press, addToBag, buyNow, bagBusy, preview } = useMember();
+  const drop = drops.find((d) => d.id === dropId);
+  const marks = useMemo(() => (drop ? phaseBoundaries([drop]) : []), [drop]);
+  const now = useServerNow(marks, Boolean(drop));
+  const shop = useDropShop(Boolean(drop));
+  const phase = drop ? dropPhase(drop, now, shop.live) : null;
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const gridRef = useRef<HTMLDivElement>(null);
+  const [kind, setKind] = useState<string>("All");
+  const lead = drop ? shop.pieceOf(drop.leadHandle) : undefined;
+  const unboxPiece = drop?.cutoutUrl
+    ? { src: drop.cutoutUrl, cutout: true }
+    : lead
+      ? { src: shopifyImage(lead.cover ?? lead.image, 360), cutout: false }
+      : undefined;
+  /* Decided once, the first time the room has the shop's answer and shows
+     the drop open to members (as she arrives, or as the clock opens it in
+     front of her): the unboxing is for her first time here, with motion,
+     with a piece to lift. Never decided on a guess while the shop loads. */
+  const ritualRef = useRef<boolean | null>(null);
+  if (ritualRef.current === null && phase === "members" && shop.status === "ready") ritualRef.current = Boolean(unboxPiece) && !hasDropFlag("unboxed", dropId) && !stillMotion();
+  const ritual = ritualRef.current === true;
+  const [unfolded, setUnfolded] = useState(false);
+  const unfoldedOnce = useRef(false);
+  const unfoldStop = useRef<(() => void) | null>(null);
+
+  // A room that will unbox asks for Tier 2's code at once (the field is prepared while the opening holds; the choreography is wanted 2.5 s in).
+  useEffect(() => {
+    if (!ritual || !spectacleAllowed()) return;
+    return whenIdle(() => {
+      void loadChoreography();
+      void loadBloomScene();
+    });
+  }, [ritual]);
+  useEffect(() => () => unfoldStop.current?.(), []);
+
+  // Seen once its pieces unfold (or she skips to them): only then is it used up on this device.
+  const onUnfold = useCallback(() => {
+    setUnfolded(true);
+    if (ritualRef.current) setDropFlag("unboxed", dropId);
+  }, [dropId]);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, [dropId]);
+
+  // Opened in its first hour: remembered on this phone, so pressing its flower later still keeps the Front Row keepsake.
+  const firstHour = Boolean(drop) && phase === "members" && now < timeOf(drop!.membersFrom) + HOUR;
+  useEffect(() => {
+    if (firstHour) setDropFlag("early", dropId);
+  }, [firstHour, dropId]);
+
+  // After the unboxing, the pieces unfold one after another.
+  useLayoutEffect(() => {
+    if (!unfolded || unfoldedOnce.current) return;
+    unfoldedOnce.current = true;
+    if (!ritual) return;
+    const cards = [...(gridRef.current?.querySelectorAll<HTMLElement>(".ig-piece") ?? [])];
+    const rise = (card: HTMLElement, i: number) => void play(card, RISE, { duration: 460, delay: i * 60, easing: EASE_REVEAL, fill: "backwards" });
+    // Measured before anything moves: whose place she can see now, above the garden path.
+    const fold = window.innerHeight - PATH_CLEAR;
+    const seen = cards.filter((c) => c.getBoundingClientRect().top < fold);
+    const below = cards.filter((c) => !seen.includes(c));
+    // Tier 2: the pieces in view come out of the box and into the grid (Flip). Otherwise, or if it declines, one after another in place.
+    const stage = gridRef.current?.closest(".ig-room")?.querySelector<HTMLElement>(".ig-unbox-stage");
+    const flown = stage && seen.length ? (choreographyNow()?.unfoldFromBox(seen, stage) ?? null) : null;
+    if (!flown) seen.forEach(rise);
+    const rising = riseInView(below, rise);
+    unfoldStop.current = () => {
+      flown?.();
+      rising();
+    };
+  }, [unfolded, ritual]);
+
+  if (!drop || !phase) return <Navigate to="/members/drops" replace />;
+
+  const number = dropNumber(drop, drops);
+  const species = speciesIndex(drop.species);
+  const mine = pressed.find((p) => p.id === drop.id);
+  const open = phase === "members" || phase === "public" || phase === "arriving";
+  const kinds = KINDS.filter((k) => drop.handles.some((h) => shop.pieceOf(h)?.category === k));
+  const shown = phase === "vault" && kind !== "All" ? drop.handles.filter((h) => shop.pieceOf(h)?.category === kind) : drop.handles;
+  const nameOf = (h: string) => shop.pieceOf(h)?.name ?? drop.names?.[h] ?? nameFromHandle(h);
+  // Some of its pieces are not up yet in its first hour: keep asking the shop.
+  const waiting = phase === "arriving" || (phase === "members" && shop.live !== null && drop.handles.some((h) => shop.live?.(h) === "unlisted") && now < timeOf(drop.membersFrom) + HOUR);
+  // During the unboxing the pieces are laid out but unseen, so nothing moves when they unfold.
+  const hidden = ritual && !unfolded;
+
+  const pieces =
+    shop.status === "ready" ? (
+      <div ref={gridRef} className="ig-pieces" style={hidden ? { visibility: "hidden" } : undefined}>
+        {shown.map((handle) => (
+          <DropPieceCard
+            key={handle}
+            handle={handle}
+            name={nameOf(handle)}
+            piece={shop.pieceOf(handle)}
+            month={month}
+            dropTitle={drop.title}
+            bud={{ species, accent: drop.accent }}
+            preview={preview}
+            bagBusy={bagBusy}
+            onAdd={addToBag}
+            onBuy={buyNow}
+          />
+        ))}
+      </div>
+    ) : shop.status === "loading" ? (
+      <p className="ig-fineprint" role="status">
+        Reading the pieces from the shop…
+      </p>
+    ) : (
+      <p className="ig-fineprint">
+        We couldn't reach the shop just now.{" "}
+        <Link className={textLink} to="/jewellery">
+          See the pieces on the shop
+        </Link>
+      </p>
+    );
+
+  return (
+    <PortalShell title={drop.title} description={`${drop.title}, a drop in the Inner Garden, Naira Flore's members' portal.`}>
+      <div className="ig-room" style={{ ["--ig-accent" as string]: drop.accent }}>
+        <Link to="/members/drops" className={`${quietButton} ig-room-back`}>
+          ← All drops
+        </Link>
+        <div className="ig-head">
+          <p className={eyebrow}>
+            Drop {number} · {EYEBROW[phase]}
+          </p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            <em>{drop.title}</em>
+          </h1>
+          {drop.story.map((line) => (
+            <p key={line} className="ig-room-story">
+              {line}
+            </p>
+          ))}
+        </div>
+
+        {(phase === "sealed" || phase === "moved") && (
+          <>
+            {drop.teaser?.imageUrl && (
+              <section className="ig-section" aria-labelledby="ig-teaser">
+                <h2 id="ig-teaser" className="ig-h2">
+                  A first look
+                </h2>
+                <PetalReveal
+                  drop={drop}
+                  imageUrl={drop.teaser.imageUrl}
+                  alt={lead ? `A first look: ${lead.name}` : `A first look at ${drop.title}`}
+                  note={`${lead ? `Your first look: the ${lead.name}.` : `Your first look at ${drop.title}.`} The same for every member.`}
+                />
+              </section>
+            )}
+            <section className="ig-section ig-room-clock" aria-label="When it opens">
+              <BloomClock drop={drop} />
+              <CalendarButton drop={drop} />
+            </section>
+            {Boolean(drop.reservable?.length) && (
+              <section className="ig-section" aria-labelledby="ig-reserve">
+                <h2 id="ig-reserve" className="ig-h2">
+                  Reserve on WhatsApp
+                </h2>
+                <p className="ig-fineprint">Ask before it opens and one of us will reply to confirm. No payment is taken for a piece that isn't out yet.</p>
+                <ul className="ig-reserve">
+                  {(drop.reservable ?? []).map((h) => {
+                    const name = nameOf(h);
+                    return (
+                      <li key={h}>
+                        <span>{name}</span>
+                        <a className={textLink} href={whatsAppAbout(name, drop.title, h, "reserve")} target="_blank" rel="noopener noreferrer">
+                          Reserve on WhatsApp
+                        </a>
+                      </li>
+                    );
+                  })}
+                </ul>
+              </section>
+            )}
+          </>
+        )}
+
+        <ShopWatch active={waiting} />
+        {open && (
+          <>
+            {phase === "arriving" ? (
+              <section className="ig-section ig-arriving" aria-labelledby="ig-arriving">
+                {/* Almost: four petals open and the last one waiting, an honest picture of "shortly". */}
+                <BudGlyph species={species} accent={drop.accent} open={4} size={170} dial />
+                <h2 id="ig-arriving" className="ig-h2">
+                  Opening shortly
+                </h2>
+                <p className="ig-fineprint">It was set to open {formatIstOpening(drop.membersFrom)}. Its pieces will be on the shop shortly.</p>
+                <a className={textLink} href={whatsAppAbout(drop.title, drop.title, drop.leadHandle, "opening")} target="_blank" rel="noopener noreferrer">
+                  Ask us on WhatsApp
+                </a>
+              </section>
+            ) : shop.status === "loading" ? (
+              <p className="ig-lede ig-wait" role="status">
+                Opening the box…
+              </p>
+            ) : shop.status === "ready" ? (
+              <DropUnbox drop={drop} piece={unboxPiece} ritual={ritual} onUnfold={onUnfold} />
+            ) : null}
+            <section className="ig-section" aria-labelledby="ig-pieces">
+              <h2 id="ig-pieces" tabIndex={-1} className="ig-h2">
+                {phase === "members" ? "The pieces · a first look" : "The pieces"}
+              </h2>
+              {phase === "members" && (
+                <p className="ig-fineprint">Yours to see first. We share it with everyone {formatIstOpening(drop.everyoneFrom)}.</p>
+              )}
+              {pieces}
+            </section>
+            {/* Her flower is pressed in the members' window; once the drop is everyone's, a flower she pressed stays, and no new one is offered. */}
+            {(phase === "members" || (phase === "public" && mine)) && (
+              <PressFlower drop={drop} number={number} pressedOn={mine ? mine.on : null} onPress={() => press(drop.id)} />
+            )}
+          </>
+        )}
+
+        {phase === "vault" && (
+          <>
+            <section className="ig-section ig-room-kept" aria-label="Your pressed flower">
+              <HerbariumFrame
+                species={species}
+                accent={drop.accent}
+                pressed={Boolean(mine)}
+                title={`Drop ${number} · ${drop.title}`}
+                note={mine ? (mine.on ? `pressed ${formatIstDay(`${mine.on}T12:00:00+05:30`)}` : "pressed") : `This one bloomed in ${istMonthName(drop.membersFrom)}`}
+                size={190}
+              />
+            </section>
+            <section className="ig-section" aria-labelledby="ig-pieces">
+              <h2 id="ig-pieces" tabIndex={-1} className="ig-h2">
+                Its pieces, as the shop has them now
+              </h2>
+              {kinds.length > 1 && (
+                <div className="ig-kinds" role="group" aria-label="Show">
+                  {["All", ...kinds].map((k) => (
+                    <button key={k} type="button" className="ig-kind" aria-pressed={kind === k} onClick={() => setKind(k)}>
+                      {k}
+                    </button>
+                  ))}
+                </div>
+              )}
+              {pieces}
+            </section>
+          </>
+        )}
+      </div>
+    </PortalShell>
+  );
+};
+
+export default DropRoom;
