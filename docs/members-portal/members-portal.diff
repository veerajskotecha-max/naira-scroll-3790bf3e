@@ -0,0 +1,251 @@
+import type { JewelPiece } from "@/data/jewellery";
+import { GIFT_BANDS, MAX_GIFTS, giftLabelOk, packGift, type Gift, type Updater } from "./memberMeta";
+import { addGift } from "./roomChanges";
+import { istParts } from "./ist";
+import type { CalendarEvent } from "./ics";
+import { BIRTHSTONE_HANDLE } from "./stonePiece";
+
+/*
+  The gift ledger (/members/gifts): up to eight dates she buys for, each a
+  short name (12 characters or fewer), a day and a month, and a budget band
+  taken from the shop's own Gifting page (its "Under" links, which count a
+  piece at the band's price as within it). They live in her account's
+  memory (naira.gifts, packed small by memberMeta), never trimmed to make
+  room: a ninth is refused with a message.
+
+  Every date is read in Indian time, as the rest of the garden is: the next
+  one is the soonest from today's IST day, across the turn of the year, and
+  a date that falls today is today's. A 29 February birthday falls on
+  28 February in other years.
+
+  The picks for a date are only what the live shop shows, in stock, within
+  her band; nothing is priced from the bundled copy of the catalogue.
+*/
+
+export type Band = Gift["b"];
+export const BANDS: readonly Band[] = GIFT_BANDS;
+export const LABEL_MAX = 12;
+export const REMIND_DAYS = 7;
+
+export const MONTHS_LONG = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
+export const MONTHS_SHORT = MONTHS_LONG.map((m) => m.slice(0, 3));
+const MONTH_DAYS = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
+/** The Gifting page's own words for a band: "Under", then the band in rupees. */
+export const bandLabel = (b: Band): string => `Under ${rupees(b)}`;
+/** The days a month can have (29 for February). */
+export const daysInMonth = (m: number): number => MONTH_DAYS[m - 1] ?? 31;
+/** "14 March" */
+export const giftDay = (g: Pick<Gift, "m" | "d">): string => `${g.d} ${MONTHS_LONG[g.m - 1]}`;
+
+/**
+ * A label as she typed it, made ready to keep: spaces gathered, control
+ * characters and broken characters taken out. Never shortened: one longer
+ * than 12 characters is refused with a message, so she chooses what to cut.
+ */
+export const cleanLabel = (raw: string): string => {
+  let out = "";
+  for (const ch of raw) {
+    const c = ch.codePointAt(0) ?? 0;
+    if (c < 0x20 || c === 0x7f || (c >= 0xd800 && c <= 0xdfff)) continue;
+    out += ch;
+  }
+  return out.replace(/\s+/g, " ").trim();
+};
+
+export type GiftDraft = { n: string; m: number; d: number; b: number | null };
+export type Checked = { ok: true; gift: Gift } | { ok: false; message: string; field: "n" | "m" | "d" | "b" };
+
+/** Her form, checked: the reason (and its field) when it cannot be kept. */
+export const checkGift = (draft: GiftDraft): Checked => {
+  const n = cleanLabel(draft.n);
+  if (!n) return { ok: false, field: "n", message: "Give the date a short name, like Mum or Riya." };
+  if (n.length > LABEL_MAX) return { ok: false, field: "n", message: `Keep the name to ${LABEL_MAX} characters or fewer.` };
+  if (!giftLabelOk(n)) return { ok: false, field: "n", message: "Please use letters, numbers and spaces in the name." };
+  if (!Number.isInteger(draft.m) || draft.m < 1 || draft.m > 12) return { ok: false, field: "m", message: "Please choose the month." };
+  if (!Number.isInteger(draft.d) || draft.d < 1) return { ok: false, field: "d", message: "Please choose the day." };
+  if (draft.d > daysInMonth(draft.m)) return { ok: false, field: "d", message: `${MONTHS_LONG[draft.m - 1]} has ${daysInMonth(draft.m)} days.` };
+  const b = BANDS.find((x) => x === draft.b);
+  if (!b) return { ok: false, field: "b", message: "Please choose a budget." };
+  return { ok: true, gift: { n, m: draft.m, d: draft.d, b } };
+};
+
+export const sameGift = (a: Gift, b: Gift): boolean => a.n === b.n && a.m === b.m && a.d === b.d && a.b === b.b;
+
+/** Why another date cannot be added now, or null when it can (a ninth is refused, never squeezed in). */
+export const refuseAnother = (gifts: readonly Gift[], gift?: Gift): string | null => {
+  if (gifts.length >= MAX_GIFTS) return "Eight dates are kept at most. Remove one to add another.";
+  if (gift && gifts.some((g) => sameGift(g, gift))) return "That date is already in your ledger.";
+  return null;
+};
+
+/* The changes, each applied again to her account's fresh copy when it is
+   written (memberMeta's read, modify, write), so a date added on another
+   phone in the meantime is kept. Each finds its date by what it is, never
+   by its place in the list. */
+
+export const giftAdded = (gift: Gift): Updater => (n) => {
+  if (refuseAnother(n.gifts, gift)) return n;
+  const added = addGift(gift, n);
+  return added.ok ? added.naira : n;
+};
+
+export const giftEdited = (before: Gift, after: Gift): Updater => (n) => {
+  const at = n.gifts.findIndex((g) => sameGift(g, before));
+  if (at < 0 || sameGift(before, after) || n.gifts.some((g, i) => i !== at && sameGift(g, after))) return n;
+  const gifts = [...n.gifts];
+  gifts[at] = after;
+  return { ...n, gifts };
+};
+
+export const giftRemoved = (gift: Gift): Updater => (n) => {
+  const at = n.gifts.findIndex((g) => sameGift(g, gift));
+  return at < 0 ? n : { ...n, gifts: n.gifts.filter((_, i) => i !== at) };
+};
+
+/** Undo of a removal: back where it was, if there is still room for it. */
+export const giftRestored = (gift: Gift, index: number): Updater => (n) => {
+  if (refuseAnother(n.gifts, gift)) return n;
+  const gifts = [...n.gifts];
+  gifts.splice(Math.max(0, Math.min(index, gifts.length)), 0, gift);
+  return { ...n, gifts };
+};
+
+/* ── when each falls ────────────────────────────────── */
+
+const DAY_MS = 86_400_000;
+const isLeap = (y: number) => (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
+/** The day a date falls on in year `y`: 29 February keeps to 28 February in other years. */
+const dayIn = (y: number, m: number, d: number) => (m === 2 && d === 29 && !isLeap(y) ? 28 : d);
+
+export type NextOn = { year: number; month: number; day: number; /** From today's IST day: 0 is today. */ days: number };
+
+/** The next time a date comes round, from today's IST day (today counts). */
+export const nextOn = (g: Pick<Gift, "m" | "d">, now: number): NextOn => {
+  const t = istParts(new Date(now));
+  const today = Date.UTC(t.year, t.month - 1, t.day);
+  let year = t.year;
+  let at = Date.UTC(year, g.m - 1, dayIn(year, g.m, g.d));
+  if (at < today) {
+    year += 1;
+    at = Date.UTC(year, g.m - 1, dayIn(year, g.m, g.d));
+  }
+  return { year, month: g.m, day: dayIn(year, g.m, g.d), days: Math.round((at - today) / DAY_MS) };
+};
+
+/** The date that comes round soonest (the first kept, when two fall on one day); -1 with none. */
+export const nextGiftIndex = (gifts: readonly Gift[], now: number): number => {
+  let best = -1;
+  let soonest = Infinity;
+  gifts.forEach((g, i) => {
+    const { days } = nextOn(g, now);
+    if (days < soonest) {
+      soonest = days;
+      best = i;
+    }
+  });
+  return best;
+};
+
+/** "today", "tomorrow", "in 12 days". */
+export const whenSaid = (days: number): string => (days === 0 ? "today" : days === 1 ? "tomorrow" : `in ${days} days`);
+
+/** Where a date sits on the twelve-month ring: 0 at the start of January, 1 a year on. */
+export const yearFraction = (g: Pick<Gift, "m" | "d">): number => (g.m - 1 + (g.d - 0.5) / daysInMonth(g.m)) / 12;
+
+/* ── her reminders ──────────────────────────────────── */
+
+const GIFTS_URL = "https://nairaflore.com/members/gifts";
+const pad2 = (n: number) => String(n).padStart(2, "0");
+const isoDay = (ms: number) => new Date(ms).toISOString().slice(0, 10);
+
+/** Every year on her day: 29 February comes round on the last day of February. */
+export const yearlyRule = (g: Pick<Gift, "m" | "d">): string => (g.m === 2 && g.d === 29 ? "FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1" : "FREQ=YEARLY");
+
+/* A short, stable id for the date, so adding it twice updates one event (FNV-1a over what it is). */
+const uidOf = (g: Gift) => {
+  let h = 0x811c9dc5;
+  for (const ch of packGift(g)) h = Math.imul(h ^ (ch.codePointAt(0) ?? 0), 0x01000193) >>> 0;
+  return `gift-${pad2(g.m)}${pad2(g.d)}-${h.toString(16)}`;
+};
+
+const detailsOf = (g: Gift) => `${g.n}, ${giftDay(g)}. From your gift ledger in the Inner Garden: ${bandLabel(g.b).toLowerCase()}.`;
+
+/** The .ics (Apple Calendar, Outlook): her day itself, all day, every year, with an alarm a week before. */
+export const giftDayEvent = (g: Gift, now: number): CalendarEvent => {
+  const next = nextOn(g, now);
+  return {
+    uid: uidOf(g),
+    title: `${g.n} · ${giftDay(g)}`,
+    start: `${next.year}-${pad2(next.month)}-${pad2(next.day)}`,
+    allDay: true,
+    repeat: yearlyRule(g),
+    alarm: `-P${REMIND_DAYS}D`,
+    details: detailsOf(g),
+    url: GIFTS_URL,
+  };
+};
+
+/**
+ * Google Calendar's add-event link cannot carry an alarm, so there the
+ * reminder is its own all-day event a week before her day, every year: the
+ * first one still to come (this year's, or next year's when this year's
+ * week-before has passed).
+ */
+export const giftReminderEvent = (g: Gift, now: number): CalendarEvent => {
+  const t = istParts(new Date(now));
+  const today = Date.UTC(t.year, t.month - 1, t.day);
+  let next = nextOn(g, now);
+  let at = Date.UTC(next.year, next.month - 1, next.day) - REMIND_DAYS * DAY_MS;
+  if (at < today) {
+    next = nextOn(g, Date.UTC(next.year, next.month - 1, next.day) + DAY_MS);
+    at = Date.UTC(next.year, next.month - 1, next.day) - REMIND_DAYS * DAY_MS;
+  }
+  return {
+    uid: `${uidOf(g)}-week`,
+    title: `A week until ${g.n} · ${giftDay(g)}`,
+    start: isoDay(at),
+    allDay: true,
+    repeat: "FREQ=YEARLY",
+    details: detailsOf(g),
+    url: GIFTS_URL,
+  };
+};
+
+/* ── what to give ───────────────────────────────────── */
+
+/**
+ * Three pieces to give within her band, from the live shop only: in stock
+ * (availableForSale), at or under the band (as the Gifting page's own
+ * "Under" links count), never the stone necklace (it has its own card), one
+ * of each kind first, closest to the band first, rings (whose size is the
+ * other person's) last. `seed` turns the list a little for each date, so two
+ * dates with one band are not given the same three. `priceOf` is the price
+ * the card would show (the variant her choices land on); the listing's own
+ * when absent. Before the shop has answered there are no picks at all.
+ */
+export const picksWithin = (
+  catalogue: readonly JewelPiece[],
+  live: boolean,
+  band: Band,
+  { seed = 0, count = 3, priceOf = (p: JewelPiece) => p.price }: { seed?: number; count?: number; priceOf?: (p: JewelPiece) => number } = {},
+): JewelPiece[] => {
+  if (!live) return [];
+  const within = catalogue
+    .filter((p) => p.availableForSale && p.handle !== BIRTHSTONE_HANDLE && Number.isFinite(priceOf(p)) && priceOf(p) > 0 && priceOf(p) <= band)
+    .sort((a, b) => Number(a.category === "Rings") - Number(b.category === "Rings") || priceOf(b) - priceOf(a) || a.handle.localeCompare(b.handle));
+  if (!within.length) return [];
+  const turn = (seed * count) % within.length;
+  const order = [...within.slice(turn), ...within.slice(0, turn)];
+  const picks: JewelPiece[] = [];
+  for (const p of order) if (picks.length < count && !picks.some((q) => q.category === p.category)) picks.push(p);
+  for (const p of order) if (picks.length < count && !picks.includes(p)) picks.push(p);
+  return picks;
+};
+
+/** Her ledger as the ring draws it, soonest first from today (for the list and the screen reader). */
+export const bySoonest = (gifts: readonly Gift[], now: number): { gift: Gift; index: number; next: NextOn }[] =>
+  gifts.map((gift, index) => ({ gift, index, next: nextOn(gift, now) })).sort((a, b) => a.next.days - b.next.days || a.index - b.index);
+
+export type { Gift };
