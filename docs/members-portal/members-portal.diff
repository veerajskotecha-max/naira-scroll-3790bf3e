@@ -0,0 +1,99 @@
+import { createElement, useEffect, useState, type ComponentType } from "react";
+
+/*
+  A room (or a part of one) in a chunk of its own that can be fetched before
+  it is needed. React.lazy suspends on its first render even when its chunk
+  has already arrived, so a room fetched ahead would still flash its
+  fallback for a frame; this renders at once once the chunk is in, and
+  suspends (for the caller's Suspense) only while it is still on its way.
+
+  A fetch made ahead that failed (a moment offline while the garden idled)
+  never stands in for her visit: opening the room asks again. A fetch her
+  visit made that fails is thrown to the nearest error boundary, as
+  React.lazy's is, and stays thrown until the next explicit preload, so
+  React's own retry of the render cannot set off a loop of fetches.
+*/
+
+export type LazyRoom<P extends object> = ComponentType<P> & {
+  /** Fetches the chunk (once); always resolves: when it is in, or once it has failed. */
+  preload: () => Promise<void>;
+  /** The chunk is in: the room renders at once. */
+  isLoaded: () => boolean;
+};
+
+export const lazyRoom = <P extends object>(load: () => Promise<{ default: ComponentType<P> }>): LazyRoom<P> => {
+  let loaded: ComponentType<P> | null = null;
+  let failed: { error: unknown; visit: boolean } | null = null;
+  let pending: Promise<void> | null = null;
+
+  const fetchRoom = (visit: boolean): Promise<void> => {
+    if (loaded) return Promise.resolve();
+    if (!pending) {
+      failed = null;
+      pending = load()
+        .then((m) => {
+          // A module without its room (Vite's helper hands back nothing once the page is reloading) is a failure too.
+          loaded = m.default;
+          if (!loaded) throw new TypeError("The room's chunk came without its room.");
+        })
+        .catch((error: unknown) => {
+          failed = { error, visit };
+          pending = null;
+        });
+    }
+    return pending;
+  };
+
+  const Room = (props: P) => {
+    if (loaded) return createElement(loaded, props);
+    if (failed?.visit) throw failed.error;
+    throw fetchRoom(true);
+  };
+
+  return Object.assign(Room, { preload: () => fetchRoom(false), isLoaded: () => loaded !== null });
+};
+
+/* After first paint, when the phone is idle: a chunk she may want next, fetched without competing with the entrance. */
+export const whenIdle = (task: () => void, after = 0): (() => void) => {
+  let idle = 0;
+  const w = window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => number; cancelIdleCallback?: (id: number) => void };
+  const timer = window.setTimeout(() => {
+    if (w.requestIdleCallback) idle = w.requestIdleCallback(task, { timeout: 2000 });
+    else task();
+  }, after);
+  return () => {
+    window.clearTimeout(timer);
+    if (idle) w.cancelIdleCallback?.(idle);
+  };
+};
+
+/**
+ * A decoration in a chunk of its own (the sky, a festival's dressing, the
+ * atelier's notes), fetched once the page has painted and only when it is
+ * wanted. `shown` turns true once its chunk is in, so it renders at once and
+ * never suspends; a chunk that cannot arrive leaves it absent, never an
+ * error. `arriving` is true when it came after the page's first paint (it
+ * may fade in), false when it was already in (back from another room).
+ */
+export const useDecoration = <P extends object>(room: LazyRoom<P>, wanted: boolean): { shown: boolean; arriving: boolean } => {
+  const [atMount] = useState(() => room.isLoaded());
+  const [loaded, setLoaded] = useState(atMount);
+  useEffect(() => {
+    if (!wanted || loaded) return;
+    if (room.isLoaded()) {
+      setLoaded(true);
+      return;
+    }
+    let live = true;
+    const cancel = whenIdle(() => {
+      void room.preload().then(() => {
+        if (live && room.isLoaded()) setLoaded(true);
+      });
+    });
+    return () => {
+      live = false;
+      cancel();
+    };
+  }, [room, wanted, loaded]);
+  return { shown: wanted && loaded, arriving: !atMount };
+};
