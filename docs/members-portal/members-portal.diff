@@ -0,0 +1,122 @@
+import { describe, expect, it } from "vitest";
+import type { Drop } from "./drops";
+import { pressInto, readNaira } from "./memberMeta";
+import { keepRing } from "./roomChanges";
+import { keepsakesFor } from "./keepsakes";
+import { BITS, STARS, WHOLE } from "./petals";
+
+/* The four keepsakes: each kept for something she did, said plainly; never
+   points, never a rank, never a count, never a word about what she missed. */
+
+const drop: Drop = {
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
+  accent: "#2F6B4F",
+  story: ["Green."],
+  membersFrom: "2026-11-21T20:00:00+05:30",
+  everyoneFrom: "2026-11-23T20:00:00+05:30",
+  handles: [],
+  leadHandle: "x",
+  teaser: { imageUrl: "", public: false },
+  reservable: [],
+};
+
+describe("keepsakes", () => {
+  it("a new member has her Seed, and the others say how they are kept", () => {
+    const ks = keepsakesFor({ joinedAt: "2026-11-04T05:00:00Z", month: null, naira: readNaira(null), drops: [] });
+    expect(ks.map((k) => [k.id, k.kept])).toEqual([
+      ["seed", true],
+      ["birth", false],
+      ["fitted", false],
+      ["front", false],
+      ["gathered", false],
+      ["stars", false],
+    ]);
+    expect(ks[0].note).toBe("Planted 4 Nov 2026, the day you joined");
+    expect(ks[1]).toMatchObject({ note: "Kept when your birthday or month is saved", to: "/members/stone" });
+    expect(ks[2]).toMatchObject({ note: "Kept when your ring size is saved", to: "/members/fit" });
+    // With no drop set, Front Row says so rather than hurrying her.
+    expect(ks[3].note).toMatch(/The first drop is not set yet/);
+  });
+
+  it("keeps Birth Flower for a saved birthday, Fitted for a kept size, Front Row for a first-hour press", () => {
+    const naira = pressInto("verdant", true)(keepRing(6, "s", "2026-11-05")(readNaira(null)));
+    const ks = keepsakesFor({ joinedAt: "2026-11-04T05:00:00Z", month: 7, naira, drops: [drop] });
+    expect(ks.filter((k) => k.id !== "gathered" && k.id !== "stars").every((k) => k.kept)).toBe(true);
+    // July's flower (larkspur) is not one the garden draws: the frame does not name a flower it is not showing.
+    expect(ks[1].note).toBe("Your July flower, in your month's colour");
+    expect(ks[1].species).toBe(4);
+    const june = keepsakesFor({ joinedAt: null, month: 6, naira, drops: [drop] });
+    expect(june[1]).toMatchObject({ note: "Rose, for June", species: 0 });
+    expect(ks[2].note).toBe("US 6, measured on your screen, 5 Nov");
+    expect(ks[3].note).toBe("Verdant, opened in its first hour");
+  });
+
+  it("a pressed flower outside the first hour is not Front Row", () => {
+    const ks = keepsakesFor({ joinedAt: null, month: null, naira: pressInto("verdant", false)(readNaira(null)), drops: [drop] });
+    expect(ks[3]).toMatchObject({ kept: false, note: "Kept the first time you are there as a drop opens, and press its flower" });
+  });
+
+  it("never speaks of points, ranks, counts or missing out", () => {
+    const all = [
+      ...keepsakesFor({ joinedAt: null, month: null, naira: readNaira(null), drops: [] }),
+      ...keepsakesFor({ joinedAt: null, month: null, naira: readNaira(null), drops: [drop] }),
+    ];
+    for (const k of all) expect(`${k.name} ${k.note}`).not.toMatch(/point|redeem|rank|unlock|reward|missed|\d+ (of|members)|hurry|last chance/i);
+  });
+});
+
+describe("Gathered (Phase 6)", () => {
+  const gathered = (p: number | undefined, found?: number) =>
+    keepsakesFor({ joinedAt: null, month: null, naira: { ...readNaira(null), ...(p ? { p } : {}) }, drops: [], found }).find((k) => k.id === "gathered");
+
+  it("is kept when the Naira flower's five pieces are home, for joy, not points, never redeemable", () => {
+    const k = gathered(WHOLE);
+    expect(k).toMatchObject({ name: "Gathered", kept: true });
+    expect(k?.note).toBe("Kept when the Naira flower's five pieces came home from your rooms. For joy, not points, never redeemable.");
+    expect(k?.rooms).toBeUndefined();
+    // The stars' bit is not a piece: with it alone, nothing is gathered.
+    expect(gathered(32)?.kept).toBe(false);
+    expect(gathered(63)?.kept).toBe(true);
+  });
+
+  it("until then, says how it is kept and lists the rooms still holding a piece, as links, with no count", () => {
+    const k = gathered((1 << BITS.drops) | (1 << BITS.fit));
+    expect(k?.kept).toBe(false);
+    expect(k?.rooms).toEqual([
+      { name: "Drawer", to: "/members/drawer" },
+      { name: "Gifts", to: "/members/gifts" },
+      { name: "Care", to: "/members/care" },
+    ]);
+    expect(k?.note).not.toMatch(/\d|of five|left|remaining/);
+    expect(gathered(undefined)?.rooms).toHaveLength(5);
+  });
+
+  it("lists a room's piece found this visit as no longer tucked there, but keeps Gathered only from her account", () => {
+    expect(gathered(1, 3)?.rooms?.map((r) => r.name)).toEqual(["Your fit", "Gifts", "Care"]);
+    // Every piece came home this visit, but her account had no room for all of them: not kept, and said so (never a keepsake that vanishes next visit).
+    const visit = gathered(15, WHOLE);
+    expect(visit).toMatchObject({ kept: false, note: "Every piece came home this visit, but your account has no room to keep them just now." });
+    expect(visit?.rooms).toEqual([]);
+    expect(gathered(WHOLE, 0)?.kept).toBe(true);
+  });
+});
+
+describe("Written in your sky (Phase 6)", () => {
+  const stars = (month: number | null, p?: number) => keepsakesFor({ joinedAt: null, month, naira: { ...readNaira(null), ...(p ? { p } : {}) }, drops: [] }).find((k) => k.id === "stars");
+
+  it("is kept when she has traced her month's flower in her garden's stars, named from stones.ts", () => {
+    const k = stars(7, STARS);
+    expect(k).toMatchObject({ name: "Written in your sky", kept: true, month: 7 });
+    expect(k?.note).toBe("Kept when you traced July's flower, the larkspur, in your garden's stars. For joy, not points, never redeemable.");
+    // The pieces' bits alone are not the stars.
+    expect(stars(7, WHOLE)?.kept).toBe(false);
+  });
+
+  it("until then, says how it is kept: in the garden after dark, or her month first", () => {
+    expect(stars(7)).toMatchObject({ kept: false, to: "/members", note: "Kept when you trace your month's flower in your garden's stars, after dark." });
+    expect(stars(null, STARS)).toMatchObject({ kept: false, to: "/members/stone" });
+    for (const m of [null, 1, 12]) expect(`${stars(m)?.note}`).not.toMatch(/zodiac|horoscope|destiny|fortune|lucky|star sign|constellation/i);
+  });
+});
diff --git a/src/lib/portal/keepsakes.ts b/src/lib/portal/keepsakes.ts
