+import type { ReactNode, Ref } from "react";
+import { FlowerGlyph } from "./FlowerGlyph";
+import "./herbarium.css";
+
+/*
+  A herbarium sheet in a thin gold frame: a pressed drop flower held by two
+  slips of vellum, labelled like a specimen ("Drop 01 · Verdant · pressed
+  21 Nov"). A drop she did not press is the same frame, gently empty, with
+  the flower's outline faint where it would lie: "This one bloomed in
+  October". Never a word about what she did not do, never a count.
+*/
+
+type Props = {
+  species: number;
+  accent: string;
+  /** Filled with her pressed flower, or the gentle empty frame. */
+  pressed: boolean;
+  /** Waiting to be pressed: only the fine inner rule is drawn; the gold frame draws itself on the press. */
+  waiting?: boolean;
+  /** "Drop 01 · Verdant" */
+  title: string;
+  /** "pressed 21 Nov", or "This one bloomed in October". */
+  note: string;
+  /** The flower's height in px. */
+  size?: number;
+  className?: string;
+  frameRef?: Ref<HTMLElement>;
+  children?: ReactNode;
+};
+
+const HerbariumFrame = ({ species, accent, pressed, waiting = false, title, note, size = 150, className = "", frameRef, children }: Props) => (
+  <figure ref={frameRef} className={`ig-herb${pressed ? "" : " is-empty"} ${className}`}>
+    <div className="ig-herb-sheet">
+      <svg className="ig-herb-frame" aria-hidden>
+        <rect x="0" y="0" width="100%" height="100%" pathLength={1} style={waiting ? { strokeDashoffset: 1 } : undefined} />
+        <rect x="3.5%" y="2.8%" width="93%" height="94.4%" pathLength={1} className="ig-herb-fine" />
+      </svg>
+      <div className="ig-herb-flower">
+        <FlowerGlyph species={species} accent={accent} state={pressed ? "pressed" : "line"} size={size} />
+        {pressed && (
+          <>
+            <span className="ig-herb-tape ig-herb-tape--a" />
+            <span className="ig-herb-tape ig-herb-tape--b" />
+          </>
+        )}
+      </div>
+      {children}
+    </div>
+    <figcaption className="ig-herb-label">
+      <span>{title}</span>
+      <span className="ig-herb-note">{note}</span>
+    </figcaption>
+  </figure>
+);
+
+export default HerbariumFrame;
diff --git a/src/components/portal/KeepsakeFrame.tsx b/src/components/portal/KeepsakeFrame.tsx
new file mode 100644
index 0000000..cad923b
--- /dev/null
+++ b/src/components/portal/KeepsakeFrame.tsx
@@ -0,0 +1,141 @@
+import type { ReactNode } from "react";
+import { Link } from "react-router-dom";
+import type { Keepsake } from "@/lib/portal/keepsakes";
+import { FlowerGlyph } from "./FlowerGlyph";
+import { FLOWER_PETALS, FLOWER_STEM, FLOWER_VIEWBOX, LEAF_SAGE, PETAL_BLUSH } from "@/lib/portal/brandFlower";
+import { onDrawing, starFlowerFor } from "@/lib/portal/starFlowers";
+import { BIRTH_FLOWER_PATHS } from "./BirthFlowers";
+import "./herbarium.css";
+
+/*
+  A keepsake in the Herbarium, on the same herbarium sheet as a pressed drop
+  flower: Seed, Birth Flower, Fitted, Front Row, Gathered (Phase 6: the
+  Naira flower in gold leaf; not yet, its gold line alone) and Written in
+  the stars (Phase 6: her month's flower in gold on ink, with its stars). Kept, it is drawn in colour
+  and taped down, with what it was kept for; not yet, it is the same frame,
+  faint, saying how it is kept (and where, as a link). Never a count, never a
+  rank, never a word about what she has not done.
+*/
+
+const LEAF = "#99B4AF";
+
+type Props = {
+  keepsake: Keepsake;
+  /** Her month's colour, for the Birth Flower. */
+  hue?: string;
+  /** The first Front Row drop's flower. */
+  species?: number;
+  accent?: string;
+};
+
+const SeedArt = () => (
+  <svg viewBox="-40 -60 80 80" aria-hidden>
+    <path d="M0 6C0-10 0-24 0-34" fill="none" stroke={LEAF} strokeWidth="1.6" />
+    <path d="M0-22C-8-24-16-32-18-42C-8-40-2-32 0-22Z" fill={LEAF} />
+    <path d="M0-30C8-32 15-40 17-49C8-47 2-40 0-30Z" fill={LEAF} opacity=".85" />
+    <ellipse cx="0" cy="10" rx="9" ry="6.5" fill="#E5B9A4" stroke="var(--nf-accent-strong)" strokeWidth=".8" />
+    <path d="M-30 17H30" stroke="var(--nf-accent)" strokeWidth=".8" />
+  </svg>
+);
+
+/* A ring of buds: her size, kept. */
+const RingArt = () => (
+  <svg viewBox="-50 -50 100 100" aria-hidden>
+    <circle r="24" fill="none" stroke="var(--nf-accent-strong)" strokeWidth="1.2" />
+    {Array.from({ length: 8 }, (_, i) => {
+      const a = (i / 8) * Math.PI * 2;
+      const x = Math.cos(a) * 33;
+      const y = Math.sin(a) * 33;
+      return (
+        <g key={i} transform={`translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${((a * 180) / Math.PI + 90).toFixed(0)})`}>
+          <path d="M0 6C-5 0-5-6 0-10C5-6 5 0 0 6Z" fill={i % 2 ? "#F6E4D5" : "#E8C88A"} />
+          <path d="M0 6V12" stroke={LEAF} strokeWidth="1.2" />
+        </g>
+      );
+    })}
+  </svg>
+);
+
+/* Gathered: the Naira flower whole, its colours edged in gold leaf; not kept yet, its gold line alone. */
+const GatheredArt = ({ kept }: { kept: boolean }) => (
+  <svg viewBox={FLOWER_VIEWBOX} height="86%" aria-hidden style={{ overflow: "visible" }}>
+    {kept && <g fill="none" stroke="#DDB46A" strokeOpacity=".45" strokeWidth=".036" strokeLinejoin="round">{[FLOWER_STEM, ...FLOWER_PETALS].map((d, i) => <path key={i} d={d} />)}</g>}
+    {[FLOWER_STEM, ...FLOWER_PETALS].map((d, i) => (
+      <path key={i} d={d} fill={kept ? (i === 0 ? LEAF_SAGE : PETAL_BLUSH) : "none"} stroke={kept ? "#C99A4C" : "var(--nf-accent-strong)"} strokeWidth={kept ? 0.012 : 0.01} strokeLinejoin="round" />
+    ))}
+  </svg>
+);
+
+/* Written in your sky: her month's flower, gold on ink, with the stars she joined; not kept yet, the stars alone, faint. */
+const StarsArt = ({ month, kept }: { month?: number; kept: boolean }) => {
+  const table = starFlowerFor(month);
+  const d = month ? BIRTH_FLOWER_PATHS[month - 1] : undefined;
+  const pts = table ? table.stars.map((s) => onDrawing(s, table.sheet)) : [];
+  return (
+    <svg viewBox="-6 -4 52 72" height="86%" aria-hidden>
+      {kept && <rect x="-6" y="-4" width="52" height="72" fill="#1A1614" />}
+      {kept && d && <path d={d} fill="none" stroke="#E8C88A" strokeWidth=".8" strokeLinecap="round" strokeLinejoin="round" />}
+      {pts.slice(1).map(([x, y], i) => (kept ? <line key={i} x1={pts[i][0]} y1={pts[i][1]} x2={x} y2={y} stroke="#C99A4C" strokeWidth=".35" opacity=".7" /> : null))}
+      {pts.map(([x, y], i) => (
+        <path key={i} d={`M${x} ${y - 2}L${x + 0.5} ${y - 0.5}L${x + 2} ${y}L${x + 0.5} ${y + 0.5}L${x} ${y + 2}L${x - 0.5} ${y + 0.5}L${x - 2} ${y}L${x - 0.5} ${y - 0.5}Z`} fill={kept ? "#FFF6D8" : "var(--nf-accent-strong)"} />
+      ))}
+    </svg>
+  );
+};
+
+const artFor = (keepsake: Keepsake, extra: Omit<Props, "keepsake">): ReactNode => {
+  if (keepsake.id === "stars") return <StarsArt month={keepsake.month} kept={keepsake.kept} />;
+  if (keepsake.id === "seed") return <SeedArt />;
+  if (keepsake.id === "gathered") return <GatheredArt kept={keepsake.kept} />;
+  if (keepsake.id === "fitted") return <RingArt />;
+  if (keepsake.id === "birth") return <FlowerGlyph species={keepsake.species ?? 4} accent={extra.hue ?? "#E5B9A4"} state={keepsake.kept ? "pressed" : "line"} size={120} />;
+  // Front Row: the drop's flower in gold line, before a small dawn arc, so it is not the pressed frame above it again.
+  return (
+    <span className="ig-keep-front">
+      {keepsake.kept && (
+        <svg className="ig-keep-dawn" viewBox="-60 -40 120 50" aria-hidden>
+          <path d="M-46 6A46 40 0 0 1 46 6" fill="none" stroke="var(--nf-accent)" strokeWidth="1" />
+          <path d="M-30 6A30 26 0 0 1 30 6" fill="none" stroke="var(--nf-accent)" strokeWidth=".7" opacity=".7" />
+          <path d="M0-37L1.6-31.6L7-30L1.6-28.4L0-23L-1.6-28.4L-7-30L-1.6-31.6Z" fill="var(--nf-accent)" />
+        </svg>
+      )}
+      <FlowerGlyph species={extra.species ?? 0} accent={extra.accent ?? "#FFBDA8"} state="line" size={120} />
+    </span>
+  );
+};
+
+const KeepsakeFrame = ({ keepsake, ...extra }: Props) => {
+  const art = artFor(keepsake, extra);
+  const figure = (
+    <figure className={`ig-herb ig-keepsake${keepsake.kept ? "" : " is-empty"}`}>
+      <div className="ig-herb-sheet">
+        <svg className="ig-herb-frame" aria-hidden>
+          <rect x="0" y="0" width="100%" height="100%" pathLength={1} />
+          <rect x="3.5%" y="2.8%" width="93%" height="94.4%" pathLength={1} className="ig-herb-fine" />
+        </svg>
+        <div className="ig-herb-flower">
+          {art}
+          {keepsake.kept && (
+            <>
+              <span className="ig-herb-tape ig-herb-tape--a" />
+              <span className="ig-herb-tape ig-herb-tape--b" />
+            </>
+          )}
+        </div>
+      </div>
+      <figcaption className="ig-herb-label">
+        <span>{keepsake.name}</span>
+        <span className="ig-herb-note">{keepsake.note}</span>
+      </figcaption>
+    </figure>
+  );
+  return !keepsake.kept && keepsake.to ? (
+    <Link to={keepsake.to} className="ig-keepsake-link">
+      {figure}
+    </Link>
+  ) : (
+    figure
+  );
+};
+
+export default KeepsakeFrame;
