+import { useEffect, useMemo, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import CareRitual from "@/components/portal/CareRitual";
+import AskAtelier from "@/components/portal/AskAtelier";
+import PetalSpot from "@/components/portal/PetalSpot";
+import { useMember } from "@/components/portal/MemberContext";
+import { useCheckouts } from "@/components/portal/useCheckouts";
+import { eyebrow, textLink } from "@/components/portal/styles";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { careLineOf, houseCareLine, piecesForCare, platingOf, pvdExplainer, ritualFor } from "@/lib/portal/care";
+import { stillMotion } from "@/lib/portal/motion";
+import { formatIstDate } from "@/lib/portal/ist";
+import "./care.css";
+
+/*
+  /members/care: looking after what she owns, only in the listings' own
+  words. The wipe ritual (three steps the listings' care lines share, a
+  cloth clearing a haze from a ring to a glint), the "PVD vs plating" explainer the PVD
+  listings carry, and a card for each piece she saved or took to a checkout
+  (called just that: a checkout is not always an order), each with its own
+  Plating and Care lines from its listing. No service of the shop's is
+  offered that it has not said exists. Ask the atelier on WhatsApp for
+  anything else. No ambient motion here.
+
+  No care line is quoted at the top as if it were hers: the commonest one
+  says water is fine, and a third of the range asks to be kept dry. What
+  each of her pieces asks, water included, is on its own card.
+*/
+
+const Care = () => {
+  const { naira } = useMember();
+  const { jewellery } = useLiveJewellery();
+  const { rows } = useCheckouts();
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const [still] = useState(stillMotion);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  // Words, not prices: the listing's own copy, live or as the shop's first paint carries it.
+  const house = useMemo(() => houseCareLine(jewellery), [jewellery]);
+  const ritual = ritualFor(house);
+  const pvd = useMemo(() => pvdExplainer(jewellery), [jewellery]);
+  // A confirmed order's pieces are called that order's (dated with it); every other row's stay "a checkout you started".
+  const checkoutNames = useMemo(() => (rows ?? []).flatMap((r) => (r.confirmedAt ? [] : r.items.map((i) => i.name))), [rows]);
+  const orderPieces = useMemo(() => (rows ?? []).flatMap((r) => (r.confirmedAt ? r.items.map((i) => ({ name: i.name, on: r.confirmedAt as string })) : [])), [rows]);
+  const pieces = useMemo(() => piecesForCare(jewellery, naira.saved, checkoutNames, orderPieces), [jewellery, naira.saved, checkoutNames, orderPieces]);
+
+  return (
+    <PortalShell title="Care" description="Caring for your pieces, in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-care">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            Caring for your <em>pieces</em>
+          </h1>
+          <p className="ig-lede">How each piece asks to be looked after, in its listing's own words.</p>
+        </div>
+
+        {ritual && (
+          <section className="ig-section" aria-labelledby="ig-ritual-h">
+            <h2 id="ig-ritual-h" className="ig-h2">
+              The ritual
+            </h2>
+            <p className="ig-fineprint">
+              {still ? "Three steps most of the listings' care lines share." : "Three steps most of the listings' care lines share, a pass of the cloth for each. Tap each in turn."} What each of
+              yours asks, water included, is on its card below.
+            </p>
+            <CareRitual steps={ritual} metal={naira.metal} />
+          </section>
+        )}
+
+        {pvd && (
+          <section className="ig-section" aria-labelledby="ig-pvd-h">
+            <h2 id="ig-pvd-h" className="ig-h2">
+              PVD and plating
+            </h2>
+            <blockquote className="ig-care-quote">{pvd}</blockquote>
+            <p className="ig-fineprint">As the PVD pieces' listings put it, under Details. Each piece's own finish is on its card below and on its page.</p>
+          </section>
+        )}
+
+        <section className="ig-section" aria-labelledby="ig-care-yours">
+          {/* A petal of the Naira flower, tucked at the end of the heading (Phase 6, Gathered). */}
+          <PetalSpot piece="care">
+            <h2 id="ig-care-yours" className="ig-h2">
+              Your pieces
+            </h2>
+          </PetalSpot>
+          {pieces.length === 0 ? (
+            <p className="ig-fineprint">
+              Save a piece to your drawer and its care line is kept here, beside every other you save.{" "}
+              <Link className={textLink} to="/members/drawer">
+                Your drawer
+              </Link>
+            </p>
+          ) : (
+            <ul className="ig-care-cards" data-clarity-mask="true">
+              {pieces.map(({ piece, from, on }) => {
+                const care = careLineOf(piece);
+                const plating = platingOf(piece);
+                const image = piece.cover ?? piece.image;
+                return (
+                  <li key={piece.handle} className="ig-care-card">
+                    {image && (
+                      <img
+                        className="ig-care-photo"
+                        src={shopifyImage(image, 240)}
+                        srcSet={shopifySrcSet(image, [240, 360]) || undefined}
+                        sizes="96px"
+                        width={240}
+                        height={240}
+                        loading="lazy"
+                        decoding="async"
+                        alt=""
+                      />
+                    )}
+                    <div className="ig-care-body">
+                      <p className={eyebrow}>{from === "saved" ? "In your drawer" : from === "order" && on ? `From the order placed ${formatIstDate(on)}` : "From a checkout you started"}</p>
+                      <h3 className="ig-care-name">
+                        <Link to={`/jewellery/${piece.handle}`}>{piece.name}</Link>
+                      </h3>
+                      {plating && (
+                        <p className="ig-care-line">
+                          <span>Finish</span> {plating}
+                        </p>
+                      )}
+                      <p className="ig-care-line">
+                        <span>Care</span> {care ?? "Its care line is on its page."}
+                      </p>
+                    </div>
+                  </li>
+                );
+              })}
+            </ul>
+          )}
+        </section>
+
+        <AskAtelier about="care" />
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Care;
