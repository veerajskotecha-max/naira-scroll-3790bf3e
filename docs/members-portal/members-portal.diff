+  content: "";
+  position: absolute;
+  left: 0.15rem;
+  top: 0.62em;
+  width: 7px;
+  height: 7px;
+  background: var(--nf-blush);
+  box-shadow: 0 0 0 1px var(--ig-gold-line);
