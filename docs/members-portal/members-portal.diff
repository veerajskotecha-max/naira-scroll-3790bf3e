+    expect(giftEdited(didi, mum)(n)).toBe(n);
+    const removed = giftRemoved(mum)(n);
+    expect(removed.gifts.map((g) => g.n)).toEqual(["Asha", "Didi"]);
+    expect(giftRestored(mum, 1)(removed).gifts.map((g) => g.n)).toEqual(["Asha", "Mum", "Didi"]);
+    expect(giftAdded(mum)(n)).toBe(n);
+  });
+});
+
+describe("the next date, in Indian time", () => {
+  it("is today on its own day, and counts from IST midnight", () => {
