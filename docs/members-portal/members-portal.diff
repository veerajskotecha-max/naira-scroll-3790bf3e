@@ -0,0 +1,181 @@
+import { useEffect, useId, useLayoutEffect, useMemo, useRef, useState, type RefObject } from "react";
+import { FLOWER_PETALS, FLOWER_STEM, FLOWER_VIEWBOX } from "@/lib/portal/brandFlower";
+import { WHATSAPP_URL, atelierLink, atelierMessage, type AtelierAbout } from "@/lib/portal/whatsapp";
+import { handOff } from "@/lib/portal/handOff";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { useMember } from "./MemberContext";
+import { eyebrow, outlineButton, primaryButton, quietButton } from "./styles";
+import "./ask.css";
+
+/*
+  Ask the atelier (in Care and on the Order Desk). Opening it lays an ivory
+  card down, its seal's place waiting; the message is written on the card from what her account
+  keeps (in Care her size, metal, month's colour and first three saved
+  pieces; on the Order Desk the email she used at checkout and a line for
+  the order number), hers to change, and "Open WhatsApp" presses a gold wax
+  seal, the Naira flower in it, onto the card and opens the atelier's chat
+  with her words filled in, to change again or send. The
+  link itself names only the shop's number: her words are put on it at the
+  tap (lib/portal/handOff), so no click recorder ever reads them. Nothing
+  is sent from here. No reply hours are said until the owner gives them.
+
+  The card opens with the seal's place drawn in a gold hairline (stroke-
+  dashoffset, once); the seal presses onto it as she taps Open WhatsApp
+  (transform and opacity, once), never holding WhatsApp back, so she comes
+  back to a sealed card. Under reduced motion or Data Saver the card is
+  simply there, sealed.
+*/
+
+const C = 36;
+/* The seal's edge: wax spreads unevenly, so its round is a ring of soft bumps of two sizes. */
+const SEAL_EDGE = (() => {
+  const n = 18;
+  const pt = (i: number) => {
+    const a = (i / n) * 2 * Math.PI - Math.PI / 2;
+    const r = 31 + (i % 3 === 0 ? 1.6 : i % 2 ? 0.4 : 1);
+    return `${(C + r * Math.cos(a)).toFixed(1)} ${(C + r * Math.sin(a)).toFixed(1)}`;
+  };
+  let d = `M${pt(0)}`;
+  for (let i = 1; i <= n; i++) d += `A4.6 4.6 0 0 1 ${pt(i % n)}`;
+  return `${d}Z`;
+})();
+
+const WaxSeal = ({ sealRef, sealed }: { sealRef: RefObject<SVGSVGElement>; sealed: boolean }) => (
+  <svg ref={sealRef} className="ig-seal" viewBox="0 0 72 72" width="72" height="72" aria-hidden>
+    {!sealed ? (
+      // Its place, waiting: a gold hairline round where the wax will go.
+      <circle cx={C} cy={C} r="31" className="ig-seal-place" pathLength={1} strokeDasharray="1 1" />
+    ) : (
+      <>
+    <path d={SEAL_EDGE} className="ig-seal-wax" />
+    <circle cx={C} cy={C} r="24" className="ig-seal-rim" />
+    <svg x="22" y="14" width="28" height="44" viewBox={FLOWER_VIEWBOX}>
+      <path d={FLOWER_STEM} className="ig-seal-flower" />
+      {FLOWER_PETALS.map((d, i) => (
+        <path key={i} d={d} className="ig-seal-flower" />
+      ))}
+    </svg>
+      </>
+    )}
+  </svg>
+);
+
+type Props = {
+  about: AtelierAbout;
+  /** The Order Desk's: her sign-in's email, which goes in the message (and she can change). */
+  email?: string | null;
+  title?: string;
+  lede?: string;
+};
+
+const AskAtelier = ({ about, email = null, title = "Ask the atelier", lede }: Props) => {
+  const { naira, month } = useMember();
+  const id = useId();
+  const written = useMemo(
+    () => atelierMessage({ about, size: naira.ring?.us, metal: naira.metal, month, saved: naira.saved, email }),
+    [about, naira.ring?.us, naira.metal, month, naira.saved, email],
+  );
+  const [open, setOpen] = useState(false);
+  const [still] = useState(stillMotion);
+  const [sealed, setSealed] = useState(still);
+  const [text, setText] = useState(written);
+  const [edited, setEdited] = useState(false);
+  const cardRef = useRef<HTMLDivElement>(null);
+  const sealRef = useRef<SVGSVGElement>(null);
+  const toRef = useRef<HTMLParagraphElement>(null);
+
+  // Her account's words, until she has written her own.
+  useEffect(() => {
+    if (!edited) setText(written);
+  }, [written, edited]);
+
+  // The card lays down, and the seal's place draws itself in.
+  useLayoutEffect(() => {
+    if (!open || still) return;
+    play(cardRef.current, [{ opacity: 0, transform: "translateY(14px)" }, { opacity: 1, transform: "none" }], { duration: 420, easing: EASE_REVEAL, fill: "backwards" });
+    play(sealRef.current?.querySelector(".ig-seal-place") ?? null, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 700, delay: 220, easing: EASE_REVEAL, fill: "backwards" });
+  }, [open, still]);
+
+  // Open WhatsApp: the seal presses onto the card, once (WhatsApp is already on its way).
+  useLayoutEffect(() => {
+    if (!sealed || still) return;
+    play(
+      sealRef.current,
+      [
+        { opacity: 0, transform: "translateY(-18px) scale(1.45) rotate(-8deg)" },
+        { opacity: 1, transform: "translateY(0) scale(0.9) rotate(0deg)", offset: 0.72 },
+        { opacity: 1, transform: "none" },
+      ],
+      { duration: 620, easing: EASE_BLOOM, fill: "backwards" },
+    );
+  }, [sealed, still]);
+
+  // Focus goes to the card, not into the message, so a phone's keyboard does not rise over the seal; she taps the message to change it.
+  useEffect(() => {
+    if (open) toRef.current?.focus({ preventScroll: true });
+  }, [open]);
+
+  return (
+    <section className="ig-section ig-ask" aria-labelledby={`${id}-h`}>
+      <h2 id={`${id}-h`} className="ig-h2">
+        {title}
+      </h2>
+      <p className="ig-fineprint">
+        {lede ??
+          "Write to the atelier on WhatsApp. Your size, metal, month's colour and the first three pieces you saved go in the message, for you to change before it goes."}
+      </p>
+      {!open ? (
+        <button type="button" className={outlineButton} onClick={() => setOpen(true)} aria-expanded={false}>
+          Write to the atelier
+        </button>
+      ) : (
+        <div ref={cardRef} className="ig-ask-card" data-clarity-mask="true">
+          <WaxSeal sealRef={sealRef} sealed={sealed} />
+          <p ref={toRef} tabIndex={-1} className={`${eyebrow} ig-ask-to`}>
+            To the atelier, Naira Flore
+          </p>
+          <label htmlFor={`${id}-text`} className="ig-ask-label">
+            Your message
+          </label>
+          <textarea
+            id={`${id}-text`}
+            className="ig-ask-text"
+            rows={9}
+            value={text}
+            onChange={(e) => {
+              setText(e.target.value);
+              setEdited(true);
+            }}
+          />
+          <a
+            className={primaryButton}
+            href={WHATSAPP_URL}
+            target="_blank"
+            rel="noopener noreferrer"
+            onClick={(e) => {
+              handOff(() => atelierLink(text))(e);
+              setSealed(true);
+            }}
+          >
+            Open WhatsApp
+          </a>
+          <p className="ig-fineprint">WhatsApp opens with these words. Nothing is sent until you send it there.</p>
+          {edited && (
+            <button
+              type="button"
+              className={quietButton}
+              onClick={() => {
+                setEdited(false);
+                setText(written);
+              }}
+            >
+              Start the message again
+            </button>
+          )}
+        </div>
+      )}
+    </section>
+  );
+};
+
+export default AskAtelier;
