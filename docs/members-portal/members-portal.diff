+
+/* The ring sizer's sums: a bank card for the screen's millimetre, the
+   site's own chart for the size, WhatsApp beyond US 5 to 9. */
+
+describe("the chart", () => {
+  it("is the site's own RING_SIZE_CHART, in millimetres", () => {
+    expect(RING_CHART.map((r) => ({ us: String(r.us), diameterCm: r.diameterMm.toFixed(1).replace(/^(\d)(\d)\.(\d)$/, "$1.$2$3"), circumferenceCm: (r.circumferenceMm / 10).toFixed(2) }))).toEqual(
+      RING_SIZE_CHART.map((r) => ({ us: r.us, diameterCm: r.diameterCm, circumferenceCm: r.circumferenceCm })),
+    );
+    expect(RING_CHART.map((r) => r.diameterMm)).toEqual([15.7, 16.5, 17.3, 18.1, 19.0]);
+  });
+});
+
+describe("the card", () => {
+  it("turns the card's length on screen into pixels per millimetre", () => {
+    expect(pxPerMmFrom(513.6, "long")).toBeCloseTo(6, 5);
+    expect(pxPerMmFrom(53.98 * 5.5, "short")).toBeCloseTo(5.5, 5);
+    expect(CARD_MM).toEqual({ long: 85.6, short: 53.98 });
+  });
+
+  it("refuses a calibration no phone could have", () => {
+    expect(pxPerMmFrom(100, "long")).toBeNull();
+    expect(pxPerMmFrom(2000, "long")).toBeNull();
+    expect(pxPerMmFrom(Number.NaN, "long")).toBeNull();
+  });
+
+  it("converts both ways", () => {
+    expect(pxToMm(99, 6)).toBeCloseTo(16.5, 5);
+    expect(mmToPx(16.5, 6)).toBeCloseTo(99, 5);
+  });
+
+  it("is kept for this screen's size and pixel ratio only", () => {
+    const key = screenKey(390, 844, 3);
+    expect(key).toBe("390x844@3");
+    expect(screenKey(412, 915, 2.625)).toBe("412x915@2.63");
+    const kept = { key, pxPerMm: 6.04 };
+    expect(calibrationFor(kept, "390x844@3")).toBe(6.04);
+    expect(calibrationFor(kept, "390x844@2")).toBeNull();
+    expect(calibrationFor(kept, "412x915@2.63")).toBeNull();
+    expect(calibrationFor({ key, pxPerMm: 42 }, key)).toBeNull();
+    expect(calibrationFor(null, key)).toBeNull();
+  });
+});
+
+/* A real card's edge on a real phone, in CSS px: its panel's physical px per mm. */
+const phones = [
+  { name: "iPhone SE (2nd, 3rd)", w: 375, pxPerMm: 6.42 },
+  { name: "iPhone 12/13 mini", w: 375, pxPerMm: 6.25 },
+  { name: "iPhone X/XS/11 Pro", w: 375, pxPerMm: 6.01 },
+  { name: "iPhone 12/13/14", w: 390, pxPerMm: 6.04 },
+  { name: "iPhone 15/16", w: 393, pxPerMm: 6.04 },
+  { name: "Galaxy S23", w: 360, pxPerMm: 5.57 },
+  { name: "Pixel 7", w: 412, pxPerMm: 6.24 },
+];
+
+describe("the stage is the limit", () => {
+  it("a line held at the stage's edge is refused, a pixel short of it is kept", () => {
+    const roomMax = calRoomMax("short", 375, 212);
+    expect(roomMax).toBe(375 - CAL_LEFT - 2);
+    expect(atRoomLimit(roomMax, "short", roomMax)).toBe(true);
+    expect(calibrationFrom(roomMax, "short", roomMax)).toBeNull();
+    expect(calibrationFrom(roomMax - 1, "short", roomMax)).toBeCloseTo((roomMax - 1) / CARD_MM.short, 5);
+    // The 9 px per mm ceiling is the range's, not the screen's: a genuine reading there passes.
+    const wide = calRoomMax("short", 1200, 212);
+    expect(atRoomLimit(9 * CARD_MM.short, "short", wide)).toBe(false);
+    expect(calibrationFrom(9 * CARD_MM.short, "short", wide)).toBeCloseTo(9, 5);
+  });
+
+  it.each(phones)("the card's short side fits across $name, edge to edge", ({ w, pxPerMm }) => {
+    const needed = CARD_MM.short * pxPerMm;
+    const roomMax = calRoomMax("short", w, 212);
+    expect(roomMax).toBeGreaterThan(needed + 1);
+    expect(calibrationFrom(needed, "short", roomMax)).toBeCloseTo(pxPerMm, 5);
+  });
+
+  it("a 320 px screen (about 50 mm across) is narrower than any card: the line reaches its limit, and nothing is kept", () => {
+    const roomMax = calRoomMax("short", 320, 212);
+    const needed = CARD_MM.short * 6.42;
+    expect(roomMax).toBeLessThan(needed);
+    expect(calibrationFrom(roomMax, "short", roomMax)).toBeNull();
+  });
+
+  it("the long side down a 664 px phone screen cannot reach a card, and is refused at its limit", () => {
+    const roomMax = calRoomMax("long", 390, 664 - 123 - 250);
+    expect(roomMax).toBeLessThan(CARD_MM.long * 6.04);
+    expect(calibrationFrom(roomMax, "long", roomMax)).toBeNull();
+  });
+});
+
+describe("the size", () => {
+  it("is the nearest US size to a ring's inner diameter", () => {
+    expect(sizeForDiameter(15.7)).toEqual({ kind: "size", us: 5, index: 0 });
+    expect(sizeForDiameter(16.4)).toEqual({ kind: "size", us: 6, index: 1 });
+    expect(sizeForDiameter(17.0)).toEqual({ kind: "size", us: 7, index: 2 });
+    expect(sizeForDiameter(18.2)).toEqual({ kind: "size", us: 8, index: 3 });
+    expect(sizeForDiameter(19.3)).toEqual({ kind: "size", us: 9, index: 4 });
+  });
+
+  it("is the nearest US size to a finger's circumference (the thread)", () => {
+    expect(sizeForCircumference(52)).toMatchObject({ us: 6 });
+    expect(sizeForCircumference(54.4)).toMatchObject({ us: 7 });
+    expect(sizeForCircumference(57.5)).toMatchObject({ us: 8 });
+  });
+
+  it("goes to WhatsApp outside US 5 to 9", () => {
+    expect(sizeForDiameter(15.2)).toEqual({ kind: "below" });
+    expect(sizeForDiameter(19.5)).toEqual({ kind: "above" });
+    expect(sizeForCircumference(46)).toEqual({ kind: "below" });
+    expect(sizeForCircumference(63)).toEqual({ kind: "above" });
+    for (const url of [outsideSizeWhatsApp("about 20 mm across"), betweenSizesWhatsApp(), ringInSizeWhatsApp(7)]) {
+      expect(url.startsWith("https://wa.me/919561557935?text=")).toBe(true);
+    }
+    expect(decodeURIComponent(outsideSizeWhatsApp("about 20 mm across"))).toMatch(/outside US 5 to 9 \(about 20 mm across\)/);
+  });
+});
+
+describe("the circle", () => {
+  it("steps through the chart, with one stop past each end", () => {
+    expect(CIRCLE_STOPS_MM).toHaveLength(7);
+    expect(CIRCLE_STOPS_MM.slice(1, 6)).toEqual([15.7, 16.5, 17.3, 18.1, 19.0]);
+    expect(matchForStop(0)).toEqual({ kind: "below" });
+    expect(matchForStop(2)).toMatchObject({ us: 6 });
+    expect(matchForStop(6)).toEqual({ kind: "above" });
+    for (let stop = 0; stop < 7; stop++) expect(stopForDiameter(CIRCLE_STOPS_MM[stop])).toBe(stop);
+    expect(stopWords(2)).toBe("US 6 · 16.5 mm across");
+    expect(stopWords(0)).toBe("Smaller than US 5");
+  });
+});
+
+describe("the pinch", () => {
+  it("moves one size for each 36 px of spread, never leaping across the chart", () => {
+    expect(PINCH_PX_PER_STOP).toBe(36);
+    // The critic's case: fingers 150 px apart spread by 24% (36 px) from US 6 reach US 7, not past US 9.
+    expect(matchForStop(pinchStop(2, 150, 186))).toMatchObject({ us: 7 });
+    expect(pinchStop(2, 150, 160)).toBe(2);
+    expect(pinchStop(2, 150, 114)).toBe(1);
+    expect(pinchStop(2, 150, 150 + 3 * PINCH_PX_PER_STOP)).toBe(5);
+    // Held inside the chart's stops, and steady on a bad reading.
+    expect(pinchStop(2, 150, 900)).toBe(CIRCLE_STOPS_MM.length - 1);
+    expect(pinchStop(2, 150, 0)).toBe(0);
+    expect(pinchStop(3, 150, NaN)).toBe(3);
+  });
+});
+
+describe("the sizer's own sheet", () => {
+  const css = readFileSync(resolve(__dirname, "../../components/portal/sizer.css"), "utf8");
+  it("gives the handles a 44 px target and moves only transform", () => {
+    expect(css).toMatch(/\.ig-sz-thumb \{[^}]*width: 44px; height: 44px/);
+    expect(css).toMatch(/\.ig-cal-grip \{[^}]*width: 48px; height: 44px/);
+    // The stage runs edge to edge (out over the 16 px gutter) and refuses gestures that would move the page under the card.
+    expect(css).toMatch(/\.ig-cal-stage \{[^}]*width: calc\(100% \+ 32px\);[^}]*margin-inline: -16px;[^}]*touch-action: none/);
+    expect(css).toMatch(/\.ig-sz-step \{[^}]*width: 44px; height: 44px/);
+    const transitions = [...css.matchAll(/transition:\s*([^;]+);/g)].map((m) => m[1].trim());
+    for (const t of transitions) expect(t).toMatch(/^(transform\b|none$)/);
+  });
+});
