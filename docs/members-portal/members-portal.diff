@@ -0,0 +1,94 @@
+import { describe, expect, it } from "vitest";
+import { FIREFLIES, NIGHT_GROUND, NIGHT_INK, SKY_FROM, nextSkyChange, skyDraws, skyHour } from "./sky";
+
+/* An instant written as the owner writes times: in IST. */
+const ist = (clock: string, day = "2026-11-05") => new Date(`${day}T${clock}+05:30`);
+
+describe("garden hours", () => {
+  it("follows the clock in India, at every edge", () => {
+    expect(skyHour(ist("04:59:59"))).toBe("night");
+    expect(skyHour(ist("05:00:00"))).toBe("dawn");
+    expect(skyHour(ist("07:29:59"))).toBe("dawn");
+    expect(skyHour(ist("07:30:00"))).toBe("day");
+    expect(skyHour(ist("12:00:00"))).toBe("day");
+    expect(skyHour(ist("16:29:59"))).toBe("day");
+    expect(skyHour(ist("16:30:00"))).toBe("golden");
+    expect(skyHour(ist("18:29:59"))).toBe("golden");
+    expect(skyHour(ist("18:30:00"))).toBe("night");
+    expect(skyHour(ist("23:59:59"))).toBe("night");
+    expect(skyHour(ist("00:00:00"))).toBe("night");
+  });
+
+  it("reads Indian time whatever zone the phone is in", () => {
+    // 13:00 UTC is 18:30 in India: night in her garden, even on a phone set to London or New York.
+    expect(skyHour(new Date("2026-11-05T13:00:00Z"))).toBe("night");
+    expect(skyHour(new Date("2026-11-05T12:59:00Z"))).toBe("golden");
+    // 23:30 UTC on the 4th is 05:00 on the 5th in India.
+    expect(skyHour(Date.parse("2026-11-04T23:30:00Z"))).toBe("dawn");
+  });
+
+  it("knows when it next changes, across midnight too", () => {
+    expect(nextSkyChange(ist("12:00:00"))).toBe(ist("16:30:00").getTime());
+    expect(nextSkyChange(ist("16:29:59"))).toBe(ist("16:30:00").getTime());
+    expect(nextSkyChange(ist("16:30:00"))).toBe(ist("18:30:00").getTime());
+    expect(nextSkyChange(ist("21:15:42"))).toBe(ist("05:00:00", "2026-11-06").getTime());
+    expect(nextSkyChange(ist("02:00:00"))).toBe(ist("05:00:00").getTime());
+    expect(nextSkyChange(ist("05:00:00"))).toBe(ist("07:30:00").getTime());
+    for (const at of ["00:00:00", "04:59:00", "07:30:00", "18:29:30", "23:59:59"].map((c) => ist(c))) {
+      const next = nextSkyChange(at);
+      expect(next).toBeGreaterThan(at.getTime());
+      expect(skyHour(next)).not.toBe(skyHour(at));
+      expect(skyHour(next - 1)).toBe(skyHour(at));
+    }
+  });
+
+  it("starts each hour in order through the day", () => {
+    expect(SKY_FROM.dawn).toBeLessThan(SKY_FROM.day);
+    expect(SKY_FROM.day).toBeLessThan(SKY_FROM.golden);
+    expect(SKY_FROM.golden).toBeLessThan(SKY_FROM.night);
+  });
+
+  it("draws nothing over the ivory day, so nothing is fetched for it", () => {
+    expect(skyDraws("day")).toBe(false);
+    expect(["dawn", "golden", "night"].every((h) => skyDraws(h as "dawn"))).toBe(true);
+  });
+
+  it("keeps to twelve fireflies", () => {
+    expect(FIREFLIES).toBe(12);
+  });
+});
+
+/* WCAG relative luminance and contrast. */
+const channel = (v: number) => {
+  const c = v / 255;
+  return c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
+};
+const luminance = (hex: string) => {
+  const n = Number.parseInt(hex.slice(1), 16);
+  return 0.2126 * channel((n >> 16) & 255) + 0.7152 * channel((n >> 8) & 255) + 0.0722 * channel(n & 255);
+};
+const contrast = (a: string, b: string) => {
+  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
+  return (hi + 0.05) / (lo + 0.05);
+};
+
+describe("the night garden's words", () => {
+  it("stands on ink", () => {
+    expect(NIGHT_GROUND).toBe("#1A1614");
+  });
+
+  it.each(Object.entries(NIGHT_INK))("holds %s at 4.5:1 or more on the night ground", (_name, colour) => {
+    expect(contrast(colour, NIGHT_GROUND)).toBeGreaterThanOrEqual(4.5);
+  });
+
+  /* The next drop's day ("Opens tomorrow · 8 pm") stands on its own ivory slip, never on the ink: the slip is opaque. */
+  it("keeps the next drop's day on an opaque ivory slip", async () => {
+    const { readFileSync } = await import("node:fs");
+    const { resolve } = await import("node:path");
+    const css = readFileSync(resolve(__dirname, "../../pages/members/members.css"), "utf8");
+    const rule = css.match(/\.ig-dropbud-day\s*\{([^}]*)\}/)?.[1] ?? "";
+    expect(rule).toMatch(/background:\s*var\(--nf-ivory\);/);
+    expect(rule).toMatch(/color:\s*var\(--nf-gold-text\);/);
+    expect(contrast("#80612A", "#FBF3EC")).toBeGreaterThanOrEqual(4.5);
+  });
+});
