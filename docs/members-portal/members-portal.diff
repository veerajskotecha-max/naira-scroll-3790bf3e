+    const filters: ((r: Stored) => boolean)[] = [];
+    let ordered: { column: string; ascending: boolean } | null = null;
+    let cap = Infinity;
+    const q: DbQuery = {
+      select: () => q,
+      eq: (c, v) => (filters.push((r) => test1(r, c, "eq", v)), q),
+      neq: (c, v) => (filters.push((r) => test1(r, c, "neq", v)), q),
+      gte: (c, v) => (filters.push((r) => test1(r, c, "gte", v)), q),
+      lte: (c, v) => (filters.push((r) => test1(r, c, "lte", v)), q),
