diff --git a/src/pages/members/members.css b/src/pages/members/members.css
new file mode 100644
index 0000000..4c5a4db
--- /dev/null
+++ b/src/pages/members/members.css
@@ -0,0 +1,488 @@
+/*
+  The Inner Garden. Imported only by MembersRoute, so Vite ships this as the
+  route's own stylesheet: nothing here reaches the product page, the bag or
+  the global CSS. Colours come from the brand tokens; the vellum pane and the
+  flower colours are portal-local. Radius 0 throughout. Motion moves only
+  transform, opacity and stroke-dashoffset.
+*/
+
+.ig-root {
+  --ig-vellum: rgb(255 248 245 / 0.86);
+  --ig-line: rgb(var(--nf-ink-rgb) / 0.1);
+  --ig-gold-line: rgb(var(--nf-gold-rgb) / 0.55);
+  background: var(--nf-surface);
+  color: var(--nf-text);
+}
+.ig-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
+.ig-main { min-height: 100svh; }
+
+/* ── type ───────────────────────────────────────────── */
+.ig-eyebrow {
+  margin: 0;
+  font-family: var(--nf-font-label);
+  font-size: 10px;
+  letter-spacing: var(--nf-track-28);
+  text-transform: uppercase;
+  color: var(--nf-gold-text);
+}
+.ig-h1 {
+  margin: 0.45rem 0 0;
+  font-family: var(--nf-font-editorial);
+  font-weight: 400;
+  font-size: clamp(2.3rem, 10vw, 3.3rem);
+  line-height: 1.04;
+}
+.ig-h1 em { font-style: italic; color: var(--nf-gold-text); }
+.ig-h1:focus { outline: none; }
+.ig-lede {
+  max-width: 30rem;
+  margin: 0.75rem auto 0;
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 1.1rem;
+  line-height: 1.55;
+  color: rgb(var(--nf-ink-rgb) / 0.72);
+}
+.ig-h2 {
+  display: block;
+  margin: 0;
+  font-family: var(--nf-font-editorial);
+  font-weight: 500;
+  font-size: 1.5rem;
+  line-height: 1.2;
+}
+.ig-fineprint {
+  margin: 0.4rem 0 0;
+  font-family: var(--nf-font-label);
+  font-size: 12px;
+  line-height: 1.6;
+  color: rgb(var(--nf-ink-rgb) / 0.64);
+}
+.ig-error { margin: 0; font-family: var(--nf-font-label); font-size: 12px; color: #a44a34; }
+
+/* ── buttons ────────────────────────────────────────── */
+.ig-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 0.5rem;
+  width: 100%;
+  max-width: 360px;
+  height: 50px;
+  padding: 0 1rem;
+  border: 1px solid var(--nf-ink);
+  background: var(--nf-ink);
+  color: var(--nf-ivory);
+  font-family: var(--nf-font-label);
+  font-size: 11.5px;
+  font-weight: 500;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  text-decoration: none;
+  cursor: pointer;
+  transition: background-color 0.2s ease, transform 0.25s var(--nf-ease-reveal);
+}
+.ig-btn:hover { background: rgb(var(--nf-ink-rgb) / 0.88); }
+.ig-btn:active { transform: scale(0.98); }
+.ig-btn:disabled { opacity: 0.6; pointer-events: none; }
+.ig-btn--outline { background: transparent; color: var(--nf-ink); }
+.ig-link,
+.ig-quiet {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 0.25rem;
+  border: 0;
+  background: none;
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: var(--nf-ink);
+  text-decoration: underline;
+  text-decoration-color: var(--nf-accent);
+  text-underline-offset: 6px;
+  cursor: pointer;
+}
+.ig-quiet { font-size: 10.5px; color: rgb(var(--nf-ink-rgb) / 0.72); }
+
+/* ── page columns ───────────────────────────────────── */
+.ig-gate-page,
+.ig-home {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-head { width: 100%; }
+.ig-section { width: 100%; margin-top: 2.75rem; text-align: left; }
+.ig-section > .ig-h2 { padding-bottom: 0.6rem; margin-bottom: 1rem; border-bottom: 1px solid var(--ig-gold-line); }
+
+/* ── the gate ───────────────────────────────────────── */
+.ig-gate { position: relative; display: flex; aspect-ratio: 1; }
+.ig-leaf { position: relative; width: 50%; height: 100%; }
+.ig-leaf--left { transform-origin: 0 50%; }
+.ig-leaf--right { transform-origin: 100% 50%; }
+.ig-leaf-art { display: block; width: 100%; height: 100%; overflow: visible; }
+.ig-leaf--right .ig-leaf-art { transform: scaleX(-1); }
+.ig-iron,
+.ig-iron-under { fill: none; stroke-linecap: round; stroke-linejoin: round; }
+.ig-iron { stroke: var(--nf-accent-strong); }
+.ig-iron .b { stroke-width: 2.2; }
+.ig-iron .f { stroke-width: 1.15; }
+.ig-iron .bud { fill: var(--nf-blush); stroke-width: 0.8; }
+.ig-iron-under { display: none; stroke: var(--nf-ivory); stroke-opacity: 0.6; }
+.ig-gate--sage .ig-iron-under { display: inline; }
+.ig-gate--sage .ig-iron-under .b { stroke-width: 4.8; }
+.ig-gate--sage .ig-iron-under .f { stroke-width: 3.2; }
+.ig-gate--sage .ig-iron-under .bud { fill: none; stroke-width: 3; }
+.ig-latch {
+  position: absolute;
+  left: 50%;
+  top: 54.45%;
+  width: 11.6%;
+  transform: translate(-50%, -50%);
+}
+.ig-latch .ig-flower { display: block; width: 100%; height: auto; }
+.ig-flower { overflow: visible; }
+
+.ig-gate-scene {
+  position: relative;
+  width: min(100%, 420px, 35vh * 1.048);
+  width: min(100%, 420px, 35svh * 1.048);
+  aspect-ratio: 390 / 372;
+  margin: 0 auto 1.1rem;
+  overflow: hidden;
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+  user-select: none;
+}
+.ig-gate-scene .ig-gate {
+  position: absolute;
+  left: 50%;
+  bottom: 8%; /* the foot rail on the bed's soil line */
+  width: min(82%, 340px);
+  transform: translateX(-50%);
+}
+.ig-gate-scene .ig-bed { position: absolute; left: 0; right: 0; bottom: 0; }
+.ig-bed--behind { opacity: 0.42; }
+.ig-gate-cta { margin-top: 1.25rem; }
+.ig-promises {
+  display: grid;
+  gap: 0.6rem;
+  margin: 1.6rem 0 0.5rem;
+  padding: 0;
+  list-style: none;
+}
+.ig-promises li,
+.ig-growing li {
+  position: relative;
+  font-family: var(--nf-font-editorial);
+  font-size: 1.12rem;
+  line-height: 1.5;
+}
+.ig-promises li { display: flex; align-items: center; justify-content: center; gap: 0.7rem; }
+.ig-promises li::before {
+  content: "";
+  flex: none;
+  width: 7px;
+  height: 7px;
+  background: var(--nf-blush);
+  box-shadow: 0 0 0 1px var(--ig-gold-line);
+  transform: rotate(45deg);
+}
+.ig-growing li::before {
+  content: "";
+  position: absolute;
+  left: 0.15rem;
+  top: 0.62em;
+  width: 7px;
+  height: 7px;
+  background: var(--nf-blush);
+  box-shadow: 0 0 0 1px var(--ig-gold-line);
+  transform: rotate(45deg);
+}
+.ig-or {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  width: 100%;
+  max-width: 360px;
+  margin: 1.9rem 0 0.6rem;
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: var(--nf-track-28);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.64);
+}
+.ig-or::before,
+.ig-or::after { content: ""; flex: 1; height: 1px; background: var(--ig-line); }
+.ig-join { display: flex; justify-content: center; width: 100%; max-width: 360px; margin-bottom: 0.5rem; }
+/* The list's button, quieter than the gate's own: one solid button per screen. */
+.ig-join button[type="submit"] { background: transparent; color: var(--nf-ink); border: 1px solid rgb(var(--nf-ink-rgb) / 0.6); }
+
+/* ── the doors ──────────────────────────────────────── */
+.ig-doors {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  overflow: hidden;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+.ig-curtain { position: absolute; inset: 0; background: var(--nf-sage); will-change: transform; }
+.ig-tassel { position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); }
+.ig-doors-stage {
+  position: absolute;
+  inset: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 1.1rem;
+  padding: 96px 16px 0;
+}
+.ig-doors-stage { will-change: transform; }
+.ig-doors .ig-gate { width: min(84vw, 380px); perspective: 900px; }
+.ig-doors .ig-leaf { will-change: transform, opacity; }
+/* The flower draws at full size, then rests in the latch at .38, a key. */
+.ig-doors-key {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  width: calc(100% / 0.38);
+  transform: translate(-50%, -50%) scale(0.38);
+  will-change: transform, opacity;
+}
+.ig-doors-glint { position: absolute; left: 62%; top: 4%; width: 22%; height: auto; opacity: 0; overflow: visible; }
+.ig-doors-words { text-align: center; }
+.ig-doors-greet {
+  margin: 0;
+  font-family: var(--nf-font-editorial);
+  font-size: clamp(1.8rem, 7.5vw, 2.6rem);
+  line-height: 1.1;
+  color: var(--nf-ink);
+}
+.ig-doors-greet em { font-style: italic; }
+.ig-doors-hint {
+  margin: 0.6rem 0 0;
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: var(--nf-track-28);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.7);
+}
+.ig-petal { position: absolute; pointer-events: none; will-change: transform, opacity; }
+/* The Doors' petals fall on after the Doors have gone: same tier, painted above them. */
+.ig-petal-layer { position: fixed; inset: 0; z-index: 40; overflow: hidden; pointer-events: none; }
+
+/* ── the garden bed ─────────────────────────────────── */
+.ig-bed-wrap { position: relative; width: 100%; margin-top: 0.75rem; }
+.ig-bed-wrap::before {
+  content: "";
+  position: absolute;
+  inset: 6% 0 4%;
+  background: url("../../assets/background_image_flora.webp") center / 520px auto repeat;
+  opacity: 0.07;
+  pointer-events: none;
+}
+.ig-bed {
+  position: relative;
+  width: 100%;
+  aspect-ratio: 390 / 560;
+  overflow: hidden;
+  touch-action: manipulation;
+  -webkit-tap-highlight-color: transparent;
+  user-select: none;
+}
+.ig-bed-ground { position: absolute; inset: 0; width: 100%; height: 100%; }
+.ig-soil { fill: none; stroke: var(--nf-accent); stroke-width: 1; }
+.ig-arbour-line { fill: none; stroke: var(--nf-accent); stroke-width: 1.2; opacity: 0.85; }
+.ig-arbour-line--fine { stroke-width: 0.7; opacity: 0.55; }
+.ig-arbour-tick { stroke: var(--nf-accent); stroke-width: 0.8; opacity: 0.6; }
+.ig-band { position: absolute; inset: 0; pointer-events: none; }
+.ig-plant { position: absolute; transform-origin: 50% 100%; }
+.ig-plant--naira,
+.ig-plant--stone { pointer-events: auto; }
+.ig-sway,
+.ig-still { width: 100%; height: 100%; transform-origin: 50% 100%; }
+.ig-sway { will-change: transform; }
+/* The outer drawing only: a stone plant's head is a nested <svg> sized by its own attributes. */
+.ig-sway > svg,
+.ig-still > svg { display: block; width: 100%; height: 100%; overflow: visible; }
+.ig-bed-label {
+  position: absolute;
+  top: 93.4%;
+  margin: 0;
+  padding-top: 5px;
+  transform: translateX(-50%);
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 13px;
+  line-height: 1.2;
+  white-space: nowrap;
+  text-align: center;
+}
+.ig-bed-label span {
+  display: block;
+  font-family: var(--nf-font-label);
+  font-style: normal;
+  font-size: 9.5px;
+  letter-spacing: var(--nf-track-24);
+  text-transform: uppercase;
+  color: var(--nf-gold-text);
+}
+.ig-bloom { position: absolute; pointer-events: none; will-change: transform, opacity; }
+.ig-bloom svg { position: absolute; inset: 0; display: block; overflow: visible; }
+.ig-bloom-in { position: absolute; inset: 0; will-change: transform; }
+.ig-glint { transform-box: fill-box; transform-origin: center; }
+.ig-stone-budcap { opacity: 0; }
+
+/* ── today and what's growing ───────────────────────── */
+.ig-card-link {
+  display: flex;
+  align-items: center;
+  gap: 1rem;
+  padding: 1rem 1.1rem;
+  border: 1px solid var(--ig-gold-line);
+  background: var(--ig-vellum);
+  color: inherit;
+  text-decoration: none;
+  transition: border-color 0.25s ease;
+}
+.ig-card-link:hover { border-color: var(--nf-accent-strong); }
+.ig-card-text { display: flex; flex-direction: column; gap: 0.2rem; }
+.ig-card-title { margin: 0; font-family: var(--nf-font-editorial); font-size: 1.4rem; line-height: 1.2; }
+.ig-card-more {
+  margin-top: 0.2rem;
+  font-family: var(--nf-font-label);
+  font-size: 10.5px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: var(--nf-gold-text);
+}
+.ig-growing { margin: 0; padding: 0; list-style: none; }
+.ig-growing li { padding: 0.6rem 0 0.6rem 1.4rem; border-bottom: 1px solid var(--ig-line); }
+.ig-growing li::before { top: 1.25rem; }
+.ig-growing strong { font-weight: 500; }
+
+.ig-card-link + .ig-card-link { margin-top: 0.6rem; }
+.ig-card-bud { flex: none; }
+.ig-wait { padding: 3rem 16px; text-align: center; }
+
+/* the next drop's sealed bud, in the back row */
+.ig-dropbud {
+  position: absolute;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 2px;
+  pointer-events: auto;
+  text-decoration: none;
+  -webkit-tap-highlight-color: transparent;
+}
+.ig-dropbud svg { display: block; width: 100%; height: auto; overflow: visible; }
+.ig-dropbud-day {
+  padding: 1px 5px;
+  border: 1px solid var(--ig-gold-line);
+  background: var(--nf-ivory);
+  font-family: var(--nf-font-label);
+  font-size: 9px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  white-space: nowrap;
+  color: var(--nf-gold-text);
+}
+
+/* ── the garden path ────────────────────────────────── */
+.ig-nav {
+  position: sticky;
+  bottom: 0;
+  z-index: 39;
+  padding-bottom: env(safe-area-inset-bottom);
+  border-top: 1px solid var(--ig-gold-line);
+  background: rgb(var(--nf-ivory-rgb) / 0.96);
+}
+.ig-nav ul { display: flex; max-width: 560px; margin: 0 auto; padding: 0; list-style: none; }
+.ig-nav li { flex: 1; }
+.ig-nav-link {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 3px;
+  min-height: 58px;
+  font-family: var(--nf-font-label);
+  font-size: 10px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.7);
+  text-decoration: none;
+}
+.ig-nav-link.is-here { color: var(--nf-ink); }
+.ig-nav-link.is-here::after {
+  content: "";
+  position: absolute;
+  top: -1px;
+  left: 32%;
+  right: 32%;
+  height: 2px;
+  background: var(--nf-accent-strong);
+}
+.ig-nav-petal { fill: none; stroke: currentColor; stroke-width: 1.1; }
+.ig-nav-line { fill: none; stroke: currentColor; stroke-width: 1.1; stroke-linecap: round; }
+.ig-nav-core { fill: var(--nf-accent); }
+.is-here .ig-nav-petal { fill: var(--nf-blush); stroke: var(--nf-accent-strong); }
+
+/* ── the vellum form and its field (her stone, the arrival repair, her fit) ── */
+.ig-birthday {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.75rem;
+  width: 100%;
+  max-width: 360px;
+  margin: 2rem auto 0;
+  padding: 1.5rem 1.25rem;
+  border: 1px solid var(--ig-gold-line);
+  background: var(--ig-vellum);
+}
+.ig-input {
+  width: 100%;
+  height: 50px;
+  padding: 0 0.75rem;
+  border: 0;
+  border-bottom: 1px solid rgb(var(--nf-ink-rgb) / 0.3);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 16px;
+  color: var(--nf-ink);
+  text-align: center;
+}
+.ig-input:focus { border-bottom-color: var(--nf-accent-strong); }
+
+/* A piece's price and stock: Your stone's card, a drop's pieces, the drawer and her fit's cards. */
+.ig-price { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0.6rem; margin: 0; font-family: var(--nf-font-label); font-size: 16px; }
+.ig-price s { font-size: 13px; color: rgb(var(--nf-ink-rgb) / 0.62); }
+.ig-stock { font-size: 10px; letter-spacing: var(--nf-track-20); text-transform: uppercase; color: var(--nf-cta); }
+.ig-stock--out { color: rgb(var(--nf-ink-rgb) / 0.6); }
+
+/* Short phones (320 x 568): the gate gives up a little height so its one action stays on the first screen. */
+@media (max-height: 620px) {
+  .ig-gate-scene { width: min(100%, 30vh * 1.048); width: min(100%, 30svh * 1.048); }
+  .ig-gate-cta { margin-top: 1rem; }
+}
+
+@media (min-width: 768px) {
+  .ig-gate-page,
+  .ig-home { padding-top: 2rem; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ig-btn,
+  .ig-card-link { transition: none; }
+}
