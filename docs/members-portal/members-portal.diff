@@ -0,0 +1,388 @@
+import { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import PieceCard from "@/components/portal/PieceCard";
+import FitsYou from "@/components/portal/FitsYou";
+import LaidOut from "@/components/portal/LaidOut";
+import SinceLastVisit from "@/components/portal/SinceLastVisit";
+import KeptNote from "@/components/portal/KeptNote";
+import PetalSpot from "@/components/portal/PetalSpot";
+import { burstPetals } from "@/components/portal/PetalBurst";
+import { PETAL_HUE, PETAL_IDS } from "@/components/portal/PetalSymbols";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, quietButton, textLink } from "@/components/portal/styles";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { useWishlist } from "@/contexts/WishlistContext";
+import type { JewelPiece } from "@/data/jewellery";
+import { applyPatch, restoreHandle, saveHandle, unsaveHandle } from "@/lib/portal/roomChanges";
+import { deviceHandles, heartsFor, mergeSaved } from "@/lib/portal/wishlistSync";
+import { freshShoots, sinceShoots, useNewIn } from "@/lib/portal/newIn";
+import { serverNow } from "@/lib/portal/clock";
+import { presetFor } from "@/lib/portal/fit";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import "./drawer.css";
+
+/*
+  /members/drawer: the Jewel drawer. The hearts on this phone (the shop's own
+  wishlist, its code untouched) and the pieces saved to her account (at most
+  24 handles) kept as one list, merged once the shop's live catalogue has
+  answered (lib/portal/wishlistSync): a new phone starts with everything she
+  saved on another. Each piece shows its live price, Available or Sold out,
+  whether it comes in her size (or the sizes the shop has), and Add to bag
+  with her size and month already chosen. Below: what goes with them ("Laid
+  out for you"), and what the shop has added since she was last here. An
+  empty drawer begins with the newest arrivals.
+
+  The merge is written as a change to her account's own fresh copy (re-run on
+  it at write time), so a piece saved on another phone in the last hour is
+  never overwritten by this phone's older copy. Hearts this phone holds that
+  the drawer has no room for stay hearted here, and are never taken off for
+  it; a piece let go to make room is said so.
+
+  Keep and Take out answer where she tapped: a kept card stays in place and
+  says "Kept in your drawer" (with a small bloom), a piece taken out leaves a
+  line with Undo, and focus goes to that answer. Its heart leaves this phone
+  only when she leaves the room, so Undo never has to heart it again.
+
+  Hearts are put back on this phone only by the owner's switch: the
+  wishlist's toggleItem tells Meta "AddToWishlist" for each heart it adds
+  (pixel and CAPI), and a member arriving on a new phone has not just added
+  anything. Saving here writes her account alone. (REBUILD_HEARTS_ON_ARRIVAL
+  turns the rebuild on once the owner approves those events; until then
+  nothing in the portal adds a heart.)
+*/
+
+const REBUILD_HEARTS_ON_ARRIVAL = false;
+
+const same = (a: readonly string[], b: readonly string[]) => a.length === b.length && a.every((h, i) => h === b[i]);
+const sameSet = (a: readonly string[], b: readonly string[]) => a.length === b.length && a.every((h) => b.includes(h));
+
+type Out = { handle: string; index: number; name: string };
+
+/* An empty drawer, drawn in gold line, a sprig laid in it: it draws itself once (final at once under reduced motion). */
+const EmptyDrawerArt = () => {
+  const ref = useRef<SVGSVGElement>(null);
+  useLayoutEffect(() => {
+    if (stillMotion()) return;
+    ref.current?.querySelectorAll("path").forEach((path, i) => play(path, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 900, delay: 120 + i * 90, easing: EASE_REVEAL, fill: "backwards" }));
+  }, []);
+  return (
+    <svg ref={ref} className="ig-drawer-empty" viewBox="0 0 160 96" aria-hidden>
+      <path d="M14 40H146V88H14Z" pathLength={1} />
+      <path d="M14 40L30 26H130L146 40" pathLength={1} />
+      <path d="M66 64H94" pathLength={1} />
+      <path d="M44 40C58 28 74 20 98 14" pathLength={1} className="ig-drawer-empty-sprig" />
+      <path d="M60 31C55 24 56 18 62 15C66 21 65 27 60 31ZM76 24C73 17 76 11 82 10C84 16 82 21 76 24Z" pathLength={1} className="ig-drawer-empty-sprig" />
+    </svg>
+  );
+};
+
+const Drawer = () => {
+  const { naira, changeMeta, savedSync: sync, keepSavedSync: keepSync, metaProblem, retryMeta, month, addToBag, bagBusy, preview, since, firstVisit } = useMember();
+  const wishlist = useWishlist();
+  const { jewellery, isLive, isLoading } = useLiveJewellery();
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const rootRef = useRef<HTMLDivElement>(null);
+  const us = naira.ring?.us ?? null;
+  const metal = naira.metal;
+
+  const catalogue = useMemo(() => (isLive ? new Set(jewellery.map((p) => p.handle)) : null), [isLive, jewellery]);
+  const byHandle = useMemo(() => new Map(jewellery.map((p) => [p.handle, p])), [jewellery]);
+  const device = useMemo(() => deviceHandles(wishlist.items), [wishlist.items]);
+  // What this phone and her account last agreed on, and the hearts here her account had no room for: the portal's own (MembersRoute), shared with every room that can let a piece go.
+  // Taken out this visit: a line with Undo where each was, and its heart held on this phone until she leaves.
+  const [outs, setOuts] = useState<Out[]>([]);
+  // Kept this visit, with the line saying what was let go to make room ("" when nothing was).
+  const [kept, setKept] = useState<Record<string, string>>({});
+  const [answer, setAnswer] = useState<{ kind: "kept" | "out" | "back"; handle: string; tick: number } | null>(null);
+  const held = useMemo(() => new Set(outs.map((o) => o.handle)), [outs]);
+  const plan = useMemo(() => mergeSaved(device, naira.saved, sync.h, catalogue, sync.x), [device, naira.saved, sync, catalogue]);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  /* Once the shop has answered: her account takes the merged list, a heart
+     taken out of the drawer on another phone leaves this one, and the two
+     remember what they agreed on. Nothing is decided while the shop is
+     unreachable. */
+  const { toggleItem, items } = wishlist;
+  useEffect(() => {
+    if (!isLive) return;
+    let lost: string[] = [];
+    if (!same(plan.saved, naira.saved)) {
+      // Merged again over her account's own fresh copy when it is written.
+      const result = changeMeta((n) => applyPatch(n, { saved: mergeSaved(device, n.saved, sync.h, catalogue, sync.x).saved }));
+      // Hearts here the account could not keep (its 1.2 KB cap): they stay hearted, spilled, never taken off.
+      if (result.ok) lost = (result.dropped ?? []).filter((h) => plan.saved.includes(h) && device.includes(h));
+    }
+    for (const handle of plan.removeFromDevice) {
+      if (held.has(handle)) continue;
+      const heart = items.find((i) => i.id === handle);
+      if (heart) toggleItem(heart);
+    }
+    const h = [...plan.agreed, ...sync.h.filter((x) => held.has(x) && !plan.agreed.includes(x))].filter((x) => !lost.includes(x));
+    const x = [...plan.spill, ...lost.filter((l) => !plan.spill.includes(l))];
+    if (!sameSet(h, sync.h) || !sameSet(x, sync.x)) keepSync(h, x);
+  }, [isLive, plan, naira.saved, sync, changeMeta, items, toggleItem, device, catalogue, held, keepSync]);
+
+  const heartHere = useCallback(() => {
+    for (const heart of heartsFor(plan.missingOnDevice, jewellery)) if (!wishlist.isWishlisted(heart.id)) toggleItem(heart);
+  }, [plan.missingOnDevice, jewellery, wishlist, toggleItem]);
+
+  useEffect(() => {
+    if (REBUILD_HEARTS_ON_ARRIVAL && isLive && plan.missingOnDevice.length) heartHere();
+  }, [isLive, plan.missingOnDevice.length, heartHere]);
+
+  /* Leaving the room: a piece taken out (and not put back) leaves this phone's hearts too. A removal tells Meta nothing. */
+  const leaving = useRef({ outs, items, toggleItem });
+  leaving.current = { outs, items, toggleItem };
+  useEffect(
+    () => () => {
+      const { outs: gone, items: hearts, toggleItem: toggle } = leaving.current;
+      for (const o of gone) {
+        const heart = hearts.find((i) => i.id === o.handle);
+        if (heart) toggle(heart);
+      }
+    },
+    [],
+  );
+
+  const nameOf = useCallback((h: string) => byHandle.get(h)?.name ?? "a piece", [byHandle]);
+
+  const keep = useCallback(
+    (handle: string) => {
+      const result = changeMeta(saveHandle(handle));
+      if (result.ok === false) return;
+      const pushed = (result.dropped ?? []).filter((h) => h !== handle);
+      const here = pushed.filter((h) => device.includes(h));
+      // A piece let go to make room that is hearted here stays hearted, outside the drawer.
+      if (here.length) keepSync(sync.h.filter((h) => !here.includes(h)), [...sync.x, ...here.filter((h) => !sync.x.includes(h))]);
+      const names = pushed.map(nameOf).join(" and ");
+      const note = pushed.length ? `To make room, ${names} ${pushed.length > 1 ? "were" : "was"} let go${here.length ? ", still hearted on this phone" : ""}.` : "";
+      setKept((k) => ({ ...k, [handle]: note }));
+      setAnswer((a) => ({ kind: "kept", handle, tick: (a?.tick ?? 0) + 1 }));
+    },
+    [changeMeta, device, keepSync, sync, nameOf],
+  );
+
+  const takeOut = (piece: JewelPiece) => {
+    const index = naira.saved.indexOf(piece.handle);
+    if (changeMeta(unsaveHandle(piece.handle)).ok === false) return;
+    setOuts((o) => [...o.filter((x) => x.handle !== piece.handle), { handle: piece.handle, index: Math.max(0, index), name: piece.name }]);
+    setAnswer((a) => ({ kind: "out", handle: piece.handle, tick: (a?.tick ?? 0) + 1 }));
+  };
+
+  const undo = (o: Out) => {
+    if (changeMeta(restoreHandle(o.handle, o.index)).ok === false) return;
+    setOuts((list) => list.filter((x) => x.handle !== o.handle));
+    setAnswer((a) => ({ kind: "back", handle: o.handle, tick: (a?.tick ?? 0) + 1 }));
+  };
+
+  /* Focus goes to the answer: the kept line (and a small bloom from it), the Undo, or the piece put back. */
+  useEffect(() => {
+    const root = rootRef.current;
+    if (!answer || !root) return;
+    // Handles are lower-case letters, digits and hyphens: safe in a selector as they are.
+    const at = (sel: string) => root.querySelector<HTMLElement>(`[${sel}="${answer.handle}"]`);
+    if (answer.kind === "out") {
+      at("data-undo")?.focus({ preventScroll: true });
+      return;
+    }
+    if (answer.kind === "back") {
+      at("data-piece")?.querySelector<HTMLElement>(".ig-pc-name a")?.focus({ preventScroll: true });
+      return;
+    }
+    const note = at("data-kept");
+    if (!note) return;
+    note.focus({ preventScroll: true });
+    const card = note.closest<HTMLElement>(".ig-pc");
+    if (!card) return;
+    const from = note.getBoundingClientRect();
+    const box = card.getBoundingClientRect();
+    burstPetals(card, from.left - box.left + 12, from.top - box.top + from.height / 2, { count: 10, spread: 70, ids: [PETAL_HUE, PETAL_IDS[0], PETAL_IDS[3]], color: "#FFBDA8", size: [7, 13] });
+  }, [answer]);
+
+  const saved = isLive ? plan.saved : naira.saved;
+  // Newest first, with a line where each piece taken out this visit was.
+  const shown = useMemo(() => {
+    const list: string[] = [...saved];
+    for (const o of outs) if (!list.includes(o.handle)) list.splice(Math.min(o.index, list.length), 0, o.handle);
+    return list.reverse();
+  }, [saved, outs]);
+  const pieces = isLive ? shown.flatMap((h) => (byHandle.has(h) || held.has(h) ? [h] : [])) : [];
+
+  /* An empty drawer begins with the newest arrivals (the same small query New
+     in the garden reads), laid out once for the visit, so a kept one stays
+     in place. Those already shown under "Since you were last here" are left out. */
+  const [startedEmpty, setStartedEmpty] = useState<boolean | null>(null);
+  useEffect(() => {
+    if (isLive && startedEmpty === null) setStartedEmpty(plan.saved.length === 0);
+  }, [isLive, startedEmpty, plan.saved.length]);
+  const newIn = useNewIn(Boolean(startedEmpty));
+  const [fresh, setFresh] = useState<JewelPiece[] | null>(null);
+  useEffect(() => {
+    if (!startedEmpty || fresh || !newIn.data || !isLive) return;
+    const now = serverNow();
+    const sinceHandles = new Set(since ? sinceShoots(newIn.data, since, now, jewellery).map((s) => s.piece.handle) : []);
+    setFresh(freshShoots(newIn.data, now, jewellery).filter((s) => !sinceHandles.has(s.piece.handle)).slice(0, 6).map((s) => s.piece));
+  }, [startedEmpty, fresh, newIn.data, isLive, since, jewellery]);
+  // "Laid out for you" goes with saved pieces: shown once there is one, and kept for the visit.
+  const [laid, setLaid] = useState(false);
+  useEffect(() => {
+    if (isLive && saved.length > 0) setLaid(true);
+  }, [isLive, saved.length]);
+
+  const empty = isLive && pieces.length === 0;
+  const hasFresh = Boolean(fresh && fresh.length);
+
+  return (
+    <PortalShell title="Jewel drawer" description="Your saved pieces in the Inner Garden, Naira Flore's members' portal.">
+      <div ref={rootRef} className="ig-drawer">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            The jewel <em>drawer</em>
+          </h1>
+          <p className="ig-lede">The pieces you saved, kept on your account and on every phone you sign in on.</p>
+        </div>
+
+        <section className="ig-section" aria-labelledby="ig-saved">
+          {/* A petal of the Naira flower, tucked at the end of the heading (Phase 6, Gathered). */}
+          <PetalSpot piece="drawer">
+            <h2 id="ig-saved" className="ig-h2">
+              Your pieces
+            </h2>
+          </PetalSpot>
+          {!isLive ? (
+            isLoading ? (
+              <p className="ig-fineprint" role="status">
+                Opening your drawer…
+              </p>
+            ) : (
+              <p className="ig-fineprint">
+                We couldn't reach the shop just now, so your pieces are waiting.{" "}
+                <Link className="ig-link" to="/jewellery">
+                  See the shop
+                </Link>
+              </p>
+            )
+          ) : empty ? (
+            <div className="ig-drawer-empty-wrap">
+              <EmptyDrawerArt />
+              <p className="ig-fineprint">
+                {hasFresh
+                  ? "Your drawer is empty. Keep a piece from the newest arrivals below, or tap the heart on any piece in the shop."
+                  : "Your drawer is empty. Tap the heart on any piece in the shop, and it is kept here."}{" "}
+                <Link className={textLink} to="/jewellery">
+                  See the shop
+                </Link>
+              </p>
+            </div>
+          ) : (
+            <>
+              <ul className="ig-pcs">
+                {pieces.map((handle) => {
+                  const out = outs.find((o) => o.handle === handle);
+                  if (out)
+                    return (
+                      <li key={handle}>
+                        <p className="ig-drawer-out">
+                          {out.name}: taken out of your drawer.{" "}
+                          <button type="button" className={quietButton} data-undo={handle} aria-label={`Undo: put ${out.name} back in your drawer`} onClick={() => undo(out)}>
+                            Undo
+                          </button>
+                        </p>
+                      </li>
+                    );
+                  const piece = byHandle.get(handle) as JewelPiece;
+                  const preset = presetFor(piece, us, metal, month);
+                  return (
+                    <li key={handle} data-piece={handle}>
+                      <PieceCard
+                        piece={piece}
+                        preset={preset}
+                        note={<FitsYou fit={preset.fit} us={us} />}
+                        extra={(named) => (
+                          <button type="button" className={quietButton} onClick={() => takeOut(piece)} aria-describedby={named}>
+                            Take out of the drawer
+                          </button>
+                        )}
+                        preview={preview}
+                        bagBusy={bagBusy}
+                        onAdd={addToBag}
+                      />
+                    </li>
+                  );
+                })}
+              </ul>
+              {/* Phase 6: the vanity, where her necklaces lie layered by their listed lengths (its own room). */}
+              <p className="ig-fineprint">
+                <Link className={textLink} to="/members/vanity">
+                  Lay your necklaces out at the Vanity →
+                </Link>
+              </p>
+              {!us && pieces.some((h) => byHandle.get(h)?.category === "Rings") && (
+                <p className="ig-fineprint">
+                  <Link className="ig-link" to="/members/fit">
+                    Keep your ring size
+                  </Link>{" "}
+                  and every ring here says whether it comes in your size.
+                </p>
+              )}
+            </>
+          )}
+          {metaProblem && (Object.keys(kept).length > 0 || outs.length > 0) && (
+            <p className="ig-fineprint" role="alert">
+              {metaProblem} Your drawer is kept here and will be saved to your account.{" "}
+              <button type="button" className={quietButton} onClick={retryMeta}>
+                Try again
+              </button>
+            </p>
+          )}
+        </section>
+
+        {isLive && startedEmpty && hasFresh && (
+          <section className="ig-section" aria-labelledby="ig-begin">
+            <h2 id="ig-begin" className="ig-h2">
+              Begin with something new
+            </h2>
+            <ul className="ig-pcs">
+              {(fresh ?? []).map((piece) => {
+                const preset = presetFor(piece, us, metal, month);
+                return (
+                  <li key={piece.handle}>
+                    <PieceCard
+                      piece={piece}
+                      preset={preset}
+                      note={piece.category === "Rings" ? <FitsYou fit={preset.fit} us={us} /> : undefined}
+                      extra={(named) =>
+                        saved.includes(piece.handle) ? (
+                          <KeptNote handle={piece.handle} name={piece.name} fresh={piece.handle in kept} note={kept[piece.handle]} />
+                        ) : (
+                          <button type="button" className={quietButton} onClick={() => keep(piece.handle)} aria-describedby={named}>
+                            Keep in my drawer
+                          </button>
+                        )
+                      }
+                      preview={preview}
+                      bagBusy={bagBusy}
+                      onAdd={addToBag}
+                    />
+                  </li>
+                );
+              })}
+            </ul>
+          </section>
+        )}
+
+        {isLive && laid && (
+          <LaidOut saved={saved} catalogue={jewellery} us={us} metal={metal} month={month} preview={preview} bagBusy={bagBusy} onAdd={addToBag} onKeep={keep} kept={kept} />
+        )}
+        <SinceLastVisit since={since} firstVisit={firstVisit} catalogue={jewellery} live={isLive} us={us} metal={metal} month={month} saved={saved} preview={preview} bagBusy={bagBusy} onAdd={addToBag} onKeep={keep} kept={kept} />
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Drawer;
