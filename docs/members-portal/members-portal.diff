+    const d = drag.current;
+    drag.current = null;
+    if (!d?.moved) return;
+    const at = pending.current ?? shown.current;
+    pending.current = null;
+    stopFrames();
+    shown.current = at;
+    ease(restingAfter(at, d.v));
+  };
+
+  const onKeyDown = (e: KeyboardEvent<HTMLDivElement>) => {
+    const to = still ? (e.key === "ArrowRight" ? nextPose(shown.current, 1) : e.key === "ArrowLeft" ? nextPose(shown.current, -1) : null) : keyToLight(shown.current, e.key);
+    if (!to) return;
+    e.preventDefault();
+    ease(to, 420);
+  };
+
+  const turn = (way: 1 | -1) => ease(nextPose(shown.current, way), 600);
+
+  /* "Tilt your phone": asked inside this click (iOS's permission), then the light follows the phone, smoothed. */
+  const askTilt = () => {
+    setTilt("asking");
+    tiltBase.current = null;
+    sensor.current = startMotion({
+      onReading: (r) => {
+        if (!tiltBase.current) {
+          tiltBase.current = { rest: r, from: shown.current };
+          filtered.current = shown.current;
+          setTilt("on");
+        }
+        const { rest, from } = tiltBase.current;
+        const t = tiltToLight(r, rest, screenAngle());
+        const next = lowPass(filtered.current, { x: clamp1(from.x + t.x), y: clamp1(from.y + t.y) });
