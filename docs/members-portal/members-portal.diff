diff --git a/supabase/functions/order-bloom/bloom.ts b/supabase/functions/order-bloom/bloom.ts
new file mode 100644
index 0000000..d2fc688
--- /dev/null
+++ b/supabase/functions/order-bloom/bloom.ts
@@ -0,0 +1,511 @@
+/*
+  order-bloom's logic: when Shopify says an order was placed, the checkout
+  a member started for it is marked as an order (member_orders.status
+  'completed', completed_at the order's own time). Nothing else is written,
+  and nothing is ever created, removed or read back to a browser: the Order
+  Desk reads her own rows under their existing row security, as it always
+  has.
+
+  Kept free of Deno globals and npm: imports so the shop's own test runner
+  can import it (src/lib/orderBloom.test.ts); index.ts, the thin Deno
+  handler, imports it as ./bloom.ts.
+
+  How a request is answered, in order:
+  1. No secret set (ORDER_BLOOM_WEBHOOK_SECRET), or one shorter than
+     MIN_SECRET once trimmed: 401 for every request, before anything is
+     read. The function is inert until the owner sets it.
+  2. Not a POST: 405. A body over MAX_BODY (by its content-length, or as it
+     is read, for a request that sends none): 413.
+  3. X-Shopify-Hmac-Sha256 must be the base64 HMAC-SHA256 of the raw body
+     under the secret, compared in constant time: else 401, nothing written.
+  4. Signed, but not this shop's orders/create, unreadable, a test order, a
+     cancelled one, or one placed more than MAX_AGE_MS ago (a replayed or
+     re-sent old delivery): 200, nothing written.
+  5. The order is matched to one row (the rule below) and that row alone is
+     marked; an order that matches nothing gets 200 at once, nothing written.
+     A database error is a 500, so Shopify delivers again later (step 5 is
+     safe to repeat).
+
+  Whose row it is. A member's browser writes her rows (the bag's insert),
+  so every column but user_id is the browser's word: its email, its tokens,
+  its time. user_id alone is the database's (row security sets it to the
+  member who wrote the row), and the one email that proves who a member is
+  is her own sign-in email (auth.users, confirmed), read here with the
+  service role. Sign-in emails are unique, so at most one member is the
+  order's.
+
+  The matching rule:
+  - First by token. The order's cart_token and checkout_token are compared
+    with each row's cart_id, checkout_token and the token in its
+    checkout_url (/cart/c/<token> or /checkouts/cn/<token>, which the bag
+    stores for every checkout it starts). The rows carrying one of them are
+    the cart's. When the order names an email, only the rows of the member
+    who signs in with it count; when none of the cart's members does, the
+    order was paid by someone else (a phone shared, a link passed on) and
+    nothing is written. Without an email, a cart shared by two members is a
+    doubt, and nothing is written. Among her rows: if one is already
+    completed, the order has bloomed before (a retry): nothing is written.
+    Otherwise only the newest started before the order (allowing SKEW_MS
+    of clock difference, and no more than TOKEN_WINDOW_MS before it) is
+    the one: a cart sent to checkout twice became one order. It is marked
+    only when its pieces agree with the order's (samePieces): the bag
+    notes a row only on its own Checkout tap, so a cart changed afterwards
+    and paid through Buy now is not the checkout the row describes.
+  - Then, only when no row carries any of the order's tokens, by email,
+    under a conservative rule: the member who signs in with the order's
+    email (found among the owners of rows naming that email; rows other
+    members wrote under her email are passed over, never counted as hers);
+    exactly one of her own rows was started in the EMAIL_WINDOW_MS before
+    the order (up to SKEW_MS after it), of any status; that row is not
+    completed already; its piece count is known and equals the order's,
+    and its pieces' names agree (samePieces); and, when the order carries a
+    token, the row carries none (a row with a token of its own was another
+    cart).
+  Two rows, or none, or any doubt: nothing is written. A missed match only
+  leaves a checkout under "Checkouts you started", which is still true.
+  What a member can still do, until the database itself refuses browser
+  rows that claim 'completed' (an owner-approved migration, outside this
+  function): mark her own rows so, for her own eyes. She cannot make this
+  function write another member's order onto her row, nor write hers onto
+  another's: at most, holding someone's cart token, a row she plants can
+  leave that person's order unmatched when it names no email.
+
+  Never logged: an email, a name, an address, a phone, a token, an order or
+  row id, an amount, a piece's name. The log carries outcome codes alone.
+*/
+
+/** The shop's own Shopify domain (src/lib/shopify.ts SHOPIFY_STORE_PERMANENT_DOMAIN): another shop's signed webhook is ignored. */
+export const SHOP_DOMAIN = "nc5eti-gp.myshopify.com";
+export const TOPIC = "orders/create";
+/** Shopify's order payloads stay well under this; anything larger is refused before it is hashed. */
+export const MAX_BODY = 512 * 1024;
+/** A cart or checkout token as Shopify writes them; anything else is never matched (nor put in a query). */
+export const TOKEN = /^[A-Za-z0-9_-]{8,128}$/;
+/** For the email fallback: the row was started at most this long before the order. */
+export const EMAIL_WINDOW_MS = 2 * 60 * 60 * 1000;
+/** Clock difference allowed between the shop's database and Shopify's. */
+export const SKEW_MS = 10 * 60 * 1000;
+/** For the token rule: a Shopify cart lives about ten days, so an older row is not this order's checkout. */
+export const TOKEN_WINDOW_MS = 10 * 24 * 60 * 60 * 1000;
+/** Rows read per question: a cart, or a member's checkouts in two hours, never comes near it. */
+export const ROWS_READ = 20;
+/** Reads of the rows naming the order's email, each passing over the members already asked: rows others planted under her email cannot crowd hers out. */
+export const EMAIL_READS = 3;
+/** An order placed longer ago than this is never matched (a replayed or re-sent old delivery): Shopify's own retries end within two days. */
+export const MAX_AGE_MS = 3 * 24 * 60 * 60 * 1000;
+/** A signing secret shorter than this, once trimmed, is treated as unset (Shopify's are 64 characters). */
+export const MIN_SECRET = 32;
+/** Only these columns are ever read, and only on the service side. */
+export const COLUMNS = "id, user_id, status, created_at, cart_id, checkout_token, checkout_url, email, item_count, items";
+
+const EMAIL = /^[^\s@]{1,64}@[^\s@]{1,255}$/;
+
+/* ── the signature ────────────────────────────────────── */
+
+const fromBase64 = (text: string): Uint8Array | null => {
+  try {
+    const raw = atob(text);
+    const out = new Uint8Array(raw.length);
+    for (let i = 0; i < raw.length; i++) out[i] = raw.charCodeAt(i);
+    return out;
+  } catch {
+    return null;
+  }
+};
+
+/** Equal bytes, in a time that depends only on the length (always 32 here), never on where they differ. */
+export const sameBytes = (a: Uint8Array, b: Uint8Array): boolean => {
+  if (a.length !== b.length) return false;
+  let diff = 0;
+  for (let i = 0; i < a.length; i++) diff |= a[i] ^ b[i];
+  return diff === 0;
+};
+
+/** True only when `header` is the base64 HMAC-SHA256 of the raw `body` under `secret`. */
+export const verifyShopifyHmac = async (body: ArrayBuffer, header: string | null | undefined, secret: string | null | undefined): Promise<boolean> => {
+  if (!secret || !header) return false;
+  const given = fromBase64(header.trim());
+  if (!given || given.length !== 32) return false;
+  try {
+    const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
+    const mac = new Uint8Array(await crypto.subtle.sign("HMAC", key, body));
+    return sameBytes(mac, given);
+  } catch {
+    return false;
+  }
+};
+
+/* ── the order, as far as matching needs it ───────────── */
+
+export type OrderFacts = {
+  /** Its cart and checkout tokens (only those shaped like one). */
+  tokens: string[];
+  /** Lower-cased, for the email fallback only; never logged, never written. */
+  email: string | null;
+  /** The order's own time (ISO): what completed_at is set to, and what the gold rose is dated with. */
+  placedAt: string;
+  /** The sum of its line items' quantities, when it has any. */
+  pieces: number | null;
+  /** Its line items' titles, folded (nameKey), for samePieces alone; never logged, never written. */
+  names: string[];
+  test: boolean;
+  cancelled: boolean;
+};
+
+const record = (x: unknown): Record<string, unknown> | null => (x && typeof x === "object" && !Array.isArray(x) ? (x as Record<string, unknown>) : null);
+
+/** A piece's name folded for comparison: lower case, letters and digits, single spaces. */
+export const nameKey = (x: unknown): string =>
+  typeof x === "string"
+    ? x
+        .toLowerCase()
+        .replace(/[^a-z0-9]+/g, " ")
+        .trim()
+        .slice(0, 120)
+    : "";
+const namesOf = (list: readonly unknown[]): string[] => [...new Set(list.map(nameKey).filter(Boolean))];
+
+export const orderFacts = (payload: unknown): OrderFacts | null => {
+  const o = record(payload);
+  if (!o) return null;
+  const when = [o.created_at, o.processed_at].find((v): v is string => typeof v === "string" && !Number.isNaN(Date.parse(v)));
+  if (!when) return null;
+  const tokens = [...new Set([o.cart_token, o.checkout_token].filter((t): t is string => typeof t === "string" && TOKEN.test(t)))];
+  const email =
+    [o.email, o.contact_email, record(o.customer)?.email]
+      .map((e) => (typeof e === "string" ? e.trim().toLowerCase() : ""))
+      .find((e) => EMAIL.test(e)) ?? null;
+  const lines = Array.isArray(o.line_items) ? o.line_items : [];
+  const quantities = lines.map((l) => Number(record(l)?.quantity)).filter((q) => Number.isInteger(q) && q > 0);
+  return {
+    tokens,
+    email,
+    placedAt: new Date(when).toISOString(),
+    pieces: quantities.length ? quantities.reduce((s, q) => s + q, 0) : null,
+    names: namesOf(lines.map((l) => record(l)?.title ?? record(l)?.name)),
+    test: o.test === true,
+    cancelled: o.cancelled_at != null && o.cancelled_at !== "",
+  };
+};
+
+/* ── a member_orders row, as far as matching needs it ── */
+
+export type Row = {
+  id: string;
+  /** The member who wrote it (set by row security, so the one column a browser cannot choose). */
+  user_id: string;
+  status: string;
+  created_at: string;
+  cart_id: string | null;
+  checkout_token: string | null;
+  checkout_url: string | null;
+  email: string | null;
+  item_count: number | null;
+  /** Its pieces' names as the bag noted them, folded (nameKey). */
+  names: string[];
+};
+
+const CART_GID = /^gid:\/\/shopify\/Cart\/([^?/#]+)/;
+const URL_TOKEN = /\/(?:cart\/c|checkouts\/(?:cn|co|c))\/([A-Za-z0-9_-]+)\/?$/;
+
+/** Every token a row carries: its cart id (bare, or as Shopify's gid), its checkout token, and its checkout address's. */
+export const tokensOfRow = (row: Pick<Row, "cart_id" | "checkout_token" | "checkout_url">): string[] => {
+  const out: string[] = [];
+  const add = (t: string | null | undefined) => {
+    if (t && TOKEN.test(t) && !out.includes(t)) out.push(t);
+  };
+  if (row.cart_id) add(CART_GID.exec(row.cart_id)?.[1] ?? row.cart_id);
+  add(row.checkout_token);
+  if (row.checkout_url) {
+    try {
+      add(URL_TOKEN.exec(new URL(row.checkout_url).pathname)?.[1]);
+    } catch {
+      /* not an address: no token */
+    }
+  }
+  return out;
+};
+
+const text = (x: unknown) => (typeof x === "string" ? x : null);
+
+export const rowOf = (x: unknown): Row | null => {
+  const r = record(x);
+  const id = text(r?.id);
+  const user = text(r?.user_id);
+  const created = text(r?.created_at);
+  if (!r || !id || !user || !created || Number.isNaN(Date.parse(created))) return null;
+  const count = Number(r.item_count);
+  return {
+    id,
+    user_id: user,
+    status: text(r.status) ?? "",
+    created_at: created,
+    cart_id: text(r.cart_id),
+    checkout_token: text(r.checkout_token),
+    checkout_url: text(r.checkout_url),
+    email: text(r.email),
+    item_count: Number.isInteger(count) ? count : null,
+    names: namesOf((Array.isArray(r.items) ? r.items : []).map((i) => record(i)?.name)),
+  };
+};
+
+/* ── where rows are read and the one write is made ───── */
+
+export interface Store {
+  /** Rows of any status that may carry one of these tokens (a coarse filter: bloomOrder checks each exactly). */
+  byTokens(tokens: readonly string[]): Promise<Row[]>;
+  /** Rows of any status with exactly this email, started between `from` and `to`, of members other than `skip`. */
+  byEmail(email: string, from: string, to: string, skip: readonly string[]): Promise<Row[]>;
+  /** This member's own rows of any status, started between `from` and `to`. */
+  byOwner(userId: string, from: string, to: string): Promise<Row[]>;
+  /** The member's own sign-in email (auth.users), lower-cased, once confirmed; null when she has none, or none confirmed. Never logged. */
+  accountEmail(userId: string): Promise<string | null>;
+  /** Marks this one row completed at `completedAt` unless it is already; true when it changed. */
+  complete(id: string, completedAt: string): Promise<boolean>;
+}
+
+export type Outcome = "bloomed_by_token" | "bloomed_by_email" | "already_bloomed" | "unmatched" | "ambiguous" | "mismatched";
+
+const newestFirst = (a: Row, b: Row) => Date.parse(b.created_at) - Date.parse(a.created_at);
+const startedIn = (r: Row, from: number, to: number) => {
+  const at = Date.parse(r.created_at);
+  return at >= from && at <= to;
+};
+
+/**
+ * Whether a row's pieces can be the order's: the same number of pieces when
+ * both are known, and, when both name theirs, at least one name in common
+ * (one name holding the other, so a shorter or longer title still agrees).
+ * Lenient on names on purpose: it only refuses a row that plainly noted
+ * other pieces, never one whose names were written a little differently.
+ */
+export const samePieces = (row: Row, order: OrderFacts): boolean => {
+  if (order.pieces !== null && row.item_count !== null && row.item_count > 0 && row.item_count !== order.pieces) return false;
+  if (order.names.length && row.names.length && !row.names.some((a) => order.names.some((b) => a.includes(b) || b.includes(a)))) return false;
+  return true;
+};
+
+export const bloomOrder = async (order: OrderFacts, store: Store): Promise<Outcome> => {
+  const placed = Date.parse(order.placedAt);
+  const latest = placed + SKEW_MS;
+  const emails = new Map<string, string | null>();
+  const accountEmail = async (id: string) => {
+    if (!emails.has(id)) emails.set(id, await store.accountEmail(id));
+    return emails.get(id) ?? null;
+  };
+
+  if (order.tokens.length) {
+    const carts = (await store.byTokens(order.tokens)).filter((r) => tokensOfRow(r).some((t) => order.tokens.includes(t)));
+    if (carts.length) {
+      // Whose cart: the member who signs in with the order's email; without one, the cart's only member.
+      const owners = [...new Set(carts.map((r) => r.user_id))];
+      let owner: string | undefined;
+      if (order.email) {
+        for (const id of owners) if ((await accountEmail(id)) === order.email) owner = id;
+        // One member with no sign-in email (a phone sign-in): her row, when it names no email either.
+        if (!owner && owners.length === 1 && (await accountEmail(owners[0])) === null && carts.every((r) => !r.email)) owner = owners[0];
+        if (!owner) return "mismatched";
+      } else if (owners.length === 1) owner = owners[0];
+      else return "ambiguous";
+      const hers = carts.filter((r) => r.user_id === owner);
+      if (hers.some((r) => r.status === "completed")) return "already_bloomed";
+      const [row] = hers.filter((r) => startedIn(r, placed - TOKEN_WINDOW_MS, latest)).sort(newestFirst);
+      if (!row) return "unmatched";
+      if (!samePieces(row, order)) return "mismatched";
+      return (await store.complete(row.id, order.placedAt)) ? "bloomed_by_token" : "already_bloomed";
+    }
+  }
+
+  if (!order.email || order.pieces === null) return "unmatched";
+  const from = placed - EMAIL_WINDOW_MS;
+  const fromIso = new Date(from).toISOString();
+  const toIso = new Date(latest).toISOString();
+  // The member who signs in with the order's email, among the owners of rows that name it.
+  let owner: string | undefined;
+  const asked: string[] = [];
+  for (let read = 0; read < EMAIL_READS && !owner; read++) {
+    const near = await store.byEmail(order.email, fromIso, toIso, asked);
+    for (const id of new Set(near.map((r) => r.user_id))) {
+      if (asked.includes(id)) continue;
+      asked.push(id);
+      if ((await accountEmail(id)) === order.email) {
+        owner = id;
+        break;
+      }
+    }
+    if (near.length < ROWS_READ) break;
+  }
+  if (!owner) return "unmatched";
+  // Her own rows in the window, read again by owner.
+  const mine = (await store.byOwner(owner, fromIso, toIso)).filter((r) => r.user_id === owner && startedIn(r, from, latest));
+  if (mine.length !== 1) return mine.length ? "ambiguous" : "unmatched";
+  const [row] = mine;
+  if (row.status === "completed") return "already_bloomed";
+  if (order.tokens.length && tokensOfRow(row).length) return "unmatched";
+  if (row.item_count === null || row.item_count <= 0 || !samePieces(row, order)) return "unmatched";
+  return (await store.complete(row.id, order.placedAt)) ? "bloomed_by_email" : "already_bloomed";
+};
+
+/* ── the Supabase side (service role), typed by what it uses ── */
+
+export type DbResult = { data: unknown; error: { code?: string } | null };
+export interface DbQuery extends PromiseLike<DbResult> {
+  select(columns: string): DbQuery;
+  eq(column: string, value: string): DbQuery;
+  neq(column: string, value: string): DbQuery;
+  gte(column: string, value: string): DbQuery;
+  lte(column: string, value: string): DbQuery;
+  not(column: string, operator: "in", value: string): DbQuery;
+  or(filters: string): DbQuery;
+  order(column: string, options: { ascending: boolean }): DbQuery;
+  limit(count: number): DbQuery;
+}
+export type AuthUser = { email?: string | null; email_confirmed_at?: string | null } | null;
+export type Db = {
+  /** The service role's read of one member's sign-in email (supabase-js auth.admin.getUserById). */
+  auth: { admin: { getUserById(id: string): PromiseLike<{ data: { user: AuthUser } | null; error: { status?: number; code?: string } | null }> } };
+  from(table: "member_orders"): {
+    select(columns: string): DbQuery;
+    /** The function's only write: these two columns, nothing else. */
+    update(values: { status: "completed"; completed_at: string }): DbQuery;
+  };
+};
+
+/** A database error, carrying its code alone (a message can quote a value). */
+export class StoreError extends Error {
+  constructor(readonly code: string) {
+    super(`store_error_${code}`);
+  }
+}
+
+const codeOf = (code: unknown, fallback: string) => String(code ?? fallback).replace(/[^A-Za-z0-9_]/g, "").slice(0, 12) || fallback;
+const rowsOf = ({ data, error }: DbResult): Row[] => {
+  if (error) throw new StoreError(codeOf(error.code, "unknown"));
+  return (Array.isArray(data) ? data : []).map(rowOf).filter((r): r is Row => r !== null);
+};
+
+/** The coarse token filter: each token is TOKEN-shaped (letters, digits, - and _), so it is safe inside PostgREST's or=(). */
+export const tokenFilter = (tokens: readonly string[]): string =>
+  tokens
+    .filter((t) => TOKEN.test(t))
+    .flatMap((t) => [`cart_id.like.*${t}*`, `checkout_token.eq.${t}`, `checkout_url.like.*${t}*`])
+    .join(",");
+
+const MEMBER_ID = /^[A-Za-z0-9-]{1,64}$/;
+
+export const supabaseStore = (db: Db): Store => ({
+  byTokens: async (tokens) => {
+    const filter = tokenFilter(tokens);
+    if (!filter) return [];
+    return rowsOf(await db.from("member_orders").select(COLUMNS).or(filter).order("created_at", { ascending: false }).limit(ROWS_READ));
+  },
+  byEmail: async (email, from, to, skip) => {
+    let q = db.from("member_orders").select(COLUMNS).eq("email", email).gte("created_at", from).lte("created_at", to);
+    // Member ids are the database's own (uuid-shaped); anything else is never put in the filter, and its rows are simply read again.
+    const ids = skip.filter((id) => MEMBER_ID.test(id));
+    if (ids.length) q = q.not("user_id", "in", `(${ids.join(",")})`);
+    return rowsOf(await q.order("created_at", { ascending: false }).limit(ROWS_READ));
+  },
+  byOwner: async (userId, from, to) =>
+    rowsOf(await db.from("member_orders").select(COLUMNS).eq("user_id", userId).gte("created_at", from).lte("created_at", to).order("created_at", { ascending: false }).limit(ROWS_READ)),
+  accountEmail: async (userId) => {
+    const { data, error } = await db.auth.admin.getUserById(userId);
+    if (error) {
+      if (error.status === 404) return null;
+      throw new StoreError(codeOf(error.code ?? error.status, "auth"));
+    }
+    const user = data?.user;
+    return user?.email && user.email_confirmed_at ? user.email.trim().toLowerCase() : null;
+  },
+  complete: async (id, completedAt) => {
+    const changed = rowsOf(await db.from("member_orders").update({ status: "completed", completed_at: completedAt }).eq("id", id).neq("status", "completed").select("id, created_at"));
+    return changed.length > 0;
+  },
+});
+
+/* ── one request ─────────────────────────────────────── */
+
+export type Incoming = {
+  method: string;
+  header: (name: string) => string | null;
+  /** The raw body, read only once the secret is known to be set; it rejects with TooLarge past `max` bytes, without reading the rest. */
+  body: (max: number) => Promise<ArrayBuffer>;
+};
+/** A body that grew past MAX_BODY while it was read (a request without a content-length). */
+export class TooLarge extends Error {}
+export type Deps = {
+  secret: string | null | undefined;
+  /** The service-role store, or null when the function's own Supabase settings are missing. */
+  store: () => Store | null;
+  /** Outcome codes only. */
+  log?: (event: string) => void;
+  /** The clock, for the age check (tests pass their own). */
+  now?: () => number;
+};
+export type Reply = { status: number; body: Record<string, string | boolean> };
+
+const reply = (status: number, body: Record<string, string | boolean>): Reply => ({ status, body });
+
+export const handleWebhook = async (req: Incoming, deps: Deps): Promise<Reply> => {
+  const log = deps.log ?? (() => undefined);
+  // Inert until the owner sets the secret: nothing is read, nothing is written, every request refused.
+  // (Trimmed, as a pasted key often carries a newline; a blank or short one counts as unset.)
+  const secret = typeof deps.secret === "string" ? deps.secret.trim() : "";
+  if (secret.length < MIN_SECRET) {
+    log("refused_not_configured");
+    return reply(401, { error: "unauthorized" });
+  }
+  if (req.method !== "POST") return reply(405, { error: "method_not_allowed" });
+  if (Number(req.header("content-length") ?? 0) > MAX_BODY) return reply(413, { error: "too_large" });
+  let body: ArrayBuffer;
+  try {
+    body = await req.body(MAX_BODY);
+  } catch (error) {
+    return error instanceof TooLarge ? reply(413, { error: "too_large" }) : reply(400, { error: "unreadable" });
+  }
+  if (body.byteLength > MAX_BODY) return reply(413, { error: "too_large" });
+  if (!(await verifyShopifyHmac(body, req.header("x-shopify-hmac-sha256"), secret))) {
+    log("refused_signature");
+    return reply(401, { error: "unauthorized" });
+  }
+
+  // Signed by the shop from here: whatever happens next, Shopify hears quickly.
+  if (req.header("x-shopify-topic") !== TOPIC || req.header("x-shopify-shop-domain") !== SHOP_DOMAIN) {
+    log("ignored_topic");
+    return reply(200, { ok: true, result: "ignored" });
+  }
+  let payload: unknown;
+  try {
+    payload = JSON.parse(new TextDecoder().decode(body));
+  } catch {
+    payload = null;
+  }
+  const order = orderFacts(payload);
+  if (!order) {
+    log("ignored_unreadable");
+    return reply(200, { ok: true, result: "ignored" });
+  }
+  // A test order or a cancelled one is not an order to bloom.
+  if (order.test || order.cancelled) {
+    log(order.test ? "ignored_test" : "ignored_cancelled");
+    return reply(200, { ok: true, result: "ignored" });
+  }
+  // An old order (a replayed or re-sent delivery) is never matched: its checkout, if any, stays a checkout.
+  if ((deps.now ?? Date.now)() - Date.parse(order.placedAt) > MAX_AGE_MS) {
+    log("ignored_stale");
+    return reply(200, { ok: true, result: "ignored" });
+  }
+  const store = deps.store();
+  if (!store) {
+    log("unavailable");
+    return reply(503, { error: "unavailable" });
+  }
+  try {
+    const outcome = await bloomOrder(order, store);
+    log(outcome);
+    return reply(200, { ok: true, result: outcome });
+  } catch (error) {
+    log(error instanceof StoreError ? error.message : "store_error");
+    return reply(500, { error: "unavailable" });
+  }
+};
