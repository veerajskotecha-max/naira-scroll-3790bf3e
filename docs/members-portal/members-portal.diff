+++ b/src/lib/portal/whatsapp.ts
@@ -0,0 +1,80 @@
+import type { Metal, UsSize } from "./memberMeta";
+import { WHATSAPP_URL } from "./handOff";
+import { stoneForMonth } from "./stones";
+
+/*
+  Writing to the atelier on WhatsApp (wa.me/919561557935, the shop's own
+  number). The message is written for her from what her account keeps:
+  about care, her ring size, her metal, her month's colour and the first
+  three pieces she saved; about an order, only the email she used at
+  checkout and a line for the order number from her confirmation email
+  (her size and saved pieces would only muddle which order she means). It
+  is shown to her on the card first and hers to change, and then again in
+  WhatsApp before she sends it. Nothing is sent by the portal: a wa.me
+  link only opens a chat with the words filled in, and it is built at the
+  tap (lib/portal/handOff), never left on the page.
+
+  No reply hours are said anywhere until the owner gives them, and nothing
+  is offered that the shop has not confirmed.
+*/
+
+export { WHATSAPP_URL };
+
+/* Half of a broken character (an emoji cut in two by a paste) becomes the
+   replacement character, as String.prototype.toWellFormed would make it:
+   encodeURIComponent throws on one, and her message must never take the
+   room down. No lookbehind, which older iPhones cannot read. */
+const wellFormed = (s: string): string => s.replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]|[\uD800-\uDFFF]/g, (m) => (m.length === 2 ? m : "\uFFFD"));
+
+/** A wa.me link with the message filled in (encoded whole: line breaks, ₹, Devanagari and all). */
+export const waLink = (text: string): string => `${WHATSAPP_URL}?text=${encodeURIComponent(wellFormed(text))}`;
+
+export const METAL_WORDS: Record<Metal, string> = { g: "Gold", s: "Silver", b: "Gold and silver" };
+export const SAVED_IN_MESSAGE = 3;
+
+export type AtelierAbout = "care" | "order";
+
+export type AtelierFacts = {
+  about: AtelierAbout;
+  size?: UsSize | null;
+  metal?: Metal | null;
+  month?: number | null;
+  /** Her saved handles, oldest first: the first three go in. */
+  saved?: readonly string[];
+  /** The order desk's: the email she used at checkout (her sign-in's, until she changes it). */
+  email?: string | null;
+};
+
+/** The order message's line for her to finish: the number is on her confirmation email. */
+export const ORDER_NUMBER_LINE = "The order number (from my confirmation email): ";
+
+const OPENING: Record<AtelierAbout, string> = {
+  care: "I have a question about caring for a piece.",
+  order: "Could you check on an order for me?",
+};
+
+/** The message, line by line: only what her account keeps, nothing guessed. */
+export const atelierMessage = (facts: AtelierFacts): string => {
+  const stone = stoneForMonth(facts.month ?? null);
+  const email = (facts.email ?? "").trim();
+  const saved = (facts.saved ?? []).slice(0, SAVED_IN_MESSAGE);
+  const lines = ["Hello Naira Flore, I'm writing from the Inner Garden.", OPENING[facts.about]];
+  if (facts.about === "order") {
+    // Only what finds the order: the email it was placed with, and its number for her to fill in.
+    if (email) lines.push(`The email I used at checkout: ${email}`);
+    lines.push(ORDER_NUMBER_LINE, "", "");
+    return lines.join("\n");
+  }
+  const about: string[] = [];
+  if (facts.size) about.push(`My ring size: US ${facts.size}`);
+  if (facts.metal) about.push(`My metal: ${METAL_WORDS[facts.metal]}`);
+  // The month's variant as the shop names it, never called her stone (they are cubic zirconia).
+  if (stone) about.push(`My month's colour: ${stone.variant}`);
+  if (saved.length) about.push("Pieces I saved:", ...saved.map((h) => `https://nairaflore.com/jewellery/${h}`));
+  if (about.length) lines.push("", ...about);
+  lines.push("", "");
+  return lines.join("\n");
+};
+
+/** The atelier's link for her words as they stand on the card. */
+export const atelierLink = (message: string): string => waLink(message.trimEnd());
