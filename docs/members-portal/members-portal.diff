--- /dev/null
+++ b/src/components/portal/ArrivalRepair.test.tsx
@@ -0,0 +1,236 @@
+import { cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/*
+  Arrival repair, end to end against a mocked Supabase: the portal's real
+  quiet join (the shop's insert without its Meta events; a duplicate answer,
+  23505, means "already joined") and the real device store. Nothing reaches
+  the live project.
+*/
+
+const db = vi.hoisted(() => ({
+  ownRows: [] as unknown[],
+  insertError: null as unknown,
+  inserts: [] as unknown[],
+  upserts: [] as unknown[],
+}));
+vi.mock("@/integrations/supabase/lazy", () => ({
+  getSupabase: async () => ({
+    from: (table: string) => ({
+      select: () => ({ eq: () => ({ limit: async () => ({ data: db.ownRows, error: null }) }) }),
+      insert: async (row: unknown) => {
+        db.inserts.push([table, row]);
+        return { error: db.insertError };
+      },
+      upsert: async (row: unknown) => {
+        db.upserts.push([table, row]);
+        return { error: null };
+      },
+    }),
+  }),
+}));
+vi.mock("@/lib/pixel", () => ({ trackPixel: vi.fn() }));
+
+import type { ComponentProps } from "react";
+import { MemoryRouter } from "react-router-dom";
+import { trackPixel } from "@/lib/pixel";
+import ArrivalRepair from "./ArrivalRepair";
+import { joinListQuietly, liveArrivalActions, wasOffered, type ArrivalProfile, type ArrivalUser } from "@/lib/portal/arrival";
+import { joinInnerCircle } from "@/lib/innerCircle";
+
+const GOOGLE_MEMBER = { id: "u-ananya", email: "ananya.r@example.com", user_metadata: { full_name: "Ananya", avatar_url: "x" } };
+const UNTOUCHED = { ad_matching_consent: false, ad_matching_consent_at: null };
+
+const refreshProfile = vi.fn(async () => {});
+const actions = () => liveArrivalActions(joinListQuietly, refreshProfile);
+const arrive = (user: ArrivalUser = GOOGLE_MEMBER, profile: ArrivalProfile = UNTOUCHED, extra: Partial<ComponentProps<typeof ArrivalRepair>> = {}) =>
+  render(
+    <MemoryRouter>
+      <ArrivalRepair user={user} profile={profile} actions={actions()} {...extra} />
+    </MemoryRouter>,
+  );
+
+beforeEach(() => {
+  window.localStorage.clear();
+  db.ownRows = [];
+  db.insertError = null;
+  db.inserts = [];
+  db.upserts = [];
+  refreshProfile.mockClear();
+});
+afterEach(cleanup);
+
+describe("arrival repair", () => {
+  it("offers the list and the consent box, unticked, to a member who has neither", async () => {
+    arrive();
+    expect(await screen.findByRole("heading", { name: "Two quick questions" })).toBeInTheDocument();
+    expect(screen.getByText("Would you like news of new pieces by email, at ananya.r@example.com?")).toBeInTheDocument();
+    expect(screen.getByRole("checkbox")).not.toBeChecked();
+    expect(screen.getByRole("button", { name: "Join the list" })).toBeInTheDocument();
+  });
+
+  it("joins her with one tap, as members-arrival, with her own account id", async () => {
+    arrive();
+    fireEvent.click(await screen.findByRole("button", { name: "Join the list" }));
+    expect(await screen.findByText("You're on the Inner Circle list.")).toBeInTheDocument();
+    expect(db.inserts).toEqual([
+      ["inner_circle_signups", { email: "ananya.r@example.com", name: null, phone: null, source: "members-arrival", user_id: "u-ananya" }],
+    ]);
+  });
+
+  it("reads a duplicate (23505, a row she made before her account) as already joined", async () => {
+    db.insertError = { code: "23505", message: "duplicate key value violates unique constraint" };
+    arrive();
+    fireEvent.click(await screen.findByRole("button", { name: "Join the list" }));
+    expect(await screen.findByText("You were already on the Inner Circle list.")).toBeInTheDocument();
+    expect(screen.queryByRole("alert")).toBeNull();
+    expect(db.inserts).toHaveLength(1);
+  });
+
+  it("says when the list would not take her, and lets her try again", async () => {
+    db.insertError = { code: "500", message: "boom" };
+    arrive();
+    fireEvent.click(await screen.findByRole("button", { name: "Join the list" }));
+    expect(await screen.findByRole("alert")).toHaveTextContent("Something went wrong. Please try again.");
+    db.insertError = null;
+    fireEvent.click(screen.getByRole("button", { name: "Join the list" }));
+    expect(await screen.findByText("You're on the Inner Circle list.")).toBeInTheDocument();
+  });
+
+  it("writes a yes only when she ticks the box herself, and an untouched box as her no", async () => {
+    arrive();
+    fireEvent.click(await screen.findByRole("button", { name: "Save my choice" }));
+    expect(await screen.findByText(/Nothing is shared/)).toBeInTheDocument();
+    // Her no is kept (no consent date, updated_at moved), so no phone asks it again.
+    expect(db.upserts).toEqual([["profiles", expect.objectContaining({ id: "u-ananya", ad_matching_consent: false, ad_matching_consent_at: null })]]);
+    cleanup();
+    db.upserts = [];
+
+    window.localStorage.clear();
+    arrive();
+    fireEvent.click(await screen.findByRole("checkbox"));
+    fireEvent.click(screen.getByRole("button", { name: "Save my choice" }));
+    expect(await screen.findByText(/^Saved\./)).toBeInTheDocument();
+    expect(db.upserts).toEqual([["profiles", expect.objectContaining({ id: "u-ananya", ad_matching_consent: true })]]);
+    expect(refreshProfile).toHaveBeenCalled();
+  });
+
+  it("asks once per member: not again after No, thank you, nor on her next visit", async () => {
+    const first = arrive();
+    fireEvent.click(await screen.findByRole("button", { name: "No, thank you" }));
+    expect(first.container).toBeEmptyDOMElement();
+    cleanup();
+
+    const again = arrive();
+    await waitFor(() => expect(db.inserts).toEqual([]));
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(again.container).toBeEmptyDOMElement();
+    cleanup();
+
+    // Another member on the same phone is still asked.
+    arrive({ ...GOOGLE_MEMBER, id: "u-meera", email: "meera@example.com" });
+    expect(await screen.findByRole("button", { name: "Join the list" })).toBeInTheDocument();
+  });
+
+  /* Below her garden the card may be under the fold: it counts as asked only
+     once it has been on her screen, or she has closed it. */
+  it("counts the offer only once the card has been on her screen", async () => {
+    const watched: { cb: IntersectionObserverCallback; disconnect: () => void }[] = [];
+    class FakeObserver {
+      cb: IntersectionObserverCallback;
+      constructor(cb: IntersectionObserverCallback) {
+        this.cb = cb;
+        watched.push(this);
+      }
+      observe() {}
+      unobserve() {}
+      disconnect() {}
+      takeRecords() {
+        return [];
+      }
+    }
+    vi.stubGlobal("IntersectionObserver", FakeObserver);
+    try {
+      const first = arrive();
+      expect(await screen.findByRole("heading", { name: "Two quick questions" })).toBeInTheDocument();
+      expect(wasOffered("u-ananya", "join")).toBe(false);
+      expect(wasOffered("u-ananya", "consent")).toBe(false);
+      first.unmount();
+
+      // Not seen yet, so her next visit asks again; this time it scrolls into view.
+      arrive();
+      expect(await screen.findByRole("heading", { name: "Two quick questions" })).toBeInTheDocument();
+      const last = watched[watched.length - 1];
+      last.cb([{ isIntersecting: true } as IntersectionObserverEntry], last as unknown as IntersectionObserver);
+      expect(wasOffered("u-ananya", "join")).toBe(true);
+      expect(wasOffered("u-ananya", "consent")).toBe(true);
+    } finally {
+      vi.unstubAllGlobals();
+    }
+  });
+
+  it("never asks again about a no she saved on /account", async () => {
+    db.ownRows = [{ id: "row-1" }];
+    const saidNo = { ad_matching_consent: false, ad_matching_consent_at: null, created_at: "2026-11-01T04:00:00+00:00", updated_at: "2026-11-02T10:00:00+00:00" };
+    const { container } = arrive(GOOGLE_MEMBER, saidNo);
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(container).toBeEmptyDOMElement();
+  });
+
+  it("joins without telling Meta, until the owner approves those events from the portal", async () => {
+    vi.mocked(trackPixel).mockClear();
+    arrive();
+    fireEvent.click(await screen.findByRole("button", { name: "Join the list" }));
+    expect(await screen.findByText("You're on the Inner Circle list.")).toBeInTheDocument();
+    expect(trackPixel).not.toHaveBeenCalled();
+  });
+
+  it("writes the very row the shop's own joinInnerCircle writes, and reads its answers the same way", async () => {
+    const input = { email: "  ananya.r@example.com ", name: " Ananya ", source: "members-arrival", userId: "u-ananya" };
+    vi.mocked(trackPixel).mockClear();
+    expect(await joinListQuietly(input)).toEqual({ ok: true, already: false });
+    expect(trackPixel).not.toHaveBeenCalled();
+    expect(await joinInnerCircle(input)).toEqual({ ok: true, already: false });
+    // The shop's own join is the one that tells Meta; the portal's never does.
+    expect(trackPixel).toHaveBeenCalledTimes(2);
+    expect(db.inserts).toHaveLength(2);
+    expect(db.inserts[0]).toEqual(db.inserts[1]);
+    db.insertError = { code: "23505", message: "duplicate" };
+    expect(await joinListQuietly(input)).toEqual(await joinInnerCircle(input));
+    db.insertError = { code: "500", message: "boom" };
+    expect(await joinListQuietly(input)).toEqual(await joinInnerCircle(input));
+    expect((await joinListQuietly({ ...input, email: "not an email" })).ok).toBe(false);
+    expect((await joinListQuietly({ ...input, name: "x".repeat(81) })).ok).toBe(false);
+  });
+
+  it("hands focus on when she closes it, and says where she can join later", async () => {
+    const onClosed = vi.fn();
+    arrive(GOOGLE_MEMBER, UNTOUCHED, { onClosed });
+    expect(await screen.findByRole("link", { name: "the Inner Circle page" })).toHaveAttribute("href", "/innercircle");
+    fireEvent.click(screen.getByRole("button", { name: "No, thank you" }));
+    expect(onClosed).toHaveBeenCalled();
+  });
+
+  it("shows nothing to a member who already has both, on any device", async () => {
+    db.ownRows = [{ id: "row-1" }];
+    const { container } = arrive(GOOGLE_MEMBER, { ad_matching_consent: true, ad_matching_consent_at: "2026-11-01T00:00:00Z" });
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(container).toBeEmptyDOMElement();
+  });
+
+  it("does not re-ask the consent box of an email sign-up who answered when registering", async () => {
+    db.ownRows = [{ id: "row-1" }];
+    const registered = { ...GOOGLE_MEMBER, user_metadata: { full_name: "Ananya", ad_matching_consent: false, ad_matching_consent_at: null } };
+    const { container } = arrive(registered);
+    await new Promise((resolve) => setTimeout(resolve, 20));
+    expect(container).toBeEmptyDOMElement();
+  });
+
+  it("asks only what is missing", async () => {
+    db.ownRows = [{ id: "row-1" }];
+    arrive();
+    expect(await screen.findByRole("heading", { name: "One quick question" })).toBeInTheDocument();
+    expect(screen.queryByRole("button", { name: "Join the list" })).toBeNull();
+    expect(screen.getByRole("checkbox")).not.toBeChecked();
+  });
+});
diff --git a/src/components/portal/ArrivalRepair.tsx b/src/components/portal/ArrivalRepair.tsx
new file mode 100644
index 0000000..2c3e098
--- /dev/null
+++ b/src/components/portal/ArrivalRepair.tsx
@@ -0,0 +1,219 @@
+import { useEffect, useRef, useState, type FormEvent } from "react";
+import { Link } from "react-router-dom";
+import {
+  arrivalNeeds,
+  markOffered,
+  type ArrivalActions,
+  type ArrivalNeed,
+  type ArrivalNeeds,
+  type ArrivalProfile,
+  type ArrivalUser,
+} from "@/lib/portal/arrival";
+import { eyebrow, outlineButton, quietButton } from "./styles";
+
+/*
+  Arrival repair (lib/portal/arrival.ts): on her first signed-in visit, the
+  Inner Circle list if she is not on it, and the ad-matching box, unticked,
+  if she has never answered it. The garden home shows it on her first
+  signed-in visit only (memberMeta's firstVisit), once the Doors have
+  finished, after her garden and the day's cards; this phone remembers what
+  it showed her, and nothing is offered that her account already has. "No,
+  thank you" closes it for good (it says where she can join, or change her
+  answer, later). No motion: it is a card of two plain questions.
+*/
+
+type Props = {
+  user: ArrivalUser;
+  profile: ArrivalProfile;
+  actions: ArrivalActions;
+  /** Where focus goes when she closes the card (the next heading). */
+  onClosed?: () => void;
+};
+
+type JoinState = "idle" | "busy" | "joined" | "already";
+type ConsentState = "idle" | "busy" | "saved" | "declined";
+
+const ArrivalRepair = ({ user, profile, actions, onClosed }: Props) => {
+  const [needs, setNeeds] = useState<ArrivalNeeds | null>(null);
+  const [closed, setClosed] = useState(false);
+  const [joinState, setJoinState] = useState<JoinState>("idle");
+  const [joinError, setJoinError] = useState<string | null>(null);
+  const [ticked, setTicked] = useState(false);
+  const [consentState, setConsentState] = useState<ConsentState>("idle");
+  const [consentError, setConsentError] = useState<string | null>(null);
+  const live = useRef(true);
+  useEffect(
+    () => () => {
+      live.current = false;
+    },
+    [],
+  );
+
+  /* What to ask is decided once per member, as she arrives. */
+  useEffect(() => {
+    let current = true;
+    void arrivalNeeds(user, profile, actions.hasOwnSignup).then((found) => {
+      if (current) setNeeds(found);
+    });
+    return () => {
+      current = false;
+    };
+    // eslint-disable-next-line react-hooks/exhaustive-deps -- decided once per member; her profile refreshing after a save must not ask again
+  }, [user.id]);
+
+  /* Asked once: what she is offered is remembered on this phone the moment
+     the card is on her screen (it sits below her garden, so it waits until
+     she scrolls to it), and a reload, or "No, thank you", never brings it
+     back. A later day never shows the card at all. Without
+     IntersectionObserver it counts as seen at once. */
+  const cardRef = useRef<HTMLElement>(null);
+  useEffect(() => {
+    if (!needs) return;
+    const shown = (["join", "consent"] as ArrivalNeed[]).filter((need) => needs[need]);
+    if (!shown.length) return;
+    const mark = () => markOffered(user.id, shown);
+    const card = cardRef.current;
+    if (!card || typeof IntersectionObserver === "undefined") {
+      mark();
+      return;
+    }
+    const watch = new IntersectionObserver(
+      (entries) => {
+        if (!entries.some((e) => e.isIntersecting)) return;
+        mark();
+        watch.disconnect();
+      },
+      { threshold: 0.4 },
+    );
+    watch.observe(card);
+    return () => watch.disconnect();
+  }, [needs, user.id]);
+
+  if (!needs || closed || (!needs.join && !needs.consent)) return null;
+
+  const join = async () => {
+    if (!user.email) return;
+    setJoinState("busy");
+    setJoinError(null);
+    const result = await actions.join({ email: user.email, userId: user.id });
+    if (!live.current) return;
+    if (result.ok === false) {
+      setJoinState("idle");
+      setJoinError(result.message);
+      return;
+    }
+    setJoinState(result.already ? "already" : "joined");
+  };
+
+  /* Her choice is saved either way: a yes, or a no that counts as answered
+     (so another phone, or a later sign-in, never asks it again). */
+  const answer = async (e: FormEvent) => {
+    e.preventDefault();
+    setConsentError(null);
+    const yes = ticked;
+    setConsentState("busy");
+    const result = await actions.saveConsent(user.id, yes);
+    if (!live.current) return;
+    if (result.ok === false) {
+      setConsentState("idle");
+      setConsentError(result.message);
+      return;
+    }
+    setConsentState(yes ? "saved" : "declined");
+  };
+
+  // "No, thank you" (or "Close") is an answer too: the card is not shown again, even if it was not yet counted as seen.
+  const close = () => {
+    const shown = (["join", "consent"] as ArrivalNeed[]).filter((need) => needs[need]);
+    markOffered(user.id, shown);
+    setClosed(true);
+    onClosed?.();
+  };
+
+  const asks = Number(needs.join) + Number(needs.consent);
+  const settled =
+    (!needs.join || joinState === "joined" || joinState === "already") &&
+    (!needs.consent || consentState === "saved" || consentState === "declined");
+
+  return (
+    <section ref={cardRef} className="ig-birthday" aria-labelledby="ig-arrival-title" data-clarity-mask="true">
+      <p className={eyebrow}>Welcome in</p>
+      <h2 id="ig-arrival-title" className="ig-h2">
+        {asks === 2 ? "Two quick questions" : "One quick question"}
+      </h2>
+
+      {needs.join && (
+        <div className="w-full">
+          {joinState === "joined" || joinState === "already" ? (
+            <p className="ig-fineprint" role="status">
+              {joinState === "joined" ? "You're on the Inner Circle list." : "You were already on the Inner Circle list."}
+            </p>
+          ) : (
+            <>
+              <p className="ig-fineprint">Would you like news of new pieces by email, at {user.email}?</p>
+              {joinError && (
+                <p className="ig-error" role="alert">
+                  {joinError}
+                </p>
+              )}
+              <button type="button" className={`${outlineButton} mt-2`} onClick={() => void join()} disabled={joinState === "busy"}>
+                {joinState === "busy" ? "Joining…" : "Join the list"}
+              </button>
+            </>
+          )}
+        </div>
+      )}
+
+      {needs.consent && (
+        <div className="w-full">
+          {consentState === "saved" || consentState === "declined" ? (
+            <p className="ig-fineprint" role="status">
+              {consentState === "saved"
+                ? "Saved. You can turn this off any time in your account."
+                : "Nothing is shared. You can change this any time in your account."}
+            </p>
+          ) : (
+            <form onSubmit={answer}>
+              <label className="flex cursor-pointer items-start gap-3 pt-1 text-left">
+                <input
+                  type="checkbox"
+                  checked={ticked}
+                  onChange={(e) => setTicked(e.target.checked)}
+                  className="mt-2 h-[14px] w-[14px] accent-[#B0843A]"
+                />
+                <span className="ig-fineprint">
+                  Show me Naira Flore pieces on social media. Your email, and your phone number if you add one, are
+                  scrambled before they leave this site and shared with Meta only to match you. You can turn this off
+                  any time in your account.
+                </span>
+              </label>
+              {consentError && (
+                <p className="ig-error" role="alert">
+                  {consentError}
+                </p>
+              )}
+              <button type="submit" className={`${outlineButton} mt-2`} disabled={consentState === "busy"}>
+                {consentState === "busy" ? "Saving…" : "Save my choice"}
+              </button>
+            </form>
+          )}
+        </div>
+      )}
+
+      {needs.join && joinState !== "joined" && joinState !== "already" && (
+        <p className="ig-fineprint">
+          You can join any time from{" "}
+          <Link className="ig-link" to="/innercircle">
+            the Inner Circle page
+          </Link>
+          .
+        </p>
+      )}
+      <button type="button" className={quietButton} onClick={close}>
+        {settled ? "Close" : "No, thank you"}
+      </button>
+    </section>
+  );
+};
+
+export default ArrivalRepair;
diff --git a/src/components/portal/AskAtelier.tsx b/src/components/portal/AskAtelier.tsx
