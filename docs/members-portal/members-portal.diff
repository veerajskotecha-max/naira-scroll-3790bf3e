@@ -0,0 +1,62 @@
+import { describe, expect, it } from "vitest";
+import { MAX_NOTES, NOTES, notesFor, readableNote, type AtelierNote } from "./notes";
+import { DROP_SPECIES } from "./drops";
+
+/* What is wrong with a note, for the owner (the garden itself only asks readableNote). */
+const DAY = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+const noteProblems = (n: AtelierNote): string[] => {
+  const out: string[] = [];
+  if (!/^[a-z0-9-]+$/.test(n.id)) out.push(`${n.id || "(no id)"}: the id is small letters, digits and dashes`);
+  if (!DAY.test(n.from)) out.push(`${n.id}: from is not a YYYY-MM-DD day`);
+  if (n.until !== undefined && (!DAY.test(n.until) || n.until < n.from)) out.push(`${n.id}: until is not a day on or after from`);
+  if (!n.title.trim() || n.title.length > 60) out.push(`${n.id}: the title is 1 to 60 characters`);
+  if (!n.body.length || n.body.some((p) => !p.trim())) out.push(`${n.id}: the body needs its words`);
+  if (!DROP_SPECIES.includes(n.flower)) out.push(`${n.id}: "${n.flower}" is not one of the garden's six species`);
+  if (!/^#[0-9a-f]{6}$/i.test(n.accent)) out.push(`${n.id}: the accent is a #rrggbb colour`);
+  if (out.length === 0 !== readableNote(n)) out.push(`${n.id}: the garden reads it differently`);
+  return out;
+};
+
+const note = (id: string, from: string, until?: string): AtelierNote => ({
+  id,
+  from,
+  ...(until ? { until } : {}),
+  title: "A word from the atelier",
+  body: ["One short line."],
+  flower: "jasmine star",
+  accent: "#E8C88A",
+});
+const ist = (stamp: string) => new Date(`${stamp}+05:30`);
+
+describe("notes from the atelier", () => {
+  /* The owner writes them. Delete this test when the first note goes in. */
+  it("ships empty until the owner writes one", () => {
+    expect(NOTES).toEqual([]);
+  });
+
+  it("holds only notes the garden can show", () => {
+    expect(NOTES.flatMap(noteProblems)).toEqual([]);
+    expect(new Set(NOTES.map((n) => n.id)).size).toBe(NOTES.length);
+  });
+
+  it("shows a note from its first IST day to its last, newest first, three at most", () => {
+    const list = [note("a", "2026-10-01"), note("b", "2026-11-01", "2026-11-05"), note("c", "2026-11-06"), note("d", "2026-09-01"), note("e", "2026-08-01")];
+    expect(notesFor(list, ist("2026-11-05T23:59:59")).map((n) => n.id)).toEqual(["b", "a", "d"]);
+    expect(notesFor(list, ist("2026-11-06T00:00:00")).map((n) => n.id)).toEqual(["c", "a", "d"]);
+    expect(notesFor(list, ist("2026-07-31T23:59:59"))).toEqual([]);
+    expect(notesFor(list, new Date("2026-11-05T18:30:00Z")).map((n) => n.id)[0]).toBe("c");
+    expect(MAX_NOTES).toBe(3);
+  });
+
+  it("shows nothing it cannot read", () => {
+    const bad = [
+      { ...note("x", "2026-11-01"), body: [] },
+      { ...note("y", "2026-11-01"), flower: "lily" as AtelierNote["flower"] },
+      { ...note("z", "2026-11-01"), accent: "gold" },
+      note("w", "2026-11-05", "2026-11-01"),
+    ];
+    for (const n of bad) expect(noteProblems(n).length).toBeGreaterThan(0);
+    expect(notesFor(bad, ist("2026-11-05T12:00:00"))).toEqual([]);
+    expect(notesFor([], new Date())).toEqual([]);
+  });
+});
