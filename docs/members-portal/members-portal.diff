+
+/*
+  Gathered, at the crown of her garden's arbour (Phase 6): a decoration in
+  a chunk of its own, fetched by the bed only once a piece of the Naira
+  flower is home (naira.p & 31), never on the gate and never before.
+
+  The pieces she found stand in their own places in the Naira flower's
+  shape, on the arch's crown where the small five-petal flower stood until
+  the first came home (the bed's Arbour lets its own go once this layer is
+  shown), so the flower forms as she finds them; no empty slot is ever
+  drawn. A piece found since she was last in the garden presses in once
+  (scale and opacity).
+  When all five are home, once on this phone, a gold-leaf line draws round
+  it (stroke-dashoffset, 1.2 s) and 24 blush and gold petals fall from the
+  crown, once any petals still in the air (the Doors') have landed; then it
+  is still art, edged in gold leaf for good. Each of those waits, at its
+  first frame, until the crown is in view below the shop's fixed header and
+  above the garden path: played under either, the gold leaf would be marked
+  drawn unseen.
+
+  Its layer lets every tap through (pointer-events none), so the garden's
+  tap blooms answer everywhere. It starts no loop, timer or frame callback:
+  the bed's one ambient loop stays the garden's only one. Under reduced
+  motion and Data Saver it is drawn final at once.
+
+  part="words" is the same flower in words, for "What's growing".
+*/
+
+type Props = { part: "bed" | "words"; bits: number; member: string };
+
+/* Where the bloom is, for the petals' fall: the petals' middle, in the bed's view. */
+const BLOOM_AT = { x: CROWN_AT.x + 0.53 * CROWN_W, y: CROWN_AT.y + 0.17 * CROWN_H };
+
+const LAYER: CSSProperties = { position: "absolute", inset: 0, pointerEvents: "none" };
+const ART: CSSProperties = { position: "absolute", inset: 0, width: "100%", height: "100%", overflow: "visible" };
+const PIECE: CSSProperties = { transformBox: "fill-box", transformOrigin: "50% 50%" };
+const SENTINEL: CSSProperties = {
+  position: "absolute",
+  left: `${(CROWN_AT.x / BED.w) * 100}%`,
+  top: `${(CROWN_AT.y / BED.h) * 100}%`,
+  width: `${(CROWN_W / BED.w) * 100}%`,
+  height: `${(CROWN_H / BED.h) * 100}%`,
+};
+
+const pathOf = (p: Piece) => (p.part === "stem" ? FLOWER_STEM : FLOWER_PETALS[p.part]);
+
+const CrownBed = ({ bits: account, member }: { bits: number; member: string }) => {
+  // Her account's pieces, and any found this visit that her account had no room for.
+  const bits = (account | foundThisVisit(member)) & WHOLE;
+  const whole = bits === WHOLE;
+  const found = PIECES.filter((p) => bits & (1 << p.bit));
+  const rootRef = useRef<HTMLDivElement>(null);
+  const seenRef = useRef<HTMLSpanElement>(null);
+  // Read once as it mounts: what presses in, and whether the gold leaf has drawn on this phone.
+  const [fresh] = useState(() => freshFinds(member) & bits);
+  const [drawn] = useState(() => hasDropFlag("crown", member));
+  const [still] = useState(stillMotion);
+
+  useLayoutEffect(() => {
+    const root = rootRef.current;
+    if (!root) return;
+    if (still) {
+      pressedIn(member, fresh);
+      return;
+    }
+    const made: Animation[] = [];
+    let k = 0;
+    root.querySelectorAll<SVGGElement>("[data-piece]").forEach((g) => {
+      const piece = PIECES.find((p) => p.key === g.dataset.piece);
+      if (!piece || !(fresh & (1 << piece.bit))) return;
+      const a = play(g, [{ transform: "scale(1.2)", opacity: 0 }, { transform: "scale(1)", opacity: 1 }], { duration: 560, delay: 160 + k++ * 150, easing: EASE_BLOOM, fill: "backwards" });
+      if (a) made.push(a);
+    });
+    const leaf = whole && !drawn;
+    let lastEdge: Animation | null = null;
+    if (leaf) {
+      root.querySelectorAll(".ig-crown-edge path").forEach((path, i) => {
+        const a = play(path, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 1200, delay: 240 + k * 150 + i * 60, easing: "cubic-bezier(0.45, 0, 0.25, 1)", fill: "backwards" });
+        if (a) {
+          made.push(a);
+          lastEdge = a;
+        }
+      });
+      const glow = play(root.querySelector(".ig-crown-glow"), [{ opacity: 0 }, { opacity: 1 }], { duration: 900, delay: 700 + k * 150, easing: EASE_REVEAL, fill: "backwards" });
+      if (glow) made.push(glow);
+    }
+    // Held at the first frame until the crown is in view: played unseen, the gold leaf would be marked drawn unseen.
+    made.forEach((a) => a.pause());
+    let fall: Animation[] = [];
+    let gone = false;
+    const start = () => {
+      made.forEach((a) => a.play());
+      pressedIn(member, fresh);
+      if (!leaf) return;
+      // The fall waits for any petals still in the air (the Doors'), so the screen never holds two bursts at once.
+      const began = performance.now();
+      const flying = Array.from(document.querySelectorAll(".ig-petal"), (el) => el.getAnimations?.() ?? []).flat();
+      void Promise.all(flying.map((a) => a.finished.catch(() => undefined))).then(() => {
+        if (gone) return;
+        const box = root.getBoundingClientRect();
+        const scale = box.width / BED.w;
+        fall = burstPetals(root, BLOOM_AT.x * scale, BLOOM_AT.y * scale, {
+          count: 24,
+          spread: 70 * Math.max(0.8, scale),
+          duration: 1400,
+          delay: Math.max(0, 1000 + k * 150 - (performance.now() - began)),
+          size: [7, 13],
+          ids: [PETAL_IDS[0], PETAL_SPARK, PETAL_IDS[4], PETAL_IDS[0], PETAL_SPARK, PETAL_IDS[1]],
+        });
+      });
+      // Drawn once on this phone: set when the last edge has drawn to its end (never on a cancel).
+      const last = lastEdge as Animation | null;
+      if (last) void last.finished?.then(() => setDropFlag("crown", member), () => undefined);
+      else setDropFlag("crown", member);
+    };
+    const sentinel = seenRef.current;
+    let io: IntersectionObserver | null = null;
+    if (sentinel && typeof IntersectionObserver !== "undefined") {
+      // In view means below the shop's fixed header (read once: 111 px on a phone) and above the garden path.
+      const top = Math.ceil(document.querySelector("header")?.getBoundingClientRect().bottom ?? 123);
+      io = new IntersectionObserver(
+        ([e]) => {
+          if (!e.isIntersecting) return;
+          io?.disconnect();
+          start();
+        },
+        { rootMargin: `-${top}px 0px -72px 0px`, threshold: 0.9 },
+      );
+      io.observe(sentinel);
+    } else start();
+    return () => {
+      gone = true;
+      io?.disconnect();
+      made.forEach((a) => a.cancel());
+      fall.forEach((a) => a.cancel());
+    };
+    // Once per mount: what was fresh, and whether it is whole, are read as it mounts.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [fresh, drawn]);
+
+  if (!found.length) return null;
+  return (
+    <div ref={rootRef} className="ig-bed-crown" style={LAYER} aria-hidden>
+      <span ref={seenRef} style={SENTINEL} />
+      <svg viewBox={`0 0 ${BED.w} ${BED.h}`} style={ART}>
+        {whole && (
+          <g transform={CROWN_PLACE} className="ig-crown-glow" fill="none" stroke={GOLD_LEAF} strokeOpacity=".35" strokeWidth={GLOW} strokeLinejoin="round">
+            {found.map((p) => (
+              <path key={p.key} d={pathOf(p)} />
+            ))}
+          </g>
+        )}
+        {/* Each piece found, in its own place in the flower's shape: nothing for the ones still out. */}
+        <g transform={CROWN_PLACE}>
+          {found.map((p) => (
+            <g key={p.key} data-piece={p.key} style={PIECE}>
+              <path d={pathOf(p)} fill={p.part === "stem" ? LEAF_SAGE : PETAL_BLUSH} stroke="var(--nf-accent-strong)" strokeWidth={HAIR} strokeLinejoin="round" />
+            </g>
+          ))}
+        </g>
+        {whole && (
+          <g transform={CROWN_PLACE} className="ig-crown-edge" fill="none" stroke={GOLD} strokeWidth={EDGE} strokeLinejoin="round">
+            {found.map((p) => (
+              <path key={p.key} d={pathOf(p)} pathLength={1} strokeDasharray="1 1" />
+            ))}
+          </g>
+        )}
+      </svg>
+    </div>
+  );
+};
+
+/* "What's growing": the flower at the crown in words, the rooms named, no number. */
+const CrownWords = ({ bits, member }: { bits: number; member: string }) => {
+  const all = (bits | foundThisVisit(member)) & WHOLE;
+  if (!all) return null;
+  return (
+    <li>
+      <strong>{WORDS.growing}</strong>
+      {crownSaid(all, bits).slice(WORDS.growing.length)}
+    </li>
+  );
+};
+
+const PetalCrown = ({ part, bits, member }: Props) => (part === "words" ? <CrownWords bits={bits} member={member} /> : <CrownBed bits={bits} member={member} />);
+
+export default PetalCrown;
