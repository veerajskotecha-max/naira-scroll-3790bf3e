+import { useEffect, useId, useMemo, useRef, useState, type KeyboardEvent, type PointerEvent as ReactPointerEvent } from "react";
+import type { Stone } from "@/lib/portal/stones";
+import { STONE_WORDS } from "@/lib/portal/stonePiece";
+import { mixHex } from "@/lib/portal/species";
+import { WAKE, stillMotion, useAmbient } from "@/lib/portal/motion";
+import {
+  CENTRE,
+  HEART_BOX,
+  PANEL,
+  REST,
+  SETTLE_MS,
+  SWEEP_MS,
+  clamp1,
+  cut,
+  dragToLight,
+  facetOpacities,
+  glintAt,
+  keyToLight,
