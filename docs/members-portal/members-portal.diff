@@ -0,0 +1,384 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import PieceCard from "@/components/portal/PieceCard";
+import GiftRing from "@/components/portal/GiftRing";
+import OccasionForm, { type SaveAnswer } from "@/components/portal/OccasionForm";
+import { BirthFlower } from "@/components/portal/BirthFlowers";
+import { HeartStone } from "@/components/portal/HeartStone";
+import { useMember, type BagLine } from "@/components/portal/MemberContext";
+import { eyebrow, outlineButton, primaryButton, quietButton, textLink } from "@/components/portal/styles";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { preorderWhatsAppUrl, type JewelPiece } from "@/data/jewellery";
+import { cartLineFor } from "@/lib/variants";
+import {
+  bandLabel,
+  bySoonest,
+  giftAdded,
+  giftDay,
+  giftDayEvent,
+  giftEdited,
+  giftReminderEvent,
+  giftRemoved,
+  giftRestored,
+  nextGiftIndex,
+  nextOn,
+  picksWithin,
+  refuseAnother,
+  sameGift,
+  whenSaid,
+  MONTHS_LONG,
+  REMIND_DAYS,
+  type Gift,
+} from "@/lib/portal/gifts";
+import { MAX_GIFTS, type MetaResult } from "@/lib/portal/memberMeta";
+import { googleCalendarUrl, icsHref } from "@/lib/portal/ics";
