index 0000000..592bc20
--- /dev/null
+++ b/src/components/portal/GardenBed.tsx
@@ -0,0 +1,480 @@
+import { forwardRef, useCallback, useEffect, useImperativeHandle, useMemo, useRef, type ReactNode } from "react";
+import { ARCH, BANDS, BED, boxOf, giftsOnArbour, layoutGarden, plantBed, RING_RX, RING_RY, RING_SOIL, ROW_SHADE, type GiftDate, type Plant, type PressedFlower, type SavedSprig } from "@/lib/portal/gardenLayout";
+import { SPECIES, petalTransform } from "@/lib/portal/species";
+import { LEAF_SAGE } from "@/lib/portal/brandFlower";
+import { stoneForMonth, type Stone } from "@/lib/portal/stones";
+import { NIGHT_GROUND, type SkyHour } from "@/lib/portal/sky";
+import { AmbientLoopContext, EASE_BLOOM, EASE_REVEAL, play, stillMotion, useAmbient, useLoop } from "@/lib/portal/motion";
+import { chainPath, leavesAlong, mirrorSegs, pointOn, type Seg } from "@/lib/portal/curves";
+import FlowerDraw from "./FlowerDraw";
+import { StoneHead, StonePlant } from "./StoneArt";
+import { useTapBloom, withTouch } from "./useTapBloom";
+import { lazyRoom, useDecoration } from "@/lib/portal/lazyRoom";
+
+/*
+  Her garden bed. Every plant is its own small layer placed over a 390 x 560
+  view, so the sway (at most 24 of them, ±2.5° about the stem base) moves
+  only transform on the compositor; the soil and everything still is painted
+  once. The plants stand in twelve bands from the back, and the bloom-in
+  grows each band up from its soil line: twelve animations, not one per
+  plant, which a mid-range phone can run beside the Doors. The sway stops off
+  screen, on a hidden tab and after 20 s without a touch, and never starts
+  under reduced motion.
+
+  Her own two plants answer a tap of their own: the Naira flower draws itself
+  again in gold, and her stone flower glints and lets go a few petals in her
+  month's colour (drawn by gardenTouch.ts, with the tap blooms: a chunk
+  fetched as the bed mounts, never part of its first paint).
+
+  The bed keeps Indian time (Phase 4): at night the arbour's doorway is ink
+  from the first paint (the labels under the soil stay on ivory), and the sky's own layers (the
+  moon, the fireflies, the dawn mist) and a festival's dressing are drawn in
+  it, behind the plants or over them. They join the bed's one ambient loop,
+  so the fireflies rest with the sway: no second loop on the screen.
+
+  Her gift dates (Phase 4) bloom on the arbour's vines, each a small stone
+  flower in its month's colour, her year round the doorway (gardenLayout's
+  giftsOnArbour), drawn once over the plants that lean on the posts, and
+  stand still.
+
+  The Naira flower's pieces she has found in her rooms (Phase 6, Gathered)
+  stand at the arbour's crown in their own places in its shape, where the
+  small five-petal flower stood until the first came home (PetalCrown, a
+  chunk of its own, fetched only once one has; one still layer that lets
+  every tap through). When all five are home it is edged in gold leaf.
+
+  Her confirmed orders (Phase 5) grow in the front row: a gold-leaf rose
+  each, dated with its order (GoldRose, a chunk of its own, fetched only
+  when the garden home asks for it, never on the gate; it grows once, then
+  stands, and is never counted).
+*/
+
+/** Her gold-leaf roses, and their words for "What's growing": fetched once the garden home wants them. */
+export const GoldRose = lazyRoom(() => import("./GoldRose"));
+/** The Naira flower re-forming at the arbour's crown (Phase 6, Gathered), and its words: fetched only once a piece is home. */
+export const PetalCrown = lazyRoom(() => import("./PetalCrown"));
+
+const STEM_HEAD: Record<0 | 1 | 2, [number, number]> = { 0: [0, -88], 1: [-8, -88], 2: [8, -88] };
+const BUD_TONES = ["#FFBDA8", "#F3D9C6", "#E5B9A4", "#FFE0D3"];
+
+/* The bed's shapes, stamped by every plant. */
+export const GardenSymbols = () => (
+  <>
+    <symbol id="ig-stem-0" viewBox="-30 -112 60 112">
+      <path d="M0 0C-2-28 3-56 0-84" fill="none" stroke={LEAF_SAGE} strokeWidth="1.6" />
+      <ellipse cx="-8" cy="-30" rx="9" ry="3.4" transform="rotate(-32 -8 -30)" fill={LEAF_SAGE} />
+      <ellipse cx="8" cy="-52" rx="8" ry="3.1" transform="rotate(34 8 -52)" fill={LEAF_SAGE} />
+    </symbol>
+    <symbol id="ig-stem-1" viewBox="-30 -112 60 112">
+      <path d="M0 0C2-30-10-58-8-84" fill="none" stroke={LEAF_SAGE} strokeWidth="1.6" />
+      <ellipse cx="6" cy="-28" rx="9" ry="3.4" transform="rotate(30 6 -28)" fill={LEAF_SAGE} />
+      <ellipse cx="-12" cy="-52" rx="8" ry="3.1" transform="rotate(-30 -12 -52)" fill={LEAF_SAGE} />
+    </symbol>
