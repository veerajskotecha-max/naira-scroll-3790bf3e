+                Look up
+              </button>
+            </div>
+          ) : (
+            <p className="ig-fineprint ig-lookup">
+              <Link className={textLink} to="/members/stone">
+                Tell us your month, and your flower joins the stars →
+              </Link>
+            </p>
+          ))}
+        {night && stone && looking === "open" && <StarSheet month={stone.month} onClose={closeSky} />}
+        {night && stone && (looking === "opening" || looking === "failed") && (
+          <p className="ig-fineprint" role="status">
