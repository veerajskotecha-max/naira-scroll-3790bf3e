index 0000000..15ef760
--- /dev/null
+++ b/src/components/portal/gardenTouch.ts
@@ -0,0 +1,126 @@
+import { SPECIES, petalTransform, type Species } from "@/lib/portal/species";
+import { EASE_REVEAL, play } from "@/lib/portal/motion";
+import { drawFlower } from "./FlowerDraw";
+import { burstPetals } from "./PetalBurst";
+import { PETAL_HUE, PETAL_SPARK } from "./PetalSymbols";
+
+/*
+  What a touch on the garden does: a flower opening where she taps (on the
+  gate too), the Naira flower drawing itself again in gold, and her stone
+  flower glinting and letting go a few petals in her month's colour. None of
+  it is drawn at first paint, so it is a chunk of its own, fetched the moment
+  a garden or the gate that can bloom mounts (useTapBloom); a tap that comes
+  before it has arrived is answered as soon as it does.
+
+  Six species, never the same twice running, leaning to the warm ones (rose,
+  camellia, marigold) that hold on the ivory bed. Each bloom is two layers,
+  the outer whorl and the inner one over it, so both turn and scale on the
+  compositor (an animated SVG group would be repainted on the main thread
+  every frame), and each is removed when it has opened and faded.
+*/
+
+const SVG = "http://www.w3.org/2000/svg";
+/* Rose, wild five, jasmine star, marigold, camellia, teal bud. */
+const WEIGHTS = [3, 1, 1, 2.5, 3, 1];
+const TOTAL = WEIGHTS.reduce((s, w) => s + w, 0);
+
+const el = (name: string, attrs: Record<string, string | number>) => {
+  const node = document.createElementNS(SVG, name);
+  for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v));
+  return node;
+};
+
+const whorlSvg = (size: number) => el("svg", { viewBox: "-50 -50 100 100", width: size, height: size });
+
+const whorl = (svg: Element, species: Species, r: number, offset: number, palette: readonly string[]) => {
+  for (let i = 0; i < species.petals; i++) {
+    const deg = offset + (i * 360) / species.petals;
+    svg.appendChild(el("path", { d: species.d, fill: palette[i % palette.length], transform: petalTransform(deg, r) }));
+  }
+};
+
+const bloomNode = (species: Species, x: number, y: number, tilt: number, scale: number) => {
+  const size = Math.round(86 * scale);
+  const node = document.createElement("div");
+  node.className = "ig-bloom";
+  node.setAttribute("aria-hidden", "true");
+  node.style.cssText = `left:${x}px;top:${y}px;width:${size}px;height:${size}px`;
+  const outer = whorlSvg(size);
+  whorl(outer, species, 40, tilt, species.palette);
+  node.appendChild(outer);
+  const innerBox = document.createElement("div");
+  innerBox.className = "ig-bloom-in";
+  const inner = whorlSvg(size);
+  if (species.inner) whorl(inner, species, 40 * species.inner, tilt + 180 / species.petals, [...species.palette].reverse());
+  inner.appendChild(el("circle", { r: 6.5, fill: species.core }));
+  inner.appendChild(el("circle", { r: 2.4, cx: -1.6, cy: -1.6, fill: "#FFF8EE" }));
+  innerBox.appendChild(inner);
+  node.appendChild(innerBox);
+  return node;
+};
+
+const pickSpecies = (last: number) => {
+  for (let tries = 0; tries < 4; tries++) {
+    let r = Math.random() * TOTAL;
+    let idx = 0;
+    while ((r -= WEIGHTS[idx]) > 0 && idx < WEIGHTS.length - 1) idx++;
+    if (idx !== last) return idx;
+  }
+  return (last + 1) % SPECIES.length;
+};
+
+/**
+ * Opens one flower at (x, y) in the root's own box, never the species of
+ * `last`; `gone` is told when it has faded and been removed. The caller
+ * keeps the count of blooms alive.
+ */
+export const openBloom = (root: HTMLElement, x: number, y: number, last: number, gone: (node: HTMLElement) => void): { node: HTMLElement; species: number } => {
+  const idx = pickSpecies(last);
+  const species = SPECIES[idx];
+  const node = bloomNode(species, x, y, Math.random() * 360, 0.82 + Math.random() * 0.36);
+  root.appendChild(node);
+
+  const dur = species.dur * 1000;
+  /* Linear overall, eased per stage: opens fast, holds in full colour,
+     then fades. (One ease-out over the whole run would reach the fade
+     a third of the way in, and the bloom would be pale most of its life.) */
+  const a = play(
+    node,
+    [
+      { transform: "translate(-50%,-50%) scale(.15) rotate(-50deg)", opacity: 0, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
+      { transform: "translate(-50%,-50%) scale(1.04) rotate(0deg)", opacity: 1, offset: 0.3, easing: "ease-in-out" },
+      { transform: "translate(-50%,-50%) scale(1) rotate(5deg)", opacity: 1, offset: 0.7, easing: "cubic-bezier(0.42, 0, 1, 1)" },
+      { transform: "translate(-50%,-50%) scale(1.08) rotate(9deg)", opacity: 0 },
+    ],
+    { duration: dur, easing: "linear", fill: "both" },
+  );
+  play(node.querySelector(".ig-bloom-in"), [{ transform: "rotate(-30deg) scale(.6)" }, { transform: "rotate(0deg) scale(1)" }], {
+    duration: dur * 0.5,
+    easing: "cubic-bezier(0.34, 1.56, 0.64, 1)",
+  });
+  const done = () => {
+    node.remove();
+    gone(node);
+  };
+  if (a) {
+    a.onfinish = done;
+    a.oncancel = done;
+  } else {
+    window.setTimeout(done, dur);
+  }
+  return { node, species: idx };
+};
+
+/** The Naira flower draws itself again in gold, and its label lifts a little. */
+export const retrace = (naira: HTMLElement, label: Element | null | undefined): void => {
+  drawFlower(naira, { duration: 700 });
+  play(label, [{ transform: "translateX(-50%) scale(1)" }, { transform: "translateX(-50%) scale(1.08)", offset: 0.4 }, { transform: "translateX(-50%) scale(1)" }], { duration: 700, easing: EASE_REVEAL });
+};
+
+/** Her stone flower glints and lets go a few petals in her month's colour. */
+export const glint = (root: HTMLElement, plant: HTMLElement, hue: string): void => {
+  play(plant.querySelector(".ig-glint"), [{ opacity: 0.4, transform: "scale(.4) rotate(0deg)" }, { opacity: 1, transform: "scale(1.7) rotate(45deg)", offset: 0.5 }, { opacity: 1, transform: "scale(1) rotate(90deg)" }], { duration: 640, easing: "ease-out" });
+  const head = plant.querySelector(".ig-stonehead")?.getBoundingClientRect();
+  const box = root.getBoundingClientRect();
+  if (head) burstPetals(root, head.left - box.left + head.width / 2, head.top - box.top + head.height / 2, { count: 9, spread: 70, ids: [PETAL_HUE, PETAL_HUE, PETAL_SPARK], color: hue, size: [9, 15] });
+};
