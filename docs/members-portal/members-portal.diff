index 0000000..7395f6f
--- /dev/null
+++ b/src/lib/portal/previewDrops.ts
@@ -0,0 +1,130 @@
+import type { Drop } from "./drops";
+import { DAY, MINUTE } from "./dropPhase";
+import { istParts, toIstIso } from "./ist";
+
+/*
+  DEVELOPMENT ONLY: PREVIEW DROPS, NOT REAL RELEASES.
+
+  The real manifest (drops.ts) ships empty until the owner gives the first
+  drop. To see the drop rooms in every state on this machine, the preview
+  member (preview.ts, itself behind import.meta.env.DEV and localhost) can
+  stand in these fixtures:
+
+    /members/drops?portalPreview=1&drop=sealed     the bud on its Bloom Clock
+    &drop=moved      the date moved: the old one struck through
+    &drop=members    open for a first look (the unboxing on the first visit)
+    &drop=public     now on the shop
+    &drop=arriving   the time has passed but its pieces are not on the shop
+                     (simulated by treating them as unlisted)
+    &drop=vault      the drop has bloomed and rests in the Vault
+    &dropAt=<ISO>    open the main fixture at this time instead (sealed and
+                     moved only), to watch a petal open at its threshold
+    &unlisted=<handle>  treat one piece as not on the shop yet ("Arriving")
+
+  Every piece is a real, published Naira Petite listing read from the live
+  shop (16 handles checked against the Storefront on 5 Nov 2026), so the
+  rooms show real photos and live prices. The titles and stories say they
+  are previews. Nothing here reaches a production build: the only way in is
+  preview.ts, which a production build drops (the build check greps dist for
+  "fixture-drop" and "portalPreview").
+*/
+
+export const FIXTURE_PREFIX = "fixture-drop-";
+export const PREVIEW_DROP_STATES = ["sealed", "moved", "members", "public", "arriving", "vault"] as const;
+export type PreviewDropState = (typeof PREVIEW_DROP_STATES)[number];
+
+/** 8:00 pm IST on the day `days` from `now`, as an instant. */
+const eveningAfter = (now: number, days: number): number => {
+  const p = istParts(new Date(now + days * DAY));
+  // 20:00 IST is 14:30 UTC on the same calendar day.
+  return Date.UTC(p.year, p.month - 1, p.day, 14, 30);
+};
+
+const roundMinute = (ms: number) => Math.round(ms / MINUTE) * MINUTE;
+
+const FLEUR_HANDLES = [
+  "clover-garland-necklace",
+  "clover-garland-bracelet",
+  "petite-heart-trio-necklace",
+  "birthstone-heart-necklace",
+  "riviere-classique-necklace",
+  "orb-cable-cuff",
+];
+
+const fleur = (membersFrom: number, everyoneFrom: number, movedFrom?: number): Drop => ({
+  id: `${FIXTURE_PREFIX}fleur`,
+  title: "Petite Fleur (preview)",
+  species: "camellia",
+  accent: "#D9837B",
+  story: ["A preview drop, made for development: not a real release.", "Real pieces from the shop, with their live prices.", "Clover, hearts and a birthstone for every month."],
+  membersFrom: toIstIso(membersFrom),
+  everyoneFrom: toIstIso(everyoneFrom),
+  handles: FLEUR_HANDLES,
+  leadHandle: "clover-garland-necklace",
+  // The listing's own macro photo of the clovers, from the live shop.
+  teaser: { imageUrl: "https://cdn.shopify.com/s/files/1/0680/9606/5698/files/76f93c90-06e6-4260-aa22-fc9c14b84bfa.jpg?v=1793699214", public: false },
+  reservable: ["clover-garland-necklace", "petite-heart-trio-necklace"],
+  // The listing's own spelling, for while the shop does not show it (the "arriving" preview).
+  names: { "riviere-classique-necklace": "Rivière Classique Necklace" },
+  ...(movedFrom ? { movedFrom: toIstIso(movedFrom) } : {}),
+});
+
+/* Two earlier previews, so the Vault has a wall: one with a sold-out piece. */
+const carre = (now: number): Drop => ({
+  id: `${FIXTURE_PREFIX}carre`,
+  title: "Carré (preview)",
+  species: "marigold",
+  accent: "#C9963E",
+  story: ["A preview drop, made for development: not a real release.", "Square-cut colour for the wrist."],
+  membersFrom: toIstIso(eveningAfter(now, -40)),
+  everyoneFrom: toIstIso(eveningAfter(now, -38)),
+  handles: ["amethyst-carre-bracelet", "champagne-carre-bracelet", "sapphire-carre-bracelet", "blush-carre-bracelet", "watch-link-strap-bracelet"],
+  leadHandle: "sapphire-carre-bracelet",
+});
+
+const prism = (now: number): Drop => ({
+  id: `${FIXTURE_PREFIX}prism`,
+  title: "Prism (preview)",
+  species: "teal bud",
+  accent: "#4F8A90",
+  story: ["A preview drop, made for development: not a real release.", "Pear drops that catch the light."],
+  membersFrom: toIstIso(eveningAfter(now, -66)),
+  everyoneFrom: toIstIso(eveningAfter(now, -64)),
+  handles: ["prism-pear-drop-hoops", "prism-pear-drop-necklace", "lotus-pear-drop-studs", "solitaire-drop-huggies"],
+  leadHandle: "prism-pear-drop-necklace",
+});
+
+export type PreviewDrops = { drops: Drop[]; unlisted: string[] };
+
+export const readPreviewDrops = (search: string, now: number = Date.now()): PreviewDrops | null => {
+  const q = new URLSearchParams(search);
+  const state = q.get("drop") as PreviewDropState | null;
+  if (!state || !(PREVIEW_DROP_STATES as readonly string[]).includes(state)) return null;
+  const at = Date.parse(q.get("dropAt") ?? "");
+  const sealedAt = Number.isNaN(at) ? eveningAfter(now, 2) : roundMinute(at);
+  let main: Drop;
+  switch (state) {
+    case "sealed":
+      main = fleur(sealedAt, sealedAt + 2 * DAY);
+      break;
+    case "moved":
+      main = fleur(Number.isNaN(at) ? eveningAfter(now, 9) : sealedAt, (Number.isNaN(at) ? eveningAfter(now, 9) : sealedAt) + 2 * DAY, Number.isNaN(at) ? eveningAfter(now, 2) : sealedAt - 7 * DAY);
+      break;
+    case "members":
+    case "arriving": {
+      const opened = roundMinute(now - 20 * MINUTE);
+      main = fleur(opened, opened + 2 * DAY);
+      break;
+    }
+    case "public":
+      main = fleur(eveningAfter(now, -3), eveningAfter(now, -1));
+      break;
+    case "vault":
+    default:
+      main = fleur(eveningAfter(now, -18), eveningAfter(now, -16));
+  }
+  const masked = state === "arriving" ? [...FLEUR_HANDLES] : [];
+  const one = q.get("unlisted");
+  if (one && !masked.includes(one)) masked.push(one);
+  return { drops: [prism(now), carre(now), main], unlisted: masked };
+};
