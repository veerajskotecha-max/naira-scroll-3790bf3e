index 0000000..4d7174c
--- /dev/null
+++ b/src/lib/auth/errors.ts
@@ -0,0 +1,53 @@
+/*
+  Supabase's sign-in errors, said plainly. The codes are Supabase Auth's
+  (error.code); older servers send only a message, so the common messages
+  are matched too. Anything unrecognised keeps Supabase's own words rather
+  than inventing a cause. None of these says whether an email has an
+  account, except where Supabase itself already has (an existing account at
+  sign-up).
+*/
+
+export type AuthErrorLike = { code?: string | null; message?: string | null; status?: number | null; name?: string | null };
+
+const BY_CODE: Record<string, string> = {
+  invalid_credentials: "That email and password don't match. Check them, or reset your password below.",
+  email_not_confirmed: "Please confirm your email first: open the link we sent when you registered.",
+  user_already_exists: "An account already uses this email. Sign in, or reset your password.",
+  email_exists: "An account already uses this email. Sign in, or reset your password.",
+  same_password: "That is the password you already have. Please choose a new one.",
+  over_email_send_rate_limit: "Too many emails for now. Please wait a few minutes and try again.",
+  over_request_rate_limit: "Too many tries for now. Please wait a few minutes and try again.",
+  otp_expired: "That code has expired or has already been used. Ask for a new one.",
+  otp_disabled: "We couldn't send a code to this email. If you are new here, please register first.",
+  signup_disabled: "New accounts can't be made just now. Please try again later.",
+  session_not_found: "Your reset link has run out. Ask for a new one below.",
+  session_expired: "Your reset link has run out. Ask for a new one below.",
+  reauthentication_needed: "For your safety, please ask for a new reset link and use it straight away.",
+  email_address_invalid: "Please enter a valid email address.",
+};
+
+const BY_MESSAGE: [RegExp, string][] = [
+  [/invalid login credentials/i, BY_CODE.invalid_credentials],
+  [/email not confirmed/i, BY_CODE.email_not_confirmed],
+  [/already (been )?registered|already exists/i, BY_CODE.user_already_exists],
+  [/should be different from the old password/i, BY_CODE.same_password],
+  [/rate limit|too many requests/i, BY_CODE.over_request_rate_limit],
+  [/token has expired|otp.*(expired|invalid)|invalid.*otp/i, BY_CODE.otp_expired],
+  [/signups not allowed for otp/i, BY_CODE.otp_disabled],
+  [/auth session missing/i, BY_CODE.session_not_found],
+  [/failed to fetch|network|load failed/i, "We couldn't reach the sign-in service. Check your connection and try again."],
+];
+
+export const honestAuthError = (error: AuthErrorLike | null | undefined): string => {
+  if (!error) return "Something went wrong. Please try again.";
+  const message = (error.message ?? "").trim();
+  /* A weak password: Supabase's own sentence says what it wants (a length,
+     or "known to be weak"), so it is kept. */
+  if (error.code === "weak_password") return message || "Please choose a stronger password.";
+  if (error.code && BY_CODE[error.code]) return BY_CODE[error.code];
+  if (error.name === "AuthRetryableFetchError" || error.status === 0) {
+    return "We couldn't reach the sign-in service. Check your connection and try again.";
+  }
+  for (const [pattern, said] of BY_MESSAGE) if (pattern.test(message)) return said;
+  return message || "Something went wrong. Please try again.";
+};
