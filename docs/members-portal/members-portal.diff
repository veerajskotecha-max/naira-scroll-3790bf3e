+import { useMemo } from "react";
+import type { Drop } from "@/lib/portal/drops";
+import { googleCalendarUrl, icsHref, REMINDER_MINUTES, type CalendarEvent } from "@/lib/portal/ics";
+import { outlineButton, textLink } from "./styles";
+
+/*
+  "Add to my calendar": Google Calendar's own add-event page first, since it
+  is a plain link and opens inside Instagram's browser too; then the .ics
+  file (Apple Calendar, Outlook) with a reminder 30 minutes before. Inside
+  Instagram or Facebook's browser a file download goes nowhere, so the .ics
+  is not offered there. (The check is spelt out here rather than borrowed
+  from lib/portal/inAppBrowser, which Auth also imports: shared by two
+  routes, it would be split into a chunk of its own and change Auth's.)
+*/
+
+const IN_APP = /\bInstagram\b|\bFB(AN|AV)\b|FB_IAB|\[FB/i;
+
+const CalendarButton = ({ drop }: { drop: Drop }) => {
+  const event = useMemo<CalendarEvent>(
+    () => ({
+      uid: `drop-${drop.id}`,
+      title: `Naira Flore: ${drop.title} opens, a first look in the Inner Garden`,
+      start: drop.membersFrom,
+      minutes: 60,
+      details: "Members of the Inner Garden see the drop first. Prices and availability are on the shop when it opens.",
+      url: `https://nairaflore.com/members/drops/${drop.id}`,
+    }),
+    [drop.id, drop.title, drop.membersFrom],
+  );
+  const inApp = typeof navigator !== "undefined" && IN_APP.test(navigator.userAgent ?? "");
+  return (
+    <div className="ig-cal">
+      <a className={outlineButton} href={googleCalendarUrl(event)} target="_blank" rel="noopener noreferrer">
+        Add to my calendar
+      </a>
+      {!inApp && (
+        <a className={textLink} href={icsHref(event)} download={`naira-drop-${drop.id}.ics`}>
+          Apple or Outlook · {REMINDER_MINUTES} min reminder
+        </a>
+      )}
+    </div>
+  );
+};
+
+export default CalendarButton;
diff --git a/src/components/portal/CardCalibrate.tsx b/src/components/portal/CardCalibrate.tsx
new file mode 100644
index 0000000..228d20c
--- /dev/null
+++ b/src/components/portal/CardCalibrate.tsx
@@ -0,0 +1,245 @@
+import { useEffect, useLayoutEffect, useRef, useState, type KeyboardEvent, type PointerEvent as ReactPointerEvent } from "react";
+import { CAL_LEFT, CAL_TOP, CARD_MM, PX_PER_MM_RANGE, atRoomLimit, calRoomMax, calibrationFrom, type CardEdge } from "@/lib/portal/sizer";
+import { primaryButton, quietButton } from "./styles";
+
+/*
+  The ring sizer's first step: a bank card held flat to the screen tells the
+  page how long a millimetre is here. The card lies upright with its top-left
+  corner in the gold corner, and she drags the gold grip until the line meets
+  the card's right edge (its short side, 53.98 mm, across the screen). The
+  stage runs edge to edge, so the short side fits every phone 360 px wide or
+  more; on a wide screen the long side (85.60 mm, down) can be used instead.
+
+  The stage is the limit of what can be measured: a line held at its edge has
+  stopped short of a card longer than the screen, and a reading taken there
+  would draw every circle too small. So at the edge "The line meets the card"
+  is refused, she is told why, and she is offered another way.
+
+  The whole step fits the first screen: the stage is a short band (the card
+  hangs on below it, and she lifts it to confirm), the nudges sit in the band
+  above the card, where her free hand reaches them while the other holds the
+  card, and the confirm button comes straight after. The stage refuses touch
+  gestures (no scroll, no pinch-zoom), so nothing slides under a card she is
+  holding. The outline scales and the line moves with transform only. Arrow
+  keys nudge by a pixel (with Shift, by five); Home and End go to either end.
+*/
+
+type OtherWay = "thread" | "known";
+
+type Props = {
+  /** The last calibration on this screen, to start from. */
+  initial: number | null;
+  onDone: (pxPerMm: number) => void;
+  onCancel: () => void;
+  /** When the card cannot be measured on this screen: the thread, or the size she knows. */
+  onOtherWay?: (way: OtherWay) => void;
+};
+
+/* A typical phone's CSS pixels per millimetre: the outline is drawn at this
+   size and scaled from it, so its hairline stays near 1 px. */
+const GUESS = 6;
+/* The long side is offered only where a card can lie down the screen with room to spare. */
+const WIDE = 600;
+
+const wide = () => {
+  try {
+    return window.innerWidth >= WIDE;
+  } catch {
+    return false;
+  }
+};
+
+const CardCalibrate = ({ initial, onDone, onCancel, onOtherWay }: Props) => {
+  const [edge, setEdge] = useState<CardEdge>("short");
+  const [len, setLen] = useState(() => (initial ?? GUESS) * CARD_MM.short);
+  // Until she moves the line, a first guess opens a little short of the edge: the edge is only ever reached by her.
+  const [touched, setTouched] = useState(false);
+  const [room, setRoom] = useState({ w: 360, h: 220 });
+  const [canLong] = useState(wide);
+  const stageRef = useRef<HTMLDivElement>(null);
+  const gripRef = useRef<HTMLDivElement>(null);
+  const switched = useRef(false);
+  const drag = useRef<{ start: number; from: number; id: number } | null>(null);
+
+  // The line can travel only as far as the stage.
+  useLayoutEffect(() => {
+    const el = stageRef.current;
+    if (!el) return;
+    const measure = () => setRoom({ w: el.clientWidth || 360, h: el.clientHeight || 220 });
+    measure();
+    window.addEventListener("resize", measure);
+    return () => window.removeEventListener("resize", measure);
+  }, [edge]);
+
+  /* While the card lies on the screen the garden path is put away: the card
+     hangs over the foot of the screen, and a thumb holding it should never
+     land on another room. */
+  useEffect(() => {
+    const root = document.documentElement;
+    root.setAttribute("data-ig-card", "");
+    return () => root.removeAttribute("data-ig-card");
+  }, []);
+
+  /* After a switch of side: the step back at the top of the screen, and the
+     new grip focused, so a screen reader hears the new slider. */
+  useEffect(() => {
+    if (!switched.current) return;
+    switched.current = false;
+    stageRef.current?.closest(".ig-sizer")?.scrollIntoView?.({ block: "start" });
+    gripRef.current?.focus({ preventScroll: true });
+  }, [edge]);
+
+  const mm = CARD_MM[edge];
+  const top = CAL_TOP[edge];
+  const roomMax = Math.max(40, calRoomMax(edge, room.w, room.h));
+  const max = Math.min(PX_PER_MM_RANGE[1] * mm, roomMax);
+  const min = Math.min(PX_PER_MM_RANGE[0] * mm, max);
+  const clamp = (v: number) => Math.max(min, Math.min(max, v));
+  const shown = clamp(touched ? len : Math.min(len, max - 12));
+  const ppm = shown / mm;
+  const axis = (e: { clientX: number; clientY: number }) => (edge === "long" ? e.clientY : e.clientX);
+  const limited = atRoomLimit(shown, edge, roomMax);
+  const value = calibrationFrom(shown, edge, roomMax);
+
+  const move = (v: number) => {
+    setTouched(true);
+    setLen(clamp(v));
+  };
+
+  const switchEdge = (next: CardEdge) => {
+    switched.current = true;
+    setTouched(false);
+    setLen((ppm || GUESS) * CARD_MM[next]);
+    setEdge(next);
+  };
+
+  const onDown = (e: ReactPointerEvent<HTMLDivElement>) => {
+    drag.current = { start: axis(e), from: shown, id: e.pointerId };
+    try {
+      e.currentTarget.setPointerCapture(e.pointerId);
+    } catch {
+      /* capture is a nicety */
+    }
+  };
+  const onMove = (e: ReactPointerEvent<HTMLDivElement>) => {
+    const d = drag.current;
+    if (!d || d.id !== e.pointerId) return;
+    move(d.from + axis(e) - d.start);
+  };
+  const onUp = () => {
+    drag.current = null;
+  };
+  const onKey = (e: KeyboardEvent<HTMLDivElement>) => {
+    const step = e.shiftKey ? 5 : 1;
+    if (e.key === "ArrowDown" || e.key === "ArrowRight") move(shown + step);
+    else if (e.key === "ArrowUp" || e.key === "ArrowLeft") move(shown - step);
+    else if (e.key === "Home") move(min);
+    else if (e.key === "End") move(max);
+    else return;
+    e.preventDefault();
+  };
+
+  const line = edge === "long" ? `translate(0px, ${shown.toFixed(1)}px)` : `translate(${shown.toFixed(1)}px, 0px)`;
+  const nudges = (
+    <div className={`ig-cal-nudge ig-cal-nudge--${edge}`}>
+      <button type="button" className="ig-sz-step" onClick={() => move(shown - 1)} aria-label="Move the line in a little">
+        −
+      </button>
+      <button type="button" className="ig-sz-step" onClick={() => move(shown + 1)} aria-label="Move the line out a little">
+        +
+      </button>
+    </div>
+  );
+
+  return (
+    <div className="ig-cal">
+      <div ref={stageRef} className="ig-cal-stage" data-edge={edge}>
+        <span className="ig-cal-corner" style={{ left: CAL_LEFT, top }} aria-hidden />
+        <svg
+          className="ig-cal-card"
+          viewBox={`0 0 ${(CARD_MM.short * GUESS).toFixed(1)} ${(CARD_MM.long * GUESS).toFixed(1)}`}
+          width={CARD_MM.short * GUESS}
+          height={CARD_MM.long * GUESS}
+          style={{ left: CAL_LEFT, top, transform: `scale(${(ppm / GUESS).toFixed(4)})` }}
+          aria-hidden
+        >
+          <rect x="0" y="0" width={CARD_MM.short * GUESS} height={CARD_MM.long * GUESS} />
+        </svg>
+        <p className="ig-cal-hint" style={{ left: CAL_LEFT + 14, top: top + 14 }}>
+          {`Lay any bank card flat here, upright, its top-left corner in the gold corner. Drag the gold grip until the line meets the card's ${edge === "long" ? "bottom" : "right"} edge, then lift the card.`}
+        </p>
+        {edge === "short" && nudges}
+        <div
+          className={`ig-cal-line ig-cal-line--${edge}`}
+          style={edge === "long" ? { top, transform: line } : { left: CAL_LEFT, transform: line }}
+        >
+          <div
+            ref={gripRef}
+            className="ig-cal-grip"
+            role="slider"
+            tabIndex={0}
+            aria-label={edge === "long" ? "The card's bottom edge" : "The card's right edge"}
+            aria-orientation={edge === "long" ? "vertical" : "horizontal"}
+            aria-valuemin={Math.round(min)}
+            aria-valuemax={Math.round(max)}
+            aria-valuenow={Math.round(shown)}
+            aria-valuetext={limited ? "At the edge of the screen" : `${Math.round(((shown - min) / Math.max(1, max - min)) * 100)}% of the way to the edge of the screen`}
+            onPointerDown={onDown}
+            onPointerMove={onMove}
+            onPointerUp={onUp}
+            onPointerCancel={onUp}
+            onKeyDown={onKey}
+          >
+            <span aria-hidden />
+          </div>
+        </div>
+      </div>
+      {edge === "long" && nudges}
+      {/* Always in place, so the refusal is spoken when it appears. */}
+      <p className="ig-cal-note" role="status">
+        {!limited
+          ? ""
+          : edge === "long"
+            ? "This screen is shorter than the card, so the line cannot reach its bottom edge. Use the card's short side instead."
+            : "The card is wider than this screen, so the line cannot reach its edge here. Measure with a thread, or choose the size you know."}
+      </p>
+      {limited && edge === "long" ? (
+        <button type="button" className={primaryButton} onClick={() => switchEdge("short")}>
+          Use the card's short side
+        </button>
+      ) : limited && onOtherWay ? (
+        <div className="ig-cal-more">
+          <button type="button" className={primaryButton} onClick={() => onOtherWay("thread")}>
+            With a thread
+          </button>
+          <button type="button" className={quietButton} onClick={() => onOtherWay("known")}>
+            I know my size
+          </button>
+        </div>
+      ) : (
+        <button type="button" className={primaryButton} disabled={!value} onClick={() => value && onDone(value)}>
+          The line meets the card
+        </button>
+      )}
+      <div className="ig-cal-more">
+        {edge === "long" && !limited ? (
+          <button type="button" className={quietButton} onClick={() => switchEdge("short")}>
+            Use the card's short side
+          </button>
+        ) : (
+          edge === "short" &&
+          canLong && (
+            <button type="button" className={quietButton} onClick={() => switchEdge("long")}>
+              Use the card's long side
+            </button>
+          )
+        )}
+        <button type="button" className={quietButton} onClick={onCancel}>
+          Not now
+        </button>
+      </div>
+    </div>
+  );
+};
+
+export default CardCalibrate;
