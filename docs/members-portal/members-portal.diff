--- /dev/null
+++ b/src/pages/members/GateWelcome.tsx
@@ -0,0 +1,58 @@
+import { Link } from "react-router-dom";
+import JoinInnerCircleForm from "@/components/members/JoinInnerCircleForm";
+import { WHATSAPP_NUMBER } from "@/data/jewellery";
+import { primaryButton, quietButton } from "@/components/portal/styles";
+import { DROPS } from "@/lib/portal/drops";
+import { byOpening, timeOf } from "@/lib/portal/dropPhase";
+import { formatIstOpening } from "@/lib/portal/ist";
+import { PROMISES } from "./Gate";
+
+/*
+  The gate's welcome, for anyone not signed in: the way in, the promises,
+  the Inner Circle list and WhatsApp. A chunk of its own, with the list's
+  form (and the parser it checks an email with), so a member, whose gate
+  only ever says "Opening the gate…" before her garden, never downloads it.
+  Until it is in, the gate keeps saying that.
+*/
+
+const WHATSAPP = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
+  "Hello Naira Flore, I'd like to know about the Inner Garden, the members' side of the Inner Circle.",
+)}`;
+
+/* The next drop's name and date show here only when the owner has said they may (teaser.public). */
+const publicTeaser = (now: number) => byOpening(DROPS).find((d) => d.teaser?.public && now < timeOf(d.membersFrom));
+
+const GateWelcome = ({ pathname }: { pathname: string }) => {
+  const teaser = publicTeaser(Date.now());
+  const next = encodeURIComponent(pathname.startsWith("/members") ? pathname : "/members");
+  return (
+    <>
+      <p className="ig-lede">The members' side of the Inner Circle: a garden of your own, grown from the day you join.</p>
+      <Link to={`/auth?next=${next}`} className={`${primaryButton} ig-gate-cta`}>
+        Enter the garden
+      </Link>
+      <p className="ig-fineprint">Sign in, or create your account.</p>
+      <ul className="ig-promises">
+        {PROMISES.filter((p) => p.live).map((p) => (
+          <li key={p.text}>{p.text}</li>
+        ))}
+      </ul>
+      {teaser && (
+        <p className="ig-fineprint">
+          The next drop, {teaser.title}, opens {formatIstOpening(teaser.membersFrom)}.
+        </p>
+      )}
+      <p className="ig-or">
+        <span>or keep in touch</span>
+      </p>
+      <div className="ig-join">
+        <JoinInnerCircleForm source="members-gate" withName={false} cta="Join the Inner Circle list" />
+      </div>
+      <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" className={quietButton}>
+        Ask us on WhatsApp
+      </a>
+    </>
+  );
+};
+
+export default GateWelcome;
diff --git a/src/pages/members/Gifts.tsx b/src/pages/members/Gifts.tsx
new file mode 100644
index 0000000..3bd39d1
--- /dev/null
+++ b/src/pages/members/Gifts.tsx
@@ -0,0 +1,414 @@
+import { useEffect, useMemo, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import PieceCard from "@/components/portal/PieceCard";
+import PetalSpot from "@/components/portal/PetalSpot";
+import GiftRing from "@/components/portal/GiftRing";
+import OccasionForm, { type SaveAnswer } from "@/components/portal/OccasionForm";
+import { BirthFlower } from "@/components/portal/BirthFlowers";
+import { HeartStone } from "@/components/portal/HeartStone";
+import { useMember, type BagLine } from "@/components/portal/MemberContext";
+import { eyebrow, outlineButton, primaryButton, quietButton, textLink } from "@/components/portal/styles";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { useWishlist } from "@/contexts/WishlistContext";
+import { preorderWhatsAppUrl, type JewelPiece } from "@/data/jewellery";
+import { cartLineFor } from "@/lib/variants";
+import {
+  bandLabel,
+  bySoonest,
+  giftAdded,
+  giftDay,
+  giftDayEvent,
+  giftEdited,
+  giftReminderEvent,
+  giftRemoved,
+  giftRestored,
+  nextGiftIndex,
+  nextOn,
+  picksWithin,
+  refuseAnother,
+  sameGift,
+  whenSaid,
+  MONTHS_LONG,
+  REMIND_DAYS,
+  type Gift,
+} from "@/lib/portal/gifts";
+import { MAX_GIFTS, type MetaResult } from "@/lib/portal/memberMeta";
+import { buildIcs, googleCalendarUrl } from "@/lib/portal/ics";
+import { GOOGLE_CALENDAR_URL, WHATSAPP_URL, handOff, saveFile } from "@/lib/portal/handOff";
+import { presetFor } from "@/lib/portal/fit";
+import { BIRTHSTONE_HANDLE, MONTH_OPTION, variantForMonth } from "@/lib/portal/stonePiece";
+import { shownName, stoneForMonth } from "@/lib/portal/stones";
+import { serverNow } from "@/lib/portal/clock";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import "./gifts.css";
+
+/*
+  /members/gifts: the gift ledger. Up to eight dates she buys for (a short
+  name, a day and a month, a budget band from the Gifting page), drawn as
+  small stone flowers round a twelve-month ring, the next one to come (in
+  Indian time, across the turn of the year) ringed in gold. For each date:
+  her stone for that month (the Birthstone Heart Necklace with the month
+  already chosen), three pieces within the budget that the live shop has in
+  stock, and a reminder a week before, every year, in her own calendar.
+  Every date can be changed or removed; a ninth is refused with a message.
+
+  The dates live in her account's memory (naira.gifts): kept on her sign-in,
+  never trimmed to make room. Prices and stock are only
+  ever the live shop's. Nothing is offered with a gift that the shop has not
+  said it can do.
+*/
+
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
+const IN_APP = /\bInstagram\b|\bFB(AN|AV)\b|FB_IAB|\[FB/i;
+
+/* Her stone for the date's month: the necklace's own variant, its live price and stock. */
+const GiftStone = ({ gift, piece, status, preview, onAdd }: { gift: Gift; piece: JewelPiece | undefined; status: "ready" | "loading" | "offline" | "missing"; preview: boolean; onAdd: (line: BagLine) => Promise<boolean> }) => {
+  const stone = stoneForMonth(gift.m);
+  const variant = variantForMonth(piece, gift.m);
+  const [adding, setAdding] = useState<"idle" | "busy" | "done">("idle");
+  const live = useRef(true);
+  useEffect(
+    () => () => {
+      live.current = false;
+    },
+    [],
+  );
+  useEffect(() => setAdding("idle"), [gift.m]);
+  if (!stone) return null;
+  const name = variant?.options[MONTH_OPTION] ?? stone.variant;
+  const add = async () => {
+    if (!piece || !variant || adding === "busy") return;
+    setAdding("busy");
+    let ok = false;
+    try {
+      ok = await onAdd(cartLineFor(piece, variant));
+    } catch {
+      ok = false;
+    }
+    if (live.current) setAdding(ok ? "done" : "idle");
+  };
+  return (
+    <div className="ig-gstone">
+      <HeartStone stone={stone} size={34} className="ig-gstone-heart" />
+      <div className="ig-gstone-body">
+        <h3 className="ig-gcard-h3">{MONTHS_LONG[gift.m - 1]}'s stone</h3>
+        <p className="ig-fineprint">The Birthstone Heart Necklace, as the shop names {MONTHS_LONG[gift.m - 1]}'s colour: {shownName(name)}.</p>
+        {status === "loading" && (
+          <p className="ig-fineprint" role="status">
+            Reading today's price from the shop…
+          </p>
+        )}
+        {status === "offline" && <p className="ig-fineprint">We couldn't reach the shop just now.</p>}
+        {(status === "missing" || (status === "ready" && !variant)) && <p className="ig-fineprint">This month isn't in the shop right now.</p>}
+        {status === "ready" && piece && variant && (
+          <>
+            <p className="ig-price ig-gstone-price">
+              <span>{rupees(variant.price)}</span>
+              {variant.compareAtPrice && variant.compareAtPrice > variant.price ? <s>{rupees(variant.compareAtPrice)}</s> : null}
+              <span className={variant.availableForSale ? "ig-stock" : "ig-stock ig-stock--out"}>{variant.availableForSale ? "Available" : "Sold out"}</span>
+            </p>
+            {variant.availableForSale ? (
+              <button type="button" className={primaryButton} onClick={add} disabled={adding === "busy"}>
+                {adding === "busy" ? "Adding…" : `Add the ${stone.monthName} heart to bag`}
+              </button>
+            ) : (
+              <a className={textLink} href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" onClick={handOff(() => preorderWhatsAppUrl({ name: piece.name, handle: piece.handle, choice: name }))}>
+                Ask on WhatsApp
+              </a>
+            )}
+            {adding === "done" && (
+              <p className="ig-fineprint" role="status">
+                {import.meta.env.DEV && preview ? "Preview only: nothing was added to a bag." : "In your bag."}
+              </p>
+            )}
+          </>
+        )}
+        {status !== "ready" && (
+          <Link className={textLink} to={`/jewellery/${BIRTHSTONE_HANDLE}`}>
+            See the piece
+          </Link>
+        )}
+      </div>
+    </div>
+  );
+};
+
+/* A reminder a week before, every year: Google's link first (it opens inside Instagram too), then the .ics.
+   Neither carries the date on the page: Google's address with her date's name is built at the tap, and
+   the .ics is made at the tap and saved (lib/portal/handOff), so no click recorder reads either. */
+const GiftReminder = ({ gift, now }: { gift: Gift; now: number }) => {
+  const inApp = typeof navigator !== "undefined" && IN_APP.test(navigator.userAgent ?? "");
+  return (
+    <div className="ig-gremind">
+      <a className={outlineButton} href={GOOGLE_CALENDAR_URL} target="_blank" rel="noopener noreferrer" onClick={handOff(() => googleCalendarUrl(giftReminderEvent(gift, now)))}>
+        Remind me a week before
+      </a>
+      {!inApp && (
+        <button type="button" className={textLink} onClick={() => saveFile(buildIcs(giftDayEvent(gift, now)), `naira-gift-${gift.m}-${gift.d}.ics`, "text/calendar;charset=utf-8")}>
+          Apple or Outlook · yearly
+        </button>
+      )}
+    </div>
+  );
+};
+
+type Notice = { text: string; undo?: { gift: Gift; index: number } };
+
+const Gifts = () => {
+  const { naira, changeMeta, metaProblem, retryMeta, addToBag, bagBusy, preview } = useMember();
+  const gifts = naira.gifts;
+  const [now] = useState(serverNow);
+  const next = nextGiftIndex(gifts, now);
+  const [chosen, setChosen] = useState<Gift | null>(null);
+  const shownIndex = chosen ? gifts.findIndex((g) => sameGift(g, chosen)) : -1;
+  const shown = shownIndex >= 0 ? shownIndex : next;
+  const gift = gifts[shown];
+  const [adding, setAdding] = useState(gifts.length === 0);
+  const [editing, setEditing] = useState<Gift | null>(null);
+  const [notice, setNotice] = useState<Notice | null>(null);
+  // The date just kept, whose flower opens on the ring.
+  const [kept, setKept] = useState<Gift | null>(null);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const cardRef = useRef<HTMLElement>(null);
+  const noticeRef = useRef<HTMLParagraphElement>(null);
+  const { jewellery, isLive, isLoading } = useLiveJewellery();
+  const { isWishlisted } = useWishlist();
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+  useEffect(() => {
+    if (notice) noticeRef.current?.focus({ preventScroll: true });
+  }, [notice]);
+  // The date's card rises in as she chooses one (never under reduced motion).
+  useEffect(() => {
+    if (!chosen || stillMotion()) return;
+    play(cardRef.current, [{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }], { duration: 420, easing: EASE_REVEAL });
+  }, [chosen]);
+
+  const necklace = isLive ? jewellery.find((p) => p.handle === BIRTHSTONE_HANDLE) : undefined;
+  const stoneStatus = necklace ? "ready" : isLive ? "missing" : isLoading ? "loading" : "offline";
+  const names = useMemo(() => new Map(jewellery.map((p) => [p.handle, p.name])), [jewellery]);
+
+  // Three within her budget, priced as each card would show it (the variant her month lands on).
+  const picks = useMemo(() => {
+    if (!gift) return [];
+    const preset = (p: JewelPiece) => presetFor(p, null, undefined, gift.m);
+    return picksWithin(jewellery, isLive, gift.b, { seed: shown, priceOf: (p) => preset(p).price }).map((piece) => ({ piece, preset: preset(piece) }));
+  }, [gift, jewellery, isLive, shown]);
+
+  /* Her account answers: refused (it has no room), or kept, with any saved piece it let go named, and
+     said to be still hearted on this phone when it is (the portal keeps it so: MembersRoute's spill). */
+  const answer = (result: MetaResult, done: string): SaveAnswer => {
+    if (result.ok === false) return result;
+    const dropped = result.dropped ?? [];
+    if (!dropped.length) {
+      setNotice({ text: done });
+      return { ok: true };
+    }
+    const named = dropped.map((h) => names.get(h) ?? h);
+    const gone = named.length > 1 ? `${named.slice(0, -1).join(", ")} and ${named[named.length - 1]}` : named[0];
+    const one = dropped.length === 1;
+    const hearted = dropped.filter((h) => isWishlisted(h)).length;
+    const still = !hearted ? "" : hearted === dropped.length ? (one ? " It is still hearted on this phone." : " They are still hearted on this phone.") : " Those hearted on this phone stay hearted.";
+    setNotice({ text: `${done} To make room on your account, ${one ? "the oldest piece in your drawer was" : "the oldest pieces in your drawer were"} let go: ${gone}.${still}` });
+    return { ok: true };
+  };
+
+  const add = (g: Gift): SaveAnswer => {
+    const refused = refuseAnother(gifts, g);
+    if (refused) return { ok: false, message: refused };
+    const saved = answer(changeMeta(giftAdded(g)), `${g.n}, ${giftDay(g)}, is in your ledger.`);
+    if (saved.ok) {
+      setAdding(false);
+      setChosen(g);
+      setKept(g);
+    }
+    return saved;
+  };
+
+  const edit = (before: Gift) => (after: Gift): SaveAnswer => {
+    if (sameGift(before, after)) {
+      setEditing(null);
+      return { ok: true };
+    }
+    if (gifts.some((g) => !sameGift(g, before) && sameGift(g, after))) return { ok: false, message: "That date is already in your ledger." };
+    const saved = answer(changeMeta(giftEdited(before, after)), `${after.n}, ${giftDay(after)}, is changed.`);
+    if (saved.ok) {
+      setEditing(null);
+      setChosen(after);
+      setKept(after);
+    }
+    return saved;
+  };
+
+  const remove = (g: Gift) => {
+    const index = gifts.findIndex((x) => sameGift(x, g));
+    const result = changeMeta(giftRemoved(g));
+    if (result.ok === false) return;
+    if (chosen && sameGift(chosen, g)) setChosen(null);
+    if (editing && sameGift(editing, g)) setEditing(null);
+    setNotice({ text: `${g.n} is out of your ledger.`, undo: { gift: g, index } });
+  };
+
+  const undo = (u: NonNullable<Notice["undo"]>) => {
+    const refused = refuseAnother(gifts, u.gift);
+    if (refused) {
+      setNotice({ text: refused });
+      return;
+    }
+    answer(changeMeta(giftRestored(u.gift, u.index)), `${u.gift.n} is back in your ledger.`);
+    setChosen(u.gift);
+    setKept(u.gift);
+  };
+
+  const full = gifts.length >= MAX_GIFTS;
+  const list = bySoonest(gifts, now);
+
+  return (
+    <PortalShell title="Gift ledger" description="The dates you buy for, in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-gifts">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            Your <em>gift</em> ledger
+          </h1>
+          <p className="ig-lede">The people you buy for, round the year. The next to come is ringed in gold.</p>
+        </div>
+
+        <GiftRing gifts={gifts} next={next} selected={shown} now={now} onSelect={(i) => setChosen(gifts[i] ?? null)} bloom={kept} />
+        {gifts.length === 0 && <p className="ig-fineprint ig-gifts-empty">No dates yet. Add the first below, and its flower opens on the ring in its month's colour.</p>}
+
+        {gift && (
+          <section ref={cardRef} className="ig-section ig-gcard" aria-labelledby="ig-gcard-h" data-clarity-mask="true">
+            <div className="ig-gcard-head">
+              <BirthFlower month={gift.m} size={72} className="ig-gcard-flower" label={`${MONTHS_LONG[gift.m - 1]}'s flower, the ${stoneForMonth(gift.m)?.flower.toLowerCase()}`} />
+              <div>
+                <p className={eyebrow}>{shown === next ? "The next to come" : "In your ledger"}</p>
+                <h2 id="ig-gcard-h" className="ig-h2 ig-gcard-name">
+                  {gift.n}
+                </h2>
+                <p className="ig-gcard-when">
+                  {giftDay(gift)} · {whenSaid(nextOn(gift, now).days)}
+                </p>
+                <p className="ig-fineprint">{bandLabel(gift.b)}</p>
+              </div>
+            </div>
+
+            <GiftStone gift={gift} piece={necklace} status={stoneStatus} preview={preview} onAdd={addToBag} />
+
+            <h3 className="ig-gcard-h3">Three within the budget</h3>
+            {picks.length > 0 ? (
+              <ul className="ig-pcs">
+                {picks.map(({ piece, preset }) => (
+                  <li key={piece.handle}>
+                    <PieceCard piece={piece} preset={preset} preview={preview} bagBusy={bagBusy} onAdd={addToBag} note={bandLabel(gift.b)} />
+                  </li>
+                ))}
+              </ul>
+            ) : (
+              <p className="ig-fineprint" role={isLoading ? "status" : undefined}>
+                {isLive ? "Nothing in stock in this budget right now." : isLoading ? "Reading today's prices from the shop…" : "We couldn't reach the shop just now."}
+              </p>
+            )}
+            <Link className={textLink} to={`/jewellery?under=${gift.b}`}>
+              Everything {bandLabel(gift.b).toLowerCase()}
+            </Link>
+
+            <h3 className="ig-gcard-h3">A reminder, every year</h3>
+            <p className="ig-fineprint">In your own calendar, a week before {giftDay(gift)}.</p>
+            <GiftReminder gift={gift} now={now} />
+          </section>
+        )}
+
+        <section className="ig-section" aria-labelledby="ig-dates">
+          {/* A petal of the Naira flower, tucked at the end of the heading (Phase 6, Gathered). */}
+          <PetalSpot piece="gifts">
+            <h2 id="ig-dates" className="ig-h2">
+              Your dates
+            </h2>
+          </PetalSpot>
+          {notice && (
+            <p ref={noticeRef} tabIndex={-1} className="ig-fineprint ig-gnotice" role="status">
+              {notice.text}
+              {notice.undo && (
+                <button
+                  type="button"
+                  className={quietButton}
+                  onClick={() => {
+                    const u = notice.undo;
+                    if (u) undo(u);
+                  }}
+                >
+                  Undo
+                </button>
+              )}
+            </p>
+          )}
+          {metaProblem && (
+            <p className="ig-fineprint" role="alert">
+              {/* A connection that failed is tried again; an account with no room is not, so nothing is promised then. */}
+              {/couldn't reach/i.test(metaProblem) ? (
+                <>
+                  {metaProblem} Your dates are kept here and will be saved to your account.{" "}
+                  <button type="button" className={quietButton} onClick={retryMeta}>
+                    Try again
+                  </button>
+                </>
+              ) : (
+                `${metaProblem} The ledger here may not match your account until then.`
+              )}
+            </p>
+          )}
+          {list.length > 0 && (
+            <ul className="ig-glist" data-clarity-mask="true">
+              {list.map(({ gift: g, index, next: when }) =>
+                editing && sameGift(editing, g) ? (
+                  <li key={`edit-${index}`} className="ig-glist-edit">
+                    <OccasionForm initial={g} onSave={edit(g)} onCancel={() => setEditing(null)} />
+                  </li>
+                ) : (
+                  <li key={`${g.n}-${g.m}-${g.d}-${g.b}`} className={index === shown ? "is-shown" : undefined}>
+                    {/* A choice, not a button: a tapped button's words (her date's name, day and budget) are what Meta's automatic events would read. */}
+                    <label className="ig-glist-pick">
+                      <input type="radio" name="ig-gift" className="ig-glist-radio" checked={index === shown} onChange={() => setChosen(g)} />
+                      <span className="ig-glist-name">{g.n}</span>
+                      <span className="ig-glist-when">
+                        {giftDay(g)} · {whenSaid(when.days)}
+                      </span>
+                      <span className="ig-glist-band">{bandLabel(g.b)}</span>
+                    </label>
+                    <span className="ig-glist-actions">
+                      <button type="button" className={quietButton} onClick={() => setEditing(g)} aria-label={`Change ${g.n}`}>
+                        Change
+                      </button>
+                      <button type="button" className={quietButton} onClick={() => remove(g)} aria-label={`Remove ${g.n}`}>
+                        Remove
+                      </button>
+                    </span>
+                  </li>
+                ),
+              )}
+            </ul>
+          )}
+
+          {full ? (
+            <p className="ig-fineprint ig-gfull">Eight dates are kept at most. Remove one to add another.</p>
+          ) : adding ? (
+            <OccasionForm onSave={add} onCancel={gifts.length ? () => setAdding(false) : undefined} />
+          ) : (
+            <button type="button" className={outlineButton} onClick={() => setAdding(true)}>
+              Add a date
+            </button>
+          )}
+          <p className="ig-fineprint ig-gprivacy">
+            Each date is kept on your account with your sign-in: its short name, its day and month, and its budget. Nothing else about the person is kept, and you can change or remove a date here at any time.
+          </p>
+        </section>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Gifts;
