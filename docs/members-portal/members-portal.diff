--- /dev/null
+++ b/src/lib/portal/tier.test.ts
@@ -0,0 +1,166 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { PROBE_FRAMES, SLOW_FRAME_MS, claimGl, demoteTier, glInUse, releaseGl, forceTier, frameProbe, portalTier, probeWanted, readDevice, resetTier, tierOneBecause, type Device } from "./tier";
+
+/* Tier 2 (the Bloom Field and the drop room's gsap choreography) only on a
+   capable phone: every one of the header flower's reasons to stay flat, and
+   a browser without WebGL, keeps Tier 1. Then the probe: more than a quarter
+   of the first 60 frames over 20 ms puts the scene away. */
+
+const capable: Device = { reducedMotion: false, saveData: false, effectiveType: "4g", deviceMemory: 8, webgl: true };
+
+type Nav = Navigator & { connection?: { saveData?: boolean; effectiveType?: string }; deviceMemory?: number };
+const setDevice = ({ reduce = false, saveData = false, effectiveType = "4g", deviceMemory = 8 as number | null, webgl = true } = {}) => {
+  window.matchMedia = ((query: string) => ({ matches: reduce && query.includes("reduce"), media: query, addEventListener() {}, removeEventListener() {} })) as unknown as typeof window.matchMedia;
+  Object.defineProperty(navigator, "connection", { configurable: true, value: { saveData, effectiveType } });
+  Object.defineProperty(navigator, "deviceMemory", { configurable: true, value: deviceMemory ?? undefined });
+  if (webgl) (window as unknown as Record<string, unknown>).WebGLRenderingContext = function WebGLRenderingContext() {};
+  else delete (window as unknown as Record<string, unknown>).WebGLRenderingContext;
+};
+
+afterEach(() => {
+  resetTier();
+  delete (navigator as Nav).connection;
+  delete (navigator as Nav).deviceMemory;
+  delete (window as unknown as Record<string, unknown>).WebGLRenderingContext;
+});
+
+describe("the device gate", () => {
+  it("lets a capable phone have Tier 2", () => {
+    expect(tierOneBecause(capable)).toBeNull();
+    setDevice();
+    expect(readDevice()).toEqual(capable);
+    expect(portalTier()).toBe(2);
+  });
+
+  it("keeps Tier 1 under reduced motion", () => {
+    expect(tierOneBecause({ ...capable, reducedMotion: true })).toBe("reduced-motion");
+    setDevice({ reduce: true });
+    expect(portalTier()).toBe(1);
+  });
+
+  it("keeps Tier 1 under Data Saver", () => {
+    expect(tierOneBecause({ ...capable, saveData: true })).toBe("save-data");
+    setDevice({ saveData: true });
+    expect(portalTier()).toBe(1);
+  });
+
+  it("keeps Tier 1 on a slow-2g, 2g or 3g connection, not on 4g", () => {
+    for (const effectiveType of ["slow-2g", "2g", "3g"]) {
+      expect(tierOneBecause({ ...capable, effectiveType })).toBe("slow-network");
+      setDevice({ effectiveType });
+      expect(portalTier(), effectiveType).toBe(1);
+    }
+    expect(tierOneBecause({ ...capable, effectiveType: "4g" })).toBeNull();
+  });
+
+  it("keeps Tier 1 on a phone with less than 4 GB, and trusts a phone that does not say", () => {
+    for (const deviceMemory of [0.5, 1, 2, 3]) {
+      expect(tierOneBecause({ ...capable, deviceMemory })).toBe("low-memory");
+      setDevice({ deviceMemory });
+      expect(portalTier(), String(deviceMemory)).toBe(1);
+    }
+    expect(tierOneBecause({ ...capable, deviceMemory: 4 })).toBeNull();
+    // Safari and Firefox do not tell: the probe decides there.
+    setDevice({ deviceMemory: null });
+    expect(readDevice().deviceMemory).toBeNull();
+    expect(portalTier()).toBe(2);
+  });
+
+  it("keeps Tier 1 without WebGL", () => {
+    expect(tierOneBecause({ ...capable, webgl: false })).toBe("no-webgl");
+    setDevice({ webgl: false });
+    expect(portalTier()).toBe(1);
+  });
+
+  it("stays on Tier 1 for the visit once the probe or a failed start has said no", () => {
+    setDevice();
+    expect(portalTier()).toBe(2);
+    demoteTier();
+    expect(portalTier()).toBe(1);
+  });
+
+  it("lets the development preview force a tier, but never past reduced motion or Data Saver", () => {
+    setDevice({ deviceMemory: 2 });
+    forceTier(2);
+    expect(portalTier()).toBe(2);
+    expect(probeWanted()).toBe(true);
+    forceTier(2, false);
+    expect(probeWanted()).toBe(false);
+    setDevice({ reduce: true });
+    expect(portalTier()).toBe(1);
+    setDevice({ saveData: true });
+    expect(portalTier()).toBe(1);
+    setDevice();
+    forceTier(1);
+    expect(portalTier()).toBe(1);
+  });
+});
+
+describe("the frame probe", () => {
+  it("passes 60 steady frames, and a few long ones among them", () => {
+    const probe = frameProbe();
+    const frames = Array.from({ length: PROBE_FRAMES }, (_, i) => (i % 5 === 0 ? 34 : 16.7));
+    const verdicts = frames.map((ms) => probe.frame(ms));
+    expect(verdicts.slice(0, -1).every((v) => v === "probing")).toBe(true);
+    expect(verdicts.at(-1)).toBe("steady");
+    expect(probe.frame(200)).toBe("steady");
+  });
+
+  it("passes exactly a quarter over 20 ms, and fails one more", () => {
+    const quarter = frameProbe();
+    for (let i = 0; i < PROBE_FRAMES; i++) quarter.frame(i < 15 ? SLOW_FRAME_MS + 1 : 16);
+    expect(quarter.verdict).toBe("steady");
+    const more = frameProbe();
+    for (let i = 0; i < PROBE_FRAMES; i++) more.frame(i < 16 ? SLOW_FRAME_MS + 1 : 16);
+    expect(more.verdict).toBe("slow");
+  });
+
+  it("gives up within the first 60 frames on a slow phone, as soon as it cannot pass", () => {
+    const probe = frameProbe();
+    let at = 0;
+    while (probe.frame(28) === "probing") at += 1;
+    expect(probe.verdict).toBe("slow");
+    expect(at + 1).toBe(16);
+    expect(at + 1).toBeLessThan(PROBE_FRAMES);
+  });
+
+  it("gives up at once on frames that take seconds, without waiting for the sixteenth", () => {
+    const probe = frameProbe();
+    expect(probe.frame(16.7)).toBe("probing");
+    expect(probe.frame(1900)).toBe("slow");
+  });
+
+  it("forgives one long frame among steady ones", () => {
+    const probe = frameProbe();
+    probe.frame(400);
+    for (let i = 1; i < PROBE_FRAMES; i++) probe.frame(16.7);
+    expect(probe.verdict).toBe("steady");
+  });
+
+  it("counts 20 ms itself as on time", () => {
+    const probe = frameProbe();
+    for (let i = 0; i < PROBE_FRAMES; i++) probe.frame(SLOW_FRAME_MS);
+    expect(probe.verdict).toBe("steady");
+  });
+});
+
+/* Phase 6: one portal scene at a time, the Bloom Field's and the gem's alike (each claims the slot before its renderer). */
+describe("the one portal scene's slot", () => {
+  it("is held by one owner at a time and given back only by it", () => {
+    const field = {};
+    const gem = {};
+    expect(glInUse()).toBe(0);
+    expect(claimGl(field)).toBe(true);
+    expect(claimGl(gem)).toBe(false);
+    expect(glInUse()).toBe(1);
+    releaseGl(gem);
+    expect(claimGl(gem)).toBe(false);
+    releaseGl(field);
+    expect(glInUse()).toBe(0);
+    expect(claimGl(gem)).toBe(true);
+    // Claiming again as its holder is harmless.
+    expect(claimGl(gem)).toBe(true);
+    releaseGl(gem);
+    expect(glInUse()).toBe(0);
+  });
+});
diff --git a/src/lib/portal/tier.ts b/src/lib/portal/tier.ts
new file mode 100644
index 0000000..9040a7a
--- /dev/null
+++ b/src/lib/portal/tier.ts
@@ -0,0 +1,161 @@
+import { prefersReducedMotion } from "./motion";
+
+/*
+  TIER 2, the portal's spectacle: the three.js Bloom Field and the drop
+  room's gsap choreography, on capable phones only. Everything else keeps
+  Tier 1 (today's SVG and CSS art, unchanged), and nothing of Tier 2 is
+  fetched for it.
+
+  The gate is the header flower's own (NairaWordmark's keepFlatFlower:
+  reduced motion, Data Saver, a slow-2g / 2g / 3g connection, a phone with
+  less than 4 GB of memory), copied rather than shared so the header's code
+  is untouched, plus a browser without WebGL. A browser that has WebGL but
+  cannot make a context, or a three.js chunk that does not arrive, also
+  keeps Tier 1: the scene's own start fails and the page is as it was.
+
+  Then the frame probe: the scene's first 60 frames are timed, and if more
+  than a quarter of them take over 20 ms the scene is put away at once and
+  this visit stays on Tier 1 (demoteTier). A phone that cannot hold the
+  fall never stutters through it.
+*/
+
+type NetworkInfo = { saveData?: boolean; effectiveType?: string };
+
+export type Device = {
+  reducedMotion: boolean;
+  saveData: boolean;
+  /** navigator.connection.effectiveType, or "" where it is not told. */
+  effectiveType: string;
+  /** navigator.deviceMemory in GB, or null where it is not told (Safari, Firefox). */
+  deviceMemory: number | null;
+  /** The browser has WebGL at all (whether it can make a context is the scene's to find out). */
+  webgl: boolean;
+};
+
+export const readDevice = (): Device => {
+  let saveData = false;
+  let effectiveType = "";
+  let deviceMemory: number | null = null;
+  let webgl = false;
+  try {
+    const nav = navigator as Navigator & { connection?: NetworkInfo; deviceMemory?: number };
+    saveData = Boolean(nav.connection?.saveData);
+    effectiveType = nav.connection?.effectiveType ?? "";
+    deviceMemory = typeof nav.deviceMemory === "number" ? nav.deviceMemory : null;
+    webgl = typeof window !== "undefined" && "WebGLRenderingContext" in window;
+  } catch {
+    webgl = false;
+  }
+  return { reducedMotion: prefersReducedMotion(), saveData, effectiveType, deviceMemory, webgl };
+};
+
+export type TierOneReason = "reduced-motion" | "save-data" | "slow-network" | "low-memory" | "no-webgl";
+
+/** Why this device keeps Tier 1, or null when Tier 2 may run. */
+export const tierOneBecause = (d: Device): TierOneReason | null => {
+  if (d.reducedMotion) return "reduced-motion";
+  if (d.saveData) return "save-data";
+  if (/^(slow-2g|2g|3g)$/.test(d.effectiveType)) return "slow-network";
+  if (d.deviceMemory !== null && d.deviceMemory < 4) return "low-memory";
+  if (!d.webgl) return "no-webgl";
+  return null;
+};
+
+export type Tier = 1 | 2;
+
+/* Development preview only (lib/portal/preview.ts): a tier to see on this machine. */
+let forced: { tier: Tier; probe: boolean } | null = null;
+/* The probe found the phone too slow, or the scene could not start: Tier 1 for the rest of this visit. */
+let demoted = false;
+
+/** Development preview only: see a tier on this machine (preview.ts's &tier= and &probe=0). */
+export const forceTier = (tier: Tier | null, probe = true) => {
+  if (import.meta.env.DEV) forced = tier ? { tier, probe } : null;
+};
+
+/** The probe or a failed start said no: this visit stays on Tier 1. */
+export const demoteTier = () => {
+  demoted = true;
+};
+
+/** Tests only: forget a demotion. */
+export const resetTier = () => {
+  demoted = false;
+  forced = null;
+};
+
+/**
+ * The tier for this device now. Reduced motion and Data Saver always keep
+ * Tier 1, even in the preview: neither three.js nor gsap is ever fetched for
+ * them.
+ */
+export const portalTier = (): Tier => {
+  const device = readDevice();
+  if (device.reducedMotion || device.saveData) return 1;
+  if (import.meta.env.DEV && forced) return forced.tier;
+  if (demoted) return 1;
+  return tierOneBecause(device) ? 1 : 2;
+};
+
+/** Whether the scene's first frames are timed (always, but for the preview's &probe=0 on a software-GL machine). */
+export const probeWanted = (): boolean => !(import.meta.env.DEV && forced && !forced.probe);
+
+/*
+  One portal scene at a time: the Bloom Field (lib/portal/scene) and the
+  gem on Your stone (lib/portal/gem/scene) share this slot, so with the
+  header flower a /members screen never holds more than two WebGL
+  contexts. A scene claims it before it makes its renderer and gives it
+  back as it is put away; a second scene is refused while one holds it.
+*/
+let glHolder: object | null = null;
+
+/** Takes the one portal scene's slot for `owner`; false while another scene holds it. */
+export const claimGl = (owner: object): boolean => {
+  if (glHolder && glHolder !== owner) return false;
+  glHolder = owner;
+  return true;
+};
+
+/** Gives the slot back (only its holder can). */
+export const releaseGl = (owner: object) => {
+  if (glHolder === owner) glHolder = null;
+};
+
+/** How many portal scenes hold a WebGL context now: 0 or 1. */
+export const glInUse = (): number => (glHolder ? 1 : 0);
+
+/* The frame probe. */
+export const PROBE_FRAMES = 60;
+export const SLOW_FRAME_MS = 20;
+export const SLOW_SHARE = 0.25;
+
+export type ProbeVerdict = "probing" | "steady" | "slow";
+
+/**
+ * Times the first `frames` frames, one interval at a time. "slow" as soon as
+ * more than a quarter of them have gone over 20 ms (it cannot pass after
+ * that, so the scene goes at once, within the 60), or as soon as they have
+ * taken longer than 60 frames at 30 ms would (1.8 s: a phone whose frames
+ * take seconds is not kept waiting for its sixteenth); "steady" once all 60
+ * are in without either, "probing" until then. The verdict never changes.
+ */
+export const frameProbe = (frames = PROBE_FRAMES, slowMs = SLOW_FRAME_MS, share = SLOW_SHARE) => {
+  let seen = 0;
+  let slow = 0;
+  let total = 0;
+  let verdict: ProbeVerdict = "probing";
+  return {
+    frame(ms: number): ProbeVerdict {
+      if (verdict !== "probing") return verdict;
+      seen += 1;
+      total += ms;
+      if (ms > slowMs) slow += 1;
+      if (slow > frames * share || total > frames * slowMs * 1.5) verdict = "slow";
+      else if (seen >= frames) verdict = "steady";
+      return verdict;
+    },
+    get verdict() {
+      return verdict;
+    },
+  };
+};
diff --git a/src/lib/portal/unboxGsap.test.ts b/src/lib/portal/unboxGsap.test.ts
new file mode 100644
index 0000000..2379cd8
--- /dev/null
+++ b/src/lib/portal/unboxGsap.test.ts
@@ -0,0 +1,186 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import gsap from "gsap";
+import { BURST_MS, MAX_BURST } from "./petalPaths";
+import { MAX_THROW, MOTION_OK, THROW_MS, UNFOLD, physicsThrows, ready, scatterPetals, throwPetals, unfoldFromBox } from "./unboxGsap";
+
+/* The drop room's gsap choreography, with gsap itself (jsdom has no
+   layout, so Flip fits onto zero-sized boxes; what is checked is that it is
+   made, inside the no-preference query alone, and that it lets everything
+   go). Under reduced motion nothing is made and the room plays today's. */
+
+let reduce = false;
+const listeners = new Set<() => void>();
+beforeEach(() => {
+  reduce = false;
+  window.matchMedia = ((query: string) => ({
+    get matches() {
+      return query === MOTION_OK ? !reduce : query.includes("reduce") && reduce;
+    },
+    media: query,
+    addListener: (f: () => void) => listeners.add(f),
+    removeListener: (f: () => void) => listeners.delete(f),
+    addEventListener: (_: string, f: () => void) => listeners.add(f),
+    removeEventListener: (_: string, f: () => void) => listeners.delete(f),
+  })) as unknown as typeof window.matchMedia;
+});
+afterEach(() => {
+  document.body.innerHTML = "";
+  gsap.globalTimeline.clear();
+});
+
+/* Everything just made, taken off gsap's clock and moved by hand. */
+const takeClock = () => {
+  const tl = gsap.exportRoot();
+  tl.pause();
+  return (seconds: number) => {
+    for (let t = tl.time(), end = t + seconds; t < end; ) {
+      t = Math.min(end, t + 1 / 30);
+      tl.time(t);
+    }
+  };
+};
+
+const petals = (n: number) =>
+  Array.from({ length: n }, () => {
+    const el = document.createElement("span");
+    el.className = "ig-petal";
+    el.style.opacity = "0";
+    document.body.appendChild(el);
+    return el;
+  });
+
+describe("the unboxing's throws", () => {
+  it("are at most 24, the same as today's arcs in number, and every one lands by 1.6 s", () => {
+    expect(MAX_THROW).toBe(MAX_BURST);
+    expect(THROW_MS).toBe(BURST_MS);
+    expect(physicsThrows(200)).toHaveLength(MAX_THROW);
+    for (const t of physicsThrows(24, { seed: "verdant", spread: 148, lift: 179 })) {
+      expect(t.delay + t.duration).toBeLessThanOrEqual(THROW_MS);
+      // Up and out of the drawer: every launch has an upward part.
+      expect(Math.sin((t.angle * Math.PI) / 180)).toBeLessThan(0);
+      expect(t.gravity).toBeGreaterThan(0);
+      expect(t.velocity).toBeGreaterThan(0);
+    }
+  });
+
+  it("are the same for a drop on every phone", () => {
+    expect(physicsThrows(24, { seed: "verdant" })).toEqual(physicsThrows(24, { seed: "verdant" }));
+    expect(physicsThrows(24, { seed: "verdant" })).not.toEqual(physicsThrows(24, { seed: "rose" }));
+  });
+});
+
+describe("with motion allowed", () => {
+  it("brings Flip and Physics2D in", async () => {
+    await expect(ready).resolves.toBeUndefined();
+  });
+
+  it("throws the petals under Physics2D and removes each as it lands, by 1.6 s", async () => {
+    await ready;
+    const nodes = petals(24);
+    const stop = throwPetals(nodes, physicsThrows(24, { seed: "verdant" }), 0);
+    expect(stop).toBeTypeOf("function");
+    const advance = takeClock();
+    advance(0.3);
+    expect(nodes.filter((n) => n.isConnected).length).toBe(24);
+    expect(nodes.some((n) => /translate/.test(n.style.transform))).toBe(true);
+    advance(1.4);
+    expect(nodes.filter((n) => n.isConnected)).toHaveLength(0);
+    stop?.();
+  });
+
+  it("lets every petal go at once when stopped (a Skip)", async () => {
+    await ready;
+    const nodes = petals(12);
+    const stop = throwPetals(nodes, physicsThrows(12), 500)!;
+    stop();
+    expect(nodes.filter((n) => n.isConnected)).toHaveLength(0);
+  });
+
+  it("scatters the rub's last petals, each removed as it lands", async () => {
+    await ready;
+    const nodes = petals(12);
+    const stop = scatterPetals(nodes, 110);
+    expect(stop).toBeTypeOf("function");
+    takeClock()(1.2);
+    expect(nodes.filter((n) => n.isConnected)).toHaveLength(0);
+  });
+
+  it("brings the pieces out of the box, then leaves them as the grid laid them out", async () => {
+    await ready;
+    const stage = document.createElement("div");
+    document.body.appendChild(stage);
+    const cards = Array.from({ length: 4 }, () => {
+      const c = document.createElement("article");
+      c.className = "ig-piece";
+      document.body.appendChild(c);
+      return c;
+    });
+    const stop = unfoldFromBox(cards, stage);
+    expect(stop).toBeTypeOf("function");
+    // At once (before the frame paints): every card starts unseen, at the box.
+    expect(cards.every((c) => c.style.opacity === "0")).toBe(true);
+    // The seat it was fitted to is gone.
+    expect(stage.children).toHaveLength(0);
+    takeClock()(UNFOLD.duration + UNFOLD.stagger * 3 + 0.1);
+    for (const c of cards) {
+      expect(c.style.transform).toBe("");
+      expect(c.style.opacity).toBe("");
+    }
+    stop?.();
+  });
+});
+
+describe("the pieces' flight", () => {
+  it("keeps a card unseen while it crosses the box: its fade begins only late in the flight", async () => {
+    await ready;
+    const stage = document.createElement("div");
+    const card = document.createElement("article");
+    document.body.append(stage, card);
+    const stop = unfoldFromBox([card], stage);
+    const tick = takeClock();
+    tick(UNFOLD.duration * (UNFOLD.fadeAt - 0.05));
+    expect(Number(card.style.opacity)).toBe(0);
+    tick(UNFOLD.duration * 0.25);
+    expect(Number(card.style.opacity)).toBeGreaterThan(0);
+    tick(UNFOLD.duration);
+    expect(card.style.opacity).toBe("");
+    stop?.();
+  });
+
+  it("is a one-shot: once played it is let go, so reduced motion turned on and off never replays it", async () => {
+    await ready;
+    const stage = document.createElement("div");
+    const card = document.createElement("article");
+    document.body.append(stage, card);
+    unfoldFromBox([card], stage);
+    takeClock()(UNFOLD.duration + 0.2);
+    expect(card.style.opacity).toBe("");
+    // She turns reduced motion on, then off again: nothing is built again (a rebuild would hide the card at once).
+    const toggle = async (on: boolean) => {
+      reduce = on;
+      listeners.forEach((f) => f());
+      await new Promise((r) => setTimeout(r, 5));
+    };
+    await toggle(true);
+    await toggle(false);
+    expect(card.style.opacity).toBe("");
+    expect(card.style.transform).toBe("");
+  });
+});
+
+describe("under reduced motion", () => {
+  it("makes nothing, so the room plays today's choreography", async () => {
+    await ready;
+    reduce = true;
+    const nodes = petals(6);
+    expect(throwPetals(nodes, physicsThrows(6), 0)).toBeNull();
+    expect(scatterPetals(nodes)).toBeNull();
+    expect(nodes.every((n) => n.style.transform === "" && n.isConnected)).toBe(true);
+    const stage = document.createElement("div");
+    const card = document.createElement("article");
+    document.body.append(stage, card);
+    expect(unfoldFromBox([card], stage)).toBeNull();
+    expect(card.style.opacity).toBe("");
+    expect(stage.children).toHaveLength(0);
+  });
+});
