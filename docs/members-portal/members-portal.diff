new file mode 100644
index 0000000..f68f079
--- /dev/null
+++ b/src/lib/portal/goldRoses.ts
@@ -0,0 +1,54 @@
+import { BED, hashString, mulberry32 } from "./gardenLayout";
+import type { ConfirmedOrder } from "./checkouts";
+
+/*
+  Her gold-leaf roses (Phase 5): one for each order the shop's webhook
+  confirmed (the newest eight), standing in the front row of her bed, on
+  the soil. Each stands at a place seeded from her id and that order's row,
+  so it is found in the same spot on every visit; placed oldest first, so
+  a new order's rose never moves the ones before it (until a ninth lets the
+  oldest go). They keep clear of her two plants' stems (and the ring of
+  buds round her stone flower) and of each other, and cost the bed's
+  80-plant budget nothing: one still layer, drawn by GoldRose. While there
+  is room, a rose also keeps off the Naira flower's low leaves (NAIRA_LEAVES),
+  so its gold head never sits on the hero's sage leaf; only a crowded row
+  lets one stand nearer, beside its stem.
+
+  Each is dated with its own order's time (`at`), never with today's, and
+  nothing counts them.
+*/
+
+/** The front row's span inside the arbour's posts, and the soil the roses stand on. */
+export const ROSE_ROW = { left: 44, right: 346, soil: BED.soil - 1 } as const;
+/** The least distance between two roses' stems, while there is room for it. */
+export const ROSE_GAP = 16;
+/** Kept clear of the Naira flower's stem (its leaves lean right) and of her stone flower and its ring of buds. */
+export const NAIRA_CLEAR = [-24, 40] as const;
+/** The Naira flower's low leaves, either side of its stem (its painted span over the bed's last 60 units): kept clear while the row has room. */
+export const NAIRA_LEAVES = [-64, 56] as const;
+export const STONE_CLEAR = 50;
+
+export type RosePlace = { id: string; x: number; y: number; flip: boolean; at: string };
+
+export const rosesInFront = (seed: string, orders: readonly ConfirmedOrder[], nairaX: number, stoneX: number): RosePlace[] => {
+  const free: number[] = [];
+  for (let x = ROSE_ROW.left; x <= ROSE_ROW.right; x += 2) {
+    if ((x < nairaX + NAIRA_CLEAR[0] || x > nairaX + NAIRA_CLEAR[1]) && Math.abs(x - stoneX) > STONE_CLEAR) free.push(x);
+  }
+  if (!free.length) return [];
+  const open = free.filter((x) => x < nairaX + NAIRA_LEAVES[0] || x > nairaX + NAIRA_LEAVES[1]);
+  const placed: RosePlace[] = [];
+  const room = (x: number) => Math.min(ROSE_GAP, ...placed.map((p) => Math.abs(p.x - x)));
+  const oldestFirst = [...orders].sort((a, b) => Date.parse(a.confirmedAt) - Date.parse(b.confirmedAt));
+  for (const order of oldestFirst) {
+    const rand = mulberry32(hashString(`${seed || "naira"}:rose:${order.id}`));
+    // Its own seeded spot, or the nearest free one with room around it (in a crowded row, the roomiest).
+    const want = free[Math.floor(rand() * free.length)];
+    const pick = (list: number[]) => list.reduce((best, c) => (room(c) * 1000 - Math.abs(c - want) > room(best) * 1000 - Math.abs(best - want) ? c : best));
+    // Clear of the hero's leaves while one spot there has full room; else anywhere free.
+    const clear = open.length && pick(open);
+    const x = clear && room(clear) >= ROSE_GAP ? clear : pick(free);
+    placed.push({ id: order.id, x, y: ROSE_ROW.soil, flip: rand() < 0.5, at: order.confirmedAt });
+  }
+  return placed.sort((a, b) => a.x - b.x);
+};
