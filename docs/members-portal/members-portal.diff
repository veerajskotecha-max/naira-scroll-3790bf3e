+        onKeyDown={onKeyDown}
+      >
+        <svg className="ig-sl-art" viewBox={`0 0 ${VIEW_W} ${VIEW_H}`} aria-hidden>
+          <defs>
+            <radialGradient id={`${uid}b`} cx="0.38" cy="0.3" r="0.8">
