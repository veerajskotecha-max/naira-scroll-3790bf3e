@@ -0,0 +1,149 @@
+import { useEffect, useId, useLayoutEffect, useMemo, useRef, useState, type RefObject } from "react";
+import { FLOWER_PETALS, FLOWER_STEM, FLOWER_VIEWBOX } from "@/lib/portal/brandFlower";
+import { atelierLink, atelierMessage, type AtelierAbout } from "@/lib/portal/whatsapp";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { useMember } from "./MemberContext";
+import { eyebrow, outlineButton, primaryButton, quietButton } from "./styles";
+import "./ask.css";
+
+/*
+  Ask the atelier (in Care and on the Order Desk). Opening it lays an ivory
+  card down and a gold wax seal, the Naira flower pressed into it, presses
+  onto the card; the message is written on the card from what her account
+  keeps (her size, metal, stone month and first three saved pieces, and on
+  the Order Desk the email she used at checkout), hers to change, and "Open
+  WhatsApp" opens the atelier's chat with her words filled in, to change
+  again or send. Nothing is sent from here. No reply hours are said until
+  the owner gives them.
+
+  The press is transform and opacity only, once; under reduced motion or
+  Data Saver the card is simply there, sealed.
+*/
+
+const C = 36;
+/* The seal's edge: wax spreads unevenly, so its round is a ring of soft bumps of two sizes. */
+const SEAL_EDGE = (() => {
+  const n = 18;
+  const pt = (i: number) => {
+    const a = (i / n) * 2 * Math.PI - Math.PI / 2;
+    const r = 31 + (i % 3 === 0 ? 1.6 : i % 2 ? 0.4 : 1);
+    return `${(C + r * Math.cos(a)).toFixed(1)} ${(C + r * Math.sin(a)).toFixed(1)}`;
+  };
+  let d = `M${pt(0)}`;
+  for (let i = 1; i <= n; i++) d += `A4.6 4.6 0 0 1 ${pt(i % n)}`;
+  return `${d}Z`;
+})();
+
+const WaxSeal = ({ sealRef }: { sealRef: RefObject<SVGSVGElement> }) => (
+  <svg ref={sealRef} className="ig-seal" viewBox="0 0 72 72" width="72" height="72" aria-hidden>
+    <path d={SEAL_EDGE} className="ig-seal-wax" />
+    <circle cx={C} cy={C} r="24" className="ig-seal-rim" />
+    <svg x="22" y="14" width="28" height="44" viewBox={FLOWER_VIEWBOX}>
+      <path d={FLOWER_STEM} className="ig-seal-flower" />
+      {FLOWER_PETALS.map((d, i) => (
+        <path key={i} d={d} className="ig-seal-flower" />
+      ))}
+    </svg>
+  </svg>
+);
+
+type Props = {
+  about: AtelierAbout;
+  /** The Order Desk's: her sign-in's email, which goes in the message (and she can change). */
+  email?: string | null;
+  title?: string;
+  lede?: string;
+};
+
+const AskAtelier = ({ about, email = null, title = "Ask the atelier", lede }: Props) => {
+  const { naira, month } = useMember();
+  const id = useId();
+  const written = useMemo(
+    () => atelierMessage({ about, size: naira.ring?.us, metal: naira.metal, month, saved: naira.saved, email }),
+    [about, naira.ring?.us, naira.metal, month, naira.saved, email],
+  );
+  const [open, setOpen] = useState(false);
+  const [text, setText] = useState(written);
+  const [edited, setEdited] = useState(false);
+  const cardRef = useRef<HTMLDivElement>(null);
+  const sealRef = useRef<SVGSVGElement>(null);
+  const fieldRef = useRef<HTMLTextAreaElement>(null);
+
+  // Her account's words, until she has written her own.
+  useEffect(() => {
+    if (!edited) setText(written);
+  }, [written, edited]);
+
+  // The card lays down, then the seal presses onto it.
+  useLayoutEffect(() => {
+    if (!open || stillMotion()) return;
+    play(cardRef.current, [{ opacity: 0, transform: "translateY(14px)" }, { opacity: 1, transform: "none" }], { duration: 420, easing: EASE_REVEAL, fill: "backwards" });
+    play(
+      sealRef.current,
+      [
+        { opacity: 0, transform: "translateY(-18px) scale(1.45) rotate(-8deg)" },
+        { opacity: 1, transform: "translateY(0) scale(0.9) rotate(0deg)", offset: 0.72 },
+        { opacity: 1, transform: "none" },
+      ],
+      { duration: 620, delay: 260, easing: EASE_BLOOM, fill: "backwards" },
+    );
+  }, [open]);
+
+  useEffect(() => {
+    if (open) fieldRef.current?.focus({ preventScroll: true });
+  }, [open]);
+
+  return (
+    <section className="ig-section ig-ask" aria-labelledby={`${id}-h`}>
+      <h2 id={`${id}-h`} className="ig-h2">
+        {title}
+      </h2>
+      <p className="ig-fineprint">
+        {lede ??
+          "Write to the atelier on WhatsApp. Your size, metal, stone and the first three pieces you saved go in the message, for you to change before it goes."}
+      </p>
+      {!open ? (
+        <button type="button" className={outlineButton} onClick={() => setOpen(true)} aria-expanded={false}>
+          Write to the atelier
+        </button>
+      ) : (
+        <div ref={cardRef} className="ig-ask-card" data-clarity-mask="true">
+          <WaxSeal sealRef={sealRef} />
+          <p className={eyebrow}>To the atelier, Naira Flore</p>
+          <label htmlFor={`${id}-text`} className="ig-ask-label">
+            Your message
+          </label>
+          <textarea
+            ref={fieldRef}
+            id={`${id}-text`}
+            className="ig-ask-text"
+            rows={9}
+            value={text}
+            onChange={(e) => {
+              setText(e.target.value);
+              setEdited(true);
+            }}
+          />
+          <a className={primaryButton} href={atelierLink(text)} target="_blank" rel="noopener noreferrer">
+            Open WhatsApp
+          </a>
+          <p className="ig-fineprint">WhatsApp opens with these words. Nothing is sent until you send it there.</p>
+          {edited && (
+            <button
+              type="button"
+              className={quietButton}
+              onClick={() => {
+                setEdited(false);
+                setText(written);
+              }}
+            >
+              Start the message again
+            </button>
+          )}
+        </div>
+      )}
+    </section>
+  );
+};
+
+export default AskAtelier;
