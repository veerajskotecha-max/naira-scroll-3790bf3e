+++ b/src/lib/portal/unboxGsap.ts
@@ -0,0 +1,234 @@
+import gsap from "gsap";
+import { hashString, mulberry32 } from "./gardenLayout";
+
+/*
+  The drop room's choreography on a Tier 2 phone (gsap, the shop's own
+  "gsap" chunk, with its Flip and Physics2D plugins as two small chunks of
+  their own). Reached only by import() from lib/portal/spectacle.ts, in the
+  drop room alone.
+
+  - The unboxing's petals are thrown out of the open drawer under real
+    gravity (Physics2D): up to 24, each removed as it lands, all gone by
+    1.6 s, exactly as today's arcs are.
+  - The pieces come out of the box: each card starts fitted onto a seat in
+    the box (Flip.fit, at the card's own proportions) and unfolds to its
+    place in the grid, one after another. Only cards whose place is in view
+    are given (the room checks): a flight into a grid below the fold is
+    never seen. A card stays unseen while it is over the box (its fade
+    begins late in the flight), so no name or price is ever half seen over
+    the box's art.
+  - The rub's last petals let go the same way.
+
+  Only transform and opacity move. Everything is made inside
+  gsap.matchMedia("(prefers-reduced-motion: no-preference)"): under reduced
+  motion nothing is made (each call returns null and the room plays today's
+  choreography, which is itself still there), and if she turns reduced
+  motion on mid-flight gsap puts every element back as it was. No
+  ScrollTrigger, no pinning, no smooth scrolling.
+*/
+
+export const MOTION_OK = "(prefers-reduced-motion: no-preference)";
+export const MAX_THROW = 24;
+export const THROW_MS = 1600;
+
+type FlipPlugin = typeof import("gsap/Flip").Flip;
+let flip: FlipPlugin | null = null;
+
+/** Flip and Physics2D, in and registered; rejects when they cannot arrive (the room then keeps today's choreography). */
+export const ready: Promise<void> = Promise.all([import("gsap/Flip"), import("gsap/Physics2DPlugin")]).then(([f, p]) => {
+  gsap.registerPlugin(f.Flip, p.Physics2DPlugin);
+  flip = f.Flip;
+});
+// Never an unhandled rejection: the loader reads the failure from `ready` itself.
+ready.catch(() => undefined);
+
+/** Stops whatever it started and puts every element back as it was. */
+export type Stop = () => void;
+
+/*
+  Builds inside the no-preference media query, or not at all. Each is a
+  one-shot: once it has played (`done`), the media query is let go, left as
+  it ended, so turning reduced motion on and off again never replays it;
+  its Stop puts everything back and lets go too.
+*/
+const whenMotion = (build: (done: () => void) => (() => void) | void): Stop | null => {
+  const mm = gsap.matchMedia();
+  let made = false;
+  const done = () => mm.kill(false);
+  mm.add(MOTION_OK, () => {
+    made = true;
+    return build(done);
+  });
+  if (!made) {
+    mm.kill();
+    return null;
+  }
+  return () => mm.kill(true);
+};
+
+/* Calls `done` once `n` of them have ended. */
+const after = (n: number, done: () => void) => {
+  let left = n;
+  if (!left) done();
+  return () => {
+    if (--left === 0) done();
+  };
+};
+
+export type Throw = {
+  /** px/s, and degrees (0 to the right, -90 straight up). */
+  velocity: number;
+  angle: number;
+  /** px/s². */
+  gravity: number;
+  /** The air's drag, per Physics2D step (30 a second). */
+  friction: number;
+  spin: number;
+  delay: number;
+  duration: number;
+  size: number;
+  tone: 0 | 1;
+};
+
+/**
+ * The unboxing's throws, worked out before the box opens: the same fan as
+ * today's arcs (lib/portal/petalPaths), as a launch speed and angle under
+ * gravity. The same for a drop on every phone; every one lands by 1.6 s.
+ */
+export const physicsThrows = (count: number, { seed = "naira", spread = 150, lift = 190 } = {}): Throw[] => {
+  const n = Math.max(0, Math.min(MAX_THROW, Math.floor(count)));
+  const rand = mulberry32(hashString(`throw:${seed}`));
+  return Array.from({ length: n }, (_, i) => {
+    const delay = Math.round(rand() * 140);
+    const duration = Math.round(1050 + rand() * (THROW_MS - 1050 - delay - 20));
+    const T = duration / 1000;
+    const angle = -150 + (i / Math.max(1, n - 1)) * 120 + (rand() - 0.5) * 18;
+    const speed = 0.62 + rand() * 0.38;
+    // The fastest tops out at `lift` 40% of the way through its flight, then falls past where it began.
+    const gravity = (12.5 * lift) / (T * T);
+    const rad = (angle * Math.PI) / 180;
+    const vy = Math.sin(rad) * Math.sqrt(2 * gravity * lift) * speed;
+    const vx = (Math.cos(rad) * spread * speed) / (T * 0.7);
+    return {
+      velocity: Math.hypot(vx, vy),
+      angle: (Math.atan2(vy, vx) * 180) / Math.PI,
+      gravity,
+      friction: 0.012,
+      spin: (rand() < 0.5 ? -1 : 1) * (240 + rand() * 420),
+      delay,
+      duration,
+      size: Math.round(10 + rand() * 9),
+      tone: rand() < 0.6 ? 0 : 1,
+    };
+  });
+};
+
+/**
+ * Throws the petals (already made, unseen, at the drawer) `startMs` from
+ * now, each removed as it lands. Null under reduced motion: nothing made.
+ */
+export const throwPetals = (nodes: readonly Element[], throws: readonly Throw[], startMs = 0): Stop | null =>
+  whenMotion((done) => {
+    const landed = after(nodes.filter((_, i) => throws[i]).length, done);
+    nodes.forEach((node, i) => {
+      const t = throws[i];
+      if (!t) {
+        node.remove();
+        return;
+      }
+      const T = t.duration / 1000;
+      gsap.set(node, { xPercent: -50, yPercent: -50, x: 0, y: 0, rotation: 0, scale: 0.4, opacity: 0 });
+      gsap
+        .timeline({
+          delay: (startMs + t.delay) / 1000,
+          onComplete: () => {
+            node.remove();
+            landed();
+          },
+        })
+        .to(node, { duration: T, ease: "none", rotation: t.spin, physics2D: { velocity: t.velocity, angle: t.angle, gravity: t.gravity, friction: t.friction } }, 0)
+        .to(node, { duration: T * 0.12, ease: "none", opacity: 1, scale: 1 }, 0)
+        .to(node, { duration: T * 0.22, ease: "none", opacity: 0 }, T * 0.78);
+    });
+    // Put back (a skip, or reduced motion turned on mid-flight): none is left behind.
+    return () => nodes.forEach((n) => n.remove());
+  });
+
+/**
+ * A round let-go from where the last stroke ended (the rub's petals): up and
+ * out a little, then down under gravity, each removed as it lands.
+ */
+export const scatterPetals = (nodes: readonly Element[], spread = 110): Stop | null =>
+  whenMotion((done) => {
+    const landed = after(nodes.length, done);
+    nodes.forEach((node, i) => {
+      const angle = (i / Math.max(1, nodes.length)) * 360 + Math.random() * 30;
+      const T = 0.7 + Math.random() * 0.3;
+      gsap.set(node, { xPercent: -50, yPercent: -50, x: 0, y: 0, scale: 0.3, opacity: 0 });
+      gsap
+        .timeline({
+          delay: Math.random() * 0.06,
+          onComplete: () => {
+            node.remove();
+            landed();
+          },
+        })
+        .to(node, { duration: T, ease: "none", rotation: (Math.random() - 0.5) * 540, physics2D: { velocity: spread * (1 + Math.random() * 0.7), angle, gravity: spread * 4.2, friction: 0.03 } }, 0)
+        .to(node, { duration: T * 0.25, ease: "none", opacity: 1, scale: 1 }, 0)
+        .to(node, { duration: T * 0.4, ease: "none", opacity: 0, scale: 0.85 }, T * 0.6);
+    });
+    return () => nodes.forEach((n) => n.remove());
+  });
+
+/** `fadeAt`: how far into its flight (0 to 1) a card begins to show; by then power3 has carried it most of the way. */
+export const UNFOLD = { duration: 0.78, stagger: 0.07, seat: 0.42, fadeAt: 0.45 };
+
+/**
+ * The pieces come out of the box: each card is fitted (Flip.fit) onto a seat
+ * at the box, the card's own shape at 42% of the stage's width, and unfolds
+ * from there to its place in the grid. Null under reduced motion, or before
+ * Flip is in.
+ */
+export const unfoldFromBox = (cards: readonly HTMLElement[], stage: HTMLElement): Stop | null => {
+  const Flip = flip;
+  if (!Flip || !cards.length) return null;
+  return whenMotion((done) => {
+    const shown = after(cards.length, done);
+    const seat = document.createElement("div");
+    seat.setAttribute("aria-hidden", "true");
+    seat.style.cssText = "position:absolute;left:50%;top:48%;visibility:hidden;pointer-events:none";
+    stage.appendChild(seat);
+    const width = stage.getBoundingClientRect().width * UNFOLD.seat;
+    const fits = cards.map((card) => {
+      const r = card.getBoundingClientRect();
+      const height = r.width ? (width * r.height) / r.width : width;
+      seat.style.width = `${width}px`;
+      seat.style.height = `${height}px`;
+      seat.style.margin = `${-height / 2}px 0 0 ${-width / 2}px`;
+      return Flip.fit(card, seat, { scale: true, getVars: true }) as { x?: number; y?: number; scaleX?: number; scaleY?: number };
+    });
+    seat.remove();
+    cards.forEach((card, i) => {
+      const fit = fits[i];
+      const delay = i * UNFOLD.stagger;
+      gsap.from(card, {
+        x: fit.x ?? 0,
+        y: fit.y ?? 0,
+        scaleX: fit.scaleX ?? 1,
+        scaleY: fit.scaleY ?? 1,
+        duration: UNFOLD.duration,
+        delay,
+        ease: "power3.out",
+        immediateRender: true,
+        // Left as the grid laid it out: no transform of gsap's stays behind.
+        clearProps: "transform",
+      });
+      // Unseen while it crosses the box; shown as it reaches its place.
+      gsap.fromTo(
+        card,
+        { opacity: 0 },
+        { opacity: 1, duration: UNFOLD.duration * (1 - UNFOLD.fadeAt), delay: delay + UNFOLD.duration * UNFOLD.fadeAt, ease: "none", immediateRender: true, clearProps: "opacity", onComplete: shown },
+      );
+    });
+  });
+};
