+/*
+  In place of "Keep in my drawer", once the piece is in her drawer: the card
+  she tapped stays where it was, and says so. Kept just now, it is the one
+  place focus goes (so a screen reader hears it, with the piece's name), and
+  a line says which piece was let go if the drawer was full. A piece saved
+  before this visit simply reads "In your drawer".
+*/
+
+type Props = { handle: string; name: string; fresh: boolean; note?: string };
+
+const KeptNote = ({ handle, name, fresh, note }: Props) => (
+  <p className="ig-kept-note" tabIndex={-1} data-kept={handle}>
+    <span className="sr-only">{name}: </span>
+    <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden>
+      <path d="M2 6.4L4.9 9.2L10 3" fill="none" stroke="var(--nf-accent-strong)" strokeWidth="1.3" />
+    </svg>
+    {fresh ? "Kept in your drawer" : "In your drawer"}
+    {note ? <span className="ig-kept-note-more">{note}</span> : null}
+  </p>
+);
+
+export default KeptNote;
