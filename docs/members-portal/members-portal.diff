+import type { GardenOverrides } from "@/components/portal/MemberContext";
+import type { SkyHour } from "./sky";
+import type { Dressing } from "./seasons";
+import type { AtelierNote } from "./notes";
+import { istDayKey } from "./ist";
+
+/*
+  DEVELOPMENT ONLY: fixtures for the garden's hours, its festival dressings
+  and the atelier's notes, so each can be seen before the owner has written
+  a row. Reached only through preview.ts (itself behind import.meta.env.DEV),
+  so none of it is in a production build: seasons.ts and notes.ts ship empty.
+
+    &hour=dawn|day|golden|night   the sky at that hour, whatever the time
+    &season=diwali|monsoon|holi   a festival row that covers today
+    &note=1                       two notes from the atelier
+*/
+
+const HOURS: readonly SkyHour[] = ["dawn", "day", "golden", "night"];
+const DRESSINGS: readonly Dressing[] = ["diwali", "monsoon", "holi"];
+
+const FIXTURE_NOTES: readonly AtelierNote[] = [
+  {
+    id: "preview-note-pressing",
+    from: "2026-11-01",
+    title: "On pressing flowers",
+    body: [
+      "Every piece starts on paper here: a flower drawn, then drawn again, until the line sits still.",
+      "This note is a preview fixture. The atelier writes the real ones.",
+    ],
+    flower: "jasmine star",
+    accent: "#E8C88A",
+  },
+  {
+    id: "preview-note-light",
+    from: "2026-10-20",
+    title: "Gold in the evening light",
+    body: ["A preview note, shown only on this machine."],
+    flower: "camellia",
+    accent: "#F0BCA8",
+  },
+];
+
+export const readPreviewGarden = (search: string, now: Date = new Date()): GardenOverrides | null => {
+  const q = new URLSearchParams(search);
+  const out: GardenOverrides = {};
+  const hour = q.get("hour") as SkyHour | null;
+  if (hour && HOURS.includes(hour)) out.hour = hour;
+  const season = q.get("season") as Dressing | null;
+  if (season && DRESSINGS.includes(season)) {
+    const day = (offset: number) => istDayKey(new Date(now.getTime() + offset * 86_400_000));
+    out.seasons = [{ id: `preview-${season}`, start: day(-1), end: day(1), dressing: season }];
+  }
+  if (q.get("note") === "1") out.notes = FIXTURE_NOTES;
+  return Object.keys(out).length ? out : null;
+};
diff --git a/src/lib/portal/roomChanges.ts b/src/lib/portal/roomChanges.ts
new file mode 100644
index 0000000..0bfabe5
--- /dev/null
+++ b/src/lib/portal/roomChanges.ts
@@ -0,0 +1,49 @@
+import { HANDLE, MAX_GIFTS, MAX_SAVED, giftOf, readNaira, type Gift, type MetaPatch, type Metal, type Naira, type RingHow, type Updater, type UsSize } from "./memberMeta";
+
+/*
+  The changes her rooms make to her account's memory (memberMeta.ts): her
+  ring size and metal (Your fit), her month alone (Your stone), the pieces
+  in her Jewel drawer, her gift dates. Each room is a chunk of its own and
+  these ride with them; the garden home's first paint carries only what
+  changes as she arrives (today's visit, the flowers pressed on this phone),
+  kept in memberMeta.ts.
+*/
+
+/** Applies a change: a value replaces its key, null deletes it, undefined leaves it alone. */
+export const applyPatch = (naira: Naira, patch: MetaPatch): Naira => {
+  const next: Record<string, unknown> = { ...naira };
+  for (const [key, value] of Object.entries(patch)) {
+    if (key === "v" || value === undefined) continue;
+    if (value === null) delete next[key];
+    else next[key] = value;
+  }
+  return readNaira(next);
+};
+
+export const keepRing = (us: UsSize, how: RingHow, day: string): Updater => (n) => applyPatch(n, { ring: { us, how, at: day } });
+export const forgetRing: Updater = (n) => applyPatch(n, { ring: null });
+export const keepMetal = (metal: Metal): Updater => (n) => applyPatch(n, { metal });
+export const forgetMetal: Updater = (n) => (n.metal ? applyPatch(n, { metal: null }) : n);
+/** Her month alone (1 to 12), for when she would rather not give the whole date. */
+export const keepMonth = (month: number): Updater => (n) =>
+  Number.isInteger(month) && month >= 1 && month <= 12 && n.month !== month ? applyPatch(n, { month }) : n;
+export const forgetMonth: Updater = (n) => (n.month ? applyPatch(n, { month: null }) : n);
+
+/** Saves a piece (newest last). Saving one already saved leaves the list as it is. */
+export const saveHandle = (handle: string): Updater => (n) =>
+  n.saved.includes(handle) || !HANDLE.test(handle) ? n : { ...n, saved: [...n.saved, handle].slice(-MAX_SAVED) };
+export const unsaveHandle = (handle: string): Updater => (n) => (n.saved.includes(handle) ? { ...n, saved: n.saved.filter((h) => h !== handle) } : n);
+/** Undo of a take-out: the piece goes back where it was in her list, not to the end. */
+export const restoreHandle = (handle: string, index: number): Updater => (n) => {
+  if (n.saved.includes(handle) || !HANDLE.test(handle)) return n;
+  const saved = [...n.saved];
+  saved.splice(Math.max(0, Math.min(index, saved.length)), 0, handle);
+  return { ...n, saved: saved.slice(-MAX_SAVED) };
+};
+
+/** A gift date (Phase 4): never more than eight, and a ninth is refused, never squeezed in by dropping one. */
+export const addGift = (gift: Gift, n: Naira): { ok: true; naira: Naira } | { ok: false; message: string } => {
+  if (!giftOf(gift)) return { ok: false, message: "Please check the name and the date." };
+  if (n.gifts.length >= MAX_GIFTS) return { ok: false, message: "Eight dates are kept at most. Remove one to add another." };
+  return { ok: true, naira: { ...n, gifts: [...n.gifts, gift] } };
+};
diff --git a/src/lib/portal/rubMask.ts b/src/lib/portal/rubMask.ts
