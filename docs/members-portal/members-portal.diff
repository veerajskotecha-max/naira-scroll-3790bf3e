+++ b/src/lib/portal/petals.ts
@@ -0,0 +1,174 @@
+import { META_CAP_BYTES, bytesOf, type Naira, type Updater } from "./memberMeta";
+
+/*
+  Play (Phase 6): the Naira flower has come apart in the breeze. Its four
+  petals and its stem are tucked in five of her rooms, one in each, at the
+  same spot for every member; she takes each home with a tap, and the flower
+  forms again at the crown of her garden's arbour. And, after dark, she can
+  trace her month's flower star by star in her garden's sky.
+
+  Her account keeps all of it in one small integer, user_metadata.naira.p
+  (1 to 63, absent when 0; memberMeta): one bit per piece and one for
+  the stars. The bits are pinned (a test holds them): Drops 0, the Drawer 1,
+  Your fit 2, Gifts 3, Care 4, written in her sky 5. Bits a later version
+  might set are not kept: memberMeta reads the number only from 1 to 63.
+
+  A play write only ever adds its bit, onto her account's fresh copy (the
+  debounced writer re-runs it there), so another phone's finds are kept. It
+  never clears a bit, and it never costs her anything: a write that would
+  pass the 1.2 KB cap is not made at all (the same object comes back, so
+  nothing is written and no saved piece is trimmed to make room). Such a
+  find is kept for this visit only, in this module's memory, so the room and
+  the Herbarium still show it as found until she leaves, and the words say
+  so (fitsOnAccount). That memory is hers alone: it is keyed by her account
+  id and starts afresh when another member signs in on the same tab. Two
+  phones writing in the same instant can lose a find; the piece is then
+  simply back in its room.
+
+  Nothing here counts, ranks, times or rewards her: pieces never blow away,
+  nothing expires, nothing reminds her, and nothing is compared between
+  members. Every word she sees is in WORDS below, where copy.test reads
+  them: no digit, and nothing that would make a game of it.
+*/
+
+export type PieceKey = "drops" | "drawer" | "fit" | "gifts" | "care";
+
+export type Piece = {
+  key: PieceKey;
+  /** Its bit in naira.p. */
+  bit: number;
+  /** The room, as said in a sentence ("the drawer"). */
+  room: string;
+  /** The room, as a link's words. */
+  name: string;
+  to: string;
+  /** Which of the brand flower's parts it is: a petal (brandFlower's FLOWER_PETALS index) or the stem. */
+  part: number | "stem";
+  /** Its own tilt where it lies, in degrees. */
+  tilt: number;
+  /** The part's box in the flower's 0.6868 x 1 view, a little padded: x, y, width, height. */
+  box: readonly [number, number, number, number];
+};
+
+/* The bits, pinned: a play number already on an account must mean the same thing for ever. */
+export const BITS = { drops: 0, drawer: 1, fit: 2, gifts: 3, care: 4, stars: 5 } as const;
+/** All five pieces found: the Naira flower is whole. */
+export const WHOLE = 31;
+export const STARS = 1 << BITS.stars;
+
+export const PIECES: readonly Piece[] = [
+  { key: "drops", bit: BITS.drops, room: "Drops", name: "Drops", to: "/members/drops", part: 0, tilt: -18, box: [0.458, 0.206, 0.241, 0.158] },
+  { key: "drawer", bit: BITS.drawer, room: "the drawer", name: "Drawer", to: "/members/drawer", part: 1, tilt: 14, box: [0.542, 0.029, 0.165, 0.22] },
+  { key: "fit", bit: BITS.fit, room: "your fit", name: "Your fit", to: "/members/fit", part: "stem", tilt: -8, box: [-0.02, 0.194, 0.605, 0.826] },
+  { key: "gifts", bit: BITS.gifts, room: "Gifts", name: "Gifts", to: "/members/gifts", part: 2, tilt: 22, box: [0.31, 0.024, 0.14, 0.212] },
+  { key: "care", bit: BITS.care, room: "Care", name: "Care", to: "/members/care", part: 3, tilt: -12, box: [0.391, -0.02, 0.221, 0.317] },
+];
+
+export const pieceOf = (key: PieceKey): Piece => PIECES.find((p) => p.key === key) as Piece;
+
+/** Her play number as her account holds it (0 when it has none). */
+export const playOf = (naira: Naira): number => (typeof naira.p === "number" ? naira.p : 0);
+
+/** Whether her account can keep this bit (it has it, or has room for it): when not, the find is kept for this visit only, and said so. */
+export const fitsOnAccount = (n: Naira, bit: number): boolean => Boolean(playOf(n) & (1 << bit)) || bytesOf({ ...n, p: playOf(n) | (1 << bit) }) <= META_CAP_BYTES;
+
+/** One bit added onto her account's copy: the same object when it is already there, or when the write would pass the cap. */
+const addBit = (bit: number): Updater => (n) => {
+  const p = playOf(n);
+  if (p & (1 << bit) || !fitsOnAccount(n, bit)) return n;
+  return { ...n, p: p | (1 << bit) };
+};
+
+const unchanged: Updater = (n) => n;
+
+/** A piece taken home (bits 0 to 4 only; anything else changes nothing). */
+export const findPiece = (bit: number): Updater => (Number.isInteger(bit) && bit >= BITS.drops && bit <= BITS.care ? addBit(bit) : unchanged);
+
+/** Her month's flower, traced in her garden's stars. Written once, on completion. */
+export const keepStars: Updater = addBit(BITS.stars);
+
+/* ── this visit's memory ─────────────────────────────── */
+
+/*
+  What she found this visit, in module memory (never stored): a find her
+  account had no room for still shows as found until she leaves, and the
+  garden's crown presses in, once, a piece found since she was last there.
+  Keyed by her account id: signing out navigates without a reload, so the
+  next member to sign in on the same tab starts with nothing found.
+*/
+const visit = { u: "", found: 0, fresh: 0 };
+const visitOf = (u: string) => {
+  if (visit.u !== u) {
+    visit.u = u;
+    visit.found = 0;
+    visit.fresh = 0;
+  }
+  return visit;
+};
+
+export const noteFound = (u: string, bit: number): void => {
+  if (!Number.isInteger(bit) || bit < BITS.drops || bit > BITS.care) return;
+  const v = visitOf(u);
+  v.found |= 1 << bit;
+  v.fresh |= 1 << bit;
+};
+
+/** What she found this visit (her account's finds aside). */
+export const foundThisVisit = (u: string): number => visitOf(u).found;
+
+/** The pieces she has found: her account's, and this visit's. */
+export const piecesFound = (naira: Naira, u: string): number => (playOf(naira) | visitOf(u).found) & WHOLE;
+
+/** Found since she was last in the garden (the crown presses these in once). */
+export const freshFinds = (u: string): number => visitOf(u).fresh;
+
+/** The crown has pressed them in. */
+export const pressedIn = (u: string, bits: number): void => {
+  visitOf(u).fresh &= ~bits;
+};
+
+/** For tests: a new visit. */
+export const forgetVisit = (): void => {
+  visit.u = "";
+  visit.found = 0;
+  visit.fresh = 0;
+};
+
+/* ── words ──────────────────────────────────────────── */
+
+/** "Drops", "Drops and the Drawer", "Drops, the Drawer and Care": the rooms whose bits are set, in the bits' order. */
+export const roomsSaid = (bits: number): string => {
+  const rooms = PIECES.filter((p) => bits & (1 << p.bit)).map((p) => p.room);
+  return rooms.length < 2 ? (rooms[0] ?? "") : `${rooms.slice(0, -1).join(", ")} and ${rooms[rooms.length - 1]}`;
+};
+
+/** The rooms still holding a piece, in order (the Herbarium's links). */
+export const roomsHolding = (bits: number): Piece[] => PIECES.filter((p) => !(bits & (1 << p.bit)));
+
+export const WORDS = {
+  petal: "A petal of the Naira flower, tucked here: take it home",
+  stem: "The Naira flower's stem, tucked here: take it home",
+  printPetal: "Where a petal of the Naira flower lay, taken home to your garden",
+  printStem: "Where the Naira flower's stem lay, taken home to your garden",
+  taken: "Taken home to your garden.",
+  /** Said in place of `taken` when her account has no room to keep the find: the room and the garden show it until she leaves. */
+  visitOnly: "Taken home for this visit: your account has no room to keep it just now.",
+  first: "The rest are tucked about your rooms, for whenever you wander.",
+  whole: "The Naira flower is whole again, at the crown of your garden's arbour.",
+  growing: "The Naira flower at the arbour's crown",
+  gatheredFrom: "gathered from",
+  wholeGrowing: "whole again, edged in gold leaf",
+  keepName: "Gathered",
+  keptNote: "Kept when the Naira flower's five pieces came home from your rooms. For joy, not points, never redeemable.",
+  howNote: "Kept when the Naira flower's pieces, tucked about your rooms, come home to your garden.",
+  /** Every piece came home this visit, but her account could not keep them all. */
+  visitNote: "Every piece came home this visit, but your account has no room to keep them just now.",
+  visitWhole: "whole for this visit",
+  holding: "Still tucked in",
+} as const;
+
+/** "What's growing", in words: no digit, the rooms named; whole only for this visit when her account could not keep every piece. */
+export const crownSaid = (bits: number, kept = bits): string =>
+  (bits & WHOLE) === WHOLE
+    ? `${WORDS.growing}, ${(kept & WHOLE) === WHOLE ? WORDS.wholeGrowing : WORDS.visitWhole}: gathered from ${roomsSaid(WHOLE)}.`
+    : `${WORDS.growing}, ${WORDS.gatheredFrom} ${roomsSaid(bits & WHOLE)}.`;
