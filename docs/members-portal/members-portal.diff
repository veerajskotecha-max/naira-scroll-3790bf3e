+import type { Drop } from "./drops";
+import type { Naira } from "./memberMeta";
+import { formatIstDate, formatIstDay } from "./ist";
+import { stoneForMonth } from "./stones";
+
+/*
+  The Herbarium's four keepsakes, each kept for something she did, said
+  plainly with what it was kept for:
+    Seed          she joined (every member has it, from her first day);
+    Birth Flower  her birthday, or her month alone, is saved (her month's flower);
+    Fitted        her ring size is saved;
+    Front Row     she opened a drop in its first hour and pressed its flower.
+  They are for joy, not points: never redeemable, never ranked or compared,
+  and they open nothing. One not kept yet is a gentle empty frame saying how
+  it is kept, never what she missed.
+*/
+
+export type KeepsakeId = "seed" | "birth" | "fitted" | "front";
+
+export type Keepsake = {
+  id: KeepsakeId;
+  name: string;
+  kept: boolean;
+  /** Kept: what it was kept for ("Planted 4 Nov 2026"). Not yet: how it is kept. */
+  note: string;
+  /** Where she can keep it, when it is not kept yet. */
+  to?: string;
+  /** The Birth Flower's drawing: one of the garden's six, where her month's flower is one of them. */
+  species?: number;
+};
+
+/* Of the twelve birth flowers, the garden draws two (rose, marigold). Every
+   other month's frame shows the camellia in her month's colour and does not
+   name a flower it is not drawing (the twelve drawings are Phase 4's art). */
+const DRAWN: Record<string, number> = { Rose: 0, Marigold: 3 };
+const CAMELLIA = 4;
+
+const HOW_RING: Record<string, string> = { s: "measured on your screen", t: "measured with a thread", k: "as you told us" };
+
+export const keepsakesFor = ({
+  joinedAt,
+  month,
+  naira,
+  drops,
+}: {
+  joinedAt: string | null | undefined;
+  /** Her birth month (her birthday's, or the month alone she kept). */
+  month: number | null | undefined;
+  naira: Naira;
+  drops: readonly Drop[];
+}): Keepsake[] => {
+  const planted = formatIstDate(joinedAt);
+  const stone = stoneForMonth(month);
+  const firstFront = naira.front.map((id) => drops.find((d) => d.id === id)).find((d): d is Drop => Boolean(d));
+  const ring = naira.ring;
+  return [
+    { id: "seed", name: "Seed", kept: true, note: planted ? `Planted ${planted}, the day you joined` : "Planted the day you joined" },
+    stone
+      ? stone.flower in DRAWN
+        ? { id: "birth", name: "Birth Flower", kept: true, note: `${stone.flower}, for ${stone.monthName}`, species: DRAWN[stone.flower] }
+        : { id: "birth", name: "Birth Flower", kept: true, note: `Your ${stone.monthName} flower, in your month's colour`, species: CAMELLIA }
+      : { id: "birth", name: "Birth Flower", kept: false, note: "Kept when your birthday or month is saved", to: "/members/stone" },
+    ring
+      ? { id: "fitted", name: "Fitted", kept: true, note: `US ${ring.us}, ${HOW_RING[ring.how]}, ${formatIstDay(`${ring.at}T12:00:00+05:30`)}` }
+      : { id: "fitted", name: "Fitted", kept: false, note: "Kept when your ring size is saved", to: "/members/fit" },
+    naira.front.length
+      ? { id: "front", name: "Front Row", kept: true, note: firstFront ? `${firstFront.title}, opened in its first hour` : "A drop opened in its first hour" }
+      : {
+          id: "front",
+          name: "Front Row",
+          kept: false,
+          note: drops.length ? "Kept the first time you are there as a drop opens, and press its flower" : "Kept the first time you are there as a drop opens. The first drop is not set yet.",
+        },
+  ];
+};
