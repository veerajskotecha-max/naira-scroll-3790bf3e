@@ -0,0 +1,227 @@
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import DoorsOpen, { DOORS_MS } from "./DoorsOpen";
+import { MemberProvider, type Member } from "./MemberContext";
+import { doorsModeFor, pickDoors } from "@/lib/portal/doors";
+import { istDayKey } from "@/lib/portal/ist";
+import { writePortal } from "@/lib/portal/safeStorage";
+import { readNaira } from "@/lib/portal/memberMeta";
+
+// The garden grows a sprig for each heart on this phone (its drawer, read only).
+vi.mock("@/contexts/WishlistContext", () => ({ useWishlist: () => ({ items: [] }) }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => null }));
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => ({ jewellery: [], isLive: false, isLoading: false }) }));
+/* Her confirmed orders' gold roses read member_orders once the Doors have gone (Phase 5): never the live Supabase from a test. */
+vi.mock("@/integrations/supabase/lazy", () => ({
+  getSupabase: async () => {
+    throw new Error("Supabase is not reached from this test");
+  },
+}));
+
+import GardenHome from "@/pages/members/GardenHome";
+
+const setReducedMotion = (reduce: boolean) => {
+  window.matchMedia = ((query: string) => ({
+    matches: reduce && query.includes("reduce"),
+    media: query,
+    onchange: null,
+    addListener: () => {},
+    removeListener: () => {},
+    addEventListener: () => {},
+    removeEventListener: () => {},
+    dispatchEvent: () => false,
+  })) as typeof window.matchMedia;
+};
+
+const member = (over: Partial<Member> = {}): Member => ({
+  user: { id: "u-1", email: "ananya@example.com", created_at: "2026-11-04T05:00:00Z", user_metadata: {} } as unknown as Member["user"],
+  profile: { id: "u-1", full_name: "Ananya", birthday: "1999-07-14", phone: null, city: null },
+  firstName: "Ananya",
+  preview: false,
+  saveBirthday: async () => ({ ok: true }),
+  addToBag: async () => true,
+  buyNow: async () => {},
+  bagBusy: false,
+  doorsPlayed: false,
+  markDoorsPlayed: () => {},
+  drops: [],
+  unlisted: [],
+  pressed: [],
+  press: () => {},
+  naira: readNaira(null),
+  changeMeta: () => ({ ok: true }),
+  savedSync: { h: [], x: [] },
+  keepSavedSync: () => {},
+  metaProblem: null,
+  retryMeta: () => {},
+  since: null,
+  month: 7,
+  // Her first signed-in visit: the arrival repair's one day.
+  firstVisit: true,
+  arrivalProfile: { id: "u-1", full_name: "Ananya", birthday: "1999-07-14", phone: null, city: null },
+  arrival: {
+    hasOwnSignup: async () => true,
+    join: async () => ({ ok: true, already: true }),
+    saveConsent: async () => ({ ok: true }),
+  },
+  ...over,
+});
+
+const home = (m: Member) =>
+  render(
+    <MemoryRouter>
+      <MemberProvider value={m}>
+        <GardenHome />
+      </MemberProvider>
+    </MemoryRouter>,
+  );
+
+beforeEach(() => {
+  window.localStorage.clear();
+  setReducedMotion(false);
+});
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+});
+
+describe("the Doors", () => {
+  it("fit the plan's timings: 1.6 s in full, 0.5 s after", () => {
+    expect(DOORS_MS.full).toBeLessThanOrEqual(1600);
+    expect(DOORS_MS.short).toBeLessThanOrEqual(500);
+  });
+
+  it("play in full once per IST day on this device, then short", () => {
+    const today = istDayKey(new Date("2026-11-05T06:00:00Z"));
+    expect(doorsModeFor(undefined, today)).toBe("full");
+    expect(doorsModeFor("2026-11-04", today)).toBe("full");
+    expect(doorsModeFor(today, today)).toBe("short");
+    writePortal({ doorsDay: istDayKey() });
+    expect(pickDoors(false)).toBe("short");
+    expect(pickDoors(true)).toBeNull();
+  });
+
+  it("record the full entrance, so the next visit that day is short", () => {
+    const first = home(member());
+    expect(first.container.querySelector(".ig-doors")?.getAttribute("data-mode")).toBe("full");
+    first.unmount();
+    const second = home(member());
+    expect(second.container.querySelector(".ig-doors")?.getAttribute("data-mode")).toBe("short");
+  });
+
+  it("sway at most 24 plants when motion is allowed", () => {
+    const { container } = home(member({ doorsPlayed: true }));
+    const sway = container.querySelectorAll(".ig-sway").length;
+    expect(sway).toBeGreaterThan(0);
+    expect(sway).toBeLessThanOrEqual(24);
+  });
+
+  it("do not replay when she comes back to the garden in the same visit", () => {
+    const { container } = home(member({ doorsPlayed: true }));
+    expect(container.querySelector(".ig-doors")).toBeNull();
+    expect(document.activeElement).toBe(screen.getByRole("heading", { level: 1 }));
+  });
+
+  it("start the garden as the curtain lifts and finish within their time", () => {
+    vi.useFakeTimers();
+    const onReveal = vi.fn();
+    const onDone = vi.fn();
+    render(<DoorsOpen mode="full" name="Ananya" greeting="Good evening" onReveal={onReveal} onDone={onDone} />);
+    act(() => void vi.advanceTimersByTime(819));
+    expect(onReveal).not.toHaveBeenCalled();
+    act(() => void vi.advanceTimersByTime(1));
+    expect(onReveal).toHaveBeenCalledWith(false);
+    act(() => void vi.advanceTimersByTime(780));
+    expect(onDone).toHaveBeenCalledTimes(1);
+  });
+
+  it("skip on a tap, once", () => {
+    const onDone = vi.fn();
+    const { container } = render(<DoorsOpen mode="full" name="Ananya" greeting="Good evening" onReveal={() => {}} onDone={onDone} />);
+    fireEvent.pointerDown(container.querySelector(".ig-doors")!);
+    fireEvent.pointerDown(container.querySelector(".ig-doors")!);
+    expect(onDone).toHaveBeenCalledTimes(1);
+  });
+
+  it("skip on Escape too", () => {
+    const onDone = vi.fn();
+    render(<DoorsOpen mode="short" name="Ananya" greeting="Good evening" onReveal={() => {}} onDone={onDone} />);
+    fireEvent.keyDown(window, { key: "Escape" });
+    expect(onDone).toHaveBeenCalledTimes(1);
+  });
+
+  /* Under reduced motion the garden is simply open: no overlay, nothing left
+     waiting at opacity 0, and the heading takes focus. */
+  it("show the final state at once under reduced motion", () => {
+    setReducedMotion(true);
+    const { container } = home(member());
+    expect(container.querySelector(".ig-doors")).toBeNull();
+    const h1 = screen.getByRole("heading", { level: 1 });
+    expect(h1).toHaveTextContent(/Ananya$/);
+    expect(document.activeElement).toBe(h1);
+    const hidden = [...container.querySelectorAll<HTMLElement>("*")].filter((el) => el.style.opacity === "0");
+    expect(hidden).toEqual([]);
+    // No sway layers either: every plant stands still.
+    expect(container.querySelector(".ig-bed")).not.toBeNull();
+    expect(container.querySelectorAll(".ig-sway")).toHaveLength(0);
+  });
+});
+
+describe("the arrival repair on the garden home", () => {
+  const needsBoth = (): Member["arrival"] => ({
+    hasOwnSignup: async () => false,
+    join: async () => ({ ok: true, already: false }),
+    saveConsent: async () => ({ ok: true }),
+  });
+
+  it("waits for the Doors to finish, then asks below her garden", async () => {
+    vi.useFakeTimers();
+    const { container } = home(member({ arrival: needsBoth() }));
+    expect(container.querySelector(".ig-doors")).not.toBeNull();
+    await act(async () => {
+      await Promise.resolve();
+    });
+    expect(screen.queryByRole("heading", { name: "Two quick questions" })).toBeNull();
+    await act(async () => {
+      vi.advanceTimersByTime(DOORS_MS.full + 50);
+    });
+    expect(container.querySelector(".ig-doors")).toBeNull();
+    await act(async () => {
+      // The card is a chunk of its own, fetched as her garden opened (under the Doors).
+      await vi.dynamicImportSettled();
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    const card = screen.getByRole("heading", { name: "Two quick questions" }).closest("section")!;
+    // Her garden and the day's cards first, the questions after.
+    const bed = container.querySelector(".ig-bed-wrap")!;
+    const today = screen.getByRole("heading", { name: "In your garden" });
+    expect(bed.compareDocumentPosition(card) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+    expect(today.compareDocumentPosition(card) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+    expect(screen.getByRole("checkbox")).not.toBeChecked();
+  });
+
+  it("shows at once when there are no Doors to watch, and nothing when she needs nothing", async () => {
+    const { unmount } = home(member({ doorsPlayed: true, arrival: needsBoth() }));
+    expect(await screen.findByRole("heading", { name: "Two quick questions" })).toBeInTheDocument();
+    unmount();
+    window.localStorage.clear();
+    const yes = { id: "u-1", full_name: "Ananya", birthday: null, phone: null, city: null, ad_matching_consent: true };
+    const answered = member({ doorsPlayed: true, profile: yes, arrivalProfile: yes });
+    home(answered);
+    await act(async () => {
+      await new Promise((r) => setTimeout(r, 20));
+    });
+    expect(screen.queryByText(/quick question/)).toBeNull();
+  });
+
+  it("asks nothing on any visit after her first, whatever she is missing", async () => {
+    home(member({ doorsPlayed: true, firstVisit: false, arrival: needsBoth() }));
+    await act(async () => {
+      await new Promise((r) => setTimeout(r, 20));
+    });
+    expect(screen.queryByText(/quick question/)).toBeNull();
+  });
+});
diff --git a/src/components/portal/DoorsOpen.tsx b/src/components/portal/DoorsOpen.tsx
new file mode 100644
index 0000000..ff0dea3
--- /dev/null
+++ b/src/components/portal/DoorsOpen.tsx
@@ -0,0 +1,237 @@
+import { useCallback, useEffect, useLayoutEffect, useRef, type RefObject } from "react";
+import GateIronwork from "./GateIronwork";
+import FlowerDraw, { drawFlower } from "./FlowerDraw";
+import { fallPetals } from "./PetalFall";
+import { EASE_BLOOM, EASE_CURTAIN, EASE_DRAWER, EASE_IN, EASE_REVEAL, cue, play, settled, type Cue } from "@/lib/portal/motion";
+
+/*
+  THE DOORS: the way into her garden. On a sage curtain the Naira flower
+  draws itself large in gold over the gate, fills blush, glints, and drops
+  into the latch like a key. The two leaves then swing back (rotateY ±100°,
+  perspective 900px, --ease-drawer), staying solid until the last of the
+  swing, while the curtain lifts on its cream five-petal tassel (the shop's
+  PageCurtain recipe, copied, not shared: the global curtain is untouched)
+  and the view moves in through the opening onto her garden, which blooms in
+  beneath. Petals thrown from the latch drift down onto it, in a layer that
+  outlasts the Doors.
+
+  1.6 s in full, once per IST day on this device; 0.5 s every other visit. A
+  tap or a key skips it. The caller never mounts it under reduced motion.
+
+  Every animation (and every petal) is built at mount, held, and started
+  together once the page has settled (two frames, fonts in), so nothing is
+  created mid-entrance and the first frames are not shared with the route's
+  own mount work.
+*/
+
+export type DoorsMode = "full" | "short";
+
+// eslint-disable-next-line react-refresh/only-export-components -- the entrance's timings, beside it for its test
+export const DOORS_MS: Record<DoorsMode, number> = { full: 1600, short: 500 };
+
+/* The flower rests in the latch at this scale; it draws at full size. */
+const KEY_REST = 0.38;
+const key = (scale: number, lift = 0) => `translate(-50%, calc(-50% - ${lift}px)) scale(${scale})`;
+
+type Props = {
+  mode: DoorsMode;
+  name: string;
+  greeting: string;
+  /** The curtain is lifting: start the garden's own bloom-in. */
+  onReveal: (short: boolean) => void;
+  onDone: () => void;
+  /** A fixed layer above the Doors that stays after them, for the petals. */
+  petalLayer?: RefObject<HTMLElement>;
+};
+
+const DoorsOpen = ({ mode, name, greeting, onReveal, onDone, petalLayer }: Props) => {
+  const short = mode === "short";
+  const rootRef = useRef<HTMLDivElement>(null);
+  const curtainRef = useRef<HTMLDivElement>(null);
+  const stageRef = useRef<HTMLDivElement>(null);
+  const leftRef = useRef<HTMLDivElement>(null);
+  const rightRef = useRef<HTMLDivElement>(null);
+  const keyRef = useRef<HTMLDivElement>(null);
+  const glintRef = useRef<SVGSVGElement>(null);
+  const wordsRef = useRef<HTMLDivElement>(null);
+  const greetRef = useRef<HTMLParagraphElement>(null);
+  const anims = useRef<Animation[]>([]);
+  const petals = useRef<Animation[]>([]);
+  const cues = useRef<Cue[]>([]);
+  const ended = useRef(false);
+
+  /* Skipped: everything jumps to its end, the petals with it. Played out:
+     the petals still in the air keep falling onto the garden. */
+  const end = useCallback(
+    (skipped: boolean) => {
+      if (ended.current) return;
+      ended.current = true;
+      cues.current.forEach((c) => c.cancel());
+      for (const a of skipped ? [...anims.current, ...petals.current] : anims.current) {
+        try {
+          a.finish();
+        } catch {
+          a.cancel();
+        }
+      }
+      onDone();
+    },
+    [onDone],
+  );
+
+  // Before the first paint, so the closed gate is the first thing she sees.
+  useLayoutEffect(() => {
+    ended.current = false;
+    const list: Animation[] = [];
+    const flock: Animation[] = [];
+    const steps: Cue[] = [];
+    anims.current = list;
+    petals.current = flock;
+    cues.current = steps;
+    const keep = (a: Animation | null) => {
+      if (a) list.push(a);
+    };
+    // Steps cued on the same timeline as the animations, so they stay in time.
+    const at = (ms: number, fn: () => void) => {
+      const c = cue(rootRef.current, ms, () => {
+        if (!ended.current) fn();
+      });
+      steps.push(c);
+      keep(c.animation);
+    };
+
+    if (!short) {
+      // 0–0.7 s: the flower draws itself, large, and its colour comes in.
+      list.push(...drawFlower(keyRef.current, { duration: 520 }));
+      keep(play(greetRef.current, [{ opacity: 0, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 420, delay: 120, easing: EASE_REVEAL, fill: "backwards" }));
+      // 0.6 s: one glint as it is finished.
+      keep(
+        play(
+          glintRef.current,
+          [
+            { opacity: 0, transform: "scale(.2) rotate(0deg)" },
+            { opacity: 1, transform: "scale(1.3) rotate(45deg)", offset: 0.45 },
+            { opacity: 0, transform: "scale(.6) rotate(90deg)" },
+          ],
+          { duration: 300, delay: 600, easing: "ease-out", fill: "both" },
+        ),
+      );
+      // 0.76–0.9 s: it drops into the latch, a key.
+      keep(play(keyRef.current, [{ transform: key(1) }, { transform: key(KEY_REST) }], { duration: 160, delay: 760, easing: EASE_BLOOM, fill: "both" }));
+      // 1.18–1.48 s: and rises away as the view passes through.
+      keep(play(keyRef.current, [{ transform: key(KEY_REST), opacity: 1 }, { transform: key(0.5, 18), opacity: 0 }], { duration: 300, delay: 1180, easing: EASE_IN, fill: "forwards" }));
+    } else {
+      keep(play(keyRef.current, [{ opacity: 1, transform: key(KEY_REST) }, { opacity: 0, transform: key(0.46, 22) }], { duration: 220, delay: 60, easing: EASE_IN, fill: "forwards" }));
+    }
+
+    // The leaves swing back, solid until the last 15% of the swing.
+    const swing: KeyframeAnimationOptions = { duration: short ? 420 : 760, delay: short ? 0 : 840, easing: "linear", fill: "both" };
+    const leaf = (deg: number): Keyframe[] => [
+      { transform: "rotateY(0deg)", opacity: 1, easing: EASE_DRAWER },
+      { transform: `rotateY(${deg * 0.86}deg)`, opacity: 1, offset: 0.85, easing: "linear" },
+      { transform: `rotateY(${deg}deg)`, opacity: 0 },
+    ];
+    keep(play(leftRef.current, leaf(100), swing));
+    keep(play(rightRef.current, leaf(-100), swing));
+
+    // The curtain lifts while the leaves are still opening, onto her garden.
+    keep(play(curtainRef.current, [{ transform: "translateY(0)" }, { transform: "translateY(-100%)" }], { duration: short ? 400 : 600, delay: short ? 80 : 820, easing: EASE_CURTAIN, fill: "forwards" }));
+    keep(
+      play(wordsRef.current, [{ opacity: 1, transform: "none" }, { opacity: 0, transform: "translateY(-12px)" }], {
+        duration: short ? 220 : 240,
+        delay: short ? 60 : 860,
+        easing: EASE_IN,
+        fill: "forwards",
+      }),
+    );
+    if (!short) {
+      // The walk through: the view moves in, centred on the latch.
+      const stage = stageRef.current;
+      const latch = keyRef.current?.getBoundingClientRect();
+      const box = stage?.getBoundingClientRect();
+      if (stage && latch && box) stage.style.transformOrigin = `${latch.left - box.left + latch.width / 2}px ${latch.top - box.top + latch.height / 2}px`;
+      keep(play(stage, [{ transform: "scale(1)" }, { transform: "scale(1.35)" }], { duration: 680, delay: 820, easing: EASE_DRAWER, fill: "forwards" }));
+    }
+
+    at(short ? 60 : 820, () => onReveal(short));
+    at(DOORS_MS[mode], () => end(false));
+
+    // Held at their first frame until the page has settled, then all at once.
+    const held = [...list];
+    held.forEach((a) => a.pause());
+    let live = true;
+    let net = 0;
+    void settled().then(() => {
+      if (!live) return;
+      // 0.8 s: petals thrown from the latch, falling onto the garden. Made here, with
+      // everything else about to start: the layer they fall in is mounted by now.
+      const latch = keyRef.current?.getBoundingClientRect();
+      if (!short && latch && petalLayer?.current) {
+        flock.push(...fallPetals(petalLayer.current, latch.left + latch.width / 2, latch.top + latch.height / 2, { count: 24, delay: 800 }));
+      }
+      held.forEach((a) => a.play());
+      // A safety net should the timeline never run (a tab hidden mid-entrance).
+      net = window.setTimeout(() => end(false), 8000);
+    });
+
+    return () => {
+      live = false;
+      window.clearTimeout(net);
+      // Gone before the end (she left mid-entrance): stop everything, petals too.
+      if (!ended.current) {
+        ended.current = true;
+        steps.forEach((c) => c.cancel());
+        [...list, ...flock].forEach((a) => a.cancel());
+      }
+    };
+    // Played once, as mounted.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  useEffect(() => {
+    const onKey = (e: KeyboardEvent) => {
+      if (e.key === "Escape" || e.key === "Enter" || e.key === " ") end(true);
+    };
+    window.addEventListener("keydown", onKey);
+    return () => window.removeEventListener("keydown", onKey);
+  }, [end]);
+
+  return (
+    <div ref={rootRef} className="ig-doors" aria-hidden onPointerDown={() => end(true)} data-mode={mode}>
+      <div ref={curtainRef} className="ig-curtain">
+        <svg className="ig-tassel" viewBox="0 0 40 40" width="40" height="40">
+          {[0, 72, 144, 216, 288].map((a) => {
+            const rad = ((a - 90) * Math.PI) / 180;
+            const x = 20 + Math.cos(rad) * 9;
+            const y = 20 + Math.sin(rad) * 9;
+            return <ellipse key={a} cx={x} cy={y} rx="6" ry="3.4" fill="#FFF8F5" transform={`rotate(${a - 90} ${x} ${y})`} />;
+          })}
+          <circle cx="20" cy="20" r="4.4" fill="var(--nf-blush)" />
+        </svg>
+      </div>
+      <div ref={stageRef} className="ig-doors-stage">
+        <GateIronwork
+          tone="sage"
+          leftRef={leftRef}
+          rightRef={rightRef}
+          latch={
+            <div ref={keyRef} className="ig-doors-key">
+              <FlowerDraw height={168} strokePx={1.8} halo />
+              <svg ref={glintRef} className="ig-doors-glint" viewBox="-12 -12 24 24">
+                <path d="M0-11L1.6-1.6L11 0L1.6 1.6L0 11L-1.6 1.6L-11 0L-1.6-1.6Z" fill="#FFF8EE" stroke="var(--nf-accent-strong)" strokeWidth=".8" />
+              </svg>
+            </div>
+          }
+        />
+        <div ref={wordsRef} className="ig-doors-words">
+          <p ref={greetRef} className="ig-doors-greet" data-clarity-mask="true">
+            {greeting}, <em>{name}</em>
+          </p>
+          {!short && <p className="ig-doors-hint">Tap to skip</p>}
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default DoorsOpen;
diff --git a/src/components/portal/DropBox.tsx b/src/components/portal/DropBox.tsx
new file mode 100644
index 0000000..6b9cf4e
--- /dev/null
+++ b/src/components/portal/DropBox.tsx
@@ -0,0 +1,169 @@
+import type { CSSProperties, Ref } from "react";
+import printSm from "@/assets/naira-box-print-sm.webp";
+import { COLOURS, PEEK_POSE, SLOT, boxGeometry, drawerTransforms, poseTransform, type BoxPose } from "@/lib/portal/boxPose";
+
+/*
+  The Naira gift box in CSS 3D, for the drop's unboxing: the portal's own
+  copy of the bag's box (components/giftbox/NairaBoxCSS). Importing that one
+  would share lib/nairaBox/config with the footer's three.js box and split
+  it into a new chunk every shop page then fetches, so its proportions and
+  colours are repeated here. Faces are divs; the compositor does the
+  perspective and the motion (transform and opacity only, no blur).
+
+  One convex box, every face turned out: the open drawer is the same box
+  made longer, its pulled-out part drawn through fixed windows (the velvet
+  tray on top, the two sides) whose contents slide back under the sleeve as
+  it closes. The piece stands in the cushion's slot, turned to face her, and
+  rises out of a window whose foot is the slot.
+*/
+
+export type BoxParts = {
+  lift?: Ref<HTMLDivElement>;
+  box?: Ref<HTMLDivElement>;
+  gleam?: Ref<HTMLDivElement>;
+  riser?: Ref<HTMLDivElement>;
+  glint?: Ref<HTMLDivElement>;
+  rule?: Ref<SVGRectElement>;
+  front?: Ref<HTMLDivElement>;
+  tray?: Ref<HTMLDivElement>;
+  left?: Ref<HTMLDivElement>;
+  right?: Ref<HTMLDivElement>;
+};
+
+type Props = {
+  size: number;
+  pose: BoxPose;
+  /** 0 shut, 1 open. */
+  open: number;
+  /** The piece is up out of its slot. */
+  raised: boolean;
+  /** A transparent cut-out (stands as it is), or a shop photo (shown as a framed specimen). */
+  piece?: { src: string; cutout: boolean };
+  parts?: BoxParts;
+};
+
+const face = (w: number, h: number, W: number, H: number, transform: string, style: CSSProperties = {}): CSSProperties => ({
+  position: "absolute",
+  boxSizing: "border-box",
+  width: w,
+  height: h,
+  left: (W - w) / 2,
+  top: (H - h) / 2,
+  transform,
+  backfaceVisibility: "hidden",
+  WebkitBackfaceVisibility: "hidden",
+  ...style,
+});
+
+const fill: CSSProperties = { position: "absolute", inset: 0 };
+
+const GLINT =
+  "radial-gradient(circle, rgb(255 255 255) 0 7%, rgb(255 255 255 / 0) 32%), " +
+  "linear-gradient(90deg, transparent 47%, rgb(255 255 255 / 0.95) 50%, transparent 53%), " +
+  "linear-gradient(0deg, transparent 47%, rgb(255 255 255 / 0.95) 50%, transparent 53%)";
+const GLINT_FADE = "radial-gradient(circle, #000 0 22%, transparent 68%)";
+
+const DropBox = ({ size, pose, open, raised, piece, parts = {} }: Props) => {
+  const { W, D, H, travel: E } = boxGeometry(size);
+  const rim = `${Math.max(1, size * 0.012)}px solid ${COLOURS.rim}`;
+  const wall = Math.max(1.5, size * 0.03);
+  const drawer = drawerTransforms(size, open);
+  const pulledOut = `translateZ(${D / 2 + E / 2}px)`;
+  // A cut-out stands as the bag's ring does; a shop photo rises as a herbarium specimen: an ivory mat with an inner gold rule.
+  const pieceW = W * (piece?.cutout ? 0.48 : 0.46);
+  const pieceH = piece?.cutout ? pieceW * (172 / 132) : pieceW * 1.22;
+
+  return (
+    <div className="ig-box" style={{ width: W, height: H + size * 0.36, perspective: size * 5.1, perspectiveOrigin: "50% 28%" }} aria-hidden>
+      <div className="ig-box-shadow" style={{ top: H + size * 0.2, left: -W * 0.125, width: W * 1.25, height: size * 0.2 }} />
+      <div ref={parts.lift} className="ig-box-3d" style={fill}>
+        <div ref={parts.box} className="ig-box-3d" style={{ position: "absolute", left: 0, top: size * 0.12, width: W, height: H, transform: poseTransform(pose) }}>
+          {/* Sleeve: lid, base, sides, back; open at the front. */}
+          <div style={face(W, D, W, H, `rotateX(90deg) translateZ(${H / 2}px)`, { background: "linear-gradient(140deg, #F2DED8 0%, #E6CCC5 55%, #DDBFB8 100%)", overflow: "hidden", border: rim })}>
+            <img src={printSm} alt="" draggable={false} style={{ position: "absolute", left: "19%", width: "62%", top: "34%", opacity: 0.86 }} />
+            <div
+              ref={parts.gleam}
+              style={{ position: "absolute", inset: "-20% 0", width: "45%", background: "linear-gradient(90deg, rgb(255 255 255 / 0), rgb(255 250 244 / 0.62), rgb(255 255 255 / 0))", transform: "translateX(-160%) skewX(-18deg)" }}
+            />
+          </div>
+          <div style={face(W, D, W, H, `rotateX(-90deg) translateZ(${H / 2}px)`, { background: COLOURS.cardDeep })} />
+          <div style={face(D, H, W, H, `rotateY(90deg) translateZ(${W / 2}px)`, { background: "linear-gradient(180deg, #C8A69F, #B9968F)", borderTop: rim, borderLeft: rim })} />
+          <div style={face(D, H, W, H, `rotateY(-90deg) translateZ(${W / 2}px)`, { background: "linear-gradient(180deg, #D8B8B1, #CBA9A2)", borderTop: rim, borderRight: rim })} />
+          <div style={face(W, H, W, H, `rotateY(180deg) translateZ(${D / 2}px)`, { background: COLOURS.cardDeep })} />
+
+          {/* The pulled-out part of the drawer, through its three windows. */}
+          <div style={face(W, E, W, H, `${pulledOut} rotateX(90deg) translateZ(${H / 2}px)`, { overflow: "hidden" })}>
+            <div ref={parts.tray} style={{ ...fill, transform: drawer.tray, background: COLOURS.rim }}>
+              <div style={{ position: "absolute", left: wall, right: wall, top: 0, bottom: wall, background: `radial-gradient(ellipse at 50% 58%, #2E2527 0%, ${COLOURS.velvet} 70%)` }}>
+                <div style={{ ...fill, background: "linear-gradient(180deg, rgb(0 0 0 / 0.6), rgb(0 0 0 / 0) 32%)" }} />
+                <div style={{ position: "absolute", left: 0, right: 0, top: `${(SLOT - 0.18) * 100}%`, height: "36%", background: "linear-gradient(180deg, #4A3C3F 0%, #2B2224 45%, #1A1415 100%)" }}>
+                  <div style={{ position: "absolute", left: "18%", right: "18%", top: "48%", height: Math.max(1, size * 0.02), background: "rgb(0 0 0 / 0.75)" }} />
+                </div>
+              </div>
+            </div>
+          </div>
+          <div style={face(E, H, W, H, `${pulledOut} rotateY(90deg) translateZ(${W / 2}px)`, { overflow: "hidden" })}>
+            <div ref={parts.right} style={{ ...fill, transform: drawer.right, background: "linear-gradient(180deg, #C2A09A, #B3918A)", borderTop: rim }} />
+          </div>
+          <div style={face(E, H, W, H, `${pulledOut} rotateY(-90deg) translateZ(${W / 2}px)`, { overflow: "hidden" })}>
+            <div ref={parts.left} style={{ ...fill, transform: drawer.left, background: "linear-gradient(180deg, #D2B1AA, #C5A39C)", borderTop: rim }} />
+          </div>
+
+          {/* The piece, in the cushion's slot, turned to face her. */}
+          {piece && (
+            <div
+              style={{
+                position: "absolute",
+                left: (W - pieceW) / 2,
+                top: H / 2 - pieceH,
+                width: pieceW,
+                height: pieceH,
+                overflow: "hidden",
+                transformOrigin: "50% 100%",
+                transform: `translate3d(0, ${-H / 2}px, ${D / 2 + E * SLOT}px) rotateY(${-PEEK_POSE.turn}deg) rotateX(${-PEEK_POSE.tilt}deg)`,
+                backfaceVisibility: "hidden",
+                WebkitBackfaceVisibility: "hidden",
+              }}
+            >
+              <div ref={parts.riser} style={{ ...fill, transform: raised ? "translateY(0%)" : "translateY(100%)" }}>
+                {piece.cutout ? (
+                  <img src={piece.src} alt="" draggable={false} style={{ display: "block", width: "100%", height: "100%" }} />
+                ) : (
+                  <span className="ig-box-card">
+                    <img src={piece.src} alt="" draggable={false} />
+                    <svg style={{ position: "absolute", left: "3%", top: "3%", width: "94%", height: "94%", overflow: "visible" }}>
+                      <rect ref={parts.rule} width="100%" height="100%" pathLength={1} fill="none" stroke="#B0843A" strokeOpacity=".75" strokeWidth="1" strokeDasharray="1 1" vectorEffect="non-scaling-stroke" />
+                    </svg>
+                  </span>
+                )}
+                <div
+                  ref={parts.glint}
+                  style={{
+                    position: "absolute",
+                    left: "50%",
+                    top: "16%",
+                    width: pieceW * 0.7,
+                    height: pieceW * 0.7,
+                    marginLeft: -pieceW * 0.35,
+                    marginTop: -pieceW * 0.35,
+                    background: GLINT,
+                    maskImage: GLINT_FADE,
+                    WebkitMaskImage: GLINT_FADE,
+                    opacity: 0,
+                  }}
+                />
+              </div>
+            </div>
+          )}
+
+          {/* The drawer's front panel, with its pull tab. */}
+          <div ref={parts.front} style={face(W, H, W, H, drawer.front, { background: "linear-gradient(180deg, #D1AEA7 0%, #C6A39C 100%)", border: rim })}>
+            <span style={{ position: "absolute", left: "43%", width: "14%", bottom: "8%", height: Math.max(1.5, size * 0.035), background: "#EEDDD7" }} />
+          </div>
+        </div>
+      </div>
+    </div>
+  );
+};
+
+export default DropBox;
