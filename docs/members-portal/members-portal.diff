+      expect(b.y).toBeLessThan(GIFT_TICKS[0] + (k + 1) * 40);
+    }
+    // Later in a month on the left post is higher up; on the right, lower down.
+    expect(giftsOnArbour([g(3, 20)])[0].y).toBeLessThan(giftsOnArbour([g(3, 2)])[0].y);
+    expect(giftsOnArbour([g(9, 20)])[0].y).toBeGreaterThan(giftsOnArbour([g(9, 2)])[0].y);
+  });
+
+  it.each([
+    ["eight on one day", Array.from({ length: 8 }, (_, i) => g(3, 14, `P${i}`))],
+    ["eight crowding the top of the left post", Array.from({ length: 8 }, (_, i) => g(6, 23 + i, `P${i}`))],
+    ["eight crowding the foot of the right post", Array.from({ length: 8 }, (_, i) => g(12, 24 + i, `P${i}`))],
+    ["a 29 February and its neighbours", [g(2, 28), g(2, 29), g(3, 1), g(2, 27, "Didi")]],
+  ])("keeps every flower apart and on its post: %s", (_what, gifts) => {
+    const blooms = giftsOnArbour(gifts);
+    expect(blooms).toHaveLength(gifts.length);
+    for (const post of GIFT_POST_X) {
+      const ys = blooms.filter((b) => b.x === post).map((b) => b.y).sort((a, b) => a - b);
+      for (let k = 1; k < ys.length; k++) expect(ys[k] - ys[k - 1]).toBeGreaterThanOrEqual(GIFT_GAP - 0.01);
+      for (const y of ys) {
+        expect(y).toBeGreaterThanOrEqual(GIFT_REACH[0]);
+        expect(y).toBeLessThanOrEqual(GIFT_REACH[1]);
+      }
+    }
+    // The year's order kept on each post, and the same dates always bloom in the same places.
+    expect(giftsOnArbour(gifts)).toEqual(blooms);
+    expect(new Set(blooms.map((b) => b.key)).size).toBe(gifts.length);
+  });
+});
