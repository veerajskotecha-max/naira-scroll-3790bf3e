+/*
+  The six botanicals of the shop's tap-to-bloom (jewellery/RingAtelierBackdrop),
+  lifted here so the portal's garden, its tap blooms and its drop flowers draw
+  from one table without the portal importing the homepage backdrop (which
+  would split it into a chunk the shop pages then fetch). Flat fills only: the
+  backdrop's radial-gradient cores are replaced by a solid core and a cream
+  dot, which costs nothing to paint on a phone.
+
+  `d` is one petal in a 40x80 box, tip at the top (20,3), base at (20,77).
+*/
+
+export type Species = {
+  name: string;
+  d: string;
+  petals: number;
+  /** Ratio of the inner whorl to the outer one (0 = no inner whorl). */
+  inner: number;
+  palette: readonly string[];
+  core: string;
+  /** Seconds a tap bloom takes to open and fade. */
+  dur: number;
+};
+
+export const SPECIES: readonly Species[] = [
+  {
+    name: "rose",
+    d: "M20,3 C34,20 35,52 20,77 C5,52 6,20 20,3 Z",
+    petals: 9,
+    inner: 0.58,
+    palette: ["#F3D9C6", "#E5B9A4", "#FFC9B4", "#EFCDBB"],
+    core: "#E5B9A4",
+    dur: 1.5,
+  },
+  {
+    name: "wild five",
+    d: "M20,4 C36,22 38,54 20,76 C2,54 4,22 20,4 Z",
+    petals: 5,
+    inner: 0,
+    palette: ["#AEBDB6", "#C9D5CE", "#DCE6E1"],
+    core: "#C9A44C",
+    dur: 1.35,
+  },
+  {
+    name: "jasmine star",
+    d: "M20,2 C26,24 30,40 20,78 C10,40 14,24 20,2 Z",
+    petals: 6,
+    inner: 0.5,
+    palette: ["#FFF6EA", "#F6E4D5", "#FFEFE2"],
+    core: "#E8C88A",
+    dur: 1.6,
+  },
+  {
+    name: "marigold",
+    d: "M20,6 C30,22 31,48 20,74 C9,48 10,22 20,6 Z",
+    petals: 14,
+    inner: 0.62,
+    palette: ["#E9C79B", "#DCB07E", "#F2D9B6", "#C99A4C"],
+    core: "#C99A4C",
+    dur: 1.7,
+  },
+  {
+    name: "camellia",
+    d: "M20,4 C39,18 40,56 20,78 C0,56 1,18 20,4 Z",
+    petals: 7,
+    inner: 0.55,
+    palette: ["#FFD6C6", "#F0BCA8", "#FFE6DA", "#E5B9A4"],
+    core: "#F0BCA8",
+    dur: 1.45,
+  },
+  {
+    name: "teal bud",
+    d: "M20,3 C31,26 32,52 20,77 C8,52 9,26 20,3 Z",
+    petals: 8,
+    inner: 0.5,
+    palette: ["#8FB0AE", "#B7CCC6", "#2F5D63", "#D6E3DE"],
+    core: "#8FB0AE",
+    dur: 1.55,
+  },
+];
+
+/* The camellia's rounder petal, used for her stone flower in every size: a
+   soft bloom around the heart-cut stone, not a star. */
+export const STONE_PETAL = SPECIES[4].d;
+
+/** A petal's transform in a head of radius `r` at angle `deg`, base at the centre. */
+export const petalTransform = (deg: number, r: number) => `rotate(${deg}) translate(0 ${-r * 0.04}) scale(${(r / 74).toFixed(4)}) translate(-20 -77)`;
+
+/** `hex` mixed towards `toward` by `t` (0 = hex, 1 = toward): a drop accent's paler petals. */
+export const mixHex = (hex: string, toward: string, t: number): string => {
+  const read = (h: string) => {
+    const n = Number.parseInt(h.slice(1, 7), 16);
+    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+  };
+  const a = read(hex);
+  const b = read(toward);
+  return `#${a.map((v, i) => Math.round(v + (b[i] - v) * t).toString(16).padStart(2, "0")).join("")}`;
+};
+
+/** The ivory the garden is drawn on, for paling a flower colour. */
+export const PAPER = "#FBF3EC";
+
+/* The Bloom Clock's bud (components/portal/FlowerGlyph). */
+/** Where each petal rests while the bud is shut, and where it turns to when it opens. */
+export const BUD_CLOSED: readonly string[] = ["rotate(-15deg) scale(.64,.94)", "rotate(15deg) scale(.64,.94)", "rotate(-8deg) scale(.7,.97)", "rotate(8deg) scale(.7,.97)", "rotate(0deg) scale(.76,1)"];
+/* They open upward like a lotus fan, outer petals first, inner ones later, never below the
+   horizontal: a bud about to bloom, never one hanging down across its stem. */
+export const BUD_OPEN: readonly string[] = ["rotate(-62deg) scale(.96,.9)", "rotate(62deg) scale(.96,.9)", "rotate(-31deg) scale(1,.96)", "rotate(31deg) scale(1,.96)", "rotate(0deg) scale(1.04,1.04)"];
