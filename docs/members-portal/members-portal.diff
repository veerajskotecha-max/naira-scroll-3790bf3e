+import { describe, expect, it } from "vitest";
+import { DROPS, DROP_SPECIES, type Drop } from "./drops";
+import { dropNumber, dropPhase, dropProblems, dropWarnings, type LiveState } from "./dropPhase";
+import { SPECIES } from "./species";
+import { FIXTURE_PREFIX, PREVIEW_DROP_STATES, readPreviewDrops } from "./previewDrops";
+
+/* The owner writes the manifest by hand. Every entry must be one the portal
+   can show honestly: IST times written with +05:30, members first (never
+   after everyone), a species from the garden's six, a real lead piece. The
+   manifest ships empty; the development fixtures obey the same rules. */
+
+describe("the drop manifest", () => {
+  /* Guards this release, which went out with no drop. Delete it when the
+     owner's first drop goes into drops.ts (the file says so too). */
+  it("ships empty until the owner sets the first drop", () => {
+    expect(DROPS).toEqual([]);
+  });
+
+  it("holds only drops the portal can show", () => {
+    expect(DROPS.flatMap(dropProblems)).toEqual([]);
+  });
+
+  it("has unique ids", () => {
+    expect(new Set(DROPS.map((d) => d.id)).size).toBe(DROPS.length);
+  });
+
+  it("names the garden's six species, in the garden's order", () => {
+    expect([...DROP_SPECIES]).toEqual(SPECIES.map((s) => s.name));
+  });
+});
+
+const good: Drop = {
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
+  accent: "#2F6B4F",
+  story: ["One.", "Two.", "Three."],
+  membersFrom: "2026-11-21T20:00:00+05:30",
+  everyoneFrom: "2026-11-23T20:00:00+05:30",
+  handles: ["a-piece", "b-piece"],
+  leadHandle: "b-piece",
+  reservable: ["a-piece"],
+};
+
+describe("dropProblems tells the owner what to fix", () => {
+  it("passes a well-formed drop", () => {
+    expect(dropProblems(good)).toEqual([]);
+  });
+
+  /* Not errors: the drop works, but would look better with them. */
+  it("notes, gently, a drop with no cut-out for the box to lift", () => {
+    expect(dropWarnings(good)).toEqual([expect.stringMatching(/no cutoutUrl/)]);
+    expect(dropWarnings({ ...good, cutoutUrl: "https://cdn.shopify.com/s/files/1/0680/9606/5698/files/cut.webp" })).toEqual([]);
+  });
+
+  it("keeps a drop's own number for good, and checks it", () => {
+    expect(dropNumber({ ...good, number: 7 }, [good])).toBe("07");
+    expect(dropProblems({ ...good, number: 0 })).toEqual([expect.stringMatching(/number must be a whole number/)]);
+  });
+
+  it.each([
+    ["a time without +05:30", { membersFrom: "2026-11-21T20:00:00Z" }, /membersFrom must be written in IST/],
+    ["a time with another offset", { everyoneFrom: "2026-11-23T20:00:00+05:00" }, /everyoneFrom must be written in IST/],
+    ["members after everyone", { everyoneFrom: "2026-11-20T20:00:00+05:30" }, /membersFrom must not be after everyoneFrom/],
+    ["a species outside the six", { species: "lotus" as Drop["species"] }, /species must be one of/],
+    ["four story lines", { story: ["1", "2", "3", "4"] }, /three lines at most/],
+    ["a lead piece not in the drop", { leadHandle: "c-piece" }, /leadHandle must be one of its handles/],
+    ["a reservable piece not in the drop", { reservable: ["z"] }, /reservable z is not one of its handles/],
+    ["an accent that is not a colour", { accent: "green" }, /accent must be a #RRGGBB colour/],
+    ["an id with spaces", { id: "Petite Fleur" }, /id must be lower-case/],
+    ["an id too long to keep in her account", { id: "the-petite-fleur-of-november" }, /20 characters or fewer/],
+    ["a moved date written badly", { movedFrom: "14 Nov" }, /movedFrom must be written in IST/],
+  ])("catches %s", (_what, over, message) => {
+    expect(dropProblems({ ...good, ...over } as Drop).join("\n")).toMatch(message);
+  });
+});
+
+describe("the development preview drops", () => {
+  const now = Date.parse("2026-11-05T02:00:00Z");
+
+  it.each(PREVIEW_DROP_STATES.map((s) => [s]))("&drop=%s is a well-formed fixture in that state", (state) => {
+    const preview = readPreviewDrops(`?portalPreview=1&drop=${state}`, now)!;
+    expect(preview).not.toBeNull();
+    for (const d of preview.drops) {
+      expect(dropProblems(d)).toEqual([]);
+      expect(d.id.startsWith(FIXTURE_PREFIX)).toBe(true);
+      expect(d.title).toMatch(/\(preview\)$/);
+      expect(d.story[0]).toMatch(/not a real release/);
+    }
+    const main = preview.drops.find((d) => d.id === `${FIXTURE_PREFIX}fleur`)!;
+    const unlisted = new Set(preview.unlisted);
+    const live = (h: string): LiveState => (unlisted.has(h) ? "unlisted" : "available");
+    expect(dropPhase(main, now, live)).toBe(state);
+  });
+
+  it("opens the main fixture at &dropAt, so a petal can be watched opening", () => {
+    const preview = readPreviewDrops("?drop=sealed&dropAt=2026-11-06T02:00:00Z", now)!;
+    expect(preview.drops.find((d) => d.id.endsWith("fleur"))!.membersFrom).toBe("2026-11-06T07:30:00+05:30");
+  });
+
+  it("is off without &drop", () => {
+    expect(readPreviewDrops("?portalPreview=1", now)).toBeNull();
+    expect(readPreviewDrops("?drop=nonsense", now)).toBeNull();
+  });
+});
