+}
+.ig-gate-scene .ig-bed { position: absolute; left: 0; right: 0; bottom: 0; }
+.ig-bed--behind { opacity: 0.42; }
+.ig-gate-cta { margin-top: 1.25rem; }
+.ig-promises {
