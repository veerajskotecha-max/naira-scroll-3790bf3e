+    const dt = Math.max(1, e.timeStamp - d.lastT);
+    d.v = (e.clientX - d.lastX) / dt / Math.max(1, width * 0.55);
+    d.lastX = e.clientX;
+    d.lastT = e.timeStamp;
+    follow(dragToLight(d.from, dx, width));
+  };
