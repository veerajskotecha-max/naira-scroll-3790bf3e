+    expect(shareMode(UAS.safariIos, true)).toBe("share");
+    expect(shareMode(UAS.chromeAndroid, false)).toBe("open");
+    expect(shareMode("", false)).toBe("open");
+    expect(shareMode(null, true)).toBe("share");
