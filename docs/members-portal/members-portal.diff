@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import { DRESSINGS, SEASONS, readableSeason, seasonOn, type SeasonRow } from "./seasons";
+
+/* What is wrong with a row, for the owner (the garden itself only asks readableSeason). */
+const DAY = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+const seasonProblems = (row: SeasonRow): string[] => {
+  const out: string[] = [];
+  if (!/^[a-z0-9-]+$/.test(row.id)) out.push(`${row.id || "(no id)"}: the id is small letters, digits and dashes`);
+  if (!DAY.test(row.start)) out.push(`${row.id}: start is not a YYYY-MM-DD day`);
+  if (!DAY.test(row.end)) out.push(`${row.id}: end is not a YYYY-MM-DD day`);
+  if (DAY.test(row.start) && DAY.test(row.end) && row.end < row.start) out.push(`${row.id}: it ends before it starts`);
+  if (!DRESSINGS.includes(row.dressing)) out.push(`${row.id}: "${row.dressing}" is not one of ${DRESSINGS.join(", ")}`);
+  if (out.length === 0 !== readableSeason(row)) out.push(`${row.id}: the garden reads it differently`);
+  return out;
+};
+
+const ist = (stamp: string) => new Date(`${stamp}+05:30`);
+const holi: SeasonRow = { id: "holi-2027", start: "2027-03-21", end: "2027-03-22", dressing: "holi" };
+
+describe("the festival table", () => {
+  /* Dates are the owner's, never computed. Delete this test when she approves the first row. */
+  it("ships empty until the owner approves a row", () => {
+    expect(SEASONS).toEqual([]);
+  });
+
+  it("holds only rows the garden can read", () => {
+    expect(SEASONS.flatMap(seasonProblems)).toEqual([]);
+    expect(new Set(SEASONS.map((r) => r.id)).size).toBe(SEASONS.length);
+  });
+
+  it("wears a row from the first minute of its first day to the last of its last, in IST", () => {
+    expect(seasonOn([holi], ist("2027-03-20T23:59:59"))).toBeNull();
+    expect(seasonOn([holi], ist("2027-03-21T00:00:00"))).toBe(holi);
+    expect(seasonOn([holi], ist("2027-03-21T12:00:00"))).toBe(holi);
+    expect(seasonOn([holi], ist("2027-03-22T23:59:59"))).toBe(holi);
+    expect(seasonOn([holi], ist("2027-03-23T00:00:00"))).toBeNull();
+  });
+
+  it("counts the days in India, whatever zone the phone is in", () => {
+    // 18:30 UTC on the 20th is midnight on the 21st in India: the first day has begun.
+    expect(seasonOn([holi], new Date("2027-03-20T18:30:00Z"))).toBe(holi);
+    expect(seasonOn([holi], new Date("2027-03-20T18:29:59Z"))).toBeNull();
+    // 18:29 UTC on the 22nd is still the 22nd in India; a minute later it is over.
+    expect(seasonOn([holi], new Date("2027-03-22T18:29:59Z"))).toBe(holi);
+    expect(seasonOn([holi], new Date("2027-03-22T18:30:00Z"))).toBeNull();
+  });
+
+  it("dresses one-day rows on that day alone", () => {
+    const day: SeasonRow = { id: "one-day", start: "2027-08-15", end: "2027-08-15", dressing: "monsoon" };
+    expect(seasonOn([day], ist("2027-08-15T00:00:00"))).toBe(day);
+    expect(seasonOn([day], ist("2027-08-15T23:59:00"))).toBe(day);
+    expect(seasonOn([day], ist("2027-08-16T00:00:00"))).toBeNull();
+  });
+
+  it("has no dressing without a row for today", () => {
+    expect(seasonOn([], ist("2026-11-08T20:00:00"))).toBeNull();
+    expect(seasonOn(SEASONS, new Date())).toBeNull();
+    expect(seasonOn([holi], ist("2026-11-08T20:00:00"))).toBeNull();
+  });
+
+  it("never wears a row it cannot read", () => {
+    const backwards = { id: "backwards", start: "2027-03-22", end: "2027-03-21", dressing: "holi" } as SeasonRow;
+    const unknown = { id: "unknown", start: "2027-03-21", end: "2027-03-22", dressing: "fireworks" } as unknown as SeasonRow;
+    const loose = { id: "loose", start: "21 Mar 2027", end: "2027-03-22", dressing: "holi" } as SeasonRow;
+    for (const row of [backwards, unknown, loose]) {
+      expect(seasonProblems(row).length).toBeGreaterThan(0);
+      expect(seasonOn([row], ist("2027-03-21T12:00:00"))).toBeNull();
+    }
+    expect(seasonProblems(holi)).toEqual([]);
+  });
+
+  it("wears the first matching row when two overlap", () => {
+    const rain: SeasonRow = { id: "rain", start: "2027-03-01", end: "2027-03-31", dressing: "monsoon" };
+    expect(seasonOn([holi, rain], ist("2027-03-21T09:00:00"))).toBe(holi);
+    expect(seasonOn([rain, holi], ist("2027-03-21T09:00:00"))).toBe(rain);
+  });
+});
diff --git a/src/lib/portal/seasons.ts b/src/lib/portal/seasons.ts
new file mode 100644
index 0000000..6d6d51f
--- /dev/null
+++ b/src/lib/portal/seasons.ts
@@ -0,0 +1,49 @@
+import { istDayKey } from "./ist";
+
+/*
+  THE FESTIVAL TABLE. Written by the owner; empty until she approves the
+  first row. Dates are never computed: a festival moves with the moon, and a
+  garden dressed for Diwali on the wrong night is worse than none. Each row
+  is a run of whole days in Indian time, start and end both included, and the
+  garden wears its dressing on those days only. With no row for today there
+  is no dressing, and nothing is fetched for one.
+
+  One row, for example (both days in IST, inclusive):
+
+    { id: "holi-2027", start: "2027-03-21", end: "2027-03-22", dressing: "holi" },
+
+  The dressings:
+  - "diwali":  diyas along the soil and a marigold garland that draws itself
+               across the arbour;
+  - "monsoon": rain in fine hairlines over the bed;
+  - "holi":    soft colour on the ground, and a puff of colour where she taps.
+  Each is still art under reduced motion or Data Saver. When the first row
+  goes in, delete the test "ships empty until the owner approves a row" in
+  seasons.test.ts: it guards the release that went out with none.
+*/
+
+export type Dressing = "diwali" | "monsoon" | "holi";
+export const DRESSINGS: readonly Dressing[] = ["diwali", "monsoon", "holi"];
+
+export type SeasonRow = {
+  id: string;
+  /** First day, "YYYY-MM-DD", in IST (included). */
+  start: string;
+  /** Last day, "YYYY-MM-DD", in IST (included). */
+  end: string;
+  dressing: Dressing;
+};
+
+export const SEASONS: readonly SeasonRow[] = [];
+
+const DAY = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+
+/** A row the garden can wear: an id, two IST days in order, a known dressing. Any other row is never worn (seasons.test says what is wrong with it). */
+export const readableSeason = (r: SeasonRow): boolean =>
+  /^[a-z0-9-]+$/.test(r.id) && DAY.test(r.start) && DAY.test(r.end) && r.start <= r.end && DRESSINGS.includes(r.dressing);
+
+/** The row the garden wears at `at` (IST days, both ends included), or null: the first readable match in the table's order. */
+export const seasonOn = (rows: readonly SeasonRow[], at: Date | number = Date.now()): SeasonRow | null => {
+  const today = istDayKey(at instanceof Date ? at : new Date(at));
+  return rows.find((r) => readableSeason(r) && r.start <= today && today <= r.end) ?? null;
+};
diff --git a/src/lib/portal/shareCard.test.ts b/src/lib/portal/shareCard.test.ts
