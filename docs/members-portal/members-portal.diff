+  const total = (opts.delay ?? 0) + (opts.iterations === Infinity ? 1e9 : Number(opts.duration ?? 0));
+  const a: Fake = {
+    onfinish: null,
+    oncancel: null,
+    playState: "running",
+    currentTime: 0,
+    finished: Promise.resolve(),
+    cancel: () => {
+      window.clearTimeout(timer);
+      a.playState = "idle";
+      a.oncancel?.();
+    },
+    play: () => {},
+    pause: () => {},
+  };
+  const timer = window.setTimeout(() => {
+    a.playState = "finished";
+    a.onfinish?.();
+  }, total);
+  return a as unknown as Animation;
+};
