@@ -0,0 +1,58 @@
+import { Link } from "react-router-dom";
+import JoinInnerCircleForm from "@/components/members/JoinInnerCircleForm";
+import { WHATSAPP_NUMBER } from "@/data/jewellery";
+import { primaryButton, quietButton } from "@/components/portal/styles";
+import { DROPS } from "@/lib/portal/drops";
+import { byOpening, timeOf } from "@/lib/portal/dropPhase";
+import { formatIstOpening } from "@/lib/portal/ist";
+import { PROMISES } from "./Gate";
+
+/*
+  The gate's welcome, for anyone not signed in: the way in, the promises,
+  the Inner Circle list and WhatsApp. A chunk of its own, with the list's
+  form (and the parser it checks an email with), so a member, whose gate
+  only ever says "Opening the gate…" before her garden, never downloads it.
+  Until it is in, the gate keeps saying that.
+*/
+
+const WHATSAPP = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
+  "Hello Naira Flore, I'd like to know about the Inner Garden, the members' side of the Inner Circle.",
+)}`;
+
+/* The next drop's name and date show here only when the owner has said they may (teaser.public). */
+const publicTeaser = (now: number) => byOpening(DROPS).find((d) => d.teaser?.public && now < timeOf(d.membersFrom));
+
+const GateWelcome = ({ pathname }: { pathname: string }) => {
+  const teaser = publicTeaser(Date.now());
+  const next = encodeURIComponent(pathname.startsWith("/members") ? pathname : "/members");
+  return (
+    <>
+      <p className="ig-lede">The members' side of the Inner Circle: a garden of your own, grown from the day you join.</p>
+      <Link to={`/auth?next=${next}`} className={`${primaryButton} ig-gate-cta`}>
+        Enter the garden
+      </Link>
+      <p className="ig-fineprint">Sign in, or create your account.</p>
+      <ul className="ig-promises">
+        {PROMISES.filter((p) => p.live).map((p) => (
+          <li key={p.text}>{p.text}</li>
+        ))}
+      </ul>
+      {teaser && (
+        <p className="ig-fineprint">
+          The next drop, {teaser.title}, opens {formatIstOpening(teaser.membersFrom)}.
+        </p>
+      )}
+      <p className="ig-or">
+        <span>or keep in touch</span>
+      </p>
+      <div className="ig-join">
+        <JoinInnerCircleForm source="members-gate" withName={false} cta="Join the Inner Circle list" />
+      </div>
+      <a href={WHATSAPP} target="_blank" rel="noopener noreferrer" className={quietButton}>
+        Ask us on WhatsApp
+      </a>
+    </>
+  );
+};
+
+export default GateWelcome;
