+import { describe, expect, it } from "vitest";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+
+/*
+  The portal's honesty rules, enforced on its sources. No invented social
+  proof or scarcity (the product page's "N pieces sold" is exactly what this
+  keeps out), no members' prices, codes or gifts the shop has not created,
+  exclusivity worded as a first look, and stones described as the listing
+  does: cubic zirconia in the month's colour, never real gemstones or solid
+  gold.
+*/
+const src = resolve(__dirname, "../..");
+const dirs = ["pages/members", "components/portal", "lib/portal", "lib/auth"];
+const files = (dir: string): string[] =>
+  readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
+    e.isDirectory() ? files(join(dir, e.name)) : /\.(tsx?|css)$/.test(e.name) && !/\.test\./.test(e.name) ? [join(dir, e.name)] : [],
+  );
+const sources = dirs.flatMap((d) => files(join(src, d)));
+
+/* Phase 6, builder b: Stone Light says its heart is a drawing in the month's
+   colour, in the listing's own words for the stone, and never praises it
+   past them; the Vanity draws by each listing's own length, says the bag's
+   ladder only as promo.ts has it, and never sells a look; neither writes to
+   her account, and the tilt's readings stay on the screen. */
+describe("Phase 6: Stone Light and the Vanity", () => {
+  const read = (f: string) => readFileSync(join(src, f), "utf8");
+  const light = ["components/portal/StoneLight.tsx", "lib/portal/stoneLight.ts", "lib/portal/motionSensor.ts", "lib/portal/gem/scene.ts"];
+  const vanity = ["pages/members/Vanity.tsx", "components/portal/LookGlass.tsx", "lib/portal/vanity.ts", "pages/members/vanity.css"];
+
+  it("never praises the stone past the listing's words", () => {
+    for (const f of light) expect(read(f), f).not.toMatch(/\b(fire|brilliance|brilliant|real|genuine|natural|precious|diamonds?|gemstones?|flawless)\b|\bsparkles? like\b/i);
+  });
+
+  it("calls the heart a drawing in the month's colour, in the listing's own words for the stone", () => {
+    const panel = read("components/portal/StoneLight.tsx");
+    expect(panel).toMatch(/A drawing of the heart in \{stone\.monthName\}'s colour, not a photo\. \{STONE_WORDS\}\./);
+    expect(read("lib/portal/stonePiece.ts")).toMatch(/export const STONE_WORDS = "Heart-cut cubic zirconia";/);
+    expect(panel).toMatch(/Hold it to the light|See it on the necklace ↑/);
+    expect(read("pages/members/Stone.tsx")).toMatch(/Hold it to the light/);
+  });
+
+  it("names the stone's controls as they work, and its light's tip in plain words", () => {
+    const panel = read("components/portal/StoneLight.tsx");
+    expect(panel).toContain('"Use the arrow keys or the Turn buttons."');
+    expect(panel).toContain('"Drag across it or use the arrow keys."');
+    expect(panel).toContain('", tipped up"');
+    expect(panel).toContain('", tipped down"');
+  });
+
+  it("keeps the tilt's readings on the screen: nothing stored, nothing sent", () => {
+    for (const f of ["lib/portal/motionSensor.ts", "lib/portal/stoneLight.ts", "components/portal/StoneLight.tsx"]) {
+      expect(read(f), f).not.toMatch(/safeSet|writePortal|localStorage|sessionStorage|fetch\(|sendBeacon|changeMeta|fbq|clarity/);
+    }
+  });
+
+  it("draws by each listing's own length, and says so", () => {
+    const room = read("pages/members/Vanity.tsx");
+    expect(room).toMatch(/Drawn to each listing's own length, one against another\. Where a chain sits on you depends on you\./);
+    expect(room).toMatch(/Necklaces whose listing gives no length yet are not drawn here\./);
+    expect(read("lib/portal/vanity.ts")).toMatch(/to confirm/);
+  });
+
+  it("never sells a look or promises a fit", () => {
+    for (const f of vanity) expect(read(f), f).not.toMatch(/fits you|perfect length|complete the look|\bdeals?\b|\bbundles?\b|members'? price|\bunlock|\bone more\b/i);
+  });
+
+  it("writes no rate and no price of its own: the ladder is promo.ts's", () => {
+    for (const f of vanity) expect(read(f), f).not.toMatch(/\b0\.[12]\b|\b(10|20)\s*%|₹\s?\d/);
+    expect(read("lib/portal/vanity.ts")).toMatch(/import \{ QUANTITY_OFFERS \} from "@\/lib\/promo";/);
+    expect(read("pages/members/Vanity.tsx")).toMatch(/const offer = offerWords\(\);/);
+  });
+
+  it("says a piece is sold out only as the live catalogue does: never when, never 'just'", () => {
+    for (const f of vanity) expect(read(f), f).not.toMatch(/sold out,?\s+(just|now|a moment|recently|today|earlier|\d+\s*(min|minute|hour|day)s?)|just sold( out)?|has just sold/i);
+    const room = read("pages/members/Vanity.tsx");
