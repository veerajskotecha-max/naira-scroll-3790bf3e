+    expect(handle.pause).toHaveBeenCalled();
+    act(() => void vi.advanceTimersByTime(10_100));
+    expect(handle.dispose).toHaveBeenCalledTimes(1);
+    delete (document as unknown as Record<string, unknown>).visibilityState;
+  });
+});
