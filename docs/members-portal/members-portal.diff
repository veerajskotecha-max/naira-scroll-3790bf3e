+import { cleanup, fireEvent, render } from "@testing-library/react";
+import { useRef } from "react";
+import { afterEach, describe, expect, it } from "vitest";
+import { loadGardenTouch, useTapBloom } from "./useTapBloom";
+
+/* The flowers a tap opens are a chunk of their own (gardenTouch), fetched as
+   the bed mounts. A tap that comes before they have arrived is not lost: it
+   blooms as soon as they do, on a bed that is still there. (A test file of
+   its own, so the chunk is not in yet when the taps land.) */
+const Bed = ({ id }: { id: string }) => {
+  const ref = useRef<HTMLDivElement>(null);
+  useTapBloom(ref);
+  return <div ref={ref} data-testid={id} />;
+};
+
+afterEach(cleanup);
+
+describe("a tap on the garden before its flowers have arrived", () => {
+  it("blooms as soon as they do, and never on a bed that has gone", async () => {
+    const stays = render(<Bed id="stays" />);
+    const goes = render(<Bed id="goes" />);
+    const bed = stays.getByTestId("stays");
+    const gone = goes.getByTestId("goes");
+    fireEvent.pointerDown(bed, { clientX: 20, clientY: 20, button: 0 });
+    fireEvent.pointerDown(gone, { clientX: 20, clientY: 20, button: 0 });
+    expect(bed.querySelectorAll(".ig-bloom")).toHaveLength(0);
+    goes.unmount();
+    await loadGardenTouch();
+    await Promise.resolve();
+    expect(bed.querySelectorAll(".ig-bloom")).toHaveLength(1);
+    expect(gone.querySelectorAll(".ig-bloom")).toHaveLength(0);
+  });
+});
