index 0000000..91d35c4
--- /dev/null
+++ b/src/components/portal/SkyLayer.tsx
@@ -0,0 +1,248 @@
+import { useLayoutEffect, useMemo, useRef, type CSSProperties, type ReactNode } from "react";
+import { ARCH, BED, hashString, mulberry32 } from "@/lib/portal/gardenLayout";
+import { EASE_REVEAL, play, stillMotion, useAmbientLoop } from "@/lib/portal/motion";
+import { FIREFLIES, NIGHT_GROUND, type SkyHour } from "@/lib/portal/sky";
+import { lazyRoom, useDecoration } from "@/lib/portal/lazyRoom";
+
+/*
+  The sky over her garden (garden hours, sky.ts): a chunk of its own,
+  fetched after the garden's first paint and never by day. Drawn inside the
+  bed in two parts, behind the plants ("back") and over them ("front"):
+
+  - dawn:   a blush glow low in the sky and a pale sun; behind the beds,
+            three bands of mist that drift a little between the stems (never
+            over a flower: the sky never dims a plant);
+  - golden: a warm wash high in the sky and a low sun behind the arbour;
+  - night:  (the bed has already laid the ink in the arbour's doorway) a
+            crescent moon inside the arbour and a scatter of still stars;
+            among the flowers, twelve slow gold fireflies.
+
+  Every wash and star is cut to the arbour's arch (ARCH), so the sky lives
+  inside the garden's doorway, never as a hard-edged box on the ivory page;
+  the fireflies fly inside it too.
+
+  The mist and the fireflies join the bed's one ambient loop (motion.ts):
+  they rest with the sway after 20 s untouched, off screen and on a hidden
+  tab, and this file starts no loop, observer or timer of its own. Outside
+  a bed, or under reduced motion and Data Saver, every part is still art:
+  the fireflies glow where they are, the mist lies where it is. Only
+  transform and opacity move. Every wash ends high above the bed's labels,
+  so its words keep their contrast. Seeded from her id: the same sky, the
+  same fireflies, on every visit.
+
+  At night, with her month known, her month's flower (Phase 6, StarSheet)
+  is in this night sky: its stars, faint, before she traces it, and once
+  written its single gold line with its stars, still, inside the arch left
+  of the moon and above the next drop's bud. It is a decoration in a chunk
+  of its own (SkyWritten), fetched only then, so dawn and the golden hour
+  never carry the star tables or the twelve drawings. It adds no animation
+  of any kind.
+*/
+
+const SkyWritten = lazyRoom(() => import("./SkyWritten"));
+
+type Props = {
+  hour: SkyHour;
+  seed: string;
+  part: "back" | "front";
+  /** It arrived after the garden's first paint: it fades in, once. */
+  arriving?: boolean;
+  /** Her month (1 to 12), at night: its flower's stars are in her sky, faint, until she traces it. */
+  month?: number;
+  /** Her month's flower is written in her garden's stars: its line rests in her night sky, still. */
+  written?: boolean;
+};
+
+const LAYER: CSSProperties = { position: "absolute", inset: 0, pointerEvents: "none" };
+const ART: CSSProperties = { position: "absolute", inset: 0, width: "100%", height: "100%", overflow: "visible" };
+const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
+const seeded = (seed: string, salt: string) => mulberry32(hashString(`${seed || "naira"}:${salt}`));
+
+/* Art colours, inside the drawing only. */
+const GOLD = "#C99A4C";
+const GOLD_DEEP = "#B0843A";
+const MOON = "#F4EBE2";
+/* The moon hangs under the arbour's crown, clear of a garland on it and of the next drop's bud. */
+const MOON_AT = [195, 158] as const;
+
+/** Where the washes end, in the bed's 560-high view: well above the soil and the labels under it. */
+const WASH_END = 392;
+
+type Star = { x: number; y: number; r: number; o: number; gold: boolean };
+const starsFor = (seed: string): Star[] => {
+  const rand = seeded(seed, "stars");
+  const out: Star[] = [];
+  for (let i = 0; out.length < 22 && i < 80; i++) {
+    const x = 44 + rand() * 302;
+    const y = 98 + rand() * 150;
+    const r = 0.6 + rand() * 0.8;
+    const o = 0.35 + rand() * 0.55;
+    const gold = rand() < 0.4;
+    // Clear of the moon.
+    if (Math.hypot(x - MOON_AT[0], y - MOON_AT[1]) < 28) continue;
+    out.push({ x, y, r, o, gold });
+  }
+  return out;
+};
+
+type Firefly = { x: number; y: number; size: number; dur: number; phase: number; path: [number, number][]; glow: number };
+/** Where a firefly may rest, in the bed's view (it flies 24 either way of it). */
+export const FLY_X = [60, 330] as const;
+export const FLY_Y = [210, 490] as const;
+const firefliesFor = (seed: string): Firefly[] => {
+  const rand = seeded(seed, "fireflies");
+  const step = () => (rand() - 0.5) * 48;
+  return Array.from({ length: FIREFLIES }, (_, i) => ({
+    // Spread across the bed in twelve columns, at any height among the plants: with their 24 px of
+    // flight either way, always inside the arbour's arch (clear of its posts and its shoulders).
+    x: FLY_X[0] + ((i + 0.2 + rand() * 0.6) * (FLY_X[1] - FLY_X[0])) / FIREFLIES,
+    y: FLY_Y[0] + rand() * (FLY_Y[1] - FLY_Y[0]),
+    size: Math.round(14 + rand() * 8),
+    dur: Math.round(7000 + rand() * 6000),
+    phase: rand(),
+    path: [
+      [step(), step()],
+      [step(), step()],
+      [step(), step()],
+    ],
+    glow: 0.55 + rand() * 0.4,
+  }));
+};
+
+const FIREFLY = (f: Firefly, calm: boolean): CSSProperties => ({
+  position: "absolute",
+  left: pct(f.x, BED.w),
+  top: pct(f.y, BED.h),
+  width: f.size,
+  height: f.size,
+  marginLeft: -f.size / 2,
+  marginTop: -f.size / 2,
+  background: "radial-gradient(closest-side, #FFF6D8 0 18%, #F3D07E 28%, rgb(236 200 112 / 0.5) 46%, rgb(201 154 76 / 0) 100%)",
+  // Its still glow; while it flies, the flight's own opacity holds instead.
+  opacity: f.glow,
+  willChange: calm ? undefined : "transform, opacity",
+});
+
+const flight = (f: Firefly): Keyframe[] => [
+  { transform: "translate(0px, 0px)", opacity: 0.12 },
+  { transform: `translate(${f.path[0][0].toFixed(1)}px, ${f.path[0][1].toFixed(1)}px)`, opacity: 1, offset: 0.3 },
+  { transform: `translate(${f.path[1][0].toFixed(1)}px, ${f.path[1][1].toFixed(1)}px)`, opacity: 0.35, offset: 0.62 },
+  { transform: `translate(${f.path[2][0].toFixed(1)}px, ${f.path[2][1].toFixed(1)}px)`, opacity: 0.95 },
+];
+
+/* Dawn's mist: three long soft bands, low behind the beds. */
+const MIST = [
+  { y: 318, h: 44, drift: 16, dur: 19000, o: 0.7 },
+  { y: 396, h: 52, drift: -20, dur: 23000, o: 0.55 },
+  { y: 470, h: 40, drift: 14, dur: 17000, o: 0.5 },
+];
+const MIST_BAND = (m: (typeof MIST)[number]): CSSProperties => ({
+  position: "absolute",
+  left: "-8%",
+  right: "-8%",
+  top: pct(m.y - m.h / 2, BED.h),
+  height: pct(m.h, BED.h),
+  background: "radial-gradient(closest-side, rgb(240 243 240 / 0.95), rgb(240 243 240 / 0))",
+  opacity: m.o,
+  willChange: "transform",
+});
+
+const Back = ({ hour, stars, flower }: { hour: SkyHour; stars: Star[]; flower: ReactNode }) => (
+  <svg viewBox={`0 0 ${BED.w} ${BED.h}`} style={ART} aria-hidden>
+    <defs>
+      <clipPath id="ig-sky-arch">
+        <path d={ARCH} />
+      </clipPath>
+    </defs>
+    {hour === "dawn" && (
+      <>
+        <defs>
+          <linearGradient id="ig-sky-dawn" x1="0" y1="0" x2="0" y2="1">
+            <stop offset="0" stopColor="#FFD9C8" stopOpacity=".55" />
+            <stop offset="1" stopColor="#FFD9C8" stopOpacity="0" />
+          </linearGradient>
+        </defs>
+        <rect x="0" y="0" width={BED.w} height={WASH_END - 92} fill="url(#ig-sky-dawn)" clipPath="url(#ig-sky-arch)" />
+        <circle cx="96" cy="232" r="20" fill="#FFE7DB" stroke={GOLD} strokeWidth=".6" opacity=".9" />
+      </>
+    )}
+    {hour === "golden" && (
+      <>
+        <defs>
+          <linearGradient id="ig-sky-golden" x1="0" y1="0" x2="0" y2="1">
+            <stop offset="0" stopColor="#F2CE97" stopOpacity=".5" />
+            <stop offset="1" stopColor="#F2CE97" stopOpacity="0" />
+          </linearGradient>
+        </defs>
+        <rect x="0" y="0" width={BED.w} height={WASH_END} fill="url(#ig-sky-golden)" clipPath="url(#ig-sky-arch)" />
+        <circle cx="300" cy="212" r="24" fill="#F7D49B" stroke={GOLD_DEEP} strokeWidth=".7" opacity=".7" />
+      </>
+    )}
+    {hour === "night" && (
+      <>
+        <g clipPath="url(#ig-sky-arch)">
+          {stars.map((s, i) => (
+            <circle key={i} cx={s.x.toFixed(1)} cy={s.y.toFixed(1)} r={s.r.toFixed(2)} fill={s.gold ? GOLD : MOON} opacity={s.o.toFixed(2)} />
+          ))}
+        </g>
+        <g>
+          <circle cx={MOON_AT[0]} cy={MOON_AT[1]} r="15" fill={MOON} stroke={GOLD} strokeWidth=".6" />
+          <circle cx={MOON_AT[0] + 6} cy={MOON_AT[1] - 4.5} r="12.6" fill={NIGHT_GROUND} />
+        </g>
+        {flower}
+      </>
+    )}
+  </svg>
+);
+
+const SkyLayer = ({ hour, seed, part, arriving = false, month, written = false }: Props) => {
+  const rootRef = useRef<HTMLDivElement>(null);
+  const hers = useDecoration(SkyWritten, hour === "night" && part === "back" && Boolean(month));
+  const loop = useAmbientLoop();
+  const calm = stillMotion();
+  const stars = useMemo(() => (hour === "night" && part === "back" ? starsFor(seed) : []), [hour, part, seed]);
+  const flies = useMemo(() => (hour === "night" && part === "front" ? firefliesFor(seed) : []), [hour, part, seed]);
+  // Behind the plants: the mist lies between the stems, never across a flower.
+  const mist = hour === "dawn" && part === "back";
+
+  // Before the layer's first paint, so it never shows a frame before its fade or its fireflies' flight.
+  useLayoutEffect(() => {
+    const root = rootRef.current;
+    if (!root || calm) return;
+    const fade = arriving ? play(root, [{ opacity: 0 }, { opacity: 1 }], { duration: 900, easing: EASE_REVEAL, fill: "backwards" }) : null;
+    // Ambient motion only inside a bed, on its loop: anywhere else the art stays still.
+    if (!loop) return () => fade?.cancel();
+    const list: Animation[] = [];
+    root.querySelectorAll<HTMLElement>("[data-firefly]").forEach((node, i) => {
+      const f = flies[i];
+      if (!f) return;
+      const a = play(node, flight(f), { duration: f.dur, iterations: Infinity, direction: "alternate", easing: "ease-in-out" });
+      if (!a) return;
+      a.currentTime = f.phase * f.dur;
+      list.push(a);
+    });
+    root.querySelectorAll<HTMLElement>("[data-mist]").forEach((node, i) => {
+      const m = MIST[i];
+      const a = play(node, [{ transform: "translateX(0px)" }, { transform: `translateX(${m.drift}px)` }], { duration: m.dur, iterations: Infinity, direction: "alternate", easing: "ease-in-out" });
+      if (a) list.push(a);
+    });
+    const leave = loop.join(list);
+    return () => {
+      leave();
+      list.forEach((a) => a.cancel());
+      fade?.cancel();
+    };
+  }, [calm, loop, flies, arriving]);
+
+  return (
+    <div ref={rootRef} className="ig-sky" data-hour={hour} data-part={part} style={LAYER} aria-hidden>
+      {mist && MIST.map((m, i) => <div key={i} data-mist="" style={MIST_BAND(m)} />)}
+      {part === "back" && <Back hour={hour} stars={stars} flower={hers.shown && month ? <SkyWritten month={month} written={written} /> : null} />}
+      {flies.map((f, i) => (
+        <span key={i} data-firefly="" style={FIREFLY(f, calm)} />
+      ))}
+    </div>
+  );
+};
+
+export default SkyLayer;
