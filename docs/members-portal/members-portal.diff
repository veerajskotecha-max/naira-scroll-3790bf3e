+    expect(fitted.naira.ring && fitted.naira.metal && fitted.naira.month && fitted.naira.seen).toBeTruthy();
+    expect(bytesOf(fitted.naira)).toBeLessThanOrEqual(META_CAP_BYTES);
+    expect(new TextEncoder().encode(JSON.stringify(compactNaira(fitted.naira))).length).toBeLessThanOrEqual(META_CAP_BYTES);
+    // What was let go is saved pieces only, the oldest first.
+    expect(fitted.trimmed).toEqual(n.saved.slice(0, fitted.trimmed.length));
+  });
+
+  it("fits them with no saved piece at all to let go", () => {
+    const fitted = fitToCap({ ...fullest(), saved: [] });
+    expect(fitted.ok).toBe(true);
+    if (fitted.ok) expect(fitted.trimmed).toEqual([]);
