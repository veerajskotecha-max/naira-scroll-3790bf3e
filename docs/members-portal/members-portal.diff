+/* /members/herbarium: pressed flowers and keepsakes. Imported only by Herbarium.tsx (the frames bring herbarium.css). */
+
+.ig-herbarium {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-herbarium .ig-lede { text-wrap: balance; }
+.ig-hwall { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem 1rem; width: 100%; margin: 0; padding: 0; list-style: none; }
+.ig-hwall > li::before { content: ""; display: block; width: 1px; height: 14px; margin: 0 auto; background: var(--ig-gold-line); }
+.ig-hwall .ig-herb-sheet { transform: rotate(-0.8deg); transform-origin: 50% 0; }
+.ig-hwall > li:nth-child(even) .ig-herb-sheet { transform: rotate(0.8deg); }
+.ig-hwall-link, .ig-keepsake-link { display: block; color: inherit; text-decoration: none; }
+.ig-hwall-link:focus-visible, .ig-keepsake-link:focus-visible { outline: 1px solid var(--nf-accent-strong); outline-offset: 4px; }
+.ig-keepsake .ig-herb-flower { height: 70%; align-items: center; }
+.ig-keepsake.is-empty .ig-herb-note { color: rgb(var(--nf-ink-rgb) / 0.6); }
+.ig-herbarium-joy { margin-top: 2rem; text-align: center; }
+
+@media (min-width: 768px) {
