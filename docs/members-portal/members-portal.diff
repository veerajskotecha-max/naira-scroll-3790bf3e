+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  META_CAP_BYTES,
+  PLAY_MAX,
+  MAX_GIFTS,
+  WRITE_DELAY_MS,
+  bytesOf,
+  compactNaira,
+  createMetaWriter,
+  fitToCap,
+  MAX_FRONT,
