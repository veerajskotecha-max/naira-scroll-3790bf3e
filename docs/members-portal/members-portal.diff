@@ -0,0 +1,72 @@
+import { useId, useRef, useState, type CSSProperties } from "react";
+import { FlowerGlyph } from "./FlowerGlyph";
+import { eyebrow } from "./styles";
+import { speciesIndex } from "@/lib/portal/dropPhase";
+import { formatIstDay } from "@/lib/portal/ist";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import type { AtelierNote as Note } from "@/lib/portal/notes";
+
+/*
+  A note from the atelier (notes.ts, the owner's words): a pressed flower on
+  a slip of vellum. A tap unfolds it: the flower opens from pressed to bloom
+  and the note itself unfolds beneath, like a folded sheet opening toward
+  her (transform and opacity only). Another tap folds it away. Under reduced
+  motion it simply opens. A chunk of its own, fetched only when there is a
+  note to show.
+*/
+
+const BUTTON: CSSProperties = { width: "100%", font: "inherit", textAlign: "left", cursor: "pointer" };
+const SLIP: CSSProperties = {
+  margin: "-1px 0 0",
+  padding: "1rem 1.1rem 1.1rem",
+  borderLeft: "1px solid var(--ig-gold-line)",
+  borderRight: "1px solid var(--ig-gold-line)",
+  borderBottom: "1px solid var(--ig-gold-line)",
+  background: "var(--ig-vellum)",
+  transformOrigin: "50% 0",
+};
+const PARA: CSSProperties = { margin: "0 0 0.6rem", fontFamily: "var(--nf-font-editorial)", fontSize: "1.1rem", lineHeight: 1.55 };
+
+const AtelierNote = ({ note }: { note: Note }) => {
+  const [open, setOpen] = useState(false);
+  const slipRef = useRef<HTMLDivElement>(null);
+  const flowerRef = useRef<HTMLSpanElement>(null);
+  const id = useId();
+
+  const toggle = () => {
+    const next = !open;
+    setOpen(next);
+    if (!next || stillMotion()) return;
+    // After the slip has rendered: it unfolds from its top edge, and the flower opens.
+    requestAnimationFrame(() => {
+      play(slipRef.current, [{ opacity: 0, transform: "perspective(700px) rotateX(-78deg)" }, { opacity: 1, transform: "none" }], { duration: 560, easing: EASE_REVEAL, fill: "backwards" });
+      play(flowerRef.current, [{ transform: "scale(.82) rotate(-8deg)" }, { transform: "none" }], { duration: 520, easing: EASE_BLOOM });
+    });
+  };
+
+  return (
+    <li style={{ listStyle: "none" }}>
+      <button type="button" className="ig-card-link" style={BUTTON} aria-expanded={open} aria-controls={id} onClick={toggle}>
+        <span ref={flowerRef} style={{ flex: "none", display: "inline-flex" }}>
+          <FlowerGlyph species={speciesIndex(note.flower)} accent={note.accent} state={open ? "bloom" : "pressed"} size={56} />
+        </span>
+        <span className="ig-card-text">
+          <span className={eyebrow}>From the atelier · {formatIstDay(`${note.from}T12:00:00+05:30`)}</span>
+          <span className="ig-card-title">{note.title}</span>
+          <span className="ig-card-more">{open ? "Fold it away" : "Tap to unfold"}</span>
+        </span>
+      </button>
+      {open && (
+        <div ref={slipRef} id={id} style={SLIP}>
+          {note.body.map((p, i) => (
+            <p key={i} style={PARA}>
+              {p}
+            </p>
+          ))}
+        </div>
+      )}
+    </li>
+  );
+};
+
+export default AtelierNote;
