+    watch();
+    return () => {
+      cancelled = true;
+      document.removeEventListener("visibilitychange", onVisibility);
+      putAway();
+    };
+    // Once, as the panel shows.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+  // It draws only while it is on screen, the tab is visible, she has touched in the last 20 s, and the bag is shut.
+  const showing = useAmbient(panelRef, gemOn);
+  useEffect(() => {
+    if (!gem.current) return;
+    if (showing && !bagOpen) gem.current.resume();
+    else gem.current.pause();
+  }, [gemOn, showing, bagOpen]);
+  useEffect(() => gem.current?.setColour(stone.hue, stone.tint), [stone.hue, stone.tint]);
+
+  const onPointerDown = (e: ReactPointerEvent<HTMLDivElement>) => {
+    if (still || (e.pointerType === "mouse" && e.button !== 0)) return;
+    drag.current = { x0: e.clientX, y0: e.clientY, id: e.pointerId, from: shown.current, moved: false, lastX: e.clientX, lastT: e.timeStamp, v: 0 };
+  };
+  const onPointerMove = (e: ReactPointerEvent<HTMLDivElement>) => {
+    const d = drag.current;
+    if (!d) return;
+    const dx = e.clientX - d.x0;
+    if (!d.moved) {
+      if (Math.abs(dx) < 6) return;
+      // A swipe up or down is the page's: it scrolls.
+      if (Math.abs(e.clientY - d.y0) > Math.abs(dx)) {
+        drag.current = null;
+        return;
+      }
+      d.moved = true;
+      stopFrames();
+      try {
+        e.currentTarget.setPointerCapture(d.id);
+      } catch {
+        /* capture is a nicety */
+      }
+    }
