+import { Suspense, useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import GardenBed, { GoldRose, PetalCrown, type GardenBedHandle } from "@/components/portal/GardenBed";
+import DoorsOpen, { type DoorsMode } from "@/components/portal/DoorsOpen";
+import { StoneHead } from "@/components/portal/StoneArt";
+import { CardGlyph } from "@/components/portal/CardGlyph";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, textLink } from "@/components/portal/styles";
+import { formatIstDate, greetingFor } from "@/lib/portal/ist";
+import { shownName, stoneForMonth } from "@/lib/portal/stones";
+import { pickDoors, recordFullDoors } from "@/lib/portal/doors";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { byOpening, dropPhase, msUntil, petalsOpen, phaseBoundaries, speciesIndex, timeOf, VAULT_AFTER_MS } from "@/lib/portal/dropPhase";
+import { formatIstDay, formatIstOpening, istOpensWhen } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { hashString } from "@/lib/portal/gardenLayout";
+import DropBud from "@/components/portal/DropBud";
+import { BudGlyph } from "@/components/portal/BudGlyph";
+import { useDropShop } from "@/components/portal/useDropShop";
+import ShopWatch from "@/components/portal/ShopWatch";
+import type { Drop } from "@/lib/portal/drops";
+import { lazyRoom, useDecoration, whenIdle } from "@/lib/portal/lazyRoom";
+import { nextSkyChange, skyDraws, skyHour, type SkyHour } from "@/lib/portal/sky";
+import { SEASONS, seasonOn, type Dressing } from "@/lib/portal/seasons";
