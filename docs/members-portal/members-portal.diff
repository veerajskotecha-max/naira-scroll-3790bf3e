+    <symbol id="ig-bud" viewBox="-30 -112 60 112">
+      <use href="#ig-stem-0" x="-30" y="-112" width="60" height="112" />
+      <path d="M0-104C7-95 8-88 0-81C-8-88-7-95 0-104Z" fill="currentColor" />
+      <path d="M0-81C-5-84-8-90-7-95M0-81C5-84 8-90 7-95" fill="none" stroke={LEAF_SAGE} strokeWidth="1.4" />
+    </symbol>
+    <symbol id="ig-sprig" viewBox="-30 -112 60 112">
+      <path d="M0 0C-4-30 6-60 2-96" fill="none" stroke={LEAF_SAGE} strokeWidth="1.4" />
+      {[0, 1, 2, 3, 4, 5].map((i) => {
+        const y = -16 - i * 14;
+        const x = (i % 2 ? 7 : -7) + (i > 2 ? 2 : 0);
+        return <ellipse key={i} cx={x} cy={y} rx="7.5" ry="3" transform={`rotate(${i % 2 ? 34 : -34} ${x} ${y})`} fill={LEAF_SAGE} opacity=".8" />;
+      })}
+      <circle cx="2" cy="-98" r="2.4" fill="var(--nf-accent)" />
+    </symbol>
+    <symbol id="ig-grass" viewBox="-30 -112 60 112">
+      <path d="M0 0C-1-20-6-34-12-46M0 0C1-24 2-40 1-58M0 0C2-18 7-30 13-40" fill="none" stroke="var(--nf-accent)" strokeWidth="1" opacity=".85" />
+    </symbol>
+    <symbol id="ig-breath" viewBox="-30 -112 60 112">
+      <path d="M0 0C0-30-2-50-10-70M0-30C4-46 10-58 14-66M-2-48C-6-58-2-66 2-80" fill="none" stroke="var(--nf-accent)" strokeWidth=".9" />
+      {[[-10, -71], [14, -67], [2, -81], [-6, -58], [8, -54], [-3, -40], [11, -74]].map(([x, y], i) => (
+        <circle key={i} cx={x} cy={y} r={i % 3 ? 2.1 : 2.6} fill={i % 2 ? "#FFF6EA" : "#FFD6C6"} />
+      ))}
+    </symbol>
+    <symbol id="ig-leaves" viewBox="-30 -112 60 112">
+      <path d="M0 0C-14-10-22-30-18-52C-6-40-2-20 0 0Z" fill={LEAF_SAGE} />
+      <path d="M0 0C10-8 18-24 16-42C6-32 2-16 0 0Z" fill={LEAF_SAGE} opacity=".85" />
+      <path d="M0 0C-8-16-12-30-17-48M0 0C6-14 10-26 15-39" fill="none" stroke="#7E9893" strokeWidth=".6" />
+    </symbol>
+  </>
+);
+
+/* The arbour over her bed: the gate's arch, opened out, with a vine climbing
+   each post and wisteria-like drops hanging from the top. Drawn once. */
+const ARBOUR_OUTER = `M22 ${BED.soil}V214C22 132 104 78 195 78C286 78 368 132 368 214V${BED.soil}`;
+const ARBOUR_INNER = `M30 ${BED.soil}V216C30 140 108 88 195 88C282 88 360 140 360 216V${BED.soil}`;
+const VINE_L: Seg[] = [
+  [26, 520, 42, 470, 12, 430, 28, 388],
+  [28, 388, 44, 346, 14, 306, 30, 266],
+  [30, 266, 44, 228, 24, 194, 46, 160],
+  [46, 160, 66, 128, 92, 106, 124, 94],
+];
+const VINE_R = mirrorSegs(VINE_L, BED.w);
+const LEAF_TS = [0.05, 0.12, 0.19, 0.26, 0.33, 0.4, 0.47, 0.54, 0.61, 0.68, 0.76, 0.84, 0.92];
+const VINES = [VINE_L, VINE_R].map((segs) => ({
+  d: chainPath(segs),
+  leaves: leavesAlong(segs, LEAF_TS, 6, 50),
+  buds: [0.3, 0.58, 0.88, 0.99].map((t) => pointOn(segs, t)),
+}));
+const DROPS = [
+  { x: 112, y: 104, n: 4 },
+  { x: 150, y: 92, n: 3 },
+  { x: 240, y: 92, n: 3 },
+  { x: 278, y: 104, n: 4 },
+];
+
+export const Arbour = () => (
+  <g className="ig-arbour">
+    <path className="ig-arbour-line" d={ARBOUR_OUTER} pathLength={1} strokeDasharray="1 1" />
+    <path className="ig-arbour-line ig-arbour-line--fine" d={ARBOUR_INNER} pathLength={1} strokeDasharray="1 1" />
+    {[250, 290, 330, 370, 410, 450, 490].map((y) => (
+      <path key={y} className="ig-arbour-tick" d={`M22 ${y}H30M360 ${y}H368`} />
+    ))}
+    {VINES.map((v, i) => (
+      <g key={i}>
+        <path d={v.d} fill="none" stroke={LEAF_SAGE} strokeWidth="1.1" />
+        {v.leaves.map((l, j) => (
+          <ellipse key={j} cx={l.x.toFixed(1)} cy={l.y.toFixed(1)} rx="6.2" ry="2.6" transform={`rotate(${l.a.toFixed(1)} ${l.x.toFixed(1)} ${l.y.toFixed(1)})`} fill={LEAF_SAGE} opacity=".85" />
+        ))}
+        {v.buds.map(([x, y], j) => (
+          <circle key={j} cx={x.toFixed(1)} cy={y.toFixed(1)} r={j === 3 ? 3.2 : 2.5} fill={j % 2 ? "#FFF6EA" : "var(--nf-blush)"} stroke="var(--nf-accent)" strokeWidth=".6" />
+        ))}
+      </g>
+    ))}
+    {DROPS.map((d) => (
+      <g key={d.x}>
+        <path d={`M${d.x} ${d.y - 6}V${d.y + (d.n - 1) * 9}`} stroke="var(--nf-accent)" strokeWidth=".6" opacity=".7" />
+        {Array.from({ length: d.n }, (_, k) => (
+          <circle key={k} cx={d.x} cy={d.y + k * 9} r={3.4 - k * 0.55} fill={k % 2 ? "#F3D9C6" : "#FFBDA8"} />
+        ))}
+      </g>
+    ))}
+    <g transform="translate(195 78)">
+      {[0, 72, 144, 216, 288].map((a) => (
+        <ellipse key={a} cx="0" cy="-6" rx="3.4" ry="5.6" transform={`rotate(${a})`} fill="var(--nf-blush)" stroke="var(--nf-accent)" strokeWidth=".6" />
+      ))}
+      <circle r="2.6" fill="var(--nf-accent)" />
+    </g>
+  </g>
+);
+
+/** One plant's drawing in its own 60 x 112 view (blooms, buds, sprigs, grasses: every kind but her two). */
+export const PlantArt = ({ p }: { p: Plant }) => art(p);
+
+const art = (p: Plant) => {
+  const flip = p.flip ? "scale(-1 1)" : undefined;
+  if (p.kind === "bloom") {
+    const [hx, hy] = STEM_HEAD[p.stem];
+    const s = SPECIES[p.species];
+    return (
+      <g transform={flip}>
+        <use href={`#ig-stem-${p.stem}`} x="-30" y="-112" width="60" height="112" />
+        <use href={`#ig-head-${p.species}`} x={hx - 17} y={hy - 17} width="34" height="34" style={{ color: s.palette[p.tone % s.palette.length] }} />
+      </g>
+    );
+  }
+  if (p.kind === "drop") {
+    const [hx, hy] = STEM_HEAD[p.stem];
+    return (
+      <g transform={flip}>
+        <use href={`#ig-stem-${p.stem}`} x="-30" y="-112" width="60" height="112" />
+        <use href={`#ig-head-${p.species}`} x={hx - 19} y={hy - 19} width="38" height="38" style={{ color: p.accent }} />
+        <circle cx={hx} cy={hy} r="20" fill="none" stroke="var(--nf-accent)" strokeWidth=".6" strokeDasharray="1.5 2.5" />
+      </g>
+    );
+  }
+  if (p.kind === "ringbud") {
+    return <use href="#ig-bud" x="-30" y="-112" width="60" height="112" transform={flip} style={{ color: p.accent }} />;
+  }
+  if (p.kind === "saved") {
+    // Her saved piece: a sprig whose tip is a small four-point glint, gold or silver as the piece is.
+    return (
+      <g transform={flip}>
+        <use href="#ig-sprig" x="-30" y="-112" width="60" height="112" />
+        <path d="M2-106L3.7-99.7L10-98L3.7-96.3L2-90L.3-96.3L-6-98L.3-99.7Z" fill={p.accent} stroke="var(--nf-accent-strong)" strokeWidth=".6" strokeLinejoin="round" />
+      </g>
+    );
+  }
+  if (p.kind === "bud") {
+    return <use href="#ig-bud" x="-30" y="-112" width="60" height="112" transform={flip} style={{ color: BUD_TONES[p.tone % BUD_TONES.length] }} />;
+  }
+  return <use href={`#ig-${p.kind}`} x="-30" y="-112" width="60" height="112" transform={flip} />;
+};
+
+const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
+
+export type GardenBedHandle = {
+  bloomIn: (short?: boolean) => Animation[];
+  /** One bloom at the Naira flower's head: shows her the garden can be tapped. */
+  hint: () => void;
+};
+
+type Props = {
+  seed: string;
+  stone: Stone | null;
+  plantedOn?: string | null;
+  stoneLabel?: string;
+  /** The small caption over `stoneLabel`. */
+  stoneCaption?: string;
+  /** The gate's backdrop: no sway, no taps, no labels, and none of a member's own plants. */
+  still?: boolean;
+  className?: string;
+  /** The drops she pressed, planted in the middle row. */
+  pressed?: readonly PressedFlower[];
+  /** Her ring size is kept: a ring of buds. */
+  fitted?: boolean;
+  /** The pieces in her drawer: a sprig each, gold or silver. */
+  saved?: readonly SavedSprig[];
+  /** Drawn over the plants, inside the bed (the next drop's sealed bud, the fireflies, a festival's dressing). */
+  children?: ReactNode;
+  /** Drawn behind the plants, inside the bed (the sky: the moon and stars, the low sun, the dawn's glow). */
+  behind?: ReactNode;
+  /** The garden's hour in India: at night the ground is ink from the first paint. */
+  sky?: SkyHour;
+};
+
+/* Where each band's plants stand, as a share of the bed's height: the band grows from there. */
+const bandSoil = (band: number) => pct(260 + ((band + 1) * (BED.soil + 2 - 260)) / BANDS, BED.h);
+
+/* The night garden: ink under the plants, and its labels in ivory and gold (held to 4.5:1 by sky.test). */
+const NIGHT_BED: CSSProperties = { background: NIGHT_GROUND };
+const NIGHT_LABEL: CSSProperties = { color: NIGHT_INK.text };
+const NIGHT_CAPTION: CSSProperties = { color: NIGHT_INK.caption };
+
+const GardenBed = forwardRef<GardenBedHandle, Props>(({ seed, stone, plantedOn, stoneLabel, stoneCaption = "Your colour", still = false, className = "", pressed, fitted = false, saved, children, behind, sky }, ref) => {
+  const bedRef = useRef<HTMLDivElement>(null);
+  const garden = useMemo(() => layoutGarden(seed), [seed]);
+  // Her own additions, within the 80-plant budget: pressed flowers, then the ring of buds, then the newest sprigs.
+  const planted = useMemo(() => plantBed(seed, garden, { still, pressed, fitted, saved }), [garden, still, pressed, fitted, saved, seed]);
+  const { bands, ringed } = planted;
+  const calm = still || stillMotion();
+  const active = useAmbient(bedRef, !calm);
+  // The screen's one ambient loop: the sway, and every layer drawn in the bed, join it.
+  const loop = useLoop(active);
+  const night = !still && sky === "night";
+  const retraced = useRef(0);
+
+  // Her own plants answer a tap of their own; anywhere else, a flower opens.
+  const onSpecial = useCallback(
+    (target: Element) => {
+      if (target.tagName.toLowerCase() !== "path") return false;
+      const root = bedRef.current;
+      const naira = target.closest<HTMLElement>(".ig-plant--naira");
+      if (naira) {
+        const now = performance.now();
+        if (now - retraced.current > 900) {
+          retraced.current = now;
+          withTouch((t) => t.retrace(naira, root?.querySelector(".ig-bed-label--naira")));
+        }
+        return true;
+      }
+      const plant = target.closest<HTMLElement>(".ig-plant--stone");
+      if (plant && stone && root) {
+        const { hue } = stone;
+        withTouch((t) => t.glint(root, plant, hue));
+        return true;
+      }
+      return false;
+    },
+    [stone],
+  );
+
+  const bloomAt = useTapBloom(bedRef, !still, { onSpecial });
+
+  useImperativeHandle(ref, () => ({
+    hint: () => {
+      const head = bedRef.current?.querySelector(".ig-plant--naira")?.getBoundingClientRect();
+      if (head) bloomAt(head.left + head.width * 0.62, head.top + head.height * 0.3);
+    },
+    bloomIn: (short = false) => {
+      const root = bedRef.current;
+      if (!root || calm) return [];
+      const out: Animation[] = [];
+      root.querySelectorAll<HTMLElement>(".ig-band").forEach((node) => {
+        const band = Number(node.dataset.band ?? 0);
+        const a = play(node, [{ transform: "scaleY(.12)", opacity: 0 }, { transform: "scaleY(1)", opacity: 1 }], {
+          duration: short ? 300 : 560,
+          delay: band * (short ? 12 : 40),
+          easing: EASE_BLOOM,
+          fill: "backwards",
+        });
+        if (a) out.push(a);
+      });
+      root.querySelectorAll(".ig-bed-label").forEach((label) => {
+        const a = play(label, [{ opacity: 0 }, { opacity: 1 }], { duration: 400, delay: short ? 120 : 520, easing: EASE_REVEAL, fill: "backwards" });
+        if (a) out.push(a);
+      });
+      root.querySelectorAll(".ig-soil, .ig-arbour-line").forEach((line) => {
+        const a = play(line, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], {
+          duration: short ? 300 : 620,
+          easing: "cubic-bezier(0.45, 0, 0.25, 1)",
+          fill: "backwards",
+        });
+        if (a) out.push(a);
+      });
+      return out;
+    },
+  }), [calm, bloomAt]);
+
+  // The sway: built once, then paused and resumed with the garden's attention (the loop).
+  useEffect(() => {
+    const root = bedRef.current;
+    if (!root || calm) return;
+    const list: Animation[] = [];
+    root.querySelectorAll<HTMLElement>(".ig-sway").forEach((node) => {
+      const dur = Number(node.dataset.dur ?? 4) * 1000;
+      const a = play(node, [{ transform: "rotate(-2.5deg)" }, { transform: "rotate(2.5deg)" }], {
+        duration: dur,
+        iterations: Infinity,
+        direction: "alternate",
+        easing: "ease-in-out",
+      });
+      if (!a) return;
+      a.currentTime = Number(node.dataset.phase ?? 0) * dur;
+      a.pause();
+      list.push(a);
+    });
+    const leave = loop.join(list);
+    return () => {
+      leave();
+      list.forEach((a) => a.cancel());
+    };
+  }, [calm, garden, loop]);
+
+  return (
+    <div ref={bedRef} className={`ig-bed ${className}`} data-resting={active ? undefined : ""} data-sky={still ? undefined : sky} style={night ? NIGHT_BED : undefined}>
+      <AmbientLoopContext.Provider value={loop}>
+      {!still && behind}
+      <svg viewBox={`0 0 ${BED.w} ${BED.h}`} className="ig-bed-ground" aria-hidden>
+        {!still && <Arbour />}
+        <path className="ig-soil" d={`M14 ${BED.soil + 1}H${BED.w - 14}`} pathLength={1} strokeDasharray="1 1" />
+        {/* Her size kept: a gold ring dropped in the soil at her stone flower's foot, the buds sprouting through it. */}
+        {ringed && <ellipse cx={garden.stone.x} cy={RING_SOIL} rx={RING_RX} ry={RING_RY} fill="none" stroke="var(--nf-accent-strong)" strokeWidth="1" />}
+        {[40, 92, 236, 318, 352].map((x) => (
+          <circle key={x} cx={x} cy={BED.soil + 5} r="1.2" fill="var(--nf-accent)" opacity=".7" />
+        ))}
+      </svg>
+      {bands.map((plants, band) =>
+        plants.length ? (
+          <div key={band} className="ig-band" data-band={band} style={{ transformOrigin: `50% ${bandSoil(band)}` }}>
+            {plants.map((p) => {
+              const b = boxOf(p);
+              return (
+                <div
+                  key={p.id}
+                  className={`ig-plant ig-plant--${p.kind}`}
+                  style={{ left: pct(b.left, BED.w), top: pct(b.top, BED.h), width: pct(b.w, BED.w), height: pct(b.h, BED.h) }}
+                >
+                  <div
+                    className={p.sway && !calm ? "ig-sway" : "ig-still"}
+                    data-dur={p.swayDur}
+                    data-phase={p.swayPhase.toFixed(3)}
+                    style={{ opacity: ROW_SHADE[p.row] }}
+                  >
+                    {p.kind === "naira" ? (
+                      <FlowerDraw height={208} />
+                    ) : p.kind === "stone" ? (
+                      <StonePlant stone={stone} />
+                    ) : (
+                      <svg viewBox="-30 -112 60 112" className="ig-sway-art" aria-hidden>
+                        {art(p)}
+                      </svg>
+                    )}
+                  </div>
+                </div>
+              );
+            })}
+          </div>
+        ) : null,
+      )}
+      {children}
+      </AmbientLoopContext.Provider>
+      {!still && plantedOn && (
+        <p className="ig-bed-label ig-bed-label--naira" style={{ left: pct(garden.naira.x, BED.w), ...(night ? NIGHT_LABEL : null) }}>
+          <span style={night ? NIGHT_CAPTION : undefined}>Planted</span>
+          {plantedOn}
+        </p>
+      )}
+      {!still && stoneLabel && (
+        <p className="ig-bed-label ig-bed-label--stone" style={{ left: pct(garden.stone.x, BED.w), ...(night ? NIGHT_LABEL : null) }}>
+          <span style={night ? NIGHT_CAPTION : undefined}>{stoneCaption}</span>
+          {stoneLabel}
+        </p>
+      )}
+    </div>
+  );
+});
+GardenBed.displayName = "GardenBed";
+
+export default GardenBed;
