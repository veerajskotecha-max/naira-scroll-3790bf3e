diff --git a/src/components/portal/petalFlight.ts b/src/components/portal/petalFlight.ts
new file mode 100644
index 0000000..ddcaf06
--- /dev/null
+++ b/src/components/portal/petalFlight.ts
@@ -0,0 +1,56 @@
+/*
+  Petals from one point (the gate's latch, her stone opening). At most 24,
+  each a small <svg><use> moved with transform and opacity only, and each
+  removed the moment its flight ends, so nothing is left behind for the
+  compositor. Nothing at all under reduced motion.
+
+  Every petal's flight is created at once, with its start as a delay on the
+  same timeline, so the moment it is cued costs nothing: no nodes are made
+  and no animations are built in the middle of an entrance.
+
+  The two flights share this: the round burst (PetalBurst.ts, for something
+  she did) and the fall from the Doors' latch (PetalFall.ts). They are apart
+  so the garden home, whose Doors need only the fall, never carries the burst.
+*/
+
+export const MAX_PETALS = 24;
+const SVG = "http://www.w3.org/2000/svg";
+
+export type PetalOptions = {
+  count?: number;
+  spread?: number;
+  duration?: number;
+  delay?: number;
+  /** Symbol ids to use, in turn (the hue petal takes its colour from `color`). */
+  ids?: readonly string[];
+  color?: string;
+  /** Petal size range in px. */
+  size?: [number, number];
+};
+
+export const petalNode = (layer: HTMLElement, x: number, y: number, id: string, size: number, color?: string) => {
+  const svg = document.createElementNS(SVG, "svg");
+  svg.setAttribute("viewBox", "0 0 20 20");
+  svg.setAttribute("aria-hidden", "true");
+  svg.setAttribute("class", "ig-petal");
+  svg.style.cssText = `left:${x}px;top:${y}px;width:${size}px;height:${size}px;opacity:0${color ? `;color:${color}` : ""}`;
+  const use = document.createElementNS(SVG, "use");
+  use.setAttribute("href", `#${id}`);
+  svg.appendChild(use);
+  layer.appendChild(svg);
+  return svg;
+};
+
+export const settle = (svg: SVGSVGElement, a: Animation | null, out: Animation[]) => {
+  if (!a) {
+    svg.remove();
+    return;
+  }
+  const done = () => svg.remove();
+  a.onfinish = done;
+  a.oncancel = done;
+  out.push(a);
+};
+
+export const clampCount = (n: number | undefined, fallback: number) => Math.min(MAX_PETALS, Math.max(0, n ?? fallback));
+
