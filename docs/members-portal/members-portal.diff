+              "Opening the night sky…"
+            ) : (
+              <>
+                We couldn't open the night sky just now.{" "}
+                <button type="button" className={textLink} onClick={lookUp}>
+                  Try again
+                </button>
+              </>
+            )}
+          </p>
+        )}
+
+        <section className="ig-section" aria-labelledby="ig-today">
+          <h2 id="ig-today" className="ig-h2">
+            In your garden
+          </h2>
+          {current ? <OpenDropCard drop={current} now={now} /> : <NextDropCard drop={next} now={now} />}
+          <Link to="/members/stone" className="ig-card-link">
+            <StoneHead stone={stone} size={56} />
+            <span className="ig-card-text">
+              <span className={eyebrow}>{stone ? `${stone.monthName}'s colour` : "Your stone"}</span>
+              <span className="ig-card-title">{stone ? shownName(stone.variant) : "Waiting for your birthday"}</span>
+              <span className="ig-card-more">{stone ? "Your birthstone heart" : "Tell us your month"} →</span>
+            </span>
+          </Link>
+          <Link to="/members/card" className="ig-card-link">
+            <CardGlyph />
+            <span className="ig-card-text">
+              <span className={eyebrow}>Your garden card</span>
+              <span className="ig-card-title">A picture of your garden</span>
+              <span className="ig-card-more">To keep, or to share →</span>
+            </span>
+          </Link>
+        </section>
+
+        {/* The atelier's notes, when the owner has written one: each a pressed flower she can unfold. */}
+        {notesIn.shown && (
+          <section className="ig-section" aria-labelledby="ig-atelier">
+            <h2 id="ig-atelier" className="ig-h2">
+              From the atelier
+            </h2>
+            <ul style={NOTE_LIST}>
+              {notes.map((n) => (
+                <AtelierNote key={n.id} note={n} />
+              ))}
+            </ul>
+          </section>
+        )}
+
+        {/* Her first signed-in visit only: the list, and the ad-matching box unticked,
+            if either is missing. Never over the Doors; once she has seen it on this phone, never again, and never on a later day. */}
+        <Suspense fallback={null}>
+          {firstVisit && !doors && <ArrivalRepair user={user} profile={arrivalProfile} actions={arrival} onClosed={onArrivalClosed} />}
+        </Suspense>
+
+        <section className="ig-section" aria-labelledby="ig-growing">
+          <h2 id="ig-growing" ref={growingRef} tabIndex={-1} className="ig-h2">
+            What's growing
