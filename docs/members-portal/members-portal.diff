@@ -0,0 +1,176 @@
+import { describe, expect, it } from "vitest";
+import { BIRTH_FLOWER_PATHS } from "@/components/portal/BirthFlowers";
+import { ARCH, BED } from "./gardenLayout";
+import { SHEET, STAR_FLOWERS, onDrawing, starFlowerFor } from "./starFlowers";
+
+/*
+  The twelve star tables of "Written in your sky": 6 to 8 stars each, far
+  enough apart for a fingertip at a 320 px phone, each on its own flower's
+  line, joined once each; and the drawing's place in the night sky, inside
+  the arbour's arch, clear of the moon and the next drop's bud.
+*/
+
+type Pt = [number, number];
+
+/* A path's points, sampled finely (M, L, H, C, Q and arcs, as the twelve drawings are written). */
+const sample = (d: string): Pt[] => {
+  const tokens = d.match(/[A-Za-z]|-?\d*\.?\d+(?:e-?\d+)?/g) ?? [];
+  const out: Pt[] = [];
+  let i = 0;
+  let cmd = "";
+  let at: Pt = [0, 0];
+  const num = () => Number(tokens[i++]);
+  const steps = 240;
+  while (i < tokens.length) {
+    if (/[A-Za-z]/.test(tokens[i])) cmd = tokens[i++];
+    if (cmd === "M" || cmd === "L") {
+      const to: Pt = [num(), num()];
+      if (cmd === "L") for (let k = 1; k <= steps; k++) out.push([at[0] + ((to[0] - at[0]) * k) / steps, at[1] + ((to[1] - at[1]) * k) / steps]);
+      at = to;
+      out.push(at);
+      if (cmd === "M") cmd = "L";
+    } else if (cmd === "H") {
+      const x = num();
+      for (let k = 1; k <= steps; k++) out.push([at[0] + ((x - at[0]) * k) / steps, at[1]]);
+      at = [x, at[1]];
+    } else if (cmd === "C") {
+      const [a, b, c]: Pt[] = [[num(), num()], [num(), num()], [num(), num()]];
+      for (let k = 1; k <= steps; k++) {
+        const t = k / steps;
+        const u = 1 - t;
+        out.push([u * u * u * at[0] + 3 * u * u * t * a[0] + 3 * u * t * t * b[0] + t * t * t * c[0], u * u * u * at[1] + 3 * u * u * t * a[1] + 3 * u * t * t * b[1] + t * t * t * c[1]]);
+      }
+      at = c;
+    } else if (cmd === "Q") {
+      const [a, c]: Pt[] = [[num(), num()], [num(), num()]];
+      for (let k = 1; k <= steps; k++) {
+        const t = k / steps;
+        const u = 1 - t;
+        out.push([u * u * at[0] + 2 * u * t * a[0] + t * t * c[0], u * u * at[1] + 2 * u * t * a[1] + t * t * c[1]]);
+      }
+      at = c;
+    } else if (cmd === "A" || cmd === "a") {
+      const [rx0, ry0, , large, sweep] = [num(), num(), num(), num(), num()];
+      const to: Pt = cmd === "a" ? [at[0] + num(), at[1] + num()] : [num(), num()];
+      // Circular arcs only (every arc in the drawings is): the centre from the chord, the radius and the flags.
+      let r = Math.max(rx0, ry0);
+      const [mx, my] = [(at[0] + to[0]) / 2, (at[1] + to[1]) / 2];
+      const half = Math.hypot(to[0] - at[0], to[1] - at[1]) / 2;
+      r = Math.max(r, half);
+      const h = Math.sqrt(Math.max(0, r * r - half * half));
+      const [ux, uy] = half ? [(to[0] - at[0]) / (2 * half), (to[1] - at[1]) / (2 * half)] : [1, 0];
+      const sign = large === sweep ? -1 : 1;
+      const c: Pt = [mx - sign * h * uy, my + sign * h * ux];
+      const a0 = Math.atan2(at[1] - c[1], at[0] - c[0]);
+      let a1 = Math.atan2(to[1] - c[1], to[0] - c[0]);
+      if (sweep && a1 < a0) a1 += 2 * Math.PI;
+      if (!sweep && a1 > a0) a1 -= 2 * Math.PI;
+      for (let k = 1; k <= steps; k++) {
+        const a = a0 + ((a1 - a0) * k) / steps;
+        out.push([c[0] + r * Math.cos(a), c[1] + r * Math.sin(a)]);
+      }
+      at = to;
+    } else {
+      throw new Error(`unread path command ${cmd}`);
+    }
+  }
+  return out;
+};
+
+/* The arbour's arch (gardenLayout's ARCH), as a polygon. */
+const arch = (() => {
+  const [p0, p1, p2, p3, q1, q2, q3]: Pt[] = [[22, 214], [22, 132], [104, 78], [195, 78], [286, 78], [368, 132], [368, 214]];
+  const bez = (a: Pt, b: Pt, c: Pt, e: Pt, t: number): Pt => {
+    const u = 1 - t;
+    return [u * u * u * a[0] + 3 * u * u * t * b[0] + 3 * u * t * t * c[0] + t * t * t * e[0], u * u * u * a[1] + 3 * u * u * t * b[1] + 3 * u * t * t * c[1] + t * t * t * e[1]];
+  };
+  const pts: Pt[] = [[22, BED.soil], p0];
+  for (let k = 1; k <= 60; k++) pts.push(bez(p0, p1, p2, p3, k / 60));
+  for (let k = 1; k <= 60; k++) pts.push(bez(p3, q1, q2, q3, k / 60));
+  pts.push([368, BED.soil]);
+  return pts;
+})();
+const insideArch = ([x, y]: Pt) => {
+  let inside = false;
+  for (let i = 0, j = arch.length - 1; i < arch.length; j = i++) {
+    const [xi, yi] = arch[i];
+    const [xj, yj] = arch[j];
+    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
+  }
+  return inside;
+};
+const toArchEdge = ([x, y]: Pt) =>
+  Math.min(
+    ...arch.map((a, i) => {
+      const b = arch[(i + 1) % arch.length];
+      const [dx, dy] = [b[0] - a[0], b[1] - a[1]];
+      const t = Math.max(0, Math.min(1, ((x - a[0]) * dx + (y - a[1]) * dy) / (dx * dx + dy * dy || 1)));
+      return Math.hypot(x - (a[0] + t * dx), y - (a[1] + t * dy));
+    }),
+  );
+
+const MOON: Pt = [195, 158];
+/* The next drop's bud (DropBud: 62 wide, its top 18 above its 77.5 high glyph), at either of its two places (GardenHome). */
+const BUDS = [92, 300].map((x) => ({ left: x - 31, right: x + 31, top: 300 - 77.5 - 18, bottom: 300 }));
+
+const inSky = (f: (typeof STAR_FLOWERS)[number]) => f.stars.map((s): Pt => {
+  const [x, y] = onDrawing(s, f.sheet);
+  return [f.sky[0] + f.sky[2] * x, f.sky[1] + f.sky[2] * y];
+});
+
+describe("the twelve star tables", () => {
+  it("has one for every month, each of 6 to 8 stars", () => {
+    expect(STAR_FLOWERS).toHaveLength(12);
+    expect(BIRTH_FLOWER_PATHS).toHaveLength(12);
+    for (const f of STAR_FLOWERS) {
+      expect(f.stars.length).toBeGreaterThanOrEqual(6);
+      expect(f.stars.length).toBeLessThanOrEqual(8);
+    }
+    expect(starFlowerFor(7)).toBe(STAR_FLOWERS[6]);
+    for (const bad of [0, 13, null, undefined, 2.5]) expect(starFlowerFor(bad)).toBeNull();
+  });
+
+  it("keeps every two stars 56 units apart and every star 28 from the sheet's edge", () => {
+    for (const [m, f] of STAR_FLOWERS.entries()) {
+      for (const [x, y] of f.stars) expect(Math.min(x, y, SHEET - x, SHEET - y), `month ${m + 1}`).toBeGreaterThanOrEqual(28);
+      for (let i = 0; i < f.stars.length; i++)
+        for (let j = i + 1; j < f.stars.length; j++) expect(Math.hypot(f.stars[i][0] - f.stars[j][0], f.stars[i][1] - f.stars[j][1]), `month ${m + 1}`).toBeGreaterThanOrEqual(56);
+      // At a 320 px phone the sheet is 288 px wide: a star's 56-unit target is 44 px or more.
+      expect((56 * 288) / SHEET).toBeGreaterThanOrEqual(44);
+    }
+  });
+
+  it("sets every star on its own month's drawing", () => {
+    for (const [m, f] of STAR_FLOWERS.entries()) {
+      const line = sample(BIRTH_FLOWER_PATHS[m]);
+      for (const star of f.stars) {
+        const [x, y] = onDrawing(star, f.sheet);
+        const near = Math.min(...line.map(([px, py]) => Math.hypot(px - x, py - y)));
+        // Within a fifth of a drawing unit (about a sheet unit): on the line itself.
+        expect(near, `month ${m + 1}, star ${star}`).toBeLessThan(0.25);
+      }
+    }
+  });
+
+  it("joins every star exactly once, in order, from the stem's foot", () => {
+    for (const f of STAR_FLOWERS) {
+      const keys = f.stars.map(([x, y]) => `${x},${y}`);
+      expect(new Set(keys).size).toBe(f.stars.length);
+      // The first star is the lowest: the stem's foot.
+      expect(f.stars[0][1]).toBe(Math.max(...f.stars.map(([, y]) => y)));
+    }
+  });
+
+  it("rests each flower inside the arch, clear of the moon and the next drop's bud", () => {
+    for (const [m, f] of STAR_FLOWERS.entries()) {
+      for (const p of inSky(f)) {
+        expect(insideArch(p), `month ${m + 1}`).toBe(true);
+        expect(toArchEdge(p), `month ${m + 1}`).toBeGreaterThanOrEqual(12);
+        expect(Math.hypot(p[0] - MOON[0], p[1] - MOON[1]), `month ${m + 1}`).toBeGreaterThanOrEqual(28);
+        for (const b of BUDS) expect(p[0] >= b.left - 4 && p[0] <= b.right + 4 && p[1] >= b.top - 4 && p[1] <= b.bottom, `month ${m + 1}`).toBe(false);
+      }
+    }
+    // The arch the test reads is the bed's own.
+    expect(ARCH).toBe("M22 522V214C22 132 104 78 195 78C286 78 368 132 368 214V522H22Z");
+  });
+});
