+    <path d="M4.5 8.5L7 4.5H17L19.5 8.5M12 8.5V20" className="ig-nav-line" />
+    <path d="M12 13.2C10.6 12 10.6 10.5 12 9.8 13.4 10.5 13.4 12 12 13.2Z" className="ig-nav-petal" />
+  </svg>
+);
+
+const CardIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    <path d="M7 3H17V21H7Z" className="ig-nav-line" />
+    <path d="M12 17V12.5M12 14.6C10.8 14.4 10.1 13.6 10 12.6 11.2 12.7 11.9 13.5 12 14.6Z" className="ig-nav-line" />
+    <circle cx="12" cy="9.4" r="2.1" className="ig-nav-petal" />
+  </svg>
+);
+
+const AccountIcon = () => (
+  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden>
+    <circle cx="12" cy="8.5" r="3.6" className="ig-nav-line" />
