+});
+
+describe("the five placements in source", () => {
+  it("puts exactly one piece in each of the five rooms, each its own, and none anywhere else", () => {
+    const rooms = { Drops: "drops", Drawer: "drawer", Fit: "fit", Gifts: "gifts", Care: "care" };
+    for (const [room, key] of Object.entries(rooms)) {
+      const code = readFileSync(resolve(src, `pages/members/${room}.tsx`), "utf8");
+      expect(code.match(/<PetalSpot\b/g), room).toHaveLength(1);
+      expect(code).toMatch(new RegExp(`<PetalSpot piece="${key}">`));
+    }
+    expect(new Set(Object.values(rooms)).size).toBe(5);
