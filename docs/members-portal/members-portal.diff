new file mode 100644
index 0000000..cf2d18e
--- /dev/null
+++ b/src/pages/members/Stone.tsx
@@ -0,0 +1,241 @@
+import { useEffect, useLayoutEffect, useRef, useState, type FormEvent } from "react";
+import PortalShell from "@/components/portal/PortalShell";
+import SeedCeremony from "@/components/portal/SeedCeremony";
+import StoneCard, { type ShopStatus } from "@/components/portal/StoneCard";
+import { HeartStone } from "@/components/portal/HeartStone";
+import { useMember, type SaveResult } from "@/components/portal/MemberContext";
+import { eyebrow, primaryButton, quietButton } from "@/components/portal/styles";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { STONES, isPlausibleBirthday, monthOfBirthday, shownName, stoneForMonth } from "@/lib/portal/stones";
+import { BIRTHSTONE_HANDLE } from "@/lib/portal/stonePiece";
+import { forgetMonth, keepMonth } from "@/lib/portal/roomChanges";
+import { formatIstDate } from "@/lib/portal/ist";
+import { readPortal, writePortal } from "@/lib/portal/safeStorage";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import "./stone.css";
+
+/*
+  Your stone. The first visit plays the seed ceremony; a birthday, if her
+  profile has none, is one date field saved to her own profile (the column
+  Account already edits), and her bud opens in view as it is saved. Rather
+  than the whole date she can keep just her month (naira.month, on her
+  account), chosen from the twelve below. Her month's specimen card turns
+  over to the live necklace; the other eleven months sit below it, for a gift.
+*/
+
+const todayIso = () => new Date().toISOString().slice(0, 10);
+/* The bloom after a saved birthday takes this long; the card rises after it. */
+const BLOOM_MS = 1500;
+
+const BirthdayForm = ({ onSave }: { onSave: (birthday: string) => Promise<SaveResult> }) => {
+  const [value, setValue] = useState("");
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState<string | null>(null);
+  const live = useRef(true);
+  useEffect(
+    () => () => {
+      live.current = false;
+    },
+    [],
+  );
+
+  const submit = async (e: FormEvent) => {
+    e.preventDefault();
+    if (!isPlausibleBirthday(value)) {
+      setMessage("Please choose your birthday from the calendar.");
+      return;
+    }
+    setBusy(true);
+    setMessage(null);
+    const result = await onSave(value);
+    // Saved, the form has gone: her stone has taken its place.
+    if (!live.current) return;
+    setBusy(false);
+    if (result.ok === false) setMessage(result.message);
+  };
+
+  return (
+    <form className="ig-birthday" onSubmit={submit} data-clarity-mask="true">
+      <label htmlFor="ig-birthday" className="ig-h2">
+        When is your birthday?
+      </label>
+      <p className="ig-fineprint">
+        Your flower opens in your month's colour. It is saved to your account, where you can change it. Rather not give the day? Choose your month below, and keep just that.
+      </p>
+      <input
+        id="ig-birthday"
+        type="date"
+        required
+        max={todayIso()}
+        min="1900-01-01"
+        value={value}
+        onChange={(e) => setValue(e.target.value)}
+        className="ig-input"
+        autoComplete="bday"
+      />
+      {message && (
+        <p className="ig-error" role="alert">
+          {message}
+        </p>
+      )}
+      <button type="submit" className={primaryButton} disabled={busy}>
+        {busy ? "Planting…" : "Plant my stone"}
+      </button>
+    </form>
+  );
+};
+
+const Stone = () => {
+  const member = useMember();
+  const { profile, user, preview, saveBirthday, addToBag, month, naira, changeMeta } = member;
+  const own = stoneForMonth(month);
+  // Her month alone (no birthday on her profile): hers to change or forget here.
+  const monthOnly = monthOfBirthday(profile?.birthday) === null && Boolean(naira.month);
+  const [picked, setPicked] = useState<number | null>(null);
+  const shown = stoneForMonth(picked ?? own?.month ?? null);
+  const [ceremony, setCeremony] = useState(() => !readPortal().seedSeen && !stillMotion());
+  const [planting, setPlanting] = useState(false);
+  const [holdCard, setHoldCard] = useState(false);
+  const [rise, setRise] = useState(false);
+  const [peek, setPeek] = useState(0);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const cardRef = useRef<HTMLElement>(null);
+  const holdTimer = useRef(0);
+  const { jewellery, isLive, isLoading } = useLiveJewellery();
+  const piece = isLive ? jewellery.find((p) => p.handle === BIRTHSTONE_HANDLE) : undefined;
+  const status: ShopStatus = piece ? "ready" : isLive ? "missing" : isLoading ? "loading" : "offline";
+  const plantedOn = formatIstDate(user.created_at);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+    return () => window.clearTimeout(holdTimer.current);
+  }, []);
+
+  // The card rises in once her stone has opened.
+  useLayoutEffect(() => {
+    if (!rise) return;
+    play(cardRef.current, [{ opacity: 0, transform: "translateY(16px)" }, { opacity: 1, transform: "none" }], { duration: 500, easing: EASE_REVEAL, fill: "backwards" });
+  }, [rise]);
+
+  const endCeremony = () => {
+    writePortal({ seedSeen: true });
+    setCeremony(false);
+    if (own) setPeek((n) => n + 1);
+  };
+
+  /* The bloom is for her saving it here, never for a profile that simply
+     arrives: SeedCeremony opens the bud only while `planting` is set. */
+  const plant = async (save: () => Promise<SaveResult>): Promise<SaveResult> => {
+    const motion = !stillMotion();
+    setPlanting(true);
+    setHoldCard(motion);
+    const result = await save();
+    if (result.ok === false) {
+      setPlanting(false);
+      setHoldCard(false);
+      return result;
+    }
+    if (motion) {
+      holdTimer.current = window.setTimeout(() => {
+        setHoldCard(false);
+        setRise(true);
+        setPeek((n) => n + 1);
+      }, BLOOM_MS);
+    }
+    return result;
+  };
+
+  /* Just her month: kept on her account, and her bud opens for it as it does for a birthday. */
+  const keepJustMonth = (m: number) => {
+    setPicked(null);
+    void plant(async () => {
+      const result = changeMeta(keepMonth(m));
+      return result.ok === false ? { ok: false, message: result.message } : { ok: true };
+    });
+    // Back to the top, where her bud opens (the heading sits under the fixed header otherwise).
+    h1Ref.current?.focus({ preventScroll: true });
+    window.scrollTo?.({ top: 0, behavior: stillMotion() ? "auto" : "smooth" });
+  };
+
+  return (
+    <PortalShell title="Your stone" description="Your birthstone in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-stone-page">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            Your <em>stone</em>
+          </h1>
+          <p className="ig-lede">
+            {own ? `${shownName(own.variant)}: the heart in your month's colour.` : "Tell us your birthday, and your flower opens in your month's colour."}
+          </p>
+        </div>
+
+        <SeedCeremony stone={own} playing={ceremony} onDone={endCeremony} celebrate={planting} />
+        <p className="ig-seed-caption">
+          A seed for you{plantedOn ? `, planted ${plantedOn}` : ""}.
+          <br />
+          {own ? `Your stone opens: ${shownName(own.variant)}.` : "Its bud waits for your birthday, or your month."}
+        </p>
+
+        {!own && (
+          <BirthdayForm
+            onSave={(birthday) =>
+              plant(async () => {
+                const result = await saveBirthday(birthday);
+                // A whole birthday now: the month kept alone is no longer needed.
+                if (result.ok) changeMeta(forgetMonth);
+                return result;
+              })
+            }
+          />
+        )}
+
+        {shown && !holdCard && (
+          <section ref={cardRef} className="ig-section" aria-label={`${shown.variant}, specimen card`}>
+            <StoneCard stone={shown} piece={piece} status={status} own={shown.month === own?.month} preview={preview} onAdd={addToBag} peek={peek} />
+          </section>
+        )}
+
+        <section className="ig-section" aria-labelledby="ig-months">
+          <h2 id="ig-months" className="ig-h2">
+            Every month's colour
+          </h2>
+          <p className="ig-fineprint">For a gift, or layer two hearts for two birthdays.</p>
+          <ul className="ig-months">
+            {STONES.map((s) => (
+              <li key={s.month}>
+                <button
+                  type="button"
+                  className="ig-month"
+                  aria-pressed={shown?.month === s.month}
+                  onClick={() => setPicked(s.month)}
+                >
+                  <HeartStone stone={s} size={22} />
+                  <span>{s.monthName.slice(0, 3)}</span>
+                  {own?.month === s.month && <span className="ig-month-own">Yours</span>}
+                </button>
+              </li>
+            ))}
+          </ul>
+          {picked && picked !== own?.month && (!own || monthOnly) && (
+            <button type="button" className={primaryButton} onClick={() => keepJustMonth(picked)}>
+              Keep {stoneForMonth(picked)?.monthName} as my month
+            </button>
+          )}
+          {picked && own && picked !== own.month && (
+            <button type="button" className={quietButton} onClick={() => setPicked(null)}>
+              Back to {own.monthName}
+            </button>
+          )}
+          {monthOnly && (!picked || picked === own?.month) && (
+            <button type="button" className={quietButton} onClick={() => changeMeta(forgetMonth)}>
+              Forget my month
+            </button>
+          )}
+        </section>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Stone;
