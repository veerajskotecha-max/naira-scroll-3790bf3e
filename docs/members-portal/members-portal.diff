@@ -0,0 +1,103 @@
+import { stillMotion } from "./motion";
+import { demoteTier, portalTier } from "./tier";
+
+/*
+  The one way in to Tier 2's code: the Bloom Field's scene (three.js, the
+  shared "three" chunk), the gem on Your stone (Phase 6's Stone Light, the
+  same three.js, its own scene-*.js chunk) and the drop room's gsap
+  choreography (the shared
+  "gsap" chunk, with Flip and Physics2D in two small chunks of their own). Both are fetched only by import()
+  from here, only on a Tier 2 phone, and never under reduced motion or Data
+  Saver: for those, neither download is ever asked for.
+
+  Either one failing to arrive is harmless: the drop room plays today's
+  choreography and its art. main.tsx reloads the page when a chunk fails
+  (a stale build), which is right for a room's code and wrong for a
+  flourish, so while one of these is on its way a listener ahead of it
+  (capture, on window, where capture listeners run first) keeps a failure of
+  these chunks, or one a browser reports without naming any file (Safari's
+  "Importing a module script failed."), from reaching that reload. The
+  import then rejects, and the caller falls back. Nothing else is touched:
+  a room's own chunk that fails still reloads, through its error boundary.
+*/
+
+export type BloomScene = typeof import("./scene");
+export type GemScene = typeof import("./gem/scene");
+export type Choreography = typeof import("./unboxGsap");
+export type BloomFieldHandle = ReturnType<BloomScene["mountBloomField"]>;
+export type GemHandle = ReturnType<GemScene["mountGem"]>;
+
+const OURS = /\/assets\/(?:scene|three|RoomEnvironment|unboxGsap|gsap|Flip|Physics2DPlugin)-[\w-]+\.js/;
+const NAMES_A_FILE = /\/assets\/[\w.-]+\.(?:js|css)\b/;
+
+/** A failed download of Tier 2's code (or one reported without a file name), never a reason to reload her page. */
+export const isSpectacleFailure = (reason: unknown): boolean => {
+  const said = String((reason as Error | undefined)?.message ?? reason ?? "");
+  return OURS.test(said) || !NAMES_A_FILE.test(said);
+};
+
+const quietly = <T>(load: () => Promise<T>): Promise<T | null> => {
+  const hush = (e: Event & { payload?: unknown }) => {
+    if (isSpectacleFailure(e.payload)) e.stopImmediatePropagation();
+  };
+  window.addEventListener("vite:preloadError", hush, true);
+  const done = () => window.removeEventListener("vite:preloadError", hush, true);
+  return load().then(
+    (m) => {
+      done();
+      return m;
+    },
+    () => {
+      done();
+      return null;
+    },
+  );
+};
+
+/** Whether Tier 2 may run now: a capable phone, motion allowed, not demoted this visit. */
+export const spectacleAllowed = (): boolean => !stillMotion() && portalTier() === 2;
+
+let scene: Promise<BloomScene | null> | null = null;
+let gsap: Promise<Choreography | null> | null = null;
+let gsapIn: Choreography | null = null;
+
+/** The Bloom Field's scene, or null (Tier 1, or it could not arrive: then Tier 1 for the visit). */
+export const loadBloomScene = (): Promise<BloomScene | null> => {
+  if (!spectacleAllowed()) return Promise.resolve(null);
+  return (scene ??= quietly(() => import("@/lib/portal/scene")).then((m) => {
+    if (!m) {
+      // No three.js today (offline, blocked): the art stays as it is, and it is not asked for again this visit.
+      demoteTier();
+      scene = null;
+    }
+    return m;
+  }));
+};
+
+let gemScene: Promise<GemScene | null> | null = null;
+
+/** The gem's scene for Stone Light, or null (Tier 1, or it could not arrive: then Tier 1 for the visit). */
+export const loadGemScene = (): Promise<GemScene | null> => {
+  if (!spectacleAllowed()) return Promise.resolve(null);
+  return (gemScene ??= quietly(() => import("@/lib/portal/gem/scene")).then((m) => {
+    if (!m) {
+      demoteTier();
+      gemScene = null;
+    }
+    return m;
+  }));
+};
+
+/** The drop room's gsap choreography, or null (Tier 1, or it could not arrive: today's choreography then). */
+export const loadChoreography = (): Promise<Choreography | null> => {
+  if (!spectacleAllowed()) return Promise.resolve(null);
+  // In once its two plugins are in and registered too.
+  return (gsap ??= quietly(() => import("@/lib/portal/unboxGsap").then((m) => m.ready.then(() => m))).then((m) => {
+    if (!m) gsap = null;
+    gsapIn = m;
+    return m;
+  }));
+};
+
+/** The choreography if it is already here and Tier 2 still holds; never waits, never fetches. */
+export const choreographyNow = (): Choreography | null => (gsapIn && spectacleAllowed() ? gsapIn : null);
