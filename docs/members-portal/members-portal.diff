+import { describe, expect, it } from "vitest";
+import type { WishlistItem } from "@/contexts/WishlistContext";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { deviceHandles, heartsFor, mergeSaved } from "./wishlistSync";
+
+/* The Jewel drawer: this phone's hearts and her account's saved handles,
+   kept as one list of at most 24, rebuilt from the live catalogue. */
+
+const live = new Set(["a", "b", "c", "d", "e", "f"]);
+
+describe("merging the phone and the account", () => {
+  it("keeps both lists together, oldest first, with nothing twice", () => {
+    const plan = mergeSaved(["c", "a", "d"], ["a", "b"], [], live);
+    expect(plan.saved).toEqual(["a", "b", "c", "d"]);
+    expect(plan.missingOnDevice).toEqual(["b"]);
+    expect(plan.removeFromDevice).toEqual([]);
+    expect(plan.agreed).toEqual(["a", "c", "d"]);
+  });
+
+  it("keeps at most 24, letting the oldest go", () => {
+    const many = Array.from({ length: 30 }, (_, i) => `piece-${i}`);
+    const plan = mergeSaved(many.slice(10), many.slice(0, 15), [], null);
+    expect(plan.saved).toHaveLength(24);
+    expect(plan.saved[0]).toBe("piece-6");
+    expect(plan.saved.at(-1)).toBe("piece-29");
+    expect(new Set(plan.saved).size).toBe(24);
+  });
+
+  it("a new phone gets everything she saved on another", () => {
+    const plan = mergeSaved([], ["a", "b", "c"], [], live);
+    expect(plan.saved).toEqual(["a", "b", "c"]);
+    expect(plan.missingOnDevice).toEqual(["a", "b", "c"]);
+  });
+
+  it("a heart taken off on this phone leaves the account too", () => {
+    const plan = mergeSaved(["a"], ["a", "b"], ["a", "b"], live);
+    expect(plan.saved).toEqual(["a"]);
+  });
+
+  it("a piece taken out of the drawer on another phone leaves this one", () => {
+    const plan = mergeSaved(["a", "b"], ["a"], ["a", "b"], live);
+    expect(plan.saved).toEqual(["a"]);
+    expect(plan.removeFromDevice).toEqual(["b"]);
+    expect(plan.agreed).toEqual(["a"]);
+  });
+
+  it("drops a handle the live shop no longer carries, quietly, but never on a guess", () => {
+    expect(mergeSaved(["a", "gone"], ["retired"], [], live).saved).toEqual(["a"]);
+    // Shop not reachable: nothing is forgotten.
+    expect(mergeSaved(["a", "gone"], ["retired"], [], null).saved).toEqual(["retired", "a", "gone"]);
+  });
+
+  it("is settled once agreed: the same lists give the same plan and nothing to do", () => {
+    const first = mergeSaved(["a", "c"], ["a", "b"], [], live);
+    const again = mergeSaved(["a", "c"], first.saved, first.agreed, live);
+    expect(again.saved).toEqual(first.saved);
+    expect(again.removeFromDevice).toEqual([]);
+    expect(again.agreed).toEqual(first.agreed);
+  });
+});
+
+/* One pass of the drawer as the page runs it: the account takes the plan's
+   list (its cap may let some go), the phone drops what was taken out
+   elsewhere, and the two keep what they agreed on and what spilled. */
+type World = { device: string[]; account: string[]; base: string[]; spill: string[] };
+const pass = (w: World, cap = Infinity): { next: World; changed: boolean } => {
+  const plan = mergeSaved(w.device, w.account, w.base, null, w.spill);
+  const fitted = plan.saved.slice(Math.max(0, plan.saved.length - cap));
+  const lost = plan.saved.filter((h) => !fitted.includes(h) && w.device.includes(h));
+  const next: World = {
+    device: w.device.filter((h) => !plan.removeFromDevice.includes(h)),
+    account: fitted,
+    base: plan.agreed.filter((h) => !lost.includes(h)),
+    spill: [...plan.spill, ...lost.filter((h) => !plan.spill.includes(h))],
+  };
+  const changed = JSON.stringify(next) !== JSON.stringify(w);
+  return { next, changed };
+};
+const settle = (start: World, cap = Infinity) => {
+  let w = start;
+  for (let i = 0; i < 10; i++) {
+    const { next, changed } = pass(w, cap);
+    if (!changed) return { w, passes: i };
+    w = next;
+  }
+  return { w, passes: Infinity };
+};
+// A small seeded random, so a failure can be replayed.
+const rng = (seed: number) => () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);
+const pick = (r: () => number, pool: string[], n: number) => pool.filter(() => r() < n / pool.length);
+
+describe("more hearts than the drawer holds", () => {
+  const hearts = (n: number) => Array.from({ length: n }, (_, i) => `heart-${String(i).padStart(2, "0")}`);
+
+  it("settles with 25 or more hearts on the phone, and never takes a heart off for not fitting", () => {
+    for (const n of [24, 25, 26, 30, 40]) {
+      const device = hearts(n);
+      const { w, passes } = settle({ device, account: [], base: [], spill: [] });
+      expect(passes, `${n} hearts`).toBeLessThanOrEqual(2);
+      expect(w.account).toHaveLength(Math.min(24, n));
+      expect(w.device).toEqual(device);
+      expect(w.spill).toHaveLength(Math.max(0, n - 24));
+    }
+  });
+
+  it("a 25th piece kept pushes the oldest out of the drawer, but its heart stays on this phone", () => {
+    const device = hearts(24);
+    const { w } = settle({ device, account: [], base: [], spill: [] });
+    // Keep a piece not hearted here: the account lets its oldest go; the page spills it.
+    const account = [...w.account, "kept-here"].slice(-24);
+    const after = settle({ ...w, account, base: w.base.filter((h) => h !== device[0]), spill: [...w.spill, device[0]] });
+    expect(after.w.account).toEqual(account);
+    expect(after.w.device).toEqual(device);
+    expect(after.w.spill).toContain(device[0]);
+  });
+
+  it("the account's cap trimming pieces never deletes this phone's hearts", () => {
+    const device = hearts(20);
+    const { w, passes } = settle({ device, account: [], base: [], spill: [] }, 12);
+    expect(passes).toBeLessThanOrEqual(3);
+    expect(w.device).toEqual(device);
+    expect(w.account).toHaveLength(12);
+    expect(w.spill).toHaveLength(8);
+  });
+
+  it("from any start, it reaches a fixed point within a few passes, keeps 24 at most, and removes only what was taken out elsewhere", () => {
+    const pool = hearts(40);
+    for (let seed = 1; seed <= 400; seed++) {
+      const r = rng(seed);
+      const device = pick(r, pool, Math.floor(r() * 40));
+      const account = pick(r, pool, Math.floor(r() * 24)).slice(-24);
+      const base = pick(r, pool, Math.floor(r() * 24));
+      const spill = pick(r, pool, Math.floor(r() * 8));
+      const start = { device, account, base, spill };
+      const { w, passes } = settle(start);
+      expect(passes, `seed ${seed}`).toBeLessThanOrEqual(3);
+      expect(w.account.length).toBeLessThanOrEqual(24);
+      // A heart leaves this phone only when the two had agreed on it and the account has since let it go.
+      for (const h of device.filter((x) => !w.device.includes(x))) {
+        expect(base.includes(h) && !account.includes(h), `seed ${seed}: ${h}`).toBe(true);
+      }
+    }
+  });
+});
