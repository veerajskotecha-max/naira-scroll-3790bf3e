+
+/* One tab for each of the bar's MORE_PATHS, in its order. */
+const MORE: Record<(typeof MORE_PATHS)[number], { label: string; icon: JSX.Element }> = {
+  "/members/fit": { label: "Your fit", icon: <FitIcon /> },
+  "/members/herbarium": { label: "Herbarium", icon: <HerbariumIcon /> },
+  "/members/gifts": { label: "Gifts", icon: <GiftsIcon /> },
+  "/members/vanity": { label: "Vanity", icon: <MirrorIcon /> },
+  "/members/card": { label: "Your card", icon: <CardIcon /> },
+  "/members/care": { label: "Care", icon: <CareIcon /> },
+  "/members/orders": { label: "Order desk", icon: <OrdersIcon /> },
+  "/account": { label: "Account", icon: <AccountIcon /> },
+};
+
+/* The second row: above the bar, inside its tier (inline, so members.css stays as it is). Four tabs to a
+   line, the last line's tabs sharing its width (a 12-column grid: four of 3 columns, three of 4, two of 6),
+   so its eight rooms (Phase 6 adds the Vanity) read as two even lines of four and every tab is 80 x 58 px
+   or more on a 320 px phone. Its own
+   hairline below keeps the bar's gold "you are here" marks from reading as underlines of the row above. */
+const PER_LINE = 4;
+const MORE_ROW: CSSProperties = {
+  position: "absolute",
+  display: "grid",
+  gridTemplateColumns: "repeat(12, minmax(0, 1fr))",
+  left: 0,
+  right: 0,
+  bottom: "100%",
+  paddingBottom: 6,
+  borderTop: "1px solid var(--ig-gold-line)",
+  borderBottom: "1px solid var(--ig-gold-line)",
+  backgroundColor: "rgb(var(--nf-ivory-rgb) / 0.98)",
+  /* A hairline between its lines of tabs (each 58 px tall), so a gold mark on a lower tab sits on a line, never under the tab above. */
+  backgroundImage: "repeating-linear-gradient(to bottom, transparent 0 57px, var(--ig-gold-line) 57px 58px)",
+  backgroundSize: "100% calc(100% - 64px)",
+  backgroundRepeat: "no-repeat",
+};
+const lastLine = MORE_PATHS.length % PER_LINE || PER_LINE;
+const span = (i: number): CSSProperties => ({
+  gridColumn: `span ${12 / (i >= MORE_PATHS.length - lastLine ? lastLine : PER_LINE)}`,
+});
+
+const PortalMore = ({ here }: { here: string }) => {
+  const rowRef = useRef<HTMLUListElement>(null);
+  useEffect(() => {
+    play(rowRef.current, [{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }], { duration: stillMotion() ? 0 : 260, easing: EASE_DRAWER, fill: "backwards" });
+  }, []);
+  return (
+    <ul ref={rowRef} id="ig-nav-more" style={MORE_ROW}>
+      {MORE_PATHS.map((to, i) => (
+        <Tab key={to} room={{ to, ...MORE[to] }} here={here} style={span(i)} />
+      ))}
+    </ul>
+  );
+};
+
+export default PortalMore;
