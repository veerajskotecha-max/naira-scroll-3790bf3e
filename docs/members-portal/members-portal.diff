+/* /members/fit: Your fit. Imported only by Fit.tsx (the sizer has its own sheet). */
+
+.ig-fit {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-fit .ig-section > .ig-fineprint { margin-top: 1rem; }
+.ig-fit .ig-lede { text-wrap: balance; }
+.ig-fit .ig-h2:focus { outline: none; }
+
+/* her size, engraved */
+.ig-kept { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 1.4rem 1rem 1.2rem; border: 1px solid var(--ig-gold-line); background: var(--ig-vellum); text-align: center; }
+.ig-kept:focus { outline: none; }
+.ig-kept:focus-visible { outline: 2px solid var(--nf-accent-strong); outline-offset: 2px; }
+.ig-kept-bloom { position: relative; display: block; height: 96px; transform-origin: 50% 70%; }
+.ig-kept-bloom svg { display: block; }
+.ig-kept-line { position: absolute; left: 0; top: 0; }
+.ig-kept-onward { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 1.25rem; margin-top: 0.5rem; }
+.ig-fit-forget, .ig-fit-all { display: flex; margin: 0.6rem auto 0; }
+.ig-kept-words { margin: 0.2rem 0 0; font-family: var(--nf-font-editorial); font-size: 2rem; line-height: 1.1; color: var(--nf-gold-text); }
+.ig-kept-letter { display: inline-block; }
+.ig-kept-rule { width: 160px; height: 6px; }
+.ig-kept-rule path { fill: none; stroke: var(--nf-accent); stroke-width: 1; stroke-dasharray: 1 1; }
+
+/* the three ways, and the metal */
+.ig-ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; width: 100%; }
+.ig-way, .ig-size {
+  min-height: 48px;
+  padding: 0.4rem 0.3rem;
+  border: 1px solid var(--ig-line);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 10.5px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.78);
+  cursor: pointer;
+}
+.ig-way[aria-pressed="true"], .ig-size[aria-pressed="true"] { border-color: var(--nf-accent-strong); background: var(--ig-vellum); color: var(--nf-ink); }
+.ig-ways + * { margin-top: 1.1rem; }
+
+.ig-thread, .ig-known, .ig-answer { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; width: 100%; }
+.ig-answer { align-items: center; padding-top: 0.4rem; }
+.ig-steps { margin: 0; padding-left: 1.2rem; font-family: var(--nf-font-label); font-size: 13px; line-height: 1.6; color: rgb(var(--nf-ink-rgb) / 0.78); text-align: left; }
+.ig-sizes { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.4rem; width: 100%; margin: 0; padding: 0; list-style: none; }
+.ig-size { width: 100%; min-height: 56px; font-size: 12px; }
+.ig-fit-h3 { margin: 1.8rem 0 0.8rem; font-family: var(--nf-font-editorial); font-weight: 500; font-size: 1.2rem; text-align: left; }
+
+@media (min-width: 768px) {
+  .ig-fit { padding-top: 2rem; }
+}
diff --git a/src/pages/members/gifts.css b/src/pages/members/gifts.css
new file mode 100644
index 0000000..3940c2d
--- /dev/null
+++ b/src/pages/members/gifts.css
@@ -0,0 +1,127 @@
+/* /members/gifts: the gift ledger. Imported only by Gifts.tsx (a piece card brings its own sheet). */
+
+.ig-gifts {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-gifts .ig-lede { text-wrap: balance; }
+.ig-gifts-empty { max-width: 22rem; }
+
+/* the twelve-month ring */
+.ig-gring { position: relative; width: 100%; max-width: 360px; aspect-ratio: 1; margin: 1.25rem auto 0.5rem; }
+.ig-gring-art { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
+.ig-gring-line { fill: none; stroke: var(--nf-accent); stroke-width: 1; stroke-dasharray: 1 1; }
+.ig-gring-line--fine { stroke-width: 0.6; opacity: 0.5; stroke-dasharray: none; }
+.ig-gring-tick { stroke: var(--nf-accent); stroke-width: 0.8; opacity: 0.75; }
+.ig-gring-month { font-family: var(--nf-font-label); font-size: 12px; letter-spacing: 0.12em; fill: var(--nf-gold-text); }
+.ig-gring-stem line { stroke: var(--nf-accent); stroke-width: 0.7; opacity: 0.75; }
+.ig-gring-stem circle { fill: var(--nf-accent); }
+.ig-gring-stem.is-next line { stroke: var(--nf-accent-strong); opacity: 1; }
+.ig-gring-today { fill: var(--nf-blush); stroke: var(--nf-accent-strong); stroke-width: 0.8; }
+.ig-gring-flowers { margin: 0; padding: 0; list-style: none; }
+.ig-gring-flowers li { position: absolute; width: 0; height: 0; }
+.ig-gring-flower {
+  position: absolute;
+  left: -22px;
+  top: -22px;
+  width: 44px;
+  height: 44px;
+  padding: 0;
+  border: 0;
+  background: none;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+.ig-gring-flower svg { display: block; overflow: visible; pointer-events: none; }
+.ig-gring-flower[aria-pressed="true"]::after { content: ""; position: absolute; left: 13px; right: 13px; bottom: -3px; height: 1px; background: var(--nf-ink); }
+.ig-gring-flower:focus-visible { outline: 2px solid var(--nf-accent-strong); outline-offset: 1px; }
+/* Round to the touch (the art inside stays as drawn): close neighbours' squares would overlap at their corners. */
+.ig-gring-flower { border-radius: 50%; }
+.ig-gring-halo { fill: rgb(var(--nf-gold-rgb) / 0.16); stroke: var(--nf-accent); stroke-width: 1; }
+.ig-gring-halo--fine { fill: none; stroke-width: 0.6; }
+.ig-gring-centre {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  display: flex;
+  flex-direction: column;
+  gap: 0.1rem;
+  width: 44%;
+  margin: 0;
+  transform: translate(-50%, -50%);
+  pointer-events: none;
+}
+.ig-gring-next { font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-28); text-transform: uppercase; color: var(--nf-gold-text); }
+.ig-gring-name { font-family: var(--nf-font-editorial); font-size: 1.6rem; line-height: 1.1; overflow-wrap: anywhere; }
+.ig-gring-when { font-family: var(--nf-font-label); font-size: 11.5px; color: rgb(var(--nf-ink-rgb) / 0.7); }
+
+/* the chosen date */
+.ig-gcard { display: flex; flex-direction: column; align-items: flex-start; gap: 0.8rem; padding: 1.2rem 1rem 1.4rem; border: 1px solid var(--ig-gold-line); background: var(--ig-vellum); }
+.ig-section.ig-gcard > .ig-h2 { padding: 0; margin: 0; border: 0; }
+.ig-gcard-head { display: flex; align-items: flex-end; gap: 0.9rem; }
+.ig-gcard-flower { flex: none; }
+.ig-gcard-name { overflow-wrap: anywhere; }
+.ig-gcard-when { margin: 0.15rem 0 0; font-family: var(--nf-font-editorial); font-style: italic; font-size: 1.1rem; }
+.ig-gcard-h3 { margin: 0.9rem 0 0; font-family: var(--nf-font-editorial); font-weight: 500; font-size: 1.2rem; }
+.ig-gstone { display: flex; gap: 0.8rem; width: 100%; padding: 0.9rem 0 0.2rem; border-top: 1px solid var(--ig-line); }
+.ig-gstone-heart { flex: none; margin-top: 1.1rem; }
+.ig-gstone-body { display: flex; flex-direction: column; align-items: flex-start; gap: 0.45rem; min-width: 0; }
+.ig-gstone-body .ig-gcard-h3 { margin: 0; }
+.ig-gstone-price { justify-content: flex-start; font-size: 15px; }
+.ig-gstone .ig-btn { height: 44px; font-size: 10.5px; }
+.ig-gremind { display: flex; flex-direction: column; align-items: flex-start; gap: 0.2rem; width: 100%; }
+
+/* her dates, in words */
+.ig-glist { margin: 0; padding: 0; list-style: none; }
+.ig-glist li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 0.5rem; padding: 0.35rem 0; border-bottom: 1px solid var(--ig-line); }
+.ig-glist li.is-shown { border-bottom-color: var(--ig-gold-line); }
+.ig-glist-pick { position: relative; display: grid; flex: 1 1 12rem; min-height: 48px; padding: 0.3rem 0; text-align: left; cursor: pointer; }
+.ig-glist-radio { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
+.ig-glist-radio:focus-visible + .ig-glist-name { outline: 2px solid var(--nf-accent-strong); outline-offset: 2px; }
+.ig-glist-name { font-family: var(--nf-font-editorial); font-size: 1.25rem; line-height: 1.2; overflow-wrap: anywhere; }
+.ig-glist-when, .ig-glist-band { font-family: var(--nf-font-label); font-size: 12px; color: rgb(var(--nf-ink-rgb) / 0.7); }
+.ig-glist-actions { display: flex; gap: 0.25rem; }
+.ig-glist li.ig-glist-edit { display: block; }
+.ig-gnotice { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; margin-bottom: 0.4rem; }
+.ig-gnotice:focus { outline: none; }
+.ig-gfull { margin-top: 1rem; color: var(--nf-ink); }
+.ig-gifts .ig-section > .ig-btn--outline { margin-top: 1.1rem; }
+.ig-gprivacy { margin-top: 1.4rem; }
+
+/* the date's form */
+.ig-oform { display: flex; flex-direction: column; gap: 1.1rem; width: 100%; margin-top: 1.1rem; padding: 1.2rem 1rem; border: 1px solid var(--ig-gold-line); background: var(--ig-vellum); text-align: left; }
+.ig-oform-row { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; margin: 0; padding: 0; border: 0; }
+.ig-oform-label { padding: 0; font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: var(--nf-track-20); text-transform: uppercase; color: var(--nf-gold-text); }
+.ig-oform-input { text-align: left; }
+.ig-oform .ig-input::placeholder { color: rgb(var(--nf-ink-rgb) / 0.55); opacity: 1; }
+.ig-oform .ig-input[aria-invalid="true"] { border-bottom: 2px solid #a44a34; }
+.ig-oform .ig-error { margin: 0.2rem 0 0; }
+.ig-oform-when { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 0.6rem; }
+.ig-oform-select { padding: 0 0.4rem; text-align: left; }
+.ig-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.4rem; }
+.ig-chip { display: block; cursor: pointer; }
+.ig-chip span {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 48px;
+  padding: 0.3rem;
+  border: 1px solid var(--ig-line);
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: 0.06em;
+  text-align: center;
+  color: rgb(var(--nf-ink-rgb) / 0.78);
+}
+.ig-chip input:checked + span { border-color: var(--nf-accent-strong); background: rgb(var(--nf-ivory-rgb)); color: var(--nf-ink); }
+.ig-chip input:focus-visible + span { outline: 2px solid var(--nf-accent-strong); outline-offset: 1px; }
+.ig-oform-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
+
+@media (min-width: 768px) {
+  .ig-gifts { padding-top: 2rem; }
+}
diff --git a/src/pages/members/herbarium-room.css b/src/pages/members/herbarium-room.css
new file mode 100644
index 0000000..026d622
--- /dev/null
+++ b/src/pages/members/herbarium-room.css
@@ -0,0 +1,27 @@
+/* /members/herbarium: pressed flowers and keepsakes. Imported only by Herbarium.tsx (the frames bring herbarium.css). */
+
+.ig-herbarium {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-herbarium .ig-lede { text-wrap: balance; }
+.ig-hwall { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem 1rem; width: 100%; margin: 0; padding: 0; list-style: none; }
+.ig-hwall > li::before { content: ""; display: block; width: 1px; height: 14px; margin: 0 auto; background: var(--ig-gold-line); }
+.ig-hwall .ig-herb-sheet { transform: rotate(-0.8deg); transform-origin: 50% 0; }
+.ig-hwall > li:nth-child(even) .ig-herb-sheet { transform: rotate(0.8deg); }
+.ig-hwall-link, .ig-keepsake-link { display: block; color: inherit; text-decoration: none; }
+.ig-hwall-link:focus-visible, .ig-keepsake-link:focus-visible { outline: 1px solid var(--nf-accent-strong); outline-offset: 4px; }
+.ig-keepsake .ig-herb-flower { height: 70%; align-items: center; }
+.ig-keepsake.is-empty .ig-herb-note { color: rgb(var(--nf-ink-rgb) / 0.6); }
+.ig-herbarium-joy { margin-top: 2rem; text-align: center; }
+
+@media (min-width: 768px) {
+  .ig-herbarium { padding-top: 2rem; }
+  .ig-hwall { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+  .ig-keeps { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+}
