+vi.mock("@/components/members/JoinInnerCircleForm", () => ({ default: () => <form aria-label="Join the Inner Circle" /> }));
+/* One stable value, as the real provider gives: a new profile object on
+   every render would re-run Account's form effect for ever. */
+const member = vi.hoisted(() => ({
