+++ b/src/components/portal/CareRitual.tsx
@@ -0,0 +1,124 @@
+import { useEffect, useLayoutEffect, useRef, useState } from "react";
+import type { RitualStep } from "@/lib/portal/care";
+import type { Metal } from "@/lib/portal/memberMeta";
+import { EASE_BLOOM, EASE_DRAWER, play, stillMotion } from "@/lib/portal/motion";
+
+/*
+  The wipe ritual: three steps, each the listings' own care words, and for
+  each a pass of the cloth. A ring (the bag's own small cut-out of a
+  solitaire, gold or silver to her metal) starts under a dull film; at each
+  step a cloth, a gold hairline at its edge, sweeps across it and the film
+  behind it thins; after the third, the stone catches a glint.
+
+  Transform and opacity only: the film is cleared by a window that slides
+  one way while the film inside it slides back (so it stays put and is cut
+  away), and the cloth rides the window's edge. Each pass runs once, on her
+  tap; nothing loops. Under reduced motion or Data Saver the ring is shown
+  polished, with its glint, and the three steps as a plain list: still art.
+*/
+
+/** How dull the ring is before each step, and after the last. */
+export const FILM = [0.66, 0.4, 0.17, 0] as const;
+const PASS_MS = 950;
+
+const CAPTION = ["Three passes of the cloth.", "One step done.", "Two steps done.", "Polished to a glint."];
+
+type Props = { steps: readonly RitualStep[]; metal?: Metal };
+
+const CareRitual = ({ steps, metal }: Props) => {
+  const [still] = useState(stillMotion);
+  const [level, setLevel] = useState(still ? steps.length : 0);
+  const [passing, setPassing] = useState<number | null>(null);
+  const windowRef = useRef<HTMLDivElement>(null);
+  const filmRef = useRef<HTMLDivElement>(null);
+  const clothRef = useRef<HTMLDivElement>(null);
+  const glintRef = useRef<SVGSVGElement>(null);
+  const live = useRef(true);
+  useEffect(
+    () => () => {
+      live.current = false;
+    },
+    [],
+  );
+
+  // A pass: the window slides off to the right, its film held in place, the cloth on its edge.
+  useLayoutEffect(() => {
+    if (passing === null) return;
+    const opts = { duration: PASS_MS, easing: EASE_DRAWER, fill: "forwards" as const };
+    const a = play(windowRef.current, [{ transform: "translateX(0)" }, { transform: "translateX(100%)" }], opts);
+    play(filmRef.current, [{ transform: "translateX(0)" }, { transform: "translateX(-100%)" }], opts);
+    play(clothRef.current, [{ transform: "translateX(-14px) rotate(-7deg)", opacity: 0 }, { opacity: 1, offset: 0.12 }, { opacity: 1, offset: 0.88 }, { transform: "translateX(146px) rotate(5deg)", opacity: 0 }], opts);
+    const done = () => {
+      if (!live.current) return;
+      setPassing(null);
+      setLevel((l) => Math.min(l + 1, steps.length));
+    };
+    if (a) a.onfinish = done;
+    else done();
+  }, [passing, steps.length]);
+
+  // The glint, once, when the last pass is done.
+  useLayoutEffect(() => {
+    if (still || level < steps.length) return;
+    play(glintRef.current, [{ opacity: 0, transform: "scale(0.2) rotate(-40deg)" }, { opacity: 1, transform: "scale(1.15) rotate(10deg)", offset: 0.6 }, { opacity: 1, transform: "none" }], { duration: 700, easing: EASE_BLOOM, fill: "backwards" });
+  }, [level, still, steps.length]);
+
+  const film = FILM[Math.min(level + (passing !== null ? 1 : 0), FILM.length - 1)];
+  const done = level >= steps.length;
+
+  return (
+    <div className={`ig-ritual${metal === "s" ? " ig-ritual--silver" : ""}`}>
+      <div className="ig-ritual-stage" aria-hidden>
+        <div className="ig-ritual-ring">
+          <div className="ig-ritual-shine" />
+          <div className="ig-ritual-film" style={{ opacity: film }} />
+          {passing !== null && (
+            <div ref={windowRef} className="ig-ritual-window">
+              <div ref={filmRef} className="ig-ritual-film" style={{ opacity: FILM[passing] }} />
+            </div>
+          )}
+          {passing !== null && (
+            <div ref={clothRef} className="ig-ritual-cloth">
+              <svg viewBox="0 0 22 190" width="22" height="190">
+                <path d="M4 0C9 40 2 80 7 120S5 170 9 190H22V0Z" className="ig-ritual-cloth-band" />
+                <path d="M4 0C9 40 2 80 7 120S5 170 9 190" className="ig-ritual-cloth-edge" />
+              </svg>
+            </div>
+          )}
+          {done && (
+            <svg ref={glintRef} className="ig-ritual-glint" viewBox="-12 -12 24 24" width="26" height="26">
+              <path d="M0-11L1.6-1.6L11 0L1.6 1.6L0 11L-1.6 1.6L-11 0L-1.6-1.6Z" />
+            </svg>
+          )}
+        </div>
+      </div>
+      <p className="ig-ritual-caption" role="status">
+        {CAPTION[Math.min(level, CAPTION.length - 1)]}
+      </p>
+      <ol className="ig-ritual-steps">
+        {steps.map((step, i) => (
+          <li key={step.words} className={i < level ? "is-done" : i === level ? "is-now" : undefined}>
+            {!still && i === level && passing === null ? (
+              <button type="button" className="ig-ritual-step" onClick={() => setPassing(i)}>
+                <span className="ig-ritual-no">{i + 1}</span>
+                {step.words}
+              </button>
+            ) : (
+              <span className="ig-ritual-step">
+                <span className="ig-ritual-no">{i + 1}</span>
+                {step.words}
+              </span>
+            )}
+          </li>
+        ))}
+      </ol>
+      {!still && done && (
+        <button type="button" className="ig-quiet" onClick={() => setLevel(0)}>
+          Once more
+        </button>
+      )}
+    </div>
+  );
+};
+
+export default CareRitual;
