+    expect(container.querySelector(".ig-wall .ig-herb.is-empty")).toBeNull();
+    expect(screen.getByRole("link", { name: /Drop 01 · Verdant/ }).getAttribute("href")).toBe("/members/drops/verdant");
+  });
+
+  it("reads 'Opening shortly' when the time has passed but nothing is on the shop, never a clock below zero", async () => {
+    vi.useFakeTimers({ now: opens + 20 * 60_000 });
+    setReducedMotion(true);
+    shop.jewellery = [];
+    const { container } = await visit("/members/drops/verdant");
+    expect(screen.getByRole("heading", { name: "Opening shortly" })).toBeInTheDocument();
+    expect(container.querySelector(".ig-bc")).toBeNull();
+    expect(container.querySelector(".ig-unbox")).toBeNull();
+    expect(screen.getAllByRole("link", { name: "Arriving · ask on WhatsApp" })).toHaveLength(verdant.handles.length);
+  });
+});
+
+describe("a drop in the Vault", () => {
+  beforeEach(() => manifest.drops.push(verdant));
+
+  it("is a gentle empty frame when she did not press it", async () => {
+    vi.useFakeTimers({ now: Date.parse("2026-12-20T06:30:00Z") });
+    const { container } = await visit("/members/vault");
+    expect(screen.getByText("This one bloomed in November")).toBeInTheDocument();
+    expect(container.querySelector(".ig-herb.is-empty")).not.toBeNull();
+    expect(container.textContent).not.toMatch(BANNED);
+  });
+
+  it("holds her pressed flower when she did", async () => {
+    vi.useFakeTimers({ now: Date.parse("2026-12-20T06:30:00Z") });
+    window.localStorage.setItem("naira-portal", JSON.stringify({ pressedLocal: ["verdant"], pressedOn: { verdant: "2026-11-21" } }));
+    const { container } = await visit("/members/vault");
+    expect(screen.getByText("pressed 21 Nov")).toBeInTheDocument();
+    expect(container.querySelector(".ig-herb.is-empty")).toBeNull();
+  });
+});
+
+describe("the unboxing's petals", () => {
+  it("are at most 24, and every flight ends by 1.6 s", () => {
+    expect(ballisticFlights(200)).toHaveLength(MAX_BURST);
+    for (const f of ballisticFlights(24, { seed: "verdant" })) {
+      expect(f.delay + f.duration).toBeLessThanOrEqual(BURST_MS);
+      expect(f.keyframes[0].opacity).toBe(0);
+      expect(f.keyframes[f.keyframes.length - 1].opacity).toBe(0);
+      for (const k of f.keyframes) expect(Object.keys(k).sort()).toEqual(["offset", "opacity", "transform"]);
+    }
+  });
+
+  it("are the same arcs for a drop on every phone", () => {
+    expect(ballisticFlights(24, { seed: "verdant" })).toEqual(ballisticFlights(24, { seed: "verdant" }));
+  });
+});
+
+/* Nothing in the portal sits above the z-40 tier: the bag drawer (z-50) opens over all of it. */
+describe("layers", () => {
+  it("keeps every portal z-index at 40 or below", () => {
+    const src = resolve(__dirname, "../..");
+    const css = (dir: string): string[] =>
+      readdirSync(dir, { withFileTypes: true }).flatMap((e) => (e.isDirectory() ? css(join(dir, e.name)) : /\.(css|tsx)$/.test(e.name) && !/\.test\./.test(e.name) ? [join(dir, e.name)] : []));
+    const values = ["pages/members", "components/portal"].flatMap((d) => css(join(src, d))).flatMap((f) => [...readFileSync(f, "utf8").matchAll(/z-index:\s*(\d+)|zIndex:\s*(\d+)/g)].map((m) => Number(m[1] ?? m[2])));
+    expect(values.length).toBeGreaterThan(0);
+    expect(Math.max(...values)).toBeLessThanOrEqual(40);
+  });
+});
