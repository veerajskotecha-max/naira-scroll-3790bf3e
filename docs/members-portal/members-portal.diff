+++ b/src/lib/portal/shareCard.test.ts
@@ -0,0 +1,231 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { ART_CSS, ART_TOKENS, CARD, FRAME, cardLayout, cardTexts, cleanLine, composeArtSvg, drawCard, shareMode, type CardInput, type CardLayout } from "./shareCard";
+import { inAppBrowser } from "./inAppBrowser";
+
+/* A stand-in for canvas measureText: a generous estimate (wider than either face sets it). */
+const estimate = (text: string, _font: string, size: number, tracking: number) => [...text].length * size * 0.62 + tracking * size * Math.max(0, [...text].length - 1);
+
+const inputs: CardInput[] = [
+  { art: "garden", name: null, stone: "July · Ruby" },
+  { art: "garden", name: "Ananya", stone: "July · Ruby" },
+  { art: "garden", name: null, stone: null },
+  { art: "garden", name: "Ananya", stone: "December · Blue Zircon" },
+  { art: "garden", name: "Mahalakshmi Venkataraman", stone: "September · Sapphire" },
+  { art: "flower", name: null, stone: "July · Ruby", flower: "Verdant" },
+  { art: "flower", name: "Meera", stone: null, flower: "Moonlit Jasmine Garland" },
+  { art: "flower", name: null, stone: null, flower: null },
+];
+
+const inside = (box: { x: number; y: number; w: number; h: number }, frame: CardLayout["frame"]["inner"]) =>
+  box.x >= frame.x && box.y >= frame.y && box.x + box.w <= frame.x + frame.w && box.y + box.h <= frame.y + frame.h;
+
+describe("the garden card's layout", () => {
+  it("is a phone's story: 1080 x 1920, framed in gold", () => {
+    expect(CARD).toEqual({ w: 1080, h: 1920 });
+    expect(FRAME.outer).toBeLessThan(FRAME.inner);
+  });
+
+  it.each(inputs.map((i) => [JSON.stringify(i), i] as const))("fits everything inside the frame: %s", (_k, input) => {
+    const layout = cardLayout(input, estimate);
+    const { inner, outer } = layout.frame;
+    expect(inside(outer, { x: 0, y: 0, w: CARD.w, h: CARD.h })).toBe(true);
+    expect(inside(inner, outer)).toBe(true);
+    expect(inside(layout.wordmark, inner)).toBe(true);
+    expect(inside(layout.art, inner)).toBe(true);
+    let last = 0;
+    for (const t of layout.texts) {
+      // Each line set to fit its width, between the frame's sides, its cap height and descenders inside the frame.
+      const width = estimate(t.text, t.font, t.size, t.tracking);
+      expect(width, t.text).toBeLessThanOrEqual(t.maxWidth);
+      expect(t.x - width / 2).toBeGreaterThanOrEqual(inner.x);
+      expect(t.x + width / 2).toBeLessThanOrEqual(inner.x + inner.w);
+      expect(t.y - t.size * 0.8).toBeGreaterThanOrEqual(inner.y);
+      expect(t.y + t.size * 0.3).toBeLessThanOrEqual(inner.y + inner.h);
+      // Top to bottom, none over another, and none over the art.
+      expect(t.y - t.size * 0.8).toBeGreaterThanOrEqual(last);
+      last = t.y + t.size * 0.3;
+      const over = t.y + t.size * 0.3 > layout.art.y && t.y - t.size * 0.8 < layout.art.y + layout.art.h;
+      expect(over, t.text).toBe(false);
+    }
+    // The art keeps its own shape: the garden bed's 390:560, or the herbarium sheet's 4:5.
+    const aspect = layout.art.w / layout.art.h;
+    expect(aspect).toBeCloseTo(input.art === "flower" ? 4 / 5 : 390 / 560, 5);
+  });
+
+  it("sets a long name smaller rather than past the frame", () => {
+    const short = cardLayout({ art: "garden", name: "Ira", stone: null }, estimate).texts.find((t) => /garden$/.test(t.text))!;
+    const long = cardLayout({ art: "garden", name: "Mahalakshmi Venkataraman", stone: null }, estimate).texts.find((t) => /garden$/.test(t.text))!;
+    expect(long.size).toBeLessThan(short.size);
+  });
+});
+
+describe("what the card says", () => {
+  it("leaves her name off unless she turns it on", () => {
+    const off = cardTexts({ art: "garden", name: null, stone: "July · Ruby" });
+    expect(off.title).toBeNull();
+    expect(cardLayout({ art: "garden", name: null, stone: "July · Ruby" }).texts.map((t) => t.text).join(" ")).not.toMatch(/Ananya/);
+    const on = cardTexts({ art: "garden", name: "Ananya", stone: "July · Ruby" });
+    expect(on.title).toBe("Ananya’s garden");
+    expect(cardTexts({ art: "garden", name: "Ras", stone: null }).title).toBe("Ras’ garden");
+  });
+
+  it("names her stone as the listing does, in her month's colour", () => {
+    const t = cardTexts({ art: "garden", name: null, stone: "July · Ruby" });
+    expect(t.line).toBe("July · Ruby");
+    expect(t.caption).toBe("IN YOUR MONTH’S COLOUR");
+    expect(cardTexts({ art: "garden", name: null, stone: null }).caption).toBeNull();
+  });
+
+  it.each(inputs.map((i) => [JSON.stringify(i), i] as const))("carries no number, no count and no date: %s", (_k, input) => {
+    const all = cardLayout(input, estimate).texts.map((t) => t.text).join(" | ");
+    expect(all).not.toMatch(/\d/);
+    expect(all).not.toMatch(/member|number|no\.|#|since|joined|planted|count|pieces|flowers pressed/i);
+  });
+
+  it("drops any line that would carry a digit, rather than print it", () => {
+    expect(cleanLine("Edition 2")).toBeNull();
+    expect(cleanLine("Ananya92")).toBeNull();
+    expect(cleanLine("  Ananya\u0007  ")).toBe("Ananya");
+    expect(cleanLine("x".repeat(33))).toBeNull();
+    const t = cardTexts({ art: "flower", name: "Ananya 2", stone: "July · Ruby", flower: "Drop 01" });
+    expect(t.title).toBeNull();
+    expect(t.line).toBeNull();
+    expect(t.caption).toBeNull();
+  });
+});
+
+describe("drawing the card", () => {
+  /* A context that records what is drawn. */
+  const recorder = () => {
+    const calls: { op: string; args: unknown[] }[] = [];
+    const ctx = new Proxy(
+      { measureText: (s: string) => ({ width: s.length * 20 }) } as Record<string, unknown>,
+      {
+        get(target, prop: string) {
+          if (prop in target) return target[prop];
+          return (...args: unknown[]) => calls.push({ op: prop, args });
+        },
+        set(target, prop: string, value) {
+          target[prop] = value;
+          calls.push({ op: `set ${prop}`, args: [value] });
+          return true;
+        },
+      },
+    );
+    return { ctx: ctx as unknown as CanvasRenderingContext2D, calls };
+  };
+  const withPath2D = <T,>(run: () => T): T => {
+    const g = globalThis as { Path2D?: unknown };
+    const had = g.Path2D;
+    g.Path2D = class {
+      constructor(public d?: string) {}
+    };
+    try {
+      return run();
+    } finally {
+      g.Path2D = had;
+    }
+  };
+
+  it("draws only the layout's words, none of them a digit, and her name only when it is on", () => {
+    for (const input of [inputs[0], inputs[1], inputs[5]]) {
+      const { ctx, calls } = recorder();
+      const layout = cardLayout(input, estimate);
+      withPath2D(() => drawCard(ctx, input, layout, {} as CanvasImageSource));
+      const drawn = calls.filter((c) => c.op === "fillText").map((c) => String(c.args[0]));
+      const joined = drawn.join("");
+      expect(joined).not.toMatch(/\d/);
+      // Tracked lines are drawn a letter at a time: the letters still spell the layout's lines.
+      expect(joined.replace(/\s/g, "")).toBe(layout.texts.map((t) => t.text).join("").replace(/\s/g, ""));
+      expect(joined.includes("Ananya")).toBe(Boolean(input.name));
+      expect(calls.filter((c) => c.op === "drawImage")).toHaveLength(1);
+    }
+  });
+
+  it("draws the Naira flower when the art could not be painted", () => {
+    const { ctx, calls } = recorder();
+    withPath2D(() => drawCard(ctx, inputs[0], cardLayout(inputs[0]), null));
+    expect(calls.filter((c) => c.op === "drawImage")).toHaveLength(0);
+    // The wordmark's letters and flower, then the fallback flower's stem and petals.
+    expect(calls.filter((c) => c.op === "fill").length).toBeGreaterThan(5);
+  });
+});
+
+describe("the art as an SVG of its own", () => {
+  it("carries the page's symbols, its colours written out and the classes it draws with", () => {
+    document.body.innerHTML = `
+      <svg class="ig-sprite"><defs><symbol id="ig-head-0" viewBox="-50 -50 100 100"><path d="M0 0" fill="currentColor"/></symbol></defs></svg>
+      <svg id="art" viewBox="0 0 390 560"><path class="ig-soil" d="M14 523H376"/><circle fill="var(--nf-accent)" r="1"/><path stroke="var(--nf-accent-strong)" d="M0 0"/><use href="#ig-head-0" style="color: #F3D9C6"/></svg>`;
+    const svg = composeArtSvg(document.getElementById("art") as unknown as SVGSVGElement, document.querySelector(".ig-sprite defs"), 876, 1258);
+    expect(svg).toMatch(/^<svg xmlns="http:\/\/www\.w3\.org\/2000\/svg" viewBox="0 0 390 560" width="876" height="1258">/);
+    expect(svg).toContain('id="ig-head-0"');
+    expect(svg).toContain(ART_CSS);
+    expect(svg).not.toMatch(/var\(--/);
+    expect(svg).toContain('fill="#C99A4C"');
+    expect(svg).toContain('stroke="#B0843A"');
+    document.body.innerHTML = "";
+  });
+
+  /* An SVG drawn as an image sees none of the page's stylesheet: the card's copies of the bed's rules must match members.css. */
+  it("draws the bed's lines as members.css does", () => {
+    const css = readFileSync(resolve(__dirname, "../../pages/members/members.css"), "utf8");
+    const rule = (selector: string) => {
+      const m = css.match(new RegExp(`(^|\\n)${selector.replace(/[.-]/g, (c) => `\\${c}`)}\\s*\\{([^}]*)\\}`));
+      return (m?.[2] ?? "")
+        .split(";")
+        .map((d) => d.trim().replace(/\s*:\s*/, ":"))
+        .filter(Boolean)
+        .map((d) => d.replace(/var\((--[\w-]+)\)/g, (_w, name: string) => ART_TOKENS[name] ?? _w).replace(/:\.(\d)/, ":0.$1"));
+    };
+    for (const sel of [".ig-soil", ".ig-arbour-line", ".ig-arbour-line--fine", ".ig-arbour-tick"]) {
+      const mine = ART_CSS.match(new RegExp(`${sel.replace(/[.-]/g, (c) => `\\${c}`)}\\{([^}]*)\\}`))?.[1].split(";") ?? [];
+      expect(mine.sort(), sel).toEqual(rule(sel).sort());
+    }
+    expect(ART_CSS).toContain(".ig-stone-budcap{opacity:0}");
+    expect(css).toMatch(/\.ig-stone-budcap \{ opacity: 0; \}/);
+  });
+
+  it("writes out the brand's own token colours", () => {
+    const css = readFileSync(resolve(__dirname, "../../index.css"), "utf8");
+    const token = (name: string) => css.match(new RegExp(`${name}:\\s*(#[0-9A-Fa-f]{6})`))?.[1]?.toUpperCase();
+    expect(ART_TOKENS["--nf-ivory"]).toBe(token("--nf-ivory"));
+    expect(ART_TOKENS["--nf-ink"]).toBe(token("--nf-ink"));
+    expect(ART_TOKENS["--nf-accent"]).toBe(token("--nf-gold"));
+    expect(ART_TOKENS["--nf-accent-strong"]).toBe(token("--nf-gold-deep"));
+    expect(ART_TOKENS["--nf-blush"]).toBe(token("--nf-blush"));
+    expect(ART_TOKENS["--nf-sage"]).toBe(token("--nf-sage"));
+    expect(ART_TOKENS["--nf-gold-text"]).toBe(token("--nf-gold-text"));
+  });
+});
+
+describe("sharing the card", () => {
+  const UAS = {
+    instagramAndroid: "Mozilla/5.0 (Linux; Android 13; SM-A536E) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/120.0 Mobile Safari/537.36 Instagram 312.0.0.34.111 Android",
+    instagramIos: "Mozilla/5.0 (iPhone; CPU iPhone OS 17_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 Instagram 311.0.2.29.104",
+    facebookIos: "Mozilla/5.0 (iPhone; CPU iPhone OS 17_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Mobile/15E148 [FBAN/FBIOS;FBAV/440.0.0.33.116]",
+    facebookAndroid: "Mozilla/5.0 (Linux; Android 13) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Mobile Safari/537.36 [FB_IAB/FB4A;FBAV/440.0.0.33.116;]",
+    chromeAndroid: "Mozilla/5.0 (Linux; Android 13; SM-A536E) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Mobile Safari/537.36",
+    safariIos: "Mozilla/5.0 (iPhone; CPU iPhone OS 17_1 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.1 Mobile/15E148 Safari/604.1",
+  };
+
+  it("opens the image inside Instagram and Facebook, even where a share seems offered", () => {
+    for (const ua of [UAS.instagramAndroid, UAS.instagramIos, UAS.facebookIos, UAS.facebookAndroid]) {
+      expect(shareMode(ua, true)).toBe("open");
+      expect(shareMode(ua, false)).toBe("open");
+    }
+  });
+
+  it("shares the file where the phone can, and opens the image where it cannot", () => {
+    expect(shareMode(UAS.chromeAndroid, true)).toBe("share");
+    expect(shareMode(UAS.safariIos, true)).toBe("share");
+    expect(shareMode(UAS.chromeAndroid, false)).toBe("open");
+    expect(shareMode("", false)).toBe("open");
+    expect(shareMode(null, true)).toBe("share");
+  });
+
+  it("tells the in-app browsers apart as Auth's own check does", () => {
+    for (const ua of Object.values(UAS)) expect(shareMode(ua, true) === "open", ua).toBe(inAppBrowser(ua) !== null);
+  });
+});
diff --git a/src/lib/portal/shareCard.ts b/src/lib/portal/shareCard.ts
