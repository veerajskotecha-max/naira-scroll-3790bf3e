@@ -0,0 +1,168 @@
+/*
+  Your stone: her seed ceremony, the date field's page and the specimen
+  card. Imported only by the Stone room, so it ships in that room's own
+  chunk and the garden home never downloads it. Loaded after members.css,
+  whose shared rules (buttons, type, the date field, a piece's price and stock) it builds on.
+*/
+
+.ig-stone-page {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-seed-soil { fill: none; stroke: var(--nf-accent); stroke-width: 1; }
+.ig-seed-naira > svg,
+.ig-seed-stone > svg,
+.ig-seed-drop > svg { display: block; width: 100%; height: 100%; overflow: visible; }
+
+/* ── your stone ─────────────────────────────────────── */
+.ig-seed { position: relative; width: 100%; max-width: 420px; aspect-ratio: 390 / 320; margin: 1rem auto 0; }
+.ig-seed-ground { position: absolute; inset: 0; width: 100%; height: 100%; }
+.ig-seed-naira,
+.ig-seed-stone { position: absolute; transform-origin: 50% 100%; }
+.ig-seed-drop { position: absolute; width: 3.1%; aspect-ratio: 12 / 17; }
+.ig-seed .ig-petal { z-index: 1; }
+.ig-skip {
+  position: absolute;
+  top: 0;
+  right: 0;
+  min-height: 44px;
+  padding: 0 0.9rem;
+  border: 1px solid var(--ig-gold-line);
+  background: rgb(var(--nf-ivory-rgb) / 0.92);
+  font-family: var(--nf-font-label);
+  font-size: 10.5px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: var(--nf-ink);
+  cursor: pointer;
+}
+.ig-seed-caption {
+  margin: 0.25rem 0 0;
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 1.04rem;
+  line-height: 1.5;
+  color: rgb(var(--nf-ink-rgb) / 0.74);
+}
+.ig-card3d { width: min(100%, 340px); margin: 0 auto; perspective: 1400px; }
+.ig-card-inner {
+  display: grid;
+  transform-style: preserve-3d;
+  transition: transform 0.8s cubic-bezier(0.32, 0.72, 0, 1);
+}
+.is-flipped .ig-card-inner { transform: rotateY(180deg); }
+.ig-face {
+  position: relative;
+  grid-area: 1 / 1;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.6rem;
+  width: 100%;
+  padding: 1.5rem 1.3rem 1.2rem;
+  border: 1px solid var(--ig-gold-line);
+  outline: 1px solid rgb(var(--nf-gold-rgb) / 0.3);
+  outline-offset: -9px;
+  background: var(--ig-vellum);
+  box-shadow: 0 22px 44px -30px rgb(122 90 40 / 0.55);
+  color: inherit;
+  font: inherit;
+  text-align: center;
+  -webkit-backface-visibility: hidden;
+  backface-visibility: hidden;
+}
+.ig-face--front { justify-content: space-between; cursor: pointer; touch-action: pan-y; user-select: none; -webkit-tap-highlight-color: transparent; }
+.ig-face--back { transform: rotateY(180deg); }
+.ig-corner { position: absolute; width: 78px; height: 78px; pointer-events: none; }
+.ig-corner--tl { top: -4px; left: -4px; transform: scaleX(-1); }
+.ig-corner--br { right: -4px; bottom: -4px; transform: scaleY(-1); }
+.ig-specimen-no {
+  font-family: var(--nf-font-label);
+  font-size: 10px;
+  letter-spacing: var(--nf-track-28);
+  text-transform: uppercase;
+  color: var(--nf-gold-text);
+}
+.ig-specimen-label { display: block; width: 100%; border-top: 1px solid var(--ig-gold-line); }
+.ig-specimen-row {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 1rem;
+  padding: 0.5rem 0.2rem;
+  border-bottom: 1px solid var(--ig-line);
+}
+.ig-specimen-row span:first-child {
+  flex: none;
+  font-family: var(--nf-font-label);
+  font-size: 10.5px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.68);
+}
+.ig-specimen-row span:last-child { font-family: var(--nf-font-editorial); font-size: 1.12rem; line-height: 1.25; text-align: right; }
+.ig-specimen-note { font-family: var(--nf-font-editorial); font-style: italic; font-size: 1.02rem; color: rgb(var(--nf-ink-rgb) / 0.72); }
+.ig-turn {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.4rem;
+  font-family: var(--nf-font-label);
+  font-size: 10.5px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: var(--nf-gold-text);
+}
+.ig-back-photo { display: block; width: 72%; aspect-ratio: 1; margin: 0 auto; object-fit: cover; background: var(--nf-surface-raised); }
+.ig-back-wait { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; width: 100%; }
+.ig-facts {
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  font-family: var(--nf-font-label);
+  font-size: 11.5px;
+  line-height: 1.55;
+  color: rgb(var(--nf-ink-rgb) / 0.66);
+}
+.ig-months { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin: 1rem 0 0; padding: 0; list-style: none; }
+.ig-month {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  width: 100%;
+  min-height: 68px;
+  border: 1px solid var(--ig-line);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.75);
+  cursor: pointer;
+}
+.ig-month[aria-pressed="true"] { border-color: var(--nf-accent-strong); background: var(--ig-vellum); color: var(--nf-ink); }
+.ig-month-own {
+  margin-top: -2px;
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 12px;
+  letter-spacing: 0;
+  text-transform: none;
+  color: var(--nf-gold-text);
+}
+
+@media (min-width: 768px) {
+  .ig-months { grid-template-columns: repeat(6, 1fr); }
+  .ig-stone-page { padding-top: 2rem; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ig-card-inner { transition: none; }
+}
diff --git a/src/pages/members/vault.css b/src/pages/members/vault.css
new file mode 100644
index 0000000..6999f04
--- /dev/null
+++ b/src/pages/members/vault.css
@@ -0,0 +1,26 @@
+/* /members/vault: the pressed-flower wall. Imported only by Vault.tsx. */
+
+.ig-vault {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-wall { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.6rem 1rem; width: 100%; margin: 2rem 0 0; padding: 0; list-style: none; }
+.ig-wall-link { display: block; color: inherit; text-decoration: none; }
+.ig-wall-link:focus-visible { outline: 1px solid var(--nf-accent-strong); outline-offset: 4px; }
+.ig-vault-empty { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-vault-frame { display: flex; justify-content: center; width: 150px; padding: 22px 0; margin-bottom: 0.6rem; outline: 1px solid var(--ig-gold-line); outline-offset: -6px; box-shadow: inset 0 0 0 1px var(--ig-gold-line); }
+/* Hung by hand: each frame on a short gold thread, a little off true, alternately. */
+.ig-wall > li::before { content: ""; display: block; width: 1px; height: 14px; margin: 0 auto; background: var(--ig-gold-line); }
+.ig-wall .ig-herb-sheet { transform: rotate(-0.8deg); transform-origin: 50% 0; }
+.ig-wall > li:nth-child(even) .ig-herb-sheet { transform: rotate(0.8deg); }
+.ig-vault-joy { margin-top: 2.2rem; }
+
+@media (min-width: 768px) {
+  .ig-vault { padding-top: 2rem; }
+  .ig-wall { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
