+                      </span>
+                      <span className="ig-glist-band">{bandLabel(g.b)}</span>
+                    </button>
+                    <span className="ig-glist-actions">
+                      <button type="button" className={quietButton} onClick={() => setEditing(g)} aria-label={`Change ${g.n}`}>
+                        Change
+                      </button>
+                      <button type="button" className={quietButton} onClick={() => remove(g)} aria-label={`Remove ${g.n}`}>
+                        Remove
+                      </button>
+                    </span>
+                  </li>
+                ),
+              )}
+            </ul>
+          )}
+
+          {full ? (
+            <p className="ig-fineprint ig-gfull">Eight dates are kept at most. Remove one to add another.</p>
+          ) : adding ? (
+            <OccasionForm onSave={add} onCancel={gifts.length ? () => setAdding(false) : undefined} />
+          ) : (
+            <button type="button" className={outlineButton} onClick={() => setAdding(true)}>
+              Add a date
+            </button>
+          )}
+          <p className="ig-fineprint ig-gprivacy">
+            Each date is kept on your account with your sign-in: its short name, its day and month, and its budget. Nothing else about the person is kept, and you can change or remove a date here at any time.
+          </p>
+        </section>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Gifts;
