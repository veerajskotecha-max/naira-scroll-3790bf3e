+              <ul className="ig-pcs">
+                {picks.map(({ piece, preset }) => (
+                  <li key={piece.handle}>
+                    <PieceCard piece={piece} preset={preset} preview={preview} bagBusy={bagBusy} onAdd={addToBag} note={bandLabel(gift.b)} />
+                  </li>
+                ))}
+              </ul>
+            ) : (
+              <p className="ig-fineprint" role={isLoading ? "status" : undefined}>
+                {isLive ? "Nothing in stock in this budget right now." : isLoading ? "Reading today's prices from the shop…" : "We couldn't reach the shop just now."}
+              </p>
+            )}
+            <Link className={textLink} to={`/jewellery?under=${gift.b}`}>
+              Everything {bandLabel(gift.b).toLowerCase()}
+            </Link>
+
+            <h3 className="ig-gcard-h3">A reminder, every year</h3>
+            <p className="ig-fineprint">In your own calendar, a week before {giftDay(gift)}.</p>
+            <GiftReminder gift={gift} now={now} />
+          </section>
+        )}
