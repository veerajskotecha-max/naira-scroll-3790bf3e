+/*
+  Her account's memory: user_metadata.naira, the portal's own corner of the
+  sign-in account's metadata (no table, no migration). It keeps what makes
+  the portal hers on any phone: her ring size and metal, the pieces she
+  saved (handles only), the drop flowers she pressed, her month when she
+  would rather not give a whole birthday, and the IST day she was last here.
+  Exactly the plan's shape (plan.data_model, 1): nothing else is kept, and
+  all of it waits on the owner's approval of keeping it in the account's
+  metadata.
+
+  - Namespaced. Supabase merges metadata one top-level key at a time, and a
+    Google sign-in merges its own claims (name, picture, email) the same way,
+    so everything lives under one key, `naira`, that no provider sends. A
+    write sends `{ naira }` alone and never touches her name or picture.
+  - Read, modify, write. The whole `naira` object is read fresh from the
+    account, changed, and written back, so a change made on another phone in
+    the meantime is kept. Keys this version does not know are kept as they are.
+  - Small. It rides in every access token and in the stored session, so it
+    is capped at 1.2 KB: past that the oldest saved handles go first, and a
+    write that still does not fit is refused. Gifts are never trimmed
+    silently: a ninth is refused with a message.
+  - A null in a change deletes that key.
+  - Her own data, which she can see and change: it never gates, prices, ranks
+    or redeems anything. Keepsakes read from it are for joy only.
+*/
+
+export const META_KEY = "naira";
+export const META_CAP_BYTES = 1200;
+export const MAX_SAVED = 24;
+export const MAX_PRESSED = 24;
+/** Front Row marks kept (the newest): the keepsake needs one, so the list stays short. */
+export const MAX_FRONT = 6;
+export const MAX_GIFTS = 8;
+export const WRITE_DELAY_MS = 800;
+
+export type UsSize = 5 | 6 | 7 | 8 | 9;
+/** How she found her size: the sizer on her screen, a thread, or she knew it. */
+export type RingHow = "s" | "t" | "k";
+export type Ring = { us: UsSize; how: RingHow; /** IST day, "2026-11-05". */ at: string };
+/** Gold, silver or both. */
+export type Metal = "g" | "s" | "b";
+/** A gift date (Phase 4): a short name (12 characters or fewer), a day and month, and a budget band from the Gifting page. */
+export type Gift = { n: string; m: number; d: number; b: 1000 | 1500 | 2500 };
+/** The Gifting page's own bands, in rupees (its "Under 1,000", "Under 1,500" and "Under 2,500"), in its order. */
+export const GIFT_BANDS = [1000, 1500, 2500] as const;
+export type Naira = {
+  v: 1;
+  ring?: Ring;
+  metal?: Metal;
+  /** Her birth month, 1 to 12, kept only when she gives a month without a whole birthday (a birthday on her profile comes first). */
+  month?: number;
+  /** Handles, oldest first. */
+  saved: string[];
+  /** Drop ids, oldest first. */
+  pressed: string[];
+  /** Drops she opened and pressed in their first hour (always also in `pressed`; the newest six). */
+  front: string[];
+  gifts: Gift[];
+  /** The last IST day she came (written at most once an IST day). */
+  seen?: { last: string };
+  /** Play (Phase 6), one small integer, 1 to 63, absent when 0: the Naira flower's five pieces she found in her rooms (bits 0 to 4) and her month's flower written in her garden's stars (bit 5). See petals.ts. Anything else is dropped as she reads it. */
+  p?: number;
+  /** Keys a later version wrote: kept untouched. */
+  [key: string]: unknown;
+};
+
+export type MetaPatch = { [key: string]: unknown };
+export type Updater = (naira: Naira) => Naira;
+/** A change kept, with the saved handles it let go (a 25th piece pushing out the oldest, or the 1.2 KB cap). */
+/** `dropped`: what left her saved list with the change; `trimmed`: of those, the ones the 1.2 KB cap alone let go (oldest first). */
+export type MetaResult = { ok: true; dropped?: readonly string[]; trimmed?: readonly string[] } | { ok: false; message: string };
+
+const DAY = /^\d{4}-\d{2}-\d{2}$/;
+/** A piece's handle or a drop's id, as her account keeps them. */
+export const HANDLE = /^[a-z0-9][a-z0-9-]{0,95}$/;
+const SIZES: readonly number[] = [5, 6, 7, 8, 9];
+const KNOWN = new Set(["v", "ring", "metal", "month", "saved", "pressed", "front", "gifts", "seen", "p"]);
+/** The play number's largest value: six bits (petals.ts names them). `,"p":63` is seven bytes. A later
+    version that wants a seventh bit ships a reader that keeps it before any writer sets it. */
+export const PLAY_MAX = 63;
+
+const isObject = (x: unknown): x is Record<string, unknown> => Boolean(x) && typeof x === "object" && !Array.isArray(x);
+
+/** The newest `max` distinct valid strings, oldest first. */
+const list = (raw: unknown, valid: RegExp, max: number): string[] => {
+  if (!Array.isArray(raw)) return [];
+  const out: string[] = [];
+  for (const item of raw) if (typeof item === "string" && valid.test(item) && !out.includes(item)) out.push(item);
+  return out.slice(-max);
+};
+
+const ringOf = (raw: unknown): Ring | undefined => {
+  if (!isObject(raw)) return undefined;
+  const us = Number(raw.us);
+  if (!SIZES.includes(us) || !["s", "t", "k"].includes(raw.how as string) || typeof raw.at !== "string" || !DAY.test(raw.at)) return undefined;
+  return { us: us as UsSize, how: raw.how as RingHow, at: raw.at };
+};
+
+/* The days a month can have (February's 29, for a leap-day birthday). */
+const MONTH_DAYS = [31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
+
+/** A label her account can keep: 12 characters or fewer, not blank, and no
+    control character or broken one, each of which JSON would write as six bytes. */
+export const giftLabelOk = (n: unknown): n is string => {
+  if (typeof n !== "string" || !n.trim() || n.length > 12) return false;
+  for (let i = 0; i < n.length; i++) {
+    const c = n.charCodeAt(i);
+    if (c < 0x20 || c === 0x7f) return false;
+    if (c >= 0xd800 && c <= 0xdbff) {
+      const next = n.charCodeAt(i + 1);
+      if (!(next >= 0xdc00 && next <= 0xdfff)) return false;
+      i++;
+    } else if (c >= 0xdc00 && c <= 0xdfff) return false;
+  }
+  return true;
+};
+
+const pad2 = (n: number) => String(n).padStart(2, "0");
+
+/*
+  A gift as it is written to her account: one short string, the month and
+  day, the band's place in GIFT_BANDS, then the label ("03141Mum": 14 March,
+  under 1,500 rupees, Mum). Eight of them with the longest labels (12 characters
+  of three bytes each) still fit beside a full Phase 3 memory under the
+  1.2 KB cap, which the object form ({ n, m, d, b }) would not. On screen,
+  and to every room, a gift is always the object; the object form is still
+  read, in case one was ever written that way.
+*/
+export const packGift = (g: Gift): string => `${pad2(g.m)}${pad2(g.d)}${GIFT_BANDS.indexOf(g.b)}${g.n}`;
+
+/** One gift date as her account keeps it, or null when it is not one. */
+export const giftOf = (raw: unknown): Gift | null => {
+  let gift: Record<string, unknown> | null = null;
+  if (typeof raw === "string") {
+    const at = /^(\d{2})(\d{2})([0-2])/.exec(raw);
+    if (at) gift = { n: raw.slice(5), m: Number(at[1]), d: Number(at[2]), b: GIFT_BANDS[Number(at[3])] };
+  } else if (isObject(raw)) gift = raw;
+  if (!gift) return null;
+  const { n, m, d, b } = gift;
+  if (!giftLabelOk(n)) return null;
+  if (!Number.isInteger(m) || (m as number) < 1 || (m as number) > 12) return null;
+  if (!Number.isInteger(d) || (d as number) < 1 || (d as number) > MONTH_DAYS[(m as number) - 1]) return null;
+  if (b !== 1000 && b !== 1500 && b !== 2500) return null;
+  return { n, m: m as number, d: d as number, b };
+};
+
+/** Her `naira` as the portal reads it: known keys checked (anything malformed is left out), unknown keys kept. */
+export const readNaira = (raw: unknown): Naira => {
+  const src = isObject(raw) ? raw : {};
+  const out: Naira = { v: 1, saved: [], pressed: [], front: [], gifts: [] };
+  for (const [key, value] of Object.entries(src)) if (!KNOWN.has(key)) out[key] = value;
+  const ring = ringOf(src.ring);
+  if (ring) out.ring = ring;
+  if (src.metal === "g" || src.metal === "s" || src.metal === "b") out.metal = src.metal;
+  if (Number.isInteger(src.month) && (src.month as number) >= 1 && (src.month as number) <= 12) out.month = src.month as number;
+  out.saved = list(src.saved, HANDLE, MAX_SAVED);
+  out.pressed = list(src.pressed, HANDLE, MAX_PRESSED);
+  out.front = list(src.front, HANDLE, MAX_PRESSED).filter((id) => out.pressed.includes(id)).slice(-MAX_FRONT);
+  out.gifts = (Array.isArray(src.gifts) ? src.gifts : []).map(giftOf).filter((g): g is Gift => g !== null).slice(0, MAX_GIFTS);
+  if (isObject(src.seen) && typeof src.seen.last === "string" && DAY.test(src.seen.last)) out.seen = { last: src.seen.last };
+  if (Number.isInteger(src.p) && (src.p as number) >= 1 && (src.p as number) <= PLAY_MAX) out.p = src.p as number;
+  return out;
+};
+
+/** What is written: empty lists left out, so a new member's metadata stays a few bytes, and each gift packed (packGift). */
+export const compactNaira = (naira: Naira): Record<string, unknown> => {
+  const out: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(naira)) {
+    if (value === undefined || (Array.isArray(value) && value.length === 0 && KNOWN.has(key))) continue;
+    out[key] = key === "gifts" && Array.isArray(value) ? (value as Gift[]).map(packGift) : value;
+  }
+  return out;
+};
+
+const utf8 = typeof TextEncoder === "undefined" ? null : new TextEncoder();
+
+/** UTF-8 bytes of the JSON written to her account (never throws, even on a broken character). */
+export const bytesOf = (naira: Naira): number => {
+  const json = JSON.stringify(compactNaira(naira));
+  if (utf8) return utf8.encode(json).length;
+  let n = 0;
+  for (const ch of json) {
+    const c = ch.codePointAt(0) ?? 0;
+    n += c < 0x80 ? 1 : c < 0x800 ? 2 : c < 0x10000 ? 3 : 4;
+  }
+  return n;
+};
+
+export const sameNaira = (a: Naira, b: Naira): boolean => JSON.stringify(compactNaira(a)) === JSON.stringify(compactNaira(b));
+
+export type Fitted = { ok: true; naira: Naira; trimmed: string[] } | { ok: false; message: string };
+
+/** Fits her `naira` under the cap, letting the oldest saved handles go first; refuses what still does not fit. */
+export const fitToCap = (naira: Naira, cap = META_CAP_BYTES): Fitted => {
+  let next = naira;
+  const trimmed: string[] = [];
+  while (bytesOf(next) > cap && next.saved.length > 0) {
+    trimmed.push(next.saved[0]);
+    next = { ...next, saved: next.saved.slice(1) };
+  }
+  if (bytesOf(next) > cap) return { ok: false, message: "Your account has no room for this just now. Please write to us on WhatsApp." };
+  return { ok: true, naira: next, trimmed };
+};
+
+/* ── the changes the portal makes ───────────────────── */
+
+/* As she arrives (today's visit, the flowers pressed on this phone), and in
+   a drop's room. What her other rooms change (her size and metal, her month
+   alone, her drawer, her gift dates) is roomChanges.ts, which only those
+   rooms' chunks carry. */
+
+/** A drop's flower pressed (once), and in its first hour, a Front Row keepsake too. Past 24 the oldest are let go. */
+export const pressInto = (dropId: string, early: boolean): Updater => (n) => {
+  if (!HANDLE.test(dropId)) return n;
+  const pressed = n.pressed.includes(dropId) ? n.pressed : [...n.pressed, dropId].slice(-MAX_PRESSED);
+  const front = early && !n.front.includes(dropId) ? [...n.front, dropId] : n.front;
+  if (pressed === n.pressed && front === n.front) return n;
+  return { ...n, pressed, front: front.filter((id) => pressed.includes(id)).slice(-MAX_FRONT) };
+};
+
+/** The device's pressed flowers, moved in on her first signed-in visit (oldest first, nothing pressed twice). */
+export const mergePressed = (ids: readonly string[]): Updater => (n) => ids.reduce((acc, id) => pressInto(id, false)(acc), n);
+
+/** Today's visit, written at most once per IST day: the same day returns the same object, so nothing is written. */
+export const touchSeen = (day: string): Updater => (n) => (!DAY.test(day) || n.seen?.last === day ? n : { ...n, seen: { last: day } });
+
+/* ── the day she was last here ──────────────────────── */
+
+export type LastVisit = { day: string; since: string | null };
+
+/**
+ * The day "Since you were last here" counts from. Her account says the last
+ * IST day she came; the first visit of a new day keeps that day as `since`
+ * on this device, so a second visit the same day still counts from it.
+ * Null on her very first visit, and on a second phone the same day (her
+ * account keeps only the last day, which by then is today). The drawer tells
+ * the two apart by firstVisit: the second says she was here earlier today.
+ */
+export const sinceFor = (seenLast: string | undefined, today: string, local: LastVisit | null | undefined): string | null => {
+  if (seenLast && seenLast < today) return seenLast;
+  if (local && local.day === today) return local.since;
+  return null;
+};
+
+/**
+ * Her first signed-in visit to the garden, when the arrival repair is
+ * offered: her account had no visit day at all as she arrived. A reload on
+ * this phone the same IST day is still that visit (`firstDay`, kept on this
+ * device); any later day, or another phone once a visit is written, is not.
+ * So the questions are offered on one day only, without the account keeping
+ * anything about them.
+ */
+export const firstVisit = (seenLast: string | undefined, today: string, firstDay: string | null | undefined): boolean =>
+  !seenLast || firstDay === today;
+
+/* ── the writer ──────────────────────────────────────── */
+
+type WriterOptions = {
+  /** The freshest `naira` from her account (read just before each write). */
+  load: () => Promise<Naira>;
+  /** Writes it; throws when the account would not take it. */
+  save: (naira: Naira) => Promise<void>;
+  delay?: number;
+  /** However often she changes things, what is waiting is written within this long. */
+  maxWait?: number;
+  /** A failed write is tried again after this long (doubling, to a minute), as well as on hide, leave and "Try again". */
+  retryAfter?: number;
+  onSettled?: (result: { ok: true; naira: Naira } | { ok: false; message: string }) => void;
+};
+
+export type MetaWriter = {
+  queue: (change: Updater) => void;
+  /** Writes what is waiting now (leaving the portal, a hidden tab, "Try again"). */
+  flush: () => Promise<void>;
+  pending: () => boolean;
+  dispose: () => void;
+};
+
+export const WRITE_MAX_WAIT_MS = 3000;
+export const RETRY_AFTER_MS = 5000;
+
+/**
+ * Changes are queued and written together 800 ms after the last one (and
+ * never more than 3 s after the first), read fresh from the account first. A
+ * failed write keeps its changes for the next try, which comes by itself
+ * after a pause; a write that changes nothing is never sent.
+ */
+export const createMetaWriter = ({ load, save, delay = WRITE_DELAY_MS, maxWait = WRITE_MAX_WAIT_MS, retryAfter = RETRY_AFTER_MS, onSettled }: WriterOptions): MetaWriter => {
+  let waiting: Updater[] = [];
+  let timer: ReturnType<typeof setTimeout> | null = null;
+  let running: Promise<void> | null = null;
+  let disposed = false;
+  let firstAt: number | null = null;
+  let backoff = retryAfter;
+
+  const clear = () => {
+    if (timer !== null) clearTimeout(timer);
+    timer = null;
+  };
+
+  const run = (): Promise<void> => {
+    clear();
+    if (running) return running.then(() => (waiting.length ? run() : undefined));
+    if (!waiting.length) return Promise.resolve();
+    const batch = waiting;
+    waiting = [];
+    firstAt = null;
+    type Settled = { ok: true; naira: Naira } | { ok: false; message: string };
+    running = (async (): Promise<Settled> => {
+      try {
+        const base = await load();
+        const next = batch.reduce((n, change) => change(n), base);
+        const fitted = fitToCap(next);
+        if (fitted.ok === false) return { ok: false, message: fitted.message };
+        if (!sameNaira(base, fitted.naira)) await save(fitted.naira);
+        return { ok: true, naira: fitted.naira };
+      } catch {
+        // Kept for the next try, ahead of anything queued since.
+        waiting = [...batch, ...waiting];
+        return { ok: false, message: "We couldn't reach your account just now." };
+      }
+    })().then((result) => {
+      running = null;
+      if (result.ok) backoff = retryAfter;
+      else if (waiting.length && !disposed && timer === null) {
+        // Tried again by itself, a little later each time.
+        timer = setTimeout(() => void run(), backoff);
+        backoff = Math.min(backoff * 2, 60_000);
+      }
+      onSettled?.(result);
+    });
+    return running;
+  };
+
+  return {
+    queue: (change) => {
+      if (disposed) return;
+      waiting.push(change);
+      const now = Date.now();
+      if (firstAt === null) firstAt = now;
+      clear();
+      timer = setTimeout(() => void run(), Math.max(0, Math.min(delay, maxWait - (now - firstAt))));
+    },
+    flush: () => (disposed ? Promise.resolve() : run()),
+    pending: () => waiting.length > 0 || running !== null,
+    dispose: () => {
+      disposed = true;
+      clear();
+    },
+  };
+};
