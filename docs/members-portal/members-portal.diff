+++ b/src/pages/members/Vault.tsx
@@ -0,0 +1,97 @@
+import { useEffect, useMemo, useRef } from "react";
+import { FlowerGlyph } from "@/components/portal/FlowerGlyph";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import HerbariumFrame from "@/components/portal/HerbariumFrame";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, textLink } from "@/components/portal/styles";
+import { byOpening, dropNumber, speciesIndex, timeOf, VAULT_AFTER_MS } from "@/lib/portal/dropPhase";
+import { formatIstDay, istMonthName } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import "./vault.css";
+
+/*
+  /members/vault: her pressed flowers and every drop that has rested, newest
+  first, as a wall of herbarium frames hung by hand. A flower she pressed is
+  here from the moment she pressed it, with the day; a drop that rested (14
+  days after it opened to everyone) without one is the same frame, gently
+  empty: "This one bloomed in October". Each opens to its room: the story,
+  and its pieces with live Available / Sold out. Pressed flowers are
+  keepsakes for joy, never points.
+*/
+
+const Vault = () => {
+  const { drops, pressed } = useMember();
+  const marks = useMemo(() => drops.map((d) => timeOf(d.everyoneFrom) + VAULT_AFTER_MS), [drops]);
+  const now = useServerNow(marks, drops.length > 0);
+  const kept = useMemo(
+    () => byOpening(drops).filter((d) => pressed.some((p) => p.id === d.id) || now >= timeOf(d.everyoneFrom) + VAULT_AFTER_MS).reverse(),
+    [drops, pressed, now],
+  );
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+
+  const emptyRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  // An empty Vault is a faint frame whose flower draws itself in once, in gold line.
+  const empty = kept.length === 0;
+  useEffect(() => {
+    if (!empty || stillMotion()) return;
+    emptyRef.current?.querySelectorAll("path, circle").forEach((line, i) => {
+      (line as SVGElement).style.strokeDasharray = "1 1";
+      play(line, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 1100, delay: 200 + i * 45, easing: EASE_REVEAL, fill: "backwards" });
+    });
+  }, [empty]);
+
+  return (
+    <PortalShell title="The Vault" description="The Vault: past drops in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-vault">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            The <em>Vault</em>
+          </h1>
+          <p className="ig-lede">Every flower you have pressed, and every drop that has bloomed. Newest first.</p>
+        </div>
+        {empty ? (
+          <section className="ig-section ig-vault-empty">
+            <div ref={emptyRef} className="ig-vault-frame" aria-hidden>
+              <FlowerGlyph species={4} accent="#E5B9A4" state="line" size={120} />
+            </div>
+            <p className="ig-fineprint">Nothing is in the Vault yet. A drop's flower is kept here once you press it, and every drop rests here after it has bloomed.</p>
+            <Link className={textLink} to="/members/drops">
+              See the drops
+            </Link>
+          </section>
+        ) : (
+          <ul className="ig-wall">
+            {kept.map((d) => {
+              const mine = pressed.find((p) => p.id === d.id);
+              return (
+                <li key={d.id}>
+                  <Link to={`/members/drops/${d.id}`} className="ig-wall-link">
+                    <HerbariumFrame
+                      species={speciesIndex(d.species)}
+                      accent={d.accent}
+                      pressed={Boolean(mine)}
+                      title={`Drop ${dropNumber(d, drops)} · ${d.title}`}
+                      note={mine ? (mine.on ? `pressed ${formatIstDay(`${mine.on}T12:00:00+05:30`)}` : "pressed") : `This one bloomed in ${istMonthName(d.membersFrom)}`}
+                      size={130}
+                    />
+                  </Link>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+        <p className="ig-fineprint ig-vault-joy">Pressed flowers are keepsakes for joy. Not points, never redeemable.</p>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Vault;
diff --git a/src/pages/members/card.css b/src/pages/members/card.css
new file mode 100644
index 0000000..b9a3076
--- /dev/null
+++ b/src/pages/members/card.css
@@ -0,0 +1,109 @@
+/* /members/card: her garden card. Imported only by Card.tsx. Radius 0; the finished picture fades in (opacity) and nothing else moves. */
+
+.ig-cardroom {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-cardroom .ig-lede { text-wrap: balance; }
+
+/* The card's shape at phone size, its art painted at once; the finished PNG is laid over it. */
+.ig-cardroom-stage { position: relative; display: flex; flex-direction: column; align-items: center; width: 100%; margin-top: 1.5rem; }
+.ig-cardroom-paper,
+.ig-cardroom-png { width: min(100%, 300px); aspect-ratio: 9 / 16; }
+.ig-cardroom-paper {
+  position: relative;
+  background: var(--nf-ivory);
+  box-shadow: 0 18px 34px -26px rgb(122 90 40 / 0.6), 0 0 0 1px var(--ig-line);
+}
+.ig-cardroom-paper::before,
+.ig-cardroom-paper::after { content: ""; position: absolute; pointer-events: none; }
+.ig-cardroom-paper::before { inset: 2.5%; border: 1px solid var(--nf-accent-strong); }
+.ig-cardroom-paper::after { inset: 3.4%; border: 1px solid var(--ig-gold-line); }
+.ig-cardroom-art { position: absolute; left: 9.4%; top: 18.2%; width: 81.2%; height: 65.6%; overflow: visible; }
+.ig-cardroom-art--flower { left: 22%; top: 26%; width: 56%; height: 45%; }
+.ig-cardroom-png {
+  position: absolute;
+  top: 0;
+  left: 50%;
+  display: block;
+  height: auto;
+  transform: translateX(-50%);
+  -webkit-touch-callout: default;
+}
+.ig-cardroom-status {
+  margin: 1.1rem 0 0;
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.64);
+}
+.ig-cardroom-actions { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; width: 100%; margin-top: 1.25rem; }
+.ig-cardroom-actions .ig-cardroom-status { margin-top: 0; }
+
+/* Her choices: the art, and her name (off until she adds it). */
+.ig-cardroom-choices { display: flex; flex-direction: column; gap: 1rem; width: 100%; max-width: 360px; margin-top: 1.75rem; text-align: left; }
+.ig-cardroom-pick { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; border: 0; }
+.ig-cardroom-pick legend { width: 100%; margin-bottom: 0.6rem; }
+.ig-cardroom-chip { position: relative; display: inline-flex; }
+.ig-cardroom-chip input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: pointer; }
+.ig-cardroom-chip span {
+  display: inline-flex;
+  align-items: center;
+  min-height: 44px;
+  padding: 0 0.9rem;
+  border: 1px solid var(--ig-gold-line);
+  background: var(--ig-vellum);
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: var(--nf-ink);
+}
+.ig-cardroom-chip input:checked + span { border-color: var(--nf-ink); background: var(--nf-ink); color: var(--nf-ivory); }
+.ig-cardroom-chip input:focus-visible + span { outline: 1px solid var(--nf-accent-strong); outline-offset: 3px; }
+.ig-cardroom-toggle {
+  display: flex;
+  align-items: center;
+  gap: 0.7rem;
+  min-height: 44px;
+  font-family: var(--nf-font-editorial);
+  font-size: 1.12rem;
+  cursor: pointer;
+}
+.ig-cardroom-toggle input { flex: none; width: 20px; height: 20px; margin: 0; accent-color: var(--nf-accent-strong); }
+.ig-cardroom-toggle em { color: var(--nf-gold-text); }
+
+/* The open image: the picture alone, to press and hold and save. Under the header (z-50) and the bag; above the garden path. */
+.ig-cardroom-open {
+  position: fixed;
+  inset: 0;
+  z-index: 40;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.6rem;
+  padding: 123px 16px 2rem;
+  overflow-y: auto;
+  background: var(--nf-ivory);
+  text-align: center;
+}
+.ig-cardroom-open .ig-h2:focus { outline: none; }
+.ig-cardroom-big {
+  display: block;
+  width: min(100%, 420px, (100svh - 280px) * 0.5625);
+  height: auto;
+  box-shadow: 0 0 0 1px var(--ig-line);
+  -webkit-touch-callout: default;
+  user-select: auto;
+}
+
+@media (min-width: 768px) {
+  .ig-cardroom { padding-top: 2rem; }
+  .ig-cardroom-open { padding-top: 144px; }
+}
diff --git a/src/pages/members/care.css b/src/pages/members/care.css
new file mode 100644
index 0000000..42b0eab
--- /dev/null
+++ b/src/pages/members/care.css
@@ -0,0 +1,84 @@
+/* /members/care: Care. Imported only by Care.tsx (the atelier's card brings its own sheet). */
+
+.ig-care {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-care .ig-lede { text-wrap: balance; }
+.ig-care-quote {
+  margin: 0.7rem 0;
+  padding: 0.2rem 0 0.2rem 1rem;
+  border-left: 1px solid var(--nf-accent);
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 1.15rem;
+  line-height: 1.5;
+}
+
+/* the ritual */
+.ig-ritual { display: flex; flex-direction: column; align-items: center; margin-top: 1rem; }
+.ig-ritual-stage { position: relative; display: flex; justify-content: center; width: 100%; max-width: 360px; padding: 1.2rem 0 0.6rem; border: 1px solid var(--ig-gold-line); background: var(--ig-vellum); overflow: hidden; }
+.ig-ritual-ring { position: relative; width: 132px; height: 172px; }
+.ig-ritual-shine,
+.ig-ritual-film,
+.ig-ritual-window { position: absolute; inset: 0; }
+.ig-ritual-shine { background: url("../../assets/naira-box-ring-sm.webp") center / contain no-repeat; }
+.ig-ritual-film {
+  background: #c9bfb2;
+  -webkit-mask: url("../../assets/naira-box-ring-sm.webp") center / contain no-repeat;
+  mask: url("../../assets/naira-box-ring-sm.webp") center / contain no-repeat;
+}
+.ig-ritual--silver .ig-ritual-shine { background-image: url("../../assets/naira-box-ring-sm-silver.webp"); }
+.ig-ritual--silver .ig-ritual-film {
+  -webkit-mask-image: url("../../assets/naira-box-ring-sm-silver.webp");
+  mask-image: url("../../assets/naira-box-ring-sm-silver.webp");
+}
+.ig-ritual-window { overflow: hidden; will-change: transform; }
+.ig-ritual-window .ig-ritual-film { will-change: transform; }
+.ig-ritual-cloth { position: absolute; left: -11px; top: -9px; pointer-events: none; will-change: transform, opacity; }
+.ig-ritual-cloth svg { display: block; }
+.ig-ritual-cloth-band { fill: rgb(var(--nf-ivory-rgb) / 0.82); }
+.ig-ritual-cloth-edge { fill: none; stroke: var(--nf-accent-strong); stroke-width: 1; }
+.ig-ritual-glint { position: absolute; left: 50%; top: 9%; margin-left: -13px; overflow: visible; }
+.ig-ritual-glint path { fill: #fff8ee; stroke: var(--nf-accent); stroke-width: 0.8; }
+.ig-ritual-caption { margin: 0.7rem 0 0; font-family: var(--nf-font-editorial); font-style: italic; font-size: 1.05rem; color: rgb(var(--nf-ink-rgb) / 0.75); }
+.ig-ritual-steps { display: grid; gap: 0.4rem; width: 100%; max-width: 360px; margin: 0.8rem 0 0; padding: 0; list-style: none; text-align: left; }
+.ig-ritual-step {
+  display: flex;
+  align-items: center;
+  gap: 0.75rem;
+  width: 100%;
+  min-height: 52px;
+  padding: 0.4rem 0.75rem;
+  border: 1px solid var(--ig-line);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 13px;
+  line-height: 1.4;
+  text-align: left;
+  color: rgb(var(--nf-ink-rgb) / 0.62);
+}
+button.ig-ritual-step { border-color: var(--nf-accent-strong); background: var(--ig-vellum); color: var(--nf-ink); cursor: pointer; }
+button.ig-ritual-step:focus-visible { outline: 2px solid var(--nf-accent-strong); outline-offset: 1px; }
+.is-done .ig-ritual-step { color: var(--nf-ink); border-color: var(--ig-gold-line); }
+.ig-ritual-no { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; border: 1px solid var(--nf-accent); font-size: 11px; color: var(--nf-gold-text); }
+.is-done .ig-ritual-no { background: var(--nf-blush); }
+
+/* her pieces */
+.ig-care-cards { display: grid; gap: 0.7rem; margin: 0; padding: 0; list-style: none; }
+.ig-care-card { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 0.9rem; padding: 0.75rem; border: 1px solid var(--ig-line); background: var(--ig-vellum); text-align: left; }
+.ig-care-photo { display: block; width: 96px; height: 96px; object-fit: cover; background: var(--nf-surface-raised); }
+.ig-care-body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
+.ig-care-name { margin: 0; font-family: var(--nf-font-editorial); font-weight: 400; font-size: 1.15rem; line-height: 1.2; }
+.ig-care-name a { display: inline-flex; align-items: center; min-height: 44px; color: inherit; text-decoration: none; }
+.ig-care-line { margin: 0; font-family: var(--nf-font-label); font-size: 12.5px; line-height: 1.55; color: rgb(var(--nf-ink-rgb) / 0.78); }
+.ig-care-line span { display: block; font-size: 10px; letter-spacing: var(--nf-track-20); text-transform: uppercase; color: var(--nf-gold-text); }
+
+@media (min-width: 768px) {
+  .ig-care { padding-top: 2rem; }
+}
diff --git a/src/pages/members/drawer.css b/src/pages/members/drawer.css
new file mode 100644
index 0000000..152e52d
--- /dev/null
+++ b/src/pages/members/drawer.css
@@ -0,0 +1,32 @@
+/* /members/drawer: the Jewel drawer. Imported only by Drawer.tsx (its cards bring their own sheet). */
+
+.ig-drawer {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-drawer .ig-section > .ig-fineprint + .ig-pcs { margin-top: 0.9rem; }
+.ig-drawer .ig-pcs + .ig-fineprint { margin-top: 1rem; }
+.ig-drawer .ig-lede { text-wrap: balance; }
+/* a kept card blooms from its own line */
+.ig-drawer .ig-pc { position: relative; }
+.ig-kept-note { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; min-height: 44px; margin: 0; font-family: var(--nf-font-label); font-size: 11px; letter-spacing: var(--nf-track-16); text-transform: uppercase; color: var(--nf-gold-text); }
+.ig-kept-note:focus { outline: none; }
+.ig-kept-note:focus-visible { outline: 2px solid var(--nf-accent-strong); outline-offset: 2px; }
+.ig-kept-note-more { flex-basis: 100%; font-size: 12px; letter-spacing: 0; text-transform: none; line-height: 1.5; color: rgb(var(--nf-ink-rgb) / 0.72); }
+/* a piece taken out: one line, with Undo, where its card was */
+.ig-drawer-out { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; margin: 0; padding: 0.5rem 0.75rem; border: 1px dashed var(--ig-line); font-family: var(--nf-font-label); font-size: 13px; color: rgb(var(--nf-ink-rgb) / 0.78); text-align: left; }
+/* the empty drawer, drawn in gold line */
+.ig-drawer-empty-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.6rem; text-align: center; }
+.ig-drawer-empty { width: 150px; height: auto; }
+.ig-drawer-empty path { fill: none; stroke: var(--nf-accent-strong); stroke-width: 1; stroke-linejoin: round; stroke-dasharray: 1 1; }
+.ig-drawer-empty .ig-drawer-empty-sprig { stroke: #99B4AF; }
+.ig-reason { font-family: var(--nf-font-editorial); font-style: italic; font-size: 1rem; color: var(--nf-gold-text); }
+
+@media (min-width: 768px) {
+  .ig-drawer { padding-top: 2rem; }
+}
diff --git a/src/pages/members/droproom.css b/src/pages/members/droproom.css
new file mode 100644
index 0000000..17b3e89
--- /dev/null
+++ b/src/pages/members/droproom.css
@@ -0,0 +1,164 @@
+/* A drop's room: rub the petals, the unboxing, the pieces and the press.
+   Imported only by DropRoom.tsx. Motion is transform and opacity only. */
+
+.ig-room {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 0.5rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-room-back { align-self: flex-start; margin-bottom: 0.4rem; text-decoration: none; }
+.ig-room-story {
+  max-width: 26rem;
+  margin: 0.35rem auto 0;
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 1.08rem;
+  line-height: 1.5;
+  color: rgb(var(--nf-ink-rgb) / 0.74);
+}
+.ig-room-clock { display: flex; flex-direction: column; align-items: center; }
+.ig-room-kept { display: flex; justify-content: center; }
+.ig-room-kept .ig-herb { width: min(76%, 280px); }
+
+/* rub the petals */
+.ig-reveal-wrap { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
+.ig-reveal {
+  position: relative;
+  width: 100%;
+  aspect-ratio: 1;
+  overflow: hidden;
+  border: 1px solid var(--ig-gold-line);
+  background: var(--nf-surface-raised);
+}
+.ig-reveal-img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.ig-reveal-canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; }
+/* Opaque (its colour is the canvas's ground, set inline): nothing of the teaser shows before Reveal. */
+.ig-reveal-cover { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; }
+.ig-reveal-hint {
+  position: absolute;
+  left: 50%;
+  bottom: 14px;
+  margin: 0;
+  padding: 6px 12px;
+  transform: translateX(-50%);
+  border: 1px solid var(--ig-gold-line);
+  background: rgb(var(--nf-ivory-rgb) / 0.9);
+  font-family: var(--nf-font-label);
+  font-size: 10px;
+  letter-spacing: var(--nf-track-24);
+  text-transform: uppercase;
+  white-space: nowrap;
+  pointer-events: none;
+}
+.ig-reveal-note { text-align: center; }
+
+/* the unboxing */
+.ig-unbox { position: relative; display: flex; flex-direction: column; align-items: center; margin-top: 1.4rem; overflow-x: clip; }
+.ig-unbox-stage { position: relative; display: flex; justify-content: center; padding-top: 30px; }
+.ig-unbox-petals { position: absolute; inset: 0; overflow: visible; pointer-events: none; }
+.ig-unbox-skip { position: absolute; top: 0; right: 0; min-width: 44px; padding-inline: 10px; }
+.ig-box { position: relative; user-select: none; }
+.ig-box-3d { transform-style: preserve-3d; }
+.ig-box-shadow {
+  position: absolute;
+  background: radial-gradient(ellipse at center, rgb(26 22 20 / 0.22), rgb(26 22 20 / 0) 68%);
+  pointer-events: none;
+}
+.ig-box-card {
+  position: absolute;
+  inset: 0;
+  display: block;
+  padding: 6%;
+  border: 1px solid rgb(var(--nf-gold-rgb) / 0.8);
+  background: #fffaf5;
+}
+.ig-box-card img { display: block; width: 100%; height: 100%; object-fit: cover; }
+
+/* the pieces */
+.ig-pieces { display: grid; gap: 0.9rem; width: 100%; }
+.ig-piece {
+  display: grid;
+  grid-template-columns: 38% 1fr;
+  gap: 0.9rem;
+  padding: 0.75rem;
+  border: 1px solid var(--ig-line);
+  background: var(--ig-vellum);
+  text-align: left;
+}
+.ig-piece-photo { display: block; align-self: start; aspect-ratio: 1; overflow: hidden; background: var(--nf-surface-raised); }
+.ig-piece-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.ig-piece-photo--blank { display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--nf-surface-raised), rgb(var(--nf-gold-rgb) / 0.12)); }
+.ig-piece-body { display: flex; flex-direction: column; align-items: flex-start; gap: 0.45rem; min-width: 0; }
+.ig-piece-name { margin: 0; font-family: var(--nf-font-editorial); font-weight: 400; font-size: 1.25rem; line-height: 1.2; }
+.ig-piece-name a { display: inline-block; padding: 6px 0; color: inherit; text-decoration: none; }
+.ig-piece .ig-price { justify-content: flex-start; font-size: 15px; }
+.ig-piece-opt { display: flex; flex-direction: column; gap: 0.2rem; width: 100%; }
+.ig-piece-opt span {
+  font-family: var(--nf-font-label);
+  font-size: 9.5px;
+  letter-spacing: var(--nf-track-20);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.62);
+}
+.ig-piece-opt select {
+  width: 100%;
+  height: 44px;
+  padding: 0 0.5rem;
+  border: 1px solid rgb(var(--nf-ink-rgb) / 0.25);
+  border-radius: 0;
+  background: var(--nf-ivory);
+  font-family: var(--nf-font-label);
+  font-size: 14px;
+  color: var(--nf-ink);
+}
+.ig-piece-actions { display: flex; flex-direction: column; gap: 0.4rem; width: 100%; }
+.ig-piece .ig-btn { height: 44px; font-size: 10.5px; }
+
+/* reserve, kinds, arriving */
+.ig-reserve { margin: 0.8rem 0 0; padding: 0; list-style: none; }
+/* Name over link, every row alike, whatever the name's length. */
+.ig-reserve li {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  padding: 0.45rem 0;
+  border-bottom: 1px solid var(--ig-line);
+  font-family: var(--nf-font-editorial);
+  font-size: 1.12rem;
+}
+.ig-kinds { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 1rem; }
+.ig-kind {
+  min-height: 44px;
+  padding: 0 0.9rem;
+  border: 1px solid var(--ig-line);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 10.5px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.75);
+  cursor: pointer;
+}
+.ig-kind[aria-pressed="true"] { border-color: var(--nf-accent-strong); background: var(--ig-vellum); color: var(--nf-ink); }
+.ig-arriving { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-arriving > .ig-h2 { border: 0; margin: 0.6rem 0 0; padding: 0; }
+
+/* press your flower */
+.ig-press { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-press > .ig-h2 { align-self: stretch; text-align: left; }
+.ig-press-stage { width: min(72%, 270px); margin-bottom: 1.1rem; }
+.ig-herb.is-waiting .ig-herb-flower { opacity: 0; }
+.ig-press .ig-herb.is-waiting .ig-herb-sheet { background: var(--ig-vellum); }
+.ig-press-bloom { position: absolute; inset: 11% 0; display: flex; justify-content: center; transform-origin: 50% 62%; }
+.ig-press-bloom svg { display: block; height: 100%; width: auto; overflow: visible; }
+.ig-press-note { max-width: 22rem; }
+
+@media (min-width: 768px) {
+  .ig-room { padding-top: 1.25rem; }
+  .ig-pieces { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .ig-piece { grid-template-columns: 1fr; }
+}
diff --git a/src/pages/members/drops.css b/src/pages/members/drops.css
new file mode 100644
index 0000000..c36d240
--- /dev/null
+++ b/src/pages/members/drops.css
@@ -0,0 +1,89 @@
+/* /members/drops: the drop calendar and New in the garden. Imported only by
+   Drops.tsx, so it ships in that room's own stylesheet. */
+
+.ig-drops {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-story {
+  max-width: 26rem;
+  margin: 0.2rem auto 0;
+  font-family: var(--nf-font-editorial);
+  font-style: italic;
+  font-size: 1.08rem;
+  line-height: 1.5;
+  color: rgb(var(--nf-ink-rgb) / 0.74);
+}
+
+/* the open drop */
+.ig-open-drop {
+  display: flex;
+  align-items: center;
+  gap: 0.9rem;
+  width: 100%;
+  margin-top: 1.8rem;
+  padding: 0.9rem 1rem;
+  border: 1px solid var(--ig-gold-line);
+  outline: 1px solid rgb(var(--nf-gold-rgb) / 0.28);
+  outline-offset: -7px;
+  background: var(--ig-vellum);
+  color: inherit;
+  text-align: left;
+  text-decoration: none;
+}
+.ig-open-art { flex: none; display: flex; }
+.ig-open-text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; }
+.ig-open-title { font-family: var(--nf-font-editorial); font-size: 1.7rem; line-height: 1.1; }
+.ig-open-story { font-family: var(--nf-font-editorial); font-style: italic; font-size: 1rem; line-height: 1.4; color: rgb(var(--nf-ink-rgb) / 0.72); }
+
+/* the next drop */
+.ig-next { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-next > .ig-h2 { align-self: stretch; text-align: left; }
+.ig-next-title {
+  display: flex;
+  flex-direction: column;
+  gap: 0.2rem;
+  margin: 1.4rem 0 0.2rem;
+  font-family: var(--nf-font-editorial);
+  font-size: 1.9rem;
+  line-height: 1.1;
+}
+
+/* nothing set yet */
+.ig-none { display: flex; flex-direction: column; align-items: center; text-align: center; }
+.ig-none > .ig-h2 { border: 0; padding: 0; margin: 0.9rem 0 0; }
+.ig-none-frame {
+  display: flex;
+  justify-content: center;
+  width: 132px;
+  padding: 1.1rem 0 0.6rem;
+  border: 1px solid var(--ig-gold-line);
+  outline: 1px solid rgb(var(--nf-gold-rgb) / 0.25);
+  outline-offset: -7px;
+}
+.ig-none-frame svg { opacity: 0.55; }
+
+/* new in the garden */
+.ig-shoots { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem 0.75rem; margin: 1rem 0 0; padding: 0; list-style: none; }
+.ig-shoot-card { display: flex; flex-direction: column; gap: 0.3rem; color: inherit; text-decoration: none; }
+.ig-shoot-photo { display: block; aspect-ratio: 1; overflow: hidden; background: var(--nf-surface-raised); }
+.ig-shoot-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
+.ig-shoot-when { display: flex; align-items: flex-end; gap: 0.3rem; margin-top: 0.15rem; }
+.ig-shoot { flex: none; width: 13px; height: 22px; }
+.ig-shoot path { fill: none; stroke: var(--nf-accent-strong); stroke-width: 1.1; stroke-dasharray: 1 1; }
+.ig-shoot path + path { fill: rgb(153 180 175 / 0.35); }
+.ig-shoot-name { font-family: var(--nf-font-editorial); font-size: 1.08rem; line-height: 1.25; }
+.ig-shoot-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.15rem 0.45rem; font-family: var(--nf-font-label); font-size: 13px; }
+.ig-shoot-price s { font-size: 11.5px; color: rgb(var(--nf-ink-rgb) / 0.6); }
+
+.ig-vault-link { width: 100%; margin-top: 2.5rem; text-align: left; }
+
+@media (min-width: 768px) {
+  .ig-drops { padding-top: 2rem; }
+  .ig-shoots { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+}
diff --git a/src/pages/members/fit.css b/src/pages/members/fit.css
