+import type { JewelPiece, JewelVariant } from "@/data/jewellery";
+import { QUANTITY_OFFERS } from "@/lib/promo";
+import { cartLineFor, choiceNeeded, choices, findVariant, initialChoice } from "@/lib/variants";
+import { familyOf, type Family } from "./family";
+import type { Preset } from "./fit";
+import type { Metal } from "./memberMeta";
+import { MONTH_OPTION, variantForMonth } from "./stonePiece";
+import { safeGet, safeSet } from "./safeStorage";
+
+/*
+  THE VANITY's model: necklaces laid on a drawn neckline, strictly by each
+  listing's own Length line, one against another.
+
+  A length is read only from the listing's own "Length:" details line, in
+  centimetres: "Approximately 46cm plus a 5cm extender" is 46 with a 5 cm
+  extender; "Approximately 40cm plus extender" is 40 with an extender whose
+  length the listing does not give (its words are kept, no tail is drawn).
+  A line still marked "(to confirm)", a length in millimetres, or no line at
+  all is not drawn: nothing is guessed.
+
+  The drawing: every chain leaves the neck at the same two points, where
+  the neck meets the shoulders, drapes out over the collarbones, and its
+  lowest point falls by half of each extra centimetre, so a longer chain
+  always hangs lower and two chains sit apart by half their difference.
+  Where one sits on her depends on her; the drawing says only how they sit
+  against each other. How a chain is drawn (fine, links, beads, a smooth
+  snake, a line of stones, pearl stations) is read from the listing's own
+  lines and name (chainKind): a style, never a claim.
+
+  The variant is her metal's where a piece comes in both, her month's on
+  the Birthstone Heart Necklace (lib/portal/fit's rule, copied here).
+
+  The look waits on this phone only (its own key, "naira-vanity"), never on
+  her account: at most three pieces. The shop's quantity offer is read from
+  lib/promo's QUANTITY_OFFERS, the bag's own ladder, never written here.
+*/
+
+export type Length = {
+  cm: number;
+  /** The extender's centimetres, when the listing gives them. */
+  ext: number | null;
+  /** The listing mentions an extender (with or without its length). */
+  extender: boolean;
+  /** The listing's length as a chip says it: "46 cm + 5 cm extender". */
+  words: string;
+};
+
+const CM = /(\d+(?:\.\d+)?)\s*cm\b/i;
+const EXT = /(\d+(?:\.\d+)?)\s*cm\s+extender/i;
+/* The lengths the drawing holds; anything outside is a listing to ask about, not to draw. */
+const MIN_CM = 25;
+const MAX_CM = 90;
+
+const fmt = (n: number) => String(Math.round(n * 10) / 10);
+
+/** A listing's "Length:" line (the words after the label), or null when it gives none to draw. */
+export const parseLength = (line: string | undefined | null): Length | null => {
+  const text = (line ?? "").replace(/^\s*Length:\s*/i, "").trim();
+  if (!text || /to confirm/i.test(text) || /\d\s*mm\b/i.test(text)) return null;
+  const m = CM.exec(text);
+  if (!m) return null;
+  const cm = Number(m[1]);
+  if (!(cm >= MIN_CM && cm <= MAX_CM)) return null;
+  const e = EXT.exec(text);
+  const listed = e && e.index > m.index ? Number(e[1]) : null;
+  // An extender's length is drawn (and said) only within what the drawing holds; past it, the extender is named without a number.
+  const ext = listed && listed > 0 && listed <= 20 ? listed : null;
+  const extender = /extender/i.test(text);
+  const words = `${fmt(cm)} cm${ext ? ` + ${fmt(ext)} cm extender` : extender ? " + extender" : ""}`;
+  return { cm, ext, extender, words };
+};
+
+/** A piece's length, from its own details. */
+export const lengthOf = (piece: Pick<JewelPiece, "details">): Length | null => parseLength((piece.details ?? []).find((l) => /^\s*Length:/i.test(l)));
+
+/* ── the drawing ────────────────────────────────────── */
+
+/** The glass's drawing: its viewBox, where every chain leaves the neck, and where a 30 cm chain's lowest point sits. */
+export const GLASS = { w: 300, h: 330, cx: 150, neckY: 121, span: 102, baseY: 150, baseCm: 30 } as const;
+/** A centimetre of chain, in the glass's units: a chain's lowest point falls by half of each extra one. */
+export const PX_PER_CM = 8.4;
+
+/** Where a chain of `cm` centimetres hangs lowest. */
+export const dropY = (cm: number): number => GLASS.baseY + ((cm - GLASS.baseCm) * PX_PER_CM) / 2;
+
+/* The left half of a chain's curve, as its four points (the right half is its mirror): out over the collarbone, then round to its lowest point. */
+const halfOf = (cm: number): [number, number][] => {
+  const y = dropY(cm);
+  const l = GLASS.cx - GLASS.span / 2;
+  const n = GLASS.neckY;
+  const deep = y - n;
+  return [
+    [l, n],
+    [l - 8, n + deep * 0.4],
+    [GLASS.cx - GLASS.span * 0.48, y],
+    [GLASS.cx, y],
+  ];
+};
+
+/** A chain's curve from one side of the neck round to the other, through its lowest point. */
+export const chainPath = (cm: number): string => {
+  const [[l, n], [ax, ay], [bx, y]] = halfOf(cm);
+  const m = (x: number) => 2 * GLASS.cx - x;
+  const f = (v: number) => v.toFixed(1);
+  return `M${f(l)} ${f(n)}C${f(ax)} ${f(ay)} ${f(bx)} ${f(y)} ${f(GLASS.cx)} ${f(y)}C${f(m(bx))} ${f(y)} ${f(m(ax))} ${f(ay)} ${f(m(l))} ${f(n)}`;
+};
+
+/** A point on a chain's left (or right) half, `t` of the way from the neck to its lowest point. */
+export const chainPoint = (cm: number, left: boolean, t: number): [number, number] => {
+  const p = halfOf(cm);
+  const k = [(1 - t) ** 3, 3 * (1 - t) ** 2 * t, 3 * (1 - t) * t * t, t ** 3];
+  const x = k.reduce((sum, c, i) => sum + c * p[i][0], 0);
+  const y = k.reduce((sum, c, i) => sum + c * p[i][1], 0);
+  return [left ? x : 2 * GLASS.cx - x, y];
+};
+
+/* How a chain is drawn, read from its listing's own lines and name: a style for the drawing, never a claim. */
+export type ChainKind = "fine" | "links" | "beads" | "smooth" | "stones" | "pearl";
+
+export const chainKind = (piece: Pick<JewelPiece, "name" | "details">): ChainKind => {
+  const lines = piece.details ?? [];
+  const line = (label: string) => lines.find((l) => new RegExp(`^\\s*${label}:`, "i").test(l)) ?? "";
+  const chain = line("Chain");
+  if (/tennis|rivi[eè]re|baguette/i.test(piece.name) || lines.some((l) => /linked directly to one another|set crosswise/i.test(l))) return "stones";
+  if (line("Pearl")) return "pearl";
+  if (/\bbeads?\b/i.test(chain)) return "beads";
+  if (/snake|serpentine/i.test(chain) || /serpentine/i.test(piece.name)) return "smooth";
+  if (/\blinks?\b|\boval\b|\bbox chain\b|paperclip/i.test(chain) || /toggle/i.test(line("Closure")) || /\blink\b|toggle|paperclip/i.test(piece.name)) return "links";
+  return "fine";
+};
+
+/** A bold chain (its listing says so): drawn a little heavier. */
+export const isBold = (piece: Pick<JewelPiece, "details">): boolean => (piece.details ?? []).some((l) => /^\s*Chain:.*\bbold\b/i.test(l));
+
+/* ── the pieces ─────────────────────────────────────── */
+
+export type VanityPiece = {
+  piece: JewelPiece;
+  length: Length;
+  /** Her metal and month chosen where the shop sells it that way, its live price and stock. */
+  preset: Preset;
+  variant?: JewelVariant;
+  metal: Family;
+  /** It hangs a pendant (the listing's own photo is drawn in a bezel on the chain). */
+  pendant: boolean;
+};
+
+const METAL_OPTION = /metal|colou?r|finish|tone/i;
+
+/** Gold or silver as it would be drawn: the chosen variant's own metal, else the listing's. */
+export const metalOf = (piece: JewelPiece, variant?: JewelVariant): Family => {
+  const value = variant ? Object.entries(variant.options).find(([name, v]) => METAL_OPTION.test(name) && /gold|silver|rhodium/i.test(v))?.[1] : undefined;
+  if (value) return /silver|rhodium/i.test(value) ? "silver" : "gold";
+  return familyOf(piece);
+};
+
+const PENDANT = /pendant|heart|bezel|drop|charm|solitaire|teardrop|lariat|clover/i;
+const METAL_WORD: Record<"g" | "s", RegExp> = { g: /gold/i, s: /silver|rhodium/i };
+
+/**
+ * A necklace as it would go in her bag: her metal where it comes in both,
+ * her month on the Birthstone Heart Necklace, else the page's opening
+ * choice; its live price and stock; and what is still hers to choose.
+ * lib/portal/fit's presetFor for a piece sold without a size, copied so
+ * this room never splits fit.ts (and the piece card with it) out of the
+ * chunk the Fit, Drawer and Gifts rooms share (vanity.test holds the two
+ * together over every necklace).
+ */
+export const necklacePreset = (piece: JewelPiece, metal: Metal | undefined, month: number | null): Preset => {
+  let chosen = initialChoice(piece);
+  const mo = choices(piece).find((o) => METAL_OPTION.test(o.name) && o.values.some((v) => /gold|silver|rhodium/i.test(v)))?.name;
+  if (mo && metal && metal !== "b") {
+    const value = piece.options?.find((o) => o.name === mo)?.values.find((v) => METAL_WORD[metal].test(v));
+    if (value) chosen = { ...chosen, [mo]: value };
+  }
+  if (month && chosen[MONTH_OPTION] !== undefined) {
+    const hers = variantForMonth(piece, month);
+    if (hers) chosen = { ...chosen, [MONTH_OPTION]: hers.options[MONTH_OPTION] };
+  }
+  const variant = piece.variants?.length ? findVariant(piece, chosen) : undefined;
+  const available = variant ? variant.availableForSale : piece.availableForSale;
+  const needs = choiceNeeded(piece) === "month" && !month ? "month" : choiceNeeded(piece) === "size" ? "size" : null;
+  return {
+    fit: { kind: "none", fits: available, sizesLeft: [], variant },
+    line: needs || !available ? null : cartLineFor(piece, variant),
+    needs,
+    price: variant?.price ?? piece.price,
+    compareAtPrice: variant ? variant.compareAtPrice : piece.compareAtPrice,
+    available,
+  };
+};
+
+/** A live necklace whose listing gives a firm length, as the vanity would draw it (null for any other piece). */
+export const vanityPiece = (piece: JewelPiece, metal: Metal | undefined, month: number | null, variantId?: string): VanityPiece | null => {
+  if (piece.category !== "Necklaces") return null;
+  const length = lengthOf(piece);
+  if (!length) return null;
+  const fitted = necklacePreset(piece, metal, month);
+  // The variant this phone kept for her look, while the shop still sells it; else her metal and month's.
+  const kept = variantId ? piece.variants?.find((v) => v.id === variantId) : undefined;
+  const variant = kept ?? fitted.fit.variant;
+  const chosen: Preset = kept ? { ...fitted, fit: { ...fitted.fit, variant: kept }, price: kept.price, compareAtPrice: kept.compareAtPrice, available: kept.availableForSale, line: kept.availableForSale ? cartLineFor(piece, kept) : null, needs: null } : fitted;
+  const pendant = PENDANT.test(piece.name) || (piece.details ?? []).some((l) => /^\s*Pendant:/i.test(l));
+  return { piece, length, preset: chosen, variant, metal: metalOf(piece, variant), pendant };
+};
+
+/**
+ * The tray: her saved necklaces with a firm length first, then every other
+ * live necklace whose listing gives one, in the shop's order, those the
+ * shop sells now ahead of those sold out (each chip says which).
+ */
+export const trayFor = (catalogue: readonly JewelPiece[], saved: readonly string[], metal: Metal | undefined, month: number | null): { drawer: VanityPiece[]; shop: VanityPiece[] } => {
+  const all = catalogue.map((p) => vanityPiece(p, metal, month)).filter((v): v is VanityPiece => v !== null);
+  const drawer = saved.map((h) => all.find((v) => v.piece.handle === h)).filter((v): v is VanityPiece => Boolean(v));
+  const rest = all.filter((v) => !drawer.includes(v));
+  return { drawer, shop: [...rest.filter((v) => v.preset.available), ...rest.filter((v) => !v.preset.available)] };
+};
+
+/** The look from the highest chain to the lowest. */
+export const highestFirst = <T extends { length: Length }>(look: readonly T[]): T[] => [...look].sort((a, b) => a.length.cm - b.length.cm);
+
+export const MAX_LOOK = 3;
+
+/* ── adding the look ────────────────────────────────── */
+
+/* Shopify tags some pieces "pre-order" (laidOut.ts's rule, copied so this room never splits that module out of the drawer's chunk): their pages sell them, a one-tap add beside others does not. */
+const isPreorder = (piece: JewelPiece) => (piece.tags ?? []).some((tag) => /^pre-?order$/i.test(tag.trim()));
+
+export type AddPlan =
+  | { kind: "add"; v: VanityPiece }
+  | { kind: "in-bag"; v: VanityPiece }
+  | { kind: "sold-out"; v: VanityPiece }
+  | { kind: "preorder"; v: VanityPiece }
+  | { kind: "choose"; v: VanityPiece };
+
+/** What "Add the look to your bag" does with each piece, in the look's order. */
+export const addPlan = (look: readonly VanityPiece[], inBag: (variantId: string) => boolean): AddPlan[] =>
+  look.map((v) => {
+    if (!v.preset.available) return { kind: "sold-out", v };
+    if (isPreorder(v.piece)) return { kind: "preorder", v };
+    const line = v.preset.line;
+    if (!line) return { kind: "choose", v };
+    return inBag(line.variantId) ? { kind: "in-bag", v } : { kind: "add", v };
+  });
+
+/* ── the shop's own offer, in words ─────────────────── */
+
+const NUMBER = ["no", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
+const count = (n: number) => NUMBER[n] ?? String(n);
+const pct = (rate: number) => `${Math.round(rate * 100)}%`;
+
+/** The bag's quantity offer as one line, its rates read from the ladder itself. */
+export const offerWords = (offers: readonly { minQuantity: number; rate: number }[] = QUANTITY_OFFERS): string | null => {
+  const rungs = [...offers].filter((o) => o.rate > 0 && o.minQuantity > 1).sort((a, b) => a.minQuantity - b.minQuantity);
+  if (!rungs.length) return null;
+  const parts = rungs.map((o, i) => (i === 0 ? `${count(o.minQuantity)} pieces take ${pct(o.rate)} off` : `${count(o.minQuantity)} take ${pct(o.rate)}`));
+  const said = parts.length > 1 ? `${parts.slice(0, -1).join(", ")} and ${parts[parts.length - 1]}` : parts[0];
+  return `In one bag, ${said}, at checkout. The bag applies it; no code needed.`;
+};
+
+/* ── the look on this phone ─────────────────────────── */
+
+export const VANITY_KEY = "naira-vanity";
+
+export type KeptLook = [handle: string, variantId: string][];
+
+/** Her look as this phone kept it, or empty (another member's, a broken or missing store). */
+export const readLook = (memberId: string): KeptLook => {
+  try {
+    const raw = JSON.parse(safeGet(VANITY_KEY) ?? "null") as { u?: unknown; h?: unknown } | null;
+    if (!raw || raw.u !== memberId || !Array.isArray(raw.h)) return [];
+    return raw.h
+      .filter((x): x is [string, string] => Array.isArray(x) && typeof x[0] === "string" && typeof x[1] === "string" && x[0].length <= 80 && x[1].length <= 80)
+      .slice(0, MAX_LOOK);
+  } catch {
+    return [];
+  }
+};
+
+/** Keeps her look on this phone (at most three pieces); false where the store refuses. */
+export const keepLook = (memberId: string, look: KeptLook): boolean => safeSet(VANITY_KEY, JSON.stringify({ u: memberId, h: look.slice(0, MAX_LOOK) }));
