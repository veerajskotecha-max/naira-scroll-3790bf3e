+  monsoon: ["Monsoon rain", ", in fine hairlines over the garden."],
+  holi: ["Colour for Holi", ": tap the garden for a puff of gulal.", ", soft on the ground."],
+};
+const NOTE_LIST = { margin: 0, padding: 0, display: "grid", gap: "0.6rem" } as const;
+
+/* The names on her gift dates, as said aloud: "Mum", "Mum and Didi", "Mum, Didi and Riya" (each once). */
+const namesSaid = (names: readonly string[]): string => {
+  const once = [...new Set(names)];
+  return once.length < 2 ? (once[0] ?? "") : `${once.slice(0, -1).join(", ")} and ${once[once.length - 1]}`;
+};
+
+/* The drop open now: whether its pieces are on the shop yet needs the live catalogue, read only here. */
+const OpenDropCard = ({ drop, now }: { drop: Drop; now: number }) => {
