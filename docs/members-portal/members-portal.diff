+import { istDayKey } from "./ist";
+import { DROP_SPECIES } from "./drops";
+
+/*
+  NOTES FROM THE ATELIER. Written by the owner; empty until she writes the
+  first one (one short note a month, if she likes, and none at all is fine).
+  Each shows on the garden home as a pressed flower she can tap open; with
+  none, the garden home has no such section and fetches nothing for it.
+
+  One note, for example (days in Indian time):
+
+    {
+      id: "nov-2026",
+      from: "2026-11-20",            // shown from this IST day
+      until: "2026-12-20",           // optional: and not after this one
+      title: "A word on the new pieces",
+      body: ["Two or three short lines.", "In the house's own voice."],
+      flower: "jasmine star",        // one of the garden's six species
+      accent: "#E8C88A",             // its colour (petals only)
+    }
+
+  A note is words only: never a price, a code, a count or a promise the shop
+  has not made (copy.test reads this file too). When the first note goes in,
+  delete the test "ships empty until the owner writes one" in notes.test.ts.
+*/
+
+/** One of the garden's six species, as a drop names its flower. */
+export type NoteFlower = (typeof DROP_SPECIES)[number];
+
+export type AtelierNote = {
+  id: string;
+  /** First IST day it is shown, "YYYY-MM-DD". */
+  from: string;
+  /** Optional last IST day it is shown, "YYYY-MM-DD". */
+  until?: string;
+  title: string;
+  /** A few short paragraphs. */
+  body: readonly string[];
+  flower: NoteFlower;
+  accent: string;
+};
+
+export const NOTES: readonly AtelierNote[] = [];
+
+/** The most notes the garden shows at once (the newest). */
+export const MAX_NOTES = 3;
+
+const DAY = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+
+/** A note the garden can show: an id, its IST days in order, a title of 60 characters or fewer, words, one of the six flowers and a #rrggbb colour (notes.test says what is wrong with one that is not). */
+export const readableNote = (n: AtelierNote): boolean =>
+  /^[a-z0-9-]+$/.test(n.id) &&
+  DAY.test(n.from) &&
+  (n.until === undefined || (DAY.test(n.until) && n.until >= n.from)) &&
+  n.title.trim().length > 0 &&
+  n.title.length <= 60 &&
+  n.body.length > 0 &&
+  n.body.every((p) => p.trim().length > 0) &&
+  DROP_SPECIES.includes(n.flower) &&
+  /^#[0-9a-f]{6}$/i.test(n.accent);
+
+/** The notes shown at `at`: readable, begun, not yet over, newest first, at most MAX_NOTES. */
+export const notesFor = (notes: readonly AtelierNote[], at: Date | number = Date.now()): AtelierNote[] => {
+  const today = istDayKey(at instanceof Date ? at : new Date(at));
+  return notes
+    .filter((n) => readableNote(n) && n.from <= today && (n.until === undefined || today <= n.until))
+    .sort((a, b) => (a.from < b.from ? 1 : a.from > b.from ? -1 : 0))
+    .slice(0, MAX_NOTES);
+};
