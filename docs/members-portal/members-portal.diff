+import { useEffect, useMemo, useRef } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import HerbariumFrame from "@/components/portal/HerbariumFrame";
+import KeepsakeFrame from "@/components/portal/KeepsakeFrame";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, textLink } from "@/components/portal/styles";
+import { byOpening, dropNumber, speciesIndex, timeOf } from "@/lib/portal/dropPhase";
+import { formatIstDay, istMonthName } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { keepsakesFor } from "@/lib/portal/keepsakes";
+import { stoneForMonth } from "@/lib/portal/stones";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import "./herbarium-room.css";
+
+/*
+  /members/herbarium: a frame for every drop that has opened to members,
+  filled with her pressed flower if she opened it during its members' window
+  (a flower is pressed in its room only then: MembersRoute's press and the
+  drop room both hold to inMembersWindow), and gently empty if not ("This
+  one bloomed in October"); then her four keepsakes,
+  each with what it was kept for. They are for joy, not points, never
+  redeemable: nothing here is ranked, compared or opens anything.
+
+  The first time the walls come into view, each frame's gold line draws
+  itself in (stroke-dashoffset only). Under reduced motion or Data Saver the
+  frames are simply there, filled, at first paint.
+*/
+
+const Herbarium = () => {
+  const { user, month, drops, pressed, naira } = useMember();
+  const marks = useMemo(() => drops.map((d) => timeOf(d.membersFrom)), [drops]);
+  const now = useServerNow(marks, drops.length > 0);
+  const bloomed = useMemo(() => byOpening(drops).filter((d) => now >= timeOf(d.membersFrom)).reverse(), [drops, now]);
+  const keepsakes = useMemo(() => keepsakesFor({ joinedAt: user.created_at, month, naira, drops }), [user.created_at, month, naira, drops]);
+  const stone = stoneForMonth(month);
+  const front = drops.find((d) => naira.front.includes(d.id));
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const roomRef = useRef<HTMLDivElement>(null);
+  const drawn = useRef(false);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  // The frames draw themselves in once, the first time they are in view.
+  useEffect(() => {
+    const room = roomRef.current;
+    if (!room || drawn.current || stillMotion() || typeof IntersectionObserver === "undefined") return;
+    const io = new IntersectionObserver(
+      (entries) => {
+        for (const entry of entries) {
+          if (!entry.isIntersecting) continue;
+          io.unobserve(entry.target);
+          entry.target.querySelectorAll(".ig-herb-frame rect").forEach((rect, i) =>
+            play(rect, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 900, delay: i * 70, easing: EASE_REVEAL, fill: "backwards" }),
+          );
+        }
+      },
+      { threshold: 0.2 },
+    );
+    room.querySelectorAll(".ig-hwall").forEach((wall) => io.observe(wall));
+    drawn.current = true;
+    return () => io.disconnect();
+  }, []);
+
+  return (
+    <PortalShell title="The Herbarium" description="Your pressed flowers and keepsakes in the Inner Garden, Naira Flore's members' portal.">
+      <div ref={roomRef} className="ig-herbarium">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            The <em>Herbarium</em>
+          </h1>
+          <p className="ig-lede">Your pressed flowers and your keepsakes, each kept for something you did.</p>
+        </div>
+
+        <section className="ig-section" aria-labelledby="ig-pressed">
+          <h2 id="ig-pressed" className="ig-h2">
+            Pressed flowers
+          </h2>
+          {bloomed.length === 0 ? (
+            <p className="ig-fineprint">
+              No drop has bloomed yet. When one does, its frame hangs here, and its flower is yours to press in its room while members see it first.{" "}
+              <Link className={textLink} to="/members/drops">
+                See the drops
+              </Link>
+            </p>
+          ) : (
+            <ul className="ig-hwall">
+              {bloomed.map((d) => {
+                const mine = pressed.find((p) => p.id === d.id);
+                return (
+                  <li key={d.id}>
