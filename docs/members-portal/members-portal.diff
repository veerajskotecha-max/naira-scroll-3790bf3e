+import { Suspense, lazy, useEffect, useLayoutEffect, useMemo, useRef, useState, type FormEvent, type RefObject } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import PieceCard from "@/components/portal/PieceCard";
+import FitsYou from "@/components/portal/FitsYou";
+import { FlowerGlyph } from "@/components/portal/FlowerGlyph";
+import { burstPetals } from "@/components/portal/PetalBurst";
+import { PETAL_HUE, PETAL_IDS } from "@/components/portal/PetalSymbols";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, primaryButton, quietButton, textLink } from "@/components/portal/styles";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import type { Metal, RingHow, UsSize } from "@/lib/portal/memberMeta";
+import { forgetMetal, forgetRing, keepMetal, keepRing } from "@/lib/portal/roomChanges";
+import { betweenSizesWhatsApp, outsideSizeWhatsApp, ringInSizeWhatsApp, sizeForCircumference, US_SIZES } from "@/lib/portal/sizer";
+import { presetFor, ringsFor } from "@/lib/portal/fit";
+import { formatIstDay, istDayKey } from "@/lib/portal/ist";
+import { serverNow } from "@/lib/portal/clock";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import "./fit.css";
+
+/*
+  /members/fit: her ring size and her metal, kept on her account so every
+  phone knows them, and the rings that fit her today. Three ways to a size:
+  the sizer on this screen (a card, then a ring she owns, its own chunk),
+  a thread and a ruler, or the size she already knows. Sizes outside US 5
+  to 9 are a conversation on WhatsApp. Keeping it opens a jasmine flower and
+  engraves "US 6 · kept"; her garden grows a ring of buds. She can forget
+  her size, and tap her metal again to have no preference.
+
+  The rings are the shop's, live: in her size and in stock now (Shopify's
+  availableForSale, nothing counted), and the open-back rings that adjust to
+  her. It is a guide, not a guarantee, and it promises nothing about
+  exchanges.
+*/
+
+const RingSizer = lazy(() => import("@/components/portal/RingSizer"));
+
+type Way = "screen" | "thread" | "known";
+const HOW: Record<RingHow, string> = { s: "Measured on your screen", t: "Measured with a thread", k: "As you told us" };
+const METALS: readonly { id: Metal; label: string }[] = [
+  { id: "g", label: "Gold" },
+  { id: "s", label: "Silver" },
+  { id: "b", label: "Both" },
+];
+const JASMINE = "#F1D9C6";
+/* The first rings shown in her size; the rest wait behind one quiet button, so the room stays short on a phone. */
+const FIRST_RINGS = 6;
+
+/* Her size, engraved. Kept just now, a jasmine flower (white, drawn in gold) opens over it and the words are cut in, letter by letter.
+   The box takes focus once kept, so a screen reader reads her size; the letters are drawn, and the words are said once, as text. */
+const Kept = ({ us, how, at, fresh, boxRef }: { us: number; how: RingHow; at: string; fresh: boolean; boxRef: RefObject<HTMLDivElement> }) => {
+  const words = `US ${us} · kept`;
+  useLayoutEffect(() => {
+    const root = boxRef.current;
+    if (!fresh || !root || stillMotion()) return;
+    play(root.querySelector(".ig-kept-bloom"), [{ opacity: 0, transform: "scale(.25) rotate(-24deg)" }, { opacity: 1, transform: "none" }], { duration: 760, easing: EASE_BLOOM, fill: "backwards" });
+    root.querySelectorAll(".ig-kept-letter").forEach((letter, i) =>
+      play(letter, [{ opacity: 0, transform: "translateY(3px)" }, { opacity: 1, transform: "none" }], { duration: 260, delay: 420 + i * 45, easing: EASE_REVEAL, fill: "backwards" }),
+    );
+    const rule = root.querySelector(".ig-kept-rule path");
+    play(rule, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 700, delay: 420, easing: EASE_REVEAL, fill: "backwards" });
+    const bloom = root.querySelector(".ig-kept-bloom")?.getBoundingClientRect();
+    const box = root.getBoundingClientRect();
+    if (bloom) burstPetals(root, bloom.left - box.left + bloom.width / 2, bloom.top - box.top + bloom.height * 0.35, { count: 16, spread: 110, ids: [PETAL_HUE, PETAL_IDS[2], PETAL_HUE, PETAL_IDS[5]], color: JASMINE, delay: 260 });
+  }, [fresh, boxRef]);
+  return (
+    <div ref={boxRef} className="ig-kept" tabIndex={-1}>
+      <span className="ig-kept-bloom" aria-hidden>
+        <FlowerGlyph species={2} accent={JASMINE} state="bloom" size={96} />
+        <FlowerGlyph species={2} accent={JASMINE} state="line" size={96} className="ig-kept-line" />
+      </span>
+      <p className="ig-kept-words">
+        <span className="sr-only">{words}</span>
+        {[...words].map((ch, i) => (
+          <span key={i} className="ig-kept-letter" aria-hidden>
+            {ch === " " ? " " : ch}
+          </span>
+        ))}
+      </p>
+      <svg className="ig-kept-rule" viewBox="0 0 160 6" aria-hidden>
+        <path d="M2 3H158" pathLength={1} />
+      </svg>
+      <p className="ig-fineprint">
+        {HOW[how]}, {formatIstDay(`${at}T12:00:00+05:30`)}. Kept on your account, so every phone you sign in on knows it.
+      </p>
+      {fresh && (
+        /* Two links, side by side where they fit and one above the other on a phone: no separator to be left alone on a line. */
+        <p className="ig-fineprint ig-kept-onward">
+          <Link className="ig-link" to="/members">
+            A ring of buds now grows in your garden
+          </Link>
+          <Link className="ig-link" to="/members/herbarium">
+            Fitted is in your Herbarium
+          </Link>
+        </p>
+      )}
+    </div>
+  );
+};
+
+const Thread = ({ onKeep }: { onKeep: (us: UsSize) => void }) => {
+  const [value, setValue] = useState("");
+  const [answer, setAnswer] = useState<ReturnType<typeof sizeForCircumference> | null>(null);
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    const mm = Number(value.replace(",", "."));
+    setAnswer(mm > 0 ? sizeForCircumference(mm) : null);
+  };
+  return (
+    <form className="ig-thread" onSubmit={submit}>
+      <ol className="ig-steps">
+        <li>Wrap a thread or a strip of paper snugly around the base of your finger.</li>
+        <li>Mark where it meets, then lay it flat along a ruler.</li>
+        <li>Write the length in millimetres.</li>
+      </ol>
+      <label htmlFor="ig-thread-mm" className="ig-eyebrow">
+        Length in millimetres
+      </label>
+      <input
+        id="ig-thread-mm"
+        className="ig-input"
+        type="number"
+        inputMode="decimal"
+        min="30"
+        max="90"
+        step="0.5"
+        value={value}
+        onChange={(e) => {
+          setValue(e.target.value);
+          setAnswer(null);
+        }}
+        placeholder="52"
+      />
+      <button type="submit" className={primaryButton} disabled={!value}>
+        Find my size
+      </button>
+      {answer?.kind === "size" && (
+        <div className="ig-answer" role="status">
+          <p className="ig-h2">US {answer.us}</p>
+          <button type="button" className={primaryButton} onClick={() => onKeep(answer.us)}>
+            Keep US {answer.us}
+          </button>
+        </div>
+      )}
+      {answer && answer.kind !== "size" && (
+        <div className="ig-answer" role="status">
+          <p className="ig-fineprint">
+            That is {answer.kind === "below" ? "smaller than US 5" : "larger than US 9"}, outside the shop's rings. Tell us on WhatsApp, and we'll tell you honestly what we can do.
+          </p>
+          <a className={primaryButton} href={outsideSizeWhatsApp(`${value} mm around`)} target="_blank" rel="noopener noreferrer">
+            Ask us on WhatsApp
+          </a>
+        </div>
+      )}
+    </form>
+  );
+};
+
+const Known = ({ current, onKeep }: { current: number | null; onKeep: (us: UsSize) => void }) => (
+  <div className="ig-known">
+    <ul className="ig-sizes" aria-label="US ring sizes">
+      {US_SIZES.map((us) => (
+        <li key={us}>
+          <button type="button" className="ig-size" aria-pressed={current === us} onClick={() => onKeep(us)}>
+            US {us}
+          </button>
+        </li>
+      ))}
+    </ul>
+    <a className={textLink} href={outsideSizeWhatsApp()} target="_blank" rel="noopener noreferrer">
+      Another size? Ask us on WhatsApp
+    </a>
+  </div>
+);
+
+const Fit = () => {
+  const { naira, changeMeta, metaProblem, retryMeta, month, addToBag, bagBusy, preview } = useMember();
+  const ring = naira.ring;
+  const metal = naira.metal;
+  const [way, setWay] = useState<Way | null>(null);
+  const [fresh, setFresh] = useState(false);
+  const [refused, setRefused] = useState<string | null>(null);
+  // Her own change this visit, so a failed write is spoken of only when it was hers.
+  const [changed, setChanged] = useState(false);
+  const [allRings, setAllRings] = useState(false);
+  // Each keep moves her to the result; forgetting moves her to the ways to find it again.
+  const [kept, setKept] = useState(0);
+  const [forgot, setForgot] = useState(0);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const keptRef = useRef<HTMLElement>(null);
+  const boxRef = useRef<HTMLDivElement>(null);
+  const waysRef = useRef<HTMLHeadingElement>(null);
+  const { jewellery, isLive, isLoading } = useLiveJewellery(Boolean(ring));
+  const rings = useMemo(() => (ring && isLive ? ringsFor(jewellery, ring.us, metal) : null), [ring, isLive, jewellery, metal]);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  const keep = (us: UsSize, how: RingHow) => {
+    const result = changeMeta(keepRing(us, how, istDayKey(new Date(serverNow()))));
+    if (result.ok === false) {
+      setRefused(result.message);
+      return;
+    }
+    setRefused(null);
+    setWay(null);
+    setFresh(true);
+    setChanged(true);
+    setKept((k) => k + 1);
+  };
+
+  /* The button she pressed has gone with its panel: focus goes to her kept size (read out as she lands on it). */
+  useEffect(() => {
+    if (!kept) return;
+    boxRef.current?.focus({ preventScroll: true });
+    keptRef.current?.scrollIntoView?.({ block: "center", behavior: stillMotion() ? "auto" : "smooth" });
+  }, [kept]);
+  useEffect(() => {
+    if (forgot) waysRef.current?.focus();
+  }, [forgot]);
+
+  const forget = () => {
+    if (changeMeta(forgetRing).ok === false) return;
+    setFresh(false);
+    setChanged(true);
+    setForgot((f) => f + 1);
+  };
+
+  return (
+    <PortalShell title="Your fit" description="Your ring size and metal in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-fit">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            Your <em>fit</em>
+          </h1>
+          <p className="ig-lede">Your ring size and your metal, kept on your account. A guide, not a guarantee.</p>
+        </div>
+
+        {ring && (
+          <section ref={keptRef} className="ig-section" aria-labelledby="ig-kept">
+            <h2 id="ig-kept" className="ig-h2">
+              Your ring size
+            </h2>
+            <Kept us={ring.us} how={ring.how} at={ring.at} fresh={fresh} boxRef={boxRef} />
+            <button type="button" className={`${quietButton} ig-fit-forget`} onClick={forget}>
+              Forget my size
+            </button>
+          </section>
+        )}
+
+        <section className="ig-section" aria-labelledby="ig-ways">
+          <h2 id="ig-ways" ref={waysRef} tabIndex={-1} className="ig-h2">
+            {ring ? "Measure again" : "Find your ring size"}
+          </h2>
+          <div className="ig-ways" role="group" aria-label="How to find your size">
+            {(
+              [
+                ["screen", "On this screen"],
+                ["thread", "With a thread"],
+                ["known", "I know my size"],
+              ] as const
+            ).map(([id, label]) => (
+              <button key={id} type="button" className="ig-way" aria-pressed={way === id} onClick={() => setWay(way === id ? null : id)}>
+                {label}
+              </button>
+            ))}
+          </div>
