@@ -0,0 +1,92 @@
+import { useState } from "react";
+import type { JewelPiece } from "@/data/jewellery";
+import { laidOutFor, reasonWords } from "@/lib/portal/laidOut";
+import { presetFor } from "@/lib/portal/fit";
+import type { Metal, UsSize } from "@/lib/portal/memberMeta";
+import type { BagLine } from "./MemberContext";
+import PieceCard from "./PieceCard";
+import FitsYou from "./FitsYou";
+import KeptNote from "./KeptNote";
+import { quietButton } from "./styles";
+
+/*
+  LAID OUT FOR YOU: up to six pieces that go with the ones she saved, each
+  with the shop's own reason (the same design, the same look, completes the
+  look, more like it), from the rows the product page shows. Live price and
+  availability, her size and month already chosen; Keep puts one in her
+  drawer. With nothing saved yet it says how the row fills, and shows nothing
+  made up.
+
+  The picks are laid out once for the visit: keeping one leaves its card
+  where it was, saying "Kept in your drawer", rather than the row re-forming
+  under her finger (a second tap there would keep a piece she never chose).
+*/
+
+type Props = {
+  saved: readonly string[];
+  catalogue: JewelPiece[];
+  us: UsSize | null;
+  metal: Metal | undefined;
+  month: number | null;
+  preview: boolean;
+  bagBusy: boolean;
+  onAdd: (line: BagLine) => Promise<boolean>;
+  onKeep: (handle: string) => void;
+  /** Pieces kept this visit, with what was let go to make room (or ""). */
+  kept: Readonly<Record<string, string>>;
+};
+
+const LaidOut = ({ saved, catalogue, us, metal, month, preview, bagBusy, onAdd, onKeep, kept }: Props) => {
+  const [picks] = useState(() => laidOutFor(saved, catalogue));
+  return (
+    <section className="ig-section" aria-labelledby="ig-laid">
+      <h2 id="ig-laid" className="ig-h2">
+        Laid out for you
+      </h2>
+      {picks.length === 0 ? (
+        <p className="ig-fineprint">
+          {saved.length ? "Nothing in the shop goes with your saved pieces just now." : "Keep a piece in your drawer, and what goes with it is laid out here."}
+        </p>
+      ) : (
+        <ul className="ig-pcs">
+          {picks.map((pick) => {
+            const preset = presetFor(pick.piece, us, metal, month);
+            return (
+              <li key={pick.piece.handle}>
+                <PieceCard
+                  piece={pick.piece}
+                  preset={preset}
+                  note={
+                    <>
+                      <span className="ig-reason">{reasonWords(pick)}</span>
+                      {pick.piece.category === "Rings" && (
+                        <>
+                          <br />
+                          <FitsYou fit={preset.fit} us={us} />
+                        </>
+                      )}
+                    </>
+                  }
+                  extra={(named) =>
+                    saved.includes(pick.piece.handle) ? (
+                      <KeptNote handle={pick.piece.handle} name={pick.piece.name} fresh note={kept[pick.piece.handle]} />
+                    ) : (
+                      <button type="button" className={quietButton} onClick={() => onKeep(pick.piece.handle)} aria-describedby={named}>
+                        Keep in my drawer
+                      </button>
+                    )
+                  }
+                  preview={preview}
+                  bagBusy={bagBusy}
+                  onAdd={onAdd}
+                />
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </section>
+  );
+};
+
+export default LaidOut;
diff --git a/src/components/portal/LookGlass.tsx b/src/components/portal/LookGlass.tsx
new file mode 100644
index 0000000..0e9b228
--- /dev/null
+++ b/src/components/portal/LookGlass.tsx
@@ -0,0 +1,206 @@
+import { useId, useLayoutEffect, useRef } from "react";
+import { shopifyImage } from "@/lib/shopifyImage";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { GLASS, chainKind, chainPath, chainPoint, dropY, isBold, type ChainKind, type VanityPiece } from "@/lib/portal/vanity";
+
+/*
+  The Vanity's looking-glass: an oval in a gold double hairline, vines up
+  its sides and a pressed rose at its crest; inside, on vellum, a single
+  ink line for a neckline and collarbones (no marks, no labels of the
+  body). Each chain she wears is drawn in its own metal, hung by its listed
+  length against the others (lib/portal/vanity's depth model), draped from
+  the neck out over the collarbones, in the style its listing names (a fine
+  chain, links, ball beads, a smooth snake, a line of stones, pearl
+  stations: vanity's chainKind), its pendant the listing's own photo in a
+  small round gold bezel. Its name sits beside the glass's edge, from the
+  highest chain down, alternately left and right, a hairline leading to it
+  from the chain's own curve. "Show extenders" adds each listed extender as
+  a dashed tail at its full reach.
+
+  Putting one on: it draws on from the clasp round to the centre (600 ms,
+  stroke-dashoffset), its links or stones fade in over it, it swings once
+  into its curve (one damped turn, 700 ms) and is still. Taking one off: a 250 ms fade. Under reduced motion each
+  is simply there, or gone. The glass is aria-hidden: the room's "Your
+  look" says it in words.
+*/
+
+export type Worn = { key: string; v: VanityPiece; leaving?: boolean };
+
+const GOLD = "#C99A4C";
+const SILVER = "#AEB3BA";
+const INK = "rgb(26 22 20 / 0.5)";
+const SWING = [0, 2.4, -1.5, 0.8, -0.3, 0];
+
+/* A name short enough to sit beside the chains inside the glass: its first two words, one above the other. */
+const short = (name: string) => name.replace(/\s+[—-]\s+.*$/, "").split(/\s+/).slice(0, 2);
+
+const IVORY = "#FFF8EE";
+/* Each style's line, in the glass's units (318 px wide on a phone): its weight tells the pieces apart. */
+const WEIGHT: Record<ChainKind, number> = { fine: 1.1, smooth: 1.7, links: 2.2, beads: 0.6, stones: 2.4, pearl: 1.1 };
+
+/* What lies over the metal line: a snake's sheen, links, ball beads, stones, or pearl stations (a fine chain is the line alone). */
+const Texture = ({ kind, d, colour, bold }: { kind: ChainKind; d: string; colour: string; bold: boolean }) => {
+  const dot = { fill: "none", strokeLinecap: "round" as const, d };
+  if (kind === "smooth") return <path d={d} fill="none" stroke={IVORY} strokeOpacity=".6" strokeWidth=".5" />;
+  if (kind === "links") return <path d={d} fill="none" stroke={IVORY} strokeOpacity=".75" strokeWidth={bold ? 1.1 : 0.8} strokeDasharray={bold ? "5.6 2.6" : "4.2 2.4"} />;
+  if (kind === "beads") return <path {...dot} stroke={colour} strokeWidth="2.8" strokeDasharray="0.01 3.6" />;
+  if (kind === "stones") return <path {...dot} stroke={IVORY} strokeWidth="1.3" strokeDasharray="0.01 3" />;
+  if (kind === "pearl")
+    return (
+      <>
+        <path {...dot} stroke={colour} strokeWidth="3.6" strokeDasharray="0.01 10" />
+        <path {...dot} stroke={IVORY} strokeWidth="2.6" strokeDasharray="0.01 10" />
+      </>
+    );
+  return null;
+};
+
+type Label = { left: boolean; y: number };
+
+const Chain = ({ w, label, extenders, clip, onGone }: { w: Worn; label: Label; extenders: boolean; clip: string; onGone: (key: string) => void }) => {
+  const ref = useRef<SVGGElement>(null);
+  const line = useRef<SVGPathElement>(null);
+  const texture = useRef<SVGGElement>(null);
+  const { v } = w;
+  const y = dropY(v.length.cm);
+  const colour = v.metal === "silver" ? SILVER : GOLD;
+  const { left, y: labelY } = label;
+  const lx = left ? 86 : GLASS.w - 86;
+  const photo = v.variant?.image ?? v.piece.cover ?? v.piece.image;
+  const kind = chainKind(v.piece);
+  const bold = isBold(v.piece);
+  const d = chainPath(v.length.cm);
+  // The leader leaves the chain's own curve on its side, clear of any pendant at the centre.
+  const [fx, fy] = chainPoint(v.length.cm, left, 0.6);
+  const [first, second] = short(v.piece.name);
+
+  useLayoutEffect(() => {
+    if (w.leaving || stillMotion()) return;
+    play(line.current, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 600, easing: EASE_REVEAL, fill: "backwards" });
+    play(texture.current, [{ opacity: 0 }, { opacity: 1 }], { duration: 300, delay: 450, easing: EASE_REVEAL, fill: "backwards" });
+    play(ref.current, SWING.map((r) => ({ transform: `rotate(${r}deg)` })), { duration: 700, delay: 600, easing: EASE_BLOOM });
+    // Once, as it goes on.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+  useLayoutEffect(() => {
+    if (!w.leaving) return;
+    const a = stillMotion() ? null : play(ref.current, [{ opacity: 1 }, { opacity: 0 }], { duration: 250, easing: EASE_REVEAL, fill: "forwards" });
+    if (!a) {
+      onGone(w.key);
+      return;
+    }
+    a.onfinish = () => onGone(w.key);
+    return () => {
+      a.onfinish = null;
+    };
+  }, [w.leaving, w.key, onGone]);
+
+  return (
+    <g ref={ref} className="ig-vn-chain" style={{ transformOrigin: `${GLASS.cx}px ${GLASS.neckY}px` }}>
+      {extenders && v.length.ext && <path d={chainPath(v.length.cm + v.length.ext)} fill="none" stroke={colour} strokeWidth="1" strokeDasharray="3 3" opacity=".6" />}
+      <path ref={line} d={d} pathLength={1} fill="none" stroke={colour} strokeWidth={kind === "links" && bold ? 2.8 : WEIGHT[kind]} strokeLinecap="round" style={{ strokeDasharray: 1 }} data-kind={kind} />
+      <g ref={texture}>
+        <Texture kind={kind} d={d} colour={colour} bold={bold} />
+      </g>
+      {v.pendant && (
+        <g transform={`translate(${GLASS.cx} ${y})`}>
+          <path d="M0 0V5" stroke={colour} strokeWidth="1" />
+          <circle cy="16" r="11.5" fill="#FBF3EC" stroke={GOLD} strokeWidth="1.4" />
+          {photo && <image href={shopifyImage(photo, 120)} x="-10" y="6" width="20" height="20" preserveAspectRatio="xMidYMid slice" clipPath={`url(#${clip})`} />}
+        </g>
+      )}
+      <path d={`M${fx.toFixed(1)} ${fy.toFixed(1)}L${lx + (left ? 2 : -2)} ${labelY - 4}`} stroke={GOLD} strokeOpacity=".6" strokeWidth=".5" fill="none" />
+      <text x={lx} y={labelY} textAnchor={left ? "end" : "start"} className="ig-vn-label">
+        <tspan x={lx}>{first}</tspan>
+        {second && (
+          <tspan x={lx} dy="11">
+            {second}
+          </tspan>
+        )}
+      </text>
+    </g>
+  );
+};
+
+type Props = { worn: readonly Worn[]; extenders: boolean; onGone: (key: string) => void };
+
+/* Each name a little below its chain's lowest point: from the highest chain down, alternately left and right,
+   so each side's names run in the chains' own order; kept two lines clear of the one above it on its side, and
+   high enough that the glass's oval never cuts it. */
+// eslint-disable-next-line react-refresh/only-export-components -- the glass's label layout, beside it for its test
+export const labelsFor = (worn: readonly Pick<Worn, "v">[]): Label[] => {
+  const out: Label[] = [];
+  const last = { l: -Infinity, r: -Infinity };
+  worn
+    .map((x, i) => i)
+    .sort((a, b) => worn[a].v.length.cm - worn[b].v.length.cm)
+    .forEach((i, k) => {
+      const left = k % 2 === 0;
+      const side = left ? "l" : "r";
+      const want = dropY(worn[i].v.length.cm) + (worn[i].v.pendant ? 30 : 10);
+      const y = Math.min(258, Math.max(want, last[side] + 26));
+      last[side] = y;
+      out[i] = { left, y };
+    });
+  return out;
+};
+
+const LookGlass = ({ worn, extenders, onGone }: Props) => {
+  const uid = useId().replace(/:/g, "");
+  const { w, h, cx } = GLASS;
+  const labels = labelsFor(worn);
+  return (
+    <svg className="ig-vn-glass" viewBox={`0 0 ${w} ${h}`} aria-hidden>
+      <defs>
+        <clipPath id={`${uid}o`}>
+          <ellipse cx={cx} cy={h / 2 + 4} rx={w / 2 - 14} ry={h / 2 - 16} />
+        </clipPath>
+        <clipPath id={`${uid}b`}>
+          <circle cy="16" r="10" />
+        </clipPath>
+        <g id={`${uid}l`}>
+          <path d="M0 0C3-5 9-6 13-4C9 0 4 1 0 0Z" />
+        </g>
+      </defs>
+      {/* The glass: vellum in a gold double hairline. */}
+      <ellipse cx={cx} cy={h / 2 + 4} rx={w / 2 - 14} ry={h / 2 - 16} fill="rgb(255 248 245)" />
+      <g clipPath={`url(#${uid}o)`}>
+        {/* A neckline and collarbones, one ink line, nothing marked. */}
+        <g fill="none" stroke={INK} strokeWidth="1.1" strokeLinecap="round">
+          <path d="M126 36C125 66 123 92 112 108C96 126 62 138 30 150" />
+          <path d="M174 36C175 66 177 92 188 108C204 126 238 138 270 150" />
+          <path d="M84 158C104 150 124 152 141 162M216 158C196 150 176 152 159 162" />
+          <path d="M146 166L150 171L154 166" strokeOpacity=".7" />
+        </g>
+        {worn.map((x, i) => (
+          <Chain key={x.key} w={x} label={labels[i]} extenders={extenders} clip={`${uid}b`} onGone={onGone} />
+        ))}
+      </g>
+      <ellipse cx={cx} cy={h / 2 + 4} rx={w / 2 - 14} ry={h / 2 - 16} fill="none" stroke={GOLD} strokeWidth="1.2" />
+      <ellipse cx={cx} cy={h / 2 + 4} rx={w / 2 - 8} ry={h / 2 - 10} fill="none" stroke={GOLD} strokeOpacity=".55" strokeWidth=".6" />
+      {/* Vines up both sides. */}
+      <g fill="none" stroke="#99B4AF" strokeWidth="1">
+        <path d="M30 300C14 250 10 200 18 150" />
+        <path d="M270 300C286 250 290 200 282 150" />
+      </g>
+      <g fill="#99B4AF" opacity=".85">
+        {[0, 1, 2, 3].map((k) => (
+          <g key={k}>
+            <use href={`#${uid}l`} transform={`translate(${16 - k} ${280 - k * 36}) rotate(${-120 + k * 8})`} />
+            <use href={`#${uid}l`} transform={`translate(${284 + k} ${280 - k * 36}) rotate(${-60 - k * 8}) scale(-1 1)`} />
+          </g>
+        ))}
+      </g>
+      {/* A pressed rose at the crest. */}
+      <g transform={`translate(${cx} 10)`}>
+        {[0, 72, 144, 216, 288].map((a) => (
+          <ellipse key={a} cx="0" cy="-5" rx="4.4" ry="6" transform={`rotate(${a})`} fill="#FFBDA8" stroke={GOLD} strokeWidth=".5" />
+        ))}
+        <circle r="3" fill="#F0BCA8" stroke={GOLD} strokeWidth=".5" />
+        <path d="M-6 6C-14 8-20 6-24 2M6 6C14 8 20 6 24 2" fill="none" stroke="#99B4AF" strokeWidth="1.2" />
+      </g>
+    </svg>
+  );
+};
+
+export default LookGlass;
diff --git a/src/components/portal/MemberContext.tsx b/src/components/portal/MemberContext.tsx
new file mode 100644
index 0000000..bdaf7e7
--- /dev/null
+++ b/src/components/portal/MemberContext.tsx
@@ -0,0 +1,113 @@
+import { createContext, useContext, type ReactNode } from "react";
+import type { User } from "@supabase/supabase-js";
+import type { MemberProfile } from "@/contexts/AuthContext";
+import type { CartItem } from "@/contexts/CartContext";
+import type { Drop } from "@/lib/portal/drops";
+import type { Pressed } from "@/lib/portal/pressed";
+import type { MetaResult, Naira, Updater } from "@/lib/portal/memberMeta";
+import type { ArrivalActions } from "@/lib/portal/arrival";
+import type { Checkout } from "@/lib/portal/checkouts";
+import type { SkyHour } from "@/lib/portal/sky";
+import type { SeasonRow } from "@/lib/portal/seasons";
+import type { AtelierNote } from "@/lib/portal/notes";
+
+/*
+  The signed-in member as the portal's screens see her, with the only writes
+  the portal makes: her birthday (profiles.birthday, her own row, under the
+  existing row security), a bag line or a Buy now (the shared CartContext, so
+  the bag itself is untouched), her account's memory (user_metadata.naira:
+  her ring size and metal, saved pieces, pressed flowers, her month, the day
+  she was last here; see lib/portal/memberMeta), and the arrival repair's two
+  (the Inner Circle list, her ad-matching answer; see lib/portal/arrival),
+  each only on her own tap. MembersRoute supplies the real ones, or the development
+  preview's console-only stand-ins.
+*/
+
+export type SaveResult = { ok: true } | { ok: false; message: string };
+export type BagLine = Omit<CartItem, "quantity" | "lineId">;
+
+/** Development preview only (lib/portal/previewGarden): the sky's hour, festival rows and notes in place of the clock's and the owner's; a fixture look at the vanity; Stone Light's scripted sweep. */
+export type GardenOverrides = {
+  hour?: SkyHour;
+  seasons?: readonly SeasonRow[];
+  notes?: readonly AtelierNote[];
+  look?: readonly string[];
+  tilt?: "sweep";
+};
+
+export type Member = {
+  user: User;
+  profile: MemberProfile | null;
+  firstName: string;
+  preview: boolean;
+  saveBirthday: (birthday: string) => Promise<SaveResult>;
+  /** True only when the shop really took the piece (the bag says why when it did not). */
+  addToBag: (line: BagLine) => Promise<boolean>;
+  /** Straight to checkout with this one piece, as the product page's Buy now. */
+  buyNow: (line: BagLine) => Promise<void>;
+  /** The bag is talking to Shopify: Buy now waits, so one tap never pays for two. */
+  bagBusy: boolean;
+  /** The Doors play once per portal visit, however often she returns to the garden. */
+  doorsPlayed: boolean;
+  markDoorsPlayed: () => void;
+  /** The drop manifest (empty until the owner sets a drop; the preview's fixtures in development). */
+  drops: readonly Drop[];
+  /** Development preview only: handles treated as not yet on the shop. Always empty in production. */
+  unlisted: readonly string[];
+  /** Development preview only: stand-in checkout rows, so the Order Desk and Care never ask Supabase for the preview member. Always null in production. */
+  checkoutsPreview?: readonly Checkout[] | null;
+  /** Her pressed flowers, oldest first. */
+  pressed: readonly Pressed[];
+  press: (dropId: string) => void;
+  /** Her account's memory, as it stands on screen (written to her account soon after each change). */
+  naira: Naira;
+  changeMeta: (update: Updater) => MetaResult;
+  /**
+   * What this phone and her account last agreed on for her saved pieces (the Jewel drawer's merge base, `h`),
+   * and the hearts here her account had no room for (`x`, spilled: they stay hearted, never taken off).
+   * Kept by the portal, not by a room, so a piece any room's change lets go to make room is spilled at once.
+   */
+  savedSync: SavedSync;
+  keepSavedSync: (h: readonly string[], x: readonly string[]) => void;
+  /** The last write did not reach her account; `retryMeta` tries again. */
+  metaProblem: string | null;
+  retryMeta: () => void;
+  /** The IST day she was last here before today ("2026-11-02"); null on her first visit, and on a second phone the day her account already says today. */
+  since: string | null;
+  /** Her birth month, 1 to 12: her profile's birthday first, else the month alone she kept (naira.month); null when neither. */
+  month: number | null;
+  /** Her first signed-in visit (her account had no visit day as she arrived): the arrival repair's one day. */
+  firstVisit: boolean;
+  /** Her profile as it was read when her rooms opened, so a change she makes this visit never changes what the arrival repair asks. */
+  arrivalProfile: MemberProfile | null;
+  /** The arrival repair's reads and writes (her list row, her ad-matching answer); console-only in the preview. */
+  arrival: ArrivalActions;
+  /** Development preview only: the garden's hour, dressings and notes to see each one. Always null in production. */
+  garden?: GardenOverrides | null;
+};
+
+export type SavedSync = { readonly h: readonly string[]; readonly x: readonly string[] };
+
+const MemberContext = createContext<Member | null>(null);
+
+export const MemberProvider = ({ value, children }: { value: Member; children: ReactNode }) => (
+  <MemberContext.Provider value={value}>{children}</MemberContext.Provider>
+);
+
+// eslint-disable-next-line react-refresh/only-export-components -- the hook lives beside its provider
+export const useMember = (): Member => {
+  const member = useContext(MemberContext);
+  if (!member) throw new Error("useMember must be used inside the members portal");
+  return member;
+};
+
+const capitalise = (word: string) => (word ? word[0].toUpperCase() + word.slice(1) : word);
+
+/** Her first name: the profile's, then the sign-in's, then her email's (ananya.r@… → Ananya). */
+// eslint-disable-next-line react-refresh/only-export-components -- shared by the route and its tests
+export const firstNameOf = (profile: MemberProfile | null, user: User | null): string => {
+  const named = profile?.full_name || (user?.user_metadata?.full_name as string | undefined) || "";
+  if (named.trim()) return named.trim().split(/\s+/)[0].slice(0, 40);
+  const local = (user?.email ?? "").split("@")[0].split(/[._\d+-]+/).filter(Boolean)[0] ?? "";
+  return capitalise(local.slice(0, 40));
+};
