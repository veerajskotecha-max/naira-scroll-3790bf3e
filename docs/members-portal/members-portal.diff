+import { afterEach, describe, expect, it } from "vitest";
+import { drawerOnlyCount } from "./jewelBox";
+import { PORTAL_STORE_KEY } from "./forgetDevice";
+import { PORTAL_KEY } from "@/lib/portal/safeStorage";
+
+const U = "u-ananya";
+const meta = (saved: unknown) => ({ full_name: "Ananya", naira: { v: 1, saved } });
+
+afterEach(() => window.localStorage.clear());
+
+describe("the jewel box's count of pieces kept on her account", () => {
+  it("reads the portal's own store key", () => {
+    expect(PORTAL_STORE_KEY).toBe(PORTAL_KEY);
+  });
+
+  it("counts her account's pieces that have no heart on this phone", () => {
+    expect(drawerOnlyCount(U, ["a-ring"], meta(["a-ring", "b-studs", "c-chain"]))).toBe(2);
+    expect(drawerOnlyCount(U, ["a-ring", "b-studs"], meta(["a-ring", "b-studs"]))).toBe(0);
+  });
+
+  it("leaves out a heart she took off on this phone, which the drawer will let go", () => {
+    window.localStorage.setItem(PORTAL_STORE_KEY, JSON.stringify({ savedSync: { u: U, h: ["a-ring", "b-studs"] } }));
+    expect(drawerOnlyCount(U, ["a-ring"], meta(["a-ring", "b-studs", "c-chain"]))).toBe(1);
+    // Another member's agreement on this phone is not hers.
+    window.localStorage.setItem(PORTAL_STORE_KEY, JSON.stringify({ savedSync: { u: "u-meera", h: ["b-studs"] } }));
+    expect(drawerOnlyCount(U, ["a-ring"], meta(["a-ring", "b-studs", "c-chain"]))).toBe(2);
+  });
+
+  it("counts nothing it cannot read", () => {
+    expect(drawerOnlyCount(null, [], meta(["a-ring"]))).toBe(0);
+    expect(drawerOnlyCount(U, [], {})).toBe(0);
+    expect(drawerOnlyCount(U, [], { naira: { saved: "a-ring" } })).toBe(0);
+    expect(drawerOnlyCount(U, [], meta(["Not A Handle", 7, "a-ring", "a-ring"]))).toBe(1);
+    window.localStorage.setItem(PORTAL_STORE_KEY, "{broken");
+    expect(drawerOnlyCount(U, [], meta(["a-ring"]))).toBe(1);
+  });
+});
diff --git a/src/lib/auth/jewelBox.ts b/src/lib/auth/jewelBox.ts
new file mode 100644
index 0000000..245b474
--- /dev/null
+++ b/src/lib/auth/jewelBox.ts
@@ -0,0 +1,43 @@
+/*
+  /account's "My jewel box": the hearts on this phone (the shop's wishlist)
+  and, since Phase 3, the pieces saved to her account (user_metadata.naira
+  .saved, the Jewel drawer's list, which reaches every phone she signs in
+  on). The panel counts the hearts here as before, and says how many more
+  her account keeps that this phone has no heart for (saved on another
+  phone), so the number matches what her drawer will show.
+
+  A heart she has since taken off on this phone, which the drawer last
+  agreed with her account on (the portal's merge base, `savedSync`), is not
+  counted: the drawer takes it out of her account on her next visit. Read
+  from the portal's own store by its key without importing the portal
+  (Account is its own chunk; a test keeps the key in step), like
+  forgetDevice.
+*/
+
+import { PORTAL_STORE_KEY } from "./forgetDevice";
+
+const HANDLE = /^[a-z0-9][a-z0-9-]{0,95}$/;
+const handles = (raw: unknown): string[] => (Array.isArray(raw) ? raw.filter((h): h is string => typeof h === "string" && HANDLE.test(h)) : []);
+
+/** What this phone and her account last agreed on (the drawer's merge base), when it is hers. */
+const agreedOnThisPhone = (userId: string): string[] => {
+  try {
+    const raw = window.localStorage.getItem(PORTAL_STORE_KEY);
+    const store = raw ? (JSON.parse(raw) as { savedSync?: { u?: unknown; h?: unknown } } | null) : null;
+    const sync = store && typeof store === "object" ? store.savedSync : undefined;
+    return sync && sync.u === userId ? handles(sync.h) : [];
+  } catch {
+    return [];
+  }
+};
+
+/** How many pieces her account keeps that have no heart on this phone (and that this phone has not let go). */
+export const drawerOnlyCount = (userId: string | null | undefined, deviceIds: readonly string[], userMetadata: unknown): number => {
+  if (!userId || !userMetadata || typeof userMetadata !== "object") return 0;
+  const naira = (userMetadata as { naira?: { saved?: unknown } }).naira;
+  const saved = handles(naira && typeof naira === "object" ? naira.saved : undefined);
+  if (!saved.length) return 0;
+  const here = new Set(deviceIds);
+  const letGoHere = new Set(agreedOnThisPhone(userId).filter((h) => !here.has(h)));
+  return new Set(saved.filter((h) => !here.has(h) && !letGoHere.has(h))).size;
+};
