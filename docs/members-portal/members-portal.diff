+
+  it("still lets in a new member who has no profile row yet", async () => {
+    auth.state = { ...auth.state, loading: false, user: member, profile: null, refreshProfile: async () => {} };
+    visit("/members/stone");
+    expect(await screen.findByLabelText("When is your birthday?")).toBeInTheDocument();
