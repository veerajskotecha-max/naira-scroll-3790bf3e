+        // A phone held still sends readings all the same: nothing is drawn for a change too small to see.
+        if (Math.abs(next.x - shown.current.x) + Math.abs(next.y - shown.current.y) > 0.002) {
+          follow(next);
+          // Tilting is her touch too: the 20 s rest counts from her last move (at most once a second).
+          if (performance.now() - woke.current > 1000) {
+            woke.current = performance.now();
+            window.dispatchEvent(new Event(WAKE));
+          }
+        }
+      },
+      onEnd: () => {
+        sensor.current = null;
+        setTilt("off");
+      },
+    });
+  };
