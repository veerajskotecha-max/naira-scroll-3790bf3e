+import { describe, expect, it } from "vitest";
+import { honestAuthError } from "./errors";
+import { PASSWORD_MAX, PASSWORD_MIN, newPasswordProblem } from "./password";
+
+describe("honestAuthError", () => {
+  it("says what went wrong in plain words, by code or by message", () => {
+    expect(honestAuthError({ code: "invalid_credentials", message: "Invalid login credentials" })).toMatch(/don't match/);
+    expect(honestAuthError({ message: "Invalid login credentials" })).toMatch(/don't match/);
+    expect(honestAuthError({ code: "email_not_confirmed" })).toMatch(/confirm your email/);
+    expect(honestAuthError({ code: "over_email_send_rate_limit" })).toMatch(/wait a few minutes/);
+    expect(honestAuthError({ message: "For security purposes, you can only request this after 42 seconds. Rate limit" })).toMatch(
+      /wait a few minutes/,
+    );
+    expect(honestAuthError({ code: "same_password" })).toMatch(/already have/);
+    expect(honestAuthError({ code: "otp_expired" })).toMatch(/expired/);
+    expect(honestAuthError({ name: "AuthRetryableFetchError", status: 0, message: "Failed to fetch" })).toMatch(/connection/);
+  });
+
+  it("keeps Supabase's own sentence for a weak password, and for anything it does not know", () => {
+    expect(honestAuthError({ code: "weak_password", message: "Password is known to be weak and easy to guess" })).toBe(
+      "Password is known to be weak and easy to guess",
+    );
+    expect(honestAuthError({ message: "Database error saving new user" })).toBe("Database error saving new user");
+    expect(honestAuthError(null)).toMatch(/Something went wrong/);
+  });
+});
+
+describe("newPasswordProblem", () => {
+  it("asks for the minimum length, a sane maximum, and two that match", () => {
+    expect(newPasswordProblem("abc", "abc")).toMatch(new RegExp(`at least ${PASSWORD_MIN}`));
+    expect(newPasswordProblem("x".repeat(PASSWORD_MAX + 1), "x".repeat(PASSWORD_MAX + 1))).toMatch(/or fewer/);
+    expect(newPasswordProblem("jasmine-7", "jasmine-8")).toMatch(/don't match/);
+    expect(newPasswordProblem("jasmine-7", "jasmine-7")).toBeNull();
+  });
+});
