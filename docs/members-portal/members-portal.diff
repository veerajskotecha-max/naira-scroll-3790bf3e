+  const pieces = (naira.p ?? 0) & 31;
+  const crownWords = useDecoration(PetalCrown, pieces > 0);
+  // Her month's flower: traced in her garden's stars after dark (naira.p's bit 5), and resting in her night sky after.
+  const night = hour === "night";
+  const flower = stone?.flower.toLowerCase() ?? "";
+  const written = Boolean(stone) && Boolean((naira.p ?? 0) & 32);
+  // The sheet: closed, opening (its chunk on its way), open, or its chunk could not arrive.
