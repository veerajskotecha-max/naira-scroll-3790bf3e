+import type { JewelPiece } from "@/data/jewellery";
+
+/*
+  Gold or silver, as the listing is: the name or handle wins ("Serpentine
+  Whisper Chain — Silver"), then the materials line. lib/pairings' familyOf,
+  copied because that file rides in the product page's chunk (laidOut.test
+  checks the two agree on every piece).
+*/
+
+export type Family = "gold" | "silver";
+
+export const familyOf = (piece: Pick<JewelPiece, "name" | "handle" | "materials">): Family =>
+  /\bsilver\b/i.test(piece.name) ||
+  /(^|-)silver(-|$)/.test(piece.handle) ||
+  (/rhodium|silver/i.test(piece.materials ?? "") && !/18k gold/i.test(piece.materials ?? ""))
+    ? "silver"
+    : "gold";
