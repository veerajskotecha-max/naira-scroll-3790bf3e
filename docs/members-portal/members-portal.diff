+  // The button goes once the tilt is on, or once it cannot be: her focus goes to the stone, never to the page's top.
+  useEffect(() => {
+    if ((tilt === "on" || tilt === "off") && (document.activeElement === document.body || !document.activeElement)) panelRef.current?.focus({ preventScroll: true });
+  }, [tilt]);
+
+  // Back up to the specimen card, where the live necklace, its price and Add to bag are.
+  const toNecklace = () => {
+    const card = document.querySelector(".ig-card3d");
+    if (card) window.scrollTo({ top: Math.max(0, card.getBoundingClientRect().top + window.scrollY - 140), behavior: stillMotion() ? "auto" : "smooth" });
+  };
+
+
+  const glint = first.glint;
