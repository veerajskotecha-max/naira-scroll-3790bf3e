@@ -0,0 +1,146 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import type { User } from "@supabase/supabase-js";
+import { getSupabase } from "@/integrations/supabase/lazy";
+import { META_KEY, compactNaira, createMetaWriter, fitToCap, readNaira, sameNaira, type MetaResult, type MetaWriter, type Naira, type Updater } from "./memberMeta";
+
+/*
+  Her account's memory in the portal: the `naira` her sign-in carries, changed
+  at once on screen and written to her account 800 ms after the last change
+  (see memberMeta.ts). When the account answers with a new copy (Supabase's
+  USER_UPDATED, which refreshes the signed-in user everywhere, or a write from
+  another tab), the screen takes it, unless a change of hers is still on its
+  way. Leaving the portal or hiding the tab writes what is waiting at once.
+
+  In development, the preview member's changes go to an in-memory copy and
+  `log` prints them: nothing reaches Supabase.
+*/
+
+export type MemberMeta = {
+  naira: Naira;
+  /** Changes her `naira` now and writes it soon; refused (with the reason) only when it cannot fit. */
+  change: (update: Updater) => MetaResult;
+  /** The last write did not reach her account (her change is kept on screen and tried again). */
+  problem: string | null;
+  retry: () => void;
+};
+
+const EMPTY = readNaira(null);
+
+export const useMemberMeta = (user: User | null, log: ((naira: Record<string, unknown>) => void) | null): MemberMeta => {
+  const uid = user?.id ?? null;
+  const fromAccount = user?.user_metadata?.[META_KEY] as unknown;
+  const [held, setHeld] = useState(() => ({ uid, naira: readNaira(fromAccount) }));
+  const [problem, setProblem] = useState<string | null>(null);
+  const current = useRef(held.naira);
+  /* She signed in (or another member did) since this hook first ran, as
+     happens when the portal opens while sign-in is still being read: her
+     account's copy is taken in this same render, so nothing that runs as
+     she arrives ever reads an empty memory. */
+  let naira = held.naira;
+  if (held.uid !== uid) {
+    naira = uid ? readNaira(fromAccount) : EMPTY;
+    current.current = naira;
+    setHeld({ uid, naira });
+  }
+  const setNaira = useCallback((next: Naira) => setHeld({ uid, naira: next }), [uid]);
+  const accountRef = useRef(fromAccount);
+  accountRef.current = fromAccount;
+  const memory = useRef<Naira>(held.naira);
+  const logRef = useRef(log);
+  logRef.current = log;
+  const writerRef = useRef<MetaWriter | null>(null);
+  const preview = Boolean(log);
+
+  const writer = useMemo(() => {
+    if (!uid) return null;
+    // The preview's account: an in-memory copy, starting from what the stand-in member carries.
+    memory.current = readNaira(accountRef.current);
+    return createMetaWriter({
+      load: async () => {
+        if (preview) return memory.current;
+        const supabase = await getSupabase();
+        const { data, error } = await supabase.auth.getUser();
+        if (error || !data.user) throw error ?? new Error("signed out");
+        return readNaira(data.user.user_metadata?.[META_KEY]);
+      },
+      save: async (next) => {
+        if (preview) {
+          memory.current = next;
+          logRef.current?.(compactNaira(next));
+          return;
+        }
+        const supabase = await getSupabase();
+        const { error } = await supabase.auth.updateUser({ data: { [META_KEY]: compactNaira(next) } });
+        if (error) throw error;
+      },
+      onSettled: (result) => {
+        if (result.ok === false) {
+          setProblem(result.message);
+          return;
+        }
+        setProblem(null);
+        // What her account now holds (unless she has changed something since: that is still on its way).
+        if (!writerRef.current?.pending()) {
+          current.current = result.naira;
+          setNaira(result.naira);
+        }
+      },
+    });
+    // One writer per member (and per preview switch).
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [uid, preview]);
+  writerRef.current = writer;
+
+  // Her account's copy, when it changes and nothing of hers is waiting.
+  const seen = JSON.stringify(fromAccount ?? null);
+  useEffect(() => {
+    if (writerRef.current?.pending()) return;
+    const next = uid ? readNaira(fromAccount) : EMPTY;
+    current.current = next;
+    setNaira(next);
+    // `seen` stands for `fromAccount`'s contents; setNaira changes only with `uid`.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [seen, uid]);
+
+  // Nothing is lost by leaving: a hidden tab or the portal closing writes at once.
+  useEffect(() => {
+    if (!writer) return;
+    const hide = () => {
+      if (document.visibilityState === "hidden") void writer.flush();
+    };
+    const leave = () => void writer.flush();
+    document.addEventListener("visibilitychange", hide);
+    window.addEventListener("pagehide", leave);
+    return () => {
+      document.removeEventListener("visibilitychange", hide);
+      window.removeEventListener("pagehide", leave);
+      void writer.flush();
+    };
+  }, [writer]);
+
+  const change = useCallback(
+    (update: Updater): MetaResult => {
+      if (!writer) return { ok: false, message: "Please sign in again." };
+      const before = current.current;
+      const next = update(before);
+      if (next === before) return { ok: true, dropped: [] };
+      const fitted = fitToCap(next);
+      if (fitted.ok === false) return fitted;
+      // Nothing changed (the same list again, or one the cap trims back to what she has): nothing to write.
+      if (sameNaira(fitted.naira, before)) return { ok: true, dropped: [] };
+      current.current = fitted.naira;
+      setNaira(fitted.naira);
+      writer.queue(update);
+      // What left her saved list with this change (taken out, or let go to make room), so the drawer can tell her;
+      // and which of them the cap alone let go, so the portal keeps them hearted on this phone (MembersRoute).
+      return { ok: true, dropped: before.saved.filter((h) => !fitted.naira.saved.includes(h)), trimmed: fitted.trimmed };
+    },
+    [writer, setNaira],
+  );
+
+  const retry = useCallback(() => {
+    if (writer) void writer.flush();
+  }, [writer]);
+
+  return { naira, change, problem, retry };
+};
