+
+  /* Supabase answers the sign-in before her profile row. A member who has
+     already given her birthday must never be asked for it, see a bud turn
+     into her stone, or be celebrated for saving something she did not. */
+  it("keeps the gate closed until her profile has been read", async () => {
+    let answer = () => {};
+    const refreshProfile = vi.fn(() => new Promise<void>((resolve) => (answer = resolve)));
+    auth.state = { ...auth.state, loading: false, user: member, profile: null, refreshProfile };
+    const { container } = visit("/members/stone");
+    expect(screen.getByRole("status")).toHaveTextContent("Opening the gate");
