@@ -0,0 +1,184 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { RING_SIZE_CHART } from "@/data/ringSizing";
+import {
+  CAL_LEFT,
+  CARD_MM,
+  atRoomLimit,
+  calRoomMax,
+  calibrationFrom,
+  CIRCLE_STOPS_MM,
+  RING_CHART,
+  betweenSizesWhatsApp,
+  calibrationFor,
+  matchForStop,
+  mmToPx,
+  outsideSizeWhatsApp,
+  PINCH_PX_PER_STOP,
+  pinchStop,
+  pxPerMmFrom,
