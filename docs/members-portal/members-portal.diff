+          {list.length > 0 && (
+            <ul className="ig-glist" data-clarity-mask="true">
+              {list.map(({ gift: g, index, next: when }) =>
+                editing && sameGift(editing, g) ? (
+                  <li key={`edit-${index}`} className="ig-glist-edit">
+                    <OccasionForm initial={g} onSave={edit(g)} onCancel={() => setEditing(null)} />
+                  </li>
+                ) : (
+                  <li key={`${g.n}-${g.m}-${g.d}-${g.b}`} className={index === shown ? "is-shown" : undefined}>
+                    <button type="button" className="ig-glist-pick" onClick={() => setChosen(g)} aria-current={index === shown ? "true" : undefined}>
