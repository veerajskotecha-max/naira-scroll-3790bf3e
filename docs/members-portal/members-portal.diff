+import { describe, expect, it } from "vitest";
+import type { Drop } from "./drops";
+import {
+  DAY,
+  HOUR,
+  MINUTE,
+  PETAL_THRESHOLDS_MS,
+  VAULT_AFTER_MS,
+  dropNumber,
+  dropPhase,
+  inMembersWindow,
+  msUntil,
+  petalsOpen,
+  phaseBoundaries,
+  type LiveLookup,
+} from "./dropPhase";
+import { formatIstOpening } from "./ist";
+import { countdown, countdownWords } from "./countdown";
+
+/* A drop's phase is a pure function of the drop, the time and the shop.
+   Times are written in IST (+05:30, no daylight saving): 8:00 pm on 21 Nov
+   is 14:30 UTC, and "midnight" for a drop opening at 00:00 IST is 18:30 UTC
+   the day before. */
+
+const drop = (over: Partial<Drop> = {}): Drop => ({
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
+  accent: "#2F6B4F",
+  story: ["Green, like a garden after rain."],
+  membersFrom: "2026-11-21T20:00:00+05:30",
+  everyoneFrom: "2026-11-23T20:00:00+05:30",
+  handles: ["verdant-pear-drop-huggies", "verdant-pear-pendant-necklace"],
+  leadHandle: "verdant-pear-pendant-necklace",
+  ...over,
+});
+
+const utc = (s: string) => Date.parse(`${s}Z`);
+const allLive: LiveLookup = () => "available";
+const noneListed: LiveLookup = () => "unlisted";
+
+describe("dropPhase", () => {
+  it("is sealed until membersFrom, to the millisecond, in IST", () => {
+    const d = drop();
+    expect(dropPhase(d, utc("2026-11-21T14:29:59.999"), allLive)).toBe("sealed");
+    expect(dropPhase(d, utc("2026-11-21T14:30:00"), allLive)).toBe("members");
+  });
+
+  it("opens to members at IST midnight, which is 18:30 UTC the day before", () => {
+    const d = drop({ membersFrom: "2026-12-01T00:00:00+05:30", everyoneFrom: "2026-12-02T00:00:00+05:30" });
+    expect(dropPhase(d, utc("2026-11-30T18:29:59"), allLive)).toBe("sealed");
+    expect(dropPhase(d, utc("2026-11-30T18:30:00"), allLive)).toBe("members");
+    expect(dropPhase(d, utc("2026-12-01T18:29:59"), allLive)).toBe("members");
+    expect(dropPhase(d, utc("2026-12-01T18:30:00"), allLive)).toBe("public");
+  });
+
+  it("holds +05:30 all year: the same wall time in March, July and December", () => {
+    for (const day of ["2027-03-28", "2027-07-15", "2027-12-31"]) {
+      const d = drop({ membersFrom: `${day}T20:00:00+05:30`, everyoneFrom: `${day}T21:00:00+05:30` });
+      expect(dropPhase(d, Date.parse(`${day}T14:29:59Z`), allLive)).toBe("sealed");
+      expect(dropPhase(d, Date.parse(`${day}T14:30:00Z`), allLive)).toBe("members");
+    }
+  });
+
+  it("goes public at everyoneFrom and rests in the Vault 14 days later", () => {
+    const d = drop();
+    const everyone = Date.parse(d.everyoneFrom);
+    expect(dropPhase(d, everyone - 1, allLive)).toBe("members");
+    expect(dropPhase(d, everyone, allLive)).toBe("public");
+    expect(dropPhase(d, everyone + VAULT_AFTER_MS - 1, allLive)).toBe("public");
+    expect(dropPhase(d, everyone + VAULT_AFTER_MS, allLive)).toBe("vault");
+  });
+
+  it("is 'arriving' when the time has passed but no piece is on the shop, so none is availableForSale", () => {
+    const d = drop();
+    const opens = Date.parse(d.membersFrom);
+    expect(dropPhase(d, opens + MINUTE, noneListed)).toBe("arriving");
+    expect(dropPhase(d, Date.parse(d.everyoneFrom) + HOUR, noneListed)).toBe("arriving");
+    // One piece on the shop and it has opened.
+    expect(dropPhase(d, opens + MINUTE, (h) => (h === "verdant-pear-drop-huggies" ? "available" : "unlisted"))).toBe("members");
+  });
+
+  it("never reads a drop that has sold out as unopened: listed but sold out is Sold out, not arriving", () => {
+    const d = drop();
+    expect(dropPhase(d, Date.parse(d.membersFrom) + DAY, () => "soldout")).toBe("members");
+  });
+
+  it("does not guess 'arriving' while the shop has not answered", () => {
+    expect(dropPhase(drop(), Date.parse(drop().membersFrom) + MINUTE, null)).toBe("members");
+  });
+
+  it("shows a moved drop as moved, with its old date, until the new one", () => {
+    const d = drop({ movedFrom: "2026-11-14T20:00:00+05:30" });
+    expect(dropPhase(d, utc("2026-11-15T10:00:00"), allLive)).toBe("moved");
+    expect(formatIstOpening(d.movedFrom!)).toBe("Sat 14 Nov · 8:00 pm IST");
+    expect(formatIstOpening(d.membersFrom)).toBe("Sat 21 Nov · 8:00 pm IST");
+    expect(dropPhase(d, Date.parse(d.membersFrom), allLive)).toBe("members");
+  });
+
+  it("never counts below zero", () => {
+    const d = drop();
+    const opens = Date.parse(d.membersFrom);
+    expect(msUntil(d, opens + DAY)).toBe(0);
+    expect(countdown(msUntil(d, opens + DAY))).toEqual({ days: 0, hours: 0, minutes: 0 });
+    expect(countdown(-5 * MINUTE)).toEqual({ days: 0, hours: 0, minutes: 0 });
+    expect(countdownWords(-1)).toBe("Opening now.");
+  });
+});
+
+describe("the members' window (the only time her flower can be pressed)", () => {
+  it("runs from membersFrom up to, not including, everyoneFrom, whatever the shop shows", () => {
+    const d = drop();
+    expect(inMembersWindow(d, utc("2026-11-21T14:29:59.999"))).toBe(false);
+    expect(inMembersWindow(d, utc("2026-11-21T14:30:00"))).toBe(true);
+    expect(inMembersWindow(d, utc("2026-11-23T14:29:59.999"))).toBe(true);
+    expect(inMembersWindow(d, utc("2026-11-23T14:30:00"))).toBe(false);
+    expect(inMembersWindow(d, utc("2026-12-30T00:00:00"))).toBe(false);
+  });
+});
+
+describe("the Bloom Clock's petals", () => {
+  it.each([
+    [8 * DAY, 0],
+    [7 * DAY + 1, 0],
+    [7 * DAY, 1],
+    [3 * DAY + 1, 1],
+    [3 * DAY, 2],
+    [DAY + 1, 2],
+    [DAY, 3],
+    [HOUR + 1, 3],
+    [HOUR, 4],
+    [1, 4],
+    [0, 5],
+    [-HOUR, 5],
+  ])("with %i ms to go, %i petals are open", (left, open) => {
+    expect(petalsOpen(left)).toBe(open);
+  });
+
+  it("names its five thresholds: 7 days, 3 days, 1 day, 1 hour, the opening", () => {
+    expect(PETAL_THRESHOLDS_MS).toEqual([7 * DAY, 3 * DAY, DAY, HOUR, 0]);
+  });
+
+  it("counts whole minutes, rounded up, so the digits change only on a minute boundary", () => {
+    expect(countdown(2 * DAY + 5 * HOUR + 41 * MINUTE)).toEqual({ days: 2, hours: 5, minutes: 41 });
+    expect(countdown(2 * DAY + 5 * HOUR + 40 * MINUTE + 1)).toEqual({ days: 2, hours: 5, minutes: 41 });
+    expect(countdown(2 * DAY + 5 * HOUR + 40 * MINUTE)).toEqual({ days: 2, hours: 5, minutes: 40 });
+    expect(countdown(30_000)).toEqual({ days: 0, hours: 0, minutes: 1 });
+  });
+
+  it("says the time in words", () => {
+    expect(countdownWords(2 * DAY + 5 * HOUR)).toBe("Opens in 2 days and 5 hours.");
+    expect(countdownWords(DAY)).toBe("Opens in 1 day.");
+    expect(countdownWords(3 * HOUR + MINUTE)).toBe("Opens in 3 hours and 1 minute.");
+    expect(countdownWords(9 * MINUTE)).toBe("Opens in 9 minutes.");
+  });
+
+  it("re-reads the clock at every threshold and phase change", () => {
+    const d = drop();
+    const opens = Date.parse(d.membersFrom);
+    const marks = phaseBoundaries([d]);
+    for (const t of PETAL_THRESHOLDS_MS) expect(marks).toContain(opens - t);
+    expect(marks).toContain(Date.parse(d.everyoneFrom));
+    expect(marks).toContain(Date.parse(d.everyoneFrom) + VAULT_AFTER_MS);
+  });
+});
+
+describe("drop numbers", () => {
+  it("count drops by when they open, whatever order the manifest lists them", () => {
+    const a = drop({ id: "a", membersFrom: "2026-12-05T20:00:00+05:30", everyoneFrom: "2026-12-06T20:00:00+05:30" });
+    const b = drop({ id: "b" });
+    expect(dropNumber(a, [a, b])).toBe("02");
+    expect(dropNumber(b, [a, b])).toBe("01");
+  });
+});
diff --git a/src/lib/portal/dropPhase.ts b/src/lib/portal/dropPhase.ts
