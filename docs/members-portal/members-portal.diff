+import { useEffect, useId, useRef, useState, type ReactNode } from "react";
+import { Link } from "react-router-dom";
+import { preorderWhatsAppUrl, type JewelPiece } from "@/data/jewellery";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { choices } from "@/lib/variants";
+import { shownName } from "@/lib/portal/stones";
+import type { Preset } from "@/lib/portal/fit";
+import type { BagLine } from "./MemberContext";
+import { eyebrow, primaryButton, textLink } from "./styles";
+import "./piececard.css";
+
+/*
+  A piece in Your fit and the Jewel drawer, as the shop sells it right now:
+  its photo, name, live ₹ price and compare-at, Available or Sold out from
+  Shopify, and Add to bag with her size, metal and month already chosen. Where
+  a choice is still hers (no size saved yet, no birthday for a month piece) it
+  says so and opens the piece's page; a sold-out piece is a question on
+  WhatsApp. "In your bag." only when the shop took it.
+*/
+
+type Props = {
+  piece: JewelPiece;
+  preset: Preset;
+  /** A line under the price: the fit, or why the piece is laid out for her. */
+  note?: ReactNode;
+  /** More, under the actions (Take out of the drawer, Keep in my drawer). Given the piece's name id, so each button can say which piece it is for. */
+  extra?: ReactNode | ((describedBy: string) => ReactNode);
+  preview?: boolean;
+  bagBusy?: boolean;
+  onAdd: (line: BagLine) => Promise<boolean>;
+};
+
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
+
+const PieceCard = ({ piece, preset, note, extra, preview = false, bagBusy = false, onAdd }: Props) => {
+  const [adding, setAdding] = useState<"idle" | "busy" | "done">("idle");
+  // Every card has an "Add to bag": each button is described by its piece's name, so a list of buttons says which is which.
+  const nameId = useId();
+  const inFlight = useRef(false);
+  const live = useRef(true);
+  useEffect(
+    () => () => {
+      live.current = false;
+    },
+    [],
+  );
+  const { line, needs, price, compareAtPrice, available } = preset;
+  const variant = preset.fit.variant;
+  const image = variant?.image ?? piece.cover ?? piece.image;
+  // The choice already made for her ("July · Ruby", "Gold"): said, never hidden in the bag line. The size is the fit line's.
+  const chosen = line && variant ? choices(piece).filter((o) => !/size/i.test(o.name)).map((o) => variant.options[o.name]).filter(Boolean).join(" · ") : "";
+
+  const add = async () => {
+    if (!line || inFlight.current || bagBusy) return;
+    inFlight.current = true;
+    setAdding("busy");
+    let ok = false;
+    try {
+      ok = await onAdd(line);
+    } catch {
+      ok = false;
+    }
+    inFlight.current = false;
+    if (live.current) setAdding(ok ? "done" : "idle");
+  };
+
+  return (
+    <article className="ig-pc">
+      <Link to={`/jewellery/${piece.handle}`} className="ig-pc-photo" tabIndex={-1} aria-hidden>
+        {image && (
+          <img
+            src={shopifyImage(image, 360)}
+            srcSet={shopifySrcSet(image, [240, 360, 480]) || undefined}
+            sizes="(min-width: 768px) 200px, 36vw"
+            width={360}
+            height={360}
+            loading="lazy"
+            decoding="async"
+            alt=""
+          />
+        )}
+      </Link>
+      <div className="ig-pc-body">
+        <p className={eyebrow}>{piece.category}</p>
+        <h3 className="ig-pc-name" id={nameId}>
+          <Link to={`/jewellery/${piece.handle}`}>{piece.name}</Link>
+        </h3>
+        <p className="ig-price ig-pc-price">
+          <span>{rupees(price)}</span>
+          {compareAtPrice && compareAtPrice > price ? <s>{rupees(compareAtPrice)}</s> : null}
+          <span className={available ? "ig-stock" : "ig-stock ig-stock--out"}>{available ? "Available" : "Sold out"}</span>
+        </p>
+        {chosen && <p className="ig-pc-note">In {shownName(chosen)}</p>}
+        {note && <div className="ig-pc-note">{note}</div>}
+        {!available ? (
+          <a className={textLink} href={preorderWhatsAppUrl({ name: piece.name, handle: piece.handle, choice: preset.fit.note })} target="_blank" rel="noopener noreferrer">
+            Ask on WhatsApp
+          </a>
+        ) : line ? (
+          <button type="button" className={primaryButton} onClick={add} disabled={adding === "busy" || bagBusy} aria-describedby={nameId}>
+            {adding === "busy" ? "Adding…" : "Add to bag"}
+          </button>
+        ) : (
+          <Link className={textLink} to={`/jewellery/${piece.handle}`}>
+            {needs === "month" ? "Choose your month on its page" : needs === "size" ? "Choose your size on its page" : "See the piece"}
+          </Link>
+        )}
+        {adding === "done" && (
+          <p className="ig-fineprint" role="status">
+            {preview ? "Preview only: nothing was added to a bag." : "In your bag."}
+          </p>
+        )}
+        {typeof extra === "function" ? extra(nameId) : extra}
+      </div>
+    </article>
+  );
+};
+
+export default PieceCard;
