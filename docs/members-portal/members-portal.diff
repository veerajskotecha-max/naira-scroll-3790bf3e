+import { Suspense, useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import GardenBed, { type GardenBedHandle } from "@/components/portal/GardenBed";
+import DoorsOpen, { type DoorsMode } from "@/components/portal/DoorsOpen";
+import { StoneHead } from "@/components/portal/StoneArt";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow } from "@/components/portal/styles";
+import { formatIstDate, greetingFor } from "@/lib/portal/ist";
+import { shownName, stoneForMonth } from "@/lib/portal/stones";
+import { pickDoors, recordFullDoors } from "@/lib/portal/doors";
+import { EASE_REVEAL, play } from "@/lib/portal/motion";
+import { byOpening, dropPhase, msUntil, petalsOpen, phaseBoundaries, speciesIndex, timeOf, VAULT_AFTER_MS } from "@/lib/portal/dropPhase";
+import { formatIstDay, formatIstOpening, istOpensWhen } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { hashString } from "@/lib/portal/gardenLayout";
+import DropBud from "@/components/portal/DropBud";
+import { BudGlyph } from "@/components/portal/BudGlyph";
+import { useDropShop } from "@/components/portal/useDropShop";
+import ShopWatch from "@/components/portal/ShopWatch";
+import type { Drop } from "@/lib/portal/drops";
+import { lazyRoom, useDecoration } from "@/lib/portal/lazyRoom";
+import { nextSkyChange, skyDraws, skyHour, type SkyHour } from "@/lib/portal/sky";
+import { SEASONS, seasonOn, type Dressing } from "@/lib/portal/seasons";
+import { NOTES, notesFor } from "@/lib/portal/notes";
+import { useGardenPlants } from "@/components/portal/useGardenPlants";
+
+/*
+  Her garden: the greeting in Indian time, her own seeded bed with the Naira
+  flower planted the day she joined and her stone flower beside it, one honest
+  card, and "What's growing", which is also the garden in words for a screen
+  reader (the drawing itself is decorative). On her first signed-in visit, and
+  only after the Doors, the arrival repair's card follows her garden and the
+  day's cards: the garden first, the questions after.
+*/
+
+/* The arrival repair is asked on her first signed-in visit only, and only
+   after the Doors: a chunk of its own, fetched as her garden opens, so it is
+   in by the time the Doors have gone (it waits on her account's answer in
+   any case). No other visit downloads it. */
+const ArrivalRepair = lazyRoom(() => import("@/components/portal/ArrivalRepair"));
+
+/* Garden hours, festivals and the atelier's notes (Phase 4): each drawn by
+   a chunk of its own, fetched once the garden has painted and only when
+   there is something to draw. By day, with no festival row and no note,
+   none of them is fetched. The night's ink ground is the bed's own, at
+   first paint (sky.ts). */
+const SkyLayer = lazyRoom(() => import("@/components/portal/SkyLayer"));
+const FestivalDressing = lazyRoom(() => import("@/components/portal/FestivalDressing"));
+const AtelierNote = lazyRoom(() => import("@/components/portal/AtelierNote"));
+
+const SIX_HOURS = 6 * 60 * 60 * 1000;
+
+/* The garden's hour, kept as the clock moves on (one timer, to the next change). */
+const useSkyHour = (fixed?: SkyHour): SkyHour => {
+  const [hour, setHour] = useState<SkyHour>(() => fixed ?? skyHour());
+  useEffect(() => {
+    if (fixed) {
+      setHour(fixed);
+      return;
+    }
+    let timer = 0;
+    const arm = () => {
+      const wait = Math.max(1000, Math.min(nextSkyChange() - Date.now() + 250, SIX_HOURS));
+      timer = window.setTimeout(() => {
+        setHour(skyHour());
+        arm();
+      }, wait);
+    };
+    arm();
+    return () => window.clearTimeout(timer);
+  }, [fixed]);
+  return hour;
+};
+
+/* The sky and the festival in words, for "What's growing" (the drawing itself is decorative). */
+const SKY_WORDS: Record<Exclude<SkyHour, "day">, [string, string]> = {
+  dawn: ["Morning mist", " over the beds: the garden keeps Indian time."],
+  golden: ["The golden hour", ", a low sun behind the arbour: the garden keeps Indian time."],
+  night: ["The night garden", ", with fireflies among the flowers: the garden keeps Indian time."],
+};
+const FESTIVAL_WORDS: Record<Dressing, [string, string]> = {
+  diwali: ["Diyas and a marigold garland", ", for Diwali."],
+  monsoon: ["Monsoon rain", ", in fine hairlines over the garden."],
+  holi: ["Colour for Holi", ": tap the garden and it puffs."],
+};
+const NOTE_LIST = { margin: 0, padding: 0, display: "grid", gap: "0.6rem" } as const;
+
+/* The drop open now: whether its pieces are on the shop yet needs the live catalogue, read only here. */
+const OpenDropCard = ({ drop, now }: { drop: Drop; now: number }) => {
+  const shop = useDropShop(true);
+  const phase = dropPhase(drop, now, shop.live);
+  return (
+    <>
+      <ShopWatch active={phase === "arriving"} />
+      <Link to={`/members/drops/${drop.id}`} className="ig-card-link">
+      <BudGlyph species={speciesIndex(drop.species)} accent={drop.accent} open={5} size={44} stem={false} className="ig-card-bud" />
+      <span className="ig-card-text">
+        <span className={eyebrow}>{phase === "public" ? "Now on the shop" : phase === "arriving" ? "Opening shortly" : "Open now · a first look"}</span>
+        <span className="ig-card-title">{drop.title}</span>
+        <span className="ig-card-more">See the drop →</span>
+      </span>
+      </Link>
+    </>
+  );
+};
+
+/* The next drop, or, with none set, the honest word and New in the garden. */
+const NextDropCard = ({ drop, now }: { drop: Drop | undefined; now: number }) => (
+  <Link to={drop ? `/members/drops/${drop.id}` : "/members/drops"} className="ig-card-link">
+    <BudGlyph species={speciesIndex(drop?.species ?? "camellia")} accent={drop?.accent ?? "#E5B9A4"} open={drop ? petalsOpen(msUntil(drop, now)) : 0} size={44} stem={false} className="ig-card-bud" />
+    <span className="ig-card-text">
+      <span className={eyebrow}>{drop ? "The next drop" : "Drops"}</span>
+      <span className="ig-card-title">{drop ? drop.title : "No drop is open right now"}</span>
+      <span className="ig-card-more">{drop ? `Opens ${formatIstOpening(drop.membersFrom)} →` : "New in the garden →"}</span>
+    </span>
+  </Link>
+);
+
+const GardenHome = () => {
+  const member = useMember();
+  const { user, firstName, doorsPlayed, markDoorsPlayed, drops, naira, arrival, month, firstVisit, arrivalProfile, garden: overrides } = member;
+  // The sky in India now, today's festival row (the owner's table), and the atelier's notes.
+  const hour = useSkyHour(overrides?.hour);
+  const season = useMemo(() => seasonOn(overrides?.seasons ?? SEASONS), [overrides]);
+  const notes = useMemo(() => notesFor(overrides?.notes ?? NOTES), [overrides]);
+  const sky = useDecoration(SkyLayer, skyDraws(hour));
+  const festival = useDecoration(FestivalDressing, season !== null);
+  const notesIn = useDecoration(AtelierNote, notes.length > 0);
+  const marks = useMemo(() => phaseBoundaries(drops), [drops]);
+  const now = useServerNow(marks, drops.length > 0);
+  const ordered = useMemo(() => byOpening(drops), [drops]);
+  // The next drop to open (its bud waits in the back row), and the latest one open now.
+  const next = ordered.find((d) => now < timeOf(d.membersFrom));
+  const current = [...ordered].reverse().find((d) => now >= timeOf(d.membersFrom) && now < timeOf(d.everyoneFrom) + VAULT_AFTER_MS);
+  const stone = stoneForMonth(month);
+  const plantedOn = formatIstDate(user.created_at);
+  // Her pressed flowers and her drawer's sprigs, as her garden card draws them too.
+  const { flowers, sprigs } = useGardenPlants();
+  const ring = naira.ring;
+  const [greeting] = useState(() => greetingFor(new Date()));
+  const [doors, setDoors] = useState<DoorsMode | null>(() => pickDoors(doorsPlayed));
+  const firstOfDay = useRef(doors === "full");
+  const bedRef = useRef<GardenBedHandle>(null);
+  const headRef = useRef<HTMLDivElement>(null);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const growingRef = useRef<HTMLHeadingElement>(null);
+  const onArrivalClosed = useCallback(() => growingRef.current?.focus(), []);
+  const petalRef = useRef<HTMLDivElement>(null);
+  const hintTimer = useRef(0);
+
+  useEffect(() => {
+    if (firstVisit) void ArrivalRepair.preload();
+  }, [firstVisit]);
+
+  useEffect(() => {
+    markDoorsPlayed();
+    if (doors === "full") recordFullDoors();
+    // Arriving with no entrance to watch (reduced motion, or back from another
+    // room), the heading takes focus at once, as a new page's should.
+    if (!doors) h1Ref.current?.focus({ preventScroll: true });
+    return () => window.clearTimeout(hintTimer.current);
+    // On arrival only.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const reveal = useCallback((short: boolean) => {
+    bedRef.current?.bloomIn(short);
+    play(headRef.current, [{ opacity: 0, transform: "translateY(12px)" }, { opacity: 1, transform: "none" }], {
+      duration: short ? 300 : 600,
+      delay: short ? 0 : 80,
+      easing: EASE_REVEAL,
+      fill: "backwards",
+    });
+  }, []);
+
+  const done = useCallback(() => {
+    setDoors(null);
+    h1Ref.current?.focus({ preventScroll: true });
+    // After the day's first entrance, one flower opens by itself: the garden can be tapped.
+    if (firstOfDay.current) hintTimer.current = window.setTimeout(() => bedRef.current?.hint(), 450);
+  }, []);
+
+  return (
+    <PortalShell title="Your garden" description="Your garden in the Inner Garden, Naira Flore's members' portal.">
+      {doors && <DoorsOpen mode={doors} name={firstName} greeting={greeting} onReveal={reveal} onDone={done} petalLayer={petalRef} />}
+      <div ref={petalRef} className="ig-petal-layer" aria-hidden />
+      <div className="ig-home">
+        <div ref={headRef} className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1 ig-h1--greet">
+            {greeting}, <em>{firstName}</em>
+          </h1>
+          <p className="ig-lede">Grown from your own seed. Tap it, and it blooms.</p>
+        </div>
+
+        <div className="ig-bed-wrap">
+          <GardenBed
+            ref={bedRef}
+            seed={user.id}
+            stone={stone}
+            plantedOn={plantedOn}
+            stoneLabel={stone ? shownName(stone.variant) : "Waiting"}
+            stoneCaption="Your colour"
+            pressed={flowers}
+            fitted={Boolean(ring)}
+            saved={sprigs}
+            sky={hour}
+            behind={sky.shown ? <SkyLayer hour={hour} seed={user.id} part="back" arriving={sky.arriving} /> : null}
+          >
+            {next && (
+              <DropBud
+                to={`/members/drops/${next.id}`}
+                species={speciesIndex(next.species)}
+                accent={next.accent}
+                open={petalsOpen(msUntil(next, now))}
+                day={istOpensWhen(next.membersFrom, now) ?? ""}
+                label={`${next.title}, the next drop: opens ${formatIstOpening(next.membersFrom)}`}
+                x={hashString(user.id) % 2 ? 300 : 92}
+              />
+            )}
+            {sky.shown && <SkyLayer hour={hour} seed={user.id} part="front" arriving={sky.arriving} />}
+            {festival.shown && season && <FestivalDressing dressing={season.dressing} seed={user.id} night={hour === "night"} />}
+          </GardenBed>
+        </div>
+
+        <section className="ig-section" aria-labelledby="ig-today">
+          <h2 id="ig-today" className="ig-h2">
+            In your garden
+          </h2>
+          {current ? <OpenDropCard drop={current} now={now} /> : <NextDropCard drop={next} now={now} />}
+          <Link to="/members/stone" className="ig-card-link">
+            <StoneHead stone={stone} size={56} />
+            <span className="ig-card-text">
+              <span className={eyebrow}>{stone ? `${stone.monthName}'s colour` : "Your stone"}</span>
+              <span className="ig-card-title">{stone ? shownName(stone.variant) : "Waiting for your birthday"}</span>
+              <span className="ig-card-more">{stone ? "Your birthstone heart" : "Tell us your month"} →</span>
+            </span>
+          </Link>
+          <Link to="/members/card" className="ig-card-link">
+            <svg viewBox="0 0 56 56" width="56" height="56" aria-hidden className="ig-card-bud">
+              <rect x="17" y="6" width="22" height="40" fill="var(--ig-vellum)" stroke="var(--nf-accent-strong)" strokeWidth="1" />
+              <path d="M28 40V27M28 33C25.5 32.4 24 30.6 23.8 28.4 26.2 28.7 27.7 30.5 28 33Z" fill="none" stroke="#8FAAA4" strokeWidth="1" />
+              {[0, 72, 144, 216, 288].map((a) => (
+                <ellipse key={a} cx="28" cy="18.6" rx="2" ry="3" transform={`rotate(${a} 28 22)`} fill="var(--nf-blush)" />
+              ))}
+              <circle cx="28" cy="22" r="1.4" fill="var(--nf-accent)" />
+            </svg>
+            <span className="ig-card-text">
+              <span className={eyebrow}>Your garden card</span>
+              <span className="ig-card-title">A picture of your garden</span>
+              <span className="ig-card-more">To keep, or to share →</span>
+            </span>
+          </Link>
+        </section>
+
+        {/* The atelier's notes, when the owner has written one: each a pressed flower she can unfold. */}
+        {notesIn.shown && (
+          <section className="ig-section" aria-labelledby="ig-atelier">
+            <h2 id="ig-atelier" className="ig-h2">
+              From the atelier
+            </h2>
+            <ul style={NOTE_LIST}>
+              {notes.map((n) => (
+                <AtelierNote key={n.id} note={n} />
+              ))}
+            </ul>
+          </section>
+        )}
+
+        {/* Her first signed-in visit only: the list, and the ad-matching box unticked,
+            if either is missing. Never over the Doors; once she has seen it on this phone, never again, and never on a later day. */}
+        <Suspense fallback={null}>
+          {firstVisit && !doors && <ArrivalRepair user={user} profile={arrivalProfile} actions={arrival} onClosed={onArrivalClosed} />}
+        </Suspense>
+
+        <section className="ig-section" aria-labelledby="ig-growing">
+          <h2 id="ig-growing" ref={growingRef} tabIndex={-1} className="ig-h2">
+            What's growing
+          </h2>
+          <ul className="ig-growing">
+            <li>
+              <strong>The Naira flower</strong>
+              {plantedOn ? `, planted ${plantedOn}, the day you joined.` : ", planted the day you joined."}
+            </li>
+            <li>
+              {stone ? (
+                <>
+                  <strong>Your stone flower</strong>, {shownName(stone.variant)}, in your month's colour.
+                </>
+              ) : (
+                <>
+                  <strong>A bud for your stone</strong>, waiting for your birthday.
+                </>
+              )}
+            </li>
+            {flowers.map((f) => (
+              <li key={f.id}>
+                <strong>The {f.title} flower</strong>
+                {f.on ? `, pressed ${formatIstDay(`${f.on}T12:00:00+05:30`)}.` : ", pressed."}
+              </li>
+            ))}
+            {ring && (
+              <li>
+                <strong>A ring of buds</strong>, for your size: US {ring.us}, kept {formatIstDay(`${ring.at}T12:00:00+05:30`)}.
+              </li>
+            )}
+            {sprigs.length > 0 && (
+              <li>
+                <strong>Sprigs for the pieces in your drawer</strong>, each tip gold or silver as the piece is.
+              </li>
+            )}
+            {next && (
+              <li>
+                <strong>A sealed bud</strong>, {next.title}, the next drop: it opens {formatIstOpening(next.membersFrom)}.
+              </li>
+            )}
+            {hour !== "day" && (
+              <li>
+                <strong>{SKY_WORDS[hour][0]}</strong>
+                {SKY_WORDS[hour][1]}
+              </li>
+            )}
+            {season && (
+              <li>
+                <strong>{FESTIVAL_WORDS[season.dressing][0]}</strong>
+                {FESTIVAL_WORDS[season.dressing][1]}
+              </li>
+            )}
+            <li>
+              <strong>Grasses, sprigs, buds and blooms</strong> grown from your own seed: the same garden on every visit, and
+              yours alone.
+            </li>
+          </ul>
+          <p className="ig-fineprint">Your garden is for joy. Nothing in it is points, and nothing in it can be redeemed.</p>
+        </section>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default GardenHome;
