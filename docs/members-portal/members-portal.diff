+import { stillMotion } from "./motion";
+import type { Reading } from "./stoneLight";
+
+/*
+  Her phone's tilt for Stone Light, and only after she asks for it: nothing
+  here listens until her tap on "Tilt your phone". On an iPhone that tap is
+  also where Safari's permission is asked (DeviceOrientationEvent.
+  requestPermission must be called inside the click itself, so `ask` calls
+  it first, before anything waits). A refusal, or a phone that sends no
+  reading within a second (a laptop, a sensor that is off), hands back to
+  the drag. Readings go only to the drawing: never kept, never sent, and
+  the permission is not remembered.
+*/
+
+type Orientation = { requestPermission?: () => Promise<string> };
+
+const orientationApi = (): (typeof DeviceOrientationEvent & Orientation) | null => {
+  try {
+    return typeof window !== "undefined" && "DeviceOrientationEvent" in window ? (window.DeviceOrientationEvent as typeof DeviceOrientationEvent & Orientation) : null;
+  } catch {
+    return null;
+  }
+};
+
+const coarse = (): boolean => {
+  try {
+    return window.matchMedia("(pointer: coarse)").matches;
+  } catch {
+    return false;
+  }
+};
+
+/** Whether to offer "Tilt your phone": the browser has the sensor's event, a finger is the pointer, and motion is allowed (never under reduced motion or Data Saver). */
+export const motionOffered = (): boolean => Boolean(orientationApi()) && coarse() && !stillMotion();
+
+/** How long a granted sensor may stay silent before the drag takes over. */
+export const SILENT_MS = 1000;
+
+export type MotionEnd = "denied" | "silent";
+
+export type MotionHandlers = {
+  onReading: (r: Reading) => void;
+  /** Refused, or nothing arrived within SILENT_MS: the listener is already off. */
+  onEnd: (why: MotionEnd) => void;
+};
+
+export type MotionHandle = {
+  /** Takes the listener off (after 20 s without her touch, off screen, the tab hidden); resume puts it back without asking again. */
+  pause: () => void;
+  resume: () => void;
+  /** Off for good. */
+  stop: () => void;
+};
+
+/**
+ * Called from her tap's click handler. Asks iOS first (inside the click),
+ * then listens; the first second must bring a reading or the drag takes over.
+ */
+export const startMotion = (handlers: MotionHandlers): MotionHandle => {
+  const api = orientationApi();
+  let asked: Promise<string>;
+  try {
+    // First, while the tap is still the user's gesture.
+    asked = typeof api?.requestPermission === "function" ? api.requestPermission() : Promise.resolve(api ? "granted" : "denied");
+  } catch {
+    asked = Promise.resolve("denied");
+  }
+  let stopped = false;
+  let listening = false;
+  let heard = false;
+  let wait = 0;
+
+  const onEvent = (e: DeviceOrientationEvent) => {
+    if (e.beta === null || e.gamma === null || !Number.isFinite(e.beta) || !Number.isFinite(e.gamma)) return;
+    heard = true;
+    handlers.onReading({ beta: e.beta, gamma: e.gamma });
+  };
+  let granted = false;
+  // The second of silence is counted only while the sensor is listened to: granted while asleep, it starts when she wakes it.
+  const listen = () => {
+    if (stopped || listening) return;
+    listening = true;
+    window.addEventListener("deviceorientation", onEvent);
+    if (granted && !heard && !wait)
+      wait = window.setTimeout(() => {
+        if (!heard) end("silent");
+      }, SILENT_MS);
+  };
+  const unlisten = () => {
+    if (!listening) return;
+    listening = false;
+    window.removeEventListener("deviceorientation", onEvent);
+    if (!heard) {
+      window.clearTimeout(wait);
+      wait = 0;
+    }
+  };
+  let asleep = false;
+  const end = (why: MotionEnd) => {
+    if (stopped) return;
+    stopped = true;
+    window.clearTimeout(wait);
+    unlisten();
+    handlers.onEnd(why);
+  };
+
+  void asked.then(
+    (state) => {
+      if (stopped) return;
+      if (state !== "granted") {
+        end("denied");
+        return;
+      }
+      granted = true;
+      if (!asleep) listen();
+    },
+    () => end("denied"),
+  );
+
+  return {
+    pause: () => {
+      asleep = true;
+      unlisten();
+    },
+    resume: () => {
+      asleep = false;
+      void asked.then((state) => {
+        if (state === "granted" && !asleep) listen();
+      });
+    },
+    stop: () => {
+      stopped = true;
+      window.clearTimeout(wait);
+      unlisten();
+    },
+  };
+};
diff --git a/src/lib/portal/newIn.test.ts b/src/lib/portal/newIn.test.ts
