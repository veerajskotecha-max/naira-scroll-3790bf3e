+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/* The gem on Your stone with three.js's renderer stood in (jsdom has no
+   WebGL; the geometry, the material and the mesh are three.js's own): about
+   140 flat triangles wound outward, at no more than 2 device pixels and
+   without shadows, a turn-in that is the probe, frames drawn only when
+   asked, one portal scene at a time (shared with the Bloom Field), and a
+   dispose that frees everything and gives the context back. */
+
+const gl = vi.hoisted(() => ({
