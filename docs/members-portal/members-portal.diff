+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+
+/*
+  The design system: headings in Auth, Account and the Inner Circle are set
+  in the brand serif through the site's own token (var(--nf-font-display):
+  Velista, then Cormorant Garamond). The old const began with
+  var(--font-cormorant), which nothing defines, so the browser dropped the
+  whole declaration and the heading's first words came out in the sans stack.
+  Small gold lettering uses the AA gold (text-nf-gold-text, #80612A), never
+  the eyebrow gold #B0843A, which is 3.1:1 on ivory.
+*/
+
+const read = (page: string) => readFileSync(resolve(__dirname, page), "utf8");
+
+describe.each(["Auth.tsx", "Account.tsx", "InnerCircle.tsx"])("%s", (page) => {
+  const source = read(page);
+
+  it("never names the undefined --font-cormorant", () => {
+    expect(source).not.toMatch(/--font-cormorant/);
+    expect(source).not.toMatch(/\bvelista\b/);
+  });
+
+  it("sets its h1 in the display token", () => {
+    expect(source).toMatch(/const display = \{ fontFamily: "var\(--nf-font-display\)" \} as const;/);
+    expect(source).toMatch(/<h1[^>]*style=\{display\}/);
+  });
+
+  it("keeps small gold capitals in the AA gold", () => {
+    expect(source).not.toMatch(/text-\[(9|10)px\][^"]*text-\[#B0843A\]/);
+  });
+});
