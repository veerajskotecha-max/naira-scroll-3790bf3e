+    const z = Number(/z-index: (\d+)/.exec(rule)?.[1]);
+    expect(z).toBeLessThanOrEqual(38);
+    expect(rule).not.toMatch(/position: fixed/);
+  });
+
+  it("puts the gem away when she leaves the room", async () => {
+    t2.tier = 2;
+    const { unmount } = render(<StoneLight stone={july} />);
+    await idle();
+    const handle = t2.handle!;
+    unmount();
+    expect(handle.dispose).toHaveBeenCalledTimes(1);
+  });
+
+  it("fetches nothing of the gem until its panel comes (nearly) into view", async () => {
+    t2.tier = 2;
+    const seen: { options?: IntersectionObserverInit; fire: (hit: boolean) => void }[] = [];
+    vi.stubGlobal(
+      "IntersectionObserver",
+      class {
+        constructor(cb: IntersectionObserverCallback, options?: IntersectionObserverInit) {
+          seen.push({ options, fire: (hit) => cb([{ isIntersecting: hit } as IntersectionObserverEntry], this as unknown as IntersectionObserver) });
+        }
+        observe() {}
+        disconnect() {}
+        unobserve() {}
+        takeRecords() {
+          return [];
+        }
+      },
+    );
+    render(<StoneLight stone={july} />);
+    await idle();
+    expect(t2.loads).toBe(0);
+    const gemIo = seen.find((o) => o.options?.rootMargin === "0px 0px 25% 0px");
+    expect(gemIo?.options?.threshold).toBe(0.2);
+    act(() => gemIo!.fire(false));
+    await idle();
+    expect(t2.loads).toBe(0);
+    act(() => gemIo!.fire(true));
+    await idle();
+    expect(t2.loads).toBe(1);
+    expect(t2.canvas?.parentElement).toBe(panel());
+    vi.unstubAllGlobals();
+  });
+
+  it("swaps at once where the browser has no animations, never leaving a live gem unseen", async () => {
+    t2.tier = 2;
+    render(<StoneLight stone={july} />);
+    await idle();
+    act(() => t2.options!.onReady());
+    expect((panel().querySelector(".ig-sl-stone") as SVGGElement).style.opacity).toBe("0");
+    expect(t2.canvas?.style.opacity).toBe("1");
+  });
+
+  it("claims the gem again when she comes back after the tab was hidden for 10 s", async () => {
+    t2.tier = 2;
+    render(<StoneLight stone={july} />);
+    await idle();
+    const first = t2.handle!;
+    vi.useFakeTimers({ toFake: ["setTimeout", "clearTimeout"] });
+    let state = "hidden";
+    Object.defineProperty(document, "visibilityState", { configurable: true, get: () => state });
+    act(() => void document.dispatchEvent(new Event("visibilitychange")));
+    act(() => void vi.advanceTimersByTime(10_100));
+    expect(first.dispose).toHaveBeenCalledTimes(1);
+    expect(panel().querySelector("canvas")).toBeNull();
+    vi.useRealTimers();
+    state = "visible";
+    act(() => void document.dispatchEvent(new Event("visibilitychange")));
+    await idle();
+    expect(t2.loads).toBe(2);
+    expect(t2.handle).not.toBe(first);
