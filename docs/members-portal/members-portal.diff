@@ -0,0 +1,120 @@
+import { describe, expect, it } from "vitest";
+import { BANDS, BED, GIFT_GAP, GIFT_POST_X, GIFT_REACH, GIFT_TICKS, MAX_PLANTS, MAX_SWAY, giftsOnArbour, layoutGarden } from "./gardenLayout";
+
+/* Her garden is hers: the same id grows the same bed on every visit and
+   device, and the bed stays inside the budgets a mid-range Android can
+   composite without dropping frames (80 plants, 24 swaying). */
+describe("the seeded garden", () => {
+  const ids = ["3f2c9a1e-0b7d-4c55-9a51-7e7e2d1c0a11", "preview-ananya", "a", "", "naira-flore-gate"];
+
+  it("grows the same garden from the same id", () => {
+    for (const id of ids) expect(layoutGarden(id)).toEqual(layoutGarden(id));
+  });
+
+  it("grows a different garden for a different member", () => {
+    const a = layoutGarden(ids[0]).plants.map((p) => [p.kind, p.x, p.y]);
+    const b = layoutGarden("3f2c9a1e-0b7d-4c55-9a51-7e7e2d1c0a12").plants.map((p) => [p.kind, p.x, p.y]);
+    expect(a).not.toEqual(b);
+  });
+
+  it.each(ids)("keeps within the budgets (%s)", (id) => {
+    const { plants } = layoutGarden(id);
+    expect(plants.length).toBeLessThanOrEqual(MAX_PLANTS);
+    expect(plants.filter((p) => p.sway).length).toBeLessThanOrEqual(MAX_SWAY);
+    expect(plants.length).toBeGreaterThan(40);
+  });
+
+  it("plants her two flowers on the soil, in front, and swaying", () => {
+    const { plants, naira, stone } = layoutGarden(ids[0]);
+    expect(plants.filter((p) => p.kind === "naira")).toHaveLength(1);
+    expect(plants.filter((p) => p.kind === "stone")).toHaveLength(1);
+    for (const p of [naira, stone]) {
+      expect(p.y).toBe(BED.soil);
+      expect(p.sway).toBe(true);
+    }
+    // Painted last: nothing stands in front of them.
+    expect(plants.slice(-2).map((p) => p.kind).sort()).toEqual(["naira", "stone"]);
+  });
+
+  it("keeps every plant inside the bed and paints back to front", () => {
+    const { plants } = layoutGarden(ids[1]);
+    for (const p of plants) {
+      expect(p.x).toBeGreaterThanOrEqual(0);
+      expect(p.x).toBeLessThanOrEqual(BED.w);
+      expect(p.y).toBeLessThanOrEqual(BED.soil);
+      expect(p.band).toBeGreaterThanOrEqual(0);
+    }
+    const ys = plants.map((p) => p.y);
+    expect(ys).toEqual([...ys].sort((a, b) => a - b));
+  });
+
+  /* The bed blooms in by band, one animation per band: grouping the plants
+     that way must keep the painter's order. */
+  it.each(ids)("stands in at most twelve bands, in painting order (%s)", (id) => {
+    const bands = layoutGarden(id).plants.map((p) => p.band);
+    expect(bands).toEqual([...bands].sort((a, b) => a - b));
+    expect(Math.max(...bands)).toBeLessThan(BANDS);
+  });
+
+  /* One breeze rolling left to right, not jitter: the same pace for every
+     plant, each starting a little behind its neighbour on the left. */
+  it("sways as one breeze", () => {
+    const swaying = layoutGarden(ids[0]).plants.filter((p) => p.sway);
+    const durs = swaying.map((p) => p.swayDur);
+    expect(Math.max(...durs) - Math.min(...durs)).toBeLessThan(0.35);
+    for (const a of swaying) {
+      for (const b of swaying) {
+        if (b.x - a.x > 100) expect(a.swayPhase).toBeGreaterThan(b.swayPhase);
+      }
+    }
+  });
+});
+
+/* Her gift dates (Phase 4): a small stone flower each on the arbour's
+   posts, her year round the doorway, never crowding a plant or each other. */
+describe("her gift dates on the arbour", () => {
+  const g = (m: number, d: number, n = "Mum") => ({ n, m, d });
+
+  it("climbs the left post from January to June and comes down the right from July to December", () => {
+    const [jan, jun, jul, dec] = giftsOnArbour([g(1, 1), g(6, 30), g(7, 1), g(12, 31)]);
+    expect([jan.x, jun.x, jul.x, dec.x]).toEqual([GIFT_POST_X[0], GIFT_POST_X[0], GIFT_POST_X[1], GIFT_POST_X[1]]);
+    expect(jan.y).toBeGreaterThan(GIFT_TICKS[1] - 1);
+    expect(jun.y).toBeLessThan(GIFT_TICKS[0] + 1);
+    expect(jul.y).toBeLessThan(GIFT_TICKS[0] + 1);
+    expect(dec.y).toBeGreaterThan(GIFT_TICKS[1] - 1);
+    expect([jan, jun, jul, dec].map((b) => b.month)).toEqual([1, 6, 7, 12]);
+  });
+
+  it("stands each month between two of the posts' ticks, at its day", () => {
+    for (let m = 1; m <= 12; m++) {
