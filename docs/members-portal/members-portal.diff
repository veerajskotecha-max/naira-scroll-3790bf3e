+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/* The one way in to Tier 2's code. Under reduced motion, Data Saver or on a
+   Tier 1 phone neither the Bloom Field's scene (three.js) nor the gsap
+   choreography is ever imported; on a capable phone each is imported once.
+   A chunk of theirs that fails to arrive is a fallback, never the page's
+   stale-chunk reload; a room's own chunk still reaches that reload. */
+
+const loads = vi.hoisted(() => ({ scene: 0, gsap: 0, gem: 0, fail: "" }));
+
+const preloadError = (file: string) =>
+  Object.assign(new Event("vite:preloadError", { cancelable: true }), { payload: new Error(`Failed to fetch dynamically imported module: https://nairaflore.com/assets/${file}`) });
+
+type Nav = Navigator & { connection?: unknown; deviceMemory?: number };
+const device = ({ reduce = false, saveData = false, memory = 8 } = {}) => {
+  window.matchMedia = ((query: string) => ({ matches: reduce && query.includes("reduce"), media: query, addEventListener() {}, removeEventListener() {} })) as unknown as typeof window.matchMedia;
+  Object.defineProperty(navigator, "connection", { configurable: true, value: { saveData, effectiveType: "4g" } });
+  Object.defineProperty(navigator, "deviceMemory", { configurable: true, value: memory });
+  (window as unknown as Record<string, unknown>).WebGLRenderingContext = function WebGLRenderingContext() {};
+};
+
+/* A fresh copy of the loaders (and their gate) for each case, with the two
+   chunks stood in: each counts its import, and can fail as a download does. */
+const fresh = async () => {
+  vi.resetModules();
+  vi.doMock("@/lib/portal/scene", () => {
+    loads.scene += 1;
+    if (loads.fail === "scene") {
+      // As Vite's preload helper does: the event first, then the rejection.
+      window.dispatchEvent(preloadError("scene-Bq9CShF5.js"));
+      throw new Error("Failed to fetch dynamically imported module: https://nairaflore.com/assets/scene-Bq9CShF5.js");
+    }
+    return { mountBloomField: vi.fn() };
+  });
+  vi.doMock("@/lib/portal/gem/scene", () => {
+    loads.gem += 1;
+    if (loads.fail === "gem") {
+      window.dispatchEvent(preloadError("scene-Gm4Hx2Lp.js"));
+      throw new Error("Failed to fetch dynamically imported module: https://nairaflore.com/assets/scene-Gm4Hx2Lp.js");
+    }
+    return { mountGem: vi.fn() };
+  });
+  vi.doMock("@/lib/portal/unboxGsap", () => {
+    loads.gsap += 1;
+    if (loads.fail === "gsap") {
+      window.dispatchEvent(preloadError("unboxGsap-Cx1.js"));
+      throw new Error("Importing a module script failed.");
+    }
+    return { ready: Promise.resolve(), throwPetals: vi.fn(), unfoldFromBox: vi.fn(), physicsThrows: vi.fn(() => []), scatterPetals: vi.fn() };
+  });
+  const spectacle = await import("./spectacle");
+  const tier = await import("./tier");
+  return { ...spectacle, ...tier };
+};
+
+/* main.tsx's own listener: a failure that reaches it reloads the page. */
+const reloads: unknown[] = [];
+const mainListener = (e: Event & { payload?: unknown }) => reloads.push(e.payload);
+
+beforeEach(() => {
+  loads.scene = loads.gsap = loads.gem = 0;
+  loads.fail = "";
+  reloads.length = 0;
+  window.addEventListener("vite:preloadError", mainListener);
+});
+afterEach(() => {
+  window.removeEventListener("vite:preloadError", mainListener);
+  delete (navigator as Nav).connection;
+  delete (navigator as Nav).deviceMemory;
+  delete (window as unknown as Record<string, unknown>).WebGLRenderingContext;
+});
+
+describe("Tier 2's loaders", () => {
+  it("import nothing under reduced motion", async () => {
+    device({ reduce: true });
+    const s = await fresh();
+    expect(s.spectacleAllowed()).toBe(false);
+    await expect(s.loadBloomScene()).resolves.toBeNull();
+    await expect(s.loadChoreography()).resolves.toBeNull();
+    expect(s.choreographyNow()).toBeNull();
+    expect(loads).toMatchObject({ scene: 0, gsap: 0 });
+  });
+
+  it("import nothing under reduced motion even when the preview forces Tier 2", async () => {
+    device({ reduce: true });
+    const s = await fresh();
+    s.forceTier(2);
+    await s.loadBloomScene();
+    await s.loadChoreography();
+    expect(loads).toMatchObject({ scene: 0, gsap: 0 });
+  });
+
+  it("import nothing under Data Saver, or on a Tier 1 phone", async () => {
+    device({ saveData: true });
+    let s = await fresh();
+    await s.loadBloomScene();
+    await s.loadChoreography();
+    device({ memory: 2 });
+    s = await fresh();
+    await s.loadBloomScene();
+    await s.loadChoreography();
+    expect(loads).toMatchObject({ scene: 0, gsap: 0 });
+  });
+
+  it("import each once on a capable phone", async () => {
+    device();
+    const s = await fresh();
+    expect(s.spectacleAllowed()).toBe(true);
+    expect(s.choreographyNow()).toBeNull();
+    const [scene, gsap] = await Promise.all([s.loadBloomScene(), s.loadChoreography()]);
+    expect(scene?.mountBloomField).toBeTypeOf("function");
+    expect(gsap?.throwPetals).toBeTypeOf("function");
+    await s.loadBloomScene();
+    await s.loadChoreography();
+    expect(loads).toMatchObject({ scene: 1, gsap: 1 });
+    expect(s.choreographyNow()).toBe(gsap);
+    // Demoted mid-visit (the probe): the choreography already here is no longer used.
+    s.demoteTier();
+    expect(s.choreographyNow()).toBeNull();
+  });
+
+  it("falls back when the scene cannot arrive, keeps the page from its reload, and stays on Tier 1 for the visit", async () => {
+    device();
+    loads.fail = "scene";
+    const s = await fresh();
+    await expect(s.loadBloomScene()).resolves.toBeNull();
+    expect(reloads).toEqual([]);
+    expect(s.portalTier()).toBe(1);
+  });
+
+  it("falls back when the choreography cannot arrive, even reported without a file name", async () => {
+    device();
+    loads.fail = "gsap";
+    const s = await fresh();
+    await expect(s.loadChoreography()).resolves.toBeNull();
+    expect(reloads).toEqual([]);
+    expect(s.choreographyNow()).toBeNull();
+  });
+
+  /* Phase 6: the gem on Your stone, through the same gate. */
+  it("never import the gem under reduced motion, Data Saver or on a Tier 1 phone, even when the preview forces Tier 2", async () => {
+    for (const d of [{ reduce: true }, { saveData: true }, { memory: 2 }]) {
+      device(d);
+      const s = await fresh();
+      s.forceTier(d.memory ? null : 2);
+      await expect(s.loadGemScene()).resolves.toBeNull();
+    }
+    expect(loads.gem).toBe(0);
+  });
+
+  it("import the gem once on a capable phone, and nothing else with it", async () => {
+    device();
+    const s = await fresh();
+    const gem = await s.loadGemScene();
+    expect(gem?.mountGem).toBeTypeOf("function");
+    await s.loadGemScene();
+    expect(loads).toMatchObject({ gem: 1, scene: 0, gsap: 0 });
+  });
+
+  it("fall back when the gem cannot arrive, keep the page from its reload, and stay on Tier 1 for the visit", async () => {
+    device();
+    loads.fail = "gem";
+    const s = await fresh();
+    await expect(s.loadGemScene()).resolves.toBeNull();
+    expect(reloads).toEqual([]);
+    expect(s.portalTier()).toBe(1);
+    await expect(s.loadGemScene()).resolves.toBeNull();
+    expect(loads.gem).toBe(1);
+  });
+
+  it("leaves a room's own failed chunk to the reload", async () => {
+    device();
+    const s = await fresh();
+    expect(s.isSpectacleFailure(new Error("Failed to fetch dynamically imported module: https://nairaflore.com/assets/DropRoom-y-4QfaDk.js"))).toBe(false);
+    expect(s.isSpectacleFailure(new Error("Unable to preload CSS for /assets/DropRoom-CqgMqcNi.css"))).toBe(false);
+    for (const ours of ["scene-BTHBexj2.js", "three-sES_xdo2.js", "RoomEnvironment-C3dwkj56.js", "unboxGsap-DuHua3NL.js", "gsap-SFc2wnMY.js", "Flip-Blvo3Ljq.js", "Physics2DPlugin-C6kGFMv_.js"]) {
+      expect(s.isSpectacleFailure(new Error(`Failed to fetch dynamically imported module: https://nairaflore.com/assets/${ours}`)), ours).toBe(true);
+    }
+    // And nothing is held back once the loaders are done.
+    await s.loadBloomScene();
+    window.dispatchEvent(preloadError("DropRoom-y-4QfaDk.js"));
+    expect(reloads).toHaveLength(1);
+  });
+});
