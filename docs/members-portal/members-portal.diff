+import { fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { describe, expect, it, vi } from "vitest";
+import { MemberProvider, type Member } from "./MemberContext";
+import { readNaira } from "@/lib/portal/memberMeta";
+
+/*
+  Written in your sky (Phase 6): the star sheet is an optional night
+  decoration. If its chunk cannot arrive when she taps "Look up" (a moment
+  offline at night), the garden says so beside "Look up" with a "Try
+  again"; it never reaches the app's error boundary and never takes her
+  garden down with it.
+*/
+
+const fetched = vi.hoisted(() => ({ tries: 0 }));
+vi.mock("./StarSheet", () => {
+  fetched.tries++;
+  throw new Error("offline");
+});
+vi.mock("@/contexts/WishlistContext", () => ({ useWishlist: () => ({ items: [] }) }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => null }));
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => ({ jewellery: [], isLive: false, isLoading: false }) }));
+vi.mock("@/integrations/supabase/lazy", () => ({
+  getSupabase: vi.fn(async () => {
+    const q = { select: () => q, eq: () => q, order: () => q, limit: () => Promise.resolve({ data: [], error: null }) };
+    return { from: () => q };
+  }),
+}));
+
+import GardenHome from "@/pages/members/GardenHome";
+
+const USER = "4c1f0a52-7e7e-4c55-9a51-000000000002";
+const member = (): Member =>
+  ({
+    user: { id: USER, email: "ananya@example.com", created_at: "2026-11-01T05:00:00Z", user_metadata: {} },
+    profile: { id: USER, full_name: "Ananya", birthday: "1999-07-14", phone: null, city: null },
+    firstName: "Ananya",
+    preview: false,
+    saveBirthday: async () => ({ ok: true }),
+    addToBag: async () => true,
+    buyNow: async () => {},
+    bagBusy: false,
+    doorsPlayed: true,
+    markDoorsPlayed: () => {},
+    drops: [],
+    unlisted: [],
+    pressed: [],
+    press: () => {},
+    naira: readNaira(null),
+    changeMeta: () => ({ ok: true }),
+    savedSync: { h: [], x: [] },
+    keepSavedSync: () => {},
+    metaProblem: null,
+    retryMeta: () => {},
+    since: null,
+    month: 7,
+    firstVisit: false,
+    arrivalProfile: null,
+    arrival: { hasOwnSignup: async () => true, join: async () => ({ ok: true, already: true }), saveConsent: async () => ({ ok: true }) },
+    garden: { hour: "night" },
+    checkoutsPreview: [],
+  }) as unknown as Member;
+
+describe("the star sheet's chunk, when it cannot arrive", () => {
+  it("says so beside 'Look up', offers to try again, and leaves the garden standing", async () => {
+    render(
+      <MemoryRouter>
+        <MemberProvider value={member()}>
+          <GardenHome />
+        </MemberProvider>
+      </MemoryRouter>,
+    );
+    const look = screen.getByRole("button", { name: "Look up" });
+    fireEvent.click(look);
+    expect(await screen.findByText(/We couldn't open the night sky just now\./)).toBeInTheDocument();
+    expect(look).toHaveAttribute("aria-expanded", "false");
+    expect(screen.getByRole("heading", { name: /Good (morning|afternoon|evening)|Ananya/ })).toBeInTheDocument();
+    const before = fetched.tries;
+    fireEvent.click(screen.getByRole("button", { name: "Try again" }));
+    expect(await screen.findByText(/We couldn't open the night sky just now\./)).toBeInTheDocument();
+    expect(fetched.tries).toBeGreaterThan(before);
+  });
+});
