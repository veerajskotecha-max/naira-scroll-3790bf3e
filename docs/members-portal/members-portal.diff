+import { PETAL_IDS } from "./PetalSymbols";
+import { EASE_IN, play, stillMotion } from "@/lib/portal/motion";
+import { clampCount, petalNode, settle, type PetalOptions } from "./petalFlight";
+
+/**
+ * Petals thrown up from the latch that then drift down, swaying, over the
+ * garden the gates have opened on. Meant for a layer that outlasts the
+ * Doors, so the petals land on her garden instead of vanishing with the
+ * curtain.
+ */
+export const fallPetals = (layer: HTMLElement | null, x: number, y: number, options: PetalOptions = {}): Animation[] => {
+  if (!layer || stillMotion()) return [];
+  const count = clampCount(options.count, 24);
+  const ids = options.ids ?? PETAL_IDS;
+  const [sMin, sMax] = options.size ?? [13, 24];
+  const base = options.duration ?? 1550;
+  const out: Animation[] = [];
+  const t = (fx: number, fy: number, r: number, s = 1) =>
+    `translate(-50%,-50%) translate(${fx.toFixed(1)}px,${fy.toFixed(1)}px) rotate(${r.toFixed(0)}deg) scale(${s})`;
+  for (let i = 0; i < count; i++) {
+    const svg = petalNode(layer, x, y, ids[i % ids.length], sMin + Math.random() * (sMax - sMin));
+    const side = count > 1 ? (i / (count - 1)) * 2 - 1 : 0;
+    const outX = side * (60 + Math.random() * 110);
+    const up = 40 + Math.random() * 40;
+    const fall = 260 + Math.random() * 80;
+    const sway = 12 + Math.random() * 10;
+    const turn = (360 + Math.random() * 360) * (Math.random() < 0.5 ? -1 : 1);
+    const a = play(
+      svg,
+      [
+        { transform: t(0, 0, 0, 0.3), opacity: 0, easing: "cubic-bezier(0.2, 0.8, 0.4, 1)" },
+        { transform: t(outX * 0.45, -up, turn * 0.2), opacity: 1, offset: 0.2, easing: "ease-in-out" },
+        { transform: t(outX * 0.7 + sway, -up + fall * 0.35, turn * 0.5), opacity: 1, offset: 0.5, easing: "ease-in-out" },
+        { transform: t(outX * 0.85 - sway, -up + fall * 0.7, turn * 0.8), opacity: 0.9, offset: 0.78, easing: EASE_IN },
+        { transform: t(outX, -up + fall, turn, 0.9), opacity: 0 },
+      ],
+      { duration: base * (0.85 + Math.random() * 0.3), delay: (options.delay ?? 0) + Math.random() * 90, easing: "linear", fill: "both" },
+    );
+    settle(svg, a, out);
+  }
+  return out;
+};
