+import { describe, expect, it } from "vitest";
+import { DEFAULT_NEXT, authPath, sameSiteNext } from "./next";
+
+/* ?next= is written by anyone who can send a link to /auth, so it may only
+   ever name a page on this site. */
+const ORIGIN = "https://nairaflore.com";
+
+describe("sameSiteNext", () => {
+  it("keeps a page on this site, query and fragment included", () => {
+    expect(sameSiteNext("/members", ORIGIN)).toBe("/members");
+    expect(sameSiteNext("/members/stone?x=1#top", ORIGIN)).toBe("/members/stone?x=1#top");
+    expect(sameSiteNext("/.lovable/oauth/consent?authorization_id=abc-123", ORIGIN)).toBe(
+      "/.lovable/oauth/consent?authorization_id=abc-123",
+    );
+  });
+
+  it.each([
+    "//evil.example",
+    "//evil.example/members",
+    "/\\evil.example",
+    "/\\\\evil.example",
+    "/members\\..\\x",
+    "/\t/evil.example",
+    "/\n/evil.example",
+    "/ /evil.example",
+    "/%0d%0a\r",
+  ])("refuses %j, which a browser can read as another site", (raw) => {
+    expect(sameSiteNext(raw, ORIGIN)).toBe(DEFAULT_NEXT);
+  });
+
+  it.each(["https://evil.example/", "http:/evil.example", "javascript:alert(1)", "data:text/html,hi", "evil.example", "members"])(
+    "refuses %j, which is not a path",
+    (raw) => {
+      expect(sameSiteNext(raw, ORIGIN)).toBe(DEFAULT_NEXT);
+    },
+  );
+
+  it("falls back to her account when there is no next, or it is absurdly long", () => {
+    expect(sameSiteNext(null, ORIGIN)).toBe(DEFAULT_NEXT);
+    expect(sameSiteNext(undefined, ORIGIN)).toBe(DEFAULT_NEXT);
+    expect(sameSiteNext("", ORIGIN)).toBe(DEFAULT_NEXT);
+    expect(sameSiteNext(`/${"a".repeat(600)}`, ORIGIN)).toBe(DEFAULT_NEXT);
+  });
+
+  it("never sends a signed-in member back to the sign-in page", () => {
+    expect(sameSiteNext("/auth", ORIGIN)).toBe(DEFAULT_NEXT);
+    expect(sameSiteNext("/auth?next=/members", ORIGIN)).toBe(DEFAULT_NEXT);
+    expect(sameSiteNext("/AUTH/", ORIGIN)).toBe(DEFAULT_NEXT);
+    expect(sameSiteNext("/authors", ORIGIN)).toBe("/authors");
+  });
+});
+
+describe("authPath", () => {
+  it("carries next along, and leaves the default off", () => {
+    expect(authPath("/members")).toBe("/auth?next=%2Fmembers");
+    expect(authPath(DEFAULT_NEXT)).toBe("/auth");
+    expect(authPath("/members", { recovery: "1" })).toBe("/auth?recovery=1&next=%2Fmembers");
+    expect(authPath(DEFAULT_NEXT, { recovery: "1" })).toBe("/auth?recovery=1");
+  });
+});
diff --git a/src/lib/auth/next.ts b/src/lib/auth/next.ts
new file mode 100644
index 0000000..4282b2a
--- /dev/null
+++ b/src/lib/auth/next.ts
@@ -0,0 +1,37 @@
+import { safeNextPath } from "@/lib/nextPath";
+
+/*
+  Where /auth sends a member once she is signed in. ?next= arrives from the
+  gate, the consent flow and our own email links, but anyone can write a link
+  to /auth, so it may only ever name a page on this site:
+
+  - it starts with exactly one "/" (no "//host", no "https:", no "javascript:");
+  - it carries no backslash, whitespace or control character, which browsers
+    quietly rewrite ("/\host" and "/<tab>/host" both read as another site);
+  - it resolves to this origin (safeNextPath, the browser's own check);
+  - it is not /auth itself, which would leave her signed in on the sign-in page.
+
+  Anything else lands on her account.
+*/
+
+export const DEFAULT_NEXT = "/account";
+const MAX = 512;
+
+export const sameSiteNext = (raw: string | null | undefined, origin = window.location.origin): string => {
+  const value = raw ?? "";
+  if (!value || value.length > MAX) return DEFAULT_NEXT;
+  if (value[0] !== "/" || value[1] === "/") return DEFAULT_NEXT;
+  // eslint-disable-next-line no-control-regex -- control characters are exactly what is refused
+  if (/[\\\s\u0000-\u001f\u007f]/.test(value)) return DEFAULT_NEXT;
+  const path = safeNextPath(value, origin);
+  if (/^\/auth(?:[/?#]|$)/i.test(path)) return DEFAULT_NEXT;
+  return path;
+};
+
+/** /auth with ?next= carried along (left off when it is the default). */
+export const authPath = (next: string, extra: Record<string, string> = {}): string => {
+  const q = new URLSearchParams(extra);
+  if (next !== DEFAULT_NEXT) q.set("next", next);
+  const query = q.toString();
+  return query ? `/auth?${query}` : "/auth";
+};
