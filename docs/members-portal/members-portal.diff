+.ig-fit .ig-lede { text-wrap: balance; }
+.ig-fit .ig-h2:focus { outline: none; }
+
+/* her size, engraved */
+.ig-kept { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.2rem; padding: 1.4rem 1rem 1.2rem; border: 1px solid var(--ig-gold-line); background: var(--ig-vellum); text-align: center; }
+.ig-kept:focus { outline: none; }
+.ig-kept:focus-visible { outline: 2px solid var(--nf-accent-strong); outline-offset: 2px; }
+.ig-kept-bloom { position: relative; display: block; height: 96px; transform-origin: 50% 70%; }
+.ig-kept-bloom svg { display: block; }
+.ig-kept-line { position: absolute; left: 0; top: 0; }
+.ig-kept-onward { display: flex; flex-wrap: wrap; justify-content: center; gap: 0 1.25rem; margin-top: 0.5rem; }
+.ig-fit-forget, .ig-fit-all { display: flex; margin: 0.6rem auto 0; }
+.ig-kept-words { margin: 0.2rem 0 0; font-family: var(--nf-font-editorial); font-size: 2rem; line-height: 1.1; color: var(--nf-gold-text); }
+.ig-kept-letter { display: inline-block; }
+.ig-kept-rule { width: 160px; height: 6px; }
+.ig-kept-rule path { fill: none; stroke: var(--nf-accent); stroke-width: 1; stroke-dasharray: 1 1; }
+
+/* the three ways, and the metal */
+.ig-ways { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; width: 100%; }
+.ig-way, .ig-size {
+  min-height: 48px;
+  padding: 0.4rem 0.3rem;
+  border: 1px solid var(--ig-line);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 10.5px;
+  letter-spacing: var(--nf-track-16);
+  text-transform: uppercase;
+  color: rgb(var(--nf-ink-rgb) / 0.78);
+  cursor: pointer;
+}
+.ig-way[aria-pressed="true"], .ig-size[aria-pressed="true"] { border-color: var(--nf-accent-strong); background: var(--ig-vellum); color: var(--nf-ink); }
+.ig-ways + * { margin-top: 1.1rem; }
+
+.ig-thread, .ig-known, .ig-answer { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; width: 100%; }
+.ig-answer { align-items: center; padding-top: 0.4rem; }
+.ig-steps { margin: 0; padding-left: 1.2rem; font-family: var(--nf-font-label); font-size: 13px; line-height: 1.6; color: rgb(var(--nf-ink-rgb) / 0.78); text-align: left; }
+.ig-sizes { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.4rem; width: 100%; margin: 0; padding: 0; list-style: none; }
+.ig-size { width: 100%; min-height: 56px; font-size: 12px; }
+.ig-fit-h3 { margin: 1.8rem 0 0.8rem; font-family: var(--nf-font-editorial); font-weight: 500; font-size: 1.2rem; text-align: left; }
