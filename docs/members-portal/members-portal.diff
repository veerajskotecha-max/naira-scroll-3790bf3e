+import { describe, expect, it } from "vitest";
+import type { JewelPiece } from "@/data/jewellery";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { LOOKALIKES as SHOP_LOOKALIKES } from "@/data/lookalikes";
+import * as shop from "@/lib/pairings";
+import { LOOKALIKES } from "./lookalikes";
+import * as portal from "./laidOut";
+
+/*
+  "Laid out for you" uses the shop's own rows, copied because the originals
+  ride in the product page's chunk. These fail the moment the copies drift:
+  re-copy lib/pairings.ts (the rows) or data/lookalikes.ts (the groups).
+*/
+
+const catalogue = jewellerySnapshot as JewelPiece[];
+
+describe("the copies", () => {
+  it("hold the same lookalike groups as the shop", () => {
+    expect(LOOKALIKES.map(([s, h]) => [s, [...h]])).toEqual(SHOP_LOOKALIKES.map(([s, h]) => [s, [...h]]));
+  });
+
+  it("lay out exactly what the product page does, for every piece", () => {
+    for (const piece of catalogue) {
+      expect(portal.completeTheLook(piece, catalogue, 3).map((p) => p.handle), piece.handle).toEqual(shop.completeTheLook(piece, catalogue, 3).map((p) => p.handle));
+      expect(portal.moreLikeThis(piece, catalogue, 8).map((p) => p.handle), piece.handle).toEqual(shop.moreLikeThis(piece, catalogue, 8).map((p) => p.handle));
+    }
+  });
+
+  it("match the shop's lookalike pairs", () => {
+    for (const a of catalogue.slice(0, 60)) for (const b of catalogue) expect(portal.lookalike(a, b)).toEqual(shop.lookalike(a, b));
+  });
+});
+
+describe("laid out for you", () => {
+  const saved = ["verdant-eternity-band", "woven-gold-hoops"].filter((h) => catalogue.some((p) => p.handle === h));
+
+  it("lays out at most six, none she saved, none twice, each with its reason", () => {
+    const picks = portal.laidOutFor(saved, catalogue);
+    expect(picks.length).toBeGreaterThan(0);
+    expect(picks.length).toBeLessThanOrEqual(6);
+    const handles = picks.map((p) => p.piece.handle);
+    expect(new Set(handles).size).toBe(handles.length);
+    for (const h of saved) expect(handles).not.toContain(h);
+    for (const pick of picks) {
+      expect(saved).toContain(pick.anchor.handle);
+      expect(portal.reasonWords(pick)).toMatch(new RegExp(`^(The same design as|The same look as|Completes the look with|More like) your ${pick.anchor.name.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}$`));
+      expect(pick.piece.availableForSale).not.toBe(false);
+    }
+  });
+
+  it("shares the row between her saved pieces, newest first", () => {
+    const picks = portal.laidOutFor(saved, catalogue);
+    if (saved.length > 1) expect(new Set(picks.map((p) => p.anchor.handle)).size).toBe(saved.length);
+    expect(picks[0].anchor.handle).toBe(saved[saved.length - 1]);
+  });
+
+  it("never says 'the same look' of a piece sold by month, whose look changes with her month's stone", () => {
+    const monthly = catalogue.filter((p) => (p.variants ?? []).some((v) => Object.keys(v.options ?? {}).some((k) => /month/i.test(k))));
+    expect(monthly.length).toBeGreaterThan(0);
+    for (const anchor of monthly) {
+      for (const pick of portal.laidOutFor([anchor.handle], catalogue)) expect(pick.reason).not.toBe("set");
+    }
+  });
+
+  it("is empty with nothing saved, rather than made up", () => {
+    expect(portal.laidOutFor([], catalogue)).toEqual([]);
+    expect(portal.laidOutFor(["no-longer-listed"], catalogue)).toEqual([]);
+  });
+});
