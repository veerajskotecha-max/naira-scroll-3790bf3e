@@ -0,0 +1,187 @@
+import { createContext, useContext, useEffect, useMemo, useRef, useState, type RefObject } from "react";
+
+/*
+  Motion for the portal, in two tiers. Tier 1 (every phone) moves only
+  transform, opacity and stroke-dashoffset, with the Web Animations API, so
+  nothing joins the site-wide stylesheet and every animation can be finished
+  on a tap. Tier 0 (reduced motion, Data Saver, 2g/3g, the prerender) draws
+  every screen in its final state at once.
+*/
+
+export const prefersReducedMotion = (): boolean => {
+  try {
+    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+  } catch {
+    return false;
+  }
+};
+
+type Connection = { saveData?: boolean; effectiveType?: string };
+
+const saveData = (): boolean => {
+  try {
+    const c = (navigator as Navigator & { connection?: Connection }).connection;
+    return Boolean(c?.saveData) || /(^|-)(2g|3g)$/.test(c?.effectiveType ?? "");
+  } catch {
+    return false;
+  }
+};
+
+/** Tier 0: show final states only. */
+export const stillMotion = (): boolean => prefersReducedMotion() || saveData();
+
+/** Starts a WAAPI animation, or returns null where it cannot (old WebViews, tests, Tier 0). */
+export const play = (
+  el: Element | null | undefined,
+  keyframes: Keyframe[],
+  options: KeyframeAnimationOptions,
+): Animation | null => {
+  if (!el || typeof (el as HTMLElement).animate !== "function") return null;
+  try {
+    return (el as HTMLElement).animate(keyframes, options);
+  } catch {
+    return null;
+  }
+};
+
+export type Cue = { animation: Animation | null; cancel: () => void };
+
+/**
+ * Calls `fn` `ms` into the element's animation timeline: a cue that keeps
+ * pace with the animations around it (a busy phone, a slowed-down devtools
+ * timeline) where a setTimeout would drift. Finishing it early fires it, so
+ * callers guard against running after a skip. Falls back to a timer. Either
+ * way `cancel()` stops it without firing.
+ */
+export const cue = (el: Element | null | undefined, ms: number, fn: () => void): Cue => {
+  const a = play(el, [{ opacity: 1 }, { opacity: 1 }], { duration: Math.max(1, ms) });
+  if (a) {
+    a.onfinish = fn;
+    return {
+      animation: a,
+      cancel: () => {
+        a.onfinish = null;
+        a.cancel();
+      },
+    };
+  }
+  const timer = window.setTimeout(fn, ms);
+  return { animation: null, cancel: () => window.clearTimeout(timer) };
+};
+
+/**
+ * Resolves once the page has settled enough for an entrance to run smoothly:
+ * two frames after mount (so the route's own renders and the sign-in reads
+ * land first) and the web fonts swapped in, never waiting more than `maxMs`.
+ * At once where nothing animates (old WebViews, tests).
+ */
+export const settled = (maxMs = 320): Promise<void> => {
+  if (typeof window === "undefined" || typeof document === "undefined") return Promise.resolve();
+  if (typeof (document.documentElement as HTMLElement).animate !== "function" || typeof requestAnimationFrame !== "function") {
+    return Promise.resolve();
+  }
+  const frames = new Promise<void>((resolve) => requestAnimationFrame(() => requestAnimationFrame(() => resolve())));
+  const fonts = (document as Document & { fonts?: { ready?: Promise<unknown> } }).fonts?.ready ?? Promise.resolve();
+  const cap = new Promise<void>((resolve) => window.setTimeout(resolve, maxMs));
+  return Promise.race([Promise.all([frames, fonts]).then(() => undefined), cap]);
+};
+
+export const EASE_DRAWER = "cubic-bezier(0.32, 0.72, 0, 1)";
+export const EASE_REVEAL = "cubic-bezier(0.22, 1, 0.36, 1)";
+export const EASE_BLOOM = "cubic-bezier(0.34, 1.56, 0.64, 1)";
+export const EASE_CURTAIN = "cubic-bezier(0.76, 0, 0.24, 1)";
+/* Accelerating. Spelt out as a curve: the CSS keyword for it, written in any
+   source file, makes Tailwind add a matching utility to the global CSS. */
+export const EASE_IN = "cubic-bezier(0.42, 0, 1, 1)";
+
+export const IDLE_MS = 20_000;
+
+/**
+ * Whether the ambient loop on this screen should run: the element is on
+ * screen, the tab is visible, and someone has touched, scrolled or typed in
+ * the last 20 s. After that "the garden rests" until the next interaction.
+ */
+export const useAmbient = (ref: RefObject<Element>, enabled = true, idleMs = IDLE_MS): boolean => {
+  const [onScreen, setOnScreen] = useState(false);
+  const [visible, setVisible] = useState(() => typeof document === "undefined" || document.visibilityState !== "hidden");
+  const [awake, setAwake] = useState(true);
+
+  useEffect(() => {
+    const el = ref.current;
+    if (!enabled || !el) return;
+    if (typeof IntersectionObserver === "undefined") {
+      setOnScreen(true);
+      return;
+    }
+    const io = new IntersectionObserver(([entry]) => setOnScreen(entry.isIntersecting), { rootMargin: "40px" });
+    io.observe(el);
+    return () => io.disconnect();
+  }, [ref, enabled]);
+
+  useEffect(() => {
+    if (!enabled) return;
+    const onVisibility = () => setVisible(document.visibilityState !== "hidden");
+    document.addEventListener("visibilitychange", onVisibility);
+    return () => document.removeEventListener("visibilitychange", onVisibility);
+  }, [enabled]);
+
+  useEffect(() => {
+    if (!enabled) return;
+    let timer = window.setTimeout(() => setAwake(false), idleMs);
+    const wake = () => {
+      window.clearTimeout(timer);
+      setAwake(true);
+      timer = window.setTimeout(() => setAwake(false), idleMs);
+    };
+    const events = ["pointerdown", "pointermove", "scroll", "keydown", "touchstart"] as const;
+    events.forEach((e) => window.addEventListener(e, wake, { passive: true }));
+    return () => {
+      window.clearTimeout(timer);
+      events.forEach((e) => window.removeEventListener(e, wake));
+    };
+  }, [enabled, idleMs]);
+
+  return enabled && onScreen && visible && awake;
+};
+
+/*
+  A screen's one ambient loop. The garden bed owns it (useAmbient decides
+  when it runs: on screen, the tab visible, touched in the last 20 s); the
+  sway and every layer drawn in the bed (the sky's fireflies and mist, a
+  festival's flames and rain) join it, so they all rest and wake together.
+  A layer never starts a loop of its own: no observer, no timer, no frame
+  callback. Outside a bed there is no loop, and a layer stays still.
+*/
+export type AmbientLoop = {
+  /** Runs these with the loop (playing now if it runs); returns their leaving. */
+  join: (animations: readonly Animation[]) => () => void;
+};
+
+export const AmbientLoopContext = createContext<AmbientLoop | null>(null);
+
+/** The loop the nearest garden bed runs, or null outside one. */
+export const useAmbientLoop = (): AmbientLoop | null => useContext(AmbientLoopContext);
+
+/** The loop itself: every joined animation played while `running`, paused while not. */
+export const useLoop = (running: boolean): AmbientLoop => {
+  const members = useRef(new Set<Animation>());
+  const now = useRef(running);
+  now.current = running;
+  const loop = useMemo<AmbientLoop>(
+    () => ({
+      join: (list) => {
+        for (const a of list) {
+          members.current.add(a);
+          if (now.current) a.play();
+          else a.pause();
+        }
+        return () => list.forEach((a) => members.current.delete(a));
+      },
+    }),
+    [],
+  );
+  useEffect(() => {
+    members.current.forEach((a) => (running ? a.play() : a.pause()));
+  }, [running]);
+  return loop;
+};
