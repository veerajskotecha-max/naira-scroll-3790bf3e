@@ -0,0 +1,214 @@
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { useMember } from "./MemberContext";
+import { petalNode, settle } from "./petalFlight";
+import { FLOWER_PETALS, FLOWER_STEM, LEAF_SAGE, PETAL_BLUSH } from "@/lib/portal/brandFlower";
+import { EASE_BLOOM, EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { WHOLE, WORDS, findPiece, fitsOnAccount, noteFound, pieceOf, piecesFound, type Piece, type PieceKey } from "@/lib/portal/petals";
+import { hasDropFlag, setDropFlag } from "@/lib/portal/safeStorage";
+import "./petals.css";
+
+/*
+  Gathered (Phase 6): one of the Naira flower's five pieces, tucked at the
+  end of a room's heading, beside the pieces that section shows (never on a
+  price, a photo, a button, a link, a field, the garden path or the bag).
+  It is still art: no glint, no loop. Once per phone, the first time a
+  piece comes fully into view, it settles where it lies (one 700 ms breath
+  of the breeze, transform only, never under reduced motion or Data Saver),
+  so she notices it; then it is still. A 44 x 44 button names it; a tap,
+  Enter or Space takes it home.
+
+  Taken home, it lifts, turns once and flies on a soft arc (860 ms) down to
+  the garden path's Garden tab, whose icon opens once. The flight is one
+  node on a fixed petal layer at z-40 (under the bag's z-50), moved by one
+  animation on transform and opacity, and removed as it lands; the tab is
+  found when she taps (PortalNav is not touched), and when it cannot be
+  found the piece floats up and fades. Where the piece lay, a faint gold
+  print stays, and focus goes to the status line, which says where it went.
+
+  Reduced motion and Data Saver: no flight and no fade, the print is there
+  at once, and the line is said.
+
+  Her account keeps it in one bit of naira.p (petals.ts), written through
+  the portal's debounced writer; nothing is lost if she never taps. When her
+  account has no room to keep it, the line says it is taken home for this
+  visit only.
+*/
+
+const SPOT_ART = 22;
+
+/** The piece's part of the brand flower, centred in a square view. */
+const pathOf = (piece: Piece): string => (piece.part === "stem" ? FLOWER_STEM : FLOWER_PETALS[piece.part]);
+const viewOf = ({ box: [x, y, w, h] }: Piece): string => {
+  const side = Math.max(w, h);
+  return `${(x + w / 2 - side / 2).toFixed(4)} ${(y + h / 2 - side / 2).toFixed(4)} ${side.toFixed(4)} ${side.toFixed(4)}`;
+};
+
+/** The piece drawn flat: blush petal or sage stem, with a gold hairline. */
+const PieceArt = ({ piece, print = false }: { piece: Piece; print?: boolean }) => (
+  <svg viewBox={viewOf(piece)} width={SPOT_ART} height={SPOT_ART} className="ig-spot-art" style={{ transform: `rotate(${piece.tilt}deg)` }} aria-hidden>
+    <path
+      d={pathOf(piece)}
+      fill={print ? "var(--nf-accent)" : piece.part === "stem" ? LEAF_SAGE : PETAL_BLUSH}
+      fillOpacity={print ? 0.16 : 1}
+      stroke={print ? "var(--nf-accent)" : "var(--nf-accent-strong)"}
+      strokeOpacity={print ? 0.7 : 1}
+      strokeWidth={print ? 0.9 : 0.8}
+      vectorEffect="non-scaling-stroke"
+      strokeLinejoin="round"
+    />
+  </svg>
+);
+
+type Props = {
+  piece: PieceKey;
+  /** The section's heading: the piece lies at its end. */
+  children: ReactNode;
+};
+
+const PetalSpot = ({ piece: key, children }: Props) => {
+  const { user, naira, changeMeta } = useMember();
+  const piece = pieceOf(key);
+  const bit = 1 << piece.bit;
+  const [taken, setTaken] = useState(false);
+  const [said, setSaid] = useState("");
+  const found = taken || Boolean(piecesFound(naira, user.id) & bit);
+  const artRef = useRef<HTMLSpanElement>(null);
+  const printRef = useRef<HTMLSpanElement>(null);
+  const saidRef = useRef<HTMLParagraphElement>(null);
+  const flights = useRef<Animation[]>([]);
+  const symbol = `ig-piece-${key}`;
+
+  // The line takes focus as it is said; the print comes in softly where the piece lay.
+  useEffect(() => {
+    if (!said) return;
+    saidRef.current?.focus({ preventScroll: true });
+    if (!stillMotion()) {
+      const a = play(printRef.current, [{ opacity: 0 }, { opacity: 1 }], { duration: 520, delay: 260, easing: EASE_REVEAL, fill: "backwards" });
+      if (a) flights.current.push(a);
+    }
+  }, [said]);
+
+  useEffect(
+    () => () => {
+      flights.current.forEach((a) => a.cancel());
+      flights.current = [];
+    },
+    [],
+  );
+
+  // Once per phone: the first piece she sees settles where it lies, once fully in view below the shop's header and above the garden path.
+  useEffect(() => {
+    const el = artRef.current;
+    if (found || !el || stillMotion() || hasDropFlag("spot", "seen") || typeof IntersectionObserver === "undefined") return;
+    const top = Math.ceil(document.querySelector("header")?.getBoundingClientRect().bottom ?? 0);
+    const io = new IntersectionObserver(
+      ([e]) => {
+        if (!e.isIntersecting) return;
+        io.disconnect();
+        if (hasDropFlag("spot", "seen")) return;
+        setDropFlag("spot", "seen");
+        const a = play(el, [{ transform: "none" }, { transform: "rotate(10deg) translateY(-3px)", offset: 0.35 }, { transform: "rotate(-5deg) translateY(0px)", offset: 0.7 }, { transform: "none" }], { duration: 700, delay: 300, easing: EASE_BLOOM });
+        if (a) flights.current.push(a);
+      },
+      { threshold: 1, rootMargin: `-${top}px 0px -72px 0px` },
+    );
+    io.observe(el);
+    return () => io.disconnect();
+  }, [found]);
+
+  const fly = (from: DOMRect) => {
+    const root = document.querySelector(".ig-root") ?? document.body;
+    const layer = document.createElement("div");
+    layer.className = "ig-petal-layer";
+    layer.setAttribute("aria-hidden", "true");
+    root.appendChild(layer);
+    const x = from.left + from.width / 2;
+    const y = from.top + from.height / 2;
+    const node = petalNode(layer, x, y, symbol, SPOT_ART);
+    const tab = document.querySelector<SVGSVGElement>(".ig-nav a[href='/members'] svg");
+    const to = tab?.getBoundingClientRect();
+    const t = piece.tilt;
+    const at = (dx: number, dy: number, turn: number, scale: number) => `translate(-50%,-50%) translate(${dx.toFixed(1)}px,${dy.toFixed(1)}px) rotate(${(t + turn).toFixed(0)}deg) scale(${scale})`;
+    const home = Boolean(to && to.width > 0 && to.height > 0);
+    const dx = home && to ? to.left + to.width / 2 - x : 0;
+    const dy = home && to ? to.top + to.height / 2 - y : 0;
+    // It lifts, turns once on a soft arc over the page, and lands in the tab; with no tab, it floats up and fades.
+    const keys: Keyframe[] = home
+      ? [
+          { transform: at(0, 0, 0, 1), opacity: 1 },
+          { transform: at(dx * 0.06, -16, 30, 1.18), opacity: 1, offset: 0.16 },
+          { transform: at(dx * 0.5, dy * 0.42 - Math.min(110, 36 + Math.abs(dy) * 0.18), 210, 1.05), opacity: 1, offset: 0.58 },
+          { transform: at(dx, dy, 360, 0.5), opacity: 0.15 },
+        ]
+      : [
+          { transform: at(0, 0, 0, 1), opacity: 1 },
+          { transform: at(0, -16, 40, 1.15), opacity: 1, offset: 0.25 },
+          { transform: at(10, -72, 360, 0.8), opacity: 0 },
+        ];
+    const a = play(node, keys, { duration: home ? 860 : 760, easing: "cubic-bezier(0.45, 0, 0.3, 1)", fill: "both" });
+    const out: Animation[] = [];
+    settle(node, a, out);
+    if (!a) {
+      layer.remove();
+      return;
+    }
+    flights.current.push(a);
+    const land = () => {
+      layer.remove();
+      if (home && a.playState === "finished") {
+        const open = play(tab, [{ transform: "scale(1)" }, { transform: "scale(1.12)" }, { transform: "scale(1)" }], { duration: 440, easing: EASE_BLOOM });
+        if (open) flights.current.push(open);
+      }
+    };
+    a.addEventListener("finish", land);
+    a.addEventListener("cancel", land);
+  };
+
+  const take = () => {
+    if (found) return;
+    const from = artRef.current?.getBoundingClientRect();
+    const before = piecesFound(naira, user.id);
+    // Whether her account can keep it: when not, the words say it is for this visit only.
+    const keeps = fitsOnAccount(naira, piece.bit);
+    noteFound(user.id, piece.bit);
+    // One bit onto her account's fresh copy: refused (the same object) when it is set, or her account has no room.
+    changeMeta(findPiece(piece.bit));
+    const now = before | bit;
+    const first = keeps ? WORDS.taken : WORDS.visitOnly;
+    setTaken(true);
+    setSaid(now === WHOLE ? `${first} ${WORDS.whole}` : before === 0 ? `${first} ${WORDS.first}` : first);
+    if (from && !stillMotion()) fly(from);
+  };
+
+  const stem = piece.part === "stem";
+  return (
+    <>
+      <div className="ig-spot-head">
+        {children}
+        <svg className="ig-sprite" aria-hidden focusable="false">
+          <defs>
+            <symbol id={symbol} viewBox={viewOf(piece)}>
+              <path d={pathOf(piece)} fill={stem ? LEAF_SAGE : PETAL_BLUSH} stroke="var(--nf-accent-strong)" strokeWidth={0.8} vectorEffect="non-scaling-stroke" strokeLinejoin="round" />
+            </symbol>
+          </defs>
+        </svg>
+        {found ? (
+          <span ref={printRef} className="ig-spot ig-spot--print" role="img" aria-label={stem ? WORDS.printStem : WORDS.printPetal}>
+            <PieceArt piece={piece} print />
+          </span>
+        ) : (
+          <button type="button" className="ig-spot" aria-label={stem ? WORDS.stem : WORDS.petal} onClick={take} data-piece={key}>
+            <span ref={artRef} className="ig-spot-lie">
+              <PieceArt piece={piece} />
+            </span>
+          </button>
+        )}
+      </div>
+      <p ref={saidRef} tabIndex={-1} role="status" className="ig-spot-said">
+        {said}
+      </p>
+    </>
+  );
+};
+
+export default PetalSpot;
