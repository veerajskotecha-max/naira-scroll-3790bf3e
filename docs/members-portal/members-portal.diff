+++ b/src/pages/members/gifts.css
@@ -0,0 +1,120 @@
+/* /members/gifts: the gift ledger. Imported only by Gifts.tsx (a piece card brings its own sheet). */
+
+.ig-gifts {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
+  text-align: center;
+}
+.ig-gifts .ig-lede { text-wrap: balance; }
+.ig-gifts-empty { max-width: 22rem; }
+
+/* the twelve-month ring */
+.ig-gring { position: relative; width: 100%; max-width: 360px; aspect-ratio: 1; margin: 1.25rem auto 0.5rem; }
+.ig-gring-art { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
+.ig-gring-line { fill: none; stroke: var(--nf-accent); stroke-width: 1; stroke-dasharray: 1 1; }
+.ig-gring-line--fine { stroke-width: 0.6; opacity: 0.5; stroke-dasharray: none; }
+.ig-gring-tick { stroke: var(--nf-accent); stroke-width: 0.8; opacity: 0.75; }
+.ig-gring-month { font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: 0.14em; fill: var(--nf-gold-text); }
+.ig-gring-stem line { stroke: var(--nf-accent); stroke-width: 0.7; opacity: 0.75; }
+.ig-gring-stem circle { fill: var(--nf-accent); }
+.ig-gring-stem.is-next line { stroke: var(--nf-accent-strong); opacity: 1; }
+.ig-gring-today { fill: var(--nf-blush); stroke: var(--nf-accent-strong); stroke-width: 0.8; }
+.ig-gring-flowers { margin: 0; padding: 0; list-style: none; }
+.ig-gring-flowers li { position: absolute; width: 0; height: 0; }
+.ig-gring-flower {
+  position: absolute;
+  left: -22px;
+  top: -22px;
+  width: 44px;
+  height: 44px;
+  padding: 0;
+  border: 0;
+  background: none;
+  cursor: pointer;
+  -webkit-tap-highlight-color: transparent;
+}
+.ig-gring-flower svg { display: block; overflow: visible; }
+.ig-gring-flower[aria-pressed="true"]::after { content: ""; position: absolute; left: 13px; right: 13px; bottom: -3px; height: 1px; background: var(--nf-ink); }
+.ig-gring-flower:focus-visible { outline: 2px solid var(--nf-accent-strong); outline-offset: 1px; }
+.ig-gring-halo { fill: rgb(var(--nf-gold-rgb) / 0.16); stroke: var(--nf-accent); stroke-width: 1; }
+.ig-gring-halo--fine { fill: none; stroke-width: 0.6; }
+.ig-gring-centre {
+  position: absolute;
+  left: 50%;
+  top: 50%;
+  display: flex;
+  flex-direction: column;
+  gap: 0.1rem;
+  width: 44%;
+  margin: 0;
+  transform: translate(-50%, -50%);
+  pointer-events: none;
+}
+.ig-gring-next { font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-28); text-transform: uppercase; color: var(--nf-gold-text); }
+.ig-gring-name { font-family: var(--nf-font-editorial); font-size: 1.6rem; line-height: 1.1; overflow-wrap: anywhere; }
+.ig-gring-when { font-family: var(--nf-font-label); font-size: 11.5px; color: rgb(var(--nf-ink-rgb) / 0.7); }
+
+/* the chosen date */
+.ig-gcard { display: flex; flex-direction: column; align-items: flex-start; gap: 0.8rem; padding: 1.2rem 1rem 1.4rem; border: 1px solid var(--ig-gold-line); background: var(--ig-vellum); }
+.ig-section.ig-gcard > .ig-h2 { padding: 0; margin: 0; border: 0; }
+.ig-gcard-head { display: flex; align-items: flex-end; gap: 0.9rem; }
+.ig-gcard-flower { flex: none; }
+.ig-gcard-name { overflow-wrap: anywhere; }
+.ig-gcard-when { margin: 0.15rem 0 0; font-family: var(--nf-font-editorial); font-style: italic; font-size: 1.1rem; }
+.ig-gcard-h3 { margin: 0.9rem 0 0; font-family: var(--nf-font-editorial); font-weight: 500; font-size: 1.2rem; }
+.ig-gstone { display: flex; gap: 0.8rem; width: 100%; padding: 0.9rem 0 0.2rem; border-top: 1px solid var(--ig-line); }
+.ig-gstone-heart { flex: none; margin-top: 1.1rem; }
+.ig-gstone-body { display: flex; flex-direction: column; align-items: flex-start; gap: 0.45rem; min-width: 0; }
+.ig-gstone-body .ig-gcard-h3 { margin: 0; }
+.ig-gstone-price { justify-content: flex-start; font-size: 15px; }
+.ig-gstone .ig-btn { height: 44px; font-size: 10.5px; }
+.ig-gremind { display: flex; flex-direction: column; align-items: flex-start; gap: 0.2rem; width: 100%; }
+
+/* her dates, in words */
+.ig-glist { margin: 0; padding: 0; list-style: none; }
+.ig-glist li { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 0.5rem; padding: 0.35rem 0; border-bottom: 1px solid var(--ig-line); }
+.ig-glist li.is-shown { border-bottom-color: var(--ig-gold-line); }
+.ig-glist-pick { display: grid; flex: 1 1 12rem; min-height: 48px; padding: 0.3rem 0; border: 0; background: none; text-align: left; color: inherit; cursor: pointer; }
+.ig-glist-name { font-family: var(--nf-font-editorial); font-size: 1.25rem; line-height: 1.2; overflow-wrap: anywhere; }
+.ig-glist-when, .ig-glist-band { font-family: var(--nf-font-label); font-size: 12px; color: rgb(var(--nf-ink-rgb) / 0.7); }
+.ig-glist-actions { display: flex; gap: 0.25rem; }
+.ig-glist li.ig-glist-edit { display: block; }
+.ig-gnotice { display: flex; flex-wrap: wrap; align-items: center; gap: 0 0.5rem; margin-bottom: 0.4rem; }
+.ig-gnotice:focus { outline: none; }
+.ig-gfull { margin-top: 1rem; color: var(--nf-ink); }
+.ig-gifts .ig-section > .ig-btn--outline { margin-top: 1.1rem; }
+.ig-gprivacy { margin-top: 1.4rem; }
+
+/* the date's form */
+.ig-oform { display: flex; flex-direction: column; gap: 1.1rem; width: 100%; margin-top: 1.1rem; padding: 1.2rem 1rem; border: 1px solid var(--ig-gold-line); background: var(--ig-vellum); text-align: left; }
+.ig-oform-row { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; margin: 0; padding: 0; border: 0; }
+.ig-oform-label { padding: 0; font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: var(--nf-track-20); text-transform: uppercase; color: var(--nf-gold-text); }
+.ig-oform-input { text-align: left; }
+.ig-oform-when { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: 0.6rem; }
+.ig-oform-select { padding: 0 0.4rem; text-align: left; }
+.ig-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.4rem; }
+.ig-chip { display: block; cursor: pointer; }
+.ig-chip span {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  min-height: 48px;
+  padding: 0.3rem;
+  border: 1px solid var(--ig-line);
+  font-family: var(--nf-font-label);
+  font-size: 11px;
+  letter-spacing: 0.06em;
+  text-align: center;
+  color: rgb(var(--nf-ink-rgb) / 0.78);
+}
+.ig-chip input:checked + span { border-color: var(--nf-accent-strong); background: rgb(var(--nf-ivory-rgb)); color: var(--nf-ink); }
+.ig-chip input:focus-visible + span { outline: 2px solid var(--nf-accent-strong); outline-offset: 1px; }
+.ig-oform-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
+
+@media (min-width: 768px) {
+  .ig-gifts { padding-top: 2rem; }
+}
