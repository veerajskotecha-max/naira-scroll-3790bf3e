@@ -0,0 +1,318 @@
+import { FLOWER_ASPECT, FLOWER_BASE_X } from "./brandFlower";
+
+/*
+  Her garden bed, laid out from her own user id: the same id always grows the
+  same garden, on every device and every visit, and no two members share one.
+  Pure maths (a 32-bit FNV-1a hash seeding mulberry32), so it is the same in a
+  test, the prerender and the browser.
+
+  The bed is a 390 x 560 view (phone first), planted in three rows from the
+  back. Two plants are hers alone, at the front: the Naira flower, planted the
+  day she joined, and her stone flower (a closed bud until her birthday is
+  known). Budgets from the plan: at most 80 plants and at most 24 swaying, so a
+  mid-range Android composites the bed without dropping frames.
+*/
+
+export const BED = { w: 390, h: 560, soil: 522 } as const;
+export const MAX_PLANTS = 80;
+export const MAX_SWAY = 24;
+export const BANDS = 12;
+
+export type PlantKind = "grass" | "sprig" | "bud" | "bloom" | "breath" | "leaves" | "naira" | "stone" | "drop" | "ringbud" | "saved";
+
+export type Plant = {
+  id: string;
+  kind: PlantKind;
+  /** 0 back, 1 middle, 2 front. */
+  row: 0 | 1 | 2;
+  /** Stem base, in the 390 x 560 view. */
+  x: number;
+  y: number;
+  scale: number;
+  flip: boolean;
+  /** Index into SPECIES for blooms. */
+  species: number;
+  /** Index into that species' palette. */
+  tone: number;
+  /** Which of the three stems a bloom or bud stands on. */
+  stem: 0 | 1 | 2;
+  sway: boolean;
+  /** Back-to-front band, 0..BANDS-1, for the bloom-in. */
+  band: number;
+  /** Seconds for one sway, and where in it this plant starts. */
+  swayDur: number;
+  swayPhase: number;
+  /** A pressed drop's flower colour, a ring bud's or a saved piece's metal. */
+  accent?: string;
+};
+
+export const hashString = (text: string): number => {
+  let h = 0x811c9dc5;
+  for (let i = 0; i < text.length; i++) {
+    h ^= text.charCodeAt(i);
+    h = Math.imul(h, 0x01000193);
+  }
+  return h >>> 0;
+};
+
+export const mulberry32 = (seed: number) => {
+  let a = seed >>> 0;
+  return () => {
+    a = (a + 0x6d2b79f5) >>> 0;
+    let t = a;
+    t = Math.imul(t ^ (t >>> 15), t | 1);
+    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
+    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
+  };
+};
+
+type Weights = Partial<Record<PlantKind, number>>;
+type RowSpec = { row: 0 | 1 | 2; count: number; yMin: number; yMax: number; sMin: number; sMax: number; weights: Weights };
+
+const ROWS: RowSpec[] = [
+  { row: 0, count: 26, yMin: 262, yMax: 330, sMin: 0.58, sMax: 0.82, weights: { grass: 26, sprig: 24, breath: 20, bud: 14, bloom: 16 } },
+  { row: 1, count: 22, yMin: 372, yMax: 448, sMin: 0.74, sMax: 0.96, weights: { bloom: 34, sprig: 20, bud: 20, grass: 14, leaves: 12 } },
+  { row: 2, count: 18, yMin: 510, yMax: 520, sMin: 0.92, sMax: 1.14, weights: { bloom: 38, leaves: 20, bud: 14, grass: 16, sprig: 12 } },
+];
+
+const pick = (rand: () => number, weights: Weights): PlantKind => {
+  const entries = Object.entries(weights) as [PlantKind, number][];
+  const total = entries.reduce((s, [, w]) => s + w, 0);
+  let r = rand() * total;
+  for (const [kind, w] of entries) {
+    if ((r -= w) < 0) return kind;
+  }
+  return entries[entries.length - 1][0];
+};
+
+/* The sway is one breeze, not jitter: every plant swings at nearly the same
+   pace, each a little behind its neighbour to the left, so the loop rolls
+   across the bed from left to right. */
+const SWAY_S = 4.6;
+const windPhase = (x: number, jitter: number) => Number(((1 - x / BED.w) * 0.45 + jitter * 0.1).toFixed(3));
+
+const bandOf = (y: number) => Math.max(0, Math.min(BANDS - 1, Math.floor(((y - 260) / (BED.soil + 2 - 260)) * BANDS)));
+
+export type Garden = { plants: Plant[]; naira: Plant; stone: Plant };
+
+export const layoutGarden = (seedText: string): Garden => {
+  const rand = mulberry32(hashString(seedText || "naira"));
+  const r = (min: number, max: number) => min + rand() * (max - min);
+  const plants: Plant[] = [];
+
+  // Her two plants first, so the rows can keep clear of them.
+  const nairaX = Math.round(r(138, 168));
+  const stoneX = Math.round(nairaX + r(96, 116));
+  const feature = (id: string, kind: PlantKind, x: number): Plant => ({
+    id,
+    kind,
+    row: 2,
+    x,
+    y: BED.soil,
+    scale: 1,
+    flip: false,
+    species: 1,
+    tone: 0,
+    stem: 0,
+    sway: true,
+    band: BANDS - 1,
+    swayDur: Number(r(SWAY_S - 0.15, SWAY_S + 0.15).toFixed(2)),
+    swayPhase: windPhase(x, rand()),
+  });
+  const naira = feature("naira", "naira", nairaX);
+  const stone = feature("stone", "stone", stoneX);
+  const clear = (x: number) => Math.abs(x - (nairaX + 18)) > 62 && Math.abs(x - stoneX) > 34;
+
+  for (const spec of ROWS) {
+    // Inside the arbour's posts.
+    const left = 40;
+    const span = BED.w - 80;
+    const slot = span / spec.count;
+    for (let i = 0; i < spec.count; i++) {
+      const x = Math.round(left + slot * (i + 0.15 + rand() * 0.7));
+      const y = Math.round(r(spec.yMin, spec.yMax));
+      const kind = pick(rand, spec.weights);
+      const species = Math.floor(rand() * 6);
+      const plant: Plant = {
+        id: `p${spec.row}-${i}`,
+        kind,
+        row: spec.row,
+        x,
+        y,
+        scale: Number(r(spec.sMin, spec.sMax).toFixed(3)),
+        flip: rand() < 0.5,
+        species,
+        tone: Math.floor(rand() * 4),
+        stem: Math.floor(rand() * 3) as 0 | 1 | 2,
+        sway: false,
+        band: bandOf(y),
+        swayDur: Number(r(SWAY_S - 0.15, SWAY_S + 0.15).toFixed(2)),
+        swayPhase: windPhase(x, rand()),
+      };
+      // The front row leaves room around her two plants.
+      if (spec.row === 2 && !clear(x)) continue;
+      plants.push(plant);
+    }
+  }
+
+  // Sway: her two, then the front and middle rows in a seeded order.
+  const candidates = plants
+    .filter((p) => p.row > 0)
+    .map((p) => ({ p, key: rand() }))
+    .sort((a, b) => a.key - b.key)
+    .slice(0, MAX_SWAY - 2);
+  for (const { p } of candidates) p.sway = true;
+
+  const all = [...plants, naira, stone].slice(0, MAX_PLANTS);
+  // Painter's order: back to front, so nearer plants overlap farther ones.
+  all.sort((a, b) => a.y - b.y || a.x - b.x);
+  return { plants: all, naira, stone };
+};
+
+/* ── her pressed drop flowers ───────────────────────────
+   Each drop she pressed is planted in the middle row, in its own species
+   and colour, at a place seeded from her id and the drop's, so it stands in
+   the same spot on every visit. Newest are kept when the bed is full. */
+
+export type PressedFlower = { id: string; species: number; accent: string };
+
+export const plantPressed = (seedText: string, pressed: readonly PressedFlower[], room: number): Plant[] =>
+  pressed.slice(Math.max(0, pressed.length - Math.max(0, room))).map((f, i) => {
+    const rand = mulberry32(hashString(`${seedText || "naira"}:${f.id}`));
+    const x = Math.round(52 + rand() * (BED.w - 104));
+    const y = Math.round(384 + rand() * 56);
+    return {
+      id: `drop-${f.id}`,
+      kind: "drop",
+      row: 1,
+      x,
+      y,
+      scale: 0.98,
+      flip: rand() < 0.5,
+      species: f.species,
+      tone: 0,
+      stem: (i % 3) as 0 | 1 | 2,
+      sway: false,
+      band: bandOf(y),
+      swayDur: SWAY_S,
+      swayPhase: windPhase(x, rand()),
+      accent: f.accent,
+    };
+  });
+
+/* ── her fit and her drawer (Phase 3) ──────────────────
+   Her ring size kept: a ring of buds on the soil around the foot of her
+   stone flower (the back half behind its stem, the front half before it). Each piece in her
+   drawer: a sprig at the back, its tip gold or silver as the piece is. All
+   seeded from her id, so they stand in the same place on every visit, and
+   all inside the bed's 80-plant budget (pressed flowers first, then the
+   ring, then the newest sprigs). */
+
+export const RING_BUDS = 7;
+/* The gold ring the buds sprout through, lying on the soil: its centre line, and its half-widths. */
+export const RING_SOIL = BED.soil - 7;
+export const RING_RX = 44;
+export const RING_RY = 9;
+export const MAX_SPRIGS = 8;
+const RING_TONES = ["#DDB46A", "#F6CDB8"];
+export const METAL_TIP = { gold: "#C99A4C", silver: "#B9BFC6" } as const;
+
+export const plantRing = (seedText: string, garden: Garden, room: number): Plant[] => {
+  if (room < RING_BUDS) return [];
+  const rand = mulberry32(hashString(`${seedText || "naira"}:ring`));
+  const cx = garden.stone.x;
+  const cy = RING_SOIL;
+  return Array.from({ length: RING_BUDS }, (_, i) => {
+    const a = (i / RING_BUDS) * Math.PI * 2 + 0.35;
+    const x = Math.round(cx + Math.cos(a) * RING_RX);
+    const y = Math.round(cy + Math.sin(a) * RING_RY);
+    return {
+      id: `ring-${i}`,
+      kind: "ringbud" as const,
+      row: 1 as const,
+      x,
+      y,
+      scale: 0.6,
+      flip: i % 2 === 1,
+      species: 2,
+      tone: i,
+      stem: (i % 3) as 0 | 1 | 2,
+      sway: false,
+      band: bandOf(y),
+      swayDur: SWAY_S,
+      swayPhase: windPhase(x, rand()),
+      accent: RING_TONES[i % RING_TONES.length],
+    };
+  });
+};
+
+export type SavedSprig = { id: string; silver: boolean };
+
+export const plantSaved = (seedText: string, saved: readonly SavedSprig[], room: number): Plant[] =>
+  saved.slice(Math.max(0, saved.length - Math.min(MAX_SPRIGS, Math.max(0, room)))).map((s, i) => {
+    const rand = mulberry32(hashString(`${seedText || "naira"}:saved:${s.id}`));
+    const x = Math.round(48 + rand() * (BED.w - 96));
+    const y = Math.round(292 + rand() * 50);
+    return {
+      id: `saved-${s.id}`,
+      kind: "saved" as const,
+      // In the middle row, at full colour beside the garden's own sprigs, so hers can be told apart.
+      row: 2 as const,
+      x,
+      y,
+      scale: 0.78,
+      flip: rand() < 0.5,
+      species: 0,
+      tone: 0,
+      stem: (i % 3) as 0 | 1 | 2,
+      sway: false,
+      band: bandOf(y),
+      swayDur: SWAY_S,
+      swayPhase: windPhase(x, rand()),
+      accent: s.silver ? METAL_TIP.silver : METAL_TIP.gold,
+    };
+  });
+
+/* ── the whole bed, as it is drawn ─────────────────────
+   The garden's own plants with hers added inside the 80-plant budget
+   (pressed flowers, then the ring of buds, then the newest sprigs), in
+   painter's order and in their bands. The bed draws these; so does her
+   garden card, from the same seed, so the card is her garden. */
+
+export type BedOptions = {
+  /** The gate's backdrop: none of a member's own plants (nor her two). */
+  still?: boolean;
+  pressed?: readonly PressedFlower[];
+  fitted?: boolean;
+  saved?: readonly SavedSprig[];
+};
+
+export const plantBed = (seed: string, garden: Garden, { still = false, pressed, fitted = false, saved }: BedOptions = {}): { bands: Plant[][]; ringed: boolean } => {
+  const out: Plant[][] = Array.from({ length: BANDS }, () => []);
+  let room = MAX_PLANTS - garden.plants.length;
+  const drops = still || !pressed?.length ? [] : plantPressed(seed, pressed, room);
+  room -= drops.length;
+  const buds = still || !fitted ? [] : plantRing(seed, garden, room);
+  room -= buds.length;
+  const sprigs = still || !saved?.length ? [] : plantSaved(seed, saved, room);
+  const extra = [...drops, ...buds, ...sprigs];
+  const all = extra.length ? [...garden.plants, ...extra].sort((a, b) => a.y - b.y || a.x - b.x) : garden.plants;
+  for (const p of all) if (!still || (p.kind !== "naira" && p.kind !== "stone")) out[p.band].push(p);
+  return { bands: out, ringed: buds.length > 0 };
+};
+
+/** Each row's shade: the back rows a little paler, so the bed has depth. */
+export const ROW_SHADE: readonly number[] = [0.62, 0.84, 1];
+
+/** Each plant's box in the bed's view: 60 x 112 scaled, stem base at the bottom middle (her two at their own sizes). */
+export const boxOf = (p: Plant): { left: number; top: number; w: number; h: number } => {
+  if (p.kind === "naira") {
+    const h = 208;
+    const w = h * FLOWER_ASPECT;
+    return { left: p.x - w * FLOWER_BASE_X, top: p.y - h, w, h };
+  }
+  if (p.kind === "stone") return { left: p.x - 40 * 1.05, top: p.y - 170 * 1.05, w: 80 * 1.05, h: 170 * 1.05 };
+  const w = 60 * p.scale;
+  const h = 112 * p.scale;
+  return { left: p.x - w / 2, top: p.y - h, w, h };
+};
