+          <g ref={stoneRef} className="ig-sl-stone" transform={`translate(${STONE_X} ${STONE_Y}) scale(${SCALE})`}>
+            <path d={HEART} fill={`url(#${uid}b)`} />
+            <g stroke={IVORY} strokeWidth=".05" strokeOpacity=".22" fill="none">
+              {pavilion.map(([a, b], i) => (
+                <path key={i} d={`M${a[0].toFixed(2)} ${a[1].toFixed(2)}L${b[0].toFixed(2)} ${b[1].toFixed(2)}`} />
+              ))}
+            </g>
+            {facets.map((f, i) => (
+              <polygon key={i} ref={(el) => (facetRefs.current[i] = el)} points={pointsAttr(f.points)} fill={IVORY} style={{ opacity: first.facets[i].toFixed(3) }} />
+            ))}
+            <path d={edges} fill="none" stroke={IVORY} strokeOpacity=".55" strokeWidth=".06" strokeLinejoin="round" />
+            <polygon points={pointsAttr(table)} fill="none" stroke={IVORY} strokeOpacity=".7" strokeWidth=".07" />
+            <path d={HEART} fill="none" stroke={GOLD} strokeWidth=".16" />
+            {claws.map(([x, y], i) => (
+              <g key={i} transform={`translate(${x.toFixed(2)} ${y.toFixed(2)})`}>
+                <circle r=".62" fill={GOLD} />
+                <circle r=".26" cx="-.18" cy="-.2" fill={PALE_GOLD} />
+              </g>
+            ))}
+            <g ref={glintRef} style={{ transform: `translate(${glint.x.toFixed(3)}px,${glint.y.toFixed(3)}px) scale(${(glint.scale * 0.2).toFixed(3)})`, opacity: glint.opacity.toFixed(3) }}>
+              <path d={STAR} fill="#FFFFFF" stroke={PALE_GOLD} strokeWidth=".6" />
+              <circle r="2.2" fill="#FFFFFF" opacity=".55" />
+            </g>
+          </g>
+        </svg>
+      </div>
+
+      <div className="ig-sl-turns">
+        <button type="button" className="ig-sl-btn" onClick={() => turn(-1)}>
+          Turn it back
+        </button>
+        <button type="button" className="ig-sl-btn" onClick={() => turn(1)}>
+          Turn it to the light
+        </button>
+      </div>
+      {(tilt === "offer" || tilt === "asking") && (
+        <button type="button" className="ig-sl-btn ig-sl-tilt" onClick={() => tilt === "offer" && askTilt()} aria-busy={tilt === "asking"}>
+          Tilt your phone
+        </button>
+      )}
+      <p className="ig-fineprint ig-sl-said" role="status">
+        {tilt === "on" ? "The light follows your phone." : tilt === "off" ? "Drag across the stone instead." : ""}
+      </p>
+      <p className="ig-sl-caption">
+        A drawing of the heart in {stone.monthName}'s colour, not a photo. {STONE_WORDS}.
+      </p>
+      <button type="button" className={textLink} onClick={toNecklace}>
+        See it on the necklace ↑
+      </button>
+    </div>
+  );
+};
+
+export default StoneLight;
