index 0000000..d458ca0
--- /dev/null
+++ b/src/lib/portal/care.ts
@@ -0,0 +1,105 @@
+import type { JewelPiece } from "@/data/jewellery";
+
+/*
+  Care, only in the listings' own words. Each piece's care line is its
+  listing's Care section (the shop's description, as the product page reads
+  it), its finish is its Plating line, and the "PVD vs plating" explainer is
+  the line the PVD listings carry in their details. Nothing here adds a care
+  claim of its own, offers a service the shop has not confirmed, or says a
+  piece was bought: pieces from a checkout are "from a checkout you started".
+
+  The wipe ritual's three steps are phrases the listings' care lines share
+  (the waterproof line, the "keep it dry" lines alike). It is drawn only
+  when the most common care line (the shop's own, read from the catalogue)
+  still says all three, so a change to the listings takes the ritual away
+  rather than leave it saying something they no longer do. That line itself
+  is never quoted as if it were about her pieces: a third of the range asks
+  to be kept dry, and each of hers says so on its own card.
+*/
+
+const detail = (piece: JewelPiece, label: RegExp): string | null => {
+  const line = (piece.details ?? []).find((d) => label.test(d));
+  return line ? line.replace(label, "").trim() || null : null;
+};
+
+/** The listing's own care line ("Waterproof and tarnish free, so…"), or null when it has none. */
+export const careLineOf = (piece: JewelPiece): string | null => piece.care?.trim() || null;
+
+/** Its Plating line ("PVD 18K gold coating, anti-tarnish"). */
+export const platingOf = (piece: JewelPiece): string | null => detail(piece, /^Plating:\s*/i);
+
+/** The "PVD vs plating" explainer, as the piece's own details give it. */
+export const pvdLineOf = (piece: JewelPiece): string | null => detail(piece, /^PVD vs plating:\s*/i);
+
+const mostCommon = (values: (string | null)[]): string | null => {
+  const counts = new Map<string, number>();
+  for (const v of values) if (v) counts.set(v, (counts.get(v) ?? 0) + 1);
+  let best: string | null = null;
+  let most = 0;
+  for (const [v, n] of counts) if (n > most) [best, most] = [v, n];
+  return best;
+};
+
+/** The care line most listings carry. */
+export const houseCareLine = (catalogue: readonly JewelPiece[]): string | null => mostCommon(catalogue.map(careLineOf));
+
+/** The explainer the PVD listings carry. */
+export const pvdExplainer = (catalogue: readonly JewelPiece[]): string | null => mostCommon(catalogue.map(pvdLineOf));
+
+export type RitualStep = { words: string; match: RegExp };
+
+/* Each step's words are the care lines' own; `match` finds them in a line (said of "it" or "them", flat or not). */
+export const RITUAL: readonly RitualStep[] = [
+  { words: "Keep it away from perfume and harsh chemicals.", match: /away from perfume and harsh chemicals/i },
+  { words: "Wipe with a soft dry cloth.", match: /wipe (it |them )?with a soft dry cloth/i },
+  { words: "Store it in its pouch.", match: /store (it|them)( flat)? in (its|their) pouch/i },
+];
+
+/** The ritual, when the shop's own care line still says each of its steps; null otherwise. */
+export const ritualFor = (careLine: string | null): readonly RitualStep[] | null =>
+  careLine && RITUAL.every((s) => s.match.test(careLine)) ? RITUAL : null;
+
+const nameKey = (name: string) => name.trim().toLowerCase().replace(/\s+/g, " ");
+
+/** Where a care card's piece came from; `on` (an order's own time) only for an order Shopify's webhook confirmed. */
+export type CarePiece = { piece: JewelPiece; from: "saved" | "checkout" | "order"; on?: string };
+
+/**
+ * Her pieces for care cards: the ones she saved (her account's handles), then
+ * those named in the checkouts she started (matched to the listing by its
+ * name, since a checkout row keeps names, not handles), each once.
+ */
+export const piecesForCare = (
+  catalogue: readonly JewelPiece[],
+  saved: readonly string[],
+  checkoutNames: readonly string[],
+  /** Pieces of her confirmed orders (status 'completed'), each with its order's own time: before the checkouts, so a confirmed piece is called an order's. */
+  orderPieces: readonly { name: string; on: string }[] = [],
+): CarePiece[] => {
+  const byHandle = new Map(catalogue.map((p) => [p.handle, p]));
+  const byName = new Map(catalogue.map((p) => [nameKey(p.name), p]));
+  const out: CarePiece[] = [];
+  const seen = new Set<string>();
+  for (const h of saved) {
+    const piece = byHandle.get(h);
+    if (piece && !seen.has(piece.handle)) {
+      seen.add(piece.handle);
+      out.push({ piece, from: "saved" });
+    }
+  }
+  for (const o of orderPieces) {
+    const piece = byName.get(nameKey(o.name));
+    if (piece && !seen.has(piece.handle)) {
+      seen.add(piece.handle);
+      out.push({ piece, from: "order", on: o.on });
+    }
+  }
+  for (const n of checkoutNames) {
+    const piece = byName.get(nameKey(n));
+    if (piece && !seen.has(piece.handle)) {
+      seen.add(piece.handle);
+      out.push({ piece, from: "checkout" });
+    }
+  }
+  return out;
+};
diff --git a/src/lib/portal/checkouts.ts b/src/lib/portal/checkouts.ts
new file mode 100644
index 0000000..b18f5fb
--- /dev/null
+++ b/src/lib/portal/checkouts.ts
@@ -0,0 +1,128 @@
+import { useEffect, useMemo, useState } from "react";
+import { getSupabase } from "@/integrations/supabase/lazy";
+import { useMember } from "@/components/portal/MemberContext";
+
+/*
+  The checkouts she started while signed in: her own member_orders rows,
+  read (never written) under their existing row security, as Account reads
+  them. The bag writes a row each time it hands her to checkout, before any
+  payment, so a row is a checkout she started, never an order: it may have
+  been paid, or left. A row is called an order only once the shop's order
+  webhook has confirmed it (Phase 5's order-bloom sets status 'completed'
+  and completed_at, the order's own time): it then carries `confirmedAt`.
+  Every other row is only ever "Checkouts you started".
+
+  The database does not yet hold that line by itself: the table's insert
+  rule checks only whose row it is, so a member's own browser could write
+  'completed' onto her own rows (for her own eyes alone, since she reads
+  only hers). An owner-approved migration that lets browsers insert only
+  open checkouts closes that; until then nothing here gates, prices or
+  redeems anything, and order-bloom never writes one member's order onto
+  another's row.
+*/
+
+export type CheckoutItem = { name: string; quantity: number; size: string | null };
+export type Checkout = {
+  id: string;
+  createdAt: string;
+  items: CheckoutItem[];
+  /** The order's own time, set only once Shopify's webhook confirmed it (status 'completed'): absent on every other row. */
+  confirmedAt?: string;
+};
+
+export const CHECKOUTS_SHOWN = 12;
+
+const text = (x: unknown, max: number): string => (typeof x === "string" ? x.trim().slice(0, max) : "");
+
+/** One row as the rooms show it: the day it was started and the names of its pieces (anything malformed left out). */
+export const checkoutOf = (row: unknown): Checkout | null => {
+  if (!row || typeof row !== "object") return null;
+  const r = row as Record<string, unknown>;
+  const id = text(r.id, 64);
+  const createdAt = text(r.created_at, 40);
+  if (!id || Number.isNaN(Date.parse(createdAt))) return null;
+  const items = (Array.isArray(r.items) ? r.items : [])
+    .map((i): CheckoutItem | null => {
+      if (!i || typeof i !== "object") return null;
+      const it = i as Record<string, unknown>;
+      const name = text(it.name, 120);
+      if (!name) return null;
+      const q = Number(it.quantity);
+      return { name, quantity: Number.isInteger(q) && q > 0 ? q : 1, size: text(it.size, 24) || null };
+    })
+    .filter((i): i is CheckoutItem => i !== null);
+  // An order only when the webhook says so: status 'completed', with the order's own time.
+  const confirmedAt = r.status === "completed" ? text(r.completed_at, 40) : "";
+  return confirmedAt && !Number.isNaN(Date.parse(confirmedAt)) ? { id, createdAt, items, confirmedAt } : { id, createdAt, items };
+};
+
+/**
+ * Her own rows, newest first (row security limits the read to her; the
+ * filter says so too): her twelve newest of any kind, and with them every
+ * order that has a rose in her garden (her newest confirmed ones), so an
+ * order whose rose stands is always listed, however many checkouts came
+ * after it.
+ */
+export const readCheckouts = async (userId: string): Promise<Checkout[]> => {
+  const supabase = await getSupabase();
+  const columns = "id, created_at, items, status, completed_at";
+  const [newest, orders] = await Promise.all([
+    supabase.from("member_orders").select(columns).eq("user_id", userId).order("created_at", { ascending: false }).limit(CHECKOUTS_SHOWN),
+    supabase.from("member_orders").select(columns).eq("user_id", userId).eq("status", "completed").order("completed_at", { ascending: false }).limit(ROSES_SHOWN),
+  ]);
+  if (newest.error) throw newest.error;
+  const seen = new Set<string>();
+  return [...(newest.data ?? []), ...(orders.error ? [] : (orders.data ?? []))]
+    .map(checkoutOf)
+    .filter((c): c is Checkout => c !== null && !seen.has(c.id) && Boolean(seen.add(c.id)))
+    .sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt));
+};
+
+/** At most this many gold roses stand in her garden's front row: the newest orders' (the Order Desk lists her twelve newest rows). */
+export const ROSES_SHOWN = 8;
+
+export type ConfirmedOrder = { id: string; confirmedAt: string };
+
+/** Her confirmed orders alone, newest first, for the garden's gold roses: their ids and the orders' own times, nothing else. */
+export const readConfirmed = async (userId: string): Promise<ConfirmedOrder[]> => {
+  const supabase = await getSupabase();
+  const { data, error } = await supabase
+    .from("member_orders")
+    .select("id, created_at, status, completed_at")
+    .eq("user_id", userId)
+    .eq("status", "completed")
+    .order("completed_at", { ascending: false })
+    .limit(ROSES_SHOWN);
+  if (error) throw error;
+  return confirmedOf((data ?? []).map(checkoutOf));
+};
+
+/** The confirmed ones among these rows, newest order first, at most ROSES_SHOWN. */
+export const confirmedOf = (rows: readonly (Checkout | null)[]): ConfirmedOrder[] =>
+  rows
+    .filter((c): c is Checkout & { confirmedAt: string } => Boolean(c?.confirmedAt))
+    .map((c) => ({ id: c.id, confirmedAt: c.confirmedAt }))
+    .sort((a, b) => Date.parse(b.confirmedAt) - Date.parse(a.confirmedAt))
+    .slice(0, ROSES_SHOWN);
+
+/* The garden's bed and its words mount together: one read for the two. */
+let lastRead: { user: string; at: number; rows: Promise<ConfirmedOrder[]> } | null = null;
+const readOnce = (user: string): Promise<ConfirmedOrder[]> => {
+  if (lastRead?.user !== user || Date.now() - lastRead.at > 5000) lastRead = { user, at: Date.now(), rows: readConfirmed(user).catch(() => []) };
+  return lastRead.rows;
+};
+
+/** Her confirmed orders for the gold roses, read once a visit (the preview member's stand-in rows instead, and Supabase never asked). */
+export const useConfirmed = (): ConfirmedOrder[] => {
+  const { user, checkoutsPreview } = useMember();
+  const [read, setRead] = useState<ConfirmedOrder[]>([]);
+  useEffect(() => {
+    if (checkoutsPreview) return;
+    let live = true;
+    void readOnce(user.id).then((rows) => live && setRead(rows));
+    return () => {
+      live = false;
+    };
+  }, [user.id, checkoutsPreview]);
+  return useMemo(() => (checkoutsPreview ? confirmedOf(checkoutsPreview) : read), [checkoutsPreview, read]);
+};
