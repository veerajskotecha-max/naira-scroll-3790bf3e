+/*
+  The garden keeps Indian time. A member in Pune at 7 pm is greeted "Good
+  evening" even if her phone is set to another zone, and "once per day" for
+  the Doors means one IST day. IST has no daylight saving, so it is plain
+  UTC + 5:30 and needs no Intl time-zone data (which some older Android
+  WebViews lack).
+*/
+
+const IST_OFFSET_MS = (5 * 60 + 30) * 60 * 1000;
+
+const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+
+export type IstParts = { year: number; month: number; day: number; hour: number; minute: number };
+
+export const istParts = (at: Date = new Date()): IstParts => {
+  const t = new Date(at.getTime() + IST_OFFSET_MS);
+  return {
+    year: t.getUTCFullYear(),
+    month: t.getUTCMonth() + 1,
+    day: t.getUTCDate(),
+    hour: t.getUTCHours(),
+    minute: t.getUTCMinutes(),
+  };
+};
+
+const pad = (n: number) => String(n).padStart(2, "0");
+
+/** "2026-11-04": the IST calendar day, for once-a-day things on this device. */
+export const istDayKey = (at: Date = new Date()): string => {
+  const p = istParts(at);
+  return `${p.year}-${pad(p.month)}-${pad(p.day)}`;
+};
+
+export type DayBand = "morning" | "afternoon" | "evening" | "night";
+
+/** Morning from 4:00, afternoon from 12:00, evening from 17:00, night from midnight. */
+export const dayBand = (at: Date = new Date()): DayBand => {
+  const { hour } = istParts(at);
+  if (hour >= 4 && hour < 12) return "morning";
+  if (hour >= 12 && hour < 17) return "afternoon";
+  if (hour >= 17) return "evening";
+  return "night";
+};
+
+const GREETING: Record<DayBand, string> = {
+  morning: "Good morning",
+  afternoon: "Good afternoon",
+  evening: "Good evening",
+  // Between midnight and four, "good evening" reads wrong and "good night" is a farewell.
+  night: "Hello",
+};
+
+export const greetingFor = (at: Date = new Date()): string => GREETING[dayBand(at)];
+
+/** "4 Nov 2026", in IST: the day a member joined, as she would have seen it. */
+export const formatIstDate = (iso: string | null | undefined): string | null => {
+  if (!iso) return null;
+  const at = new Date(iso);
+  if (Number.isNaN(at.getTime())) return null;
+  const p = istParts(at);
+  return `${p.day} ${MONTHS[p.month - 1]} ${p.year}`;
+};
+
+/* ── drop times ─────────────────────────────────────────
+   A drop opens at a time the owner wrote in Indian time ("2026-11-21T20:00:00+05:30").
+   Everything below reads an instant as it falls in India, whatever zone the
+   phone is set to. */
+
+const WEEKDAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+const MONTHS_LONG = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
+
+const parse = (at: string | number | Date): Date | null => {
+  const d = at instanceof Date ? at : new Date(at);
+  return Number.isNaN(d.getTime()) ? null : d;
+};
+
+/** "8:00 pm", "12:30 am": the clock in IST, as it is said in India. */
+export const istClock = (at: string | number | Date): string | null => {
+  const d = parse(at);
+  if (!d) return null;
+  const { hour, minute } = istParts(d);
+  const h12 = hour % 12 === 0 ? 12 : hour % 12;
+  return `${h12}:${pad(minute)} ${hour < 12 ? "am" : "pm"}`;
+};
+
+/** "Fri 21 Nov · 8:00 pm IST": when a drop opens. */
+export const formatIstOpening = (at: string | number | Date): string | null => {
+  const d = parse(at);
+  if (!d) return null;
+  const p = istParts(d);
+  const weekday = WEEKDAYS[new Date(d.getTime() + IST_OFFSET_MS).getUTCDay()];
+  return `${weekday} ${p.day} ${MONTHS[p.month - 1]} · ${istClock(d)} IST`;
+};
+
+/** "21 Nov": the IST day of an instant (pressed on, arrived on). */
+export const formatIstDay = (at: string | number | Date): string | null => {
+  const d = parse(at);
+  if (!d) return null;
+  const p = istParts(d);
+  return `${p.day} ${MONTHS[p.month - 1]}`;
+};
+
+/** "tonight · 8 pm", "today · 11:30 am", "tomorrow · 8 pm", else "21 Nov": when a drop opens, as one would say it in India. */
+export const istOpensWhen = (at: string | number | Date, now: number): string | null => {
+  const d = parse(at);
+  if (!d) return null;
+  const { hour, minute } = istParts(d);
+  const clock = `${hour % 12 === 0 ? 12 : hour % 12}${minute ? `:${pad(minute)}` : ""} ${hour < 12 ? "am" : "pm"}`;
+  const day = istDayKey(d);
+  if (day === istDayKey(new Date(now))) return `${hour >= 17 ? "tonight" : "today"} · ${clock}`;
+  if (day === istDayKey(new Date(now + 86_400_000))) return `tomorrow · ${clock}`;
+  return formatIstDay(d);
+};
+
+/** "October": the IST month an instant falls in (the month a drop bloomed). */
+export const istMonthName = (at: string | number | Date): string | null => {
+  const d = parse(at);
+  return d ? MONTHS_LONG[istParts(d).month - 1] : null;
+};
+
+/** "2026-11-21T20:00:00+05:30": an instant written as the owner writes drop times. */
+export const toIstIso = (ms: number): string => {
+  const p = istParts(new Date(ms));
+  const s = new Date(ms + IST_OFFSET_MS).getUTCSeconds();
+  return `${p.year}-${pad(p.month)}-${pad(p.day)}T${pad(p.hour)}:${pad(p.minute)}:${pad(s)}+05:30`;
+};
