+/*
+  Your stone: her seed ceremony, the date field's page and the specimen
+  card. Imported only by the Stone room, so it ships in that room's own
+  chunk and the garden home never downloads it. Loaded after members.css,
+  whose shared rules (buttons, type, the date field, a piece's price and stock) it builds on.
+*/
+
+.ig-stone-page {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  max-width: 592px;
+  margin: 0 auto;
+  padding: 1.25rem 16px 3.5rem;
