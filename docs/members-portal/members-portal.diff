+    fireEvent.click(chip("Bold Nocturne Chain"));
+    fireEvent.click(chip("Baguette Tennis Necklace"));
+    const dashed = () => document.querySelectorAll('.ig-vn-chain path[stroke-dasharray="3 3"]').length;
+    expect(dashed()).toBe(0);
+    fireEvent.click(screen.getByRole("button", { name: "Show extenders" }));
+    expect(screen.getByRole("button", { name: "Show extenders" })).toHaveAttribute("aria-pressed", "true");
+    // The chain's 5 cm extender; the choker gives none.
+    expect(dashed()).toBe(1);
+  });
+
+  it("puts chains on with no draw and no swing under reduced motion", () => {
+    window.matchMedia = ((query: string) => ({ matches: query.includes("reduce"), media: query, addEventListener() {}, removeEventListener() {} })) as unknown as typeof window.matchMedia;
+    const animate = vi.fn();
+    (Element.prototype as unknown as { animate: unknown }).animate = animate;
+    room();
+    fireEvent.click(chip("Bold Nocturne Chain"));
+    expect(document.querySelectorAll(".ig-vn-chain")).toHaveLength(1);
+    expect(animate).not.toHaveBeenCalled();
+    delete (Element.prototype as unknown as { animate?: unknown }).animate;
+  });
+});
diff --git a/src/pages/members/Vanity.tsx b/src/pages/members/Vanity.tsx
new file mode 100644
index 0000000..b13a6fa
--- /dev/null
+++ b/src/pages/members/Vanity.tsx
@@ -0,0 +1,366 @@
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import LookGlass, { type Worn } from "@/components/portal/LookGlass";
+import { burstPetals } from "@/components/portal/PetalBurst";
+import { PETAL_HUE, PETAL_IDS } from "@/components/portal/PetalSymbols";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, primaryButton, quietButton, textLink } from "@/components/portal/styles";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { useWishlist } from "@/contexts/WishlistContext";
+import { useCart } from "@/contexts/CartContext";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { choices } from "@/lib/variants";
+import { shownName } from "@/lib/portal/stones";
+import { deviceHandles } from "@/lib/portal/wishlistSync";
+import { MAX_LOOK, addPlan, highestFirst, keepLook, offerWords, readLook, trayFor, vanityPiece, type AddPlan, type KeptLook, type VanityPiece } from "@/lib/portal/vanity";
+import { stillMotion } from "@/lib/portal/motion";
+import "./vanity.css";
+
+/*
+  /members/vanity: the Vanity. Live necklaces laid on a drawn neckline,
+  strictly by each listing's own Length line, one against another, up to
+  three at a time: her saved necklaces first, then every live necklace
+  whose listing gives a firm length. A listing that gives none (or says
+  "to confirm") is not drawn, and the room says so.
+
+  Every price and stock word is the live catalogue's, for the variant her
+  metal (or her month) chooses; nothing priced shows before Shopify answers.
+  The bag's own Buy 2 / Buy 3 ladder is said once, read from lib/promo.
+  "Add the look to your bag" adds each piece the bag can take, one after
+  another, and names every one it leaves for its page; it never opens
+  checkout. The bag opens over the room with the first add, so a look with
+  a piece the bag cannot take says so here first, before anything is added
+  ("Add the pieces that can go" then adds the rest); and when she closes the
+  bag, the results are said again and take focus. The look waits on this phone (lib/portal/vanity), never on her
+  account: the room writes nothing of hers.
+*/
+
+const rupees = (n: number) => `₹${n.toLocaleString("en-IN")}`;
+const uniq = (list: readonly string[]) => list.filter((h, i) => list.indexOf(h) === i);
+
+type Result = { key: string; name: string; handle: string; said: string; link?: string; retry?: boolean };
+
+const resultOf = (p: AddPlan, preview: boolean, ok?: boolean): Result => {
+  const { piece } = p.v;
+  const base = { key: piece.handle, name: piece.name, handle: piece.handle };
+  if (p.kind === "in-bag") return { ...base, said: "Already in your bag." };
+  if (p.kind === "sold-out") return { ...base, said: "Sold out.", link: "See its page" };
+  if (p.kind === "preorder") return { ...base, said: "A pre-order piece: its page takes it.", link: "See its page" };
+  if (p.kind === "choose") return { ...base, said: p.v.preset.needs === "month" ? "Its month is yours to choose." : "Its choice is yours to make.", link: "Choose on its page" };
+  if (!ok) return { ...base, said: "Not added.", retry: true };
+  return { ...base, said: import.meta.env.DEV && preview ? "Preview only: nothing was added to a bag." : "In your bag." };
+};
+
+const Chip = ({ v, worn, onToggle }: { v: VanityPiece; worn: boolean; onToggle: (v: VanityPiece) => void }) => {
+  const img = v.variant?.image ?? v.piece.cover ?? v.piece.image;
+  return (
+    <li>
+      <button type="button" className="ig-vn-chip" aria-pressed={worn} onClick={() => onToggle(v)}>
+        {img && <img src={shopifyImage(img, 120)} srcSet={shopifySrcSet(img, [120, 240]) || undefined} sizes="56px" width={56} height={56} loading="lazy" decoding="async" alt="" />}
+        <span className="ig-vn-chip-name">{v.piece.name}</span>
+        <span className="ig-vn-chip-len">
+          {v.length.words}
+          {!v.preset.available && <span className="ig-stock ig-stock--out ig-vn-chip-out">Sold out</span>}
+        </span>
+      </button>
+    </li>
+  );
+};
+
+const Vanity = () => {
+  const { user, naira, month, addToBag, preview, garden } = useMember();
+  const wishlist = useWishlist();
+  const { items: bag, isDrawerOpen } = useCart();
+  const { jewellery, isLive, isLoading } = useLiveJewellery();
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const statusRef = useRef<HTMLDivElement>(null);
+  const actionsRef = useRef<HTMLDivElement>(null);
+  const glassRef = useRef<HTMLDivElement>(null);
+  const inFlight = useRef(false);
+  const live = useRef(true);
+  // The bag is open over the room (the first add opens it): the results wait to be said until she closes it.
+  const bagOpen = useRef(isDrawerOpen);
+  bagOpen.current = isDrawerOpen;
+  const afterBag = useRef(false);
+
+  // Her look, as this phone kept it (or, in development only, the preview's fixture look, &look=1).
+  const [kept, setKept] = useState<KeptLook>(() => (import.meta.env.DEV && garden?.look ? garden.look.map((h) => [h, ""] as [string, string]) : readLook(user.id)));
+  const [leaving, setLeaving] = useState<Worn[]>([]);
+  const [extenders, setExtenders] = useState(false);
+  const [said, setSaid] = useState("");
+  const [results, setResults] = useState<Result[] | null>(null);
+  // Said before anything is added: some of her look cannot go in the bag, and the rest can.
+  const [planned, setPlanned] = useState(false);
+  // Bumped to say the results again (a live region speaks only what changes).
+  const [round, setRound] = useState(0);
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+    return () => {
+      live.current = false;
+    };
+  }, []);
+
+  const bloom = () => {
+    const root = actionsRef.current;
+    if (root) burstPetals(root, root.offsetWidth / 2, 24, { count: 14, spread: 100, ids: [PETAL_HUE, PETAL_IDS[0], PETAL_IDS[3], PETAL_IDS[5]], color: "#FFBDA8" });
+  };
+  const added = useRef(false);
+  const sayResults = () => {
+    setRound((r) => r + 1);
+    window.setTimeout(() => statusRef.current?.focus(), 0);
+    if (added.current) bloom();
+    added.current = false;
+  };
+
+  // She has closed the bag that opened over the room: the results are said again, and take focus (after the bag's own focus return).
+  useEffect(() => {
+    if (isDrawerOpen || !afterBag.current) return;
+    afterBag.current = false;
+    const t = window.setTimeout(sayResults, 80);
+    return () => window.clearTimeout(t);
+    // When the bag closes.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [isDrawerOpen]);
+
+  const saved = useMemo(() => uniq([...naira.saved, ...deviceHandles(wishlist.items)]), [naira.saved, wishlist.items]);
+  const tray = useMemo(() => (isLive ? trayFor(jewellery, saved, naira.metal, month) : null), [isLive, jewellery, saved, naira.metal, month]);
+  const look = useMemo(() => {
+    if (!isLive) return [];
+    return kept
+      .map(([handle, variantId]) => {
+        const piece = jewellery.find((p) => p.handle === handle);
+        return piece ? vanityPiece(piece, naira.metal, month, variantId || undefined) : null;
+      })
+      .filter((v): v is VanityPiece => v !== null);
+  }, [isLive, kept, jewellery, naira.metal, month]);
+  const wornKeys = look.map((v) => v.piece.handle);
+
+  const keep = (next: KeptLook) => {
+    setKept(next);
+    keepLook(user.id, next);
+  };
+
+  const takeOff = (v: VanityPiece) => {
+    keep(kept.filter(([h]) => h !== v.piece.handle));
+    setLeaving((l) => [...l.filter((x) => x.key !== v.piece.handle), { key: v.piece.handle, v, leaving: true }]);
+    setSaid(`${v.piece.name}: off the glass.`);
+    setResults(null);
+    setPlanned(false);
+  };
+
+  /* On a short phone, a chain laid on from the tray is drawn where she can see it: the glass comes up when less than 60% of it shows. */
+  const glassIntoView = () => {
+    const glass = glassRef.current;
+    if (!glass) return;
+    const r = glass.getBoundingClientRect();
+    const top = Math.max(r.top, document.querySelector("header")?.getBoundingClientRect().bottom ?? 0);
+    const bottom = Math.min(r.bottom, document.querySelector(".ig-nav")?.getBoundingClientRect().top ?? window.innerHeight);
+    if (r.height > 0 && bottom - top < r.height * 0.6) glass.scrollIntoView?.({ block: "start", behavior: stillMotion() ? "auto" : "smooth" });
+  };
+
+  const toggle = (v: VanityPiece) => {
+    if (wornKeys.includes(v.piece.handle)) {
+      takeOff(v);
+      return;
+    }
+    if (look.length >= MAX_LOOK) {
+      setSaid("Three is as many as the glass holds. Take one off first.");
+      return;
+    }
+    setLeaving((l) => l.filter((x) => x.key !== v.piece.handle));
+    keep([...kept.filter(([h]) => look.some((x) => x.piece.handle === h)), [v.piece.handle, v.variant?.id ?? ""]]);
+    setSaid(`${v.piece.name}: on the glass, ${v.length.words}.`);
+    setResults(null);
+    setPlanned(false);
+    glassIntoView();
+  };
+
+  const clear = () => {
+    keep([]);
+    setLeaving(look.map((v) => ({ key: v.piece.handle, v, leaving: true })));
+    setSaid("The glass is clear.");
+    setResults(null);
+    setPlanned(false);
+  };
+
+  const gone = useCallback((key: string) => setLeaving((l) => l.filter((x) => x.key !== key)), []);
+
+  /* Every piece the bag can take, one after another; each one it cannot is named, with its page. */
+  const addLook = async (only?: string, sure = false) => {
+    if (inFlight.current) return;
+    const inBag = (id: string) => bag.some((line) => line.variantId === id);
+    const plan = addPlan(only ? look.filter((v) => v.piece.handle === only) : look, inBag);
+    // The bag opens over the room with the first add: a piece it cannot take is said here first, while she can read it.
+    if (!only && !sure && plan.some((p) => p.kind === "add") && plan.some((p) => p.kind !== "add" && p.kind !== "in-bag")) {
+      setSaid("");
+      setResults(plan.map((p) => (p.kind === "add" ? { key: p.v.piece.handle, name: p.v.piece.name, handle: p.v.piece.handle, said: "Can go in your bag." } : resultOf(p, preview))));
+      setPlanned(true);
+      sayResults();
+      return;
+    }
+    inFlight.current = true;
+    setBusy(true);
+    setPlanned(false);
+    const out: Result[] = [];
+    for (const p of plan) {
+      if (p.kind !== "add" || !p.v.preset.line) {
+        out.push(resultOf(p, preview));
+        continue;
+      }
+      let ok = false;
+      try {
+        ok = await addToBag(p.v.preset.line);
+      } catch {
+        ok = false;
+      }
+      out.push(resultOf(p, preview, ok));
+    }
+    inFlight.current = false;
+    if (!live.current) return;
+    setBusy(false);
+    setSaid("");
+    setResults((prev) => (only && prev ? prev.map((r) => out.find((o) => o.key === r.key) ?? r) : out));
+    added.current = out.some((r) => r.said === "In your bag." || r.said.startsWith("Preview only"));
+    // Under the open bag the room is hidden from her and her screen reader: the results are said once she closes it.
+    if (bagOpen.current) afterBag.current = true;
+    else sayResults();
+  };
+
+  const worn: Worn[] = [...look.map((v) => ({ key: v.piece.handle, v })), ...leaving.filter((x) => !wornKeys.includes(x.key))];
+  const offer = offerWords();
+  const hasDrawer = Boolean(tray?.drawer.length);
+
+  return (
+    <PortalShell title="The Vanity" description="The Vanity in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-vn-page">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1 ig-vn-h1">
+            The <em>Vanity</em>
+          </h1>
+          <p className="ig-lede">Tap a necklace below to lay it on the glass, drawn to its listed length.</p>
+        </div>
+
+        <div ref={glassRef} className="ig-vn-glasswrap">
+          <LookGlass worn={worn} extenders={extenders} onGone={gone} />
+        </div>
+
+        {!isLive ? (
+          <p className="ig-fineprint ig-vn-wait" role="status">
+            {isLoading ? "Reading today's necklaces from the shop…" : "We couldn't reach the shop just now. The vanity lays out live necklaces only, so nothing is drawn until the shop answers."}
+          </p>
+        ) : (
+          <div className="ig-vn-tray">
+            {hasDrawer && (
+              <>
+                <h2 className="ig-vn-row-title">From your drawer</h2>
+                <ul className="ig-vn-row">
+                  {tray!.drawer.map((v) => (
+                    <Chip key={v.piece.handle} v={v} worn={wornKeys.includes(v.piece.handle)} onToggle={toggle} />
+                  ))}
+                </ul>
+              </>
+            )}
+            <h2 className="ig-vn-row-title">From the shop</h2>
+            <ul className="ig-vn-row">
+              {tray!.shop.map((v) => (
+                <Chip key={v.piece.handle} v={v} worn={wornKeys.includes(v.piece.handle)} onToggle={toggle} />
+              ))}
+            </ul>
+            <p className="ig-fineprint">Necklaces whose listing gives no length yet are not drawn here.</p>
+          </div>
+        )}
+
+        <p className="ig-fineprint ig-vn-said" role="status">
+          {said}
+        </p>
+
+        <div className="ig-vn-tools">
+          <button type="button" className={quietButton} aria-pressed={extenders} onClick={() => setExtenders((e) => !e)}>
+            Show extenders
+          </button>
+        </div>
+        <p className="ig-vn-caption">Drawn to each listing's own length, one against another. Where a chain sits on you depends on you.</p>
+
+        <section className="ig-section" aria-labelledby="ig-vn-look">
+          <h2 id="ig-vn-look" className="ig-h2">
+            Your look
+          </h2>
+          {look.length === 0 ? (
+            <p className="ig-fineprint">Nothing on the glass yet. Tap a necklace above to lay it on.</p>
+          ) : (
+            <ol className="ig-vn-look" aria-label="Your look in words, from the highest chain">
+              {highestFirst(look).map((v) => {
+                const chosen = v.variant ? choices(v.piece).map((o) => v.variant!.options[o.name]).filter(Boolean).join(" · ") : "";
+                const { price, compareAtPrice, available } = v.preset;
+                return (
+                  <li key={v.piece.handle} className="ig-vn-item">
+                    <span className="ig-vn-item-name" id={`ig-vn-${v.piece.handle}`}>
+                      <Link to={`/jewellery/${v.piece.handle}`}>{v.piece.name}</Link>
+                    </span>
+                    <span className="ig-fineprint">
+                      {v.length.words}
+                      {chosen ? `, in ${shownName(chosen)}` : ""}
+                    </span>
+                    <span className="ig-price ig-vn-price">
+                      <span>{rupees(price)}</span>
+                      {compareAtPrice && compareAtPrice > price ? <s>{rupees(compareAtPrice)}</s> : null}
+                      <span className={available ? "ig-stock" : "ig-stock ig-stock--out"}>{available ? "Available" : "Sold out"}</span>
+                    </span>
+                    <button type="button" className={quietButton} onClick={() => takeOff(v)} aria-describedby={`ig-vn-${v.piece.handle}`}>
+                      Take off
+                    </button>
+                  </li>
+                );
+              })}
+            </ol>
+          )}
+          <p className="ig-fineprint">Kept on this phone.</p>
+          {offer && <p className="ig-vn-offer">{offer}</p>}
+          <div ref={actionsRef} className="ig-vn-actions">
+            {/* Never disabled while adding (a focused button that is disabled drops focus to the page, and the bag would hand it back nowhere): a second press waits. */}
+            <button type="button" className={primaryButton} onClick={() => void addLook(undefined, planned)} disabled={look.length === 0} aria-disabled={busy || undefined}>
+              {busy ? "Adding…" : "Add the look to your bag"}
+            </button>
+            {look.length > 0 && (
+              <button type="button" className={quietButton} onClick={clear}>
+                Clear the glass
+              </button>
+            )}
+          </div>
+          <div ref={statusRef} tabIndex={-1} role="status" className="ig-vn-results">
+            {results && (
+              <ul key={round}>
+                {results.map((r) => (
+                  <li key={r.key}>
+                    <strong>{r.name}</strong>: {r.said}{" "}
+                    {r.link && (
+                      <Link className={textLink} to={`/jewellery/${r.handle}`}>
+                        {r.link}
+                      </Link>
+                    )}
+                    {r.retry && (
+                      <button type="button" className={textLink} onClick={() => void addLook(r.handle)}>
+                        Try again
+                      </button>
+                    )}
+                  </li>
+                ))}
+              </ul>
+            )}
+            {planned && (
+              <button type="button" className={quietButton} onClick={() => void addLook(undefined, true)}>
+                Add the pieces that can go
+              </button>
+            )}
+          </div>
+        </section>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Vanity;
diff --git a/src/pages/members/VanityBag.test.tsx b/src/pages/members/VanityBag.test.tsx
new file mode 100644
index 0000000..95a97eb
--- /dev/null
+++ b/src/pages/members/VanityBag.test.tsx
@@ -0,0 +1,111 @@
+import { act, cleanup, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { useState } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { jewellery as bundled } from "@/data/jewellery";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import type { JewelPiece } from "@/data/jewellery";
+import { VANITY_KEY } from "@/lib/portal/vanity";
+import { Sheet, SheetContent, SheetTitle } from "@/components/ui/sheet";
+
+/*
+  The Vanity with the shop's own bag (Phase 6 polish, ENG6-02). In
+  production the first add opens the bag, a modal sheet that hides the rest
+  of the page from her screen reader and takes focus. So a look with a
+  piece the bag cannot take says so in the room before anything is added,
+  and once she closes the bag the results are said again and take focus.
+  The real @/components/ui/sheet is used, opened by addToBag as
+  MembersRoute's does.
+*/
+
+const catalogue: JewelPiece[] = [...bundled, ...jewellerySnapshot.filter((p) => !bundled.some((j) => j.handle === p.handle))];
+
+const shop = vi.hoisted(() => ({ jewellery: [] as unknown[], isLive: true, isLoading: false }));
+const cart = vi.hoisted(() => ({ items: [] as { variantId: string }[], buyNow: vi.fn(), isDrawerOpen: false }));
+const member = vi.hoisted(() => ({ value: {} as Record<string, unknown> }));
+const bag = vi.hoisted(() => ({ open: (_: boolean) => {} }));
+
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => shop }));
+vi.mock("@/contexts/WishlistContext", () => ({ useWishlist: () => ({ items: [] }) }));
+vi.mock("@/contexts/CartContext", () => ({ useCart: () => cart }));
+vi.mock("@/components/portal/MemberContext", () => ({ useMember: () => member.value }));
+vi.mock("@/components/portal/PortalShell", () => ({ default: ({ children }: { children: unknown }) => <div>{children as never}</div> }));
+
+import Vanity from "./Vanity";
+
+// As MembersRoute's addToBag in production: the bag opens, then the add is awaited.
+const addToBag = vi.fn(async (_line: { variantId: string }) => {
+  bag.open(true);
+  await new Promise((r) => setTimeout(r, 5));
+  return true;
+});
+
+const Room = () => {
+  const [open, setOpen] = useState(false);
+  bag.open = setOpen;
+  cart.isDrawerOpen = open;
+  return (
+    <MemoryRouter>
+      <Vanity />
+      <Sheet open={open} onOpenChange={setOpen}>
+        <SheetContent>
+          <SheetTitle>Your bag</SheetTitle>
+          <button type="button">Checkout</button>
+        </SheetContent>
+      </Sheet>
+    </MemoryRouter>
+  );
+};
+
+const results = () => document.querySelector(".ig-vn-results") as HTMLElement;
+const lookOf = (...handles: string[]) => window.localStorage.setItem(VANITY_KEY, JSON.stringify({ u: "u-9", h: handles.map((h) => [h, ""]) }));
+
+beforeEach(() => {
+  shop.jewellery = catalogue;
+  cart.items = [];
+  cart.isDrawerOpen = false;
+  window.localStorage.clear();
+  addToBag.mockClear();
+  member.value = { user: { id: "u-9" }, naira: { v: 1, saved: [], pressed: [], front: [], gifts: [] }, month: null, addToBag, preview: false, garden: null };
+});
+afterEach(() => cleanup());
+
+describe("the Vanity beside the shop's bag", () => {
+  it("says a piece the bag cannot take before the bag opens over the room, where she and her screen reader can read it", async () => {
+    lookOf("bold-nocturne-chain", "birthstone-heart-necklace");
+    render(<Room />);
+    fireEvent.click(screen.getByRole("button", { name: "Add the look to your bag" }));
+    expect(addToBag).not.toHaveBeenCalled();
+    expect(document.querySelector('[role="dialog"]')).toBeNull();
+    expect(results().textContent).toMatch(/Birthstone Heart Necklace: Its month is yours to choose\./);
+    expect(results().closest('[aria-hidden="true"]')).toBeNull();
+    await waitFor(() => expect(document.activeElement).toBe(results()));
+  });
+
+  it("with the bag open over the room, waits; once she closes it, says the results again and gives them focus", async () => {
+    lookOf("bold-nocturne-chain", "dewdrop-bezel-necklace");
+    render(<Room />);
+    const add = screen.getByRole("button", { name: "Add the look to your bag" });
+    add.focus();
+    fireEvent.click(add);
+    await waitFor(() => expect(addToBag).toHaveBeenCalledTimes(2));
+    await waitFor(() => expect(results().textContent).toMatch(/Dewdrop Bezel Necklace: In your bag\./));
+    expect(document.querySelector('[role="dialog"]')).not.toBeNull();
+    // The bag has the room hidden: the results are not pulled out from under it.
+    await act(async () => {
+      await new Promise((r) => setTimeout(r, 30));
+    });
+    expect(document.activeElement).not.toBe(results());
+    const before = results().querySelector("ul");
+    await act(async () => {
+      bag.open(false);
+      await new Promise((r) => setTimeout(r, 200));
+    });
+    expect(document.querySelector('[role="dialog"]')).toBeNull();
+    await waitFor(() => expect(document.activeElement).toBe(results()));
+    expect(results().closest('[aria-hidden="true"]')).toBeNull();
+    // Said again: the list is new, so the live region speaks it.
+    expect(results().querySelector("ul")).not.toBe(before);
+    expect(results().textContent).toMatch(/Bold Nocturne Chain: In your bag\./);
+  });
+});
diff --git a/src/pages/members/Vault.tsx b/src/pages/members/Vault.tsx
new file mode 100644
index 0000000..2612e0c
--- /dev/null
+++ b/src/pages/members/Vault.tsx
@@ -0,0 +1,97 @@
+import { useEffect, useMemo, useRef } from "react";
+import { FlowerGlyph } from "@/components/portal/FlowerGlyph";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import HerbariumFrame from "@/components/portal/HerbariumFrame";
+import { useMember } from "@/components/portal/MemberContext";
+import { eyebrow, textLink } from "@/components/portal/styles";
+import { byOpening, dropNumber, speciesIndex, timeOf, VAULT_AFTER_MS } from "@/lib/portal/dropPhase";
+import { formatIstDay, istMonthName } from "@/lib/portal/ist";
+import { useServerNow } from "@/lib/portal/clock";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import "./vault.css";
+
+/*
+  /members/vault: her pressed flowers and every drop that has rested, newest
+  first, as a wall of herbarium frames hung by hand. A flower she pressed is
+  here from the moment she pressed it, with the day; a drop that rested (14
+  days after it opened to everyone) without one is the same frame, gently
+  empty: "This one bloomed in October". Each opens to its room: the story,
+  and its pieces with live Available / Sold out. Pressed flowers are
+  keepsakes for joy, never points.
+*/
+
+const Vault = () => {
+  const { drops, pressed } = useMember();
+  const marks = useMemo(() => drops.map((d) => timeOf(d.everyoneFrom) + VAULT_AFTER_MS), [drops]);
+  const now = useServerNow(marks, drops.length > 0);
+  const kept = useMemo(
+    () => byOpening(drops).filter((d) => pressed.some((p) => p.id === d.id) || now >= timeOf(d.everyoneFrom) + VAULT_AFTER_MS).reverse(),
+    [drops, pressed, now],
+  );
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+
+  const emptyRef = useRef<HTMLDivElement>(null);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  // An empty Vault is a faint frame whose flower draws itself in once, in gold line.
+  const empty = kept.length === 0;
+  useEffect(() => {
+    if (!empty || stillMotion()) return;
+    emptyRef.current?.querySelectorAll("path, circle").forEach((line, i) => {
+      (line as SVGElement).style.strokeDasharray = "1 1";
+      play(line, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 1100, delay: 200 + i * 45, easing: EASE_REVEAL, fill: "backwards" });
+    });
+  }, [empty]);
+
+  return (
+    <PortalShell title="The Vault" description="The Vault: past drops in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-vault">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            The <em>Vault</em>
+          </h1>
+          <p className="ig-lede">Every flower you have pressed, and every drop that has bloomed. Newest first.</p>
+        </div>
+        {empty ? (
+          <section className="ig-section ig-vault-empty">
+            <div ref={emptyRef} className="ig-vault-frame" aria-hidden>
+              <FlowerGlyph species={4} accent="#E5B9A4" state="line" size={120} />
+            </div>
+            <p className="ig-fineprint">Nothing is in the Vault yet. A drop's flower is kept here once you press it, and every drop rests here after it has bloomed.</p>
+            <Link className={textLink} to="/members/drops">
+              See the drops
+            </Link>
+          </section>
+        ) : (
+          <ul className="ig-wall">
+            {kept.map((d) => {
+              const mine = pressed.find((p) => p.id === d.id);
+              return (
+                <li key={d.id}>
+                  <Link to={`/members/drops/${d.id}`} className="ig-wall-link">
+                    <HerbariumFrame
+                      species={speciesIndex(d.species)}
+                      accent={d.accent}
+                      pressed={Boolean(mine)}
+                      title={`Drop ${dropNumber(d, drops)} · ${d.title}`}
+                      note={mine ? (mine.on ? `pressed ${formatIstDay(`${mine.on}T12:00:00+05:30`)}` : "pressed") : `This one bloomed in ${istMonthName(d.membersFrom)}`}
+                      size={130}
+                    />
+                  </Link>
+                </li>
+              );
+            })}
+          </ul>
+        )}
+        <p className="ig-fineprint ig-vault-joy">Pressed flowers are keepsakes for joy. Not points, never redeemable.</p>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Vault;
diff --git a/src/pages/members/card.css b/src/pages/members/card.css
new file mode 100644
