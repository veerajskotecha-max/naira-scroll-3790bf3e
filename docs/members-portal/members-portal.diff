+/*
+  The gift ledger's rules: eight dates at most (a ninth refused, never one
+  dropped), names of 12 characters or fewer, a yearly reminder a week
+  before, the next date read in Indian time across the turn of the year,
+  and picks priced only from the live shop. And the account's memory still
+  under 1.2 KB with eight dates beside everything Phase 3 keeps at its most.
+*/
+
+const gift = (n: string, m: number, d: number, b: Gift["b"] = 1500): Gift => ({ n, m, d, b });
+const ist = (iso: string) => Date.parse(iso);
+
+describe("the ledger's limits", () => {
+  it("keeps eight dates at most and refuses a ninth with a message", () => {
+    let n = readNaira(null);
+    for (let i = 0; i < MAX_GIFTS; i++) n = giftAdded(gift(`G${i}`, 1 + i, 3))(n);
+    expect(n.gifts).toHaveLength(MAX_GIFTS);
+    const ninth = gift("One more", 12, 1);
+    expect(refuseAnother(n.gifts, ninth)).toMatch(/Eight dates are kept at most/);
+    // Applied anyway (another phone's change landing first), it leaves the ledger as it was.
+    expect(giftAdded(ninth)(n)).toBe(n);
+    // Nothing kept is let go to make room.
+    expect(n.gifts.map((g) => g.n)).toEqual(Array.from({ length: 8 }, (_, i) => `G${i}`));
+    // An account that somehow holds more is read as its first eight, never more.
+    expect(readNaira({ v: 1, gifts: [...compactNaira(n).gifts as string[], "12011Extra"] }).gifts).toHaveLength(8);
+  });
+
+  it("takes names of 12 characters or fewer, and says why it will not take one", () => {
+    expect(LABEL_MAX).toBe(12);
+    expect(checkGift({ n: "  Riya   Didi ", m: 3, d: 14, b: 1500 })).toEqual({ ok: true, gift: gift("Riya Didi", 3, 14) });
+    expect(checkGift({ n: "x".repeat(12), m: 3, d: 14, b: 1500 }).ok).toBe(true);
+    const long = checkGift({ n: "x".repeat(13), m: 3, d: 14, b: 1500 });
+    expect(long).toMatchObject({ ok: false, field: "n" });
+    if (long.ok === false) expect(long.message).toMatch(/12 characters or fewer/);
+    expect(checkGift({ n: "   ", m: 3, d: 14, b: 1500 })).toMatchObject({ ok: false, field: "n" });
+    expect(checkGift({ n: "माँ", m: 3, d: 14, b: 1500 }).ok).toBe(true);
+    // Her account refuses one longer too, whatever wrote it.
+    expect(giftOf({ n: "x".repeat(13), m: 3, d: 14, b: 1500 })).toBeNull();
+    expect(giftOf("03141" + "x".repeat(13))).toBeNull();
+  });
+
+  it("takes out control and broken characters, which JSON would write six bytes each", () => {
+    expect(cleanLabel("Mu\u0000m\u0007")).toBe("Mum");
+    expect(cleanLabel("Ri\uD800ya")).toBe("Riya");
+    expect(giftOf({ n: "Mu\u0001m", m: 3, d: 14, b: 1500 })).toBeNull();
+    expect(giftOf({ n: "Ri\uDC00ya", m: 3, d: 14, b: 1500 })).toBeNull();
+    // A whole character from beyond the basic plane (two code units) is fine.
+    expect(giftOf({ n: "Mum 🌸", m: 3, d: 14, b: 1500 })).not.toBeNull();
+  });
+
+  it("checks the day against the month, and the band against the Gifting page's", () => {
