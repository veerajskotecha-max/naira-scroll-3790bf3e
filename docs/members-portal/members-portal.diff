+const Herbarium = () => {
+  const { user, month, drops, pressed, naira, garden } = useMember();
+  const marks = useMemo(() => drops.map((d) => timeOf(d.membersFrom)), [drops]);
+  const now = useServerNow(marks, drops.length > 0);
+  const bloomed = useMemo(() => byOpening(drops).filter((d) => now >= timeOf(d.membersFrom)).reverse(), [drops, now]);
+  // By day her garden shows no "Look up", so the stars' frame leads there only after dark (its note already says so).
+  const night = (garden?.hour ?? skyHour()) === "night";
+  const keepsakes = useMemo(
+    () => keepsakesFor({ joinedAt: user.created_at, month, naira, drops, found: piecesFound(naira, user.id) }).map((k) => (k.id === "stars" && k.to === "/members" && !night ? { ...k, to: undefined } : k)),
+    [user.id, user.created_at, month, naira, drops, night],
+  );
