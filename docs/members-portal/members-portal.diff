+
+  it("writes each date as one short string and reads it back as the same date", () => {
+    const n = { ...readNaira(null), gifts: [gift("Mum", 3, 14), gift("माँ", 12, 31, 2500), gift("Isha", 2, 29, 1000)] };
+    const written = compactNaira(n);
+    expect(written.gifts).toEqual(["03141Mum", "12312माँ", "02290Isha"]);
+    expect(readNaira(JSON.parse(JSON.stringify(written))).gifts).toEqual(n.gifts);
+    // The object form is still read, should anything ever have written it.
+    expect(readNaira({ v: 1, gifts: [{ n: "Mum", m: 3, d: 14, b: 1500 }] }).gifts).toEqual([gift("Mum", 3, 14)]);
+    expect(readNaira({ v: 1, gifts: ["0314", "13011Bad", "03149Bad", 7] }).gifts).toEqual([]);
