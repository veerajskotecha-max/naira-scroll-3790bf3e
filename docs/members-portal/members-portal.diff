+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+/* The 6-digit email code, with its flag turned on as the owner will once the
+   email template carries {{ .Token }}. Supabase is mocked. */
+
+vi.mock("@/lib/auth/flags", () => ({ EMAIL_CODE_SIGN_IN: true }));
+vi.mock("@/contexts/AuthContext", () => ({
+  useAuth: () => ({ session: null, user: null, profile: null, loading: false, refreshProfile: async () => {}, signOut: async () => {} }),
+}));
+const sb = vi.hoisted(() => ({
+  signInWithOtp: vi.fn(async () => ({ data: {}, error: null })),
+  verifyOtp: vi.fn(async () => ({ data: { user: { id: "u-1", user_metadata: {} }, session: {} }, error: null })),
+}));
+vi.mock("@/integrations/supabase/client", () => ({
+  supabase: {
+    auth: {
+      onAuthStateChange: () => ({ data: { subscription: { unsubscribe: () => {} } } }),
+      signInWithOtp: sb.signInWithOtp,
+      verifyOtp: sb.verifyOtp,
+    },
+  },
+}));
+vi.mock("@/integrations/lovable/index", () => ({ lovable: { auth: { signInWithOAuth: vi.fn() } } }));
+vi.mock("@/lib/pixel", () => ({ trackPixel: vi.fn() }));
+vi.mock("@/lib/innerCircle", () => ({ joinInnerCircle: vi.fn() }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => <footer /> }));
+
+import Auth from "./Auth";
+
+afterEach(cleanup);
+
+describe("the email code, switched on", () => {
+  it("sends a code to an existing account only, then signs in with it", async () => {
+    window.history.replaceState(null, "", "/auth?next=%2Fmembers");
+    render(
+      <MemoryRouter initialEntries={["/auth?next=%2Fmembers"]}>
+        <Routes>
+          <Route path="/auth" element={<Auth />} />
+          <Route path="/members" element={<p>members room</p>} />
+        </Routes>
+      </MemoryRouter>,
+    );
+    fireEvent.click(screen.getByRole("button", { name: /email me a sign-in code instead/i }));
+    expect(screen.getByRole("heading", { level: 1 })).toHaveTextContent("Sign in with a code.");
+    fireEvent.change(screen.getByLabelText("Email address"), { target: { value: "ananya.r@example.com" } });
+    fireEvent.click(screen.getByRole("button", { name: /email me a code/i }));
+    expect(await screen.findByRole("status")).toHaveTextContent("We've emailed a 6-digit code to ananya.r@example.com");
+    expect(sb.signInWithOtp).toHaveBeenCalledWith({ email: "ananya.r@example.com", options: { shouldCreateUser: false } });
+
+    fireEvent.change(screen.getByLabelText("6-digit code"), { target: { value: "12a34" } });
+    expect(screen.getByLabelText("6-digit code")).toHaveValue("1234");
+    fireEvent.click(screen.getByRole("button", { name: /^sign in$/i }));
+    expect(await screen.findByRole("alert")).toHaveTextContent("Please type the 6 digits from the email.");
+    expect(sb.verifyOtp).not.toHaveBeenCalled();
+
+    fireEvent.change(screen.getByLabelText("6-digit code"), { target: { value: "123456" } });
+    fireEvent.click(screen.getByRole("button", { name: /^sign in$/i }));
+    expect(await screen.findByText("members room")).toBeInTheDocument();
+    expect(sb.verifyOtp).toHaveBeenCalledWith({ email: "ananya.r@example.com", token: "123456", type: "email" });
+  });
+});
