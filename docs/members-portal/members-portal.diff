+/* The rooms still holding a piece of the Naira flower, under Gathered's frame: a short list of links. */
+const ROOMS_LINE = { margin: "0.5rem 0 0", textAlign: "center" } as const;
+const ROOMS_LIST = { display: "flex", flexWrap: "wrap", justifyContent: "center", columnGap: "0.4rem", margin: 0, padding: 0, listStyle: "none" } as const;
