+.ig-bed-roses { pointer-events: none; }
+.ig-rose-line { fill: none; stroke: #B0843A; stroke-dasharray: 1 1; }
+.ig-rose-bloom { transform-box: fill-box; transform-origin: 50% 100%; }
+.ig-soil { fill: none; stroke: var(--nf-accent); stroke-width: 1; }
+.ig-arbour-line { fill: none; stroke: var(--nf-accent); stroke-width: 1.2; opacity: 0.85; }
+.ig-arbour-line--fine { stroke-width: 0.7; opacity: 0.55; }
