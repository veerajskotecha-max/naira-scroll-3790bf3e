+import { describe, expect, it } from "vitest";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { jewellery, type JewelPiece } from "@/data/jewellery";
+import { RITUAL, careLineOf, houseCareLine, piecesForCare, platingOf, pvdExplainer, pvdLineOf, ritualFor } from "./care";
+import { checkoutOf } from "./checkouts";
+
+/*
+  Care says only what the listings say: each piece's own care line, its
+  Plating line, the PVD explainer from its details, and a ritual whose three
+  steps are the care line's own words, drawn only while the shop's care
+  line still says them.
+*/
+
+const catalogue = jewellerySnapshot as JewelPiece[];
+
+describe("care in the listings' own words", () => {
+  it("reads each piece's care line, finish and PVD explainer from its listing", () => {
+    const piece = catalogue.find((p) => p.handle === "riviere-eternal-necklace") ?? catalogue.find((p) => pvdLineOf(p)) as JewelPiece;
+    expect(careLineOf(piece)).toBe(piece.care);
+    expect(platingOf(piece)).toMatch(/^PVD 18K gold coating/);
+    expect(pvdLineOf(piece)).toMatch(/^Regular plating is a soft layer that wears off over time\. PVD is bonded to the metal in a vacuum/);
+    expect(careLineOf({ ...piece, care: undefined })).toBeNull();
+    expect(pvdLineOf({ ...piece, details: ["Plating: Rhodium"] })).toBeNull();
+  });
+
+  it("finds the shop's own care line and PVD explainer, word for word", () => {
+    const line = houseCareLine(catalogue);
+    expect(line).toBe("Waterproof and tarnish free, so daily wear and water are fine. Keep it away from perfume and harsh chemicals, wipe with a soft dry cloth and store it flat in its pouch.");
+    expect(catalogue.filter((p) => p.care === line).length).toBeGreaterThan(catalogue.length / 2);
+    const pvd = pvdExplainer(catalogue);
+    expect(pvd).toBe("Regular plating is a soft layer that wears off over time. PVD is bonded to the metal in a vacuum, so it is far harder, stands up to sweat and keeps its colour much longer.");
+    // The bundled listings say the same.
+    expect(houseCareLine(jewellery)).toBe(line);
+    expect(pvdExplainer(jewellery)).toBe(pvd);
+  });
+
+  it("builds the ritual only from steps the care line says", () => {
+    const line = houseCareLine(catalogue);
+    expect(ritualFor(line)).toBe(RITUAL);
+    expect(RITUAL).toHaveLength(3);
+    for (const step of RITUAL) {
+      expect(step.match.test(step.words)).toBe(true);
+      // Each step's words, less the closing stop, are the care line's own (in any case).
+      expect(line?.toLowerCase()).toContain(step.words.replace(/\.$/, "").toLowerCase());
+    }
+    // A care line that no longer says one of them takes the ritual away.
+    expect(ritualFor("Keep it dry and away from perfume and harsh chemicals. Wipe with a soft dry cloth.")).toBeNull();
+    expect(ritualFor(null)).toBeNull();
+  });
+
+  it("lays out her saved pieces, then pieces from checkouts she started, each once", () => {
+    const [a, b, c] = catalogue;
+    const out = piecesForCare(catalogue, [a.handle, "not-in-the-shop"], [` ${b.name.toUpperCase()} `, a.name, "Unknown piece", c.name]);
+    expect(out.map((x) => [x.piece.handle, x.from])).toEqual([
+      [a.handle, "saved"],
+      [b.handle, "checkout"],
+      [c.handle, "checkout"],
+    ]);
+  });
+
+  it("reads a checkout row for its day and pieces, and leaves out what is malformed", () => {
+    expect(checkoutOf({ id: "r1", created_at: "2026-11-03T14:10:00Z", items: [{ name: "Ring", quantity: 2, size: "7" }, { name: "" }, null, "x"] })).toEqual({
+      id: "r1",
+      createdAt: "2026-11-03T14:10:00Z",
+      items: [{ name: "Ring", quantity: 2, size: "7" }],
+    });
+    expect(checkoutOf({ id: "r2", created_at: "not a date", items: [] })).toBeNull();
+    expect(checkoutOf(null)).toBeNull();
+    expect(checkoutOf({ id: "r3", created_at: "2026-11-03T14:10:00Z", items: "nope" })).toEqual({ id: "r3", createdAt: "2026-11-03T14:10:00Z", items: [] });
+  });
+});
diff --git a/src/lib/portal/care.ts b/src/lib/portal/care.ts
new file mode 100644
index 0000000..0763a06
--- /dev/null
+++ b/src/lib/portal/care.ts
@@ -0,0 +1,88 @@
+import type { JewelPiece } from "@/data/jewellery";
+
+/*
+  Care, only in the listings' own words. Each piece's care line is its
+  listing's Care section (the shop's description, as the product page reads
+  it), its finish is its Plating line, and the "PVD vs plating" explainer is
+  the line the PVD listings carry in their details. Nothing here adds a care
+  claim of its own, offers a service the shop has not confirmed, or says a
+  piece was bought: pieces from a checkout are "from a checkout you started".
+
+  The wipe ritual's three steps are phrases the listings' care lines share.
+  It is drawn only when the most common care line (the shop's own, read
+  from the catalogue) still says all three, so a change to the listings
+  takes the ritual away rather than leave it saying something they no longer do.
+*/
+
+const detail = (piece: JewelPiece, label: RegExp): string | null => {
+  const line = (piece.details ?? []).find((d) => label.test(d));
+  return line ? line.replace(label, "").trim() || null : null;
+};
+
+/** The listing's own care line ("Waterproof and tarnish free, so…"), or null when it has none. */
+export const careLineOf = (piece: JewelPiece): string | null => piece.care?.trim() || null;
+
+/** Its Plating line ("PVD 18K gold coating, anti-tarnish"). */
+export const platingOf = (piece: JewelPiece): string | null => detail(piece, /^Plating:\s*/i);
+
+/** The "PVD vs plating" explainer, as the piece's own details give it. */
+export const pvdLineOf = (piece: JewelPiece): string | null => detail(piece, /^PVD vs plating:\s*/i);
+
+const mostCommon = (values: (string | null)[]): string | null => {
+  const counts = new Map<string, number>();
+  for (const v of values) if (v) counts.set(v, (counts.get(v) ?? 0) + 1);
+  let best: string | null = null;
+  let most = 0;
+  for (const [v, n] of counts) if (n > most) [best, most] = [v, n];
+  return best;
+};
+
+/** The care line most listings carry. */
+export const houseCareLine = (catalogue: readonly JewelPiece[]): string | null => mostCommon(catalogue.map(careLineOf));
+
+/** The explainer the PVD listings carry. */
+export const pvdExplainer = (catalogue: readonly JewelPiece[]): string | null => mostCommon(catalogue.map(pvdLineOf));
+
+export type RitualStep = { words: string; match: RegExp };
+
+/* Each step's words are the care line's own; `match` finds them in it. */
+export const RITUAL: readonly RitualStep[] = [
+  { words: "Keep it away from perfume and harsh chemicals.", match: /away from perfume and harsh chemicals/i },
+  { words: "Wipe with a soft dry cloth.", match: /wipe (it )?with a soft dry cloth/i },
+  { words: "Store it flat in its pouch.", match: /store (it|them) flat in (its|their) pouch/i },
+];
+
+/** The ritual, when the shop's own care line still says each of its steps; null otherwise. */
+export const ritualFor = (careLine: string | null): readonly RitualStep[] | null =>
+  careLine && RITUAL.every((s) => s.match.test(careLine)) ? RITUAL : null;
+
+const nameKey = (name: string) => name.trim().toLowerCase().replace(/\s+/g, " ");
+
+export type CarePiece = { piece: JewelPiece; from: "saved" | "checkout" };
+
+/**
+ * Her pieces for care cards: the ones she saved (her account's handles), then
+ * those named in the checkouts she started (matched to the listing by its
+ * name, since a checkout row keeps names, not handles), each once.
+ */
+export const piecesForCare = (catalogue: readonly JewelPiece[], saved: readonly string[], checkoutNames: readonly string[]): CarePiece[] => {
+  const byHandle = new Map(catalogue.map((p) => [p.handle, p]));
+  const byName = new Map(catalogue.map((p) => [nameKey(p.name), p]));
+  const out: CarePiece[] = [];
+  const seen = new Set<string>();
+  for (const h of saved) {
+    const piece = byHandle.get(h);
+    if (piece && !seen.has(piece.handle)) {
+      seen.add(piece.handle);
+      out.push({ piece, from: "saved" });
+    }
+  }
+  for (const n of checkoutNames) {
+    const piece = byName.get(nameKey(n));
+    if (piece && !seen.has(piece.handle)) {
+      seen.add(piece.handle);
+      out.push({ piece, from: "checkout" });
+    }
+  }
+  return out;
+};
diff --git a/src/lib/portal/checkouts.ts b/src/lib/portal/checkouts.ts
new file mode 100644
index 0000000..06a0be7
--- /dev/null
+++ b/src/lib/portal/checkouts.ts
@@ -0,0 +1,50 @@
+import { getSupabase } from "@/integrations/supabase/lazy";
+
+/*
+  The checkouts she started while signed in: her own member_orders rows,
+  read (never written) under their existing row security, as Account reads
+  them. The bag writes a row each time it hands her to checkout, before any
+  payment, so a row is a checkout she started, never an order: it may have
+  been paid, or left. Until the shop's order webhook confirms them (Phase 5)
+  they are only ever called "Checkouts you started".
+*/
+
+export type CheckoutItem = { name: string; quantity: number; size: string | null };
+export type Checkout = { id: string; createdAt: string; items: CheckoutItem[] };
+
+export const CHECKOUTS_SHOWN = 12;
+
+const text = (x: unknown, max: number): string => (typeof x === "string" ? x.trim().slice(0, max) : "");
+
+/** One row as the rooms show it: the day it was started and the names of its pieces (anything malformed left out). */
+export const checkoutOf = (row: unknown): Checkout | null => {
+  if (!row || typeof row !== "object") return null;
+  const r = row as Record<string, unknown>;
+  const id = text(r.id, 64);
+  const createdAt = text(r.created_at, 40);
+  if (!id || Number.isNaN(Date.parse(createdAt))) return null;
+  const items = (Array.isArray(r.items) ? r.items : [])
+    .map((i): CheckoutItem | null => {
+      if (!i || typeof i !== "object") return null;
+      const it = i as Record<string, unknown>;
+      const name = text(it.name, 120);
+      if (!name) return null;
+      const q = Number(it.quantity);
+      return { name, quantity: Number.isInteger(q) && q > 0 ? q : 1, size: text(it.size, 24) || null };
+    })
+    .filter((i): i is CheckoutItem => i !== null);
+  return { id, createdAt, items };
+};
+
+/** Her own rows, newest first (row security limits the read to her; the filter says so too). */
+export const readCheckouts = async (userId: string): Promise<Checkout[]> => {
+  const supabase = await getSupabase();
+  const { data, error } = await supabase
+    .from("member_orders")
+    .select("id, created_at, items")
+    .eq("user_id", userId)
+    .order("created_at", { ascending: false })
+    .limit(CHECKOUTS_SHOWN);
+  if (error) throw error;
+  return (data ?? []).map(checkoutOf).filter((c): c is Checkout => c !== null);
+};
diff --git a/src/lib/portal/clock.test.ts b/src/lib/portal/clock.test.ts
new file mode 100644
index 0000000..5779fbd
--- /dev/null
+++ b/src/lib/portal/clock.test.ts
@@ -0,0 +1,75 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { measureServerOffset, nextTickAt, offsetFrom, resetServerClock, serverNow } from "./clock";
+
+/* The drop clock keeps the server's time: a phone set five minutes fast
+   must not open the bud early. One HEAD request's Date header sets the
+   offset; anything odd falls back to the phone's own clock. */
+
+afterEach(() => {
+  resetServerClock();
+  vi.restoreAllMocks();
+});
+
+const headers = (h: Record<string, string>) => ({ headers: { get: (k: string) => h[k.toLowerCase()] ?? null } }) as unknown as Response;
+
+describe("offsetFrom", () => {
+  it("reads the Date header against the middle of the round trip", () => {
+    // Sent at 10:00:00.000, answered at 10:00:00.400 on the phone; the server said 10:05:00 (whole seconds).
+    const sent = Date.parse("2026-11-21T10:00:00.000Z");
+    const offset = offsetFrom({ sent, received: sent + 400, date: "Sat, 21 Nov 2026 10:05:00 GMT" });
+    // 10:05:00.500 (the half second the header drops) minus 10:00:00.200.
+    expect(offset).toBe(5 * 60_000 + 300);
+  });
+
+  it("adds the Age a cache held the answer for", () => {
+    const sent = Date.parse("2026-11-21T10:00:00.000Z");
+    expect(offsetFrom({ sent, received: sent, date: "Sat, 21 Nov 2026 09:59:00 GMT", age: "60" })).toBe(500);
+  });
+
+  it("falls back on a missing, unreadable or absurd header", () => {
+    const sent = Date.now();
+    expect(offsetFrom({ sent, received: sent + 10, date: null })).toBeNull();
+    expect(offsetFrom({ sent, received: sent + 10, date: "yesterday-ish" })).toBeNull();
+    expect(offsetFrom({ sent, received: sent + 10, date: "Mon, 01 Jan 2024 00:00:00 GMT" })).toBeNull();
+    expect(offsetFrom({ sent, received: sent - 10, date: new Date(sent).toUTCString() })).toBeNull();
+  });
+});
+
+describe("measureServerOffset", () => {
+  it("asks the same origin once, with HEAD and no cache, and keeps the answer", async () => {
+    let t = Date.parse("2026-11-21T10:00:00.000Z");
+    const now = () => t;
+    const doFetch = vi.fn(async (_url: string, _init?: RequestInit) => {
+      t += 200;
+      return headers({ date: "Sat, 21 Nov 2026 10:02:00 GMT" });
+    });
+    const offset = await measureServerOffset(doFetch, now);
+    expect(offset).toBe(2 * 60_000 + 400);
+    expect(doFetch).toHaveBeenCalledTimes(1);
+    const [url, init] = doFetch.mock.calls[0];
+    expect(url.startsWith(`${window.location.origin}/`)).toBe(true);
+    expect(init).toMatchObject({ method: "HEAD", cache: "no-store", credentials: "same-origin" });
+    await measureServerOffset(doFetch, now);
+    expect(doFetch).toHaveBeenCalledTimes(1);
+    vi.spyOn(Date, "now").mockReturnValue(1_000_000);
+    expect(serverNow()).toBe(1_000_000 + offset);
+  });
+
+  it("uses the phone's clock when the request fails", async () => {
+    const offset = await measureServerOffset(async () => {
+      throw new Error("offline");
+    });
+    expect(offset).toBe(0);
+    vi.spyOn(Date, "now").mockReturnValue(42);
+    expect(serverNow()).toBe(42);
+  });
+});
+
+describe("the minute tick", () => {
+  it("is due at the next minute boundary, or a sooner mark", () => {
+    const t = Date.parse("2026-11-21T10:00:30.000Z");
+    expect(nextTickAt(t)).toBe(Date.parse("2026-11-21T10:01:00.000Z"));
+    expect(nextTickAt(t, [t + 5_000, t - 5_000])).toBe(t + 5_000);
+    expect(nextTickAt(t, [t + 120_000])).toBe(Date.parse("2026-11-21T10:01:00.000Z"));
+  });
+});
diff --git a/src/lib/portal/clock.ts b/src/lib/portal/clock.ts
new file mode 100644
index 0000000..15a36f5
--- /dev/null
+++ b/src/lib/portal/clock.ts
@@ -0,0 +1,131 @@
+import { useEffect, useState } from "react";
+import { MINUTE } from "./dropPhase";
+
+/*
+  The drop clock keeps the server's time, not the phone's. A phone set five
+  minutes fast would otherwise open the bud before the shop does, and one set
+  a day wrong would count to the wrong day. One same-origin HEAD request per
+  visit reads the host's Date header (plus Age, when a cache answered) and
+  sets it against the middle of the round trip; the difference is the offset
+  every countdown adds to Date.now(). No answer, no header, or a nonsense one
+  (more than a week out) means the phone's own clock, which is right for
+  nearly everyone.
+
+  The minute tick that drives the countdown is one timer, set for the next
+  minute boundary (or the next phase change, if sooner), and re-read when the
+  tab comes back: no animation loop, nothing running between minutes.
+*/
+
+const MAX_OFFSET_MS = 7 * 24 * 60 * MINUTE;
+const PROBE_TIMEOUT_MS = 4000;
+
+export type Probe = {
+  /** Device time the request went out and the answer came back. */
+  sent: number;
+  received: number;
+  /** The answer's Date header (an HTTP date, whole seconds). */
+  date: string | null;
+  /** The answer's Age header (seconds a cache held it), if any. */
+  age?: string | null;
+};
+
+/** The server's clock minus the device's, in ms, or null when the answer cannot tell. */
+export const offsetFrom = ({ sent, received, date, age }: Probe): number | null => {
+  if (!date || !(received >= sent)) return null;
+  const stamped = Date.parse(date);
+  if (Number.isNaN(stamped)) return null;
+  const held = Number(age);
+  // The header drops the milliseconds: on average the true time is half a second on.
+  const server = stamped + 500 + (Number.isFinite(held) && held > 0 ? held * 1000 : 0);
+  const offset = server - (sent + (received - sent) / 2);
+  return Math.abs(offset) > MAX_OFFSET_MS ? null : Math.round(offset);
+};
+
+let offsetMs = 0;
+let measuring: Promise<number> | null = null;
+
+type Fetcher = (input: string, init?: RequestInit) => Promise<Response>;
+
+/** Reads the offset once per page visit; resolves to 0 (the device's clock) on any failure. */
+export const measureServerOffset = (doFetch: Fetcher = (input, init) => fetch(input, init), now: () => number = Date.now): Promise<number> => {
+  if (measuring) return measuring;
+  measuring = (async () => {
+    try {
+      const controller = typeof AbortController === "function" ? new AbortController() : null;
+      const timer = window.setTimeout(() => controller?.abort(), PROBE_TIMEOUT_MS);
+      const sent = now();
+      const res = await doFetch(`${window.location.origin}/favicon.ico?clock=${sent}`, {
+        method: "HEAD",
+        cache: "no-store",
+        credentials: "same-origin",
+        signal: controller?.signal,
+      });
+      const received = now();
+      window.clearTimeout(timer);
+      offsetMs = offsetFrom({ sent, received, date: res.headers.get("date"), age: res.headers.get("age") }) ?? 0;
+    } catch {
+      offsetMs = 0;
+    }
+    return offsetMs;
+  })();
+  return measuring;
+};
+
+/** The server's time now (the device's, until the offset is known). */
+export const serverNow = (): number => Date.now() + offsetMs;
+
+/** Sets the offset as if measured: for tests, and for a page that already knows it. */
+export const primeServerClock = (offset = 0): void => {
+  offsetMs = offset;
+  measuring = Promise.resolve(offset);
+};
+
+/** Forgets the measurement (tests). */
+export const resetServerClock = (): void => {
+  offsetMs = 0;
+  measuring = null;
+};
+
+/** When the next tick is due: the next minute boundary, or the next boundary in `marks`, whichever is first. */
+export const nextTickAt = (now: number, marks: readonly number[] = []): number => {
+  const minute = Math.floor(now / MINUTE) * MINUTE + MINUTE;
+  return marks.reduce((at, m) => (m > now && m < at ? m : at), minute);
+};
+
+/**
+ * The server's time, re-read on every minute boundary and at each of
+ * `marks` (a drop's opening, its petal thresholds), and when the tab is shown
+ * again. `enabled` false leaves the clock alone (nothing to count to).
+ */
+export const useServerNow = (marks: readonly number[] = [], enabled = true): number => {
+  const [now, setNow] = useState(serverNow);
+  const key = marks.join(",");
+
+  useEffect(() => {
+    if (!enabled) return;
+    let timer = 0;
+    let live = true;
+    const list = key ? key.split(",").map(Number) : [];
+    const tick = () => {
+      window.clearTimeout(timer);
+      if (!live) return;
+      const t = serverNow();
+      setNow(t);
+      // A few ms past the boundary, so the next read lands on the new minute.
+      timer = window.setTimeout(tick, Math.max(20, nextTickAt(t, list) - t + 15));
+    };
+    tick();
+    measureServerOffset().then(() => live && tick());
+    const onVisible = () => {
+      if (document.visibilityState !== "hidden") tick();
+    };
+    document.addEventListener("visibilitychange", onVisible);
+    return () => {
+      live = false;
+      window.clearTimeout(timer);
+      document.removeEventListener("visibilitychange", onVisible);
+    };
+  }, [key, enabled]);
+
+  return now;
+};
diff --git a/src/lib/portal/consentWriters.test.ts b/src/lib/portal/consentWriters.test.ts
new file mode 100644
index 0000000..9e18ac6
--- /dev/null
+++ b/src/lib/portal/consentWriters.test.ts
@@ -0,0 +1,91 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+import { carryOverPatch } from "@/lib/auth/signupChoices";
+
+/*
+  The arrival repair reads a profile row changed since it was made
+  (updated_at later than created_at) as her ad-matching answer given
+  (lib/portal/arrival consentAnswered), because a "no" saved on /account
+  leaves no other mark. That is exact only while every place the shop
+  writes her row also writes her answer. This holds it to that:
+
+  - /account's details form (the consent box is in the same form, so a save
+    is her answer, ticked or not), the sign-up upsert, the sign-up carry-over
+    and the arrival repair's own save each write ad_matching_consent;
+  - the one write that does not, the portal's birthday save, can never take
+    a question away: the arrival repair asks from her profile as it was when
+    her rooms opened (MembersRoute's arrivalProfile), and only on her first
+    visit.
+
+  A new writer of the profiles table fails here until it writes her answer
+  too, or is shown not to change what the arrival repair asks. A change made
+  outside the shop's code (an edit in the database itself) is still read as
+  answered: that is the one way left to err, and it errs on not asking.
+*/
+
+const src = resolve(__dirname, "../..");
+const files = (dir: string): string[] =>
+  readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
+    e.isDirectory() ? files(join(dir, e.name)) : /\.tsx?$/.test(e.name) && !/\.test\.tsx?$/.test(e.name) ? [join(dir, e.name)] : [],
+  );
+
+const WRITE = /\.from\(\s*["']profiles["']\s*\)\s*\.(upsert|update|insert)\s*\(/g;
+
+/** The argument text of the call whose "(" is at `open`. */
+const argumentOf = (text: string, open: number): string => {
+  let depth = 0;
+  for (let i = open; i < text.length; i++) {
+    if (text[i] === "(") depth++;
+    else if (text[i] === ")" && --depth === 0) return text.slice(open + 1, i);
+  }
+  return text.slice(open + 1);
+};
+
+const writers = files(src).flatMap((file) => {
+  const text = readFileSync(file, "utf8");
+  return [...text.matchAll(WRITE)].map((m) => ({
+    file: relative(src, file).split("\\").join("/"),
+    row: argumentOf(text, (m.index ?? 0) + m[0].length - 1),
+  }));
+});
+
+describe("every place the shop writes her profile row", () => {
+  it("is one of the five the arrival repair knows", () => {
+    expect(writers.map((w) => w.file).sort()).toEqual([
+      "lib/auth/signupChoices.ts",
+      "lib/portal/arrival.ts",
+      "pages/Account.tsx",
+      "pages/Auth.tsx",
+      "pages/members/MembersRoute.tsx",
+    ]);
+  });
+
+  it("writes her ad-matching answer with it, but for the portal's birthday save", () => {
+    for (const { file, row } of writers) {
+      if (file === "pages/members/MembersRoute.tsx") {
+        expect(row).toMatch(/^\s*\{\s*id:\s*user\.id,\s*birthday\s*\}/);
+        continue;
+      }
+      if (file === "lib/auth/signupChoices.ts") {
+        // Her sign-up answer, carried over: the patch always holds it.
+        expect(row).toMatch(/\.\.\.patch/);
+        continue;
+      }
+      expect(row, file).toMatch(/ad_matching_consent:/);
+    }
+  });
+
+  it("carries her sign-up answer over only with the answer itself", () => {
+    const patch = carryOverPatch({ ad_matching_consent: true, full_name: "Ananya" }, { full_name: null, ad_matching_consent: false, created_at: "t", updated_at: "t" });
+    expect(patch).toMatchObject({ ad_matching_consent: true });
+    expect(patch?.ad_matching_consent_at).toEqual(expect.any(String));
+  });
+
+  it("asks the arrival questions from her profile as her rooms opened, so a birthday saved this visit takes none away", () => {
+    const route = readFileSync(join(src, "pages/members/MembersRoute.tsx"), "utf8");
+    const garden = readFileSync(join(src, "pages/members/GardenHome.tsx"), "utf8");
+    expect(route).toMatch(/const arrivalProfile = opened && opened\.u === memberId \? opened\.profile : profile;/);
+    expect(garden).toMatch(/firstVisit && !doors && <ArrivalRepair user=\{user\} profile=\{arrivalProfile\}/);
+  });
+});
diff --git a/src/lib/portal/copy.test.ts b/src/lib/portal/copy.test.ts
new file mode 100644
index 0000000..f2fbbd8
--- /dev/null
+++ b/src/lib/portal/copy.test.ts
@@ -0,0 +1,225 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync, readdirSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+
+/*
+  The portal's honesty rules, enforced on its sources. No invented social
+  proof or scarcity (the product page's "N pieces sold" is exactly what this
+  keeps out), no members' prices, codes or gifts the shop has not created,
+  exclusivity worded as a first look, and stones described as the listing
+  does: cubic zirconia in the month's colour, never real gemstones or solid
+  gold.
+*/
+const src = resolve(__dirname, "../..");
+const dirs = ["pages/members", "components/portal", "lib/portal", "lib/auth"];
+const files = (dir: string): string[] =>
+  readdirSync(dir, { withFileTypes: true }).flatMap((e) =>
+    e.isDirectory() ? files(join(dir, e.name)) : /\.(tsx?|css)$/.test(e.name) && !/\.test\./.test(e.name) ? [join(dir, e.name)] : [],
+  );
+const sources = dirs.flatMap((d) => files(join(src, d)));
+
+/* A rule may name the only quotations it allows: the shop's own words for something real, quoted (the
+   confirmation email's "View your order" button is sent only for a placed order). */
+const BANNED: [string, RegExp, RegExp[]?][] = [
+  ["the plan's banned phrases", /members-only pric|only \d+ left|\d+ (members|watching)|spots left|sold in the last|selling fast/i],
+  ["exclusivity beyond a first look", /exclusive to members|members only can buy|only members can buy/i],
+  ["a price or reward that does not exist", /\d+\s*%\s*off|discount code|members'? price|birthday gift|free gift|reward points|referral/i],
+  ["scarcity nobody confirmed", /\b(small batch|limited edition|gone for good|almost gone|hurry)\b/i],
+  ["stones or metal beyond the listing's words", /\b(real|genuine|natural|precious) (garnet|amethyst|aquamarine|emerald|ruby|peridot|sapphire|topaz|zircon|gemstone|stone)s?\b|solid gold/i],
+  /* The drops (Phase 2): a first look, never a secret or a members-only shop;
+     no hurry, no stock counts, no penalty for a drop she let pass; pressed
