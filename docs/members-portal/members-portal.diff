+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const db = vi.hoisted(() => ({
+  rows: [] as unknown[],
+  selectError: null as unknown,
+  upsertError: null as unknown,
+  calls: [] as unknown[][],
+}));
+vi.mock("@/integrations/supabase/lazy", () => ({
+  getSupabase: async () => ({
+    from: (table: string) => ({
+      select: (cols: string) => ({
+        eq: (col: string, value: string) => ({
+          limit: async (n: number) => {
+            db.calls.push(["select", table, cols, col, value, n]);
+            return { data: db.selectError ? null : db.rows, error: db.selectError };
+          },
+        }),
+      }),
+      upsert: async (row: unknown) => {
+        db.calls.push(["upsert", table, row]);
+        return { error: db.upsertError };
+      },
+    }),
+  }),
+}));
+
+import {
+  ARRIVAL_JOIN_TELLS_META,
+  ARRIVAL_SOURCE,
+  arrivalNeeds,
+  changedSinceMade,
+  consentAnswered,
+  liveArrivalActions,
+  markOffered,
+  previewArrivalActions,
+  wasOffered,
+} from "./arrival";
+import { PORTAL_KEY, readPortal, writePortal } from "./safeStorage";
+
+const ANANYA = { id: "u-ananya", email: "ananya.r@example.com", user_metadata: {} };
+const MEERA = { id: "u-meera", email: "meera@example.com", user_metadata: {} };
+const untouched = { ad_matching_consent: false, ad_matching_consent_at: null };
+
+beforeEach(() => {
+  window.localStorage.clear();
+  db.rows = [];
+  db.selectError = null;
+  db.upsertError = null;
+  db.calls = [];
+});
+
+describe("consentAnswered", () => {
+  it("reads a yes, a dated answer, or the answer she gave when registering", () => {
+    expect(consentAnswered(ANANYA, { ad_matching_consent: true })).toBe(true);
+    expect(consentAnswered(ANANYA, { ad_matching_consent: false, ad_matching_consent_at: "2026-11-01T00:00:00Z" })).toBe(true);
+    expect(consentAnswered({ ...ANANYA, user_metadata: { ad_matching_consent: false } }, untouched)).toBe(true);
+    expect(consentAnswered({ ...ANANYA, user_metadata: { ad_matching_consent: true } }, untouched)).toBe(true);
+  });
+
+  it("finds a Google sign-up, or one whose answer was lost at confirmation, never asked", () => {
+    expect(consentAnswered(ANANYA, untouched)).toBe(false);
+    expect(consentAnswered({ ...ANANYA, user_metadata: { full_name: "Ananya", avatar_url: "x" } }, untouched)).toBe(false);
+    // A row exactly as the sign-up trigger made it: never changed since.
+    const made = "2026-11-01T04:00:00.123456+00:00";
+    expect(consentAnswered(ANANYA, { ...untouched, created_at: made, updated_at: made })).toBe(false);
+  });
+
+  it("counts a no saved on /account (no consent date, but her row changed since it was made) as answered", () => {
+    const saidNo = { ad_matching_consent: false, ad_matching_consent_at: null, created_at: "2026-11-01T04:00:00+00:00", updated_at: "2026-11-03T09:30:00+00:00" };
+    expect(changedSinceMade(saidNo)).toBe(true);
+    expect(consentAnswered(ANANYA, saidNo)).toBe(true);
+    // Unreadable dates prove nothing.
+    expect(changedSinceMade({ ...saidNo, updated_at: "soon" })).toBe(false);
+    expect(changedSinceMade(null)).toBe(false);
+  });
+});
+
+describe("what this device has offered", () => {
+  it("remembers each need per member, beside the portal's other device flags", () => {
+    writePortal({ seedSeen: true });
+    expect(wasOffered(ANANYA.id, "join")).toBe(false);
+    markOffered(ANANYA.id, ["join"]);
+    expect(wasOffered(ANANYA.id, "join")).toBe(true);
+    expect(wasOffered(ANANYA.id, "consent")).toBe(false);
+    expect(wasOffered(MEERA.id, "join")).toBe(false);
+    markOffered(ANANYA.id, ["consent"]);
+    expect(wasOffered(ANANYA.id, "join")).toBe(true);
+    expect(readPortal().seedSeen).toBe(true);
+  });
+
+  it("reads a broken store as nothing offered", () => {
+    window.localStorage.setItem(PORTAL_KEY, JSON.stringify({ arrival: ["nonsense"] }));
+    expect(wasOffered(ANANYA.id, "join")).toBe(false);
+    window.localStorage.setItem(PORTAL_KEY, "{not json");
+    expect(wasOffered(ANANYA.id, "consent")).toBe(false);
+  });
+});
+
+describe("arrivalNeeds", () => {
+  const actions = liveArrivalActions(vi.fn(), async () => {});
+
+  it("offers the list when she has no row of her own, asking with her own account id", async () => {
+    expect(await arrivalNeeds(ANANYA, untouched, actions.hasOwnSignup)).toEqual({ join: true, consent: true });
+    expect(db.calls[0]).toEqual(["select", "inner_circle_signups", "id", "user_id", ANANYA.id, 1]);
+  });
+
+  it("offers nothing she already has", async () => {
+    db.rows = [{ id: "row-1" }];
+    expect(await arrivalNeeds(ANANYA, { ad_matching_consent: true }, actions.hasOwnSignup)).toEqual({ join: false, consent: false });
+  });
+
+  it("offers each need at most once for her on this device", async () => {
+    markOffered(ANANYA.id, ["join", "consent"]);
+    expect(await arrivalNeeds(ANANYA, untouched, actions.hasOwnSignup)).toEqual({ join: false, consent: false });
+    expect(db.calls).toEqual([]);
+    expect(await arrivalNeeds(MEERA, untouched, actions.hasOwnSignup)).toEqual({ join: true, consent: true });
+  });
+
+  it("offers nothing it is unsure of: no list check, no profile read, no email", async () => {
+    db.selectError = { message: "Failed to fetch" };
+    expect((await arrivalNeeds(ANANYA, untouched, actions.hasOwnSignup)).join).toBe(false);
+    expect((await arrivalNeeds(ANANYA, null, actions.hasOwnSignup)).consent).toBe(false);
+    db.selectError = null;
+    expect((await arrivalNeeds({ ...ANANYA, email: null }, untouched, actions.hasOwnSignup)).join).toBe(false);
+  });
+});
+
+describe("the writes", () => {
+  it("joins the list through the join it is handed, with the arrival source", async () => {
+    const join = vi.fn(async () => ({ ok: true as const, already: true }));
+    const actions = liveArrivalActions(join, async () => {});
+    expect(await actions.join({ email: ANANYA.email, userId: ANANYA.id })).toEqual({ ok: true, already: true });
+    expect(join).toHaveBeenCalledWith({ email: ANANYA.email, name: undefined, source: "members-arrival", userId: ANANYA.id });
+    expect(ARRIVAL_SOURCE.length).toBeLessThanOrEqual(40);
+    // Lead and Subscribe stay unsent from the portal until the owner approves them (MembersRoute hands in the quiet join).
+    expect(ARRIVAL_JOIN_TELLS_META).toBe(false);
+  });
+
+  it("writes her answer to her own profile row as /account does, then refreshes it", async () => {
+    const refresh = vi.fn(async () => {});
+    const actions = liveArrivalActions(vi.fn(), refresh);
+    expect(await actions.saveConsent(ANANYA.id, true)).toEqual({ ok: true });
+    const [, table, row] = db.calls[0] as [string, string, Record<string, unknown>];
+    expect(table).toBe("profiles");
+    expect(row).toMatchObject({ id: ANANYA.id, ad_matching_consent: true });
+    expect(Date.parse(row.ad_matching_consent_at as string)).not.toBeNaN();
+    expect(Date.parse(row.updated_at as string)).not.toBeNaN();
+    expect(refresh).toHaveBeenCalled();
+    // A no: no consent date, and updated_at, so it counts as answered.
+    expect(await actions.saveConsent(ANANYA.id, false)).toEqual({ ok: true });
+    const [, , no] = db.calls[1] as [string, string, Record<string, unknown>];
+    expect(no).toMatchObject({ id: ANANYA.id, ad_matching_consent: false, ad_matching_consent_at: null });
+    expect(Date.parse(no.updated_at as string)).not.toBeNaN();
