+type Fake = { onfinish: null | (() => void); oncancel: null | (() => void); playState: string; currentTime: number; finished: Promise<void>; cancel: () => void; play: () => void; pause: () => void };
+const animate = function (this: Element, _k: Keyframe[], o?: number | KeyframeAnimationOptions): Animation {
