+    expect(checkGift({ n: "Isha", m: 5, d: 1, b: 2000 })).toMatchObject({ ok: false, field: "b" });
+    expect(checkGift({ n: "Isha", m: 5, d: 1, b: null })).toMatchObject({ ok: false, field: "b" });
+    expect(bandLabel(1000)).toBe("Under ₹1,000");
