+++ b/src/lib/portal/scene.test.ts
@@ -0,0 +1,326 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+/* The Bloom Field's scene with three.js's renderer and light probe stood in
+   (jsdom has no WebGL; the geometry, the material and the InstancedMesh are
+   three.js's own): one InstancedMesh of 60 to 200 flowers, the device pixels
+   capped at 2, no shadow maps, a fall that ends by 6 s, the probe putting a
+   slow phone back on Tier 1, one portal scene at a time, and a dispose that
+   frees everything and gives the context back. */
+
+const gl = vi.hoisted(() => ({
+  renderers: [] as {
+    pixelRatio: number;
+    shadowMap: { enabled: boolean };
+    renders: number;
+    disposed: number;
+    lost: number;
+  }[],
+  pmrem: { disposed: 0, env: 0 },
+}));
+
+vi.mock("three", async (importOriginal) => {
+  const actual = await importOriginal<Record<string, unknown>>();
+  class WebGLRenderer {
+    shadowMap = { enabled: false };
+    toneMapping = 0;
+    toneMappingExposure = 1;
+    pixelRatio = 1;
+    renders = 0;
+    disposed = 0;
+    lost = 0;
+    constructor() {
+      gl.renderers.push(this);
+    }
+    setPixelRatio(r: number) {
+      this.pixelRatio = r;
+    }
+    setClearColor() {}
+    setSize() {}
+    render() {
+      this.renders += 1;
+    }
+    compileAsync() {
+      return Promise.resolve();
+    }
+    dispose() {
+      this.disposed += 1;
+    }
+    forceContextLoss() {
+      this.lost += 1;
+    }
+  }
+  class PMREMGenerator {
+    fromScene() {
+      // A render target: freeing it (not only its texture) frees its framebuffer too.
+      return { texture: { isTexture: true, dispose: () => undefined }, dispose: () => (gl.pmrem.env += 1) };
+    }
+    dispose() {
+      gl.pmrem.disposed += 1;
+    }
+  }
+  return { ...actual, WebGLRenderer, PMREMGenerator };
+});
+
+const THREE = await import("three");
+const { BANK, FALL_MS, MAX_FLOWERS, MIN_FLOWERS, ROCK, SETTING_GOLD, fallPlan, flowerCount, liveScenes, mountBloomField, pose, simplifyOutline } = await import("./scene");
+const { FLOWER_SHAPES } = await import("@/lib/nairaFlower/outline");
+
+/* A frame clock: each step runs the waiting callbacks `ms` after the last. */
+let now = 0;
+let queue: Map<number, FrameRequestCallback> = new Map();
+let nextId = 1;
+const step = (ms: number, frames = 1) => {
+  for (let i = 0; i < frames; i++) {
+    now += ms;
+    const run = queue;
+    queue = new Map();
+    run.forEach((cb) => cb(now));
+  }
+};
+const settle = async () => {
+  for (let i = 0; i < 5; i++) await Promise.resolve();
+};
+
+beforeEach(() => {
+  gl.renderers.length = 0;
+  gl.pmrem.disposed = gl.pmrem.env = 0;
+  now = 1000;
+  queue = new Map();
+  vi.stubGlobal("requestAnimationFrame", (cb: FrameRequestCallback) => {
+    const id = nextId++;
+    queue.set(id, cb);
+    return id;
+  });
+  vi.stubGlobal("cancelAnimationFrame", (id: number) => queue.delete(id));
+  Object.defineProperty(window, "devicePixelRatio", { configurable: true, value: 3 });
+  Object.defineProperty(window, "innerWidth", { configurable: true, value: 390 });
+  Object.defineProperty(window, "innerHeight", { configurable: true, value: 844 });
+});
+const mounted: { dispose: () => void }[] = [];
+afterEach(() => {
+  mounted.splice(0).forEach((h) => h.dispose());
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+});
+
+const mount = (extra: Partial<Parameters<typeof mountBloomField>[1]> = {}) => {
+  const onEnd = vi.fn();
+  const onStart = vi.fn();
+  const onReady = vi.fn();
+  const canvas = document.createElement("canvas");
+  const add = vi.spyOn(THREE.Scene.prototype, "add");
+  const handle = mountBloomField(canvas, { colours: ["#2F6B4F", "#9DB8A6"], seed: "verdant", onEnd, onStart, onReady, ...extra });
+  // Its flowers (RoomEnvironment's own boxes are an InstancedMesh too).
+  const mesh = add.mock.calls.map((c) => c[0]).find((o) => (o as { isInstancedMesh?: boolean }).isInstancedMesh && (o as { geometry?: unknown }).geometry instanceof THREE.ExtrudeGeometry) as InstanceType<typeof THREE.InstancedMesh>;
+  add.mockRestore();
+  mounted.push(handle);
+  return { handle, onEnd, onStart, onReady, canvas, mesh, renderer: gl.renderers.at(-1)! };
+};
+
+describe("the Bloom Field's scene", () => {
+  it("is one InstancedMesh of 60 to 200 enamel flowers, at no more than 2 device pixels and without shadows", async () => {
+    const { handle, mesh, renderer } = mount();
+    expect(mesh).toBeInstanceOf(THREE.InstancedMesh);
+    expect(mesh.count).toBe(flowerCount(390, 844));
+    expect(mesh.count).toBeGreaterThanOrEqual(MIN_FLOWERS);
+    expect(mesh.count).toBeLessThanOrEqual(MAX_FLOWERS);
+    // Enamel faces in the drop's colour and a gold setting: two materials, two draws (not one per shape and side).
+    const materials = mesh.material as InstanceType<typeof THREE.MeshStandardMaterial>[];
+    expect(materials).toHaveLength(2);
+    for (const m of materials) expect(m).toBeInstanceOf(THREE.MeshStandardMaterial);
+    expect(materials[1].metalness).toBe(1);
+    expect(`#${materials[1].color.getHexString()}`.toUpperCase()).toBe(SETTING_GOLD.toUpperCase());
+    expect(mesh.geometry.groups.map((g) => g.materialIndex)).toEqual([0, 1]);
+    expect(mesh.geometry.groups[0].start).toBe(0);
+    expect(mesh.geometry.groups[1].start + mesh.geometry.groups[1].count).toBe(mesh.geometry.attributes.position.count);
+    expect(mesh.geometry).toBeInstanceOf(THREE.ExtrudeGeometry);
+    expect(mesh.instanceColor).not.toBeNull();
+    expect(renderer.pixelRatio).toBe(2);
+    expect(renderer.shadowMap.enabled).toBe(false);
+    expect(liveScenes()).toBe(1);
+    handle.dispose();
+    await settle();
+  });
+
+  it("falls for 6 s, then ends, and its dispose frees everything and gives the context back", async () => {
+    const geometry = vi.spyOn(THREE.BufferGeometry.prototype, "dispose");
+    const material = vi.spyOn(THREE.Material.prototype, "dispose");
+    const instances = vi.spyOn(THREE.InstancedMesh.prototype, "dispose");
+    const { handle, onEnd, onStart, renderer } = mount({ probe: false });
+    await settle();
+    step(16.7);
+    expect(onStart).toHaveBeenCalledTimes(1);
+    step(16.7, 60 * 5);
+    expect(onEnd).not.toHaveBeenCalled();
+    step(16.7, 60 * 1.1);
+    expect(onEnd).toHaveBeenCalledTimes(1);
+    expect(onEnd).toHaveBeenCalledWith("done");
+    // Stopped: no more frames once it ended.
+    const drawn = renderer.renders;
+    step(16.7, 10);
+    expect(renderer.renders).toBe(drawn);
+    handle.dispose();
