+import { describe, expect, it } from "vitest";
+import type { Drop } from "./drops";
+import { pressInto, readNaira } from "./memberMeta";
+import { keepRing } from "./roomChanges";
+import { keepsakesFor } from "./keepsakes";
+
+/* The four keepsakes: each kept for something she did, said plainly; never
+   points, never a rank, never a count, never a word about what she missed. */
+
+const drop: Drop = {
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
+  accent: "#2F6B4F",
+  story: ["Green."],
+  membersFrom: "2026-11-21T20:00:00+05:30",
+  everyoneFrom: "2026-11-23T20:00:00+05:30",
+  handles: [],
+  leadHandle: "x",
+  teaser: { imageUrl: "", public: false },
+  reservable: [],
+};
+
+describe("keepsakes", () => {
+  it("a new member has her Seed, and the others say how they are kept", () => {
+    const ks = keepsakesFor({ joinedAt: "2026-11-04T05:00:00Z", month: null, naira: readNaira(null), drops: [] });
+    expect(ks.map((k) => [k.id, k.kept])).toEqual([
+      ["seed", true],
+      ["birth", false],
+      ["fitted", false],
+      ["front", false],
+    ]);
+    expect(ks[0].note).toBe("Planted 4 Nov 2026, the day you joined");
+    expect(ks[1]).toMatchObject({ note: "Kept when your birthday or month is saved", to: "/members/stone" });
+    expect(ks[2]).toMatchObject({ note: "Kept when your ring size is saved", to: "/members/fit" });
+    // With no drop set, Front Row says so rather than hurrying her.
+    expect(ks[3].note).toMatch(/The first drop is not set yet/);
+  });
+
+  it("keeps Birth Flower for a saved birthday, Fitted for a kept size, Front Row for a first-hour press", () => {
+    const naira = pressInto("verdant", true)(keepRing(6, "s", "2026-11-05")(readNaira(null)));
+    const ks = keepsakesFor({ joinedAt: "2026-11-04T05:00:00Z", month: 7, naira, drops: [drop] });
+    expect(ks.every((k) => k.kept)).toBe(true);
+    // July's flower (larkspur) is not one the garden draws: the frame does not name a flower it is not showing.
+    expect(ks[1].note).toBe("Your July flower, in your month's colour");
+    expect(ks[1].species).toBe(4);
+    const june = keepsakesFor({ joinedAt: null, month: 6, naira, drops: [drop] });
+    expect(june[1]).toMatchObject({ note: "Rose, for June", species: 0 });
+    expect(ks[2].note).toBe("US 6, measured on your screen, 5 Nov");
+    expect(ks[3].note).toBe("Verdant, opened in its first hour");
+  });
+
+  it("a pressed flower outside the first hour is not Front Row", () => {
+    const ks = keepsakesFor({ joinedAt: null, month: null, naira: pressInto("verdant", false)(readNaira(null)), drops: [drop] });
+    expect(ks[3]).toMatchObject({ kept: false, note: "Kept the first time you are there as a drop opens, and press its flower" });
+  });
+
+  it("never speaks of points, ranks, counts or missing out", () => {
+    const all = [
+      ...keepsakesFor({ joinedAt: null, month: null, naira: readNaira(null), drops: [] }),
+      ...keepsakesFor({ joinedAt: null, month: null, naira: readNaira(null), drops: [drop] }),
+    ];
+    for (const k of all) expect(`${k.name} ${k.note}`).not.toMatch(/point|redeem|rank|unlock|reward|missed|\d+ (of|members)|hurry|last chance/i);
+  });
+});
