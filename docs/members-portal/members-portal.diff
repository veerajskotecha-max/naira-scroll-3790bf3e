+import * as THREE from "three";
+import { RoomEnvironment } from "three/examples/jsm/environments/RoomEnvironment.js";
+import { BEVEL, BLUSH, DEPTH } from "@/lib/nairaFlower/config";
+import { FLOWER_SHAPES } from "@/lib/nairaFlower/outline";
+import { hashString, mulberry32 } from "./gardenLayout";
+import { claimGl, frameProbe, glInUse, releaseGl } from "./tier";
+
+/*
+  THE BLOOM FIELD (Tier 2): as a drop opens, a fall of the brand's own
+  flower, cast as enamel charms in the drop's colour, set in gold, over the
+  unboxing. One InstancedMesh of 60 to 200 flowers (by the screen's size),
+  each the header flower's five shapes extruded with its DEPTH and BEVEL;
+  its faces glazed in the drop's colour with the BLUSH roughness, its edge
+  and bevel in bright gold (two MeshStandardMaterials, two draws), lit by
+  RoomEnvironment and one key light, no shadow maps, the device pixels
+  capped at 2. Each flower flutters as it falls (rocking, banking into its
+  glide, turning in its own plane), so its face is always to her: never an
+  edge-on bar. Every flower is out of sight by 6 s and the scene stops; the
+  caller then puts it away (dispose), which frees the geometry, the
+  materials, the room's light and its render target, and the renderer, and
+  gives the WebGL context back at once.
+
+  Its cost is paid before the opening moves: mounting makes the renderer
+  and the room's light (one synchronous task), the shaders compile (off the
+  main thread where the browser can), and one unseen frame is drawn with
+  every flower hidden, so a browser that links its programs on first use
+  does so then, not mid-fall. Only then is it ready (onReady); the caller
+  holds the fall (pause) until the opening begins.
+
+  Reached only by import() (lib/portal/spectacle.ts), so three.js stays the
+  shared "three" chunk the header flower already brought, and a scene that
+  fails to arrive is harmless (lib/optionalChunk knows scene-*.js). At most
+  one portal scene lives at a time (tier.ts's claimGl, shared with the gem on
+  Your stone): with the header flower, never more than two WebGL contexts on
+  a /members screen.
+
+  The first 60 frames are the probe (lib/portal/tier): a phone that cannot
+  hold them ends the fall at once (onEnd("slow")) and keeps Tier 1.
+*/
+
+export const FALL_MS = 6000;
+export const MIN_FLOWERS = 60;
+export const MAX_FLOWERS = 200;
+export const DPR_CAP = 2;
+/* Every flower has landed (gone below the screen) by this time; the fall's 6 s leave a margin. */
+const LAST_SPAWN_S = 2.4;
+const LONGEST_FALL_S = 3.4;
+
+/** How many flowers fall on a screen this size: about one per 4,200 CSS px², 60 to 200. */
+export const flowerCount = (width: number, height: number): number =>
+  Math.max(MIN_FLOWERS, Math.min(MAX_FLOWERS, Math.round((Math.max(0, width) * Math.max(0, height)) / 4200)));
+
+/** A closed outline (flat x,y pairs) with the points it does not need dropped (Ramer–Douglas–Peucker). */
+export const simplifyOutline = (pts: readonly number[], tolerance: number): number[] => {
+  const n = pts.length / 2;
+  if (n < 4) return [...pts];
+  const keep = new Uint8Array(n);
+  keep[0] = keep[n - 1] = 1;
+  const stack: [number, number][] = [[0, n - 1]];
+  while (stack.length) {
+    const [a, b] = stack.pop()!;
+    const ax = pts[a * 2];
+    const ay = pts[a * 2 + 1];
+    const dx = pts[b * 2] - ax;
+    const dy = pts[b * 2 + 1] - ay;
+    const len = Math.hypot(dx, dy) || 1e-9;
+    let far = -1;
+    let at = -1;
+    for (let i = a + 1; i < b; i++) {
+      const d = Math.abs((pts[i * 2] - ax) * dy - (pts[i * 2 + 1] - ay) * dx) / len;
+      if (d > far) {
+        far = d;
+        at = i;
+      }
+    }
+    if (far > tolerance) {
+      keep[at] = 1;
+      stack.push([a, at], [at, b]);
+    }
+  }
+  const out: number[] = [];
+  for (let i = 0; i < n; i++) if (keep[i]) out.push(pts[i * 2], pts[i * 2 + 1]);
+  return out;
+};
+
+/* 0.3% of the flower's height: a seventh of a pixel on the largest that falls, and less than half the points. */
+const OUTLINE_TOLERANCE = 0.003;
+
+export type Fall = {
+  /** Across the screen, -1 to 1 of its half-width. */
+  x: number;
+  /** Depth, world units (nearer is larger and quicker). */
+  z: number;
+  /** When it starts to fall, and how long it takes to cross the screen, in s. */
+  delay: number;
+  time: number;
+  /** Height on screen at depth 0, CSS px. */
+  size: number;
+  sway: number;
+  swayHz: number;
+  phase: number;
+  /** Its turn in its own plane (rad/s), and where that turn starts. */
+  spin: number;
+  turn: number;
+  /** 0 the drop's colour, 1 its paler tint, 2 the brand flower's blush. */
+  tone: 0 | 1 | 2;
+};
+
+/** Each flower's fall, the same for a drop on every phone. All are out of sight by 5.8 s. */
+export const fallPlan = (count: number, seed: string): Fall[] => {
+  const rand = mulberry32(hashString(`bloom-field:${seed}`));
+  const n = Math.max(0, Math.min(MAX_FLOWERS, Math.floor(count)));
+  return Array.from({ length: n }, (_, i) => {
+    // An even rain across the width, jittered, so no gap opens down the middle.
+    const x = ((i + rand()) / n) * 2.1 - 1.05;
+    const r = rand();
+    return {
+      x,
+      z: -3 + rand() * 5,
+      // Front-loaded: most arrive while the box turns and opens.
+      delay: Math.pow(rand(), 1.35) * LAST_SPAWN_S,
+      time: 2.6 + rand() * (LONGEST_FALL_S - 2.6),
+      size: 22 + rand() * 24,
+      sway: 0.12 + rand() * 0.3,
+      swayHz: 0.45 + rand() * 0.6,
+      phase: rand() * Math.PI * 2,
+      spin: (rand() < 0.5 ? -1 : 1) * (0.6 + rand() * 1.0),
+      turn: rand() * Math.PI * 2,
+      tone: r < 0.125 ? 2 : r < 0.45 ? 1 : 0,
+    };
+  });
+};
+
+/** The most a flower rocks (about its x axis) and banks (about y), rad: its face never turns more than about 40° from her. */
+export const ROCK = 0.45;
+export const BANK = 0.55;
+
+/**
+ * A flower's flutter t seconds into the fall, as Euler angles (x, y, z):
+ * it rocks, banks into its sideways glide (the y tilt follows the sway's
+ * velocity) and turns in its own plane. Its face stays to her.
+ */
+export const pose = (f: Fall, t: number): [number, number, number] => {
+  const a = f.phase + t * f.swayHz * Math.PI * 2;
+  return [Math.sin(a * 0.75 + f.phase) * ROCK, Math.cos(a) * BANK, f.turn + f.spin * t];
+};
+
+export type FallEnd = "done" | "slow" | "lost";
+
+export type BloomFieldOptions = {
+  /** The drop's colour and its paler tint (the brand blush is added for one flower in eight). */
+  colours: [string, string];
+  /** The drop's id: the same fall for a drop on every phone. */
+  seed: string;
+  /** Time the first 60 frames and give up on a slow phone (always, but for the development preview's &probe=0). */
+  probe?: boolean;
+  /** The fall is over: every flower has gone ("done"), the phone was too slow ("slow"), or the context was lost. Called once. */
+  onEnd: (why: FallEnd) => void;
+  /** Its first frame is drawn. */
+  onStart?: () => void;
+  /** Prepared (shaders compiled, an unseen frame drawn): it will start at once when it is wanted. */
+  onReady?: () => void;
+};
+
+export type BloomFieldHandle = {
+  pause: () => void;
+  resume: () => void;
+  /** Stops it and frees everything, the WebGL context included. Safe to call more than once. */
+  dispose: () => void;
+};
+
+/** How many portal scenes hold a WebGL context now (never more than one: tier.ts's shared slot). */
+export const liveScenes = () => glInUse();
+
+const buildFlower = () => {
+  const shapes = FLOWER_SHAPES.map((outline) => {
+    const pts = simplifyOutline(outline, OUTLINE_TOLERANCE);
+    const s = new THREE.Shape();
+    s.moveTo(pts[0], pts[1]);
+    for (let i = 2; i < pts.length; i += 2) s.lineTo(pts[i], pts[i + 1]);
+    s.closePath();
+    return s;
+  });
+  const geometry = new THREE.ExtrudeGeometry(shapes, {
+    depth: DEPTH,
+    bevelEnabled: true,
+    bevelThickness: BEVEL,
+    bevelSize: BEVEL * 0.7,
+    // One chamfer catches the light as it turns; the header's three segments are for a flower sixty times the size.
+    bevelSegments: 1,
+    curveSegments: 1,
+  });
+  geometry.translate(0, 0, -DEPTH / 2);
+  geometry.computeVertexNormals();
+  return twoGroups(geometry);
+};
+
+/**
+ * ExtrudeGeometry gives each shape its own two groups (its faces, then its
+ * edge and bevel), ten draws for five shapes. Its triangles are reordered
+ * in place, every face first, then every edge, so the flower draws in two:
+ * the enamel, and the gold.
+ */
+export const twoGroups = <G extends THREE.BufferGeometry>(geometry: G): G => {
+  const order = [0, 1].flatMap((m) => geometry.groups.filter((g) => (g.materialIndex ?? 0) === m));
+  if (order.length < 3) return geometry;
+  for (const attr of Object.values(geometry.attributes) as THREE.BufferAttribute[]) {
+    const size = attr.itemSize;
+    const was = attr.array.slice();
+    let at = 0;
+    for (const g of order) {
+      (attr.array as Float32Array).set(was.subarray(g.start * size, (g.start + g.count) * size) as Float32Array, at);
+      at += g.count * size;
+    }
+    attr.needsUpdate = true;
+  }
+  const faces = order.filter((g) => (g.materialIndex ?? 0) === 0).reduce((n, g) => n + g.count, 0);
+  const all = order.reduce((n, g) => n + g.count, 0);
+  geometry.clearGroups();
+  geometry.addGroup(0, faces, 0);
+  geometry.addGroup(faces, all - faces, 1);
+  return geometry;
+};
+
+/** The setting's gold: the brand's gold, as bright metal. */
+export const SETTING_GOLD = "#C99A4C";
+
+const FOV = 30;
+const CAMERA_Z = 14;
+const TAN = Math.tan(THREE.MathUtils.degToRad(FOV / 2));
+
+export function mountBloomField(canvas: HTMLCanvasElement, options: BloomFieldOptions): BloomFieldHandle {
+  const slot = {};
+  if (!claimGl(slot)) throw new Error("A portal scene is already live.");
+  let renderer: THREE.WebGLRenderer;
+  try {
+    // Antialiased as the header flower is: on a phone's tiled GPU it costs next to nothing, and the petals' edges need it.
+    renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: "default" });
+  } catch (error) {
+    releaseGl(slot);
+    throw error;
+  }
+  let disposed = false;
+  const parts: { dispose: () => void }[] = [];
+  const release = () => {
+    if (disposed) return;
+    disposed = true;
+    releaseGl(slot);
+    for (const p of parts.reverse()) {
+      try {
+        p.dispose();
+      } catch {
+        /* freeing is best effort */
+      }
+    }
+    try {
+      renderer.dispose();
+    } catch {
+      /* the context below is given back regardless */
+    }
+    try {
+      // Give the context back now, not whenever the canvas is collected.
+      renderer.forceContextLoss();
+    } catch {
+      /* already lost */
+    }
+  };
+
+  try {
+    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, DPR_CAP));
+    renderer.setClearColor(0xffffff, 0);
+    renderer.shadowMap.enabled = false;
+    renderer.toneMapping = THREE.NeutralToneMapping;
+    renderer.toneMappingExposure = 0.95;
+
+    const scene = new THREE.Scene();
+    const pmrem = new THREE.PMREMGenerator(renderer);
+    parts.push(pmrem);
+    // The room's light: its boxes and their materials freed at once, its render target (not only its texture) with the rest.
+    const room = new RoomEnvironment();
+    const env = pmrem.fromScene(room, 0.04);
+    room.dispose();
+    parts.push(env);
+    scene.environment = env.texture;
+
+    const camera = new THREE.PerspectiveCamera(FOV, 1, 0.5, 40);
+    camera.position.set(0, 0, CAMERA_Z);
+    camera.lookAt(0, 0, 0);
+
+    const key = new THREE.DirectionalLight(0xfff4e6, 1.3);
+    key.position.set(3, 5, 6);
+    scene.add(key);
+
+    const width = () => canvas.clientWidth || window.innerWidth || 390;
+    const height = () => canvas.clientHeight || window.innerHeight || 844;
+    const plan = fallPlan(flowerCount(width(), height()), options.seed);
+
+    const geometry = buildFlower();
+    parts.push(geometry);
+    // The enamel takes each flower's colour; the gold keeps its own (the instance colour is left out of its shader).
+    const enamel = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: BLUSH.roughness, metalness: 0.08 });
+    const gold = new THREE.MeshStandardMaterial({ color: SETTING_GOLD, roughness: 0.34, metalness: 1 });
+    gold.onBeforeCompile = (shader) => {
+      shader.fragmentShader = shader.fragmentShader.replace("#include <color_fragment>", "");
+    };
+    parts.push(enamel, gold);
+    const mesh = new THREE.InstancedMesh(geometry, [enamel, gold], plan.length);
+    parts.push(mesh);
+    // THREE.DynamicDrawUsage, by its value: the shared three chunk then gains no export for it (InstancedMesh is its one new name).
+    mesh.instanceMatrix.setUsage(35048);
+    mesh.frustumCulled = false;
+    const tones = [new THREE.Color(options.colours[0]), new THREE.Color(options.colours[1]), new THREE.Color(BLUSH.base)];
+    plan.forEach((f, i) => mesh.setColorAt(i, tones[f.tone]));
+    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
+    scene.add(mesh);
+
+    let aspect = 1;
+    let pxToWorld = 1;
+    const resize = () => {
+      const w = width();
+      const h = height();
+      renderer.setSize(w, h, false);
+      aspect = w / h;
+      camera.aspect = aspect;
+      camera.updateProjectionMatrix();
+      // World units per CSS px at depth 0.
+      pxToWorld = (2 * CAMERA_Z * TAN) / h;
+    };
+    resize();
+
+    // One stand-in moved to each flower in turn (Object3D, which the shared chunk already exports, rather than Matrix4 and Quaternion).
+    const stand = new THREE.Object3D();
+    const hide = (i: number) => {
+      stand.scale.setScalar(0);
+      stand.updateMatrix();
+      mesh.setMatrixAt(i, stand.matrix);
+    };
+
+    /* Where every flower is at t seconds into the fall; false once all are gone. */
+    const place = (t: number): boolean => {
+      let falling = false;
+      for (let i = 0; i < plan.length; i++) {
+        const f = plan[i];
+        const k = (t - f.delay) / f.time;
+        if (k < 0 || k > 1) {
+          hide(i);
+          if (k < 0) falling = true;
+          continue;
+        }
+        falling = true;
+        const half = (CAMERA_Z - f.z) * TAN;
+        const s = f.size * pxToWorld;
+        const top = half + s;
+        stand.position.set(f.x * half * aspect + Math.sin(f.phase + t * f.swayHz * Math.PI * 2) * f.sway, top - k * 2 * top, f.z);
+        const [rx, ry, rz] = pose(f, t);
+        stand.rotation.set(rx, ry, rz);
+        stand.scale.setScalar(s);
+        stand.updateMatrix();
+        mesh.setMatrixAt(i, stand.matrix);
+      }
+      mesh.instanceMatrix.needsUpdate = true;
+      return falling;
+    };
+
+    const probe = options.probe === false ? null : frameProbe();
+    let raf = 0;
+    let going = false;
+    let started = false;
+    let ended = false;
+    let last = 0;
+    let t = 0;
+    // Wall time while running: a phone that slows after the probe (heat) still ends the fall by 9 s.
+    let ran = 0;
+    let ready = false;
+    let wanted = true;
+
+    const end = (why: FallEnd) => {
+      if (ended) return;
+      ended = true;
+      going = false;
+      cancelAnimationFrame(raf);
+      options.onEnd(why);
+    };
+
+    const frame = (now: number) => {
+      if (!going || disposed) return;
+      raf = requestAnimationFrame(frame);
+      // The first frame after a start or a pause is the baseline: never counted, never a jump.
+      if (last) {
+        const dt = now - last;
+        if (probe && probe.frame(dt) === "slow") {
+          last = now;
+          end("slow");
+          return;
+        }
+        t += Math.min(dt, 50) / 1000;
+        ran += dt;
+      }
+      last = now;
+      const falling = place(t);
+      renderer.render(scene, camera);
+      if (!started) {
+        started = true;
+        options.onStart?.();
+      }
+      if (!falling || t * 1000 >= FALL_MS || ran >= FALL_MS * 1.5) end("done");
+    };
+
+    const run = () => {
+      if (disposed || ended || going || !ready || !wanted) return;
+      going = true;
+      last = 0;
+      raf = requestAnimationFrame(frame);
+    };
+
+    let resizeFrame = 0;
+    const onResize = () => {
+      cancelAnimationFrame(resizeFrame);
+      resizeFrame = requestAnimationFrame(resize);
+    };
+    window.addEventListener("resize", onResize);
+    const onLost = (e: Event) => {
+      e.preventDefault();
+      end("lost");
+    };
+    canvas.addEventListener("webglcontextlost", onLost);
+    parts.push({
+      dispose: () => {
+        going = false;
+        cancelAnimationFrame(raf);
+        cancelAnimationFrame(resizeFrame);
+        window.removeEventListener("resize", onResize);
+        canvas.removeEventListener("webglcontextlost", onLost);
+      },
+    });
+
+    // Every flower out of sight before the shaders are ready, so nothing flashes; compiled off the main thread where the browser can.
+    place(-1);
+    const compiled = typeof renderer.compileAsync === "function" ? renderer.compileAsync(scene, camera) : Promise.resolve();
+    void Promise.resolve(compiled)
+      .catch(() => undefined)
+      .then(() => {
+        if (disposed) return;
+        // One unseen frame (every flower hidden, the canvas not yet shown): a browser that links its programs on first use does it now.
+        try {
+          renderer.render(scene, camera);
+        } catch {
+          /* the first real frame tries again */
+        }
+        ready = true;
+        options.onReady?.();
+        run();
+      });
+
+    return {
+      pause: () => {
+        wanted = false;
+        going = false;
+        cancelAnimationFrame(raf);
+      },
+      resume: () => {
+        wanted = true;
+        run();
+      },
+      dispose: release,
+    };
+  } catch (error) {
+    release();
+    throw error;
+  }
+}
diff --git a/src/lib/portal/seasons.test.ts b/src/lib/portal/seasons.test.ts
new file mode 100644
index 0000000..8105577
--- /dev/null
+++ b/src/lib/portal/seasons.test.ts
@@ -0,0 +1,77 @@
+import { describe, expect, it } from "vitest";
+import { DRESSINGS, SEASONS, readableSeason, seasonOn, type SeasonRow } from "./seasons";
+
+/* What is wrong with a row, for the owner (the garden itself only asks readableSeason). */
+const DAY = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+const seasonProblems = (row: SeasonRow): string[] => {
+  const out: string[] = [];
+  if (!/^[a-z0-9-]+$/.test(row.id)) out.push(`${row.id || "(no id)"}: the id is small letters, digits and dashes`);
+  if (!DAY.test(row.start)) out.push(`${row.id}: start is not a YYYY-MM-DD day`);
+  if (!DAY.test(row.end)) out.push(`${row.id}: end is not a YYYY-MM-DD day`);
+  if (DAY.test(row.start) && DAY.test(row.end) && row.end < row.start) out.push(`${row.id}: it ends before it starts`);
+  if (!DRESSINGS.includes(row.dressing)) out.push(`${row.id}: "${row.dressing}" is not one of ${DRESSINGS.join(", ")}`);
+  if (out.length === 0 !== readableSeason(row)) out.push(`${row.id}: the garden reads it differently`);
+  return out;
+};
+
+const ist = (stamp: string) => new Date(`${stamp}+05:30`);
+const holi: SeasonRow = { id: "holi-2027", start: "2027-03-21", end: "2027-03-22", dressing: "holi" };
+
+describe("the festival table", () => {
+  /* Dates are the owner's, never computed. Delete this test when she approves the first row. */
+  it("ships empty until the owner approves a row", () => {
+    expect(SEASONS).toEqual([]);
+  });
+
+  it("holds only rows the garden can read", () => {
+    expect(SEASONS.flatMap(seasonProblems)).toEqual([]);
+    expect(new Set(SEASONS.map((r) => r.id)).size).toBe(SEASONS.length);
+  });
+
+  it("wears a row from the first minute of its first day to the last of its last, in IST", () => {
+    expect(seasonOn([holi], ist("2027-03-20T23:59:59"))).toBeNull();
+    expect(seasonOn([holi], ist("2027-03-21T00:00:00"))).toBe(holi);
+    expect(seasonOn([holi], ist("2027-03-21T12:00:00"))).toBe(holi);
+    expect(seasonOn([holi], ist("2027-03-22T23:59:59"))).toBe(holi);
+    expect(seasonOn([holi], ist("2027-03-23T00:00:00"))).toBeNull();
+  });
+
+  it("counts the days in India, whatever zone the phone is in", () => {
+    // 18:30 UTC on the 20th is midnight on the 21st in India: the first day has begun.
+    expect(seasonOn([holi], new Date("2027-03-20T18:30:00Z"))).toBe(holi);
+    expect(seasonOn([holi], new Date("2027-03-20T18:29:59Z"))).toBeNull();
+    // 18:29 UTC on the 22nd is still the 22nd in India; a minute later it is over.
+    expect(seasonOn([holi], new Date("2027-03-22T18:29:59Z"))).toBe(holi);
+    expect(seasonOn([holi], new Date("2027-03-22T18:30:00Z"))).toBeNull();
+  });
+
+  it("dresses one-day rows on that day alone", () => {
+    const day: SeasonRow = { id: "one-day", start: "2027-08-15", end: "2027-08-15", dressing: "monsoon" };
+    expect(seasonOn([day], ist("2027-08-15T00:00:00"))).toBe(day);
+    expect(seasonOn([day], ist("2027-08-15T23:59:00"))).toBe(day);
+    expect(seasonOn([day], ist("2027-08-16T00:00:00"))).toBeNull();
+  });
+
+  it("has no dressing without a row for today", () => {
+    expect(seasonOn([], ist("2026-11-08T20:00:00"))).toBeNull();
+    expect(seasonOn(SEASONS, new Date())).toBeNull();
+    expect(seasonOn([holi], ist("2026-11-08T20:00:00"))).toBeNull();
+  });
+
+  it("never wears a row it cannot read", () => {
+    const backwards = { id: "backwards", start: "2027-03-22", end: "2027-03-21", dressing: "holi" } as SeasonRow;
+    const unknown = { id: "unknown", start: "2027-03-21", end: "2027-03-22", dressing: "fireworks" } as unknown as SeasonRow;
+    const loose = { id: "loose", start: "21 Mar 2027", end: "2027-03-22", dressing: "holi" } as SeasonRow;
+    for (const row of [backwards, unknown, loose]) {
+      expect(seasonProblems(row).length).toBeGreaterThan(0);
+      expect(seasonOn([row], ist("2027-03-21T12:00:00"))).toBeNull();
+    }
+    expect(seasonProblems(holi)).toEqual([]);
+  });
+
+  it("wears the first matching row when two overlap", () => {
+    const rain: SeasonRow = { id: "rain", start: "2027-03-01", end: "2027-03-31", dressing: "monsoon" };
+    expect(seasonOn([holi, rain], ist("2027-03-21T09:00:00"))).toBe(holi);
+    expect(seasonOn([rain, holi], ist("2027-03-21T09:00:00"))).toBe(rain);
+  });
+});
diff --git a/src/lib/portal/seasons.ts b/src/lib/portal/seasons.ts
new file mode 100644
index 0000000..6d6d51f
--- /dev/null
+++ b/src/lib/portal/seasons.ts
@@ -0,0 +1,49 @@
+import { istDayKey } from "./ist";
+
+/*
+  THE FESTIVAL TABLE. Written by the owner; empty until she approves the
+  first row. Dates are never computed: a festival moves with the moon, and a
+  garden dressed for Diwali on the wrong night is worse than none. Each row
+  is a run of whole days in Indian time, start and end both included, and the
+  garden wears its dressing on those days only. With no row for today there
+  is no dressing, and nothing is fetched for one.
+
+  One row, for example (both days in IST, inclusive):
+
+    { id: "holi-2027", start: "2027-03-21", end: "2027-03-22", dressing: "holi" },
+
+  The dressings:
+  - "diwali":  diyas along the soil and a marigold garland that draws itself
+               across the arbour;
+  - "monsoon": rain in fine hairlines over the bed;
+  - "holi":    soft colour on the ground, and a puff of colour where she taps.
+  Each is still art under reduced motion or Data Saver. When the first row
+  goes in, delete the test "ships empty until the owner approves a row" in
+  seasons.test.ts: it guards the release that went out with none.
+*/
+
+export type Dressing = "diwali" | "monsoon" | "holi";
+export const DRESSINGS: readonly Dressing[] = ["diwali", "monsoon", "holi"];
+
+export type SeasonRow = {
+  id: string;
+  /** First day, "YYYY-MM-DD", in IST (included). */
+  start: string;
+  /** Last day, "YYYY-MM-DD", in IST (included). */
+  end: string;
+  dressing: Dressing;
+};
+
+export const SEASONS: readonly SeasonRow[] = [];
+
+const DAY = /^\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\d|3[01])$/;
+
+/** A row the garden can wear: an id, two IST days in order, a known dressing. Any other row is never worn (seasons.test says what is wrong with it). */
+export const readableSeason = (r: SeasonRow): boolean =>
+  /^[a-z0-9-]+$/.test(r.id) && DAY.test(r.start) && DAY.test(r.end) && r.start <= r.end && DRESSINGS.includes(r.dressing);
+
+/** The row the garden wears at `at` (IST days, both ends included), or null: the first readable match in the table's order. */
+export const seasonOn = (rows: readonly SeasonRow[], at: Date | number = Date.now()): SeasonRow | null => {
+  const today = istDayKey(at instanceof Date ? at : new Date(at));
+  return rows.find((r) => readableSeason(r) && r.start <= today && today <= r.end) ?? null;
+};
diff --git a/src/lib/portal/shareCard.test.ts b/src/lib/portal/shareCard.test.ts
