+import { forwardRef, useEffect, useMemo, useRef, useState } from "react";
+import PortalShell from "@/components/portal/PortalShell";
+import { Arbour, PlantArt } from "@/components/portal/GardenBed";
+import FlowerDraw from "@/components/portal/FlowerDraw";
+import { StonePlant } from "@/components/portal/StoneArt";
+import { FlowerGlyph } from "@/components/portal/FlowerGlyph";
+import { useMember } from "@/components/portal/MemberContext";
+import { useGardenPlants, type GardenFlower } from "@/components/portal/useGardenPlants";
+import { eyebrow } from "@/components/portal/styles";
+import { BED, RING_RX, RING_RY, RING_SOIL, ROW_SHADE, boxOf, layoutGarden, plantBed, type SavedSprig } from "@/lib/portal/gardenLayout";
+import { FLOWER_ASPECT } from "@/lib/portal/brandFlower";
+import { CrownStill } from "@/components/portal/crownArt";
+import { shownName, stoneForMonth, type Stone } from "@/lib/portal/stones";
+import { lazyRoom, whenIdle } from "@/lib/portal/lazyRoom";
+import "./card.css";
+
+/*
+  /members/card: her garden card. A picture of her garden (the same seed,
+  the same planting as her bed) or of a flower she pressed, with her
+  stone's name and the still NAIRA wordmark, as a 1080 x 1920 PNG drawn on
+  her phone. Her first name is left off unless she adds it; the card never
+  carries a number, a count or a date. Her gift dates, which bloom on her
+  garden's arbour at home, stay off it too: the ledger is about the people
+  she buys for. Once her account holds all five of the Naira flower's
+  pieces (Gathered, Phase 6), the whole flower stands at the arbour's crown
+  in gold leaf, as it does in her bed.
+
+  The room paints the art at once, in a frame shaped like the card; the
+  renderer (ShareCard.tsx, with lib/portal/shareCard) is a chunk of its own,
+  fetched once the room has painted, and lays the finished picture over it.
+  The room has no ambient motion: the drawing never shares a frame with an
+  animation.
+*/
+
+const ShareCard = lazyRoom(() => import("@/components/portal/ShareCard"));
+
+type ArtProps = { seed: string; stone: Stone | null; pressed: readonly GardenFlower[]; fitted: boolean; saved: readonly SavedSprig[]; gathered: boolean };
+
+/* Her garden as one SVG: the bed's own plants, boxes and drawings, standing still. */
+const GardenArt = forwardRef<SVGSVGElement, ArtProps>(({ seed, stone, pressed, fitted, saved, gathered }, ref) => {
+  const garden = useMemo(() => layoutGarden(seed), [seed]);
+  const { bands, ringed } = useMemo(() => plantBed(seed, garden, { pressed, fitted, saved }), [seed, garden, pressed, fitted, saved]);
+  return (
+    <svg ref={ref} viewBox={`0 0 ${BED.w} ${BED.h}`} className="ig-cardroom-art" aria-hidden>
+      <Arbour crown={!gathered} />
+      {gathered && <CrownStill />}
+      <path className="ig-soil" d={`M14 ${BED.soil + 1}H${BED.w - 14}`} pathLength={1} strokeDasharray="1 1" />
+      {ringed && <ellipse cx={garden.stone.x} cy={RING_SOIL} rx={RING_RX} ry={RING_RY} fill="none" stroke="var(--nf-accent-strong)" strokeWidth="1" />}
+      {[40, 92, 236, 318, 352].map((x) => (
+        <circle key={x} cx={x} cy={BED.soil + 5} r="1.2" fill="var(--nf-accent)" opacity=".7" />
+      ))}
+      {bands.flat().map((p) => {
+        const b = boxOf(p);
+        const at = { x: b.left.toFixed(2), y: b.top.toFixed(2), width: b.w.toFixed(2), height: b.h.toFixed(2) };
+        if (p.kind === "naira") {
+          return (
+            <svg key={p.id} {...at} viewBox={`0 0 ${Math.round(208 * FLOWER_ASPECT)} 208`} preserveAspectRatio="none">
+              <FlowerDraw height={208} />
+            </svg>
+          );
+        }
+        if (p.kind === "stone") {
+          return (
+            <svg key={p.id} {...at} viewBox="0 0 80 170">
+              <StonePlant stone={stone} />
+            </svg>
+          );
+        }
+        return (
+          <svg key={p.id} {...at} viewBox="-30 -112 60 112" opacity={ROW_SHADE[p.row]}>
+            <PlantArt p={p} />
+          </svg>
+        );
+      })}
+    </svg>
+  );
+});
+GardenArt.displayName = "GardenArt";
+
+/* A pressed flower, as its herbarium frame holds it. */
+const PressedArt = forwardRef<SVGSVGElement, { flower: GardenFlower }>(({ flower }, ref) => (
+  <svg ref={ref} viewBox="0 0 120 166" className="ig-cardroom-art ig-cardroom-art--flower" aria-hidden>
+    <FlowerGlyph species={flower.species} accent={flower.accent} state="pressed" size={166} />
+  </svg>
+));
+PressedArt.displayName = "PressedArt";
+
+const Card = () => {
+  const { user, firstName, month, naira } = useMember();
+  const { flowers, sprigs } = useGardenPlants();
+  const stone = stoneForMonth(month);
+  const [art, setArt] = useState<string>("garden");
+  const [withName, setWithName] = useState(false);
+  const [rendererIn, setRendererIn] = useState(ShareCard.isLoaded());
+  const artRef = useRef<SVGSVGElement>(null);
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+  const flower = flowers.find((f) => f.id === art) ?? null;
+  // A name the card would never print (none on her account) is not offered.
+  const nameable = firstName !== "friend" && !/\d/.test(firstName);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+    // The card's three faces, asked for now, so the first drawing does not wait on them.
+    const fonts = (document as Document & { fonts?: FontFaceSet }).fonts;
+    for (const face of ["400 26px Jost", "400 58px 'Cormorant Garamond'", "italic 400 68px 'Cormorant Garamond'"]) void fonts?.load?.(face).catch(() => undefined);
+  }, []);
+
+  // The renderer, once the room has painted.
+  useEffect(() => {
+    if (rendererIn) return;
+    let live = true;
+    const cancel = whenIdle(() => {
+      void ShareCard.preload().then(() => {
+        if (live && ShareCard.isLoaded()) setRendererIn(true);
+      });
+    });
+    return () => {
+      live = false;
+      cancel();
+    };
+  }, [rendererIn]);
+
+  const input = useMemo(
+    () => ({
+      art: flower ? ("flower" as const) : ("garden" as const),
+      name: withName && nameable ? firstName : null,
+      stone: stone ? stone.variant : null,
+      flower: flower?.title ?? null,
+    }),
+    [flower, withName, nameable, firstName, stone],
+  );
+
+  return (
+    <PortalShell title="Your garden card" description="Your garden card in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-cardroom">
+        <p className={eyebrow}>The Inner Garden</p>
+        <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+          Your garden card
+        </h1>
+        <p className="ig-lede">Your garden as a picture, drawn here on your phone: to keep, or to share.</p>
+
+        <div className="ig-cardroom-stage">
+          <div className="ig-cardroom-paper" data-art={flower ? "flower" : "garden"}>
+            {flower ? (
+              <PressedArt ref={artRef} flower={flower} />
+            ) : (
+              <GardenArt ref={artRef} seed={user.id} stone={stone} pressed={flowers} fitted={Boolean(naira.ring)} saved={sprigs} gathered={((naira.p ?? 0) & 31) === 31} />
+            )}
+          </div>
+          <div className="ig-cardroom-choices">
+            {flowers.length > 0 && (
+              <fieldset className="ig-cardroom-pick">
+                <legend className={eyebrow}>On the card</legend>
+                <label className="ig-cardroom-chip">
+                  <input type="radio" name="ig-card-art" value="garden" checked={!flower} onChange={() => setArt("garden")} />
+                  <span>Your garden</span>
+                </label>
+                {flowers.map((f) => (
+                  <label key={f.id} className="ig-cardroom-chip">
+                    <input type="radio" name="ig-card-art" value={f.id} checked={flower?.id === f.id} onChange={() => setArt(f.id)} />
+                    <span>The {f.title} flower</span>
+                  </label>
+                ))}
+              </fieldset>
+            )}
+            {nameable && (
+              <label className="ig-cardroom-toggle">
+                <input type="checkbox" checked={withName} onChange={(e) => setWithName(e.target.checked)} />
+                <span>
+                  Add my first name, <em>{firstName}</em>
+                </span>
+              </label>
+            )}
+            <p className="ig-fineprint">
+              Your first name is left off unless you add it. The card carries no number of any kind, and nothing else about your account.
+              {stone ? ` Your stone is named as the shop names it: ${shownName(stone.variant)}, in your month's colour.` : ""}
+            </p>
+          </div>
+          {rendererIn ? (
+            <ShareCard source={artRef} input={input} />
+          ) : (
+            <p className="ig-cardroom-status" role="status">
+              Drawing your card…
+            </p>
+          )}
+        </div>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Card;
