+.ig-nav li { flex: 1; }
+.ig-nav-link {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 3px;
+  min-height: 58px;
+  font-family: var(--nf-font-label);
