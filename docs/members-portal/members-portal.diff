+import { useEffect, useId, useRef, useState, type FormEvent } from "react";
+import { BANDS, LABEL_MAX, MONTHS_LONG, bandLabel, checkGift, daysInMonth, type Gift } from "@/lib/portal/gifts";
+import { primaryButton, quietButton } from "./styles";
+
+/*
+  One date for the gift ledger: a short name (12 characters or fewer), the
+  day and the month (no year: it comes round every year), and a budget band
+  from the shop's Gifting page. Checked as she saves; when it cannot be kept
+  the form says why, beside the field, and keeps what she typed. Clarity
+  masks it (the portal's screens already are; the form says so itself too).
+*/
+
+export type SaveAnswer = { ok: true } | { ok: false; message: string };
+
+type Props = {
+  /** The date being changed; a new one when absent. */
+  initial?: Gift;
+  onSave: (gift: Gift) => SaveAnswer;
+  onCancel?: () => void;
+};
+
+const OccasionForm = ({ initial, onSave, onCancel }: Props) => {
+  const id = useId();
+  const [n, setN] = useState(initial?.n ?? "");
+  const [m, setM] = useState(initial?.m ?? 0);
+  const [d, setD] = useState(initial?.d ?? 0);
+  const [b, setB] = useState<number | null>(initial?.b ?? null);
+  const [problem, setProblem] = useState<{ field: string; message: string } | null>(null);
+  const nameRef = useRef<HTMLInputElement>(null);
+
+  useEffect(() => {
+    nameRef.current?.focus({ preventScroll: true });
+  }, []);
+
+  // A day the new month does not have (31 April) is let go, never moved quietly to another.
+  useEffect(() => {
+    if (m && d > daysInMonth(m)) setD(0);
+  }, [m, d]);
+
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    const checked = checkGift({ n, m, d, b });
+    if (checked.ok === false) {
+      setProblem({ field: checked.field, message: checked.message });
+      return;
+    }
+    const answer = onSave(checked.gift);
+    setProblem(answer.ok === false ? { field: "form", message: answer.message } : null);
+  };
+
+  const err = (field: string) => (problem?.field === field ? `${id}-problem` : undefined);
+
+  return (
+    <form className="ig-oform" onSubmit={submit} noValidate data-clarity-mask="true">
+      <div className="ig-oform-row">
+        <label htmlFor={`${id}-n`} className="ig-oform-label">
+          Who it is for
+        </label>
+        <input
+          ref={nameRef}
+          id={`${id}-n`}
+          className="ig-input ig-oform-input"
+          value={n}
+          maxLength={LABEL_MAX}
+          autoComplete="off"
+          enterKeyHint="next"
+          placeholder="Mum, Riya, Nani"
+          aria-describedby={`${id}-n-hint`}
+          aria-invalid={problem?.field === "n" || undefined}
+          aria-errormessage={err("n")}
+          onChange={(e) => setN(e.target.value)}
+        />
+        <p id={`${id}-n-hint`} className="ig-fineprint">
+          A first name or a word, {LABEL_MAX} characters at most.
+        </p>
+      </div>
+
+      <fieldset className="ig-oform-row">
+        <legend className="ig-oform-label">The day</legend>
+        <div className="ig-oform-when">
+          <label className="sr-only" htmlFor={`${id}-d`}>
+            Day
+          </label>
+          <select
+            id={`${id}-d`}
+            className="ig-input ig-oform-select"
+            value={d || ""}
+            aria-invalid={problem?.field === "d" || undefined}
+            aria-errormessage={err("d")}
+            onChange={(e) => setD(Number(e.target.value))}
+          >
+            <option value="">Day</option>
+            {Array.from({ length: m ? daysInMonth(m) : 31 }, (_, i) => (
+              <option key={i + 1} value={i + 1}>
+                {i + 1}
+              </option>
+            ))}
+          </select>
+          <label className="sr-only" htmlFor={`${id}-m`}>
+            Month
+          </label>
+          <select
+            id={`${id}-m`}
+            className="ig-input ig-oform-select"
+            value={m || ""}
+            aria-invalid={problem?.field === "m" || undefined}
+            aria-errormessage={err("m")}
+            onChange={(e) => setM(Number(e.target.value))}
+          >
+            <option value="">Month</option>
+            {MONTHS_LONG.map((name, i) => (
+              <option key={name} value={i + 1}>
+                {name}
+              </option>
+            ))}
+          </select>
+        </div>
+        <p className="ig-fineprint">No year: it comes round every year.</p>
+      </fieldset>
+
+      <fieldset className="ig-oform-row" aria-invalid={problem?.field === "b" || undefined} aria-errormessage={err("b")}>
+        <legend className="ig-oform-label">Budget</legend>
+        <div className="ig-chips">
+          {BANDS.map((band) => (
+            <label key={band} className="ig-chip">
+              <input type="radio" className="sr-only" name={`${id}-b`} value={band} checked={b === band} onChange={() => setB(band)} />
+              <span>{bandLabel(band)}</span>
+            </label>
+          ))}
+        </div>
+      </fieldset>
+
+      {problem && (
+        <p id={`${id}-problem`} className="ig-error" role="alert">
+          {problem.message}
+        </p>
+      )}
+      <div className="ig-oform-actions">
+        <button type="submit" className={primaryButton}>
+          {initial ? "Keep the change" : "Keep this date"}
+        </button>
+        {onCancel && (
+          <button type="button" className={quietButton} onClick={onCancel}>
+            Cancel
+          </button>
+        )}
+      </div>
+    </form>
+  );
+};
+
+export default OccasionForm;
