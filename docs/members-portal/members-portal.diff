+    expect(ics).toContain("RRULE:FREQ=YEARLY\r\n");
+    expect(ics).toContain("BEGIN:VALARM\r\nACTION:DISPLAY\r\n");
+    expect(ics).toContain("TRIGGER:-P7D\r\n");
+    expect(ics).toContain("SUMMARY:Mum\\, Papa · 14 March\r\n");
+    expect(ics).not.toMatch(/DTSTART:\d/);
+    // This year's date still to come is this year's.
+    expect(buildIcs(giftDayEvent(gift("Didi", 12, 2), now), 0)).toContain("DTSTART;VALUE=DATE:20261202");
+  });
+
+  it("repeats a leap-day birthday on the last day of February", () => {
+    expect(yearlyRule(gift("Isha", 2, 29))).toBe("FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1");
+    expect(buildIcs(giftDayEvent(gift("Isha", 2, 29), now), 0)).toContain("RRULE:FREQ=YEARLY;BYMONTH=2;BYMONTHDAY=-1");
+  });
+
+  it("puts Google's reminder a week before her day, all day, every year", () => {
+    const url = new URL(googleCalendarUrl(giftReminderEvent(gift("Mum", 3, 14), now)));
+    expect(url.searchParams.get("dates")).toBe("20270307/20270308");
+    expect(url.searchParams.get("recur")).toBe("RRULE:FREQ=YEARLY");
+    expect(url.searchParams.get("text")).toBe("A week until Mum · 14 March");
+    expect(url.searchParams.get("details")).toContain("https://nairaflore.com/members/gifts");
