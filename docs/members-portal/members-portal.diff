index 0000000..6424ce7
--- /dev/null
+++ b/src/components/portal/BirthFlowers.tsx
@@ -0,0 +1,138 @@
+/*
+  The twelve birth flowers (stones.ts names them: carnation, violet,
+  daffodil, daisy, lily of the valley, rose, larkspur, gladiolus, aster,
+  marigold, chrysanthemum, narcissus), each one gold line drawing in a
+  single <path> on a 40 x 64 sheet, the stem's foot at the bottom centre.
+  pathLength is 1, so a drawing can draw itself in with stroke-dashoffset
+  (1 to 0) and is whole, still art, when nothing animates.
+
+  Drawn from a few strokes (a petal's loop, a round, a scalloped round, a
+  stem, a leaf) so the twelve weigh little. No stylesheet of its own: any
+  room, or the share card, can draw them.
+*/
+
+const r1 = (n: number) => Math.round(n * 10) / 10;
+const P = (x: number, y: number) => `${r1(x)} ${r1(y)}`;
+const DEG = Math.PI / 180;
+
+/** A petal's loop out from (cx, cy) along `deg` (0 is up), from r0 to r1, `w` wide; `round` 0 (pointed) to 1. */
+const petal = (cx: number, cy: number, deg: number, from: number, to: number, w: number, round = 0.5): string => {
+  const a = (deg - 90) * DEG;
+  const [ux, uy] = [Math.cos(a), Math.sin(a)];
+  const [vx, vy] = [-uy, ux];
+  const len = to - from;
+  const bx = cx + ux * from;
+  const by = cy + uy * from;
+  const tx = cx + ux * to;
+  const ty = cy + uy * to;
+  const near = len * 0.3;
+  const far = len * (0.05 + 0.3 * (1 - round));
+  const wt = w * (0.25 + 0.6 * round);
+  return (
+    `M${P(bx, by)}C${P(bx + ux * near + vx * w, by + uy * near + vy * w)} ${P(tx - ux * far + vx * wt, ty - uy * far + vy * wt)} ${P(tx, ty)}` +
+    `C${P(tx - ux * far - vx * wt, ty - uy * far - vy * wt)} ${P(bx + ux * near - vx * w, by + uy * near - vy * w)} ${P(bx, by)}`
+  );
+};
+
+const petals = (cx: number, cy: number, n: number, from: number, to: number, w: number, round = 0.5, turn = 0): string =>
+  Array.from({ length: n }, (_, i) => petal(cx, cy, turn + (360 / n) * i, from, to, w, round)).join("");
+
+const round = (cx: number, cy: number, r: number) => `M${P(cx - r, cy)}a${r1(r)} ${r1(r)} 0 1 0 ${r1(2 * r)} 0a${r1(r)} ${r1(r)} 0 1 0 ${r1(-2 * r)} 0`;
+
+/** A scalloped round: `n` small arcs bulging outward. */
+const scallop = (cx: number, cy: number, r: number, n: number, bump = 0.7): string => {
+  const at = (i: number) => {
+    const a = ((360 / n) * i - 90) * DEG;
+    return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
+  };
+  const chord = 2 * r * Math.sin(Math.PI / n);
+  const br = (chord / 2) / bump;
+  let d = `M${P(at(0)[0], at(0)[1])}`;
+  for (let i = 1; i <= n; i++) d += `A${r1(br)} ${r1(br)} 0 0 1 ${P(at(i)[0], at(i)[1])}`;
+  return d;
+};
+
+/** A ray: a straight stroke out from the centre. */
+const ray = (cx: number, cy: number, deg: number, from: number, to: number) => {
+  const a = (deg - 90) * DEG;
+  return `M${P(cx + Math.cos(a) * from, cy + Math.sin(a) * from)}L${P(cx + Math.cos(a) * to, cy + Math.sin(a) * to)}`;
+};
+
+const STEM = (top: number, sway = 0) => `M20 63C${P(20 + sway, 50)} ${P(20 - sway, top + 12)} ${P(20, top)}`;
+/** A leaf off the stem at height y, toward `side` (-1 for the left, 1 for the right). */
+const leaf = (y: number, side: number, len = 11, w = 3.2, lift = 30) => petal(20, y, side * (90 - lift), 0, len, w, 0.45);
+const blade = (side: number) => `M20 62C${P(20 + side * 4, 52)} ${P(20 + side * 9, 44)} ${P(20 + side * 13, 34)}C${P(20 + side * 9, 45)} ${P(20 + side * 5, 53)} 20.5 62`;
+
+const BELL = (x: number, y: number) => `M${P(x, y)}C${P(x - 2.6, y + 0.4)} ${P(x - 3, y + 3.2)} ${P(x - 2.6, y + 4.6)}Q${P(x - 1.3, y + 3.8)} ${P(x, y + 5)}Q${P(x + 1.3, y + 3.8)} ${P(x + 2.6, y + 4.6)}C${P(x + 3, y + 3.2)} ${P(x + 2.6, y + 0.4)} ${P(x, y)}`;
+const floret = (x: number, y: number, s: number) => petals(x, y, 4, 0, s, s * 0.55, 0.8, 45);
+
+// eslint-disable-next-line react-refresh/only-export-components -- the drawings themselves, for any room (or a canvas) to draw
+export const BIRTH_FLOWER_PATHS: readonly string[] = [
+  // January · carnation: a ruffled head with its inner frill, a narrow calyx, two grass leaves
+  `${STEM(28, 1.5)}M17.4 23.6L18.6 28H21.4L22.6 23.6M${P(20 + Math.cos(203 * DEG) * 10.5, 22 + Math.sin(203 * DEG) * 11.5)}${Array.from({ length: 7 }, (_, i) => {
+    const a = (203 + i * 19.1) * DEG;
+    const b = (203 + (i + 1) * 19.1) * DEG;
+    return `Q${P(20 + Math.cos((a + b) / 2) * 14, 22 + Math.sin((a + b) / 2) * 15)} ${P(20 + Math.cos(b) * 10.5, 22 + Math.sin(b) * 11.5)}`;
+  }).join("")}Q20 25.6 ${P(20 + Math.cos(203 * DEG) * 10.5, 22 + Math.sin(203 * DEG) * 11.5)}M14.2 17.6Q17 14.6 20 16.4Q23 14.6 25.8 17.6M16.4 21Q20 18.4 23.6 21${leaf(44, -1, 13, 1.8, 40)}${leaf(50, 1, 12, 1.8, 45)}`,
+  // February · violet: five round petals, two up, two out, one down; a heart leaf
+  `${STEM(28, 2)}${petal(20, 18, -32, 1.5, 11, 5, 0.95)}${petal(20, 18, 32, 1.5, 11, 5, 0.95)}${petal(20, 18, -100, 1.5, 9.5, 4.2, 0.9)}${petal(20, 18, 100, 1.5, 9.5, 4.2, 0.9)}${petal(20, 18, 180, 1.5, 10, 5, 0.95)}${round(20, 18, 1.5)}M20 46C14 40 9 43 11 48C12.5 52 18 53 20 50`,
+  // March · daffodil: six pointed petals, a frilled trumpet, a long blade
+  `${STEM(29.5, -1.5)}${petals(20, 17, 6, 2, 12.5, 3.6, 0.25)}${round(20, 17, 4.2)}${scallop(20, 17, 2.4, 8, 0.75)}${blade(1)}`,
+  // April · daisy: twelve slim petals round a button heart
+  `${STEM(30, 1)}${petals(20, 17, 12, 3.4, 13, 1.9, 0.7)}${round(20, 17, 3)}${leaf(46, 1, 10, 2.6)}`,
+  // May · lily of the valley: an arching stem of hanging bells over a broad leaf
+  `M20 63C20 44 22 28 30 16M23.6 38.5Q20.5 39.5 19 41M26 30Q23 30.5 21.5 32.5M28.6 21.5Q26 21.5 24.5 23.6${BELL(18.6, 41)}${BELL(21.4, 32.4)}${BELL(24.3, 23.5)}M30 16C31.5 15 32.4 13.2 32.2 12.2M19.5 62C9 56 6 42 11 30C16 40 18.5 50 19.5 62M19.5 62C15.5 52 12.5 42 11 30`,
+  // June · rose: a cupped head with its swirl, a calyx and two leaves
+  `${STEM(26, 1.5)}M10.5 15C10.5 23 15 27 20 27C25 27 29.5 23 29.5 15M10.5 15C13 11 17 10 20 12C23 10 27 11 29.5 15M20 12C17 13.5 16 16.5 17.5 18.5C19 20.5 22.5 20 23.2 17.5C23.8 15.2 22 13.6 20.2 14.2C18.8 14.8 18.8 16.8 20.2 17.2M13 20.5C15.5 23 18 23.5 20 23.5C22 23.5 24.5 23 27 20.5M16.6 27.6L14.6 30.2M23.4 27.6L25.4 30.2${leaf(40, -1, 11, 3.4)}${leaf(48, 1, 10, 3.2)}`,
+  // July · larkspur: a tall spike of four-petal florets, smaller toward the bud at its tip
+  `M20 63C20.5 45 20 25 20 4${floret(16.5, 34, 4.4)}${floret(23.5, 27.5, 4)}${floret(16.8, 21, 3.6)}${floret(23.2, 15, 3.2)}${floret(17.4, 9.6, 2.6)}${petal(20, 4.4, 0, 0, 2.6, 1.4, 0.6)}M20 34H18.4M20 27.5H21.6M20 21H18.6M20 15H21.4${leaf(50, 1, 9, 2.4)}`,
+  // August · gladiolus: ruffled florets climbing one side of a leaning spike
+  `M20 63C20.5 46 22 30 27 6${[
+    [17.5, 42, 5.2],
+    [19.6, 32, 4.8],
+    [21.8, 22.5, 4.2],
+    [24.2, 14, 3.4],
+  ]
+    .map(([x, y, s]) => petal(x, y, -70, 0, s * 1.6, s * 0.7, 0.85) + petal(x, y, -20, 0, s * 1.7, s * 0.8, 0.85) + petal(x, y, 30, 0, s * 1.5, s * 0.6, 0.85))
+    .join("")}${petal(27, 6.2, 15, 0, 3.4, 1.2, 0.3)}${blade(-1)}`,
+  // September · aster: many fine rays round a full heart
+  `${STEM(28.5, -1.5)}${Array.from({ length: 22 }, (_, i) => ray(20, 17, i * (360 / 22), 3.6, i % 2 ? 11.5 : 13)).join("")}${round(20, 17, 3.4)}${leaf(42, -1, 10, 2.4, 35)}${leaf(49, 1, 9, 2.2, 40)}`,
+  // October · marigold: a dense ruffled pompom, layer on layer, over a fern leaf
+  `${STEM(28.5, 1)}${scallop(20, 16.5, 12, 14, 0.8)}${scallop(20, 16.5, 8, 10, 0.78)}${scallop(20, 16.5, 4.2, 7, 0.75)}M20 44L28 36M22.6 41.4L23.6 37.4M22.6 41.4L26.4 42.2M25.2 38.8L26 35.4M25.2 38.8L28.6 39.4`,
+  // November · chrysanthemum: two rings of pointed petals, the inner turned between the outer
+  `${STEM(30, -1)}${petals(20, 16.5, 16, 7, 13.5, 1.7, 0.15)}${petals(20, 16.5, 11, 2.5, 8, 1.8, 0.2, 16)}${round(20, 16.5, 2.2)}${leaf(44, 1, 11, 3.4, 25)}`,
+  // December · narcissus: six round petals, a small flat cup with its eye, a blade
+  `${STEM(20.2, 1.5)}${petals(20, 17, 6, 2.2, 11.5, 4.6, 0.9, 30)}${scallop(20, 17, 3.2, 9, 0.8)}${round(20, 17, 1.3)}${blade(-1)}`,
+];
+
+type Props = {
+  /** 1 to 12. */
+  month: number;
+  /** Rendered height in px (the sheet is 40 wide by 64 tall). */
+  size: number;
+  className?: string;
+  /** Spoken name ("March's flower, the daffodil"); decorative when absent. */
+  label?: string;
+};
+
+/** One birth flower, in a gold hairline. */
+export const BirthFlower = ({ month, size, className = "", label }: Props) => {
+  const d = BIRTH_FLOWER_PATHS[month - 1];
+  if (!d) return null;
+  return (
+    <svg
+      viewBox="0 0 40 64"
+      width={Math.round((size * 40) / 64)}
+      height={size}
+      className={`ig-birthflower ${className}`}
+      role={label ? "img" : undefined}
+      aria-label={label}
+      aria-hidden={label ? undefined : true}
+      overflow="visible"
+    >
+      <path d={d} pathLength={1} fill="none" stroke="var(--nf-accent-strong)" strokeWidth="0.9" strokeLinecap="round" strokeLinejoin="round" />
+    </svg>
+  );
+};
+
+export default BirthFlower;
diff --git a/src/components/portal/BloomClock.test.tsx b/src/components/portal/BloomClock.test.tsx
