+import { act, cleanup, render, screen } from "@testing-library/react";
+import { MemoryRouter, Route, Routes } from "react-router-dom";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { safePerformancePath } from "@/lib/shopperPerformance";
+
+const auth = vi.hoisted(() => ({
+  state: { user: null as unknown, profile: null as unknown, loading: true, refreshProfile: async () => {}, session: null, signOut: async () => {} },
+}));
+// The garden grows a sprig for each heart on this phone (its drawer, read only).
+vi.mock("@/contexts/WishlistContext", () => ({ useWishlist: () => ({ items: [] }) }));
+vi.mock("@/contexts/AuthContext", () => ({ useAuth: () => auth.state }));
+vi.mock("@/contexts/CartContext", () => ({ useCart: () => ({ addItem: vi.fn(), setDrawerOpen: vi.fn() }) }));
+vi.mock("@/components/PageSEO", () => ({ default: () => null }));
+vi.mock("@/components/Footer", () => ({ default: () => <footer /> }));
+vi.mock("@/components/members/JoinInnerCircleForm", () => ({ default: () => <form aria-label="Join the Inner Circle" /> }));
+vi.mock("@/hooks/useLiveJewellery", () => ({ useLiveJewellery: () => ({ jewellery: [], isLive: false, isLoading: true }) }));
+vi.mock("@/integrations/supabase/lazy", () => ({ getSupabase: vi.fn() }));
+
+import MembersRoute, { PROFILE_WAIT_MS } from "./MembersRoute";
+
+const visit = (path: string) =>
+  render(
+    <MemoryRouter initialEntries={[path]}>
+      <Routes>
+        <Route path="/members/*" element={<MembersRoute />} />
+      </Routes>
+    </MemoryRouter>,
+  );
+
+const member = {
+  id: "3f2c9a1e-0b7d-4c55-9a51-7e7e2d1c0a11",
+  email: "ananya.r@example.com",
+  created_at: "2026-11-04T05:00:00Z",
+  user_metadata: {},
+};
+
+beforeEach(() => {
+  auth.state = { ...auth.state, user: null, profile: null, loading: true, refreshProfile: async () => {} };
+  window.localStorage.clear();
+});
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+});
+
+describe("/members", () => {
+  /* While Supabase is still reading the session, a member must not see the
+     signed-out page (and its sign-in prompt) flash before her garden. */
+  it("keeps the gate closed while sign-in is being read", () => {
+    visit("/members");
+    expect(screen.getByRole("heading", { level: 1 })).toHaveTextContent("The Inner Garden");
+    expect(screen.getByRole("status")).toHaveTextContent("Opening the gate");
+    expect(screen.queryByRole("link", { name: /enter the garden/i })).toBeNull();
+    expect(screen.queryByRole("form", { name: /join the inner circle/i })).toBeNull();
+  });
+
+  it("sends a signed-out visitor to sign in, and back to the room she asked for", async () => {
+    auth.state = { ...auth.state, loading: false };
+    visit("/members/stone");
+    // The gate's welcome is a chunk of its own (a member never downloads it): until it is in, the gate says it is opening.
+    const link = await screen.findByRole("link", { name: /enter the garden/i });
+    const next = new URLSearchParams(link.getAttribute("href")!.split("?")[1]).get("next");
+    expect(link.getAttribute("href")!.startsWith("/auth?")).toBe(true);
+    expect(next).toBe("/members/stone");
+    expect(screen.getByRole("form", { name: /join the inner circle/i })).toBeInTheDocument();
+    expect(screen.getByRole("img", { name: /closed gold garden gate/i })).toBeInTheDocument();
+  });
+
+  it("makes no promise of prices, codes or perks at the gate", async () => {
+    auth.state = { ...auth.state, loading: false };
+    const { container } = visit("/members");
+    await screen.findByRole("link", { name: /enter the garden/i });
+    expect(container.textContent).not.toMatch(/price|discount|% off|code|reward|exclusive/i);
+  });
+
+  /* The drop rooms are built (Phase 2) but no drop is set yet; Your fit and
+     the Jewel drawer are built (Phase 3): the gate promises only what a
+     member can use today, and with no drop set it names no drop, no date and
+     no first look (they appear as the owner adds the first drop). */
+  it("promises only what is built and set", async () => {
+    auth.state = { ...auth.state, loading: false };
+    const { container } = visit("/members");
+    await screen.findByRole("link", { name: /enter the garden/i });
+    const promises = screen.getAllByRole("listitem").map((li) => li.textContent ?? "");
+    expect(promises).toContain("A garden of your own, planted the day you join");
+    expect(promises).toContain("Your ring size and saved pieces, kept on every phone");
+    expect(promises).not.toContain("A first look at each new drop");
+    expect(promises).not.toContain("A pressed flower for every drop");
+    expect(container.textContent).not.toMatch(/next drop|opens \w{3} \d/i);
+  });
+
+  it("opens her garden when she is signed in, greeting her by name", () => {
+    auth.state = { ...auth.state, loading: false, user: member, profile: { id: member.id, full_name: "Ananya Rao", birthday: "1999-07-14", phone: null, city: null } };
+    const { container } = visit("/members");
+    expect(screen.getByRole("heading", { level: 1 }).textContent).toMatch(/^Good (morning|afternoon|evening), Ananya$|^Hello, Ananya$/);
+    expect(container.querySelectorAll(".ig-plant").length).toBeGreaterThan(40);
+    expect(container.querySelectorAll(".ig-plant").length).toBeLessThanOrEqual(80);
+    const growing = screen.getByRole("heading", { name: "What's growing" }).nextElementSibling!;
+    expect(growing.textContent).toMatch(/The Naira flower, planted 4 Nov 2026/);
+    expect(growing.textContent).toMatch(/July\s·\sRuby, in your month's colour/);
+    expect(screen.getByRole("navigation", { name: "Your garden" })).toBeInTheDocument();
+  });
+
+  it("falls back to her email for a name", () => {
+    auth.state = { ...auth.state, loading: false, user: member, profile: { id: member.id, full_name: null, birthday: null, phone: null, city: null } };
+    visit("/members");
+    expect(screen.getByRole("heading", { level: 1 })).toHaveTextContent(/, Ananya$/);
+  });
+
+  it("returns an unknown room to the garden", async () => {
+    auth.state = { ...auth.state, loading: false, user: member, profile: null };
+    visit("/members/nowhere");
+    expect(await screen.findByRole("heading", { name: "What's growing" })).toBeInTheDocument();
+  });
+
+  /* Supabase answers the sign-in before her profile row. A member who has
+     already given her birthday must never be asked for it, see a bud turn
+     into her stone, or be celebrated for saving something she did not. */
+  it("keeps the gate closed until her profile has been read", async () => {
+    let answer = () => {};
+    const refreshProfile = vi.fn(() => new Promise<void>((resolve) => (answer = resolve)));
+    auth.state = { ...auth.state, loading: false, user: member, profile: null, refreshProfile };
+    const { container } = visit("/members/stone");
+    expect(screen.getByRole("status")).toHaveTextContent("Opening the gate");
+    expect(screen.queryByLabelText("When is your birthday?")).toBeNull();
+    expect(refreshProfile).toHaveBeenCalledTimes(1);
+
+    auth.state = { ...auth.state, profile: { id: member.id, full_name: "Priya Kapoor", birthday: "1999-07-14", phone: null, city: null } };
+    await act(async () => answer());
+    // Your stone is a room of its own, fetched while the gate was closed.
+    expect(await screen.findByRole("heading", { level: 1, name: /Your stone/ })).toBeInTheDocument();
+    expect(screen.queryByLabelText("When is your birthday?")).toBeNull();
+    expect(screen.getByRole("button", { name: /^July · Ruby\. Turn the card over/ })).toBeInTheDocument();
+    expect(container.querySelector(".ig-seed")?.hasAttribute("data-bloomed")).toBe(false);
+  });
+
+  it("still lets in a new member who has no profile row yet", async () => {
+    auth.state = { ...auth.state, loading: false, user: member, profile: null, refreshProfile: async () => {} };
+    visit("/members/stone");
+    expect(await screen.findByLabelText("When is your birthday?")).toBeInTheDocument();
+  });
+
+  it("never keeps her out for long when the profile is slow", () => {
+    vi.useFakeTimers();
+    auth.state = { ...auth.state, loading: false, user: member, profile: null, refreshProfile: () => new Promise<void>(() => {}) };
+    visit("/members");
+    expect(screen.getByRole("status")).toHaveTextContent("Opening the gate");
+    act(() => void vi.advanceTimersByTime(PROFILE_WAIT_MS));
+    expect(screen.getByRole("heading", { name: "What's growing" })).toBeInTheDocument();
+  });
+
+  /* /auth and /account are kept out of shopper telemetry; so is the portal. */
+  it("is left out of the shopper performance telemetry", () => {
+    expect(safePerformancePath("/members")).toBeNull();
+    expect(safePerformancePath("/members/stone")).toBeNull();
+    expect(safePerformancePath("/jewellery")).toBe("/jewellery");
+  });
+});
