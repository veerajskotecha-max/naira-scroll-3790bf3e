@@ -0,0 +1,133 @@
+import { useEffect, useRef } from "react";
+import { Link } from "react-router-dom";
+import PortalShell from "@/components/portal/PortalShell";
+import AskAtelier from "@/components/portal/AskAtelier";
+import { useMember } from "@/components/portal/MemberContext";
+import { useCheckouts } from "@/components/portal/useCheckouts";
+import { eyebrow, outlineButton, primaryButton, textLink } from "@/components/portal/styles";
+import { formatIstDate, istClock } from "@/lib/portal/ist";
+import "./orders.css";
+
+/*
+  /members/orders: the Order Desk. Where an order can really be seen: the
+  shop's own Track Order page (its sign-in with the checkout email, which
+  lists each order and its status), and the confirmation email's own
+  button, which opens that order's page on any phone. Then the checkouts
+  she started while signed in (her own member_orders rows, read only),
+  called only that, never orders: the bag notes a checkout as it hands her
+  to payment, so one may have been paid or left. Each asks "Did this go
+  through?" and points to where she can see. Ask the atelier, with her
+  email in the message, for anything else. No ambient motion here.
+
+  Phase 5's order webhook is what would let this page say a checkout became
+  an order; until then it never does.
+*/
+
+/* The confirmation email's own button label (Shopify's order confirmation), quoted so she knows it on sight. */
+const EMAIL_BUTTON = "“View your order”";
+
+const Orders = () => {
+  const { user } = useMember();
+  const { rows, failed } = useCheckouts();
+  const h1Ref = useRef<HTMLHeadingElement>(null);
+
+  useEffect(() => {
+    h1Ref.current?.focus({ preventScroll: true });
+  }, []);
+
+  return (
+    <PortalShell title="Order desk" description="Where to see an order, in the Inner Garden, Naira Flore's members' portal.">
+      <div className="ig-orders">
+        <div className="ig-head">
+          <p className={eyebrow}>The Inner Garden</p>
+          <h1 ref={h1Ref} tabIndex={-1} className="ig-h1">
+            The order <em>desk</em>
+          </h1>
+          <p className="ig-lede">Where to see an order, and who to ask about one.</p>
+        </div>
+
+        <section className="ig-section" aria-labelledby="ig-track-h">
+          <h2 id="ig-track-h" className="ig-h2">
+            Track an order
+          </h2>
+          <p className="ig-fineprint">
+            Orders are kept by our checkout. On the Track Order page, sign in there with the email you used at checkout, and each order is listed with its status.
+          </p>
+          <Link className={primaryButton} to="/track-order">
+            Track an order
+          </Link>
+        </section>
+
+        <section className="ig-section" aria-labelledby="ig-email-h">
+          <h2 id="ig-email-h" className="ig-h2">
+            The confirmation email
+          </h2>
+          <p className="ig-fineprint">
+            When an order is placed, an email confirms it. Its {EMAIL_BUTTON} button opens that order's own page, with its status, on any phone. Keep the email: it is the record of the order.
+          </p>
+        </section>
+
+        <section className="ig-section" aria-labelledby="ig-started-h">
+          <h2 id="ig-started-h" className="ig-h2">
+            Checkouts you started
+          </h2>
+          <p className="ig-fineprint">
+            Each time you went to checkout while signed in, it was noted here. A checkout is not always an order: it may have been paid, or left before paying.
+          </p>
+          {rows === null ? (
+            <p className="ig-fineprint" role="status">
+              Reading them from your account…
+            </p>
+          ) : failed ? (
+            <p className="ig-fineprint" role="alert">
+              We couldn't read them just now. The Track Order page and the confirmation email still show every order.
+            </p>
+          ) : rows.length === 0 ? (
+            <p className="ig-fineprint ig-started-none">Nothing here yet. A checkout you start while signed in will appear here.</p>
+          ) : (
+            <ul className="ig-started" data-clarity-mask="true">
+              {rows.map((row) => (
+                <li key={row.id} className="ig-started-row">
+                  <p className="ig-started-when">
+                    Started {formatIstDate(row.createdAt)} · {istClock(row.createdAt)} IST
+                  </p>
+                  <ul className="ig-started-items">
+                    {row.items.length === 0 ? (
+                      <li>Its pieces were not noted.</li>
+                    ) : (
+                      row.items.map((item, i) => (
+                        <li key={i}>
+                          {item.name}
+                          {item.size ? `, ${item.size}` : ""}
+                          {item.quantity > 1 ? ` × ${item.quantity}` : ""}
+                        </li>
+                      ))
+                    )}
+                  </ul>
+                  <Link className={textLink} to="/track-order">
+                    Did this go through? Track it
+                  </Link>
+                </li>
+              ))}
+            </ul>
+          )}
+        </section>
+
+        <AskAtelier
+          about="order"
+          email={user.email ?? null}
+          title="Ask the order desk"
+          lede="Write to the atelier on WhatsApp about an order. The email you used at checkout goes in the message (change it if it was another), with your size, metal and stone."
+        />
+
+        <p className="ig-orders-more">
+          <Link className={outlineButton} to="/members/care">
+            Caring for your pieces
+          </Link>
+        </p>
+      </div>
+    </PortalShell>
+  );
+};
+
+export default Orders;
