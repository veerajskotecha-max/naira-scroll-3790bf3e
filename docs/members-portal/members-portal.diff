@@ -0,0 +1,370 @@
+import { HEART } from "@/components/portal/StoneArt";
+import { hashString, mulberry32 } from "./gardenLayout";
+
+/*
+  STONE LIGHT, the drawing's model: her heart-cut stone held to the light.
+
+  The facets are cut from StoneArt's own HEART outline (the same heart the
+  specimen card and the garden draw), sampled into sixteen girdle points by
+  arc length from its point, so the cleft is the ninth. Inside it a smaller
+  table, and between them a ring of points: one table, eight star facets,
+  eight kites and sixteen upper girdle facets, 33 in all, each with the
+  normal of its plane in a crown about 34° high. Under them, a few faint
+  pavilion lines seen through the table.
+
+  The light is two numbers, x across (a drag, the arrow keys, the Turn
+  buttons, a tilt left and right) and y up and down (a tilt toward her and
+  away), each -1 to 1. A facet catches it as the light's reflection off its
+  plane comes round to her eye; the drawing sets only each facet's opacity.
+  The light petals (up to 18, five-petal flowers and tiny hearts) skate the
+  other way across the ink, each kept inside the panel at every angle.
+
+  Pure, so the gem's scene (lib/portal/gem/scene.ts, Tier 2) builds its
+  triangles from the same cut, and the tests can hold every number.
+*/
+
+export type Pt = readonly [number, number];
+export type Vec3 = readonly [number, number, number];
+export type Light = { readonly x: number; readonly y: number };
+export type FacetKind = "table" | "star" | "kite" | "girdle";
+export type Facet = { kind: FacetKind; points: Pt[]; normal: Vec3 };
+
+/** The heart's own box (StoneArt's viewBox, 24 x 22). */
+export const HEART_BOX = { w: 24, h: 22 } as const;
+/** The panel's drawing: its viewBox, and the heart in it at this scale (about 220 px wide at 390), its box centred at (w / 2, cy). */
+export const PANEL = { w: 358, h: 380, scale: 9.2, cy: 176 } as const;
+/** The gem's canvas (Tier 2) covers the heart's box with this margin round it, in heart units, so a turned gem never meets its edge. */
+export const GEM_MARGIN = 3.3;
+
+/** The gem's canvas over the heart's box, in percent of the panel (stonelight.css's .ig-sl-gem). */
+export const gemBox = () => {
+  const m = GEM_MARGIN * PANEL.scale;
+  const w = HEART_BOX.w * PANEL.scale + 2 * m;
+  const h = HEART_BOX.h * PANEL.scale + 2 * m;
+  const pct = (v: number, of: number) => Math.round((v / of) * 10000) / 100;
+  return { left: pct(PANEL.w / 2 - w / 2, PANEL.w), top: pct(PANEL.cy - h / 2, PANEL.h), width: pct(w, PANEL.w), height: pct(h, PANEL.h) };
+};
+export const GIRDLE_POINTS = 16;
+/* The table's size and the middle ring's, as fractions of the way from the heart's centre to its edge. */
+const TABLE = 0.5;
+const RING = 0.8;
+/* The crown's height at the table, in heart units: a crown angle of about 34°. */
+export const CROWN = 3.4;
+/* The point the table shrinks toward: the heart's visual centre, a little above its middle. */
+export const CENTRE: Pt = [12, 9.6];
+
+const nums = HEART.match(/-?\d*\.?\d+/g)!.map(Number);
+
+/** The heart's outline as a fine polyline, from its point round by the left lobe and back. */
+const outline = (steps = 24): Pt[] => {
+  const pts: Pt[] = [[nums[0], nums[1]]];
+  for (let i = 2; i + 5 < nums.length; i += 6) {
+    const [x0, y0] = pts[pts.length - 1];
+    const [x1, y1, x2, y2, x3, y3] = nums.slice(i, i + 6);
+    for (let s = 1; s <= steps; s++) {
+      const t = s / steps;
+      const u = 1 - t;
+      pts.push([u * u * u * x0 + 3 * u * u * t * x1 + 3 * u * t * t * x2 + t * t * t * x3, u * u * u * y0 + 3 * u * u * t * y1 + 3 * u * t * t * y2 + t * t * t * y3]);
+    }
+  }
+  return pts;
+};
+
+/** n points on the heart's edge, evenly spaced by arc length, starting at its point (12, 20.5). */
+export const girdle = (n = GIRDLE_POINTS): Pt[] => {
+  const line = outline();
+  const acc = [0];
+  for (let i = 1; i < line.length; i++) acc.push(acc[i - 1] + Math.hypot(line[i][0] - line[i - 1][0], line[i][1] - line[i - 1][1]));
+  const total = acc[acc.length - 1];
+  const out: Pt[] = [];
+  let j = 1;
+  for (let k = 0; k < n; k++) {
+    const at = (k / n) * total;
+    while (j < acc.length - 1 && acc[j] < at) j++;
+    const f = (at - acc[j - 1]) / (acc[j] - acc[j - 1] || 1);
+    out.push([line[j - 1][0] + f * (line[j][0] - line[j - 1][0]), line[j - 1][1] + f * (line[j][1] - line[j - 1][1])]);
+  }
+  return out;
+};
+
+const toward = (p: Pt, k: number): Pt => [CENTRE[0] + (p[0] - CENTRE[0]) * k, CENTRE[1] + (p[1] - CENTRE[1]) * k];
+/* Height above the girdle of a point k of the way out (the table at CROWN, the girdle at 0). */
+const heightAt = (k: number) => (CROWN * (1 - k)) / (1 - TABLE);
+
+const norm = (v: Vec3): Vec3 => {
+  const l = Math.hypot(v[0], v[1], v[2]) || 1;
+  return [v[0] / l, v[1] / l, v[2] / l];
+};
+export const dot = (a: Vec3, b: Vec3) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
+
+/**
+ * A facet's normal by Newell's method, in a frame with x to the right, y up
+ * (the drawing's y flipped) and z toward her.
+ */
+export const normalOf = (pts: readonly Vec3[]): Vec3 => {
+  let nx = 0;
+  let ny = 0;
+  let nz = 0;
+  for (let i = 0; i < pts.length; i++) {
+    const a = pts[i];
+    const b = pts[(i + 1) % pts.length];
+    nx += (a[1] - b[1]) * (a[2] + b[2]);
+    ny += (a[2] - b[2]) * (a[0] + b[0]);
+    nz += (a[0] - b[0]) * (a[1] + b[1]);
+  }
+  const n = norm([nx, ny, nz]);
+  // Every crown facet faces her: its normal leans out of the stone, never into it.
+  return n[2] < 0 ? [-n[0], -n[1], -n[2]] : n;
+};
+
+/** A point of the cut in 3D (heart units, centred, y up). */
+export const lift = (p: Pt, z: number): Vec3 => [p[0] - CENTRE[0], CENTRE[1] - p[1], z];
+
+export type Cut = {
+  girdle: Pt[];
+  ring: Pt[];
+  table: Pt[];
+  facets: Facet[];
+  /** Faint lines of the pavilion, seen through the table: from the girdle toward the point below the table. */
+  pavilion: [Pt, Pt][];
+  /** Where the four gold claws hold it: each lobe, the cleft and the point. */
+  claws: Pt[];
+};
+
+const cutOnce = (): Cut => {
+  const g = girdle();
+  const n = g.length;
+  const ring = g.map((p) => toward(p, RING));
+  const table = g.filter((_, i) => i % 2 === 0).map((p) => toward(p, TABLE));
+  const zG = 0;
+  const zR = heightAt(RING);
+  const zT = heightAt(TABLE);
+  const facets: Facet[] = [];
+  const add = (kind: FacetKind, pts: [Pt, number][]) =>
+    facets.push({ kind, points: pts.map(([p]) => p), normal: kind === "table" ? [0, 0, 1] : normalOf(pts.map(([p, z]) => lift(p, z))) });
+  add("table", table.map((p) => [p, zT]));
+  const half = n / 2;
+  for (let k = 0; k < half; k++) {
+    const t0 = table[k];
+    const t1 = table[(k + 1) % half];
+    const odd = 2 * k + 1;
+    // A star between two table corners, its point on the middle ring.
+    add("star", [[t0, zT], [t1, zT], [ring[odd], zR]]);
+    // A kite from a table corner down to the girdle, between two stars.
+    const prev = (2 * k - 1 + n) % n;
+    add("kite", [[t0, zT], [ring[prev], zR], [g[2 * k], zG], [ring[odd], zR]]);
+  }
+  for (let k = 0; k < half; k++) {
+    const odd = 2 * k + 1;
+    // Two upper girdle facets under each star.
+    add("girdle", [[ring[odd], zR], [g[2 * k], zG], [g[odd], zG]]);
+    add("girdle", [[ring[odd], zR], [g[odd], zG], [g[(odd + 1) % n], zG]]);
+  }
+  const culet: Pt = [CENTRE[0], CENTRE[1] + 3.2];
+  const pavilion = g.filter((_, i) => i % 2 === 1).map((p) => [toward(p, 0.92), culet] as [Pt, Pt]);
+  return { girdle: g, ring, table, facets, pavilion, claws: [g[4], g[8], g[12], g[0]] };
+};
+
+let made: Cut | null = null;
+/** The cut, made once. */
+export const cut = (): Cut => (made ??= cutOnce());
+
+/** An outline as an SVG points list ("x,y x,y …"), to two places. */
+export const pointsAttr = (pts: readonly Pt[]) => pts.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(" ");
+
+/* ── the light ───────────────────────────────────────── */
+
+export const clamp1 = (v: number) => Math.max(-1, Math.min(1, v));
+
+/* How far the light swings: 60° across, 40° up and down. Across, it travels on a shallow arc (higher as it
+   passes her), so a drag alone brings it round to the upper facets as well as the side ones. */
+const SWING_X = (60 * Math.PI) / 180;
+const SWING_Y = (40 * Math.PI) / 180;
+const ARC = 0.35;
+
+/** The light's direction from the stone, toward its source. */
+export const lightDir = (light: Light): Vec3 => {
+  const x = clamp1(light.x);
+  const ax = x * SWING_X;
+  const ay = (clamp1(light.y) + ARC * (1 - x * x)) * SWING_Y;
+  return norm([Math.sin(ax) * Math.cos(ay), Math.sin(ay), Math.cos(ax) * Math.cos(ay)]);
+};
+
+/* A second, softer light high on the left, fixed: some facet always holds a little. */
+const FILL: Vec3 = norm([-0.45, 0.55, 0.7]);
+
+/* A facet holds the light while the light's direction lies within about 30° of its normal: the dot product, sharpened. */
+const caught = (normal: Vec3, toLight: Vec3, from = 0.86) => {
+  const k = Math.max(0, (dot(normal, toLight) - from) / (1 - from));
+  return k * k;
+};
+
+/** How much light a facet catches, 0 to 0.92: its ivory overlay's opacity. */
+export const facetLight = (normal: Vec3, light: Light): number =>
+  Math.min(0.92, 0.05 + 0.87 * caught(normal, lightDir(light)) + 0.25 * caught(normal, FILL, 0.9));
+
+/** Every facet's overlay opacity, in the cut's order. */
+export const facetOpacities = (light: Light): number[] => cut().facets.map((f) => facetLight(f.normal, light));
+
+/** The four-point glint on the table: where it sits (heart units) and how bright it is. */
+export const glintAt = (light: Light): { x: number; y: number; scale: number; opacity: number } => {
+  const t = cut().table;
+  const w = Math.max(...t.map((p) => p[0])) - Math.min(...t.map((p) => p[0]));
+  const lit = facetLight([0, 0, 1], light);
+  return {
+    x: CENTRE[0] - 0.5 + clamp1(light.x) * w * 0.32,
+    y: CENTRE[1] - 1.2 - clamp1(light.y) * w * 0.2,
+    scale: 0.6 + 0.7 * lit,
+    opacity: Math.min(1, 0.45 + lit),
+  };
+};
+
+/* ── the light petals ───────────────────────────────── */
+
+export const MAX_LIGHT_PETALS = 18;
+/* How far a petal skates across the panel at full swing (a fraction of its width and height). */
+export const TRAVEL_X = 0.22;
+export const TRAVEL_Y = 0.08;
+/* Every petal's box keeps this far from the panel's edge, at every angle (a fraction of its width). */
+export const EDGE = 0.03;
+
+export type LightPetal = {
+  /** Where it rests with the light facing her, 0 to 1 across and down the panel. */
+  x: number;
+  y: number;
+  /** Nearer petals skate further and are larger. */
+  depth: number;
+  /** Its width, as a fraction of the panel's width. */
+  size: number;
+  kind: "flower" | "heart";
+  /** 0 the month's hue, 1 its tint, 2 ivory, 3 pale gold. */
+  tone: 0 | 1 | 2 | 3;
+  turn: number;
+  /** Degrees it turns across a full swing. */
+  spin: number;
+  /** The light's x at which it shines brightest. */
+  phase: number;
+};
+
+/** The petals' plan: the same on every phone, kept inside the panel at every light. */
+export const petalPlan = (count = MAX_LIGHT_PETALS, seed = "stone-light"): LightPetal[] => {
+  const rand = mulberry32(hashString(seed));
+  const n = Math.max(0, Math.min(MAX_LIGHT_PETALS, Math.floor(count)));
+  return Array.from({ length: n }, (_, i) => {
+    const depth = 0.35 + rand() * 0.65;
+    const size = 0.022 + depth * 0.028;
+    const mx = EDGE + size / 2 + TRAVEL_X * depth;
+    const my = (EDGE + size / 2) * 1.2 + TRAVEL_Y * depth;
+    // Spread evenly across, so no gap opens down one side.
+    const x = mx + ((i + rand()) / n) * (1 - 2 * mx);
+    return {
+      x,
+      y: my + rand() * (1 - 2 * my),
+      depth,
+      size,
+      kind: rand() < 0.68 ? "flower" : "heart",
+      tone: (i % 4) as LightPetal["tone"],
+      turn: rand() * 360,
+      spin: (rand() < 0.5 ? -1 : 1) * (60 + rand() * 140),
+      phase: rand() * 2 - 1,
+    };
+  });
+};
+
+/** A petal at this light: its centre (0 to 1 of the panel), its turn in degrees and its opacity. */
+export const petalPose = (p: LightPetal, light: Light): { x: number; y: number; rot: number; opacity: number } => {
+  const lx = clamp1(light.x);
+  const ly = clamp1(light.y);
+  const near = lx - p.phase;
+  return {
+    // The other way from the light.
+    x: p.x - lx * p.depth * TRAVEL_X,
+    y: p.y + ly * p.depth * TRAVEL_Y,
+    rot: p.turn - lx * p.spin,
+    // Never below 0.45: on ink, a dimmer petal reads as dust, not light.
+    opacity: 0.45 + 0.55 * Math.exp(-(near * near) / 0.18),
+  };
+};
+
+/* ── turning it ─────────────────────────────────────── */
+
+/** Where the light rests at first: a little to her right, a little high. Also the still pose under reduced motion. */
+export const REST: Light = { x: 0.35, y: 0.12 };
+/** The four poses the Turn buttons step through, in order, without moving between them under reduced motion. */
+export const POSES: readonly Light[] = [
+  { x: -0.7, y: 0.05 },
+  { x: -0.2, y: -0.1 },
+  { x: 0.35, y: 0.12 },
+  { x: 0.8, y: -0.05 },
+];
+/** One Turn button press, or one arrow key: about a fifth of the swing. */
+export const STEP = 0.22;
+
+/** A horizontal drag of dx CSS px across a panel `width` px wide, from where the light was. */
+export const dragToLight = (from: Light, dx: number, width: number): Light => ({ x: clamp1(from.x + dx / Math.max(1, width * 0.55)), y: from.y });
+
+/** One arrow key: left and right turn it, up and down tip it. */
+export const keyToLight = (from: Light, key: string): Light | null => {
+  if (key === "ArrowRight") return { x: clamp1(from.x + STEP), y: from.y };
+  if (key === "ArrowLeft") return { x: clamp1(from.x - STEP), y: from.y };
+  if (key === "ArrowUp") return { x: from.x, y: clamp1(from.y + STEP) };
+  if (key === "ArrowDown") return { x: from.x, y: clamp1(from.y - STEP) };
+  return null;
+};
+
+/** The next of the four poses after (or before) the nearest one to this light. */
+export const nextPose = (from: Light, way: 1 | -1): Light => {
+  let at = 0;
+  POSES.forEach((p, i) => {
+    if (Math.abs(p.x - from.x) < Math.abs(POSES[at].x - from.x)) at = i;
+  });
+  return POSES[Math.max(0, Math.min(POSES.length - 1, at + way))];
+};
+
+export type Reading = { beta: number; gamma: number };
+
+/* A tilt of 30° either way is a full swing; further is held there. */
+export const TILT_LIMIT = 30;
+
+/**
+ * A phone's tilt as light: left and right (gamma, upright) turn it, toward
+ * and away (beta, against how she held it when it began) tip it. Turned on
+ * its side, the two swap, as the screen does.
+ */
+export const tiltToLight = (r: Reading, rest: Reading, screenAngle = 0): Light => {
+  const db = r.beta - rest.beta;
+  const dg = r.gamma - rest.gamma;
+  const a = ((Math.round(screenAngle / 90) * 90) % 360 + 360) % 360;
+  const [across, tip] = a === 90 ? [db, -dg] : a === 270 ? [-db, dg] : a === 180 ? [-dg, -db] : [dg, db];
+  const clampDeg = (d: number) => Math.max(-TILT_LIMIT, Math.min(TILT_LIMIT, d)) / TILT_LIMIT;
+  return { x: clampDeg(across), y: -clampDeg(tip) };
+};
+
+/** One step of a low-pass filter: a reading's jitter smoothed away, its movement kept. */
+export const lowPass = (prev: Light, next: Light, k = 0.18): Light => ({ x: prev.x + (next.x - prev.x) * k, y: prev.y + (next.y - prev.y) * k });
+
+/* ── letting go ─────────────────────────────────────── */
+
+/** When she lets go, the light coasts a little and rests: always within this. */
+export const SETTLE_MS = 900;
+/* How far a flick carries: the drag's speed (light per ms) times this. */
+const COAST_MS = 160;
+
+/** Where the light comes to rest after she lets go, moving at `velocity` (light per ms across). */
+export const restingAfter = (from: Light, velocity: number): Light => ({ x: clamp1(from.x + Math.max(-0.4, Math.min(0.4, velocity * COAST_MS))), y: from.y });
+
+/** The light t ms into its settle from `from` to `to`: eased out, there by SETTLE_MS. */
+export const settleAt = (from: Light, to: Light, t: number): Light => {
+  const k = Math.max(0, Math.min(1, t / SETTLE_MS));
+  const e = 1 - Math.pow(1 - k, 3);
+  return { x: from.x + (to.x - from.x) * e, y: from.y + (to.y - from.y) * e };
+};
+
+/** The preview's scripted sweep (&tilt=sweep), for a capture with nobody's hand on it: across and back, then rest. */
+export const SWEEP_MS = 3600;
+export const sweepAt = (t: number): Light => {
+  const k = Math.max(0, Math.min(1, t / SWEEP_MS));
+  const fade = Math.pow(1 - k, 0.3);
+  const arrive = Math.pow(k, 4);
+  return { x: Math.sin(k * Math.PI * 2) * 0.95 * fade + REST.x * arrive, y: Math.sin(k * Math.PI * 3) * 0.35 * fade + REST.y * arrive };
+};
