+import { PETAL_HUE, PETAL_IDS } from "./PetalSymbols";
+import { EASE_IN, play, stillMotion } from "@/lib/portal/motion";
+import { clampCount, petalNode, settle, type PetalOptions } from "./petalFlight";
+
+/* At most 24 petals, removed as each lands (petalFlight.ts); the Doors' fall is PetalFall.ts. */
+export { MAX_PETALS } from "./petalFlight";
+
+/** A round burst that opens out and fades where it is: a bloom for something she did. */
+export const burstPetals = (layer: HTMLElement | null, x: number, y: number, options: PetalOptions = {}): Animation[] => {
+  if (!layer || stillMotion()) return [];
+  const count = clampCount(options.count, 18);
+  const spread = options.spread ?? 120;
+  const duration = options.duration ?? 820;
+  const ids = options.ids ?? PETAL_IDS;
+  const [sMin, sMax] = options.size ?? [9, 18];
+  const out: Animation[] = [];
+  for (let i = 0; i < count; i++) {
+    const id = ids[i % ids.length];
+    const svg = petalNode(layer, x, y, id, sMin + Math.random() * (sMax - sMin), id === PETAL_HUE ? options.color : undefined);
+    const angle = (i / count) * Math.PI * 2 + Math.random() * 0.5;
+    const dist = spread * (0.55 + Math.random() * 0.6);
+    const dx = Math.cos(angle) * dist;
+    const dy = Math.sin(angle) * dist * 0.8;
+    const turn = (Math.random() - 0.5) * 540;
+    const a = play(
+      svg,
+      [
+        { transform: "translate(-50%,-50%) translate(0,0) rotate(0deg) scale(.3)", opacity: 0, easing: "cubic-bezier(0.2, 0.7, 0.3, 1)" },
+        { transform: `translate(-50%,-50%) translate(${dx * 0.62}px,${dy * 0.62 - 18}px) rotate(${turn * 0.6}deg) scale(1)`, opacity: 1, offset: 0.4, easing: EASE_IN },
+        { transform: `translate(-50%,-50%) translate(${dx}px,${dy + 34}px) rotate(${turn}deg) scale(.85)`, opacity: 0 },
+      ],
+      { duration: duration * (0.8 + Math.random() * 0.35), delay: (options.delay ?? 0) + Math.random() * 60, easing: "linear", fill: "both" },
+    );
+    settle(svg, a, out);
+  }
+  return out;
+};
