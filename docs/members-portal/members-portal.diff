+import { useEffect, useRef, type CSSProperties } from "react";
+import { EASE_DRAWER, play, stillMotion } from "@/lib/portal/motion";
+import { MORE_PATHS, Tab } from "./PortalNav";
+
+/*
+  The garden path's second row (PortalNav's More): the rooms beyond its five
+  tabs. A chunk of its own, fetched once the bar has painted; it rises on
+  its first frame with transform and opacity only, as it did inside the bar.
+*/
+
+const FitIcon = () => (
