+  const lookRef = useRef<HTMLButtonElement>(null);
+  const preloadSky = useCallback(() => void StarSheet.preload(), []);
+  const lookUp = () => {
+    if (looking === "open") return document.getElementById("ig-stars")?.scrollIntoView?.({ block: "start", behavior: still ? "auto" : "smooth" });
