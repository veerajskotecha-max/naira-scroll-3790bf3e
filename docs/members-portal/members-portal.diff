+    const calls: string[] = [];
+    const store = {
+      byTokens: vi.fn(async () => (calls.push("tokens"), [])),
+      byEmail: vi.fn(async () => (calls.push("email"), [])),
+      byOwner: vi.fn(async () => (calls.push("owner"), [])),
