+              ))}
+            </g>
+            <path id={`${uid}h`} d={HEART} transform="translate(-10 -9.2) scale(.84)" />
+            <g id={`${uid}s`} fill="none" stroke={GOLD} strokeOpacity=".5" strokeWidth=".9">
+              <path d="M4 52C14 34 26 20 48 6" />
+              {[0, 1, 2, 3].map((i) => (
+                <ellipse key={i} cx={11 + i * 9.5} cy={42 - i * 9.5} rx="6" ry="2.8" transform={`rotate(${i % 2 ? -12 : -66} ${11 + i * 9.5} ${42 - i * 9.5})`} />
+              ))}
+            </g>
+          </defs>
+          <use href={`#${uid}s`} transform="translate(8 8) scale(1 -1) translate(0 -56)" />
+          <use href={`#${uid}s`} transform={`translate(${VIEW_W - 8} ${VIEW_H - 8}) rotate(180) scale(1 -1) translate(0 -56)`} />
+          <ellipse ref={poolRef} cx={VIEW_W / 2} cy="168" rx="150" ry="132" fill={`url(#${uid}p)`} style={{ transform: `translate(${REST.x * 46}px,${-REST.y * 24}px)` }} />
+          <g className="ig-sl-petals">
+            {plan.map((p, i) => {
+              const at = first.petals[i];
+              return (
+                <use
+                  key={i}
+                  ref={(el) => (petalRefs.current[i] = el)}
+                  href={`#${uid}${p.kind === "flower" ? "f" : "h"}`}
+                  fill={tones[p.tone]}
+                  style={{
+                    transform: `translate(${(at.x * VIEW_W).toFixed(1)}px,${(at.y * VIEW_H).toFixed(1)}px) rotate(${at.rot.toFixed(1)}deg) scale(${((p.size * VIEW_W) / 20).toFixed(3)})`,
+                    opacity: at.opacity.toFixed(3),
