+  type Reading,
+} from "@/lib/portal/stoneLight";
+import { motionOffered, startMotion, type MotionHandle } from "@/lib/portal/motionSensor";
+import { useCart } from "@/contexts/CartContext";
+import { whenIdle } from "@/lib/portal/lazyRoom";
+import { demoteTier, portalTier, probeWanted } from "@/lib/portal/tier";
+import { loadGemScene, type GemHandle } from "@/lib/portal/spectacle";
+import { EASE_REVEAL, play } from "@/lib/portal/motion";
+import { useMember } from "./MemberContext";
+import { HEART } from "./StoneArt";
+import { textLink } from "./styles";
+import "./stonelight.css";
+
+/*
+  HOLD IT TO THE LIGHT, on Your stone under the specimen card: her heart-cut
+  stone, large, in the month the room is showing, on an ink panel in a gold
+  double hairline. Its 33 facets (lib/portal/stoneLight) catch the light and
+  lose it as she drags across the panel, presses the arrow keys or the two
+  Turn buttons, or, after one tap on "Tilt your phone", tilts her phone; a
+  four-point glint slides across the table and up to 18 light petals skate
+  the other way across the ink. When she lets go the light coasts and rests
+  (900 ms), and nothing moves again until she does.
+
+  Only transform and opacity change: each facet's ivory overlay's opacity,
+  the glint's and each petal's transform. Everything stays inside the panel
+  (its overflow clipped), under the garden path and the bag. A vertical
+  swipe over it still scrolls the page (touch-action: pan-y).
+
+  Reduced motion and Data Saver: the stone in its best pose and the petals
+  in a still scatter at first paint; no drag, no tilt; the Turn buttons step
+  through four poses at once. The tilt's readings are never kept or sent.
+
+  Its own chunk, fetched as the section nears the screen, after the seed
+  ceremony; the month a chip shows recolours it in the same render as the
+  specimen card.
+
+  TIER 2, on a capable phone only (lib/portal/tier's gate; never under
+  reduced motion or Data Saver, when nothing of it is fetched): after the
+  room's paint, on idle, with the panel in view, the gem's scene
+  (lib/portal/gem/scene, through spectacle.ts's loadGemScene) turns in
+  unseen as its probe, then the drawn stone gives way to it in a 300 ms
+  crossfade; the light petals go on as they were. Its canvas covers the
+  heart's box only, in the panel (z-index 1, pointer-events none: the panel
+  takes the drag). It draws only on her input, pauses off screen, with the
+  tab hidden, after 20 s without her touch and while the bag is open, and is
+  put away (the context given back) on leaving the room or after 10 s
+  hidden. Too slow, lost or failed: put away at once, Tier 1 for the visit,
+  and the drawing stays.
+*/
+
+const HIDDEN_MAX_MS = 10_000;
+const FADE_MS = 300;
+
+const { w: VIEW_W, h: VIEW_H, scale: SCALE } = PANEL;
+/* The heart, about 220 px wide at 390, a little above the panel's middle. */
+const STONE_X = VIEW_W / 2 - CENTRE[0] * SCALE;
+const STONE_Y = PANEL.cy - HEART_BOX.h * 0.5 * SCALE;
+const IVORY = "#FFF8EE";
+const GOLD = "#C99A4C";
+const PALE_GOLD = "#E8C88A";
+const INK = "#1A1614";
+
+const plan = petalPlan();
+const FLOWER = [0, 72, 144, 216, 288].map((a) => `rotate(${a})`);
+const STAR = "M0-9L1.4-1.4L9 0L1.4 1.4L0 9L-1.4 1.4L-9 0L-1.4-1.4Z";
+
+const words = (x: number, y = 0) =>
+  `${x < -0.45 ? "Turned away to the left" : x < -0.1 ? "Turned a little to the left" : x <= 0.1 ? "Facing you" : x <= 0.45 ? "Turned a little to the right" : "Turned to the right"}${y > 0.3 ? ", tipped up" : y < -0.3 ? ", tipped down" : ""}`;
+
+type Tilt = "none" | "offer" | "asking" | "on" | "off";
+
+const screenAngle = () => {
+  try {
+    return screen.orientation?.angle ?? Number((window as Window & { orientation?: number }).orientation ?? 0);
+  } catch {
+    return 0;
+  }
+};
+
+type Props = { stone: Stone };
+
+const StoneLight = ({ stone }: Props) => {
+  const { garden } = useMember();
+  const uid = useId().replace(/:/g, "");
+  const [still] = useState(() => stillMotion());
+  const [tilt, setTilt] = useState<Tilt>(() => (!still && motionOffered() ? "offer" : "none"));
+  const panelRef = useRef<HTMLDivElement>(null);
+  const facetRefs = useRef<(SVGPolygonElement | null)[]>([]);
+  const petalRefs = useRef<(SVGUseElement | null)[]>([]);
+  const glintRef = useRef<SVGGElement>(null);
+  const poolRef = useRef<SVGEllipseElement>(null);
+  const shown = useRef<Light>(REST);
+  const raf = useRef(0);
+  const drag = useRef<{ x0: number; y0: number; id: number; from: Light; moved: boolean; lastX: number; lastT: number; v: number } | null>(null);
+  const sensor = useRef<MotionHandle | null>(null);
+  const tiltBase = useRef<{ rest: Reading; from: Light } | null>(null);
+  const woke = useRef(0);
+  const filtered = useRef<Light>(REST);
+  const stoneRef = useRef<SVGGElement>(null);
+  const gem = useRef<GemHandle | null>(null);
+  const [gemOn, setGemOn] = useState(false);
+  const bagOpen = useCart().isDrawerOpen;
+
+  const first = useMemo(() => ({ facets: facetOpacities(REST), glint: glintAt(REST), petals: plan.map((p) => petalPose(p, REST)) }), []);
+  const { facets, pavilion, claws, table } = cut();
+  const edges = useMemo(() => facets.filter((f) => f.kind !== "table").map((f) => `M${pointsAttr(f.points).replace(/ /g, "L")}Z`).join(""), [facets]);
+  const dark = mixHex(stone.hue, INK, 0.5);
+  // The petals of light: lit versions of the stone's colour (its raw hue on ink reads as maroon dust), its tint, ivory and pale gold.
+  const tones = [mixHex(stone.hue, IVORY, 0.35), stone.tint, IVORY, PALE_GOLD];
+
+  /* The drawing at this light: opacity and transform only, straight onto the elements (no render). */
+  const apply = (l: Light) => {
+    shown.current = l;
+    gem.current?.setLight(l);
+    const lit = facetOpacities(l);
+    facetRefs.current.forEach((el, i) => {
+      if (el) el.style.opacity = lit[i].toFixed(3);
+    });
+    const g = glintAt(l);
+    if (glintRef.current) {
+      glintRef.current.style.transform = `translate(${g.x.toFixed(3)}px,${g.y.toFixed(3)}px) scale(${(g.scale * 0.2).toFixed(3)})`;
+      glintRef.current.style.opacity = g.opacity.toFixed(3);
+    }
+    if (poolRef.current) poolRef.current.style.transform = `translate(${(clamp1(l.x) * 46).toFixed(1)}px,${(-clamp1(l.y) * 24).toFixed(1)}px)`;
+    // The petals keep their still scatter under reduced motion.
+    if (still) return;
+    plan.forEach((p, i) => {
+      const el = petalRefs.current[i];
+      if (!el) return;
+      const at = petalPose(p, l);
+      el.style.transform = `translate(${(at.x * VIEW_W).toFixed(1)}px,${(at.y * VIEW_H).toFixed(1)}px) rotate(${at.rot.toFixed(1)}deg) scale(${((p.size * VIEW_W) / 20).toFixed(3)})`;
+      el.style.opacity = at.opacity.toFixed(3);
+    });
+  };
+
+  const stopFrames = () => {
+    cancelAnimationFrame(raf.current);
+    raf.current = 0;
+  };
+  const announce = () => {
+    const el = panelRef.current;
+    if (!el) return;
+    el.setAttribute("aria-valuenow", String(Math.round(shown.current.x * 100)));
+    el.setAttribute("aria-valuetext", words(shown.current.x, shown.current.y));
+  };
+
+  /* One frame for the latest input (a drag's moves come faster than frames). */
+  const pending = useRef<Light | null>(null);
+  const follow = (l: Light) => {
+    pending.current = l;
+    if (raf.current) return;
+    raf.current = requestAnimationFrame(() => {
+      raf.current = 0;
+      if (pending.current) apply(pending.current);
+      pending.current = null;
+    });
+  };
+
+  /* To a new light: eased, within SETTLE_MS, then no frame is asked for until the next input. At once under reduced motion. */
+  const ease = (to: Light, ms = SETTLE_MS, path?: (t: number) => Light) => {
+    stopFrames();
+    if (still) {
+      apply(to);
+      announce();
+      return;
+    }
+    const from = shown.current;
+    let t0 = 0;
+    const step = (now: number) => {
+      t0 ||= now;
+      const t = now - t0;
+      apply(path ? path(t) : settleAt(from, to, (t * SETTLE_MS) / ms));
+      if (t < ms) raf.current = requestAnimationFrame(step);
+      else {
+        raf.current = 0;
+        announce();
+      }
+    };
+    raf.current = requestAnimationFrame(step);
+  };
+
+  useEffect(() => stopFrames, []);
+
+  // The development preview's scripted sweep (&tilt=sweep), for captures with nobody's hand on it.
+  const sweep = import.meta.env.DEV && garden?.tilt === "sweep";
+  useEffect(() => {
+    if (!sweep || still) return;
+    const timer = window.setTimeout(() => ease(REST, SWEEP_MS, sweepAt), 700);
+    return () => window.clearTimeout(timer);
+    // Once, as it shows.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [sweep]);
+
+  /* Tier 2: the gem, with the panel in view (nothing is fetched before), then on idle, so neither the fetch nor the
+     mount is a long task in the middle of her scroll. Put away after 10 s with the tab hidden, it is claimed again
+     when she comes back (while the phone is still Tier 2). */
+  const colours = useRef({ hue: stone.hue, tint: stone.tint });
+  colours.current = { hue: stone.hue, tint: stone.tint };
+  useEffect(() => {
+    if (still || portalTier() !== 2) return;
+    let cancelled = false;
+    let canvas: HTMLCanvasElement | null = null;
+    let io: IntersectionObserver | null = null;
+    let hiddenFor = 0;
+    let parked = false;
+    let cancelIdle = () => {};
+    const fades: (Animation | null)[] = [];
+    const putAway = () => {
+      io?.disconnect();
+      io = null;
+      cancelIdle();
+      window.clearTimeout(hiddenFor);
+      gem.current?.dispose();
+      gem.current = null;
+      fades.splice(0).forEach((a) => a?.cancel());
+      if (stoneRef.current) stoneRef.current.style.opacity = "";
+      canvas?.remove();
+      canvas = null;
+      if (!cancelled) setGemOn(false);
+    };
+    function onVisibility() {
+      window.clearTimeout(hiddenFor);
+      if (document.visibilityState === "hidden") {
+        hiddenFor = window.setTimeout(() => {
+          if (!gem.current) return;
+          putAway();
+          parked = true;
+        }, HIDDEN_MAX_MS);
+      } else if (parked && !cancelled && portalTier() === 2) {
+        parked = false;
+        watch();
+      }
+    }
+    const mount = (mod: NonNullable<Awaited<ReturnType<typeof loadGemScene>>>) => {
+      const panel = panelRef.current;
+      if (cancelled || !panel || gem.current) return;
+      canvas = document.createElement("canvas");
+      canvas.className = "ig-sl-gem";
+      canvas.setAttribute("aria-hidden", "true");
+      panel.appendChild(canvas);
+      try {
+        gem.current = mod.mountGem(canvas, {
+          ...colours.current,
+          light: shown.current,
+          probe: probeWanted(),
+          onReady: () => {
+            // The drawn stone gives way; the petals stay as they are.
+            const out = play(stoneRef.current, [{ opacity: 1 }, { opacity: 0 }], { duration: FADE_MS, easing: EASE_REVEAL, fill: "forwards" });
+            const into = play(canvas, [{ opacity: 0 }, { opacity: 1 }], { duration: FADE_MS, easing: EASE_REVEAL, fill: "forwards" });
+            fades.push(out, into);
+            // A browser without animations: the swap is made at once, never a live gem left at opacity 0.
+            if (!out || !into) {
+              if (stoneRef.current) stoneRef.current.style.opacity = "0";
+              if (canvas) canvas.style.opacity = "1";
+            }
+          },
+          onEnd: () => {
+            // Too slow for this phone, or the context was lost: the drawing stays, and Tier 1 for the visit.
+            demoteTier();
+            putAway();
+          },
+        });
+      } catch {
+        // A browser with WebGL that cannot make a context, or the one portal scene's slot is taken: the drawing stays.
+        demoteTier();
+        putAway();
+        return;
+      }
+      setGemOn(true);
+    };
+    const begin = () => {
+      cancelIdle = whenIdle(() => {
+        void loadGemScene().then((mod) => {
+          if (!cancelled && mod) mount(mod);
+        });
+      });
+    };
+    // In view first (a little before it arrives): nothing of the gem is fetched for a panel she never scrolls to.
+    const watch = () => {
+      const panel = panelRef.current;
+      if (!panel || typeof IntersectionObserver === "undefined") return begin();
+      io = new IntersectionObserver(
+        ([entry]) => {
+          if (!entry.isIntersecting) return;
+          io?.disconnect();
+          io = null;
+          begin();
+        },
+        { threshold: 0.2, rootMargin: "0px 0px 25% 0px" },
+      );
+      io.observe(panel);
+    };
