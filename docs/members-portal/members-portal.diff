+
+  it("reads each price as the live shop gives it, and leaves out what is sold out or over", () => {
+    const one = catalogue.find((p) => p.category === "Necklaces") as JewelPiece;
+    const live = [
+      { ...one, handle: "a", price: 1500, availableForSale: true },
+      { ...one, handle: "b", price: 1501, availableForSale: true },
+      { ...one, handle: "c", price: 900, availableForSale: false },
+      { ...one, handle: "d", price: 400, availableForSale: true },
+    ];
+    expect(picksWithin(live, true, 1500).map((p) => p.handle)).toEqual(["a", "d"]);
+    // The price the card would show (a variant's), not the listing's, decides.
+    expect(picksWithin(live, true, 1500, { priceOf: (p) => (p.handle === "a" ? 1600 : p.price) }).map((p) => p.handle)).toEqual(["d"]);
+  });
+
+  it("turns the list for each date, so two dates with one band differ", () => {
+    const a = picksWithin(catalogue, true, 1500, { seed: 0 }).map((p) => p.handle);
+    const b = picksWithin(catalogue, true, 1500, { seed: 1 }).map((p) => p.handle);
+    expect(a).not.toEqual(b);
+  });
+});
+
+describe("her account's memory with a full ledger", () => {
+  /* Phase 3 at its most: 24 pressed drops with the longest id allowed (20),
+     the six newest Front Row, a ring, a metal, a month and a visit day; 24
+     saved handles of 31 characters; and eight dates whose names are each 12
