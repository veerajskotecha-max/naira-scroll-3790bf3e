--- /dev/null
+++ b/src/lib/portal/preview.ts
@@ -0,0 +1,192 @@
+import type { User } from "@supabase/supabase-js";
+import type { MemberProfile } from "@/contexts/AuthContext";
+import { PORTAL_KEY, safeRemove } from "./safeStorage";
+import { readPreviewDrops, type PreviewDrops } from "./previewDrops";
+import type { Checkout } from "./checkouts";
+import { readPreviewGarden } from "./previewGarden";
+import { forceTier } from "./tier";
+import type { GardenOverrides } from "@/components/portal/MemberContext";
+
+/*
+  DEVELOPMENT ONLY. A stand-in member so the portal can be seen signed in
+  without creating an account or touching the live Supabase or Shopify:
+
+    /members?portalPreview=1&name=Ananya&birthday=1999-07-14
+
+  MembersRoute reaches this only behind `import.meta.env.DEV` (and only on
+  localhost), which Vite
+  replaces with false in a production build, so the build drops this module
+  (the build check greps dist for its query name). Every write the preview
+  would make is logged to the console instead.
+
+  Extra switches: joined=2026-11-04 (the planted date), reset=1 (forget this
+  device's Doors, seed-ceremony, unboxing, reveal and pressed flags, to see
+  them again), and drop=sealed|moved|members|public|arriving|vault for a
+  preview drop in each state (see previewDrops.ts).
+
+  Her account's memory (user_metadata.naira, Phase 3), to see each room in
+  each state: ring=6 (her size, as she knew it), metal=g|s|b, month=7 (her month alone),
+  saved=woven-gold-hoops,star-point-band (saved handles), seen=2026-10-20
+  (the day she was last here), front=<drop id> (a Front Row keepsake). Her
+  changes then live in memory and are printed to the console.
+
+  Phase 4's rooms: gifts=Mum:03-14:1500,Didi:12-02:1000 (her gift dates:
+  a name, the month and day, a band of 1000, 1500 or 2500), or gifts=8 for
+  a full ledger of eight with the longest names; checkouts=1 for two
+  stand-in checkouts on the Order Desk and in Care (real listings' names,
+  never a real member's rows). Without it the preview member has none, and
+  Supabase is never asked.
+
+  Phase 5's confirmed orders: orders=1 for two stand-in rows the shop's
+  webhook would have confirmed (status 'completed', each with its order's
+  own time): the Order Desk lists them under "Orders" and a gold-leaf rose
+  grows for each in the garden's front row. With checkouts=1 as well, the
+  two unconfirmed checkouts stay under "Checkouts you started".
+
+  The garden's hours, dressings and notes (Phase 4; see previewGarden.ts):
+  hour=dawn|day|golden|night, season=diwali|monsoon|holi, note=1.
+
+  Phase 5's spectacle (lib/portal/tier): tier=1 keeps this machine on
+  Tier 1, tier=2 gives it Tier 2 whatever its memory, connection or WebGL
+  say (never past reduced motion or Data Saver), and probe=0 lets the
+  Bloom Field run past its 60-frame probe, for a software-GL machine whose
+  frames say nothing about a phone's.
+
+  Phase 6's play (her account's one play number, naira.p; see petals.ts):
+  hunt=0..5 sets the lowest N of the Naira flower's five pieces as found
+  (Drops, the Drawer, Your fit, Gifts, Care, in that order; hunt=5 is the
+  whole flower, edged in gold leaf), and stars=1 has her month's flower
+  already written in her garden's stars. Use them with hour=night|day and
+  month=7 (or birthday=1999-07-14): /members?portalPreview=1&hunt=2,
+  /members?portalPreview=1&hour=night&month=7&stars=1.
+*/
+
+export type PreviewMember = {
+  user: User;
+  profile: MemberProfile;
+  drops: PreviewDrops | null;
+  checkouts: Checkout[] | null;
+  garden: GardenOverrides | null;
+};
+
+/* A full ledger: eight dates, every name as long as it may be, across the year (and two on one day). */
+const FULL_LEDGER = [
+  "01011Maa's friend",
+  "02292Leap-yr Isha",
+  "03140Mum and Papa",
+  "06301Riya's 30th!",
+  "10052Anniversary",
+  "11120Didi (Pune)",
+  "11121Jiju & Didi",
+  "12312Nani ke liye",
+];
+
+const previewGifts = (raw: string | null): string[] => {
+  if (!raw) return [];
+  if (raw === "8") return [...FULL_LEDGER];
+  return raw
+    .split(",")
+    .map((part) => /^(.{1,12}):(\d{2})-(\d{2}):(1000|1500|2500)$/.exec(part.trim()))
+    .filter((m): m is RegExpExecArray => m !== null)
+    .map((m) => `${m[2]}${m[3]}${["1000", "1500", "2500"].indexOf(m[4])}${m[1]}`);
+};
+
+/* Two checkouts started, a week apart: names of real listings, so Care can find their care lines.
+   Without the switch, none at all (an empty list, never null): the Order Desk shows its own empty
+   line, and the live Supabase is never asked about the stand-in member. */
+const previewCheckouts = (on: boolean): Checkout[] =>
+  on
+    ? [
+        { id: "preview-checkout-2", createdAt: "2026-11-03T14:10:00Z", items: [{ name: "Birthstone Heart Necklace", quantity: 1, size: null }] },
+        {
+          id: "preview-checkout-1",
+          createdAt: "2026-10-27T09:40:00Z",
+          items: [
+            { name: "Toggle Link Chain", quantity: 1, size: null },
+            { name: "Verdant Drop Earrings", quantity: 1, size: null },
+          ],
+        },
+      ]
+    : [];
+
+/* Two orders the webhook confirmed: real listings' names, dated with their own orders' times. */
+const previewOrders = (on: boolean): Checkout[] =>
+  on
+    ? [
+        {
+          id: "preview-order-2",
+          createdAt: "2026-11-04T12:20:00Z",
+          confirmedAt: "2026-11-04T12:26:00Z",
+          items: [{ name: "Woven Gold Hoops", quantity: 1, size: null }],
+        },
+        {
+          id: "preview-order-1",
+          createdAt: "2026-10-12T15:05:00Z",
+          confirmedAt: "2026-10-12T15:09:00Z",
+          items: [
+            { name: "Star Point Band", quantity: 1, size: "US 7" },
+            { name: "Prism Cluster Studs", quantity: 2, size: null },
+          ],
+        },
+      ]
+    : [];
+
+/** Only on this machine: a development build served anywhere else (an editor preview, `vite build --mode development`) never stands in a member. */
+export const previewHost = (hostname: string): boolean => /^(localhost|127\.0\.0\.1|\[::1\])$/.test(hostname);
+
+const DATE = /^\d{4}-\d{2}-\d{2}$/;
+
+export const readPreviewMember = (search: string): PreviewMember | null => {
+  const q = new URLSearchParams(search);
+  if (q.get("portalPreview") !== "1") return null;
+  if (q.get("reset") === "1") safeRemove(PORTAL_KEY);
+  const name = (q.get("name") ?? "Ananya").trim().slice(0, 40) || "Ananya";
+  const birthday = q.get("birthday") ?? "";
+  const joined = q.get("joined") ?? "";
+  const id = `preview-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-")}`;
+  const naira: Record<string, unknown> = { v: 1 };
+  const ring = Number(q.get("ring"));
+  if (ring >= 5 && ring <= 9) naira.ring = { us: ring, how: "k", at: "2026-11-04" };
+  if (/^[gsb]$/.test(q.get("metal") ?? "")) naira.metal = q.get("metal");
+  const month = Number(q.get("month"));
+  if (Number.isInteger(month) && month >= 1 && month <= 12) naira.month = month;
+  const handles = (q.get("saved") ?? "").split(",").map((h) => h.trim()).filter(Boolean);
+  if (handles.length) naira.saved = handles;
+  if (DATE.test(q.get("seen") ?? "")) naira.seen = { last: q.get("seen") };
+  const front = q.get("front");
+  if (front) Object.assign(naira, { pressed: [front], front: [front] });
+  const tier = q.get("tier");
+  forceTier(tier === "1" ? 1 : tier === "2" ? 2 : null, q.get("probe") !== "0");
+  const gifts = previewGifts(q.get("gifts"));
+  if (gifts.length) naira.gifts = gifts;
+  // Play: the lowest N pieces found (hunt=0..5), and her month's flower written in her sky (stars=1).
+  const hunt = Number(q.get("hunt"));
+  const play = (Number.isInteger(hunt) && hunt >= 1 && hunt <= 5 ? (1 << hunt) - 1 : 0) | (q.get("stars") === "1" ? 32 : 0);
+  if (play) naira.p = play;
+  const user = {
+    id,
+    aud: "authenticated",
+    email: `${id}@example.invalid`,
+    created_at: DATE.test(joined) ? `${joined}T10:00:00+05:30` : "2026-11-04T10:00:00+05:30",
+    app_metadata: {},
+    user_metadata: { full_name: name, naira },
+  } as unknown as User;
+  const profile: MemberProfile = {
+    id,
+    full_name: name,
+    phone: null,
+    birthday: DATE.test(birthday) ? birthday : null,
+    city: null,
+  };
+  return {
+    user,
+    profile,
+    drops: readPreviewDrops(search),
+    checkouts: [...previewOrders(q.get("orders") === "1"), ...previewCheckouts(q.get("checkouts") === "1")].sort((a, b) => Date.parse(b.createdAt) - Date.parse(a.createdAt)),
+    garden: readPreviewGarden(search),
+  };
+};
+
+export const logPreviewWrite = (what: string, detail: unknown) => {
+  console.info(`[portal preview] not written: ${what}`, detail);
+};
