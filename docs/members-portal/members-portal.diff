+    delete (document as unknown as Record<string, unknown>).visibilityState;
+  });
+
+  it("puts the gem away after 10 s with the tab hidden", async () => {
+    t2.tier = 2;
+    render(<StoneLight stone={july} />);
+    await idle();
+    const handle = t2.handle!;
