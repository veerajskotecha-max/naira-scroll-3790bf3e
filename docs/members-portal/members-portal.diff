+import { describe, expect, it } from "vitest";
+import { buildIcs, escapeIcsText, foldIcsLine, googleCalendarUrl, icsHref, utcStamp, type CalendarEvent } from "./ics";
+
+/* "Add to my calendar": the Google link must open Google's own add-event
+   page with the right instant, and the .ics must be a valid VEVENT at the
+   right UTC time, with text escaped and a reminder 30 minutes before. */
+
+const event: CalendarEvent = {
+  uid: "drop-verdant",
+  title: "Naira Flore: Verdant opens, a first look; in the garden",
+  start: "2026-11-21T20:00:00+05:30",
+  minutes: 60,
+  details: "Line one\nLine two, with a comma\\and a backslash",
+  url: "https://nairaflore.com/members/drops/verdant",
+};
+const stamp = Date.parse("2026-11-05T01:02:03Z");
+
+describe("the .ics", () => {
+  const ics = buildIcs(event, stamp);
+  const lines = ics.split("\r\n");
+
+  it("is a calendar with one VEVENT, in CRLF lines", () => {
+    expect(ics.endsWith("\r\n")).toBe(true);
+    expect(ics.replace(/\r\n/g, "")).not.toMatch(/\n/);
+    expect(lines[0]).toBe("BEGIN:VCALENDAR");
+    expect(lines).toContain("VERSION:2.0");
+    expect(lines.filter((l) => l === "BEGIN:VEVENT")).toHaveLength(1);
+    expect(lines.filter((l) => l === "END:VEVENT")).toHaveLength(1);
+    expect(lines[lines.length - 2]).toBe("END:VCALENDAR");
+    expect(lines).toContain("UID:drop-verdant@nairaflore.com");
+    expect(lines).toContain("DTSTAMP:20261105T010203Z");
+  });
+
+  it("converts 8:00 pm IST to 14:30 UTC", () => {
+    expect(lines).toContain("DTSTART:20261121T143000Z");
+    expect(lines).toContain("DTEND:20261121T153000Z");
+    expect(utcStamp(Date.parse("2026-12-01T00:00:00+05:30"))).toBe("20261130T183000Z");
+  });
+
+  it("escapes commas, semicolons, backslashes and newlines", () => {
+    expect(escapeIcsText("a,b;c\\d\ne")).toBe("a\\,b\\;c\\\\d\\ne");
+    const unfolded = ics.replace(/\r\n /g, "");
+    expect(unfolded).toContain("SUMMARY:Naira Flore: Verdant opens\\, a first look\\; in the garden");
+    expect(unfolded).toContain("DESCRIPTION:Line one\\nLine two\\, with a comma\\\\and a backslash");
+  });
+
+  it("reminds her 30 minutes before", () => {
+    const alarm = lines.slice(lines.indexOf("BEGIN:VALARM"), lines.indexOf("END:VALARM") + 1);
+    expect(alarm).toContain("ACTION:DISPLAY");
+    expect(alarm).toContain("TRIGGER:-PT30M");
+    expect(lines.indexOf("BEGIN:VALARM")).toBeGreaterThan(lines.indexOf("BEGIN:VEVENT"));
+    expect(lines.indexOf("END:VALARM")).toBeLessThan(lines.indexOf("END:VEVENT"));
+  });
+
+  it("folds long lines at 75 octets without splitting a character", () => {
+    const long = `DESCRIPTION:${"₹ · ".repeat(40)}`;
+    const folded = foldIcsLine(long).split("\r\n");
+    expect(folded.length).toBeGreaterThan(1);
+    for (const part of folded) expect(new TextEncoder().encode(part).length).toBeLessThanOrEqual(75);
+    expect(folded.slice(1).every((p) => p.startsWith(" "))).toBe(true);
+    expect(folded.map((p, i) => (i ? p.slice(1) : p)).join("")).toBe(long);
+    for (const l of lines) expect(new TextEncoder().encode(l).length).toBeLessThanOrEqual(75);
+  });
+
+  it("can be opened as a link", () => {
+    expect(icsHref(event, stamp).startsWith("data:text/calendar;charset=utf-8,BEGIN%3AVCALENDAR")).toBe(true);
+  });
+});
+
+describe("the Google Calendar link", () => {
+  it("opens Google's add-event page at the same instant", () => {
+    const url = new URL(googleCalendarUrl(event));
+    expect(url.origin + url.pathname).toBe("https://calendar.google.com/calendar/render");
+    expect(url.searchParams.get("action")).toBe("TEMPLATE");
+    expect(url.searchParams.get("text")).toBe(event.title);
+    expect(url.searchParams.get("dates")).toBe("20261121T143000Z/20261121T153000Z");
+    expect(url.searchParams.get("ctz")).toBe("Asia/Kolkata");
+    expect(url.searchParams.get("details")).toContain("https://nairaflore.com/members/drops/verdant");
+  });
+});
diff --git a/src/lib/portal/ics.ts b/src/lib/portal/ics.ts
new file mode 100644
index 0000000..491be96
--- /dev/null
+++ b/src/lib/portal/ics.ts
@@ -0,0 +1,129 @@
+/*
+  "Add to my calendar". A Google Calendar template link comes first: it is an
+  ordinary link, so it works inside Instagram's in-app browser, where a file
+  download goes nowhere. The .ics file is the second way, for Apple Calendar
+  and Outlook, with a reminder 30 minutes before.
+
+  Times are written in UTC (…Z), converted from the owner's +05:30, so every
+  calendar shows the opening in its own zone without needing IST's zone data.
+  Text is escaped as RFC 5545 asks (backslash, semicolon, comma, newline) and
+  long lines are folded at 75 octets without splitting a character.
+
+  The gift ledger (Phase 4) adds a yearly day: an all-day event (DATE
+  values, so it falls on her day whatever the zone), repeating every year
+  (RRULE), with its own alarm (a week before). The drops' events are
+  written exactly as before.
+*/
+
+export type CalendarEvent = {
+  /** Stable for the drop, so adding it twice updates one event. */
+  uid: string;
+  title: string;
+  /** ISO start time (the drop's membersFrom). */
+  start: string;
+  minutes?: number;
+  details?: string;
+  url?: string;
+  /** An all-day event: `start` is its first day, "2027-03-14". */
+  allDay?: boolean;
+  /** A repeat rule, as RRULE writes it ("FREQ=YEARLY"). */
+  repeat?: string;
+  /** The alarm, as a TRIGGER duration before the start ("-P7D"); 30 minutes when absent. */
+  alarm?: string;
+};
+
+export const REMINDER_MINUTES = 30;
+const DOMAIN = "nairaflore.com";
+
+/** "20261121T143000Z" */
+export const utcStamp = (ms: number): string => new Date(ms).toISOString().replace(/\.\d{3}Z$/, "Z").replace(/[-:]/g, "");
+
+const span = (event: CalendarEvent) => {
+  const start = Date.parse(event.start);
+  return { start, end: start + (event.minutes ?? 60) * 60_000 };
+};
+
+/** "20270314" for an all-day event's day, and the day after it (where the event ends, as DTEND counts). */
+const daySpan = (day: string) => {
+  const start = Date.parse(`${day}T00:00:00Z`);
+  const stamp = (ms: number) => new Date(ms).toISOString().slice(0, 10).replace(/-/g, "");
+  return { start: stamp(start), end: stamp(start + 86_400_000) };
+};
+
+export const escapeIcsText = (text: string): string =>
+  text.replace(/\\/g, "\\\\").replace(/;/g, "\\;").replace(/,/g, "\\,").replace(/\r?\n/g, "\\n");
+
+const octets = (ch: string) => {
+  const c = ch.codePointAt(0) ?? 0;
+  return c < 0x80 ? 1 : c < 0x800 ? 2 : c < 0x10000 ? 3 : 4;
+};
+
+/** Folds one content line at 75 octets (continuations begin with a space). */
+export const foldIcsLine = (line: string): string => {
+  const parts: string[] = [];
+  let current = "";
+  let size = 0;
+  for (const ch of line) {
+    const n = octets(ch);
+    const limit = parts.length ? 74 : 75; // a continuation's leading space counts
+    if (size + n > limit) {
+      parts.push(current);
+      current = "";
+      size = 0;
+    }
+    current += ch;
+    size += n;
+  }
+  parts.push(current);
+  return parts.join("\r\n ");
+};
+
+const whenLines = (event: CalendarEvent): string[] => {
+  if (event.allDay) {
+    const { start, end } = daySpan(event.start);
+    return [`DTSTART;VALUE=DATE:${start}`, `DTEND;VALUE=DATE:${end}`];
+  }
+  const { start, end } = span(event);
+  return [`DTSTART:${utcStamp(start)}`, `DTEND:${utcStamp(end)}`];
+};
+
+export const buildIcs = (event: CalendarEvent, stampMs: number = Date.now()): string => {
+  const lines = [
+    "BEGIN:VCALENDAR",
+    "VERSION:2.0",
+    "PRODID:-//Naira Flore//The Inner Garden//EN",
+    "CALSCALE:GREGORIAN",
+    "METHOD:PUBLISH",
+    "BEGIN:VEVENT",
+    `UID:${event.uid}@${DOMAIN}`,
+    `DTSTAMP:${utcStamp(stampMs)}`,
+    ...whenLines(event),
+    ...(event.repeat ? [`RRULE:${event.repeat}`] : []),
+    `SUMMARY:${escapeIcsText(event.title)}`,
+    ...(event.details ? [`DESCRIPTION:${escapeIcsText(event.details)}`] : []),
+    ...(event.url ? [`URL:${event.url}`] : []),
+    "BEGIN:VALARM",
+    "ACTION:DISPLAY",
+    `DESCRIPTION:${escapeIcsText(event.title)}`,
+    `TRIGGER:${event.alarm ?? `-PT${REMINDER_MINUTES}M`}`,
+    "END:VALARM",
+    "END:VEVENT",
+    "END:VCALENDAR",
+  ];
+  return `${lines.map(foldIcsLine).join("\r\n")}\r\n`;
+};
+
+/** The .ics as a link a phone can open or save. */
+export const icsHref = (event: CalendarEvent, stampMs?: number): string =>
+  `data:text/calendar;charset=utf-8,${encodeURIComponent(buildIcs(event, stampMs))}`;
+
+export const googleCalendarUrl = (event: CalendarEvent): string => {
+  const { start, end } = span(event);
+  const days = event.allDay ? daySpan(event.start) : null;
+  const details = [event.details, event.url].filter(Boolean).join("\n\n");
+  const q = new URLSearchParams({ action: "TEMPLATE", text: event.title, dates: days ? `${days.start}/${days.end}` : `${utcStamp(start)}/${utcStamp(end)}`, ctz: "Asia/Kolkata" });
+  if (details) q.set("details", details);
+  // Google's add-event page takes the repeat rule, but no alarm: a reminder there is an event of its own, on the day she wants reminding.
+  if (event.repeat) q.set("recur", `RRULE:${event.repeat}`);
+  return `https://calendar.google.com/calendar/render?${q.toString()}`;
+};
