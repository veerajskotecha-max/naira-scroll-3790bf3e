+++ b/src/components/portal/DropUnbox.test.tsx
@@ -0,0 +1,212 @@
+import { act, cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import type { Drop } from "@/lib/portal/drops";
+import { MAX_BURST } from "@/lib/portal/petalPaths";
+
+/* The unboxing with Tier 2 joined to it, and without: the Bloom Field rides
+   with the ritual only on a Tier 2 phone and goes with a Skip; the petals
+   are thrown by the gsap choreography when it is in, and on today's arcs
+   when it is not, or when it declines (reduced motion turned on). Either
+   way the same 24 petals, from the same drawer, at the same moment. On
+   Tier 2 the opening holds its first move (the stage still) until the
+   field says it is prepared, for at most FIELD_WAIT_MS; the bag opening
+   ends the fall. */
+
+const tier2 = vi.hoisted(() => ({
+  allowed: true,
+  choreo: null as null | { physicsThrows: ReturnType<typeof vi.fn>; throwPetals: ReturnType<typeof vi.fn> },
+}));
+vi.mock("@/lib/portal/spectacle", () => ({
+  spectacleAllowed: () => tier2.allowed,
+  choreographyNow: () => tier2.choreo,
+}));
+type FieldProps = { accent: string; seed: string; stop: boolean; go: { current: () => void }; onReady: () => void; onGone: () => void };
+const field = vi.hoisted(() => ({ props: [] as FieldProps[], autoReady: true, readied: false, went: 0 }));
+vi.mock("./BloomField", () => ({
+  FIELD_WAIT_MS: 900,
+  default: (props: FieldProps) => {
+    field.props.push(props);
+    props.go.current = () => void (field.went += 1);
+    // Prepared at once, unless a test holds it.
+    if (field.autoReady && !field.readied) {
+      field.readied = true;
+      queueMicrotask(props.onReady);
+    }
+    return null;
+  },
+}));
+const bag = vi.hoisted(() => ({ open: false }));
+vi.mock("@/contexts/CartContext", () => ({ useCart: () => ({ isDrawerOpen: bag.open }) }));
+
+import DropUnbox from "./DropUnbox";
+
+const drop: Drop = {
+  id: "verdant",
+  title: "Verdant",
+  species: "teal bud",
+  accent: "#2F6B4F",
+  story: ["Green, like a garden after rain."],
+  membersFrom: "2026-11-21T20:00:00+05:30",
+  everyoneFrom: "2026-11-23T20:00:00+05:30",
+  handles: ["birthstone-heart-necklace"],
+  leadHandle: "birthstone-heart-necklace",
+};
+
+/* WAAPI in jsdom: each animation finishes on the (fake) clock. */
+const made: { el: Element; delay: number }[] = [];
+const animate = function (this: Element, _k: Keyframe[], o?: number | KeyframeAnimationOptions): Animation {
+  const opts = typeof o === "number" ? { duration: o } : (o ?? {});
+  made.push({ el: this, delay: Number(opts.delay ?? 0) });
+  const total = Number(opts.delay ?? 0) + Number(opts.duration ?? 0);
+  const a = { onfinish: null as null | (() => void), oncancel: null as null | (() => void), cancel: () => window.clearTimeout(t), play() {}, pause() {}, finish() {} };
+  const t = window.setTimeout(() => a.onfinish?.(), total);
+  return a as unknown as Animation;
+};
+
+const throwsFor = (n: number) => Array.from({ length: n }, (_, i) => ({ size: 12, tone: (i % 2) as 0 | 1 }));
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  Element.prototype.animate = animate as never;
+  made.length = 0;
+  field.props.length = 0;
+  field.autoReady = true;
+  field.readied = false;
+  field.went = 0;
+  bag.open = false;
+  tier2.allowed = true;
+  tier2.choreo = null;
+  window.matchMedia = ((query: string) => ({ matches: false, media: query, addEventListener() {}, removeEventListener() {} })) as unknown as typeof window.matchMedia;
+});
+afterEach(() => {
+  cleanup();
+  vi.useRealTimers();
+  delete (Element.prototype as Partial<Element>).animate;
+});
+
+const open = async () => {
+  const onUnfold = vi.fn();
+  const view = render(<DropUnbox drop={drop} piece={{ src: "https://cdn.shopify.com/x.jpg", cutout: false }} ritual onUnfold={onUnfold} />);
+  // Once the page has settled (at most 320 ms), everything is made at once.
+  await act(async () => void vi.advanceTimersByTime(400));
+  await act(async () => {
+    for (let i = 0; i < 5; i++) await Promise.resolve();
+  });
+  return { ...view, onUnfold };
+};
+
+describe("the unboxing on a Tier 2 phone", () => {
+  it("lays the Bloom Field over the ritual, and lets it go with a Skip", async () => {
+    await open();
+    expect(field.props.at(-1)).toMatchObject({ accent: "#2F6B4F", seed: "verdant", stop: false });
+    expect(field.went).toBe(1);
+    fireEvent.click(screen.getByRole("button", { name: "Skip" }));
+    expect(field.props.at(-1)).toMatchObject({ stop: true });
+  });
+
+  it("holds its first move, the stage still, until the field is prepared, then opens with the fall", async () => {
+    field.autoReady = false;
+    render(<DropUnbox drop={drop} piece={{ src: "https://cdn.shopify.com/x.jpg", cutout: false }} ritual onUnfold={vi.fn()} />);
+    await act(async () => void vi.advanceTimersByTime(600));
+    // Nothing made yet: the field is still preparing, and the fall has not been told to go.
+    expect(made.filter((m) => m.el.closest?.(".ig-unbox"))).toHaveLength(0);
+    expect(field.went).toBe(0);
+    await act(async () => {
+      field.props.at(-1)!.onReady();
+      for (let i = 0; i < 5; i++) await Promise.resolve();
+    });
+    expect(made.filter((m) => m.el.closest?.(".ig-unbox")).length).toBeGreaterThan(5);
+    expect(field.went).toBe(1);
+  });
+
+  it("waits no more than FIELD_WAIT_MS for the field, then opens without waiting further", async () => {
+    field.autoReady = false;
+    render(<DropUnbox drop={drop} piece={{ src: "https://cdn.shopify.com/x.jpg", cutout: false }} ritual onUnfold={vi.fn()} />);
+    await act(async () => void vi.advanceTimersByTime(850));
+    expect(made.filter((m) => m.el.closest?.(".ig-unbox"))).toHaveLength(0);
+    await act(async () => {
+      vi.advanceTimersByTime(100);
+      for (let i = 0; i < 5; i++) await Promise.resolve();
+    });
+    expect(made.filter((m) => m.el.closest?.(".ig-unbox")).length).toBeGreaterThan(5);
+    // Told to go, in the same task: the field, not ready, puts itself away rather than start mid-opening.
+    expect(field.went).toBe(1);
+  });
+
+  it("ends the fall when the bag opens over it", async () => {
+    const view = await open();
+    expect(field.props.at(-1)?.stop).toBe(false);
+    bag.open = true;
+    view.rerender(<DropUnbox drop={drop} piece={{ src: "https://cdn.shopify.com/x.jpg", cutout: false }} ritual onUnfold={view.onUnfold} />);
+    await act(async () => void (await Promise.resolve()));
+    expect(field.props.at(-1)?.stop).toBe(true);
+  });
+
+  it("moves her focus on to the pieces when she skips", async () => {
+    const heading = document.createElement("h2");
+    heading.id = "ig-pieces";
+    heading.tabIndex = -1;
+    document.body.appendChild(heading);
+    try {
+      await open();
+      fireEvent.click(screen.getByRole("button", { name: "Skip" }));
+      expect(document.activeElement).toBe(heading);
+    } finally {
+      heading.remove();
+    }
+  });
+
+  it("throws the petals with the choreography when it is in: 24, from the drawer, at the burst", async () => {
+    tier2.choreo = { physicsThrows: vi.fn(() => throwsFor(MAX_BURST)), throwPetals: vi.fn(() => () => {}) };
+    const { container } = await open();
+    expect(tier2.choreo.physicsThrows).toHaveBeenCalledWith(MAX_BURST, expect.objectContaining({ seed: "verdant" }));
+    expect(tier2.choreo.throwPetals).toHaveBeenCalledTimes(1);
+    const [nodes, , startMs] = tier2.choreo.throwPetals.mock.calls[0];
+    expect(nodes).toHaveLength(MAX_BURST);
+    expect(container.querySelectorAll(".ig-unbox-petals .ig-petal")).toHaveLength(MAX_BURST);
+    expect(startMs).toBeGreaterThan(2000);
+    // Not on today's arcs as well.
+    expect(made.filter((m) => m.el.classList?.contains("ig-petal"))).toHaveLength(0);
+  });
+
+  it("falls back to today's arcs when the choreography declines", async () => {
+    tier2.choreo = { physicsThrows: vi.fn(() => throwsFor(MAX_BURST)), throwPetals: vi.fn(() => null) };
+    const { container } = await open();
+    expect(tier2.choreo.throwPetals).toHaveBeenCalledTimes(1);
+    expect(container.querySelectorAll(".ig-unbox-petals .ig-petal")).toHaveLength(MAX_BURST);
+    expect(made.filter((m) => m.el.classList?.contains("ig-petal"))).toHaveLength(MAX_BURST);
+  });
+});
+
+describe("the unboxing on a Tier 2 phone, its choreography still on its way", () => {
+  it("makes the petals as ever, and lets the choreography throw them if it is in just before the burst", async () => {
+    const { container } = await open();
+    expect(container.querySelectorAll(".ig-unbox-petals .ig-petal")).toHaveLength(MAX_BURST);
+    expect(made.filter((m) => m.el.classList?.contains("ig-petal"))).toHaveLength(0);
+    tier2.choreo = { physicsThrows: vi.fn(() => throwsFor(MAX_BURST)), throwPetals: vi.fn(() => () => {}) };
+    await act(async () => void vi.advanceTimersByTime(2400));
+    expect(tier2.choreo.throwPetals).toHaveBeenCalledTimes(1);
+    const [nodes, , lead] = tier2.choreo.throwPetals.mock.calls[0];
+    expect(nodes).toHaveLength(MAX_BURST);
+    expect(lead).toBe(200);
+    expect(container.querySelectorAll(".ig-unbox-petals .ig-petal")).toHaveLength(MAX_BURST);
+    expect(made.filter((m) => m.el.classList?.contains("ig-petal"))).toHaveLength(0);
+  });
+
+  it("throws them on today's arcs if it has still not arrived", async () => {
+    const { container } = await open();
+    await act(async () => void vi.advanceTimersByTime(2400));
+    expect(container.querySelectorAll(".ig-unbox-petals .ig-petal")).toHaveLength(MAX_BURST);
+    expect(made.filter((m) => m.el.classList?.contains("ig-petal"))).toHaveLength(MAX_BURST);
+  });
+});
+
+describe("the unboxing on Tier 1", () => {
+  it("is today's: no Bloom Field, the petals on their worked-out arcs", async () => {
+    tier2.allowed = false;
+    const { container } = await open();
+    expect(field.props).toHaveLength(0);
+    expect(container.querySelectorAll(".ig-unbox-petals .ig-petal")).toHaveLength(MAX_BURST);
+    expect(made.filter((m) => m.el.classList?.contains("ig-petal"))).toHaveLength(MAX_BURST);
+  });
+});
