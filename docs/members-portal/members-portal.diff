+  right: 32%;
+  height: 2px;
+  background: var(--nf-accent-strong);
+}
+.ig-nav-petal { fill: none; stroke: currentColor; stroke-width: 1.1; }
+.ig-nav-line { fill: none; stroke: currentColor; stroke-width: 1.1; stroke-linecap: round; }
+.ig-nav-core { fill: var(--nf-accent); }
+.is-here .ig-nav-petal { fill: var(--nf-blush); stroke: var(--nf-accent-strong); }
+
+/* ── the vellum form and its field (her stone, the arrival repair, her fit) ── */
+.ig-birthday {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 0.75rem;
+  width: 100%;
+  max-width: 360px;
+  margin: 2rem auto 0;
+  padding: 1.5rem 1.25rem;
+  border: 1px solid var(--ig-gold-line);
+  background: var(--ig-vellum);
+}
+.ig-input {
+  width: 100%;
+  height: 50px;
+  padding: 0 0.75rem;
+  border: 0;
+  border-bottom: 1px solid rgb(var(--nf-ink-rgb) / 0.3);
+  background: transparent;
+  font-family: var(--nf-font-label);
+  font-size: 16px;
+  color: var(--nf-ink);
+  text-align: center;
+}
+.ig-input:focus { border-bottom-color: var(--nf-accent-strong); }
+
+/* A piece's price and stock: Your stone's card, a drop's pieces, the drawer and her fit's cards. */
+.ig-price { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0.6rem; margin: 0; font-family: var(--nf-font-label); font-size: 16px; }
+.ig-price s { font-size: 13px; color: rgb(var(--nf-ink-rgb) / 0.62); }
+.ig-stock { font-size: 10px; letter-spacing: var(--nf-track-20); text-transform: uppercase; color: var(--nf-cta); }
+.ig-stock--out { color: rgb(var(--nf-ink-rgb) / 0.6); }
+
+/* Short phones (320 x 568): the gate gives up a little height so its one action stays on the first screen. */
+@media (max-height: 620px) {
+  .ig-gate-scene { width: min(100%, 30vh * 1.048); width: min(100%, 30svh * 1.048); }
+  .ig-gate-cta { margin-top: 1rem; }
+}
+
+@media (min-width: 768px) {
+  .ig-gate-page,
+  .ig-home { padding-top: 2rem; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .ig-btn,
+  .ig-card-link { transition: none; }
+}
+
+/* Phase 6: after dark, the line under her garden that asks her to look up (the star sheet is a chunk of its own). */
+.ig-lookup { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; column-gap: 0.5rem; width: 100%; margin: 0.5rem 0 0; }
+.ig-lookup > .ig-fineprint { margin: 0; }
