+  });
+
+  it("writes nothing to her account from either room", () => {
+    for (const f of [...light, ...vanity]) expect(read(f), f).not.toMatch(/changeMeta|user_metadata|\.update\(|\.upsert\(|\.insert\(/);
+  });
+});
+
+/* A rule may name the only quotations it allows: the shop's own words for something real, quoted (the
+   confirmation email's "View your order" button is sent only for a placed order). */
+const BANNED: [string, RegExp, RegExp[]?][] = [
+  ["the plan's banned phrases", /members-only pric|only \d+ left|\d+ (members|watching)|spots left|sold in the last|selling fast/i],
+  ["exclusivity beyond a first look", /exclusive to members|members only can buy|only members can buy/i],
+  ["a price or reward that does not exist", /\d+\s*%\s*off|discount code|members'? price|birthday gift|free gift|reward points|referral/i],
+  ["scarcity nobody confirmed", /\b(small batch|limited edition|gone for good|almost gone|hurry)\b/i],
+  ["stones or metal beyond the listing's words", /\b(real|genuine|natural|precious) (garnet|amethyst|aquamarine|emerald|ruby|peridot|sapphire|topaz|zircon|gemstone|stone)s?\b|solid gold/i],
+  /* The drops (Phase 2): a first look, never a secret or a members-only shop;
+     no hurry, no stock counts, no penalty for a drop she let pass; pressed
+     flowers are for joy, never a currency. */
+  ["a teaser called a secret, or exclusivity", /\b(secret|secretly|exclusive|exclusively)\b/i],
+  ["urgency, or a penalty for missing a drop", /\b(missed out|you missed|last chance|don'?t miss|hurry|almost gone|few left|low stock|stock is low|sells? out (soon|fast)|before (it|they) (sell|go|are gone)|streaks?|wilt(s|ed|ing)?)\b/i],
+  ["a quantity on a piece", /\b\d+\s*(left|remaining|sold|in stock)\b/i],
+  ["keepsakes as a currency", /\b(earn|earned|earning|collect|win|won|unlocks?|unlocked)\b[^.]{0,30}\b(points?|rewards?|perks?)\b|\bpoints? (balance|total)\b|\bredeem (it|them|your|now)\b/i],
+  ["a price written into the code instead of read from the shop", /₹\s?\d/],
+  /* Phase 3: the sizer is a guide, never a promise of an exchange (the
+     return policy covers defects only); a checkout she started is never an
+     order; a saved piece is never held for her. */
+  ["a promise of a free exchange or a guaranteed fit", /free (exchange|resiz|size change)|exchanges? (are|is) free|easy exchange|guaranteed fit|fit guaranteed|perfect fit, guaranteed/i],
+  ["a checkout called an order", /\b(your|my) orders?\b|order history|past orders/i, [/“View your order”/g]],
+  ["a saved piece said to be held or reserved", /reserved for you|held for you|we('ll| will) (hold|keep) (it|them) for you/i],
+  /* Polish: her size is a guide, so a ring "fits you" is never promised (it
+     comes in her size); the sizes the shop has are "available", never "left";
+     and a size outside the chart is a conversation, not a promise of a ring. */
+  ["a ring promised to fit, or sizes said to be running out", /\bFits you\b|[Ss]izes? left/],
+  ["a promise of a ring outside the chart", /help you find one that fits|we('ll| will) find you a ring/i],
+  /* Phase 4: no gift note, gift wrap or re-polish is offered until the shop confirms it has one; WhatsApp
+     shows no reply hours until the owner gives them; a checkout's pieces are never "what you bought". */
+  ["a gift note, gift wrap or re-polish nobody confirmed", /gift (note|message|wrap|wrapping|card)s?\b|re-?polish(ing)?\b|replat(e|ing)\b|repair service|free (polish|cleaning)/i],
+  /* The listings say "wipe with a soft dry cloth": never polish, which invites a cloth that wears a coat. */
+  ["care beyond the listings' wipe", /\bpolish(ed|es|ing)?\b|\bbuff(ed|ing)?\b/i],
+  ["WhatsApp reply hours the owner has not given", /reply (within|in) \d|replies (within|in) \d|\b(we|the atelier) (reply|replies|answer|answers) (within|by|between)|\b\d{1,2}\s?(am|pm)\s?(to|-|–)\s?\d{1,2}\s?(am|pm)\b/i],
+  ["a checkout's pieces called what she bought", /\b(you|she) (bought|purchased|ordered)\b|your purchases?\b/i],
+];
+
+describe("portal copy", () => {
+  it("reads the portal's sources", () => {
+    expect(sources.length).toBeGreaterThan(20);
+  });
+
+  it.each(BANNED)("never carries %s", (_what, pattern, quoted = []) => {
+    const hits = sources.flatMap((f) =>
+      readFileSync(f, "utf8")
+        .split("\n")
+        .flatMap((line, i) => (pattern.test(quoted.reduce((l, q) => l.replace(q, ""), line)) ? [`${relative(src, f)}:${i + 1}: ${line.trim()}`] : [])),
+    );
+    expect(hits).toEqual([]);
+  });
+
+  /* The drops ship with an empty manifest: the honest words must be there,
+     and nothing may stand in for a drop the owner has not set. */
+  it("says plainly when no drop is set, and keeps a missed drop gentle", () => {
+    const drops = readFileSync(join(src, "pages/members/Drops.tsx"), "utf8");
+    expect(drops).toMatch(/No drop is open right now/);
+    expect(drops).toMatch(/The next one will bloom here/);
+    const vault = readFileSync(join(src, "pages/members/Vault.tsx"), "utf8");
+    expect(vault).toMatch(/This one bloomed in \$\{/);
+    expect(vault).toMatch(/Not points, never redeemable/);
+    expect(readFileSync(join(src, "components/portal/PressFlower.tsx"), "utf8")).toMatch(/not points, never redeemable/);
+  });
+
+  /* The gate promises a first look and a pressed flower only once a drop is set. */
+  it("promises the drops at the gate only once the owner has set one", () => {
+    const gate = readFileSync(join(src, "pages/members/Gate.tsx"), "utf8");
+    expect(gate).toMatch(/"A first look at each new drop", live: DROPS\.length > 0/);
+    expect(gate).toMatch(/"A pressed flower for every drop", live: DROPS\.length > 0/);
+  });
+
+  it("words exclusivity only as a first look, a reserve only as a question on WhatsApp", () => {
+    const room = readFileSync(join(src, "pages/members/DropRoom.tsx"), "utf8");
+    const card = readFileSync(join(src, "components/portal/DropPieceCard.tsx"), "utf8");
+    expect(room).toMatch(/a first look/);
+    expect(room).toMatch(/Reserve on WhatsApp/);
+    expect(card).toMatch(/Arriving · ask on WhatsApp/);
+    for (const text of [room, card]) expect(text).not.toMatch(/members only|only for members|members-only/i);
+  });
+
+  /* Phase 3's rooms say what they are, plainly. */
+  it("calls the sizer a guide, not a guarantee, and sends other sizes to a person", () => {
+    const fit = readFileSync(join(src, "pages/members/Fit.tsx"), "utf8");
+    expect(fit).toMatch(/A guide, not a guarantee/);
+    // And on the sizer itself, under the size she is about to keep.
+    expect(readFileSync(join(src, "components/portal/RingSizer.tsx"), "utf8")).toMatch(/A guide, not a guarantee/);
+    const sizer = readFileSync(join(src, "lib/portal/sizer.ts"), "utf8");
+    expect(sizer).toMatch(/https:\/\/wa\.me\/\$\{WHATSAPP_NUMBER\}/);
+  });
+
+  it("labels keepsakes for joy, not points, never redeemable", () => {
+    const herbarium = readFileSync(join(src, "pages/members/Herbarium.tsx"), "utf8");
+    expect(herbarium).toMatch(/for joy, not points, never redeemable/);
+  });
+
+  it("keeps the drawer's hearts to her own taps, and every price live", () => {
+    const drawer = readFileSync(join(src, "pages/members/Drawer.tsx"), "utf8");
+    expect(drawer).toMatch(/const REBUILD_HEARTS_ON_ARRIVAL = false;/);
+    // No button puts hearts back on a phone: each would send Meta an AddToWishlist.
+    expect(drawer).not.toMatch(/Heart them here/);
+    expect(drawer.match(/\bheartHere\(\)/g)).toHaveLength(1);
+    expect(drawer).toMatch(/if \(REBUILD_HEARTS_ON_ARRIVAL && isLive && plan\.missingOnDevice\.length\) heartHere\(\);/);
+    const card = readFileSync(join(src, "components/portal/PieceCard.tsx"), "utf8");
+    expect(card).toMatch(/available \? "Available" : "Sold out"/);
+    expect(card).not.toMatch(/priceLabel/);
+  });
+
+  /* The arrival repair asks, it never decides for her: the consent box
+     starts unticked and is never ticked by code, and the list is offered for
+     what it is (news by email), with no price or reward attached. */
+  it("never pre-ticks the arrival repair's consent box", () => {
+    const card = readFileSync(join(src, "components/portal/ArrivalRepair.tsx"), "utf8");
+    expect(card).toMatch(/const \[ticked, setTicked\] = useState\(false\);/);
+    expect(card).toMatch(/checked=\{ticked\}/);
+    expect(card).toMatch(/onChange=\{\(e\) => setTicked\(e\.target\.checked\)\}/);
+    expect(card.match(/setTicked\(/g)).toHaveLength(1);
+    expect(card).not.toMatch(/defaultChecked|checked=\{true\}|checked\s*\/?>/);
+    expect(card).toMatch(/news of new pieces by email/);
+    const arrival = readFileSync(join(src, "lib/portal/arrival.ts"), "utf8");
+    expect(arrival).toMatch(/export const ARRIVAL_SOURCE = "members-arrival";/);
+    // Joining from the portal tells Meta nothing until the owner approves those events:
+    // its own quiet copy of the insert, and the shop's lib/innerCircle left exactly as it was.
+    expect(arrival).toMatch(/export const ARRIVAL_JOIN_TELLS_META = false;/);
+    expect(arrival).not.toMatch(/lib\/pixel|trackPixel\(|fbq\(/);
+    const route = readFileSync(join(src, "pages/members/MembersRoute.tsx"), "utf8");
+    expect(route).toMatch(/liveArrivalActions\(ARRIVAL_JOIN_TELLS_META \? joinInnerCircle : joinListQuietly, refreshProfile\)/);
+    expect(readFileSync(join(src, "lib/innerCircle.ts"), "utf8")).not.toMatch(/track\??:/);
+  });
+
+  it("says out loud that the garden is for joy, not points", () => {
+    const home = readFileSync(join(src, "pages/members/GardenHome.tsx"), "utf8");
+    expect(home).toMatch(/Nothing in it is points, and nothing in it can be redeemed/);
+  });
+
+  /* Phase 4's rooms say what they are. */
+  it("keeps the ledger to eight dates, the Gifting page's bands and a yearly reminder", () => {
+    const gifts = readFileSync(join(src, "lib/portal/gifts.ts"), "utf8");
+    expect(gifts).toMatch(/Eight dates are kept at most\. Remove one to add another\./);
+    expect(gifts).toMatch(/export const LABEL_MAX = 12;/);
+    expect(gifts).toMatch(/alarm: `-P\$\{REMIND_DAYS\}D`/);
+    expect(gifts).toMatch(/export const REMIND_DAYS = 7;/);
+    expect(readFileSync(join(src, "lib/portal/memberMeta.ts"), "utf8")).toMatch(/export const GIFT_BANDS = \[1000, 1500, 2500\] as const;/);
+    // The Gifting page's own bands.
+    const gifting = readFileSync(join(src, "pages/Gifting.tsx"), "utf8");
+    for (const band of ["1,000", "1,500", "2,500"]) expect(gifting).toContain(`Under ₹${band}`);
