+const test1 = (row: Stored, column: string, op: string, value: string): boolean => {
+  const v = (row as Record<string, unknown>)[column];
+  if (op === "eq") return v === value;
+  if (op === "neq") return v !== value;
+  if (op === "gte") return String(v) >= value;
+  if (op === "lte") return String(v) <= value;
+  if (op === "like") return typeof v === "string" && like(value).test(v);
+  if (op === "in") return value.replace(/^\(|\)$/g, "").split(",").includes(String(v));
+  throw new Error(`unexpected filter ${op}`);
