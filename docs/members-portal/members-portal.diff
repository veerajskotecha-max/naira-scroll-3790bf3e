+import * as THREE from "three";
+import { CENTRE, CROWN, GEM_MARGIN, HEART_BOX, cut, lift, type Light, type Pt, type Vec3 } from "../stoneLight";
+import { claimGl, frameProbe, releaseGl } from "../tier";
+
+/*
+  THE GEM (Tier 2) on Your stone: Stone Light's heart as a faceted solid
+  under one shader, in the panel's own box, on a capable phone only.
+
+  About 126 flat-shaded triangles from the same cut the drawing uses
+  (lib/portal/stoneLight): its crown (the table, stars, kites and upper
+  girdle facets), a thin girdle, and a pavilion of lower girdle facets and
+  mains down to its point. One material whose program is wholly its own: a
+  procedural room (a gold-to-ivory gradient and three soft window strips,
+  no texture, no light probe), the window's reflection at grazing angles,
+  the room seen through the stone in three channels, so its colour parts a
+  little at the facets' edges (eased, never clipped to a neon), and two
+  small specular stars that follow the light. The shared "three" chunk
+  exports no ShaderMaterial, and naming one here would add an export to it,
+  so the program is MeshStandardMaterial's, replaced whole in
+  onBeforeCompile (as the Bloom Field's gold already edits its own).
+
+  Set as the drawing is: its girdle in gold, four gold claws that
+  turn with it (where the drawing puts them), and its crown's facet edges
+  drawn in fine ivory lines over the stone. Each is built only from what
+  the shared chunk already exports (a plane's geometry refilled, a
+  MeshStandardMaterial with its own program, its wireframe for the lines),
+  so the three chunk stays byte for byte as it is.
+
+  It draws only when asked: on her input, while the drawing's light
+  settles, and never on its own after the turn-in. The turn-in (1.2 s,
+  unseen at opacity 0, after compileAsync) is the 60-frame probe: a phone
+  that cannot hold it is told at once (onEnd("slow")), and the host puts
+  everything away, gives the context back (forceContextLoss) and keeps the
+  drawing. One portal scene at a time (tier.ts's claimGl, shared with the
+  Bloom Field): with the header flower, never more than two contexts.
+
+  Reached only by import(), from lib/portal/spectacle.ts's loadGemScene.
+  Its only package import is three, as a namespace, as the Bloom Field's.
+*/
+
+export const DPR_CAP = 2;
+export const TURN_IN_MS = 1200;
+/* The girdle's height and the pavilion's depth, in heart units. */
+const GIRDLE_H = 0.45;
+const PAVILION = 8.5;
+/* The lower girdle facets meet the mains this far in from the girdle, and this deep. */
+const LOWER_IN = 0.62;
+const LOWER_DEPTH = 0.45;
+
+type Tri = [Vec3, Vec3, Vec3];
+
+const sub = (a: Vec3, b: Vec3): Vec3 => [a[0] - b[0], a[1] - b[1], a[2] - b[2]];
+const cross = (a: Vec3, b: Vec3): Vec3 => [a[1] * b[2] - a[2] * b[1], a[2] * b[0] - a[0] * b[2], a[0] * b[1] - a[1] * b[0]];
+const faceNormal = ([a, b, c]: Tri): Vec3 => cross(sub(b, a), sub(c, a));
+/* Wound so its face is outward along `out`. */
+const facing = (t: Tri, out: Vec3): Tri => {
+  const n = faceNormal(t);
+  return n[0] * out[0] + n[1] * out[1] + n[2] * out[2] < 0 ? [t[0], t[2], t[1]] : t;
+};
+
+const shrink = (p: Pt, k: number, at: Pt): Pt => [at[0] + (p[0] - at[0]) * k, at[1] + (p[1] - at[1]) * k];
+
+/**
+ * The gem's triangles, in heart units around the cut's centre (x right, y
+ * up, z toward her), each wound outward: the crown, the girdle and the
+ * pavilion. Flat x,y,z triples, nine numbers to a triangle.
+ */
+export const gemTriangles = (): Float32Array => {
+  const c = cut();
+  const g = c.girdle;
+  const n = g.length;
+  const tris: Tri[] = [];
+  const up: Vec3 = [0, 0, 1];
+  const down: Vec3 = [0, 0, -1];
+  // The crown: every facet of the drawing, lifted, its polygons fanned into triangles.
+  const zAt = (p: Pt) => {
+    const t = c.table.findIndex((q) => q[0] === p[0] && q[1] === p[1]);
+    if (t >= 0) return CROWN;
+    return c.ring.some((q) => q[0] === p[0] && q[1] === p[1]) ? CROWN * 0.4 : 0;
+  };
+  for (const f of c.facets) {
+    const pts = f.points.map((p) => lift(p, zAt(p)));
+    for (let i = 1; i + 1 < pts.length; i++) tris.push(facing([pts[0], pts[i], pts[i + 1]], up));
+  }
+  // The girdle: a thin band straight down from the crown's edge, facing out from the outline.
+  const top = g.map((p) => lift(p, 0));
+  const area = top.reduce((s, p, i) => s + p[0] * top[(i + 1) % n][1] - top[(i + 1) % n][0] * p[1], 0);
+  const foot = g.map((p) => lift(p, -GIRDLE_H));
+  for (let i = 0; i < n; i++) {
+    const j = (i + 1) % n;
+    const d = sub(top[j], top[i]);
+    // The outline's outward side, from its winding.
+    const out: Vec3 = area > 0 ? [d[1], -d[0], 0] : [-d[1], d[0], 0];
+    tris.push(facing([top[i], top[j], foot[j]], out), facing([top[i], foot[j], foot[i]], out));
+  }
+  // The pavilion: lower girdle facets to a ring, then mains to the point below the table.
+  const centre = c.table.reduce<Pt>((s, p) => [s[0] + p[0] / c.table.length, s[1] + p[1] / c.table.length], [0, 0]);
+  const ring = g.map((p) => lift(shrink(p, LOWER_IN, centre), -GIRDLE_H - PAVILION * LOWER_DEPTH));
+  const point = lift(centre, -GIRDLE_H - PAVILION);
+  for (let i = 0; i < n; i++) {
+    const j = (i + 1) % n;
+    tris.push(facing([foot[i], foot[j], ring[j]], down), facing([foot[i], ring[j], ring[i]], down));
+    tris.push(facing([ring[i], ring[j], point], down));
+  }
+  const out = new Float32Array(tris.length * 9);
+  tris.forEach((t, i) => t.forEach((v, k) => out.set(v, i * 9 + k * 3)));
+  return out;
+};
+
+/** Which of the gem's triangles are its girdle (drawn in gold): one flag a vertex, in gemTriangles' order. */
+export const girdleFlags = (): Float32Array => {
+  const c = cut();
+  const crown = c.facets.reduce((sum, f) => sum + f.points.length - 2, 0);
+  const n = c.girdle.length;
+  const flags = new Float32Array(gemTriangles().length / 3);
+  flags.fill(1, crown * 3, (crown + 2 * n) * 3);
+  return flags;
+};
+
+/** The four claws, where the drawing holds the stone: a small faceted gold bead each (12 triangles), at the crown's edge. */
+export const clawTriangles = (r = 0.62): Float32Array => {
+  const out: number[] = [];
+  const SIDES = 6;
+  for (const claw of cut().claws) {
+    const [x, y] = lift(claw, 0);
+    const z = 0.12;
+    const top: Vec3 = [x, y, z + r];
+    const foot: Vec3 = [x, y, z - r * 0.8];
+    const ring: Vec3[] = Array.from({ length: SIDES }, (_, i): Vec3 => [x + Math.cos((i / SIDES) * Math.PI * 2) * r, y + Math.sin((i / SIDES) * Math.PI * 2) * r, z]);
+    for (let i = 0; i < SIDES; i++) {
+      const a = ring[i];
+      const b = ring[(i + 1) % SIDES];
+      const mx = (a[0] + b[0]) / 2 - x;
+      const my = (a[1] + b[1]) / 2 - y;
+      for (const t of [facing([top, a, b], [mx, my, 1]), facing([foot, b, a], [mx, my, -1])]) for (const v of t) out.push(...v);
+    }
+  }
+  return new Float32Array(out);
+};
+
+/** The crown's facet edges and the girdle's top edge, each once, as degenerate triangles (a, b, b): drawn as wireframe, they are its fine lines. */
+export const edgeTriangles = (): Float32Array => {
+  const c = cut();
+  const zAt = (p: Pt) => (c.table.some((q) => q[0] === p[0] && q[1] === p[1]) ? CROWN : c.ring.some((q) => q[0] === p[0] && q[1] === p[1]) ? CROWN * 0.4 : 0);
+  const seen = new Set<string>();
+  const out: number[] = [];
+  const edge = (a: Pt, b: Pt) => {
+    const key = [a, b].map((p) => p.map((v) => v.toFixed(3)).join(",")).sort().join("|");
+    if (seen.has(key)) return;
+    seen.add(key);
+    const A = lift(a, zAt(a));
+    const B = lift(b, zAt(b));
+    out.push(...A, ...B, ...B);
+  };
+  for (const f of c.facets) f.points.forEach((p, i) => edge(p, f.points[(i + 1) % f.points.length]));
+  c.girdle.forEach((p, i) => edge(p, c.girdle[(i + 1) % c.girdle.length]));
+  return new Float32Array(out);
+};
+
+const VERTEX = /* glsl */ `
+attribute float aGold;
+varying vec3 vN;
+varying vec3 vV;
+varying float vGold;
+void main() {
+  vec4 mv = modelViewMatrix * vec4(position, 1.0);
+  vN = normalize(normalMatrix * normal);
+  vV = -mv.xyz;
+  vGold = aGold;
+  gl_Position = projectionMatrix * mv;
+}`;
+
+/* Gold, as the drawing's (#C99A4C, a pale-gold #E8C88A highlight), lit by the same light: in the screen's own colours. */
+const GOLD_GLSL = /* glsl */ `
+vec3 gold(vec3 n, vec3 v, float lx, float ly) {
+  vec3 l = normalize(vec3(lx * 1.3, 0.5 + ly, 1.0));
+  vec3 r = reflect(-v, n);
+  float d = max(dot(n, l), 0.0);
+  float s = pow(max(dot(r, l), 0.0), 22.0);
+  return mix(vec3(0.43, 0.31, 0.13), vec3(0.79, 0.6, 0.3), 0.3 + 0.7 * d) + vec3(0.91, 0.78, 0.54) * s * 0.9;
+}`;
+
+const GOLD_VERTEX = /* glsl */ `
+varying vec3 vN;
+varying vec3 vV;
+void main() {
+  vec4 mv = modelViewMatrix * vec4(position, 1.0);
+  vN = normalize(normalMatrix * normal);
+  vV = -mv.xyz;
+  gl_Position = projectionMatrix * mv;
+}`;
+
+const GOLD_FRAGMENT = /* glsl */ `
+uniform float uLx;
+uniform float uLy;
+varying vec3 vN;
+varying vec3 vV;
+${GOLD_GLSL}
+void main() {
+  gl_FragColor = vec4(gold(normalize(vN), normalize(vV), uLx, uLy), 1.0);
+}`;
+
+const LINE_VERTEX = /* glsl */ `
+void main() {
+  gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
+}`;
+
+/* The drawing's fine ivory facet lines (#F4EBE2 at about a third). */
+const LINE_FRAGMENT = /* glsl */ `
+void main() {
+  gl_FragColor = vec4(0.957, 0.922, 0.886, 0.34);
+}`;
+
+const FRAGMENT = /* glsl */ `
+uniform vec3 uHue;
+uniform vec3 uTint;
+uniform float uLx;
+uniform float uLy;
+varying vec3 vN;
+varying vec3 vV;
+varying float vGold;
+${GOLD_GLSL}
+/* The atelier, procedurally: a dark room warming to gold below and ivory above, and bright windows that move with the light. */
+vec3 room(vec3 d) {
+  float up = clamp(d.y * 0.5 + 0.5, 0.0, 1.0);
+  vec3 c = mix(vec3(0.04, 0.025, 0.01), vec3(0.3, 0.24, 0.18), up * up);
+  float a = atan(d.x, d.z) + uLx * 1.6;
+  float w = 0.0;
+  for (int i = 0; i < 4; i++) {
+    float at = -1.5 + float(i) * 1.0;
+    w += smoothstep(0.24, 0.03, abs(a - at)) * smoothstep(-0.5, 0.25, d.y + uLy * 0.9);
+  }
+  return c + vec3(1.0, 0.95, 0.86) * w * 2.4;
+}
+/* The room seen through the crown after one bounce off the pavilion below it: each facet sends her eye to a different part of the room. */
+vec3 inside(vec3 v, vec3 n, float eta) {
+  vec3 t = refract(-v, n, eta);
+  vec3 back = normalize(vec3(n.xy * 3.2 - v.xy * 2.6, -1.0));
+  return room(reflect(t, back));
+}
+void main() {
+  vec3 n = normalize(vN);
+  vec3 v = normalize(vV);
+  /* The girdle: set in gold, as the drawing's outline is. */
+  if (vGold > 0.5) {
+    gl_FragColor = vec4(gold(n, v, uLx, uLy), 1.0);
+    return;
+  }
+  float f = pow(1.0 - max(dot(n, v), 0.0), 3.0);
+  vec3 r = reflect(-v, n);
+  vec3 seen = vec3(inside(v, n, 0.47).r, inside(v, n, 0.455).g, inside(v, n, 0.44).b);
+  /* Eased toward the stone's own colour, never clipped to a pure hue. */
+  vec3 lit = seen * uHue * 2.6;
+  vec3 col = mix(1.0 - exp(-lit * 1.15), uTint * 0.55, 0.1);
+  col = mix(col, room(r), 0.05 + 0.8 * f);
+  vec3 l1 = normalize(vec3(uLx * 1.3, 0.5 + uLy, 1.0));
+  vec3 l2 = normalize(vec3(-0.6 + uLx * 0.5, 0.9, 0.6));
+  float s = pow(max(dot(r, l1), 0.0), 60.0) + 0.7 * pow(max(dot(r, l2), 0.0), 110.0);
+  col += vec3(1.0, 0.97, 0.9) * s * 2.2;
+  gl_FragColor = vec4(pow(max(col, 0.0), vec3(0.4545)), 1.0);
+}`;
+
+export type GemEnd = "slow" | "lost";
+
+export type GemOptions = {
+  hue: string;
+  tint: string;
+  light: Light;
+  /** Time the turn-in's frames and give up on a slow phone (always, but for the development preview's &probe=0). */
+  probe?: boolean;
+  /** Turned in on a steady phone: it may be shown (the crossfade). Called once. */
+  onReady: () => void;
+  /** The phone was too slow for it, or the context was lost: the host puts it away. Called once. */
+  onEnd: (why: GemEnd) => void;
+};
+
+export type GemHandle = {
+  /** The drawing's light: one frame is drawn for it (none while paused or still turning in). */
+  setLight: (l: Light) => void;
+  setColour: (hue: string, tint: string) => void;
+  /** Off screen, the tab hidden, idle for 20 s, or the bag open over it: nothing is drawn. */
+  pause: () => void;
+  resume: () => void;
+  /** Frees everything and gives the context back. Safe to call more than once. */
+  dispose: () => void;
+};
+
+const FOV = 22;
+/* The canvas shows the heart's box with GEM_MARGIN round it; the box's centre sits this far below the cut's centre. */
+const BOX_DROP = HEART_BOX.h / 2 - CENTRE[1];
+const TILT_Y = 0.45;
+const TILT_X = 0.3;
+
+export function mountGem(canvas: HTMLCanvasElement, options: GemOptions): GemHandle {
+  const slot = {};
+  if (!claimGl(slot)) throw new Error("A portal scene is already live.");
+  let renderer: THREE.WebGLRenderer;
+  try {
+    renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true, powerPreference: "default" });
+  } catch (error) {
+    releaseGl(slot);
+    throw error;
+  }
+  let disposed = false;
+  let raf = 0;
+  const parts: { dispose: () => void }[] = [];
+  const dispose = () => {
+    if (disposed) return;
+    disposed = true;
+    cancelAnimationFrame(raf);
+    releaseGl(slot);
+    for (const p of parts.reverse()) {
+      try {
+        p.dispose();
+      } catch {
+        /* freeing is best effort */
+      }
+    }
+    try {
+      renderer.dispose();
+    } catch {
+      /* the context below is given back regardless */
+    }
+    try {
+      renderer.forceContextLoss();
+    } catch {
+      /* already lost */
+    }
+  };
+
+  try {
+    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, DPR_CAP));
+    renderer.setClearColor(0xffffff, 0);
+    renderer.shadowMap.enabled = false;
+
+    const scene = new THREE.Scene();
+    const camera = new THREE.PerspectiveCamera(FOV, 1, 1, 400);
+    const halfH = HEART_BOX.h / 2 + GEM_MARGIN;
+    camera.position.set(0, -BOX_DROP, halfH / Math.tan(THREE.MathUtils.degToRad(FOV / 2)));
+    camera.lookAt(0, -BOX_DROP, 0);
+
+    // A plane's geometry, emptied and refilled: the shared chunk exports no bare BufferGeometry or BufferAttribute, and its attribute is the same class.
+    const geometry = new THREE.PlaneGeometry(1, 1);
+    const Attribute = geometry.getAttribute("position").constructor as new (array: Float32Array, size: number) => THREE.BufferAttribute;
+    geometry.setIndex(null);
+    geometry.deleteAttribute("uv");
+    geometry.deleteAttribute("normal");
+    geometry.setAttribute("position", new Attribute(gemTriangles(), 3));
+    geometry.setAttribute("aGold", new Attribute(girdleFlags(), 1));
+    // Unshared vertices: each triangle's own flat normal.
+    geometry.computeVertexNormals();
+    parts.push(geometry);
+    /* The same refill for the claws and the facet lines. */
+    const refilled = (triangles: Float32Array, normals: boolean) => {
+      const g = new THREE.PlaneGeometry(1, 1);
+      g.setIndex(null);
+      g.deleteAttribute("uv");
+      g.deleteAttribute("normal");
+      g.setAttribute("position", new Attribute(triangles, 3));
+      if (normals) g.computeVertexNormals();
+      parts.push(g);
+      return g;
+    };
+
+    const uniforms = {
+      uHue: { value: new THREE.Color(options.hue) },
+      uTint: { value: new THREE.Color(options.tint) },
+      uLx: { value: options.light.x },
+      uLy: { value: options.light.y },
+    };
+    const material = new THREE.MeshStandardMaterial();
+    material.onBeforeCompile = (shader) => {
+      Object.assign(shader.uniforms, uniforms);
+      shader.vertexShader = VERTEX;
+      shader.fragmentShader = FRAGMENT;
+    };
+    parts.push(material);
+    const gem = new THREE.Mesh(geometry, material);
+    scene.add(gem);
+
+    // Its four gold claws and its drawn facet lines turn with it: children of the gem.
+    const goldMaterial = new THREE.MeshStandardMaterial();
+    goldMaterial.onBeforeCompile = (shader) => {
+      Object.assign(shader.uniforms, { uLx: uniforms.uLx, uLy: uniforms.uLy });
+      shader.vertexShader = GOLD_VERTEX;
+      shader.fragmentShader = GOLD_FRAGMENT;
+    };
+    parts.push(goldMaterial);
+    gem.add(new THREE.Mesh(refilled(clawTriangles(), true), goldMaterial));
+    const lineMaterial = new THREE.MeshStandardMaterial({ wireframe: true, transparent: true, depthTest: false, depthWrite: false });
+    lineMaterial.onBeforeCompile = (shader) => {
+      shader.vertexShader = LINE_VERTEX;
+      shader.fragmentShader = LINE_FRAGMENT;
+    };
+    parts.push(lineMaterial);
+    const lines = new THREE.Mesh(refilled(edgeTriangles(), false), lineMaterial);
+    lines.renderOrder = 1;
+    gem.add(lines);
+
+    let light = options.light;
+    const pose = (turn = 0) => {
+      gem.rotation.set(-light.y * TILT_X, light.x * TILT_Y + turn, 0);
+      uniforms.uLx.value = light.x;
+      uniforms.uLy.value = light.y;
+    };
+
+    /* Sized to its box; a size that has not changed is left alone (setting it clears the drawing). */
+    let sized = "";
+    const resize = (): boolean => {
+      const w = canvas.clientWidth || 300;
+      const h = canvas.clientHeight || 300;
+      if (sized === `${w}x${h}`) return false;
+      sized = `${w}x${h}`;
+      renderer.setSize(w, h, false);
+      camera.aspect = w / h;
+      camera.updateProjectionMatrix();
+      return true;
+    };
+    resize();
+
+    let compiledIn = false;
+    let ready = false;
+    let ended = false;
+    let wanted = true;
+    let turning = false;
+    let turnedFor = 0;
+    let last = 0;
+    const probe = options.probe === false ? null : frameProbe();
+
+    const end = (why: GemEnd) => {
+      if (ended || disposed) return;
+      ended = true;
+      turning = false;
+      cancelAnimationFrame(raf);
+      raf = 0;
+      options.onEnd(why);
+    };
+
+    /* The turn-in: unseen, about three quarters of a turn easing into her light, every frame timed. */
+    const turnIn = (now: number) => {
+      raf = 0;
+      if (!turning || disposed || !wanted) return;
+      if (last) {
+        const dt = now - last;
+        turnedFor += Math.min(dt, 50);
+        if (probe && probe.frame(dt) === "slow") {
+          end("slow");
+          return;
+        }
+      }
+      last = now;
+      const k = Math.min(1, turnedFor / TURN_IN_MS);
+      pose(-4.4 * Math.pow(1 - k, 3));
+      renderer.render(scene, camera);
+      // On, until the turn is done and the probe has its verdict.
+      if (k < 1 || (probe && probe.verdict === "probing")) {
+        raf = requestAnimationFrame(turnIn);
+        return;
+      }
+      turning = false;
+      ready = true;
+      options.onReady();
+    };
+    const startTurn = () => {
+      if (disposed || ended || turning || ready || !wanted || !compiledIn) return;
+      turning = true;
+      last = 0;
+      raf = requestAnimationFrame(turnIn);
+    };
+
+    /* After the turn-in, a frame only when asked. */
+    const ask = () => {
+      if (!ready || disposed || ended || !wanted || raf) return;
+      raf = requestAnimationFrame(() => {
+        raf = 0;
+        if (disposed || !wanted) return;
+        pose();
+        renderer.render(scene, camera);
+      });
+    };
+
+    let resizeFrame = 0;
+    const onResize = () => {
+      cancelAnimationFrame(resizeFrame);
+      resizeFrame = requestAnimationFrame(() => {
+        // A new size clears the canvas: once it is in, one frame is drawn at once, even while paused, so the heart is never left blank.
+        const changed = resize();
+        if (changed === false || !ready || disposed || ended) return;
+        pose();
+        renderer.render(scene, camera);
+      });
+    };
+    window.addEventListener("resize", onResize);
+    const onLost = (e: Event) => {
+      e.preventDefault();
+      end("lost");
+    };
+    canvas.addEventListener("webglcontextlost", onLost);
+    parts.push({
+      dispose: () => {
+        cancelAnimationFrame(resizeFrame);
+        window.removeEventListener("resize", onResize);
+        canvas.removeEventListener("webglcontextlost", onLost);
+      },
+    });
+
+    pose();
+    const compiled = typeof renderer.compileAsync === "function" ? renderer.compileAsync(scene, camera) : Promise.resolve();
+    void Promise.resolve(compiled)
+      .catch(() => undefined)
+      .then(() => {
+        compiledIn = true;
+        startTurn();
+      });
+
+    return {
+      setLight: (l) => {
+        light = l;
+        ask();
+      },
+      setColour: (hue, tint) => {
+        uniforms.uHue.value.set(hue);
+        uniforms.uTint.value.set(tint);
+        ask();
+      },
+      pause: () => {
+        wanted = false;
+        cancelAnimationFrame(raf);
+        raf = 0;
+      },
+      resume: () => {
+        wanted = true;
+        if (ready) ask();
+        else {
+          turning = false;
+          startTurn();
+        }
+      },
+      dispose,
+    };
+  } catch (error) {
+    dispose();
+    throw error;
+  }
+}
