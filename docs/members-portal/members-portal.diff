+import { act, cleanup, render } from "@testing-library/react";
+import { useRef } from "react";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { IDLE_MS, cue, useAmbient } from "./motion";
+
+/* "The garden rests": the one ambient loop on a screen runs only while its
+   element is on screen, the tab is visible and someone has touched, scrolled
+   or typed in the last 20 s. */
+
+let seen: (visible: boolean) => void = () => {};
+class FakeObserver {
+  constructor(cb: (entries: { isIntersecting: boolean }[]) => void) {
+    seen = (visible) => cb([{ isIntersecting: visible }]);
+  }
+  observe() {}
+  disconnect() {}
+}
+
+const states: boolean[] = [];
+const Probe = ({ enabled = true }: { enabled?: boolean }) => {
+  const ref = useRef<HTMLDivElement>(null);
+  states.push(useAmbient(ref, enabled));
+  return <div ref={ref} />;
+};
+const now = () => states[states.length - 1];
+
+const setHidden = (hidden: boolean) => {
+  Object.defineProperty(document, "visibilityState", { configurable: true, get: () => (hidden ? "hidden" : "visible") });
+  document.dispatchEvent(new Event("visibilitychange"));
+};
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  states.length = 0;
+  seen = () => {};
+  vi.stubGlobal("IntersectionObserver", FakeObserver);
+});
+afterEach(() => {
+  cleanup();
+  setHidden(false);
+  vi.unstubAllGlobals();
+  vi.useRealTimers();
+});
+
+describe("useAmbient", () => {
+  it("runs only while the element is on screen", () => {
+    render(<Probe />);
+    expect(now()).toBe(false);
+    act(() => seen(true));
+    expect(now()).toBe(true);
+    act(() => seen(false));
+    expect(now()).toBe(false);
+  });
+
+  it("rests on a hidden tab", () => {
+    render(<Probe />);
+    act(() => seen(true));
+    act(() => setHidden(true));
+    expect(now()).toBe(false);
+    act(() => setHidden(false));
+    expect(now()).toBe(true);
+  });
+
+  it("rests after 20 s without a touch, and wakes on the next one", () => {
+    render(<Probe />);
+    act(() => seen(true));
+    act(() => void vi.advanceTimersByTime(IDLE_MS - 1));
+    expect(now()).toBe(true);
+    act(() => void vi.advanceTimersByTime(1));
+    expect(now()).toBe(false);
+    act(() => void window.dispatchEvent(new Event("pointerdown")));
+    expect(now()).toBe(true);
+  });
+
+  it("never runs when switched off (reduced motion)", () => {
+    render(<Probe enabled={false} />);
+    act(() => seen(true));
+    expect(now()).toBe(false);
+  });
+});
+
+describe("cue", () => {
+  it("fires at its time, and not at all once cancelled", () => {
+    const fired = vi.fn();
+    const kept = cue(null, 300, fired);
+    const dropped = cue(null, 300, fired);
+    dropped.cancel();
+    act(() => void vi.advanceTimersByTime(300));
+    expect(fired).toHaveBeenCalledTimes(1);
+    kept.cancel();
+  });
+});
