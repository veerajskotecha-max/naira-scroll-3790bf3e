+import { describe, expect, it } from "vitest";
+import { WHATSAPP_NUMBER } from "@/data/jewellery";
+import { ORDER_NUMBER_LINE, SAVED_IN_MESSAGE, WHATSAPP_URL, atelierLink, atelierMessage, waLink } from "./whatsapp";
+
+/*
+  The atelier's WhatsApp: the shop's own number, her words filled in from
+  what her account keeps (and nothing it does not), encoded whole, and no
+  reply hours, gift notes or services the shop has not confirmed.
+*/
+
+const textOf = (link: string) => new URL(link).searchParams.get("text") ?? "";
+
+describe("writing to the atelier", () => {
+  it("opens the shop's own number", () => {
+    expect(WHATSAPP_NUMBER).toBe("919561557935");
+    expect(WHATSAPP_URL).toBe("https://wa.me/919561557935");
+    expect(waLink("Hello")).toBe("https://wa.me/919561557935?text=Hello");
+  });
+
+  it("fills in her size, metal, stone and the first three pieces she saved", () => {
+    const text = atelierMessage({ about: "care", size: 7, metal: "g", month: 7, saved: ["a-piece", "b-piece", "c-piece", "d-piece"] });
+    expect(text).toContain("I have a question about caring for a piece.");
+    expect(text).toContain("My ring size: US 7");
+    expect(text).toContain("My metal: Gold");
+    // The month's variant as the shop names it, never "my stone" (they are cubic zirconia).
+    expect(text).toContain("My month's colour: July · Ruby");
+    expect(text).not.toMatch(/My stone:/);
+    expect(text).toContain("https://nairaflore.com/jewellery/a-piece\nhttps://nairaflore.com/jewellery/b-piece\nhttps://nairaflore.com/jewellery/c-piece");
+    expect(text).not.toContain("d-piece");
+    expect(SAVED_IN_MESSAGE).toBe(3);
+  });
+
+  it("says nothing her account does not keep", () => {
+    const text = atelierMessage({ about: "care" });
+    expect(text).not.toMatch(/ring size|metal|stone|saved/i);
+    expect(atelierMessage({ about: "care", metal: "b" })).toContain("My metal: Gold and silver");
+    expect(atelierMessage({ about: "care", month: 13 })).not.toMatch(/My stone/);
+  });
+
+  it("puts her checkout email and a line for the order number in the order desk's message, and nothing else", () => {
+    const text = atelierMessage({ about: "order", email: " meera@example.com ", size: 6, metal: "g", month: 7, saved: ["a-piece", "b-piece"] });
+    expect(text).toContain("Could you check on an order for me?");
+    expect(text).toContain("The email I used at checkout: meera@example.com");
+    expect(text).toContain(ORDER_NUMBER_LINE);
+    expect(ORDER_NUMBER_LINE).toBe("The order number (from my confirmation email): ");
+    // Her size, metal, month and saved pieces would only muddle which order she means.
+    expect(text).not.toMatch(/My ring size|My metal|My month|My stone|Pieces I saved|a-piece/);
+    expect(atelierMessage({ about: "order", email: "" })).not.toContain("email I used");
+    // Never her orders: an order she asks about.
+    expect(text).not.toMatch(/\b(your|my) orders?\b/i);
+  });
+
+  it("encodes the whole message, line breaks, middots and Devanagari included", () => {
+    const words = "नमस्ते\nJuly · Ruby & more? #1024";
+    const link = atelierLink(`${words}\n\n`);
+    const query = link.split("?text=")[1];
+    expect(query).not.toMatch(/[\s·#&?]/);
+    // Devanagari is percent-encoded too.
+    expect([...query].some((c) => (c.codePointAt(0) ?? 0) > 0x7f)).toBe(false);
+    expect(textOf(link)).toBe(words);
+  });
+
+  it("never throws on half of a broken character (an emoji cut by a paste)", () => {
+    const fffd = "%EF%BF%BD";
+    expect(waLink("Hi \uD83C")).toBe(`${WHATSAPP_URL}?text=Hi%20${fffd}`);
+    expect(waLink("\uDC00")).toBe(`${WHATSAPP_URL}?text=${fffd}`);
+    expect(waLink("\uDC00\uD83C")).toBe(`${WHATSAPP_URL}?text=${fffd}${fffd}`);
+    // A whole pair beside a broken half: the pair kept, the half replaced.
+    expect(textOf(waLink("\uD83C🌸"))).toBe("\uFFFD🌸");
+    expect(textOf(atelierLink("नमस्ते ₹500 😀\n"))).toBe("नमस्ते ₹500 😀");
+  });
+
+  it("promises no reply hours, gift note or re-polish", () => {
+    for (const about of ["care", "order"] as const) {
+      const text = atelierMessage({ about, size: 7, metal: "s", month: 1, saved: ["x"], email: "a@b.co" });
+      expect(text).not.toMatch(/hours|reply within|gift note|gift message|re-?polish|replating/i);
+    }
+  });
+});
