+            ref={bedRef}
+            seed={user.id}
+            stone={stone}
+            plantedOn={plantedOn}
+            stoneLabel={stone ? shownName(stone.variant) : "Waiting"}
+            stoneCaption="Your colour"
+            pressed={flowers}
+            fitted={Boolean(ring)}
+            saved={sprigs}
+            gifts={naira.gifts}
+            sky={hour}
+            roses={!doors}
+            crown={doors ? 0 : pieces}
+            behind={sky.shown ? <SkyLayer hour={hour} seed={user.id} part="back" arriving={sky.arriving} month={night && stone ? stone.month : undefined} written={written} /> : null}
+          >
+            {next && (
+              <DropBud
+                to={`/members/drops/${next.id}`}
+                species={speciesIndex(next.species)}
+                accent={next.accent}
+                open={petalsOpen(msUntil(next, now))}
+                day={istOpensWhen(next.membersFrom, now) ?? ""}
+                label={`${next.title}, the next drop: opens ${formatIstOpening(next.membersFrom)}`}
+                x={hashString(user.id) % 2 ? 300 : 92}
