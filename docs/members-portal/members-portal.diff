+import { onDrawing, starFlowerFor } from "@/lib/portal/starFlowers";
+import { BIRTH_FLOWER_PATHS } from "./BirthFlowers";
+
+/*
+  Her month's flower in her garden's night sky (Phase 6, Written in your
+  sky): a decoration in a chunk of its own, fetched by the sky only at night
+  with her month known (never at dawn or the golden hour, and never by
+  day), with the month's star table and the twelve drawings it needs.
+
+  Before she has traced it, only its 6 to 8 stars are there, faint, where it
+  will rest, so tracing joins stars she has already seen overhead. Once it
+  is written: its single gold line and its stars, still, inside the arch
+  left of the moon and above the next drop's bud (starFlowers' sky
+  placement). It adds no animation of any kind.
+*/
+
+const GOLD = "#C99A4C";
+
+const SkyWritten = ({ month, written }: { month: number; written: boolean }) => {
+  const table = starFlowerFor(month);
+  const d = BIRTH_FLOWER_PATHS[month - 1];
+  if (table === null || !d) return null;
+  const [x, y, s] = table.sky;
+  return (
+    <g className={written ? "ig-sky-written" : "ig-sky-hers"} data-written={written ? month : undefined}>
+      {written && <path d={d} transform={`translate(${x} ${y}) scale(${s})`} fill="none" stroke={GOLD} strokeOpacity=".75" strokeWidth={0.75 / s} strokeLinecap="round" strokeLinejoin="round" />}
+      {table.stars.map((star, i) => {
+        const [dx, dy] = onDrawing(star, table.sheet);
+        return <circle key={i} cx={(x + s * dx).toFixed(1)} cy={(y + s * dy).toFixed(1)} r={written ? 1.6 : 1.1} fill="#E8C88A" opacity={written ? 0.9 : 0.5} />;
+      })}
+    </g>
+  );
+};
+
+export default SkyWritten;
