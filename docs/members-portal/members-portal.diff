+import type { Stone } from "@/lib/portal/stones";
+import { STONE_PETAL, petalTransform } from "@/lib/portal/species";
+import { LEAF_SAGE } from "@/lib/portal/brandFlower";
+
+/*
+  Her stone as a flower that holds the piece itself: five soft petals in the
+  month's tint edged in its hue, five inner petals in the hue, and at the
+  heart the heart-cut stone of the Birthstone Heart Necklace, in four thin
+  gold claws, with one glint. The same drawing at every size: the garden's
+  stone plant, the seed ceremony, the specimen card and the month chips.
+  Until her month is known it is a closed sage bud.
+
+  The ceremony also needs the bud before it opens: `.ig-stone-budcap` is that
+  closed bud in her hue, hidden by members.css and shown only while an
+  animation holds it.
+*/
+
+export const HEART = "M12 20.5C5 15 1.5 11 1.5 6.8C1.5 3.6 4 1.5 6.8 1.5C9 1.5 10.9 2.8 12 4.6C13.1 2.8 15 1.5 17.2 1.5C20 1.5 22.5 3.6 22.5 6.8C22.5 11 19 15 12 20.5Z";
+export const FACETS = "M12 4.6V20.5M1.8 7.4H22.2M6.8 1.5L12 7.4L17.2 1.5M12 7.4L5 13.5M12 7.4L19 13.5";
+const BUD = "M0-30C13-17 15-4 0 12C-15-4-13-17 0-30Z";
+
+/* A pale stone (April's crystal, June's light amethyst) gets a gold edge, so its petals hold on vellum. */
+const luminance = (hex: string) => {
+  const n = Number.parseInt(hex.slice(1), 16);
+  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
+  return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
+};
+const edgeOf = (stone: Stone) => (luminance(stone.hue) > 0.7 ? "rgb(128 97 42 / .5)" : stone.hue);
+
+type HeadProps = { stone: Stone | null; size: number; className?: string; x?: number; y?: number };
+
+export const StoneHead = ({ stone, size, className = "", x, y }: HeadProps) => (
+  <svg viewBox="-50 -50 100 100" x={x} y={y} width={size} height={size} className={`ig-stonehead ${className}`} aria-hidden>
+    {stone ? (
+      <>
+        <g className="ig-stone-outer">
+          {[0, 1, 2, 3, 4].map((i) => (
+            <path key={i} d={STONE_PETAL} transform={petalTransform(i * 72, 47)} fill={stone.tint} stroke={edgeOf(stone)} strokeWidth="1.3" />
+          ))}
+        </g>
+        <g className="ig-stone-inner">
+          {[0, 1, 2, 3, 4].map((i) => (
+            <path key={i} d={STONE_PETAL} transform={petalTransform(36 + i * 72, 29)} fill={stone.hue} opacity=".72" />
+          ))}
+        </g>
+        <g className="ig-stone-heart">
+          <g transform="translate(-12.5 -11.5) scale(1.04)">
+            <path d={HEART} fill={stone.hue} stroke="var(--nf-accent-strong)" strokeWidth=".9" />
+            <path d={FACETS} fill="none" stroke="#FFF8EE" strokeOpacity=".5" strokeWidth=".6" />
+          </g>
+        </g>
+        <g transform="translate(-17 -24)">
+          <path className="ig-glint" d="M0-9L1.4-1.4L9 0L1.4 1.4L0 9L-1.4 1.4L-9 0L-1.4-1.4Z" fill="#FFF8EE" stroke="var(--nf-accent)" strokeWidth=".7" />
+        </g>
+        <g className="ig-stone-budcap">
+          <path d={BUD} fill={stone.hue} />
+          <path d={BUD} fill="none" stroke="var(--nf-accent)" strokeWidth="1.1" />
+          <path d="M0 12C-8 6-16 8-20 2M0 12C8 6 16 8 20 2" fill="none" stroke={LEAF_SAGE} strokeWidth="2" />
+        </g>
+      </>
+    ) : (
+      <>
+        <path d={BUD} fill={LEAF_SAGE} opacity=".85" />
+        <path d={BUD} fill="none" stroke="var(--nf-accent)" strokeWidth="1.2" />
+        <path d="M0 12C-8 6-16 8-20 2M0 12C8 6 16 8 20 2" fill="none" stroke={LEAF_SAGE} strokeWidth="2" />
+      </>
+    )}
+  </svg>
+);
+
+/* The whole stone plant for the garden: a tall stem with two leaves and the head. */
+export const StonePlant = ({ stone }: { stone: Stone | null }) => (
+  <svg viewBox="-40 -170 80 170" className="ig-sway-art" aria-hidden>
+    <path d="M0 0C-3-40 6-80 0-122" fill="none" stroke={LEAF_SAGE} strokeWidth="2.2" strokeLinecap="round" />
+    <path d="M-1-38C-14-40-24-50-26-64C-12-60-4-52-1-38Z" fill={LEAF_SAGE} />
+    <path d="M2-70C14-72 22-82 24-96C11-92 4-84 2-70Z" fill={LEAF_SAGE} />
+    <StoneHead stone={stone} size={80} x={-40} y={-170} />
+  </svg>
+);
