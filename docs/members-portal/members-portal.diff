+import { beforeEach, describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { MEMBER_FIELDS, PORTAL_STORE_KEY, forgetMemberOnDevice } from "./forgetDevice";
+
+/* Signing out clears what the garden kept on this phone about her, and keeps the phone's own conveniences. */
+
+const store = () => JSON.parse(window.localStorage.getItem(PORTAL_STORE_KEY) ?? "{}");
+
+beforeEach(() => window.localStorage.clear());
+
+describe("signing out on a phone", () => {
+  it("clears her saved pieces, visit days, pressed flowers and arrival answers, and keeps the sizer's measurement", () => {
+    window.localStorage.setItem(
+      PORTAL_STORE_KEY,
+      JSON.stringify({
+        savedSync: { u: "u-1", h: ["a"], x: [] },
+        lastVisitLocal: { u: "u-1", day: "2026-11-05", since: null },
+        pressedLocal: ["d"],
+        pressedOn: { d: "2026-11-01" },
+        pressedFor: "u-1",
+        early: { d: true },
+        arrival: { "u-1": { join: true }, "u-2": { consent: true } },
+        cardCal: { key: "390x844@3", pxPerMm: 6.04 },
+        doorsDay: "2026-11-05",
+        seedSeen: true,
+      }),
+    );
+    forgetMemberOnDevice("u-1");
+    expect(store()).toEqual({ arrival: { "u-2": { consent: true } }, cardCal: { key: "390x844@3", pxPerMm: 6.04 }, doorsDay: "2026-11-05", seedSeen: true });
+  });
+
+  it("leaves another member's pressed flowers on a shared phone", () => {
+    window.localStorage.setItem(PORTAL_STORE_KEY, JSON.stringify({ pressedLocal: ["d"], pressedFor: "u-2" }));
+    forgetMemberOnDevice("u-1");
+    expect(store()).toEqual({ pressedLocal: ["d"], pressedFor: "u-2" });
+  });
+
+  it("never throws on an empty or broken store", () => {
+    expect(() => forgetMemberOnDevice("u-1")).not.toThrow();
+    window.localStorage.setItem(PORTAL_STORE_KEY, "{not json");
+    expect(() => forgetMemberOnDevice("u-1")).not.toThrow();
+  });
+
+  it("names the portal's own store and fields", () => {
+    const portal = readFileSync(resolve(__dirname, "../portal/safeStorage.ts"), "utf8");
+    expect(portal).toMatch(new RegExp(`PORTAL_KEY = "${PORTAL_STORE_KEY}"`));
+    for (const field of MEMBER_FIELDS) expect(portal).toMatch(new RegExp(`\\b${field}\\?:`));
+  });
+});
diff --git a/src/lib/auth/forgetDevice.ts b/src/lib/auth/forgetDevice.ts
new file mode 100644
index 0000000..bccc79b
--- /dev/null
+++ b/src/lib/auth/forgetDevice.ts
@@ -0,0 +1,43 @@
+/*
+  Signing out on a phone: what the members' garden kept on this device about
+  her, and only her, is cleared, so the next person to use the phone cannot
+  read it in the browser's storage. That is the drawer's record of her saved
+  pieces (tagged with her account id), the days of her visits, the pressed
+  flowers' days and owner, and which arrival questions she was shown here
+  (on her first visit only). Conveniences that are the phone's own (the
+  ring sizer's measurement of this screen, which welcome screens were seen)
+  stay.
+
+  It reads the portal's own store by its key, without importing the portal
+  (Account is its own chunk and must not pull the portal in); a test keeps
+  the key and the fields in step with lib/portal/safeStorage.ts.
+*/
+
+export const PORTAL_STORE_KEY = "naira-portal";
+
+/** Hers alone: cleared on sign-out. */
+export const MEMBER_FIELDS = ["savedSync", "lastVisitLocal", "pressedFor", "pressedLocal", "pressedOn", "early"] as const;
+
+export const forgetMemberOnDevice = (userId: string | null | undefined): void => {
+  try {
+    const raw = window.localStorage.getItem(PORTAL_STORE_KEY);
+    if (!raw) return;
+    const store = JSON.parse(raw) as Record<string, unknown> | null;
+    if (!store || typeof store !== "object" || Array.isArray(store)) return;
+    // Pressed flowers moved into another member's account are not hers to clear.
+    const pressedHers = !store.pressedFor || store.pressedFor === userId;
+    for (const field of MEMBER_FIELDS) {
+      if (!pressedHers && (field === "pressedFor" || field === "pressedLocal" || field === "pressedOn")) continue;
+      delete store[field];
+    }
+    const arrival = store.arrival;
+    if (userId && arrival && typeof arrival === "object" && !Array.isArray(arrival)) {
+      const rest = { ...(arrival as Record<string, unknown>) };
+      delete rest[userId];
+      store.arrival = rest;
+    }
+    window.localStorage.setItem(PORTAL_STORE_KEY, JSON.stringify(store));
+  } catch {
+    /* blocked storage: nothing was kept */
+  }
+};
