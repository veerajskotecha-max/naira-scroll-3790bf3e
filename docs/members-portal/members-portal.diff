+import { useCallback, useEffect, useMemo, useRef, useState, type KeyboardEvent as ReactKeyboardEvent, type PointerEvent as ReactPointerEvent } from "react";
+import { useMember } from "./MemberContext";
+import { BIRTH_FLOWER_PATHS } from "./BirthFlowers";
+import { burstPetals } from "./PetalBurst";
+import { PETAL_IDS, PETAL_SPARK } from "./PetalSymbols";
+import { outlineButton, quietButton } from "./styles";
+import { hashString, mulberry32 } from "@/lib/portal/gardenLayout";
+import { EASE_REVEAL, play, stillMotion } from "@/lib/portal/motion";
+import { BITS, STARS, fitsOnAccount, keepStars, playOf } from "@/lib/portal/petals";
+import { SHEET, starFlowerFor } from "@/lib/portal/starFlowers";
+import { stoneForMonth } from "@/lib/portal/stones";
+import "./stars.css";
+
+/*
+  Written in your sky (Phase 6): a square of night that opens under her
+  garden, after dark, where she traces her month's birth flower star by
+  star. A chunk of its own, fetched only at night, with her month known,
+  once "Look up" is near or tapped.
+
+  The stars sit on her month's own drawing (starFlowers.ts, on
+  BirthFlowers' line); the next to join is a little brighter. She may tap
+  the next star, drag a finger from star to star, press "Join the next
+  star", or "Draw it for me": each is enough on its own. A gold hairline
+  draws between each pair (stroke-dashoffset, 300 ms); the line under her
+  finger is one element moved by transform alone. A wrong star gives a
+  tiny shake: no penalty, no count of tries. With the last star the
+  flower's single gold line draws through them (900 ms), a few starlight
+  petals open (12 at most), and her account keeps it (keepStars, bit 5 of
+  naira.p, written once). From then on it rests in her night sky.
+
+  Each star is a button with a 56-unit target (44 CSS px or more even on a
+  320 px phone); only the next is in the tab order (and the only one a tap
+  can focus), and focus shows as a gold ring. A plain click, as a screen
+  reader or switch sends it, joins a star too. Escape closes the sheet. No
+  frame loop, no timer and no twinkle: the bed's fireflies stay the
+  screen's one loop. Under reduced motion and Data Saver every line and the
+  flower are there at once, and nothing bursts or shakes.
+
+  Opened, the sheet comes up into the band between the shop's header and
+  the garden path (unless it is there already), so the first star she
+  joins is in sight; with the last star, the words she earned come above
+  the path too. A touch that starts on a star belongs to the trace, not to
+  the page's scroll; one that starts on the empty sky still scrolls. Once
+  written, the hairlines she drew fade back under the flower's line.
+
+  Her garden's sky, not a real one: nothing here reads the stars.
+*/
+
+type Props = {
+  month: number;
+  /** Closes the sheet (focus goes back to "Look up"). */
+  onClose: () => void;
+};
+
+type Pt = readonly [number, number];
+const HIT = 28;
+const near = (a: Pt, b: Pt, r = HIT) => Math.hypot(a[0] - b[0], a[1] - b[1]) <= r;
+
+/* Already in sight: between the bottom of the shop's fixed header and the top of the garden path. */
+const inBand = (el: Element) => {
+  const r = el.getBoundingClientRect();
+  const top = document.querySelector("header")?.getBoundingClientRect().bottom ?? 0;
+  const bottom = document.querySelector(".ig-nav")?.getBoundingClientRect().top ?? window.innerHeight;
+  return r.top >= top && r.bottom <= bottom;
+};
+
+/* The faint scatter of her garden's sky, seeded from her id: the same on every visit. */
+const scatterFor = (seed: string, avoid: readonly Pt[]) => {
+  const rand = mulberry32(hashString(`${seed || "naira"}:sheet`));
+  const out: { x: number; y: number; r: number; o: number; gold: boolean }[] = [];
+  for (let i = 0; out.length < 34 && i < 160; i++) {
+    const x = 14 + rand() * (SHEET - 28);
+    const y = 14 + rand() * (SHEET - 28);
+    const r = 0.5 + rand() * 0.8;
+    const o = 0.22 + rand() * 0.4;
+    const gold = rand() < 0.35;
+    if (avoid.some((p) => near(p, [x, y], 18)) || near([304, 58], [x, y], 26)) continue;
+    out.push({ x, y, r, o, gold });
+  }
+  return out;
+};
+
+/* Art colours, inside the drawing only. */
+const GOLD = "#C99A4C";
+const GOLD_LIGHT = "#E8C88A";
+const IVORY = "#F4EBE2";
+const INK = "#1A1614";
+
+const StarSheet = ({ month, onClose }: Props) => {
+  const { user, naira, changeMeta } = useMember();
+  const table = starFlowerFor(month);
+  const stone = stoneForMonth(month);
+  const flower = stone?.flower.toLowerCase() ?? "";
+  const stars = useMemo(() => table?.stars ?? [], [table]);
+  const n = stars.length;
+  const written = Boolean(playOf(naira) & STARS);
+  const [still] = useState(stillMotion);
+  const [joined, setJoined] = useState(() => (written ? n : 0));
+  const [said, setSaid] = useState(() => (written && stone ? `${stone.monthName}'s flower, the ${flower}, written in your sky.` : ""));
+  const joinedRef = useRef(joined);
+  joinedRef.current = joined;
+  const kept = useRef(written);
+  const rootRef = useRef<HTMLElement>(null);
+  const frameRef = useRef<HTMLDivElement>(null);
+  const svgRef = useRef<SVGSVGElement>(null);
+  const dragRef = useRef<SVGLineElement>(null);
+  const burstRef = useRef<HTMLDivElement>(null);
+  const saidRef = useRef<HTMLParagraphElement>(null);
+  const flowerRef = useRef<SVGPathElement>(null);
+  const dragging = useRef<number | null>(null);
+  // The star her pointer last pressed: the click that follows that press is the same join, not a second one.
+  const pressed = useRef(-1);
+  // Focus moves to the next star once it has rendered as the tab stop (and, after "Trace it again", to the first).
+  const refocus = useRef(false);
+  // The last star has just joined: the words she earned are brought into sight once they are there.
+  const showSaid = useRef(false);
+  const made = useRef<Animation[]>([]);
+  const drawn = useRef(joined);
+  const scatter = useMemo(() => scatterFor(user.id, stars), [user.id, stars]);
+  const done = joined >= n && n > 0;
+
+  const keep = (a: Animation | null) => {
+    if (a) made.current.push(a);
+  };
+
+  // Opened, the sheet comes into sight, and the next star (or, once written, the line that says so) takes focus.
+  useEffect(() => {
+    const root = rootRef.current;
+    if (root && frameRef.current && !inBand(frameRef.current)) root.scrollIntoView?.({ block: "start", behavior: still ? "auto" : "smooth" });
+    const first = svgRef.current?.querySelector<SVGGElement>(".ig-star.is-next");
+    if (first) first.focus({ preventScroll: true });
+    else saidRef.current?.focus({ preventScroll: true });
+    return () => {
+      made.current.forEach((a) => a.cancel());
+      made.current = [];
+    };
+    // On opening only.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  // A touch that starts on a star is hers to drag from star to star: the page must not take it for a scroll.
+  // (React's own touch listeners are passive, so this one is the sheet's own; a touch on the empty sky still scrolls.)
+  useEffect(() => {
+    const svg = svgRef.current;
+    if (!svg) return;
+    const hold = (e: TouchEvent) => {
+      const t = e.touches[0];
+      const box = svg.getBoundingClientRect();
+      if (!t || !box.width) return;
+      // Her pointer has already joined a star and armed the drag (pointerdown comes first), or the touch is on a star of a trace not yet done.
+      const p: Pt = [((t.clientX - box.left) / box.width) * SHEET, ((t.clientY - box.top) / box.height) * SHEET];
+      if (dragging.current !== null || (joinedRef.current < n && stars.some((s) => near(s, p)))) e.preventDefault();
+    };
+    svg.addEventListener("touchstart", hold, { passive: false });
+    return () => svg.removeEventListener("touchstart", hold);
+  }, [n, stars]);
+
+  // With the last star, the words she earned come above the garden path (once her finger is off the glass: a scroll during her drag would be cancelled by it).
+  const bringSaid = () => {
+    const el = saidRef.current;
+    const path = document.querySelector(".ig-nav")?.getBoundingClientRect().top ?? window.innerHeight;
+    if (el && el.getBoundingClientRect().bottom > path - 8) el.scrollIntoView?.({ block: "end", behavior: still ? "auto" : "smooth" });
+  };
+  useEffect(() => {
+    if (!showSaid.current || !said || dragging.current !== null) return;
+    showSaid.current = false;
+    bringSaid();
+    // As the words arrive.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [said]);
+
+  // Each newly joined pair's hairline draws in; with the last star, the flower, the petals and her account.
+  useEffect(() => {
+    const svg = svgRef.current;
+    const from = drawn.current;
+    drawn.current = joined;
+    if (refocus.current) {
+      refocus.current = false;
+      svg?.querySelector<SVGGElement>(".ig-star.is-next")?.focus({ preventScroll: true });
+    }
+    if (!svg || joined <= from) return;
+    if (!still) {
+      for (let k = Math.max(1, from); k < joined; k++) {
+        keep(play(svg.querySelector(`[data-join="${k}"]`), [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 300, delay: (k - Math.max(1, from)) * 140, easing: EASE_REVEAL, fill: "backwards" }));
+      }
+    }
+    if (joined < n || !stone) return;
+    const lead = still ? 0 : Math.max(0, joined - Math.max(1, from) - 1) * 140 + 260;
+    if (!still) {
+      keep(play(flowerRef.current, [{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], { duration: 900, delay: lead, easing: "cubic-bezier(0.45, 0, 0.25, 1)", fill: "backwards" }));
+      const box = svg.getBoundingClientRect();
+      const k = box.width / SHEET;
+      // From the last star, kept inside the drawing, so the spray stays on the sheet (most months end at its top edge); two thirds ivory, to show on ink.
+      const [hx, hy] = stars[n - 1];
+      burstPetals(burstRef.current, Math.min(Math.max(hx, 100), SHEET - 100) * k, Math.max(hy, 100) * k, { count: 12, spread: 95 * Math.max(0.8, k), size: [10, 16], delay: lead + 700, ids: [PETAL_IDS[3], PETAL_SPARK, PETAL_IDS[1], PETAL_IDS[3]] }).forEach(keep);
+    }
+    showSaid.current = true;
+    // Her account keeps it, or (with no room) it is written for this visit only, and said so.
+    setSaid(fitsOnAccount(naira, BITS.stars) ? `${stone.monthName}'s flower, the ${flower}, written in your sky.` : `${stone.monthName}'s flower, the ${flower}, written in your sky for this visit: your account has no room to keep it just now.`);
+    if (!kept.current) {
+      kept.current = true;
+      changeMeta(keepStars);
+    }
+    // The buttons that led here are gone: the line that says it takes focus.
+    saidRef.current?.focus({ preventScroll: true });
+    // Read as each star joins.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [joined]);
+
+  const shake = (i: number) => {
+    if (still) return;
+    keep(play(svgRef.current?.querySelector(`[data-star="${i}"] .ig-star-dot`), [{ transform: "translateX(0px)" }, { transform: "translateX(-4px)" }, { transform: "translateX(4px)" }, { transform: "translateX(-2px)" }, { transform: "translateX(0px)" }], { duration: 260, easing: EASE_REVEAL }));
+  };
+
+  const join = useCallback(
+    (i: number) => {
+      const at = joinedRef.current;
+      if (at >= n) return;
+      if (i !== at) {
+        shake(i);
+        return;
+      }
+      joinedRef.current = at + 1;
+      // The next star takes focus once it is the tab stop, as a roving tab stop does.
+      refocus.current = Boolean(document.activeElement?.closest?.(".ig-stars-sky"));
+      setJoined(at + 1);
+    },
+    // `shake` reads only `still` and the sheet.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [n],
+  );
+
+  const drawAll = () => {
+    joinedRef.current = n;
+    setJoined(n);
+  };
+
+  const again = () => {
+    made.current.forEach((a) => a.cancel());
+    made.current = [];
+    drawn.current = 0;
+    joinedRef.current = 0;
+    // Its button is gone: the first star takes focus.
+    refocus.current = true;
+    setJoined(0);
+    setSaid("");
+  };
+
+  /* Her finger, in the sheet's own units. */
+  const toSheet = (e: ReactPointerEvent<SVGSVGElement>): Pt | null => {
+    const box = svgRef.current?.getBoundingClientRect();
+    if (!box || !box.width) return null;
+    return [((e.clientX - box.left) / box.width) * SHEET, ((e.clientY - box.top) / box.height) * SHEET];
+  };
+
+  /* The line under her finger: one element, moved by transform alone. */
+  const pull = (to: Pt | null) => {
+    const line = dragRef.current;
+    if (!line) return;
+    const at = joinedRef.current;
+    if (!to || at < 1 || at >= n) {
+      line.style.opacity = "0";
+      return;
+    }
+    const [fx, fy] = stars[at - 1];
+    const len = Math.hypot(to[0] - fx, to[1] - fy);
+    const turn = (Math.atan2(to[1] - fy, to[0] - fx) * 180) / Math.PI;
+    line.style.transform = `translate(${fx.toFixed(1)}px, ${fy.toFixed(1)}px) rotate(${turn.toFixed(1)}deg) scaleX(${len.toFixed(1)})`;
+    line.style.opacity = "1";
+  };
+
+  const down = (e: ReactPointerEvent<SVGSVGElement>) => {
+    const p = toSheet(e);
+    pressed.current = -1;
+    if (!p || done) return;
+    // The nearest star not yet joined, within its target.
+    let hit = -1;
+    stars.forEach((s, i) => {
+      if (i >= joinedRef.current && near(s, p) && (hit < 0 || Math.hypot(s[0] - p[0], s[1] - p[1]) < Math.hypot(stars[hit][0] - p[0], stars[hit][1] - p[1]))) hit = i;
+    });
+    if (hit < 0) return;
+    pressed.current = hit;
+    if (hit !== joinedRef.current) {
+      shake(hit);
+      return;
+    }
+    join(hit);
+    dragging.current = e.pointerId;
+    try {
+      e.currentTarget.setPointerCapture(e.pointerId);
+    } catch {
+      /* an old browser: the drag still follows while over the sheet */
+    }
+  };
+
+  const move = (e: ReactPointerEvent<SVGSVGElement>) => {
+    if (dragging.current !== e.pointerId) return;
+    const p = toSheet(e);
+    const at = joinedRef.current;
+    if (p && at < n && near(stars[at], p)) join(at);
+    pull(joinedRef.current < n ? p : null);
+  };
+
+  const up = (e: ReactPointerEvent<SVGSVGElement>) => {
+    if (dragging.current !== e.pointerId) return;
+    dragging.current = null;
+    pull(null);
+    if (showSaid.current && joinedRef.current >= n) {
+      showSaid.current = false;
+      bringSaid();
+    }
+  };
+
+  /* A click with no press before it (a screen reader's or a switch's) joins the star; the click after her own press does not join twice. */
+  const onStarClick = (i: number) => () => {
+    if (pressed.current === i) {
+      pressed.current = -1;
+      return;
+    }
+    join(i);
+  };
+
+  const onStarKey = (i: number) => (e: ReactKeyboardEvent) => {
+    if (e.key !== "Enter" && e.key !== " ") return;
+    e.preventDefault();
+    join(i);
+  };
+
+  const onKey = (e: ReactKeyboardEvent) => {
+    if (e.key !== "Escape") return;
+    e.preventDefault();
+    onClose();
+  };
+
+  if (table === null || stone === null) return null;
+  const [tx, ty, s] = table.sheet;
+  return (
+    <section ref={rootRef} id="ig-stars" className="ig-stars" aria-labelledby="ig-stars-h" onKeyDown={onKey}>
+      <h2 id="ig-stars-h" className="ig-lede">
+        Your {flower}, in your garden's stars
+      </h2>
+      <div ref={frameRef} className="ig-stars-frame">
+        <svg
+          ref={svgRef}
+          viewBox={`0 0 ${SHEET} ${SHEET}`}
+          className={`ig-stars-sky${done ? " is-written" : ""}${still ? " is-still" : ""}`}
+          role="group"
+          aria-label={`Your garden's night sky. Trace your ${flower} star by star.`}
+          onPointerDown={down}
+          onPointerMove={move}
+          onPointerUp={up}
+          onPointerCancel={up}
+        >
+          <rect width={SHEET} height={SHEET} fill={INK} />
+          {scatter.map((p, i) => (
+            <circle key={i} cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r={p.r.toFixed(2)} fill={p.gold ? GOLD : IVORY} opacity={p.o.toFixed(2)} />
+          ))}
+          <g aria-hidden>
+            <circle cx="304" cy="58" r="15" fill={IVORY} stroke={GOLD} strokeWidth=".6" />
+            <circle cx="310" cy="53.5" r="13.4" fill={INK} />
+          </g>
+          {stars.slice(1, Math.max(1, joined)).map((p, k) => {
+            const [ax, ay] = stars[k];
+            return <line key={k} data-join={k + 1} x1={ax} y1={ay} x2={p[0]} y2={p[1]} pathLength={1} strokeDasharray="1 1" stroke={GOLD} className="ig-stars-join" />;
+          })}
+          <line ref={dragRef} x1="0" y1="0" x2="1" y2="0" className="ig-stars-pull" stroke={GOLD_LIGHT} vectorEffect="non-scaling-stroke" pointerEvents="none" style={{ opacity: 0 }} />
+          {done && (
+            <path
+              ref={flowerRef}
+              d={BIRTH_FLOWER_PATHS[month - 1]}
+              transform={`translate(${tx} ${ty}) scale(${s})`}
+              pathLength={1}
+              strokeDasharray="1 1"
+              fill="none"
+              stroke={GOLD_LIGHT}
+              strokeWidth={1.3 / s}
+              strokeLinecap="round"
+              strokeLinejoin="round"
+              aria-hidden
+            />
+          )}
+          {stars.map(([x, y], i) => {
+            const isNext = i === joined;
+            const isJoined = i < joined;
+            return (
+              <g
+                key={i}
+                data-star={i}
+                className={`ig-star${isNext ? " is-next" : ""}${isJoined ? " is-joined" : ""}`}
+                transform={`translate(${x} ${y})`}
+                role="button"
+                tabIndex={isNext ? 0 : undefined}
+                aria-label={`Star ${i + 1} of your ${flower}${isJoined ? ", joined" : ""}`}
+                aria-disabled={isJoined || !isNext ? true : undefined}
+                onClick={onStarClick(i)}
+                onKeyDown={onStarKey(i)}
+              >
+                <circle r={HIT} fill="transparent" />
+                <circle r="13" className="ig-star-ring" fill="none" stroke={GOLD_LIGHT} strokeWidth="1.2" />
+                <g className="ig-star-dot">
+                  <circle r={isNext ? 9 : 6} fill={GOLD} opacity={isNext ? 0.22 : 0.12} />
+                  <path d={isNext ? "M0-7L1.6-1.6L7 0L1.6 1.6L0 7L-1.6 1.6L-7 0L-1.6-1.6Z" : "M0-5L1.2-1.2L5 0L1.2 1.2L0 5L-1.2 1.2L-5 0L-1.2-1.2Z"} fill={isJoined ? GOLD_LIGHT : isNext ? "#FFF6D8" : GOLD} />
+                </g>
+              </g>
+            );
+          })}
+        </svg>
+        <div ref={burstRef} className="ig-stars-burst" aria-hidden />
+      </div>
+      <p ref={saidRef} tabIndex={-1} role="status" className="ig-lede ig-stars-said">
+        {said}
+      </p>
+      <div className="ig-stars-actions">
+        {done ? (
+          <button type="button" className={quietButton} onClick={again}>
+            Trace it again
+          </button>
+        ) : (
+          <>
+            <button type="button" className={outlineButton} onClick={() => join(joinedRef.current)}>
+              Join the next star
+            </button>
+            <button type="button" className={quietButton} onClick={drawAll}>
+              Draw it for me
+            </button>
+          </>
+        )}
+        <button type="button" className={quietButton} onClick={onClose}>
+          Close the sky
+        </button>
+      </div>
+    </section>
+  );
+};
+
+export default StarSheet;
