diff --git a/src/lib/catalogue.ts b/src/lib/catalogue.ts
new file mode 100644
index 0000000..666bd5c
--- /dev/null
+++ b/src/lib/catalogue.ts
@@ -0,0 +1,20 @@
+import { fetchShopifyProducts } from "@/lib/shopify";
+import { routeKeyFor } from "@/lib/routeCode";
+
+/* The live jewellery catalogue query, shared by useLiveJewellery and main.tsx. */
+export const CATALOGUE_KEY = ["shopify-products", "jewellery-catalogue"] as const;
+export const fetchCatalogue = () => fetchShopifyProducts(250);
+
+/*
+  Pages whose first screen is drawn from the catalogue. Their pre-built HTML
+  shows the live pieces, but React's first render used the bundled list (21
+  pieces, no Prism Rivière), so on a slower phone the grid was swapped twice
+  as the page came alive: the card under the shopper's thumb moved and taps
+  landed on the wrong piece. On these pages React waits, a little, for the
+  catalogue so its first render is the page already on screen.
+*/
+const CATALOGUE_PAGES = new Set(["Jewellery", "JewelleryCategory", "JewelDetailNext"]);
+export const pageNeedsCatalogue = (pathname: string) => {
+  const key = routeKeyFor(pathname);
+  return key !== null && CATALOGUE_PAGES.has(key);
+};
