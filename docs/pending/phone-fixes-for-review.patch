+import { describe, expect, it } from "vitest";
+import type { JewelPiece } from "@/data/jewellery";
+import { parseQuery, searchPieces, shopPageFor } from "./search";
+
+const piece = (p: Partial<JewelPiece> & Pick<JewelPiece, "handle" | "name" | "category" | "price">): JewelPiece => ({
+  sku: "",
+  number: "",
+  priceLabel: `₹${p.price}`,
+  variantId: "gid://shopify/ProductVariant/1",
+  availableForSale: true,
+  image: "",
+  blurb: "",
+  materials: "",
+  ...p,
+});
+
+/* In catalogue order, earrings first, as the shop lists them. */
+const catalogue = [
+  piece({ handle: "molten-bloom-hoops", name: "Molten Bloom Hoops", category: "Earrings", price: 1300, tags: ["18k Gold Tone Plated", "Demi Fine"] }),
+  piece({ handle: "ribbon-bow-earrings", name: "Ribbon Bow Earrings", category: "Earrings", price: 1599, tags: ["Cubic Zirconia"] }),
+  piece({ handle: "solitaire-whisper-studs", name: "Solitaire Whisper Studs", category: "Earrings", price: 1099, tags: ["Rhodium Silver Tone Plated", "Cubic Zirconia"] }),
+  piece({ handle: "prism-riviere-bracelet", name: "Prism Rivière Bracelet", category: "Bracelets", price: 2399, tags: ["Cubic Zirconia"] }),
+  piece({ handle: "star-point-band", name: "Star Point Band", category: "Rings", price: 799, options: [{ name: "Metal", values: ["Gold", "Silver"] }] }),
+  piece({ handle: "cushion-halo-ring", name: "Cushion Halo Ring", category: "Rings", price: 1199, tags: ["18k Gold Tone Plated"] }),
+  piece({ handle: "golden-duet-ring", name: "Golden Duet Ring", category: "Rings", price: 1399 }),
+  piece({ handle: "pearl-legacy-necklace", name: "Pearl Legacy Necklace", category: "Necklaces", price: 1799, tags: ["Pearl"] }),
+  piece({ handle: "bold-nocturne-chain", name: "Bold Nocturne Chain", category: "Necklaces", price: 1799 }),
+];
+const handles = (q: string) => searchPieces(catalogue, q).map((p) => p.handle);
+
+describe("searchPieces", () => {
+  it("finds rings for 'ring', not the earrings that contain the letters", () => {
+    expect(handles("ring")).toEqual(["cushion-halo-ring", "golden-duet-ring", "star-point-band"]);
+    expect(handles("Rings")).toEqual(["cushion-halo-ring", "golden-duet-ring", "star-point-band"]);
+  });
+
+  it("puts a name match ahead of a category match", () => {
+    expect(handles("ring")[0]).toBe("cushion-halo-ring");
+  });
+
+  it("ignores accents", () => {
+    expect(handles("riviere")).toEqual(["prism-riviere-bracelet"]);
+  });
+
+  it("needs every word, wherever it appears", () => {
+    // Star Point Band is sold in gold as well as silver.
+    expect(handles("gold ring")).toEqual(["golden-duet-ring", "cushion-halo-ring", "star-point-band"]);
+    expect(handles("silver studs")).toEqual(["solitaire-whisper-studs"]);
+    expect(handles("silver ring")).toEqual(["star-point-band"]);
+  });
+
+  it("understands the stone and the misspellings shoppers type", () => {
+    expect(handles("zircone")).toEqual(["ribbon-bow-earrings", "solitaire-whisper-studs", "prism-riviere-bracelet"]);
+    expect(handles("earing")).toEqual(["ribbon-bow-earrings", "molten-bloom-hoops", "solitaire-whisper-studs"]);
+  });
+
+  it("filters by price", () => {
+    expect(handles("Under 1500")).toEqual(["molten-bloom-hoops", "solitaire-whisper-studs", "star-point-band", "cushion-halo-ring", "golden-duet-ring"]);
+    expect(handles("rings under ₹1,200")).toEqual(["cushion-halo-ring", "star-point-band"]);
+    expect(handles("necklace above 1500")).toEqual(["pearl-legacy-necklace", "bold-nocturne-chain"]);
+  });
+
+  it("returns nothing for a query that matches nothing, and for an empty one", () => {
+    expect(handles("xyzzy")).toEqual([]);
+    expect(handles("  ")).toEqual([]);
+  });
+});
+
+describe("parseQuery", () => {
+  it("reads price bounds and the category", () => {
+    expect(parseQuery("rings under 1,500")).toMatchObject({ terms: ["ring"], max: 1500, min: null, category: "Rings" });
+    expect(parseQuery("2000+")).toMatchObject({ terms: [], max: null, min: 2000, category: null });
+    expect(parseQuery("gold earrings and rings").category).toBeNull();
+  });
+});
+
+describe("shopPageFor", () => {
+  it("sends category and price searches to the shop page, filtered", () => {
+    expect(shopPageFor("rings")).toBe("/jewellery?category=Rings");
+    expect(shopPageFor("under 1500")).toBe("/jewellery?under=1500");
+    expect(shopPageFor("earrings under 1000")).toBe("/jewellery?category=Earrings&under=1000");
+  });
+
+  it("leaves other searches to the results list", () => {
+    expect(shopPageFor("gold ring")).toBeNull();
+    expect(shopPageFor("pearl")).toBeNull();
+  });
+});
diff --git a/src/lib/search.ts b/src/lib/search.ts
new file mode 100644
index 0000000..ab10118
--- /dev/null
+++ b/src/lib/search.ts
@@ -0,0 +1,139 @@
+import type { JewelCategory, JewelPiece } from "@/data/jewellery";
+
+/*
+  Shop search over the jewellery catalogue.
+
+  It used to keep any piece whose "title category tags" text contained the
+  query, in catalogue order, so "ring" listed six earrings (EarRINGS) before
+  the first ring, "riviere" missed Prism Rivière, "gold ring" and
+  "silver studs" found nothing, and three of the five Popular chips
+  ("Zircone", "Gifting", "Under 1500") always said "Nothing matches".
+
+  Now every word of the query must start a word of the piece (name first,
+  then category, then tags, metals and stones), accents and plurals are
+  ignored, the stone and price words shoppers use are understood, and the
+  best match comes first.
+*/
+
+export const normalise = (text: string) =>
+  text.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
+
+const words = (text: string) => normalise(text).split(/[^a-z0-9]+/).filter(Boolean);
+
+/* "rings" → "ring", "earrings" → "earring", but "glass" stays "glass". */
+const stem = (word: string) =>
+  word.length > 3 && word.endsWith("s") && !word.endsWith("ss") ? word.slice(0, -1) : word;
+
+const STOP = new Set(["a", "an", "and", "the", "for", "with", "in", "of", "my", "jewellery", "jewelry", "jewel", "piece", "rs", "inr"]);
+
+/* Words shoppers type for what the catalogue calls something else, and the
+   usual misspellings. Words that also appear in piece names (chain, band,
+   cuff, bangle) are left alone so they still find those pieces by name. */
+const SYNONYMS: Record<string, string> = {
+  zircone: "zirconia",
+  zircon: "zirconia",
+  cz: "zirconia",
+  diamond: "zirconia",
+  ad: "zirconia",
+  pendant: "necklace",
+  earing: "earring",
+  eraring: "earring",
+  neckles: "necklace",
+  neckle: "necklace",
+  necklac: "necklace",
+  braclet: "bracelet",
+  bracelate: "bracelet",
+  bracelat: "bracelet",
+};
+
+export const CATEGORY_WORDS: Record<string, JewelCategory> = {
+  ring: "Rings",
+  earring: "Earrings",
+  necklace: "Necklaces",
+  bracelet: "Bracelets",
+};
+
+export interface ParsedQuery {
+  terms: string[];
+  max: number | null;
+  min: number | null;
+  /** Set when the query names exactly one category ("rings", "gold earrings"). */
+  category: JewelCategory | null;
+}
+
+/** "under 1500", "below ₹1,500", "< 1500", "1500 below", "over 2000", "2000+" */
+export const parseQuery = (query: string): ParsedQuery => {
+  let text = normalise(query).replace(/₹/g, " ").replace(/(\d),(?=\d{3}\b)/g, "$1");
+  const price: { max: number | null; min: number | null } = { max: null, min: null };
+  const take = (re: RegExp, bound: "max" | "min") => {
+    text = text.replace(re, (_m, n: string) => {
+      price[bound] = Number(n);
+      return " ";
+    });
+  };
+  take(/(?:under|below|less than|upto|up to|within|<=?)\s*(\d{2,6})/g, "max");
+  take(/(\d{2,6})\s*(?:and\s+)?(?:under|below|or less|&\s*below)/g, "max");
+  take(/(?:over|above|more than|from|>=?)\s*(\d{2,6})/g, "min");
+  take(/(\d{2,6})\s*(?:\+|and above|& above|or more|plus)/g, "min");
+  const { max, min } = price;
+
+  const terms = words(text)
+    .filter((w) => !STOP.has(w))
+    .map(stem)
+    .map((w) => SYNONYMS[w] ?? w);
+  const named = [...new Set(terms.map((t) => CATEGORY_WORDS[t]).filter(Boolean))];
+  return { terms, max, min, category: named.length === 1 ? named[0] : null };
+};
+
+const matchWord = (fieldWords: string[], term: string) => {
+  let best = 0;
+  for (const w of fieldWords) {
+    if (w === term || stem(w) === term) return 2;
+    if (w.startsWith(term)) best = 1;
+  }
+  return best;
+};
+
+/** Pieces matching the query, best first; ties keep the catalogue's order. */
+export const searchPieces = (pieces: JewelPiece[], query: string): JewelPiece[] => {
+  const { terms, max, min } = parseQuery(query);
+  if (!terms.length && max === null && min === null) return [];
+  const scored: Array<[number, number, JewelPiece]> = [];
+  pieces.forEach((piece, index) => {
+    if (max !== null && piece.price > max) return;
+    if (min !== null && piece.price < min) return;
+    const name = words(piece.name);
+    const category = words(piece.category);
+    const extra = words(
+      [
+        ...(piece.tags ?? []),
+        piece.colour?.value ?? "",
+        ...(piece.options ?? []).flatMap((o) => o.values),
+        piece.materials ?? "",
+      ].join(" ")
+    );
+    let score = 0;
+    for (const term of terms) {
+      const inName = matchWord(name, term);
+      const inCategory = matchWord(category, term);
+      const s = inName ? 4 + inName : inCategory ? 3 + inCategory : matchWord(extra, term);
+      if (!s) return; // every word has to match somewhere
+      score += s;
+    }
+    scored.push([score, index, piece]);
+  });
+  return scored.sort((a, b) => b[0] - a[0] || a[1] - b[1]).map(([, , piece]) => piece);
+};
+
+/** Where "see all" and the keyboard's Go/Enter take the shopper, if the query maps onto the shop page. */
+export const shopPageFor = (query: string): string | null => {
+  const { terms, max, min, category } = parseQuery(query);
+  const onlyCategory = terms.every((t) => CATEGORY_WORDS[t]);
+  if (!category && max === null && min === null) return null;
+  if (!onlyCategory) return null;
+  const params = new URLSearchParams();
+  if (category) params.set("category", category);
+  if (max !== null) params.set("under", String(max));
+  if (min !== null) params.set("over", String(min));
+  return `/jewellery?${params.toString()}`;
+};
