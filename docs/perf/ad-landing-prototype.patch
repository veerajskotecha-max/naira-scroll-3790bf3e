diff --git a/src/lib/lazyRoute.ts b/src/lib/lazyRoute.ts
new file mode 100644
index 0000000..20a65f1
--- /dev/null
+++ b/src/lib/lazyRoute.ts
@@ -0,0 +1,12 @@
+import { createElement, lazy, type ComponentType } from "react";
+
+/* PROTOTYPE: a React.lazy route that can be loaded before the first render.
+   Once preload() has resolved, the route renders synchronously — no Suspense
+   fallback, so React's first commit already contains the page. */
+export function lazyRoute(load: () => Promise<{ default: ComponentType }>) {
+  let Loaded: ComponentType | null = null;
+  const Lazy = lazy(() => load().then((m) => { Loaded = m.default; return m; }));
+  const Route = () => (Loaded ? createElement(Loaded) : createElement(Lazy));
+  Route.preload = () => load().then((m) => { Loaded = m.default; });
+  return Route;
+}
