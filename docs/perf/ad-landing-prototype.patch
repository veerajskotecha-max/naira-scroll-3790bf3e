+/* PROTOTYPE: load the landing route's code before React's first render, so
+   the first commit replaces the pre-built page with the same page, not with
+   an empty Suspense fallback. Resolves anyway after 4 s. */
+export const preloadRouteFor = (pathname: string): Promise<unknown> => {
+  const p = pathname.replace(/\/+$/, "") || "/";
+  const job =
+    /^\/jewellery\/collections\/[^/]+$/.test(p) ? JewelleryCategory.preload()
+    : /^\/jewellery\/[^/]+$/.test(p) ? JewelDetail.preload()
+    : p === "/jewellery" ? Jewellery.preload()
+    : Promise.resolve();
+  return Promise.race([job.catch(() => {}), new Promise((r) => setTimeout(r, 4000))]);
+};
