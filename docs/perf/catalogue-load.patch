+    .replace(/<link(?=[^>]*\brel="modulepreload")(?=[^>]*\bdata-deferred-preload\b)[^>]*>/gi, "");
+
+/*
+  Some imports are deferred on purpose. The 3D wordmark waits for load and an
+  idle moment because it "must not compete with the page for the first load";
+  the gift box waits until it is nearly on screen; the reels warm up when the
+  browser is idle. Vite's preload helper still announces each one with a
+  <link rel="modulepreload"> in <head> the moment its import() runs, and the
+  capture serialises the live DOM — so every one of those was being written
+  into the static HTML as an eager, high-priority download for every visitor.
+  On a product page that put 559 kB of three.js ahead of the product itself.
+
+  Runs in the capture browser before any page script. While the page is inside
+  a requestIdleCallback or IntersectionObserver callback — the two APIs that
+  exist to defer work — any modulepreload it adds is tagged, and clean() drops
+  exactly those. The helper appends its links synchronously inside import(),
+  so the attribution is exact rather than timing-based.
+
+  Everything else is kept on purpose: the route's own chunk and its imports
+  are announced while the page renders itself, and it needs them before it
+  works. Dropping those as well turns one parallel download into a waterfall.
+  On a modelled slow-4G product page, stripping every runtime preload made
+  add-to-cart usable 1.2 s LATER than doing nothing; stripping only the
+  deferred ones made it 2.8 s earlier.
+
+  It is a string, not a function: Playwright ships functions to the page via
+  toString(), and tsx wraps named inner functions in a __name() helper that
+  only exists in Node — the script would throw on its first line in the page
+  and silently tag nothing.
+*/
+const MARK_DEFERRED_PRELOADS = `(() => {
+  let deferred = 0;
+  const within = (fn) => function (...args) {
+    deferred += 1;
+    try { return fn.apply(this, args); } finally { deferred -= 1; }
+  };
+  const idle = window.requestIdleCallback && window.requestIdleCallback.bind(window);
+  if (idle) window.requestIdleCallback = (cb, opts) => idle(within(cb), opts);
+  const Observer = window.IntersectionObserver;
+  if (Observer) {
+    window.IntersectionObserver = class extends Observer {
+      constructor(cb, opts) { super(within(cb), opts); }
+    };
+  }
+  const append = HTMLHeadElement.prototype.appendChild;
+  HTMLHeadElement.prototype.appendChild = function (node) {
+    if (deferred > 0 && node instanceof HTMLLinkElement && node.rel === "modulepreload") {
+      node.setAttribute("data-deferred-preload", "");
+    }
+    return append.call(this, node);
+  };
+})();`;
 
