index 19bd296..24d3ae9 100644
--- a/scripts/prerender.ts
+++ b/scripts/prerender.ts
@@ -96,7 +96,28 @@ const clean = (html: string) =>
     */
     .replace(/<script[^>]+src="[^"]*(?:facebook\.net|facebook\.com|fbcdn\.net)[^"]*"[^>]*><\/script>/gi, "")
     .replace(/<link[^>]+href="[^"]*(?:facebook\.net|facebook\.com|fbcdn\.net)[^"]*"[^>]*\/?>/gi, "")
-    .replace(/<img[^>]+src="[^"]*facebook\.com\/tr[^"]*"[^>]*\/?>/gi, "");
+    .replace(/<img[^>]+src="[^"]*facebook\.com\/tr[^"]*"[^>]*\/?>/gi, "")
+    /*
+      Vite's runtime preload helper injects
+        <link rel="modulepreload" as="script" href="/assets/<chunk>.js">
+      into <head> for every chunk a dynamic import() reaches. The capture above
+      serialises the LIVE DOM after the app has mounted and run, so every chunk
+      this prerender happened to touch is written to disk as an eager,
+      high-priority preload — the exact opposite of what import() is for.
+
+      On a product page that shipped 19 preload links pulling 1.8 MB of
+      JavaScript ahead of everything else, including 559 kB of three.js that
+      only the animated wordmark ever loads, plus the reels bundle, the ring
+      sizer and the pincode checker. At 1.6 Mbit (Lighthouse's slow 4G, ~200
+      kB/s) that is most of a 20 second wait before the product is on screen.
+
+      The two kinds are easy to tell apart: preloads Vite writes into
+      index.html at build time — the entry's own static graph — carry no `as`
+      attribute, while every runtime-injected one sets as="script". Strip only
+      the latter. The router still import()s the route chunk the moment it
+      resolves; it just no longer drags the whole application with it.
+    */
+    .replace(/<link(?=[^>]*\brel="modulepreload")(?=[^>]*\bas="script")[^>]*>/gi, "");
 
 const routeToFile = (routePath: string) =>
   routePath === "/" ? join(DIST, "index.html") : join(DIST, routePath, "index.html");
