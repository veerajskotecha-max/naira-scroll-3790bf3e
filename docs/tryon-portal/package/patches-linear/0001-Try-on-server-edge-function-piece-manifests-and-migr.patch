+/**
+ * The 20 try-on pieces as the server sees them: the words every prompt is
+ * built from and the one listing photo sent as the product reference.
+ *
+ * Plain data, no imports. The browser never sees this file: it sends only a
+ * handle and a stone, so no prompt text and no reference can come from a
+ * shopper. src/data/tryOnPieces.ts is the browser's copy of the shared fields
+ * (handle, kind, slot, stones, certified) and a test keeps the two equal.
+ *
+ * Rows follow the build spec's prompt table (portal-oct30 SPEC.md, "THE 20
+ * ROWS") with these corrections, where the shop's own listings and rules win:
+ *   - cushion-halo-ring: the centre stone is a round brilliant in a
+ *     cushion-shaped halo (jewellery.ts details, the macro photo's alt text),
+ *     not a cushion-cut stone.
+ *   - silver-drop-earrings: the large oval is LINED with baguettes and the bar
+ *     across it is small round stones (listing details and macro photo).
+ *   - emerald-square-ear-cuff: the reference is the listing's single-cuff
+ *     photo. The pair photo would show two cuffs while the prompt places one,
+ *     and the verdict fails any count that differs from the reference.
+ *   - bold-nocturne-chain: its morph lock gains "never pavé"; the table's
+ *     lock had no "never" clause, which the house law ("X must stay Y, never
+ *     Z") and the spec's own fidelity stack require.
+ * Owner notes in the table ("[OWNER TO CONFIRM the ridge]", "[OWNER: 10 or
+ * 11.7 mm]") are questions, not prompt text, and are kept out of the prompts.
+ */
+
+export const TRYON_HANDLES = [
+  "woven-gold-hoops",
+  "brushed-gold-huggies",
+  "baguette-huggies",
+  "bold-nocturne-drops",
+  "silver-drop-earrings",
+  "emerald-halo-c-hoops",
+  "pearl-drop-studs",
+  "filigree-bloom-studs",
+  "crystal-pear-ear-cuff",
+  "emerald-square-ear-cuff",
+  "toggle-link-chain",
+  "bold-nocturne-chain",
+  "serpentine-whisper-chain",
+  "charm-box-chain",
+  "marquise-layering-set",
+  "cushion-halo-ring",
+  "baguette-eternity-band",
+  "baguette-tennis-bracelet",
+  "prism-riviere-bracelet",
+  "heartbead-bracelet",
+] as const;
+
+export type Handle = (typeof TRYON_HANDLES)[number];
+export type Kind = "face" | "hand";
+export type Slot = "earrings" | "ear-cuff" | "necklace" | "ring" | "bracelet";
+export const STONES = ["Ruby", "Crystal", "Emerald", "Amethyst"] as const;
+export type Stone = (typeof STONES)[number];
+export type Metal = "gold" | "silver" | "steel and gold";
+export type RefKey = Stone | "default";
+
+/** One stated size against a body measure, so a test can check the maths:
+    `says` must appear in the anchor and `ratio` must be within 15% of mm / base. */
+export interface ScaleClaim {
+  mm: number;
+  of: "iris" | "finger";
+  ratio: number;
+  says: string;
+}
+
+export interface ServerPiece {
+  handle: Handle;
+  kind: Kind;
+  slot: Slot;
+  /** Shopify's "Stone" option values in Shopify's order, or null for a one-colour piece. */
+  stones: readonly Stone[] | null;
+  /** Six words or fewer. `{stone}` is filled with the short stone word. */
+  short: string;
+  metal: Metal;
+  /** Countable facts in digits. `{stoneWords}` is filled with the long stone words. */
+  countable: string;
+  /** The morph lock: "X must stay Y, never Z". */
+  morph: string;
+  sizeLine: string;
+  anchor: string;
+  placement: string;
+  /** Listing photo per stone, or under "default" for a one-colour piece.
+      Each is pinned with ?v= so a replaced photo cannot change a certified prompt. */
+  refs: Partial<Record<RefKey, string>>;
+  /** 'YYYY-MM-DD' once the owner has approved the piece's proof renders. */
+  certified: string | null;
+  scale: readonly ScaleClaim[];
+}
+
+const CDN = "https://cdn.shopify.com/s/files/1/0680/9606/5698/files/";
+
+const EAR_CUFF_PLACEMENT = "one cuff on the middle ridge of the more visible ear, gripping it with no piercing";
+const WRIST_PLACEMENT = "around the wrist just below the wrist bone, stones facing the camera, resting close with a little slack";
+
+export const PIECES: readonly ServerPiece[] = [
