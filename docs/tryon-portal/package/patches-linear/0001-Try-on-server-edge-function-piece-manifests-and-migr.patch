+// @vitest-environment node
+/*
+  The two manifests (server prompts and references, browser cards) must
+  describe the same 20 pieces as the shop sells them. A drift here shows a
+  shopper one stone and adds another, or renders a piece the shop cannot sell.
+*/
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { jewellery } from "@/data/jewellery";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { JEWELLERY_HANDLES } from "@/data/jewelleryHandles";
+import { TRY_ON_ENTRY_LIVE, TRY_ON_HANDLES, TRY_ON_LIVE_HANDLES } from "@/data/tryOnHandles";
+import { TRY_ON_CONSENT_VERSION, TRY_ON_PIECES, tryOnPiece, tryOnStone } from "@/data/tryOnPieces";
+import { isPreorder } from "@/lib/pairings";
+import { colourOption } from "@/lib/colourCards";
+import { PIECES, REF_PREFIXES, TRYON_HANDLES } from "../../../supabase/functions/tryon/pieces.ts";
+import { CONSENT_VERSION } from "../../../supabase/functions/tryon/prompt.ts";
+
+const firstPaint = (handle: string) => jewellery.find((p) => p.handle === handle) ?? jewellerySnapshot.find((p) => p.handle === handle);
+const path = (url: string) => url.split("?")[0];
+
+describe("try-on manifests", () => {
+  it("lists exactly 20 handles, the same in every list and in the same order", () => {
+    expect(PIECES).toHaveLength(20);
+    expect(new Set(TRYON_HANDLES).size).toBe(20);
+    expect(PIECES.map((p) => p.handle)).toEqual([...TRYON_HANDLES]);
+    expect(TRY_ON_PIECES.map((p) => p.handle)).toEqual([...TRYON_HANDLES]);
+    expect([...TRY_ON_HANDLES]).toEqual([...TRYON_HANDLES]);
+  });
+
+  it("agrees between browser and server on kind, slot, stones and certification", () => {
+    const shared = (p: { handle: string; kind: string; slot: string; stones: readonly string[] | null; certified: string | null }) => ({
+      handle: p.handle,
+      kind: p.kind,
+      slot: p.slot,
+      stones: p.stones ? [...p.stones] : null,
+      certified: p.certified,
+    });
+    expect(TRY_ON_PIECES.map(shared)).toEqual(PIECES.map(shared));
+  });
+
+  it("splits 15 face pieces from 5 hand pieces by slot", () => {
+    for (const p of PIECES) expect(p.kind).toBe(p.slot === "ring" || p.slot === "bracelet" ? "hand" : "face");
+    expect(PIECES.filter((p) => p.kind === "face")).toHaveLength(15);
+    expect(TRY_ON_PIECES.every((p) => p.guide === (p.kind === "hand" ? "hand" : p.slot === "ear-cuff" ? "ear-cuff" : "face"))).toBe(true);
+  });
+
+  /* Every piece must be a live jewellery listing that paints without a round trip. */
+  it("uses only live jewellery handles with first-paint data", () => {
+    for (const p of PIECES) {
+      expect(JEWELLERY_HANDLES.has(p.handle)).toBe(true);
+      expect(firstPaint(p.handle)).toBeDefined();
+    }
+  });
+
+  /* A one-tap Add never takes a pre-order piece (CLAUDE.md, product links). */
+  it("has no pre-order piece", () => {
+    expect(PIECES.filter((p) => isPreorder(firstPaint(p.handle)!)).map((p) => p.handle)).toEqual([]);
+  });
+
+  it("matches each piece's category and metal to the listing", () => {
+    const category = { earrings: "Earrings", "ear-cuff": "Earrings", necklace: "Necklaces", ring: "Rings", bracelet: "Bracelets" } as const;
+    for (const p of PIECES) {
+      const listing = firstPaint(p.handle)!;
+      expect(listing.category).toBe(category[p.slot]);
+      if (p.metal === "gold") expect(listing.materials).toMatch(/18K gold/);
+      if (p.metal === "silver") expect(listing.materials).toMatch(/rhodium/);
+    }
+  });
+
+  it("takes references only from the shop's CDN or its own host, each pinned with ?v=", () => {
+    for (const p of PIECES)
+      for (const url of Object.values(p.refs)) {
+        expect(REF_PREFIXES.some((prefix) => url!.startsWith(prefix))).toBe(true);
+        expect(url).toMatch(/\?v=\d+$/);
+      }
+  });
+
+  /* Stones are Shopify's own option values, so the Add button names exactly
+     the variant the preview shows. */
+  it("offers stones only where Shopify sells them, in Shopify's order", () => {
+    const withStones = PIECES.filter((p) => p.stones).map((p) => p.handle);
+    expect(withStones).toEqual(["baguette-huggies", "baguette-eternity-band", "baguette-tennis-bracelet"]);
+    for (const p of PIECES) {
+      const option = colourOption(firstPaint(p.handle)!);
+      if (!p.stones) {
+        expect(Object.keys(p.refs)).toEqual(["default"]);
+        expect(option).toBeUndefined();
+        continue;
+      }
+      expect(option?.name).toBe("Stone");
+      expect([...p.stones]).toEqual(option!.values);
+      expect(Object.keys(p.refs).sort()).toEqual([...p.stones].sort());
+    }
+  });
+
+  /* The reference for a stone is the photo Shopify itself shows for that
+     stone's variant: Emerald is never rendered from the Ruby photo. */
+  it("uses each stone's own variant photo as its reference", () => {
+    for (const p of PIECES.filter((x) => x.stones)) {
+      const listing = firstPaint(p.handle)!;
+      for (const stone of p.stones!) {
+        const variant = listing.variants!.find((v) => v.options.Stone === stone)!;
+        expect(path(p.refs[stone]!)).toBe(path(variant.image!));
+      }
+    }
+  });
+
+  it("keeps TRY_ON_LIVE_HANDLES equal to the certified pieces, and the chip off", () => {
+    const certified = TRY_ON_PIECES.filter((p) => p.certified).map((p) => p.handle);
+    expect([...TRY_ON_LIVE_HANDLES].sort()).toEqual(certified.sort());
+    for (const p of TRY_ON_PIECES) {
+      if (p.certified !== null) expect(p.certified).toMatch(/^\d{4}-\d{2}-\d{2}$/);
+      // A demo image exists only once the owner has approved the piece.
+      if (p.demo) expect(p.certified).not.toBeNull();
+    }
+    expect(TRY_ON_ENTRY_LIVE).toBe(false);
+  });
+
+  /* The PDP may import tryOnHandles and nothing else from try-on, so it stays tiny. */
+  it("keeps tryOnHandles.ts under 1 KB with no imports", () => {
+    const source = readFileSync(new URL("../../../src/data/tryOnHandles.ts", import.meta.url), "utf8");
+    expect(new TextEncoder().encode(source).byteLength).toBeLessThan(1024);
+    expect(source).not.toMatch(/^\s*import\s/m);
+  });
+
+  /* The browser manifest carries no prompt words and no references. */
+  it("keeps prompts and references out of the browser manifest", () => {
+    const source = readFileSync(new URL("../../../src/data/tryOnPieces.ts", import.meta.url), "utf8");
+    for (const p of PIECES) {
+      expect(source).not.toContain(p.morph);
+      expect(source).not.toContain(p.countable);
+    }
+    expect(TRY_ON_PIECES.every((p) => Object.keys(p).sort().join() === "certified,demo,guide,handle,image,kind,name,sizeLine,slot,stones")).toBe(true);
+  });
+
+  it("paints each card from a photo on its own listing", () => {
+    for (const p of TRY_ON_PIECES) {
+      const listing = firstPaint(p.handle)!;
+      expect([listing.image, ...(listing.gallery ?? [])].map(path)).toContain(path(p.image));
+      expect(p.name).toBe(listing.name);
+    }
+  });
+
+  it("states the same size to the browser as to the model", () => {
+    for (const p of TRY_ON_PIECES) {
+      const server = PIECES.find((s) => s.handle === p.handle)!;
+      for (const n of p.sizeLine.match(/\d+(\.\d+)?/g)!) expect(server.sizeLine).toContain(n);
+    }
+  });
+
+  it("sends the consent version the server accepts", () => {
+    expect(TRY_ON_CONSENT_VERSION).toBe(CONSENT_VERSION);
+  });
+
+  it("resolves a route's handle and a link's stone", () => {
+    expect(tryOnPiece("baguette-huggies")?.name).toBe("Baguette Huggies");
+    expect(tryOnPiece("not-a-piece")).toBeUndefined();
+    expect(tryOnPiece(undefined)).toBeUndefined();
+    const huggies = tryOnPiece("baguette-huggies")!;
+    expect(tryOnStone(huggies, "emerald")).toBe("Emerald");
+    expect(tryOnStone(huggies, " RUBY ")).toBe("Ruby");
+    expect(tryOnStone(huggies, "sapphire")).toBeUndefined();
+    expect(tryOnStone(tryOnPiece("woven-gold-hoops")!, "ruby")).toBeUndefined();
+  });
+});
