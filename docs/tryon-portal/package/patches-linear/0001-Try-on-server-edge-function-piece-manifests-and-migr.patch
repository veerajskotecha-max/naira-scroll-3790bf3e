+export async function handle(req: Request, deps: Deps): Promise<Response> {
+  if (req.method === "OPTIONS") return new Response("ok", { headers: corsHeaders });
+  const t0 = deps.now();
+  const op = opOf(req.url);
+  const run = new Run(op ?? "unknown", t0, deps.now);
+  let res: Response;
+  try {
+    if (req.method !== "POST") res = run.reply("bad_request", { status: 405 });
+    else if (op === "render") res = await withDeadline(run, () => render(req, deps, run));
+    else if (op === "feedback") res = await feedback(req, deps, run);
