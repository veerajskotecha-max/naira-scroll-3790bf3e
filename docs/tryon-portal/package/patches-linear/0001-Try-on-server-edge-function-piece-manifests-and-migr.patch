+    3:4 asked for (NOT CONFIRMED that the gateway honours image_config). */
+export const renderBody = (model: string, content: Part[]) => ({
+  model,
+  messages: [{ role: "user", content }],
+  modalities: ["image", "text"],
+  image_config: { aspect_ratio: "3:4" },
+});
+
+/** The pre-check and the verdict: text out only, short. */
+export const checkBody = (content: Part[]) => ({
+  model: CHECK_MODEL,
+  messages: [{ role: "user", content }],
+  max_tokens: 300,
+});
