+    return stats;
+  };
+
+  it("records an answer once, and a second answer cannot overwrite it", async () => {
+    const stats = seeded();
+    const { deps } = makeDeps({ stats });
+    const first = await handle(feedbackRequest({ v: 1, render: RENDER_ID, looksRight: false, scene: "high" }), deps);
+    expect(first.status).toBe(204);
+    expect(stats.rows.get(RENDER_ID)).toMatchObject({ feedback: "no", scene: "high" });
+    const second = await handle(feedbackRequest({ v: 1, render: RENDER_ID, looksRight: true, scene: "low" }), deps);
+    expect(second.status).toBe(204);
+    expect(stats.rows.get(RENDER_ID)).toMatchObject({ feedback: "no", scene: "high" });
+  });
+
+  it("always answers 204 and ignores extra keys, bad JSON, oversize bodies and unknown ids", async () => {
+    const stats = seeded();
+    const { deps, lines } = makeDeps({ stats });
+    for (const body of [
+      { v: 1, render: RENDER_ID, looksRight: true, scene: null, note: "hello" },
+      { v: 1, render: RENDER_ID, looksRight: "yes", scene: null },
+      { v: 1, render: "not-a-uuid", looksRight: true, scene: null },
+      "{oops",
+      JSON.stringify({ v: 1, render: RENDER_ID, looksRight: true, scene: null, pad: "x".repeat(600) }),
+      { v: 1, render: "00000000-0000-4000-8000-000000000000", looksRight: true, scene: null },
+    ]) {
+      const res = await handle(feedbackRequest(body), deps);
+      expect(res.status).toBe(204);
+      expect(await res.text()).toBe("");
+    }
+    expect(stats.rows.get(RENDER_ID)).toMatchObject({ feedback: null, scene: null });
+    expect(lines.every((l) => JSON.parse(l).op === "feedback")).toBe(true);
