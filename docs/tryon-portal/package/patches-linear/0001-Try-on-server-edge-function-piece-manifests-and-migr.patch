index 0000000..34408cb
--- /dev/null
+++ b/supabase/functions/tryon/errors.ts
@@ -0,0 +1,80 @@
+/**
+ * Every error the function can answer with. The body is always
+ * {code, reason?, resetAt?, retryAfter?, retryable}; model text never appears.
+ * The browser's src/lib/tryon/errors.ts holds the copy for each code and
+ * reason, and a test keeps the two lists equal.
+ */
+
+export const ERROR_STATUS = {
+  bad_request: 400,
+  origin: 403,
+  challenge: 403,
+  too_large: 413,
+  not_jpeg: 415,
+  photo_unusable: 422,
+  fidelity_failed: 422,
+  device_limit: 429,
+  ip_limit: 429,
+  busy: 429,
+  paused: 503,
+  timeout: 504,
+  failed: 500,
+} as const;
+
+export type ErrorCode = keyof typeof ERROR_STATUS;
+
+export const PHOTO_REASONS = [
+  "ear_not_visible",
+  "neck_not_visible",
+  "hand_not_visible",
+  "wrist_not_visible",
+  "multiple_people",
+  "no_person",
+  "under_18",
+  "not_a_photo",
+  "blocked",
+  "too_dark",
+  "too_blurry",
+  "model_declined",
+] as const;
+export type PhotoReason = (typeof PHOTO_REASONS)[number];
+
+export const PAUSED_REASONS = ["off", "not_configured", "daily_cap", "credits", "piece_unavailable"] as const;
+export type PausedReason = (typeof PAUSED_REASONS)[number];
+
+export type Reason = PhotoReason | PausedReason;
+
+/** Whether the same request may simply be sent again. */
+export const RETRYABLE: Readonly<Record<ErrorCode, boolean>> = {
+  bad_request: false,
+  origin: false,
+  challenge: false,
+  too_large: false,
+  not_jpeg: false,
+  photo_unusable: false,
+  fidelity_failed: false,
+  device_limit: false,
+  ip_limit: false,
+  busy: true,
+  paused: false,
+  timeout: true,
+  failed: true,
+};
+
+export type ErrorBody = {
+  code: ErrorCode;
+  reason?: Reason;
+  resetAt?: string;
+  retryAfter?: number;
+  retryable: boolean;
+};
+
+export type ErrorExtra = { reason?: Reason; resetAt?: string; retryAfter?: number; status?: number };
+
+export const errorBody = (code: ErrorCode, extra: ErrorExtra = {}): ErrorBody => {
+  const body: ErrorBody = { code, retryable: RETRYABLE[code] };
+  if (extra.reason) body.reason = extra.reason;
+  if (extra.resetAt) body.resetAt = extra.resetAt;
+  if (extra.retryAfter !== undefined) body.retryAfter = extra.retryAfter;
+  return body;
+};
