+export type GatewayFailure = "status" | "timeout" | "network";
+
+export class GatewayError extends Error {
+  constructor(
+    readonly failure: GatewayFailure,
+    readonly status = 0,
+  ) {
+    super(`gateway ${failure}${status ? ` ${status}` : ""}`);
+  }
