+  get signal() {
+    return this.abort.signal;
+  }
+
+  elapsed() {
+    return this.now() - this.t0;
+  }
+
+  reply(code: ErrorCode, extra: ErrorExtra = {}): Response {
+    this.line.code = code;
+    this.line.reason = extra.reason ?? null;
+    return json(extra.status ?? ERROR_STATUS[code], errorBody(code, extra), extra.retryAfter ? { "Retry-After": String(extra.retryAfter) } : {});
+  }
+
+  track(attempt: NonNullable<Run["attempt"]>) {
+    this.attempt = attempt;
+  }
+
+  /** A failure: refund the device and IP rows and write the ledger row. */
+  async settle(code: ErrorCode, extra: ErrorExtra = {}): Promise<Response> {
+    if (!this.finished) {
+      this.finished = true;
+      if (this.attempt) {
+        await this.attempt.refund().catch(() => {});
+        await this.record(code, extra.reason ?? null);
+      }
+    }
+    return this.reply(code, extra);
+  }
+
+  async succeed(image: { mime: string; bytes: Uint8Array }, verified: "pass" | "log" | "off", remaining: number): Promise<Response> {
+    if (this.finished) return this.reply("timeout");
+    this.finished = true;
+    this.timing.outBytes = this.line.outBytes = image.bytes.byteLength;
+    await this.record("ok", null);
+    return new Response(image.bytes as BodyInit, {
+      status: 200,
+      headers: {
+        ...corsHeaders,
+        "Content-Type": image.mime,
+        "Cache-Control": "no-store",
+        "X-Tryon-Remaining": String(remaining),
+        "X-Tryon-Verified": verified,
+        "X-Tryon-Render": this.attempt ? this.attempt.row.id : "",
+        "Access-Control-Expose-Headers": EXPOSED_HEADERS,
+      },
+    });
+  }
