diff --git a/tests/edge/tryon/gateway.test.ts b/tests/edge/tryon/gateway.test.ts
new file mode 100644
index 0000000..5628ba2
--- /dev/null
+++ b/tests/edge/tryon/gateway.test.ts
@@ -0,0 +1,116 @@
+// @vitest-environment node
+/*
+  Reading the gateway's replies. The image is the only thing taken from a
+  render reply; a check reply is reduced to its JSON; model prose goes nowhere.
+*/
+import { describe, expect, it } from "vitest";
+import {
+  checkBody,
+  fromBase64,
+  gatewayBase,
+  GatewayError,
+  imageFromReply,
+  jsonFromReply,
+  makeChat,
+  MAX_IMAGE_BYTES,
+  refusalCode,
+  renderBody,
+  textFromReply,
+  toBase64,
+} from "../../../supabase/functions/tryon/gateway.ts";
+
+const withImage = (url: unknown, content: unknown = "") => ({ choices: [{ message: { content, images: [{ type: "image_url", image_url: { url } }] } }] });
+
+describe("imageFromReply", () => {
+  it("takes a png, jpeg or webp data URL", () => {
+    for (const mime of ["image/png", "image/jpeg", "image/webp"]) {
+      const got = imageFromReply(withImage(`data:${mime};base64,${toBase64(new Uint8Array([1, 2, 3, 4]))}`));
+      expect(got?.mime).toBe(mime);
+      expect([...got!.bytes]).toEqual([1, 2, 3, 4]);
+    }
+  });
+  it("refuses other types, remote URLs, broken base64 and anything over 8 MB", () => {
+    expect(imageFromReply(withImage("data:image/gif;base64,AAAA"))).toBeNull();
+    expect(imageFromReply(withImage("data:image/svg+xml;base64,AAAA"))).toBeNull();
+    expect(imageFromReply(withImage("https://example.com/x.png"))).toBeNull();
+    expect(imageFromReply(withImage("data:image/png;base64,@@@"))).toBeNull();
+    expect(imageFromReply(withImage(42))).toBeNull();
+    expect(imageFromReply({ choices: [] })).toBeNull();
+    expect(imageFromReply(null)).toBeNull();
+    const big = "A".repeat(Math.ceil(((MAX_IMAGE_BYTES + 1024) * 4) / 3 / 4) * 4);
+    expect(imageFromReply(withImage(`data:image/png;base64,${big}`))).toBeNull();
+  });
+});
+
+describe("text and JSON", () => {
+  it("reads string or part content", () => {
+    expect(textFromReply({ choices: [{ message: { content: "hi" } }] })).toBe("hi");
+    expect(textFromReply({ choices: [{ message: { content: [{ type: "text", text: "a" }, { type: "text", text: "b" }] } }] })).toBe("a b");
+    expect(textFromReply({})).toBe("");
+  });
+  it("takes the first balanced JSON object out of prose or a fence", () => {
+    expect(jsonFromReply('```json\n{"people": 1, "adult": true}\n```')).toEqual({ people: 1, adult: true });
+    expect(jsonFromReply('Sure. {"a": "has } brace", "b": {"c": 1}} and {"d": 2}')).toEqual({ a: "has } brace", b: { c: 1 } });
+    expect(jsonFromReply("no json here")).toBeNull();
+    expect(jsonFromReply("{broken")).toBeNull();
+    expect(jsonFromReply("{'single': true}")).toBeNull();
+  });
+  it("finds a refusal word only as a whole word", () => {
+    expect(refusalCode("NO_EAR")).toBe("NO_EAR");
+    expect(refusalCode("I can't: NO_WRIST.")).toBe("NO_WRIST");
+    expect(refusalCode("XNO_EARX")).toBeNull();
+    expect(refusalCode("no ear visible")).toBeNull();
+  });
+});
+
+describe("request bodies", () => {
+  it("builds the render body as shape A and the check body without image output", () => {
+    const content = [{ type: "text" as const, text: "t" }];
+    expect(renderBody("google/gemini-3-pro-image", content)).toEqual({
+      model: "google/gemini-3-pro-image",
+      messages: [{ role: "user", content }],
+      modalities: ["image", "text"],
+      image_config: { aspect_ratio: "3:4" },
+    });
+    expect(checkBody(content)).toEqual({ model: "google/gemini-3.8-flash", messages: [{ role: "user", content }], max_tokens: 300 });
+  });
+  it("sends the key only to the Lovable gateway or a loopback fake", () => {
+    expect(gatewayBase(undefined)).toBe("https://ai.gateway.lovable.dev/v1");
+    expect(gatewayBase("http://127.0.0.1:54399/v1")).toBe("http://127.0.0.1:54399/v1");
+    expect(gatewayBase("http://localhost:54399/v1")).toBe("http://localhost:54399/v1");
+    for (const bad of ["https://evil.example/v1", "http://127.0.0.1.evil.example/v1", "http://10.0.0.5/v1", "https://127.0.0.1:1/v1"]) expect(gatewayBase(bad)).toBe("https://ai.gateway.lovable.dev/v1");
+  });
+});
+
+describe("makeChat", () => {
+  it("throws a status error on non-2xx and a timeout error when the timer fires", async () => {
+    const parent = new AbortController().signal;
+    const status = makeChat(async () => new Response("x", { status: 503 }), "http://127.0.0.1:1/v1", "k", parent);
+    await expect(status({}, 1000)).rejects.toMatchObject({ failure: "status", status: 503 });
+    const hang = makeChat(
+      (_u, init) => new Promise((_, reject) => init!.signal!.addEventListener("abort", () => reject(new Error("aborted")))),
+      "http://127.0.0.1:1/v1",
+      "k",
+      parent,
+    );
+    const err = await hang({}, 5).catch((e) => e);
+    expect(err).toBeInstanceOf(GatewayError);
+    expect(err.failure).toBe("timeout");
+    const network = makeChat(async () => { throw new TypeError("fetch failed"); }, "http://127.0.0.1:1/v1", "k", parent);
+    await expect(network({}, 1000)).rejects.toMatchObject({ failure: "network" });
+  });
+  it("returns null for a 2xx reply that is not JSON", async () => {
+    const chat = makeChat(async () => new Response("<html>"), "http://127.0.0.1:1/v1", "k", new AbortController().signal);
+    expect(await chat({}, 1000)).toBeNull();
+  });
+});
+
+describe("base64", () => {
+  it("round-trips large buffers without Buffer", () => {
+    const data = new Uint8Array(200_000).map((_, i) => (i * 31) % 256);
+    const encoded = toBase64(data);
+    expect(encoded).toBe(Buffer.from(data).toString("base64"));
+    expect(fromBase64(encoded)).toEqual(data);
+    expect(fromBase64("***")).toBeNull();
+  });
+});
