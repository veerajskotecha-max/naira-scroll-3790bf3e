+// @vitest-environment node
+/*
+  Daily limits by India's calendar day. The in-memory quota is what tests and
+  serve-local run, so it must keep the database functions' rules exactly.
+*/
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { istDay, keyHash, limitsFrom, memoryQuota, nextIstMidnight, rpcQuota, sha256Hex } from "../../../supabase/functions/tryon/quota.ts";
+import { dbStats, memoryStats, type Db, type RenderRow } from "../../../supabase/functions/tryon/stats.ts";
+
+const L = { device: 2, ip: 3, all: 4 };
+const at = (iso: string) => Date.parse(iso);
+
+describe("IST day", () => {
+  it("turns over at 18:30 UTC", () => {
+    expect(istDay(at("2026-10-30T18:29:59.999Z"))).toBe("2026-10-30");
+    expect(istDay(at("2026-10-30T18:30:00.000Z"))).toBe("2026-10-31");
+    expect(nextIstMidnight(at("2026-10-30T10:00:00Z"))).toBe("2026-10-30T18:30:00.000Z");
+    expect(nextIstMidnight(at("2026-10-30T18:30:00Z"))).toBe("2026-10-31T18:30:00.000Z");
+    expect(nextIstMidnight(at("2026-12-31T20:00:00Z"))).toBe("2027-01-01T18:30:00.000Z");
+  });
+});
+
+describe("keyHash", () => {
+  it("is SHA-256 hex of salt | day | scope | value", async () => {
+    expect(await keyHash(sha256Hex, "salt", "2026-10-30", "device", "abc")).toBe(await sha256Hex("salt|2026-10-30|device|abc"));
+    expect(await sha256Hex("abc")).toBe("ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+  });
+
+  /* Stable within a day, so the limit holds; different the next day and per
+     scope, so a key cannot be followed from one day to the next. */
+  it("is stable for one IST day and changes across days and scopes", async () => {
+    const morning = istDay(at("2026-10-29T19:00:00Z"));
+    const night = istDay(at("2026-10-30T18:00:00Z"));
+    expect(morning).toBe(night);
+    const a = await keyHash(sha256Hex, "salt", morning, "device", "uuid-1");
+    expect(await keyHash(sha256Hex, "salt", night, "device", "uuid-1")).toBe(a);
+    expect(await keyHash(sha256Hex, "salt", istDay(at("2026-10-30T18:31:00Z")), "device", "uuid-1")).not.toBe(a);
+    expect(await keyHash(sha256Hex, "salt", morning, "ip", "uuid-1")).not.toBe(a);
+    expect(await keyHash(sha256Hex, "other-salt", morning, "device", "uuid-1")).not.toBe(a);
+    expect(a).toMatch(/^[0-9a-f]{64}$/);
+  });
+});
+
+describe("memory quota", () => {
+  it("takes one from device, IP and the day, and says how many the device has left", async () => {
+    const q = memoryQuota(() => at("2026-10-30T10:00:00Z"));
+    expect(await q.take("d1", "i1", L)).toEqual({ ok: true, deviceLeft: 1 });
+    expect(await q.take("d1", "i1", L)).toEqual({ ok: true, deviceLeft: 0 });
+    expect(await q.take("d1", "i1", L)).toEqual({ ok: false, scope: "device", deviceLeft: 0 });
+    expect(q.used("all")).toBe(2);
+  });
+
+  it("checks the day first, then the device, then the address", async () => {
+    const q = memoryQuota(() => at("2026-10-30T10:00:00Z"));
+    await q.take("d1", "i1", L);
+    await q.take("d2", "i1", L);
+    await q.take("d3", "i1", L);
+    expect(await q.take("d4", "i1", L)).toEqual({ ok: false, scope: "ip", deviceLeft: 2 });
+    await q.take("d5", "i2", L);
+    expect(q.used("all")).toBe(4);
+    expect(await q.take("d6", "i3", L)).toEqual({ ok: false, scope: "all", deviceLeft: 2 });
+    // A refused take changes nothing.
+    expect(q.used("all")).toBe(4);
+    expect(q.used("ip", "i1")).toBe(3);
+  });
+
+  /* The global count bounds the day's spend: a refund never gives it back. */
+  it("refunds the device and address but never the day's count, and never below zero", async () => {
+    const q = memoryQuota(() => at("2026-10-30T10:00:00Z"));
+    await q.take("d1", "i1", L);
+    await q.refund("d1", "i1");
+    expect(q.used("device", "d1")).toBe(0);
+    expect(q.used("ip", "i1")).toBe(0);
+    expect(q.used("all")).toBe(1);
+    await q.refund("d1", "i1");
+    expect(q.used("device", "d1")).toBe(0);
+  });
+
+  it("starts each IST day fresh", async () => {
+    let t = at("2026-10-30T18:00:00Z");
+    const q = memoryQuota(() => t);
+    await q.take("d1", "i1", L);
+    await q.take("d1", "i1", L);
+    expect((await q.take("d1", "i1", L)).ok).toBe(false);
+    t = at("2026-10-30T18:31:00Z");
+    expect(await q.take("d1", "i1", L)).toEqual({ ok: true, deviceLeft: 1 });
+  });
+});
+
+describe("database quota", () => {
+  it("calls tryon_take and tryon_refund with the migration's argument names", async () => {
+    const calls: [string, Record<string, unknown>][] = [];
+    const answers = [
+      { data: [{ ok: true, scope: null, device_left: 4 }], error: null },
+      { data: [{ ok: false, scope: "ip", device_left: 3 }], error: null },
+      { data: null, error: null },
+    ];
+    const q = rpcQuota(async (fn, args) => (calls.push([fn, args]), answers.shift() ?? { data: null, error: null }));
+    expect(await q.take("dk", "ik", { device: 5, ip: 30, all: 100 })).toEqual({ ok: true, deviceLeft: 4 });
+    expect(await q.take("dk", "ik", { device: 5, ip: 30, all: 100 })).toEqual({ ok: false, scope: "ip", deviceLeft: 3 });
+    await q.refund("dk", "ik");
+    expect(calls).toEqual([
+      ["tryon_take", { p_device: "dk", p_ip: "ik", p_device_max: 5, p_ip_max: 30, p_all_max: 100 }],
+      ["tryon_take", { p_device: "dk", p_ip: "ik", p_device_max: 5, p_ip_max: 30, p_all_max: 100 }],
+      ["tryon_refund", { p_device: "dk", p_ip: "ik" }],
+    ]);
+    const sql = readFileSync(new URL("../../../supabase/migrations/20261101000000_tryon.sql", import.meta.url), "utf8");
+    expect(sql).toContain("function public.tryon_take(p_device text, p_ip text, p_device_max int, p_ip_max int, p_all_max int)");
+    expect(sql).toContain("function public.tryon_refund(p_device text, p_ip text)");
+  });
+
+  /* Fail closed: a missing function or table must not read as "allowed". */
+  it("throws on an RPC error or an empty answer", async () => {
+    await expect(rpcQuota(async () => ({ data: null, error: { message: "function does not exist" } })).take("d", "i", L)).rejects.toThrow();
+    await expect(rpcQuota(async () => ({ data: [], error: null })).take("d", "i", L)).rejects.toThrow();
+    await expect(rpcQuota(async () => ({ data: null, error: { message: "x" } })).refund("d", "i")).rejects.toThrow();
+  });
+
+  it("locks the migration down: RLS on, no policy, execute for service_role only", () => {
+    const sql = readFileSync(new URL("../../../supabase/migrations/20261101000000_tryon.sql", import.meta.url), "utf8");
+    expect(sql).toContain("alter table public.tryon_quota enable row level security;");
+    expect(sql).toContain("alter table public.tryon_renders enable row level security;");
+    expect(sql).not.toMatch(/create policy/i);
+    expect(sql).toContain("revoke all on public.tryon_quota, public.tryon_renders from anon, authenticated;");
+    expect(sql).toMatch(/revoke execute on function [^;]+ from public, anon, authenticated;/);
+    expect(sql).toMatch(/grant execute on function [^;]+ to service_role;/);
+    // The tables hold no column that could name a shopper or hold a picture.
+    const ddl = sql.replace(/--.*$/gm, "");
+    expect(ddl).not.toMatch(/\b(device_id|ip_address|visitor|naira_vid|photo|image|bytea)\b/i);
+  });
+});
+
+describe("limits", () => {
+  it("defaults to 5 per device, 30 per address and 100 a day, ignoring bad values", () => {
+    expect(limitsFrom({})).toEqual({ device: 5, ip: 30, all: 100 });
+    expect(limitsFrom({ TRYON_DEVICE_DAILY: "3", TRYON_IP_DAILY: "40", TRYON_DAILY_CAP: "250" })).toEqual({ device: 3, ip: 40, all: 250 });
+    expect(limitsFrom({ TRYON_DEVICE_DAILY: "0", TRYON_IP_DAILY: "-1", TRYON_DAILY_CAP: "lots" })).toEqual({ device: 5, ip: 30, all: 100 });
+  });
+});
+
+describe("ledger", () => {
+  const row = (id: string): RenderRow => ({
+    id, handle: "woven-gold-hoops", stone: null, kind: "face", outcome: "ok", reason: null, attempts: 1,
+    precheck_ms: 1, render_ms: 2, verify_ms: 3, total_ms: 6, out_bytes: 10, verdict: { model: "m" }, consent_version: "tryon-2026-11",
+  });
+
+  /* The service-role writes, as supabase-js builds them: insert, the 90-day
+     sweep, and a feedback update guarded by feedback IS NULL and one day. */
+  it("writes through supabase-js with the guards the spec sets", async () => {
+    const ops: unknown[][] = [];
+    const chain = (name: string): unknown => new Proxy(() => {}, {
+      get: (_t, prop) => (prop === "then" ? (r: (v: unknown) => void) => r({ error: null }) : (...args: unknown[]) => (ops.push([name, String(prop), ...args]), chain(name))),
+    });
+    const db = { from: (table: string) => (ops.push(["from", table]), chain(table)) } as unknown as Db;
+    const now = at("2026-10-30T10:00:00Z");
+    const stats = dbStats(db, () => now);
+    await stats.insert(row("r1"));
+    await stats.feedback("r1", "no", "high");
+    await stats.feedback("r1", null, null);
+    expect(ops).toEqual([
+      ["from", "tryon_renders"],
+      ["tryon_renders", "insert", row("r1")],
+      ["from", "tryon_renders"],
+      ["tryon_renders", "delete"],
+      ["tryon_renders", "lt", "created_at", "2026-08-01T10:00:00.000Z"],
+      ["from", "tryon_renders"],
+      ["tryon_renders", "update", { feedback: "no", scene: "high" }],
+      ["tryon_renders", "eq", "id", "r1"],
+      ["tryon_renders", "is", "feedback", null],
+      ["tryon_renders", "gt", "created_at", "2026-10-29T10:00:00.000Z"],
+    ]);
+  });
+
+  it("sweeps memory rows older than 90 days", async () => {
+    let t = at("2026-08-01T00:00:00Z");
+    const stats = memoryStats(() => t);
+    await stats.insert(row("old"));
+    t = at("2026-10-30T00:00:01Z");
+    await stats.insert(row("new"));
+    expect([...stats.rows.keys()]).toEqual(["new"]);
+  });
+});
