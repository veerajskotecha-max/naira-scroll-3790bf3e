+/** Nano Banana Pro, the owner's model. Pinned in code so nobody can move off
+    it by changing a setting; TRYON_RENDER_ID may only pick the other id of the
+    same model, in case the gateway still wants the preview id. */
+export const RENDER_MODEL = "google/gemini-3-pro-image";
+export const RENDER_MODELS = ["google/gemini-3-pro-image", "google/gemini-3-pro-image-preview"] as const;
