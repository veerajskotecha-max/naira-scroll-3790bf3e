+export type Part = { type: "image_url"; image_url: { url: string } } | { type: "text"; text: string };
+
+export const imagePart = (url: string): Part => ({ type: "image_url", image_url: { url } });
+export const textPart = (text: string): Part => ({ type: "text", text });
