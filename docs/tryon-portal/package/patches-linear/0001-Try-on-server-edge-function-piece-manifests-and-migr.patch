+    refs: { default: CDN + "woven-gold-hoops-0_6c9f6b30-a09f-479d-bbfa-ab40df3853a4.jpg?v=1787524536" },
+    certified: null,
+    scale: [{ mm: 25, of: "iris", ratio: 2, says: "about 2 times the width of the iris" }],
+  },
+  {
