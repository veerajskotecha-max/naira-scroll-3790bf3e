+export type Chat = (body: Record<string, unknown>, timeoutMs: number) => Promise<unknown>;
+
+/** One gateway call. Resolves with the parsed JSON reply (null if the reply
+    is not JSON); throws GatewayError on a non-2xx status, a timeout or a
+    network failure. */
+export const makeChat =
+  (fetchFn: typeof fetch, base: string, key: string, parent: AbortSignal): Chat =>
+  async (body, timeoutMs) => {
+    const t = timeoutSignal(parent, timeoutMs);
+    try {
+      let res: Response;
+      try {
+        res = await fetchFn(`${base}/chat/completions`, {
+          method: "POST",
+          headers: { Authorization: "Bearer " + key, "Content-Type": "application/json" },
+          body: JSON.stringify(body),
+          signal: t.signal,
+        });
+      } catch {
+        throw new GatewayError(t.signal.aborted ? "timeout" : "network");
+      }
+      if (!res.ok) {
+        await res.body?.cancel().catch(() => {});
+        throw new GatewayError("status", res.status);
+      }
+      try {
+        return await res.json();
+      } catch {
+        if (t.signal.aborted) throw new GatewayError("timeout");
+        return null;
+      }
+    } finally {
+      t.done();
+    }
+  };
+
+type Reply = { choices?: Array<{ message?: { content?: unknown; images?: Array<{ image_url?: { url?: unknown } }> } }> };
+
+const messageOf = (json: unknown) => (json as Reply | null)?.choices?.[0]?.message;
+
+export const MAX_IMAGE_BYTES = 8 * 1024 * 1024;
+
+/** The edited image: a png, jpeg or webp data URL of 8 MB or less decoded. */
+export function imageFromReply(json: unknown): { mime: string; dataUrl: string; bytes: Uint8Array } | null {
+  const url = messageOf(json)?.images?.[0]?.image_url?.url;
+  if (typeof url !== "string") return null;
+  const m = /^data:(image\/(?:png|jpeg|webp));base64,([A-Za-z0-9+/=]+)$/.exec(url);
+  if (!m) return null;
+  if (Math.floor((m[2].length * 3) / 4) > MAX_IMAGE_BYTES + 3) return null;
+  const bytes = fromBase64(m[2]);
+  if (!bytes || bytes.length === 0 || bytes.length > MAX_IMAGE_BYTES) return null;
+  return { mime: m[1], dataUrl: url, bytes };
+}
+
+/** The reply's text, whether the gateway sends a string or text parts. */
+export function textFromReply(json: unknown): string {
+  const content = messageOf(json)?.content;
+  if (typeof content === "string") return content;
+  if (Array.isArray(content))
+    return content.map((p) => (p && typeof p === "object" && typeof (p as { text?: unknown }).text === "string" ? (p as { text: string }).text : "")).join(" ");
+  return "";
+}
+
+/** The first balanced {...} block of a reply, parsed; null if there is none. */
+export function jsonFromReply(text: string): Record<string, unknown> | null {
+  const start = text.indexOf("{");
+  if (start < 0) return null;
+  let depth = 0;
+  let inString = false;
+  for (let i = start; i < text.length; i++) {
+    const c = text[i];
+    if (inString) {
+      if (c === "\\") i++;
+      else if (c === '"') inString = false;
+    } else if (c === '"') inString = true;
+    else if (c === "{") depth++;
+    else if (c === "}" && --depth === 0) {
+      try {
+        const value = JSON.parse(text.slice(start, i + 1));
+        return value && typeof value === "object" && !Array.isArray(value) ? (value as Record<string, unknown>) : null;
+      } catch {
+        return null;
+      }
+    }
+  }
+  return null;
+}
+
+export function refusalCode(text: string): "NO_EAR" | "NO_NECK" | "NO_HAND" | "NO_WRIST" | null {
+  const m = /\b(NO_EAR|NO_NECK|NO_HAND|NO_WRIST)\b/.exec(text);
+  return m ? (m[1] as "NO_EAR" | "NO_NECK" | "NO_HAND" | "NO_WRIST") : null;
+}
+
+/** Base64 without Buffer, so the same code runs in Deno and in Node's tests. */
+export function toBase64(bytes: Uint8Array): string {
+  let out = "";
+  const CHUNK = 0x8000;
+  for (let i = 0; i < bytes.length; i += CHUNK) out += String.fromCharCode(...bytes.subarray(i, i + CHUNK));
+  return btoa(out);
+}
+
+export function fromBase64(b64: string): Uint8Array | null {
+  try {
+    const bin = atob(b64);
+    const out = new Uint8Array(bin.length);
+    for (let i = 0; i < bin.length; i++) out[i] = bin.charCodeAt(i);
+    return out;
+  } catch {
+    return null;
+  }
+}
