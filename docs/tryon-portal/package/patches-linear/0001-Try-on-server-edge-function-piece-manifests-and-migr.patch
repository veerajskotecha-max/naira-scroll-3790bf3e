+/** One request: its log line, its abort signal, and, once quota is taken,
+    the refund and the ledger row. Settles exactly once, so the deadline and a
+    late pipeline cannot both refund or both write a row. */
+class Run {
+  readonly line: Line;
+  readonly abort = new AbortController();
+  finished = false;
+  private attempt: {
+    row: Omit<RenderRow, "outcome" | "reason" | "total_ms" | "attempts" | "precheck_ms" | "render_ms" | "verify_ms" | "out_bytes">;
+    refund: () => Promise<void>;
+    stats: Stats;
+  } | null = null;
+  readonly timing = { precheckMs: null as number | null, renderMs: 0, verifyMs: null as number | null, outBytes: null as number | null };
