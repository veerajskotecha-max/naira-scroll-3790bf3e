+    refs: { default: CDN + "brushed-gold-huggies-0_d9e5187c-0e22-4997-988b-81e1533a5ebd.jpg?v=1787524089" },
+    certified: null,
+    scale: [{ mm: 14, of: "iris", ratio: 1.2, says: "about 1.2 iris widths" }],
+  },
+  {
+    handle: "baguette-huggies",
+    kind: "face",
+    slot: "earrings",
+    stones: ["Ruby", "Crystal", "Emerald", "Amethyst"],
+    short: "gold huggies, {stone} baguettes",
+    metal: "gold",
+    countable: "2 huggies, each with one row of rectangular {stoneWords} baguettes",
+    morph: "they must stay rectangular step-cut baguettes in a single row, never round stones or pavé",
+    sizeLine: "15 mm across with a 4.4 mm stone row",
+    anchor: "about 1.3 iris widths",
+    placement: "hugging the lower lobe of each visible ear, the stone row along the front",
+    refs: {
+      Ruby: CDN + "5b1db5cf-e98e-41c3-b411-f3d165cbf67c.jpg?v=1792193135",
+      Crystal: CDN + "151d0f0a-6c0b-4873-abb8-598755e393d1.jpg?v=1792193136",
+      Emerald: CDN + "bff78c83-b184-47e8-a791-5454d010026b.jpg?v=1792193136",
+      Amethyst: CDN + "1d6e2afc-d943-4530-a5c9-c044ee6b187d.jpg?v=1792193135",
+    },
+    certified: null,
+    scale: [{ mm: 15, of: "iris", ratio: 1.3, says: "about 1.3 iris widths" }],
+  },
+  {
+    handle: "bold-nocturne-drops",
+    kind: "face",
+    slot: "earrings",
+    stones: null,
+    short: "gold oval link drop earrings",
