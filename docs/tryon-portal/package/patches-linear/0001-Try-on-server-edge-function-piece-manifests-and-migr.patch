index 0000000..e34d930
--- /dev/null
+++ b/supabase/functions/tryon/index.ts
@@ -0,0 +1,61 @@
+/**
+ * Virtual try-on: one shopper photo and one certified piece in, one AI
+ * preview out (Nano Banana Pro through the Lovable AI gateway).
+ *
+ * This file only reads the environment and builds the deps; the pipeline is
+ * handler.ts, which is tested in Node. Two flags keep a publish inert:
+ * TRYON_ENABLED must be "on", and the client's TRY_ON_ENTRY_LIVE must be true
+ * before any product page links here. Until the migration
+ * 20261101000000_tryon.sql exists in the database, quota calls fail and the
+ * function answers 503 paused (not_configured).
+ *
+ * Before launch, Lovable's "AI app context" must be OFF: it keeps full AI
+ * requests, the shopper's photo included, for 90 days.
+ */
+import { createClient } from "npm:@supabase/supabase-js@2";
+import { handle, type Env } from "./handler.ts";
+import { rpcQuota, sha256Hex } from "./quota.ts";
+import { dbStats, type Db } from "./stats.ts";
+
+const ENV_KEYS = [
+  "TRYON_ENABLED",
+  "LOVABLE_API_KEY",
+  "TRYON_SALT",
+  "TRYON_DEVICE_DAILY",
+  "TRYON_IP_DAILY",
+  "TRYON_DAILY_CAP",
+  "TRYON_VERIFY",
+  "TRYON_RENDER_ID",
+  "TRYON_EXTRA_ORIGINS",
+  "TRYON_ALLOW_UNCERTIFIED",
+  "TRYON_GATEWAY_URL",
+  "TURNSTILE_SECRET",
+] as const satisfies readonly (keyof Env)[];
+
+let db: ReturnType<typeof createClient> | null = null;
+const database = () => {
+  if (db) return db;
+  const url = Deno.env.get("SUPABASE_URL");
+  const key = Deno.env.get("SUPABASE_SERVICE_ROLE_KEY");
+  if (!url || !key) return null;
+  db = createClient(url, key, { auth: { persistSession: false } });
+  return db;
+};
+
+Deno.serve((req) => {
+  const env: Env = Object.fromEntries(ENV_KEYS.map((k) => [k, Deno.env.get(k)]));
+  const client = database();
+  return handle(req, {
+    fetch: (input, init) => fetch(input, init),
+    // The client is untyped (no generated Database types here), so rpc's
+    // argument type is unknown to it; the names match the migration.
+    quota: client ? rpcQuota((fn, args) => client.rpc(fn, args as never)) : null,
+    // supabase-js's generated types are too deep to compare structurally;
+    // stats.ts's Db names the four calls it makes (insert, delete, update, filters).
+    stats: client ? dbStats(client as unknown as Db, Date.now) : null,
+    now: Date.now,
+    env,
+    log: (line, level) => (level === "error" ? console.error(line) : console.log(line)),
+    sha256: sha256Hex,
+  });
+});
diff --git a/supabase/functions/tryon/jpeg.ts b/supabase/functions/tryon/jpeg.ts
new file mode 100644
index 0000000..059a32f
--- /dev/null
+++ b/supabase/functions/tryon/jpeg.ts
@@ -0,0 +1,44 @@
+/**
+ * The size a JPEG declares in its frame header (SOF), read without decoding,
+ * so a PNG or a landscape photo is refused before any money is spent on it.
+ */
+
+/** Width and height from a baseline or progressive JPEG's SOF marker; null if
+    the bytes are not a JPEG or carry no frame header. */
+export function jpegSize(b: Uint8Array): { width: number; height: number } | null {
+  if (b.length < 4 || b[0] !== 0xff || b[1] !== 0xd8 || b[2] !== 0xff) return null;
+  let i = 2;
+  while (i + 3 < b.length) {
+    if (b[i] !== 0xff) return null;
+    const marker = b[i + 1];
+    // Fill bytes: any number of 0xFF may pad a marker.
+    if (marker === 0xff) {
+      i++;
+      continue;
+    }
+    // Markers that stand alone, with no length.
+    if (marker === 0x01 || (marker >= 0xd0 && marker <= 0xd8)) {
+      i += 2;
+      continue;
+    }
+    if (marker === 0xd9 || marker === 0xda) return null; // end of image, or scan data before any SOF
+    const len = (b[i + 2] << 8) | b[i + 3];
+    if (len < 2) return null;
+    // SOF0–SOF15, except DHT (C4), JPG (C8) and DAC (CC), which share the range.
+    if (marker >= 0xc0 && marker <= 0xcf && marker !== 0xc4 && marker !== 0xc8 && marker !== 0xcc) {
+      if (i + 8 >= b.length) return null;
+      const height = (b[i + 5] << 8) | b[i + 6];
+      const width = (b[i + 7] << 8) | b[i + 8];
+      return width && height ? { width, height } : null;
+    }
+    i += 2 + len;
+  }
+  return null;
+}
+
+/** The phone's output: a 3:4 portrait (0.75 ± 2%) with its long side 1024–1600 px. */
+export function isTryOnPhoto(size: { width: number; height: number } | null): boolean {
+  if (!size) return false;
+  const long = Math.max(size.width, size.height);
+  return long >= 1024 && long <= 1600 && Math.abs(size.width / size.height - 0.75) <= 0.75 * 0.02;
+}
