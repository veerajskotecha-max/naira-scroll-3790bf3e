+
+/** The photo a piece needs: one face photo covers every face piece, one hand photo every hand piece. */
+export type TryOnKind = "face" | "hand";
+export type TryOnSlot = "earrings" | "ear-cuff" | "necklace" | "ring" | "bracelet";
+/** Shopify's "Stone" option values. */
+export type TryOnStone = "Ruby" | "Crystal" | "Emerald" | "Amethyst";
+/** Which photo tips to show: face, face plus the ear-cuff line, or hand. */
+export type TryOnGuide = "face" | "ear-cuff" | "hand";
+
+export interface TryOnPiece {
+  handle: TryOnHandle;
+  name: string;
+  kind: TryOnKind;
+  slot: TryOnSlot;
+  /** Shopify's Stone values in Shopify's order (the PDP's swatch order), or null. */
+  stones: readonly TryOnStone[] | null;
+  /** Reads after "Actual size " and "Shown at its listed size: ". */
+  sizeLine: string;
+  guide: TryOnGuide;
+  /** 'YYYY-MM-DD' once the owner has approved the piece, else null. */
+  certified: string | null;
+  /** True once public/tryon/demo/<handle>.webp exists (owner-approved). */
+  demo: boolean;
+  /** The piece's card photo (the shop's own card cover), for the hub and strip. */
+  image: string;
+}
+
+/** Sent with every render; the server accepts only this version. */
+export const TRY_ON_CONSENT_VERSION = "tryon-2026-11";
+
