+];
+
+const BY_HANDLE = new Map<string, TryOnPiece>(TRY_ON_PIECES.map((p) => [p.handle, p]));
+
+/** The piece for a route's handle, or undefined for anything else. */
+export const tryOnPiece = (handle: string | undefined | null): TryOnPiece | undefined => (handle ? BY_HANDLE.get(handle) : undefined);
+
+/** A stone a link names (?colour=emerald), in the piece's own spelling, or undefined. */
+export const tryOnStone = (piece: TryOnPiece, param: string | null | undefined): TryOnStone | undefined => {
+  const wanted = param?.trim().toLowerCase();
+  return wanted ? piece.stones?.find((s) => s.toLowerCase() === wanted) : undefined;
+};
diff --git a/supabase/functions/tryon/body.ts b/supabase/functions/tryon/body.ts
new file mode 100644
index 0000000..89500be
--- /dev/null
+++ b/supabase/functions/tryon/body.ts
@@ -0,0 +1,45 @@
+/**
+ * A request body read with a running byte count. Content-Length is checked
+ * first when present, but it cannot be required: a proxy may forward the
+ * upload chunked, so the cap is enforced on the bytes actually read.
+ */
+
+export class TooLarge extends Error {
+  constructor(readonly maxBytes: number) {
+    super(`body over ${maxBytes} bytes`);
+  }
+}
+
+type Readable = { body: ReadableStream<Uint8Array> | null };
+
+export async function readCapped(source: Readable, maxBytes: number, signal?: AbortSignal): Promise<Uint8Array> {
+  if (!source.body) return new Uint8Array(0);
+  const reader = source.body.getReader();
+  const onAbort = () => reader.cancel().catch(() => {});
+  signal?.addEventListener("abort", onAbort, { once: true });
+  const chunks: Uint8Array[] = [];
+  let total = 0;
+  try {
+    for (;;) {
+      const { done, value } = await reader.read();
+      // A cancelled reader reports done; an aborted read must not look like a short body.
+      if (signal?.aborted) throw new Error("aborted");
+      if (done) break;
+      total += value.byteLength;
+      if (total > maxBytes) {
+        await reader.cancel().catch(() => {});
+        throw new TooLarge(maxBytes);
+      }
+      chunks.push(value);
+    }
+  } finally {
+    signal?.removeEventListener("abort", onAbort);
+  }
+  const out = new Uint8Array(total);
+  let at = 0;
+  for (const c of chunks) {
+    out.set(c, at);
+    at += c.byteLength;
+  }
+  return out;
+}
diff --git a/supabase/functions/tryon/errors.ts b/supabase/functions/tryon/errors.ts
