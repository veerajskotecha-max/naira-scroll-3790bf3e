+/**
+ * Writes every try-on prompt to JSON, for the Higgsfield proof renders and for
+ * review: the 27 render prompts (20 pieces, one per stone), the five
+ * pre-checks, the 27 verdicts and the eight retry corrections, plus the models.
+ *
+ *   npx vite-node scripts/tryon/print-prompts.ts [out.json]
+ *
+ * It prints promptBook() from supabase/functions/tryon/prompt.ts, the same
+ * function the handler builds its requests from, so the proof runs the shipped
+ * words byte for byte (tests/edge/tryon/handler.test.ts compares the text the
+ * handler sends against promptBook()). Without an argument it writes to stdout.
+ */
+import { writeFileSync } from "node:fs";
+import { CHECK_MODEL, RENDER_MODEL } from "../../supabase/functions/tryon/gateway.ts";
+import { PIECES } from "../../supabase/functions/tryon/pieces.ts";
+import { promptBook } from "../../supabase/functions/tryon/prompt.ts";
+
+const book = promptBook();
+const out = {
+  models: { render: RENDER_MODEL, check: CHECK_MODEL },
+  imageOrder: "Image 1 is the customer photo, Image 2 is the one product reference",
+  references: Object.fromEntries(
+    PIECES.flatMap((p) => Object.entries(p.refs).map(([stone, url]) => [`${p.handle}:${stone}`, `${url}&width=1024&format=jpg`])),
+  ),
+  ...book,
+};
+const text = JSON.stringify(out, null, 2) + "\n";
+const target = process.argv[2];
+if (target) {
+  writeFileSync(target, text);
+  console.log(`wrote ${Object.keys(book.render).length} render prompts to ${target}`);
+} else process.stdout.write(text);
