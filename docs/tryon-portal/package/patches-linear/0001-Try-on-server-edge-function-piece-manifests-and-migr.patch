+/** Production hosts, plus TRYON_EXTRA_ORIGINS for a preview (the
+    shopper-performance pattern). An exact match, never a substring: a
+    preview host can carry the shop's name. */
+export const originAllowed = (origin: string | null, env: Env) => {
+  if (!origin) return false;
+  if ((PROD_ORIGINS as readonly string[]).includes(origin)) return true;
+  return (env.TRYON_EXTRA_ORIGINS ?? "")
+    .split(",")
+    .map((s) => s.trim())
+    .filter((s) => /^https?:\/\/[^/\s]+$/.test(s))
+    .includes(origin);
+};
