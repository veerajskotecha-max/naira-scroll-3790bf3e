@@ -0,0 +1,211 @@
+/* Shared fixtures for the try-on function tests: a synthetic JPEG header
+   (bytes built here, never a photo of anyone), a scripted stand-in for the
+   Lovable gateway and the Shopify CDN, and the handler's deps with the
+   in-memory quota and ledger. */
+import type { Deps, Env } from "../../../supabase/functions/tryon/handler.ts";
+import { memoryQuota, sha256Hex, type Quota } from "../../../supabase/functions/tryon/quota.ts";
+import { memoryStats, type Stats } from "../../../supabase/functions/tryon/stats.ts";
+
+export const SALT = "s3cret-salt-of-at-least-32-characters!";
+export const DEVICE = "0b3f2a4e-7c1d-4e8a-9f00-123456789abc";
+export const ORIGIN = "https://nairaflore.com";
+export const URL_RENDER = "https://xlsejigpjlqfvzfhhntf.supabase.co/functions/v1/tryon/render";
+export const URL_FEEDBACK = "https://xlsejigpjlqfvzfhhntf.supabase.co/functions/v1/tryon/feedback";
+
+export const BASE_ENV: Env = {
+  TRYON_ENABLED: "on",
+  LOVABLE_API_KEY: "test-gateway-key",
+  TRYON_SALT: SALT,
+  TRYON_ALLOW_UNCERTIFIED: "1",
+};
+
+/** A JPEG header the server can size without decoding: SOI, APP0, an optional
+    comment segment carrying `marker`, SOF0 (or SOF2), EOI. */
+export function jpegBytes(width = 1152, height = 1536, opts: { marker?: string; progressive?: boolean; padTo?: number } = {}): Uint8Array {
+  const out: number[] = [0xff, 0xd8];
+  out.push(0xff, 0xe0, 0x00, 0x10, 0x4a, 0x46, 0x49, 0x46, 0x00, 0x01, 0x01, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00);
+  if (opts.marker) {
+    const text = Array.from(new TextEncoder().encode(opts.marker));
+    const len = text.length + 2;
+    out.push(0xff, 0xfe, len >> 8, len & 0xff, ...text);
+  }
+  out.push(0xff, opts.progressive ? 0xc2 : 0xc0, 0x00, 0x11, 0x08, height >> 8, height & 0xff, width >> 8, width & 0xff, 0x03, 0x01, 0x22, 0x00, 0x02, 0x11, 0x01, 0x03, 0x11, 0x01);
+  if (opts.padTo && opts.padTo > out.length + 2) {
+    // Filler inside a comment segment keeps the header walkable at any size.
+    let left = opts.padTo - out.length - 2;
+    while (left > 4) {
+      const n = Math.min(left - 4, 65000);
+      out.push(0xff, 0xfe, (n + 2) >> 8, (n + 2) & 0xff, ...new Array(n).fill(0x41));
+      left -= n + 4;
+    }
+  }
+  out.push(0xff, 0xd9);
+  return new Uint8Array(out);
+}
+
+/** The edited image the fake gateway returns: a PNG signature and a few bytes. */
+export const RESULT_PNG = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0x00, 0x00, 0x00, 0x0d, 0x49, 0x48, 0x44, 0x52, 7, 7, 7]);
+/** The reference photo the fake CDN returns. */
+export const REFERENCE_JPEG = jpegBytes(1024, 1024, { marker: "REFERENCE" });
+
+export const b64 = (bytes: Uint8Array) => Buffer.from(bytes).toString("base64");
+
+export type Meta = Record<string, unknown>;
+export const okMeta = (over: Meta = {}): Meta => ({
+  v: 1,
+  handle: "woven-gold-hoops",
+  stone: null,
+  kind: "face",
+  device: DEVICE,
+  consent: { version: "tryon-2026-11", accepted: true, adult: true, ownPhoto: true },
+  ...over,
+});
+
+type RequestOpts = {
+  meta?: Meta | string;
+  photo?: Uint8Array;
+  photoType?: string;
+  origin?: string | null;
+  extraParts?: Record<string, string>;
+  headers?: Record<string, string>;
+  /** Send without Content-Length, as a chunked stream. */
+  chunked?: boolean;
+};
+
+/** A multipart render request, serialised so it carries a real Content-Length
+    (Node's FormData bodies have none until read). */
+export async function renderRequest(opts: RequestOpts = {}): Promise<Request> {
+  const form = new FormData();
+  form.set("meta", typeof opts.meta === "string" ? opts.meta : JSON.stringify(opts.meta ?? okMeta()));
+  form.set("photo", new Blob([opts.photo ?? jpegBytes()], { type: opts.photoType ?? "image/jpeg" }), "photo.jpg");
+  for (const [k, v] of Object.entries(opts.extraParts ?? {})) form.set(k, v);
+  const draft = new Request(URL_RENDER, { method: "POST", body: form });
+  const body = new Uint8Array(await draft.arrayBuffer());
+  const headers: Record<string, string> = { "content-type": draft.headers.get("content-type")!, ...opts.headers };
+  const origin = opts.origin === undefined ? ORIGIN : opts.origin;
+  if (origin) headers.origin = origin;
+  if (opts.chunked) return new Request(URL_RENDER, { method: "POST", headers, body: streamOf(body, 64 * 1024), duplex: "half" } as RequestInit);
+  headers["content-length"] = String(body.byteLength);
+  return new Request(URL_RENDER, { method: "POST", headers, body });
+}
+
+/** A body that yields `chunk` bytes per read and pulls nothing until read
+    (high-water mark 0), so a test can tell whether the handler read it. */
+export function streamOf(bytes: Uint8Array, chunk: number, onPull?: () => void): ReadableStream<Uint8Array> {
+  let at = 0;
+  return new ReadableStream(
+    {
+      pull(ctl) {
+        onPull?.();
+        if (at >= bytes.length) return ctl.close();
+        ctl.enqueue(bytes.slice(at, at + chunk));
+        at += chunk;
+      },
+    },
+    { highWaterMark: 0 },
+  );
+}
+
+/** Lets real I/O (body parsing) run while timers are faked, until `ready`. */
+export async function until(ready: () => boolean) {
+  for (let i = 0; i < 1000 && !ready(); i++) await new Promise((r) => setImmediate(r));
+  if (!ready()) throw new Error("condition never met");
+}
+
+export function feedbackRequest(body: unknown, origin: string | null = ORIGIN): Request {
+  const text = typeof body === "string" ? body : JSON.stringify(body);
+  const headers: Record<string, string> = { "content-type": "application/json", "content-length": String(new TextEncoder().encode(text).byteLength) };
+  if (origin) headers.origin = origin;
+  return new Request(URL_FEEDBACK, { method: "POST", headers, body: text });
+}
+
+/* ---------- the fake gateway ---------- */
+
+export type Kind = "reference" | "precheck" | "render" | "verify" | "turnstile";
+type ChatPart = { type: string; text?: string; image_url?: { url: string } };
+export type ChatBody = { model: string; messages: { role: string; content: ChatPart[] }[]; modalities?: string[]; image_config?: unknown; max_tokens?: number };
+export type Call = { kind: Kind; url: string; init: RequestInit; body: ChatBody };
+export type Responder = (call: Call) => Response | Promise<Response>;
+
+const chatReply = (message: Record<string, unknown>) =>
+  new Response(JSON.stringify({ choices: [{ message: { role: "assistant", ...message } }] }), { headers: { "content-type": "application/json" } });
+
+export const reply = {
+  json: (obj: unknown): Responder => () => chatReply({ content: "```json\n" + JSON.stringify(obj) + "\n```" }),
+  text: (text: string): Responder => () => chatReply({ content: text }),
+  image: (bytes: Uint8Array = RESULT_PNG, mime = "image/png", text = ""): Responder => () =>
+    chatReply({ content: text, images: [{ type: "image_url", image_url: { url: `data:${mime};base64,${b64(bytes)}` } }] }),
+  status: (status: number): Responder => () => new Response(JSON.stringify({ error: { message: "MODEL-SECRET-TEXT" } }), { status }),
+  /** Never answers; rejects when the request is aborted, as fetch does. */
+  hang: (): Responder => (call) =>
+    new Promise((_, reject) => {
+      const signal = call.init.signal as AbortSignal | undefined;
+      signal?.addEventListener("abort", () => reject(new DOMException("aborted", "AbortError")), { once: true });
+    }),
+  /** Advances an injected clock before answering, to stand in for a slow model. */
+  after: (clock: { t: number }, ms: number, then: Responder): Responder => (call) => {
+    clock.t += ms;
+    return then(call);
+  },
+};
+
+export const PRECHECK_OK = { people: 1, adult: true, real_photo: true, ear_visible: true, neck_visible: true, hand_visible: true, back_of_hand: true, wrist_visible: true, too_dark: false, too_blurry: false, explicit: false };
+export const VERIFY_OK = { piece_present: true, same_design: true, same_colours: true, placement_ok: true, size_ok: true, person_unchanged: true, scene_unchanged: true, extra_items_added: false };
+
+type Script = Partial<Record<Kind, Responder | Responder[]>>;
+
+/** fetch for the handler: the CDN, the gateway's three calls and Turnstile,
+    each answered from the script (a list is used in order, the last repeats). */
+export function fakeFetch(script: Script = {}) {
+  const calls: Call[] = [];
+  const defaults: Record<Kind, Responder> = {
+    reference: () => new Response(REFERENCE_JPEG, { headers: { "content-type": "image/jpeg" } }),
+    precheck: reply.json(PRECHECK_OK),
+    render: reply.image(),
+    verify: reply.json(VERIFY_OK),
+    turnstile: () => new Response(JSON.stringify({ success: true })),
+  };
+  const used: Partial<Record<Kind, number>> = {};
+  const pick = (kind: Kind): Responder => {
+    const entry = script[kind];
+    if (!entry) return defaults[kind];
+    if (!Array.isArray(entry)) return entry;
+    const i = used[kind] ?? 0;
+    used[kind] = i + 1;
+    return entry[Math.min(i, entry.length - 1)];
+  };
+  const fetchFn = (async (input: RequestInfo | URL, init: RequestInit = {}) => {
+    const url = String(input);
+    let kind: Kind;
+    let body = null as unknown as ChatBody;
+    if (url.startsWith("https://cdn.shopify.com/") || url.startsWith("https://nairaflore.com/tryon/ref/")) kind = "reference";
+    else if (url.startsWith("https://challenges.cloudflare.com/")) kind = "turnstile";
+    else if (url.endsWith("/chat/completions")) {
+      body = JSON.parse(String(init.body)) as ChatBody;
+      kind = body.modalities ? "render" : body.messages[0].content.length === 4 ? "verify" : "precheck";
+    } else throw new Error(`unexpected fetch ${url}`);
+    const call = { kind, url, init, body };
+    calls.push(call);
+    return pick(kind)(call);
+  }) as typeof fetch;
+  return { fetch: fetchFn, calls, of: (kind: Kind) => calls.filter((c) => c.kind === kind) };
+}
+
+export function makeDeps(opts: { env?: Env; fetch?: typeof fetch; quota?: Quota | null; stats?: Stats | null; now?: () => number } = {}) {
+  const now = opts.now ?? (() => Date.now());
+  const quota = opts.quota === undefined ? memoryQuota(now) : opts.quota;
+  const stats = opts.stats === undefined ? memoryStats(now) : opts.stats;
+  const lines: string[] = [];
+  const deps: Deps = {
+    fetch: opts.fetch ?? fakeFetch().fetch,
+    quota,
+    stats,
+    now,
+    env: { ...BASE_ENV, ...opts.env },
+    log: (line) => lines.push(line),
+    sha256: sha256Hex,
+  };
+  return { deps, lines, quota, stats };
+}
+
+export const bodyOf = async (res: Response) => JSON.parse(await res.text());
