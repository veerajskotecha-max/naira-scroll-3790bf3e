+export function precheckVerdict(slot: Slot, reply: Record<string, unknown> | null): { state: string; reason: PhotoReason | null } {
+  const raw = reply?.people;
+  const people = typeof raw === "number" ? raw : typeof raw === "string" && /^\d+$/.test(raw) ? Number(raw) : null;
+  if (!reply || people === null) return { state: "unparsable", reason: null };
+  const isFalse = (k: string) => reply[k] === false;
+  const isTrue = (k: string) => reply[k] === true;
+  let reason: PhotoReason | null = null;
+  if (people === 0) reason = "no_person";
+  else if (people > 1) reason = "multiple_people";
+  else if (isFalse("adult")) reason = "under_18";
+  else if (isFalse("real_photo")) reason = "not_a_photo";
+  else if (isTrue("explicit")) reason = "blocked";
+  else if (isTrue("too_dark")) reason = "too_dark";
+  else if (isTrue("too_blurry")) reason = "too_blurry";
+  else if ((slot === "earrings" || slot === "ear-cuff") && isFalse("ear_visible")) reason = "ear_not_visible";
+  else if (slot === "necklace" && isFalse("neck_visible")) reason = "neck_not_visible";
+  else if (slot === "ring" && isFalse("hand_visible")) reason = "hand_not_visible";
+  else if (slot === "bracelet" && (isFalse("hand_visible") || isFalse("wrist_visible"))) reason = "wrist_not_visible";
+  return { state: reason ?? "pass", reason };
+}
+
+/** The verdict's rules: the first seven keys true and extra_items_added
+    false. A reply with none of the keys is unparsable, which fails. */
+export function verifyVerdict(reply: Record<string, unknown> | null): { parsed: boolean; pass: boolean; failed: VerifyKey[] } {
+  if (!reply || !VERIFY_KEYS.some((k) => typeof reply[k] === "boolean")) return { parsed: false, pass: false, failed: [] };
+  const failed = VERIFY_KEYS.filter((k) => (k === "extra_items_added" ? reply[k] !== false : reply[k] !== true));
+  return { parsed: true, pass: failed.length === 0, failed };
+}
+
+/** A gateway failure on any call, as the shopper hears it. */
+function gatewayFailure(e: unknown, deps: Deps): Failure {
+  if (e instanceof GatewayError) {
+    if (e.failure === "timeout") return ["timeout", {}];
+    if (e.failure === "status") {
+      if (e.status === 429) return ["busy", { retryAfter: 60 }];
+      if (e.status === 402) {
+        deps.log("tryon credits exhausted", "error");
+        return ["paused", { reason: "credits" }];
+      }
+      if (e.status === 401 || e.status === 403) return ["paused", { reason: "not_configured" }];
+    }
+  }
+  return ["failed", {}];
+}
+
+/** A verdict call that failed in strict mode: the image exists but is unchecked,
+    so it is not shown. Account states keep their meaning; anything else is busy. */
+function verifyFailure(e: unknown, deps: Deps): Failure {
+  const mapped = gatewayFailure(e, deps);
+  if (mapped[0] === "paused" || mapped[0] === "busy") return mapped;
+  return ["busy", { status: 503, retryAfter: 60 }];
+}
+
+type Image = { mime: string; dataUrl: string; bytes: Uint8Array };
+
+async function render(req: Request, deps: Deps, run: Run): Promise<Response> {
+  const env = deps.env;
+  if (!originAllowed(req.headers.get("origin"), env)) return run.reply("origin");
+  if (env.TRYON_ENABLED !== "on") return run.reply("paused", { reason: "off" });
+  const key = env.LOVABLE_API_KEY;
+  const salt = env.TRYON_SALT;
+  const { quota, stats } = deps;
+  if (!key || !salt || salt.length < 32 || !quota || !stats) return run.reply("paused", { reason: "not_configured" });
+
+  const declared = req.headers.get("content-length");
+  if (declared !== null && Number(declared) > LIMITS.body) return run.reply("too_large");
+  let raw: Uint8Array;
+  try {
+    raw = await readCapped(req, LIMITS.body, run.signal);
+  } catch (e) {
+    return run.reply(e instanceof TooLarge ? "too_large" : "bad_request");
+  }
+  run.line.inBytes = raw.byteLength;
+
+  const form = await parseForm(raw, req.headers.get("content-type"));
+  const meta = form ? parseMeta(form.meta) : null;
+  if (!form || !meta) return run.reply("bad_request");
+  const piece = PIECE_BY_HANDLE[meta.handle];
+  run.line.handle = piece.handle;
+  if (meta.kind !== piece.kind || !stoneOk(piece, meta.stone)) return run.reply("bad_request");
+  if (!piece.certified && env.TRYON_ALLOW_UNCERTIFIED !== "1") return run.reply("paused", { reason: "piece_unavailable" });
+
+  if (form.photo.size > LIMITS.photo) return run.reply("too_large");
+  if (form.photo.type !== "image/jpeg") return run.reply("not_jpeg");
+  const photo = new Uint8Array(await form.photo.arrayBuffer());
+  if (!isTryOnPhoto(jpegSize(photo))) return run.reply("not_jpeg");
+
+  const ip = (req.headers.get("x-forwarded-for") ?? "").split(",")[0].trim();
+  if (env.TURNSTILE_SECRET && !(await turnstileOk(deps, env.TURNSTILE_SECRET, meta.turnstile, ip, run.signal))) return run.reply("challenge");
+
+  const day = istDay(deps.now());
+  const deviceKey = await keyHash(deps.sha256, salt, day, "device", meta.device);
+  const ipKey = ip ? await keyHash(deps.sha256, salt, day, "ip", ip) : deviceKey;
+  let taken: TakeResult;
+  try {
+    taken = await quota.take(deviceKey, ipKey, limitsFrom(env));
+  } catch {
+    return run.reply("paused", { reason: "not_configured" });
+  }
+  if (run.finished) {
+    // The deadline answered while the database was slow: give the try back.
+    if (taken.ok) await quota.refund(deviceKey, ipKey).catch(() => {});
+    return run.reply("timeout");
+  }
+  if (!taken.ok) {
+    if (taken.scope === "all") return run.reply("paused", { reason: "daily_cap" });
+    return run.reply(taken.scope === "device" ? "device_limit" : "ip_limit", { resetAt: nextIstMidnight(deps.now()) });
+  }
+
+  const stone = meta.stone;
+  const model = renderModel(env.TRYON_RENDER_ID);
+  const verdict: Record<string, unknown> = { model };
+  run.track({
+    row: { id: crypto.randomUUID(), handle: piece.handle, stone, kind: piece.kind, verdict, consent_version: meta.consent.version },
+    refund: () => quota.refund(deviceKey, ipKey),
+    stats,
+  });
+
+  let reference: string;
+  try {
+    reference = await referenceB64(deps.fetch, piece, stone, run.signal);
+  } catch {
+    return run.settle("paused", { reason: "piece_unavailable" });
+  }
+
+  const chat = makeChat(deps.fetch, gatewayBase(env.TRYON_GATEWAY_URL), key, run.signal);
+  const photoUrl = "data:image/jpeg;base64," + toBase64(photo);
+  const refUrl = "data:image/jpeg;base64," + reference;
+
+  // 1. Pre-check: is this a usable photo for this slot?
+  const started = deps.now();
+  let precheck: unknown;
+  try {
+    precheck = await chat(checkBody([imagePart(photoUrl), textPart(buildPrecheckPrompt(piece.slot))]), TIMEOUTS.precheck);
+  } catch (e) {
+    return run.settle(...gatewayFailure(e, deps));
+  } finally {
+    run.timing.precheckMs = deps.now() - started;
+  }
+  const check = precheckVerdict(piece.slot, jsonFromReply(textFromReply(precheck)));
+  verdict.precheck = check.state;
+  if (check.reason) return run.settle("photo_unusable", { reason: check.reason });
+
+  // 2. Render, then 3. the verdict, with at most one corrected retry.
+  const renderOnce = async (text: string, timeoutMs: number): Promise<{ image: Image } | { fail: Failure }> => {
+    run.line.attempts++;
+    const t = deps.now();
+    let reply: unknown;
+    try {
+      reply = await chat(renderBody(model, [imagePart(photoUrl), imagePart(refUrl), textPart(text)]), timeoutMs);
+    } catch (e) {
+      return { fail: gatewayFailure(e, deps) };
+    } finally {
+      run.timing.renderMs += deps.now() - t;
+    }
+    const image = imageFromReply(reply);
+    if (image) return { image };
+    const code = refusalCode(textFromReply(reply));
+    return { fail: ["photo_unusable", { reason: code ? REFUSAL_REASON[code] : "model_declined" }] };
+  };
+  const verifyText = buildVerifyPrompt(piece, stone);
+  const verdicts: unknown[] = [];
+  verdict.verify = verdicts;
+  type Checked = { verdict: ReturnType<typeof verifyVerdict> } | { error: unknown };
+  const verifyOnce = async (image: Image, timeoutMs: number): Promise<Checked> => {
+    const t = deps.now();
+    try {
+      const reply = await chat(checkBody([imagePart(refUrl), imagePart(photoUrl), imagePart(image.dataUrl), textPart(verifyText)]), timeoutMs);
+      const v = verifyVerdict(jsonFromReply(textFromReply(reply)));
+      verdicts.push(v.parsed ? { pass: v.pass, failed: v.failed } : "unparsable");
+      return { verdict: v };
+    } catch (e) {
+      verdicts.push("error");
+      return { error: e };
+    } finally {
+      run.timing.verifyMs = (run.timing.verifyMs ?? 0) + deps.now() - t;
+    }
+  };
+
+  const mode = env.TRYON_VERIFY === "log" || env.TRYON_VERIFY === "off" ? env.TRYON_VERIFY : "strict";
+  const renderText = buildRenderPrompt(piece, stone);
+  const first = await renderOnce(renderText, TIMEOUTS.render);
+  if ("fail" in first) return run.settle(...first.fail);
+  if (mode === "off") return run.succeed(first.image, "off", taken.deviceLeft);
+
+  const checked = await verifyOnce(first.image, TIMEOUTS.verify);
+  if (mode === "log") {
+    // The image is shown either way; an empty credit balance is still reported.
+    if ("error" in checked && checked.error instanceof GatewayError && checked.error.status === 402) deps.log("tryon credits exhausted", "error");
+    return run.succeed(first.image, "verdict" in checked && checked.verdict.pass ? "pass" : "log", taken.deviceLeft);
+  }
+  if ("error" in checked) return run.settle(...verifyFailure(checked.error, deps));
+  if (checked.verdict.pass) return run.succeed(first.image, "pass", taken.deviceLeft);
+  if (run.elapsed() > TIMEOUTS.retryWindow) return run.settle("fidelity_failed");
+
+  const second = await renderOnce(renderText + retrySuffix(checked.verdict.failed), TIMEOUTS.retryRender);
+  if ("fail" in second) return run.settle(...second.fail);
+  const rechecked = await verifyOnce(second.image, TIMEOUTS.retryVerify);
+  if ("error" in rechecked) return run.settle(...verifyFailure(rechecked.error, deps));
+  if (!rechecked.verdict.pass) return run.settle("fidelity_failed");
+  return run.succeed(second.image, "pass", taken.deviceLeft);
+}
+
+async function feedback(req: Request, deps: Deps, run: Run): Promise<Response> {
+  if (!originAllowed(req.headers.get("origin"), deps.env)) return run.reply("origin");
+  // Always 204, applied or not, so the endpoint answers nothing about a render id.
+  const done = (applied: boolean) => {
+    run.line.code = applied ? "ok" : "ignored";
+    return new Response(null, { status: 204, headers: corsHeaders });
+  };
+  const declared = req.headers.get("content-length");
+  if (declared !== null && Number(declared) > LIMITS.feedback) return done(false);
+  let parsed: z.infer<typeof FeedbackBody>;
+  try {
+    const raw = await readCapped(req, LIMITS.feedback);
+    run.line.inBytes = raw.byteLength;
+    const result = FeedbackBody.safeParse(JSON.parse(new TextDecoder().decode(raw)));
+    if (!result.success) return done(false);
+    parsed = result.data;
+  } catch {
+    return done(false);
+  }
+  if (!deps.stats || (parsed.looksRight === null && parsed.scene === null)) return done(false);
+  const answer = parsed.looksRight === null ? null : parsed.looksRight ? "yes" : "no";
+  try {
+    await deps.stats.feedback(parsed.render, answer, parsed.scene);
+  } catch {
+    return done(false);
+  }
+  return done(true);
+}
