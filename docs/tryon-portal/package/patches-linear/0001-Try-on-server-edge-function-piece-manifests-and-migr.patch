+      ["attempts", "consent_version", "created_at", "feedback", "handle", "id", "kind", "out_bytes", "outcome", "precheck_ms", "reason", "render_ms", "scene", "stone", "total_ms", "verdict", "verify_ms"].sort(),
+    );
+    const text = JSON.stringify(row);
+    const day = "2026-10-30";
+    for (const secret of [DEVICE, ip, SALT, await keyHash(deps.sha256, SALT, day, "device", DEVICE), await keyHash(deps.sha256, SALT, day, "ip", ip)])
+      expect(text).not.toContain(secret);
+    expect(row).toMatchObject({ handle: "woven-gold-hoops", stone: null, kind: "face", outcome: "ok", attempts: 1, consent_version: "tryon-2026-11" });
+    expect(row.verdict).toEqual({ model: RENDER_MODEL, precheck: "pass", verify: [{ pass: true, failed: [] }] });
