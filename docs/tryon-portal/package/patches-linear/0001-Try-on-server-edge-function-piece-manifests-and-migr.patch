+
+/** A signal that aborts after `ms`, or with its parent. Built on setTimeout
+    rather than AbortSignal.timeout so the deadline tests can drive it with
+    fake timers; the behaviour is the same. */
+export const timeoutSignal = (parent: AbortSignal, ms: number) => {
+  const ctl = new AbortController();
+  let timedOut = false;
+  const timer = setTimeout(() => {
+    timedOut = true;
+    ctl.abort();
+  }, ms);
+  const onParent = () => ctl.abort();
+  if (parent.aborted) ctl.abort();
+  else parent.addEventListener("abort", onParent, { once: true });
+  return {
+    signal: ctl.signal,
+    timedOut: () => timedOut,
+    done: () => {
+      clearTimeout(timer);
+      parent.removeEventListener("abort", onParent);
+    },
+  };
+};
