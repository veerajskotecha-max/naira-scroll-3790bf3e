+  private async record(outcome: string, reason: string | null) {
+    if (!this.attempt) return;
+    const t = this.timing;
+    const row: RenderRow = {
+      ...this.attempt.row,
+      outcome,
+      reason,
+      attempts: this.line.attempts,
+      precheck_ms: t.precheckMs,
+      render_ms: this.line.attempts ? t.renderMs : null,
+      verify_ms: t.verifyMs,
+      total_ms: this.elapsed(),
+      out_bytes: t.outBytes,
+    };
