diff --git a/scripts/tryon/check-refs.ts b/scripts/tryon/check-refs.ts
new file mode 100644
index 0000000..6fbfd96
--- /dev/null
+++ b/scripts/tryon/check-refs.ts
@@ -0,0 +1,36 @@
+/**
+ * Checks every try-on reference photo is still served: a HEAD (then a GET if
+ * the CDN refuses HEAD) on each reference URL exactly as the function fetches
+ * it, with "&width=1024&format=jpg". Fails on anything but a 200 image.
+ *
+ *   npx vite-node scripts/tryon/check-refs.ts
+ *
+ * Run before every publish. A photo replaced or deleted in Shopify would make
+ * the function answer 503 paused (piece_unavailable) for that piece and stone.
+ * Read-only: it only reads public CDN files.
+ */
+import { PIECES, referenceUrl, type Stone } from "../../supabase/functions/tryon/pieces.ts";
+
+type Result = { key: string; url: string; status: number; type: string; bytes: string; ok: boolean };
+
+async function check(key: string, url: string): Promise<Result> {
+  let res = await fetch(url, { method: "HEAD" }).catch(() => null);
+  if (!res || res.status === 405 || res.status === 403) res = await fetch(url).catch(() => null);
+  const status = res?.status ?? 0;
+  const type = res?.headers.get("content-type") ?? "";
+  const bytes = res?.headers.get("content-length") ?? "?";
+  await res?.body?.cancel().catch(() => {});
+  return { key, url, status, type, bytes, ok: status === 200 && type.startsWith("image/") && (bytes === "?" || Number(bytes) <= 2 * 1024 * 1024) };
+}
+
+const jobs = PIECES.flatMap((piece) =>
+  (piece.stones ?? [null]).map((stone: Stone | null) => {
+    const url = referenceUrl(piece, stone);
+    return { key: `${piece.handle}:${stone ?? "default"}`, url };
+  }),
+);
+const results = await Promise.all(jobs.map((j) => (j.url ? check(j.key, j.url) : Promise.resolve({ key: j.key, url: "(not allowed)", status: 0, type: "", bytes: "", ok: false }))));
+for (const r of results) console.log(`${r.ok ? "ok  " : "FAIL"} ${r.status} ${r.type.padEnd(11)} ${String(r.bytes).padStart(7)}  ${r.key}`);
+const failed = results.filter((r) => !r.ok);
+console.log(`\n${results.length - failed.length} of ${results.length} references served as images`);
+if (failed.length) process.exit(1);
