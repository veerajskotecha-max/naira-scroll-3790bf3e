@@ -0,0 +1,723 @@
+// @vitest-environment node
+/*
+  The real try-on handler against a scripted gateway and the in-memory quota
+  and ledger. What each block prevents is in its comment.
+*/
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { corsHeaders } from "npm:@supabase/supabase-js@2/cors";
+import { clearReferenceCache, EXPOSED_HEADERS, handle, precheckVerdict, verifyVerdict } from "../../../supabase/functions/tryon/handler.ts";
+import { CHECK_MODEL, RENDER_MODEL } from "../../../supabase/functions/tryon/gateway.ts";
+import { PIECE_BY_HANDLE } from "../../../supabase/functions/tryon/pieces.ts";
+import { buildPrecheckPrompt, buildRenderPrompt, buildVerifyPrompt, promptBook, retrySuffix } from "../../../supabase/functions/tryon/prompt.ts";
+import { keyHash, memoryQuota, type Quota } from "../../../supabase/functions/tryon/quota.ts";
+import { memoryStats } from "../../../supabase/functions/tryon/stats.ts";
+import {
+  b64,
+  bodyOf,
+  DEVICE,
+  fakeFetch,
+  feedbackRequest,
+  jpegBytes,
+  makeDeps,
+  okMeta,
+  PRECHECK_OK,
+  REFERENCE_JPEG,
+  renderRequest,
+  reply,
+  RESULT_PNG,
+  SALT,
+  streamOf,
+  until,
+  URL_RENDER,
+  VERIFY_OK,
+} from "./helpers";
+
+beforeEach(() => clearReferenceCache());
+afterEach(() => vi.useRealTimers());
+
+// 15:30 IST on 30 Oct 2026; the next IST midnight is 18:30 UTC that day.
+const NOON_IST = Date.UTC(2026, 9, 30, 10, 0);
+
+describe("contract", () => {
+  it("answers a preflight with the stock Supabase CORS headers", async () => {
+    const res = await handle(new Request(URL_RENDER, { method: "OPTIONS" }), makeDeps().deps);
+    expect(res.status).toBe(200);
+    expect(await res.text()).toBe("ok");
+    for (const [k, v] of Object.entries(corsHeaders)) expect(res.headers.get(k)).toBe(v);
+  });
+
+  it("refuses anything but POST", async () => {
+    const res = await handle(new Request(URL_RENDER, { method: "GET", headers: { origin: "https://nairaflore.com" } }), makeDeps().deps);
+    expect(res.status).toBe(405);
+  });
+
+  /* A public endpoint that spends money: only the shop's own pages may call it.
+     Exact matches only, never a substring (a preview host can carry the name). */
+  it.each(["https://nairaflore.com", "https://www.nairaflore.com"])("lets %s through", async (origin) => {
+    const res = await handle(await renderRequest({ origin }), makeDeps().deps);
+    expect(res.status).toBe(200);
+  });
+  it.each(["https://evil.example", "https://nairaflore.com.evil.example", "http://nairaflore.com", "null", null])("refuses origin %s", async (origin) => {
+    const res = await handle(await renderRequest({ origin }), makeDeps().deps);
+    expect(res.status).toBe(403);
+    expect(await bodyOf(res)).toEqual({ code: "origin", retryable: false });
+  });
+  it("honours TRYON_EXTRA_ORIGINS for a preview", async () => {
+    const preview = "https://id-preview--abc.lovable.app";
+    expect((await handle(await renderRequest({ origin: preview }), makeDeps().deps)).status).toBe(403);
+    const res = await handle(await renderRequest({ origin: preview }), makeDeps({ env: { TRYON_EXTRA_ORIGINS: `http://127.0.0.1:4173, ${preview}` } }).deps);
+    expect(res.status).toBe(200);
+  });
+
+  /* Two flags keep a publish inert; a missing secret or database fails closed. */
+  it("rests when TRYON_ENABLED is not 'on'", async () => {
+    for (const value of [undefined, "", "true", "ON"]) {
+      const res = await handle(await renderRequest(), makeDeps({ env: { TRYON_ENABLED: value } }).deps);
+      expect(res.status).toBe(503);
+      expect(await bodyOf(res)).toEqual({ code: "paused", reason: "off", retryable: false });
+    }
+  });
+  it.each([
+    ["no gateway key", { env: { LOVABLE_API_KEY: undefined } }],
+    ["no salt", { env: { TRYON_SALT: undefined } }],
+    ["a short salt", { env: { TRYON_SALT: "too-short" } }],
+    ["no database for quota", { quota: null }],
+    ["no database for the ledger", { stats: null }],
+  ])("answers not_configured with %s", async (_label, opts) => {
+    const f = fakeFetch();
+    const res = await handle(await renderRequest(), makeDeps({ ...opts, fetch: f.fetch } as never).deps);
+    expect(res.status).toBe(503);
+    expect(await bodyOf(res)).toEqual({ code: "paused", reason: "not_configured", retryable: false });
+    expect(f.calls).toEqual([]);
+  });
+  it("answers not_configured when the quota RPC fails (migration not applied)", async () => {
+    const broken: Quota = { take: () => Promise.reject(new Error("relation does not exist")), refund: async () => {} };
+    const f = fakeFetch();
+    const res = await handle(await renderRequest(), makeDeps({ quota: broken, fetch: f.fetch }).deps);
+    expect(res.status).toBe(503);
+    expect((await bodyOf(res)).reason).toBe("not_configured");
+    expect(f.calls).toEqual([]);
+  });
+
+  /* The cap holds whether or not the client declares a length: a proxy may
+     forward the upload chunked. */
+  it("refuses an oversized body by Content-Length before reading it", async () => {
+    let pulled = 0;
+    const req = new Request(URL_RENDER, {
+      method: "POST",
+      headers: { origin: "https://nairaflore.com", "content-type": "multipart/form-data; boundary=x", "content-length": "1300001" },
+      body: streamOf(new Uint8Array(10), 10, () => pulled++),
+      duplex: "half",
+    } as RequestInit);
+    const res = await handle(req, makeDeps().deps);
+    expect(res.status).toBe(413);
+    expect(await bodyOf(res)).toEqual({ code: "too_large", retryable: false });
+    expect(pulled).toBe(0);
+  });
+  it("refuses an oversized chunked body with no Content-Length", async () => {
+    const big = jpegBytes(1152, 1536, { padTo: 1_400_000 });
+    const req = await renderRequest({ photo: big, chunked: true });
+    expect(req.headers.get("content-length")).toBeNull();
+    const res = await handle(req, makeDeps().deps);
+    expect(res.status).toBe(413);
+  });
+  it("accepts a chunked body under the cap", async () => {
+    const res = await handle(await renderRequest({ chunked: true }), makeDeps().deps);
+    expect(res.status).toBe(200);
+  });
+  it("refuses a photo part over 1.2 MB", async () => {
+    const res = await handle(await renderRequest({ photo: jpegBytes(1152, 1536, { padTo: 1_250_000 }) }), makeDeps().deps);
+    expect(res.status).toBe(413);
+  });
+
+  /* The browser sends enums only. Any extra key is how a prompt, a model or a
+     reference would sneak in, so the schema is strict. */
+  it.each([
+    ["a prompt", okMeta({ prompt: "make it bigger" })],
+    ["a model", okMeta({ model: "openai/gpt-image-2" })],
+    ["a reference", okMeta({ reference: "https://evil.example/x.jpg" })],
+    ["an image_url", okMeta({ image_url: "data:image/png;base64,AAAA" })],
+    ["an unknown handle", okMeta({ handle: "not-a-pick" })],
+    ["a stone the piece is not sold in", okMeta({ handle: "baguette-tennis-bracelet", kind: "hand", stone: "Amethyst" })],
+    ["a stone on a one-colour piece", okMeta({ stone: "Ruby" })],
+    ["no stone on a colour piece", okMeta({ handle: "baguette-huggies", stone: null })],
+    ["the wrong photo kind", okMeta({ kind: "hand" })],
+    ["consent not accepted", okMeta({ consent: { version: "tryon-2026-11", accepted: false, adult: true, ownPhoto: true } })],
+    ["not confirmed adult", okMeta({ consent: { version: "tryon-2026-11", accepted: true, adult: false, ownPhoto: true } })],
+    ["not their own photo", okMeta({ consent: { version: "tryon-2026-11", accepted: true, adult: true, ownPhoto: false } })],
+    ["an old consent version", okMeta({ consent: { version: "tryon-2026-01", accepted: true, adult: true, ownPhoto: true } })],
+    ["an extra consent key", okMeta({ consent: { version: "tryon-2026-11", accepted: true, adult: true, ownPhoto: true, marketing: true } })],
+    ["a device that is not a uuid", okMeta({ device: "naira_vid_123" })],
+    ["a version 2 body", okMeta({ v: 2 })],
+  ])("refuses meta with %s", async (_label, meta) => {
+    const f = fakeFetch();
+    const res = await handle(await renderRequest({ meta }), makeDeps({ fetch: f.fetch }).deps);
+    expect(res.status).toBe(400);
+    expect(await bodyOf(res)).toEqual({ code: "bad_request", retryable: false });
+    expect(f.calls).toEqual([]);
+  });
+  it("refuses meta that is not JSON, or over 1 KB", async () => {
+    expect((await handle(await renderRequest({ meta: "{not json" }), makeDeps().deps)).status).toBe(400);
+    const long = JSON.stringify(okMeta({ turnstile: "x".repeat(1100) }));
+    expect((await handle(await renderRequest({ meta: long }), makeDeps().deps)).status).toBe(400);
+  });
+  it("refuses a third multipart part", async () => {
+    const res = await handle(await renderRequest({ extraParts: { prompt: "anything" } }), makeDeps().deps);
+    expect(res.status).toBe(400);
+  });
+
+  /* Only the phone's own output is accepted: a 3:4 JPEG of 1024–1600 px. */
+  it("refuses PNG bytes, a 4:3 JPEG, a tiny JPEG and a non-JPEG part type", async () => {
+    const png = new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 0, 0, 0, 0]);
+    for (const opts of [{ photo: png }, { photo: jpegBytes(1536, 1152) }, { photo: jpegBytes(600, 800) }, { photoType: "image/png" }]) {
+      const res = await handle(await renderRequest(opts), makeDeps().deps);
+      expect(res.status).toBe(415);
+      expect(await bodyOf(res)).toEqual({ code: "not_jpeg", retryable: false });
+    }
+  });
+  it("accepts a progressive JPEG", async () => {
+    expect((await handle(await renderRequest({ photo: jpegBytes(1152, 1536, { progressive: true }) }), makeDeps().deps)).status).toBe(200);
+  });
+
+  /* An uncertified piece must never be rendered on the real shop. */
+  it("rests an uncertified piece unless TRYON_ALLOW_UNCERTIFIED=1", async () => {
+    const f = fakeFetch();
+    const res = await handle(await renderRequest(), makeDeps({ env: { TRYON_ALLOW_UNCERTIFIED: undefined }, fetch: f.fetch }).deps);
+    expect(res.status).toBe(503);
+    expect(await bodyOf(res)).toEqual({ code: "paused", reason: "piece_unavailable", retryable: false });
+    expect(f.calls).toEqual([]);
+    const piece = PIECE_BY_HANDLE["woven-gold-hoops"];
+    piece.certified = "2026-11-01";
+    try {
+      expect((await handle(await renderRequest(), makeDeps({ env: { TRYON_ALLOW_UNCERTIFIED: undefined } }).deps)).status).toBe(200);
+    } finally {
+      piece.certified = null;
+    }
+  });
+
+  /* Limits by IST day. The reset time is the next 00:00 in India. */
+  it("stops a device after 5 a day, with resetAt at the next IST midnight", async () => {
+    const { deps } = makeDeps({ now: () => NOON_IST });
+    for (let i = 0; i < 5; i++) {
+      const ok = await handle(await renderRequest(), deps);
+      expect(ok.status).toBe(200);
+      expect(ok.headers.get("X-Tryon-Remaining")).toBe(String(4 - i));
+    }
+    const res = await handle(await renderRequest(), deps);
+    expect(res.status).toBe(429);
+    expect(await bodyOf(res)).toEqual({ code: "device_limit", resetAt: "2026-10-30T18:30:00.000Z", retryable: false });
+  });
+  it("stops one network address after TRYON_IP_DAILY, across devices", async () => {
+    const { deps } = makeDeps({ now: () => NOON_IST, env: { TRYON_IP_DAILY: "2" } });
+    const from = (device: string) => renderRequest({ meta: okMeta({ device }), headers: { "x-forwarded-for": "203.0.113.9, 10.0.0.1" } });
+    expect((await handle(await from("11111111-1111-4111-8111-111111111111"), deps)).status).toBe(200);
+    expect((await handle(await from("22222222-2222-4222-8222-222222222222"), deps)).status).toBe(200);
+    const res = await handle(await from("33333333-3333-4333-8333-333333333333"), deps);
+    expect(res.status).toBe(429);
+    expect(await bodyOf(res)).toEqual({ code: "ip_limit", resetAt: "2026-10-30T18:30:00.000Z", retryable: false });
+  });
+  it("rests everyone once the day's global cap is reached", async () => {
+    const { deps } = makeDeps({ now: () => NOON_IST, env: { TRYON_DAILY_CAP: "2" } });
+    const from = (device: string, ip: string) => renderRequest({ meta: okMeta({ device }), headers: { "x-forwarded-for": ip } });
+    expect((await handle(await from("11111111-1111-4111-8111-111111111111", "203.0.113.1"), deps)).status).toBe(200);
+    expect((await handle(await from("22222222-2222-4222-8222-222222222222", "203.0.113.2"), deps)).status).toBe(200);
+    const res = await handle(await from("33333333-3333-4333-8333-333333333333", "203.0.113.3"), deps);
+    expect(res.status).toBe(503);
+    expect(await bodyOf(res)).toEqual({ code: "paused", reason: "daily_cap", retryable: false });
+  });
+  it("gives the reset time across the IST date line", async () => {
+    // 01:30 IST on 31 Oct: the next midnight is 18:30 UTC on 31 Oct.
+    const { deps } = makeDeps({ now: () => Date.UTC(2026, 9, 30, 20, 0), env: { TRYON_DEVICE_DAILY: "1" } });
+    await handle(await renderRequest(), deps);
+    expect((await bodyOf(await handle(await renderRequest(), deps))).resetAt).toBe("2026-10-31T18:30:00.000Z");
+  });
+
