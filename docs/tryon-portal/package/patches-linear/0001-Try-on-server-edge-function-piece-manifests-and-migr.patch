+// @vitest-environment node
+/*
+  The server sizes the photo from its JPEG frame header without decoding it.
+  The fixtures are gradients drawn with PIL (no person): a baseline, a
+  progressive, and one with an EXIF block (orientation 6) before the frame.
+*/
+import { readFileSync } from "node:fs";
+import { describe, expect, it } from "vitest";
+import { isTryOnPhoto, jpegSize } from "../../../supabase/functions/tryon/jpeg.ts";
+import { jpegBytes } from "./helpers";
+
+const fixture = (name: string) => new Uint8Array(readFileSync(new URL(`./fixtures/${name}`, import.meta.url)));
+
+describe("jpegSize", () => {
+  it("reads a baseline JPEG", () => {
+    expect(jpegSize(fixture("baseline-90x120.jpg"))).toEqual({ width: 90, height: 120 });
+  });
+  it("reads a progressive JPEG", () => {
+    expect(jpegSize(fixture("progressive-90x120.jpg"))).toEqual({ width: 90, height: 120 });
+  });
+  it("walks past an EXIF block to the frame header", () => {
+    const bytes = fixture("exif-orientation6-160x120.jpg");
+    expect(bytes[2] === 0xff && bytes[3] === 0xe0).toBe(true);
+    expect(jpegSize(bytes)).toEqual({ width: 160, height: 120 });
+  });
+  it("reads the synthetic headers the handler tests send", () => {
+    expect(jpegSize(jpegBytes(1152, 1536))).toEqual({ width: 1152, height: 1536 });
+    expect(jpegSize(jpegBytes(1152, 1536, { progressive: true, marker: "x" }))).toEqual({ width: 1152, height: 1536 });
+  });
+  it("skips fill bytes before a marker", () => {
+    const b = jpegBytes(300, 400);
+    const padded = new Uint8Array([...b.slice(0, 2), 0xff, 0xff, ...b.slice(2)]);
+    expect(jpegSize(padded)).toEqual({ width: 300, height: 400 });
+  });
+  it("refuses anything that is not a JPEG with a frame header", () => {
+    expect(jpegSize(new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))).toBeNull();
+    expect(jpegSize(new Uint8Array([0xff, 0xd8, 0xff]))).toBeNull();
+    expect(jpegSize(new Uint8Array([0xff, 0xd8, 0xff, 0xd9]))).toBeNull();
+    expect(jpegSize(fixture("baseline-90x120.jpg").slice(0, 30))).toBeNull();
+    expect(jpegSize(new Uint8Array(0))).toBeNull();
+  });
+});
+
+describe("isTryOnPhoto", () => {
+  it("accepts the phone's 3:4 output between 1024 and 1600 px", () => {
+    for (const [w, h] of [[1152, 1536], [768, 1024], [1200, 1600], [1140, 1536], [1164, 1536]]) expect(isTryOnPhoto({ width: w, height: h })).toBe(true);
+  });
+  it("refuses landscape, the wrong shape, too small or too large", () => {
+    for (const [w, h] of [[1536, 1152], [1080, 1536], [1200, 1536], [600, 800], [1260, 1680], [1536, 1536]]) expect(isTryOnPhoto({ width: w, height: h })).toBe(false);
+    expect(isTryOnPhoto(null)).toBe(false);
+  });
+});
