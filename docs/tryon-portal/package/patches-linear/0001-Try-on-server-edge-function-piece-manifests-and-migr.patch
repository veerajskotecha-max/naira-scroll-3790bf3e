+    for (const script of [
+      { render: reply.text(`${secret} NO_EAR`) },
+      { render: reply.status(500) },
+      { precheck: reply.text(`{"people": 3, "note": "${secret}"}`) },
+      { verify: reply.text(`{"same_design": false, "why": "${secret}"}`) },
+    ]) {
