index 0000000..6b4ca6f
--- /dev/null
+++ b/tests/edge/tryon/body.test.ts
@@ -0,0 +1,46 @@
+// @vitest-environment node
+/*
+  The upload cap is enforced on the bytes read, not on a header the client or
+  a proxy may leave out.
+*/
+import { describe, expect, it } from "vitest";
+import { readCapped, TooLarge } from "../../../supabase/functions/tryon/body.ts";
+import { streamOf } from "./helpers";
+
+const bytes = (n: number) => new Uint8Array(n).fill(7);
+
+describe("readCapped", () => {
+  it("returns the whole body under the cap, chunk by chunk", async () => {
+    const out = await readCapped({ body: streamOf(bytes(1000), 64) }, 1000);
+    expect(out.byteLength).toBe(1000);
+    expect(out.every((b) => b === 7)).toBe(true);
+  });
+
+  it("stops at the cap and reads no further", async () => {
+    let pulls = 0;
+    const read = readCapped({ body: streamOf(bytes(10_000), 100, () => pulls++) }, 1000);
+    await expect(read).rejects.toBeInstanceOf(TooLarge);
+    // 11 chunks of 100 cross 1000 bytes; nothing after that is pulled.
+    expect(pulls).toBe(11);
+  });
+
+  it("works with a Request that has no Content-Length", async () => {
+    const req = new Request("https://x/functions/v1/tryon/render", { method: "POST", body: streamOf(bytes(5000), 512), duplex: "half" } as RequestInit);
+    expect(req.headers.get("content-length")).toBeNull();
+    await expect(readCapped(req, 4999)).rejects.toBeInstanceOf(TooLarge);
+    const ok = new Request("https://x/functions/v1/tryon/render", { method: "POST", body: streamOf(bytes(5000), 512), duplex: "half" } as RequestInit);
+    expect((await readCapped(ok, 5000)).byteLength).toBe(5000);
+  });
+
+  it("reads an empty body as no bytes", async () => {
+    expect((await readCapped({ body: null }, 10)).byteLength).toBe(0);
+  });
+
+  it("gives up when its signal aborts", async () => {
+    const ctl = new AbortController();
+    const never = new ReadableStream<Uint8Array>({ pull: () => new Promise(() => {}) }, { highWaterMark: 0 });
+    const read = readCapped({ body: never }, 10, ctl.signal);
+    ctl.abort();
+    await expect(read).rejects.toBeDefined();
+  });
+});
