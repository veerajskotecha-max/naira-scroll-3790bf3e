+  constructor(
+    op: string,
+    readonly t0: number,
+    private readonly now: () => number,
+  ) {
+    this.line = { op, handle: null, code: "ok", reason: null, attempts: 0, ms: 0, inBytes: 0, outBytes: 0 };
+  }
