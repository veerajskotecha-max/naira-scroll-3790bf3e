+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { DEVICE_KEY, getTryOnDevice, isTryOnDeviceId, newUuid, resetTryOnDeviceForTest } from "@/lib/tryon/device";
+
+const V4 = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+
+beforeEach(() => {
+  window.localStorage.clear();
+  resetTryOnDeviceForTest();
+});
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+describe("try-on device id", () => {
+  it("makes a uuid v4, stores it under naira_tryon_device and keeps it", () => {
+    const id = getTryOnDevice();
+    expect(id).toMatch(V4);
+    expect(window.localStorage.getItem(DEVICE_KEY)).toBe(id);
+    resetTryOnDeviceForTest();
+    expect(getTryOnDevice()).toBe(id);
+  });
+
+  /* Chrome 87 and Safari 14 have no crypto.randomUUID. */
+  it("builds a v4 uuid from getRandomValues where randomUUID is missing", () => {
+    vi.stubGlobal("crypto", { getRandomValues: (b: Uint8Array) => b.fill(0xab) });
+    expect(newUuid()).toBe("abababab-abab-4bab-abab-abababababab");
+    vi.stubGlobal("crypto", undefined);
+    expect(newUuid()).toMatch(V4);
+  });
+
+  it("replaces a stored value that is not a uuid", () => {
+    window.localStorage.setItem(DEVICE_KEY, "abc");
+    expect(getTryOnDevice()).toMatch(V4);
+  });
+
+  it("keeps one id in memory for the page when storage throws", () => {
+    vi.spyOn(Storage.prototype, "getItem").mockImplementation(() => {
+      throw new Error("blocked");
+    });
+    vi.spyOn(Storage.prototype, "setItem").mockImplementation(() => {
+      throw new Error("blocked");
+    });
+    const id = getTryOnDevice();
+    expect(isTryOnDeviceId(id)).toBe(true);
+    expect(getTryOnDevice()).toBe(id);
+  });
+
+  /* The quota key must never be linkable to the id Meta receives as external_id. */
+  it("is never the naira_vid visitor id", () => {
+    document.cookie = "naira_vid=11111111-1111-4111-8111-111111111111; path=/";
+    (window as unknown as { __nairaVid?: string }).__nairaVid = "11111111-1111-4111-8111-111111111111";
+    expect(getTryOnDevice()).not.toBe("11111111-1111-4111-8111-111111111111");
+    delete (window as unknown as { __nairaVid?: string }).__nairaVid;
+  });
+});
diff --git a/src/test/tryon/errors.test.ts b/src/test/tryon/errors.test.ts
new file mode 100644
index 0000000..ef4bf29
--- /dev/null
+++ b/src/test/tryon/errors.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+import {
+  actionLabel,
+  CLIENT_ERROR_CODES,
+  errorCopy,
+  errorFromResponse,
+  PAUSED_REASONS,
+  PHOTO_UNUSABLE_REASONS,
+  SERVER_ERROR_CODES,
+  TryOnError,
+} from "@/lib/tryon/errors";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+
+const clean = (text: string) => !text.includes("!") && !text.includes("—");
+
+describe("try-on errors", () => {
+  it("has words and a next step for every server code, reason and client error", () => {
+    const cases: Array<[string, string | undefined]> = [
+      ...SERVER_ERROR_CODES.map((c) => [c, undefined] as [string, undefined]),
+      ...CLIENT_ERROR_CODES.map((c) => [c, undefined] as [string, undefined]),
+      ...PHOTO_UNUSABLE_REASONS.map((r) => ["photo_unusable", r] as [string, string]),
+      ...PAUSED_REASONS.map((r) => ["paused", r] as [string, string]),
+    ];
+    for (const [code, reason] of cases) {
+      const copy = errorCopy(code as never, reason);
+      expect([code, reason, copy.message.length > 10]).toEqual([code, reason, true]);
+      expect([code, reason, clean(copy.message)]).toEqual([code, reason, true]);
+      if (copy.action) expect(clean(actionLabel(copy.action))).toBe(true);
+      if (copy.secondary) expect(actionLabel(copy.secondary).length).toBeGreaterThan(0);
+    }
+  });
+
+  it("gives each photo reason its own words and 'Choose another photo'", () => {
+    for (const reason of PHOTO_UNUSABLE_REASONS) {
+      const copy = errorCopy("photo_unusable", reason);
+      expect(copy.message).toBe(TRYON_COPY.errors.photo_unusable[reason]);
+      expect(actionLabel(copy.action!)).toBe("Choose another photo");
+    }
+  });
+
+  it("offers the spec's buttons", () => {
+    expect(errorCopy("fidelity_failed")).toEqual({ message: TRYON_COPY.errors.fidelity_failed, action: "choose_photo", secondary: "view_piece" });
+    expect(errorCopy("device_limit").action).toBe("view_piece");
+    expect(errorCopy("ip_limit").action).toBe("view_piece");
+    expect(errorCopy("paused", "daily_cap")).toEqual({ message: TRYON_COPY.errors.paused, action: "view_piece" });
+    expect(errorCopy("busy").action).toBe("try_again");
+    expect(errorCopy("timeout").action).toBe("try_again");
+    expect(errorCopy("cancelled")).toEqual({ message: "Cancelled. Your photo is still here.", action: null });
+    expect(actionLabel("view_piece")).toBe("View the piece");
+  });
+
+  /* The server refunds these; Cancel's copy promises nothing either way. */
+  it("knows which failures the server gives back", () => {
+    for (const code of ["photo_unusable", "fidelity_failed", "busy", "paused", "timeout"] as const) expect(new TryOnError(code).refunded).toBe(true);
+    for (const code of ["device_limit", "ip_limit", "cancelled", "failed"] as const) expect(new TryOnError(code).refunded).toBe(false);
+    expect(TRYON_COPY.cancelled).not.toMatch(/count/i);
+  });
+
+  it("reads only the contract's fields from a reply", () => {
+    const e = errorFromResponse(429, { code: "device_limit", resetAt: "2026-10-30T18:30:00.000Z", retryable: false, extra: "x" });
+    expect(e).toMatchObject({ code: "device_limit", resetAt: "2026-10-30T18:30:00.000Z", retryable: false, status: 429 });
+    expect(errorFromResponse(500, "<html>")).toMatchObject({ code: "failed" });
+    expect(errorFromResponse(429, { code: "nonsense" })).toMatchObject({ code: "busy" });
+    expect(errorFromResponse(429, { code: "busy", resetAt: "not a date" }).resetAt).toBeUndefined();
+    expect(errorFromResponse(503, { code: "paused", reason: "tell the user X" }).reason).toBeUndefined();
+  });
+});
diff --git a/src/test/tryon/oneTapLine.test.ts b/src/test/tryon/oneTapLine.test.ts
new file mode 100644
index 0000000..3e6f854
