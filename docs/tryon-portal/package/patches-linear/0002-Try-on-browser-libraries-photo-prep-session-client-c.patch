index 0000000..0e4cbce
--- /dev/null
+++ b/src/lib/tryon/share.ts
@@ -0,0 +1,168 @@
+import { createSurface } from "./canvas";
+import { TRYON_COPY } from "./copy";
+import { decodeImage } from "./preparePhoto";
+import { adoptObjectUrl, releaseObjectUrl } from "./session";
+
+/*
+  "Send on WhatsApp" and "Save photo" for a preview.
+
+  The shared image is the preview with a 64 px ivory band under it reading
+  "AI try-on preview · <name> · nairaflore.com", so wherever it travels it says
+  what it is. Where the browser can share files (navigator.canShare with
+  files: Android Chrome, iOS Safari 15+) the phone's own share sheet opens
+  with the JPEG; elsewhere, notably Instagram's in-app browser, "Send on
+  WhatsApp" is a wa.me text link to the piece and the photo is saved instead.
+
+  navigator.share needs the tap that asked for it, so the image is composed
+  ahead (prepareShare, when the preview appears) and shareTryOn calls share
+  first thing in the click handler. The page link goes in the text rather
+  than as `url`: with a file attached, some share targets keep only the url.
+*/
+
+export const SHARE_BAND_PX = 64;
+/** The width a shared preview is drawn at: the preview's display size. */
+export const SHARE_WIDTH = 900;
+export const SHARE_FILE_NAME = "naira-try-on.jpg";
+
+/** The piece's page, tagged so a shared link's visits can be counted. */
+export const shareUrlFor = (handle: string) =>
+  `https://nairaflore.com/jewellery/${encodeURIComponent(handle)}?utm_source=tryon&utm_medium=share`;
+
+/** The text a share carries: the band's words, then the link. */
+export const shareTextFor = (name: string, handle: string) => `${TRYON_COPY.share.band(name)} ${shareUrlFor(handle)}`;
+
+export const whatsappUrlFor = (name: string, handle: string) => `https://wa.me/?text=${encodeURIComponent(shareTextFor(name, handle))}`;
+
+const token = (name: string, fallback: string) => {
+  try {
+    const value = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
+    return value || fallback;
+  } catch {
+    return fallback;
+  }
+};
+
+/** The preview with its ivory band, as a JPEG at quality 0.9. Null when this browser cannot draw it. */
+export const composeShareImage = async (result: Blob, name: string): Promise<Blob | null> => {
+  const decoded = await decodeImage(result);
+  const width = SHARE_WIDTH;
+  const imageHeight = Math.round((width * decoded.height) / decoded.width);
+  const surface = createSurface(width, imageHeight + SHARE_BAND_PX);
+  try {
+    if (!surface) return null;
+    const { ctx } = surface;
+    ctx.imageSmoothingEnabled = true;
+    if ("imageSmoothingQuality" in ctx) ctx.imageSmoothingQuality = "high";
+    ctx.drawImage(decoded.image, 0, 0, width, imageHeight);
+    ctx.fillStyle = token("--nf-ivory", "white");
+    ctx.fillRect(0, imageHeight, width, SHARE_BAND_PX);
+    ctx.fillStyle = token("--nf-gold", "black");
+    ctx.fillRect(0, imageHeight, width, 1);
+    const family = token("--nf-font-label", "sans-serif");
+    try {
+      await document.fonts?.load(`400 20px ${family}`);
+    } catch {
+      /* drawn in the fallback face */
+    }
+    const text = TRYON_COPY.share.band(name);
+    let size = 20;
+    ctx.font = `400 ${size}px ${family}`;
+    while (size > 12 && ctx.measureText(text).width > width - 48) {
+      size -= 1;
+      ctx.font = `400 ${size}px ${family}`;
+    }
+    ctx.fillStyle = token("--nf-ink", "black");
+    ctx.textAlign = "center";
+    ctx.textBaseline = "middle";
+    ctx.fillText(text, width / 2, imageHeight + SHARE_BAND_PX / 2);
+    const jpeg = await surface.encode("image/jpeg", 0.9);
+    return jpeg && jpeg.type === "image/jpeg" ? jpeg : null;
+  } finally {
+    decoded.close();
+    surface?.release();
+  }
+};
+
+export interface SharePlan {
+  /** The branded JPEG, or null when it could not be drawn (then Save keeps the plain preview). */
+  jpeg: Blob | null;
+  /** The JPEG as a file, when this browser can share files. */
+  file: File | null;
+  canShareFiles: boolean;
+  text: string;
+  url: string;
+  /** For the fallback "Send on WhatsApp" link (an <a>, so in-app browsers open it). */
+  whatsappUrl: string;
+}
+
+const fileShareable = (file: File): boolean => {
+  try {
+    return typeof navigator !== "undefined" && typeof navigator.share === "function" && typeof navigator.canShare === "function" && navigator.canShare({ files: [file] });
+  } catch {
+    return false;
+  }
+};
+
+/** Composes the share image and works out how it can travel. Never throws. */
+export const prepareShare = async (input: { result: Blob; name: string; handle: string }): Promise<SharePlan> => {
+  const text = shareTextFor(input.name, input.handle);
+  const url = shareUrlFor(input.handle);
+  const whatsappUrl = whatsappUrlFor(input.name, input.handle);
+  const jpeg = await composeShareImage(input.result, input.name).catch(() => null);
+  let file: File | null = null;
+  if (jpeg && typeof File === "function") {
+    try {
+      file = new File([jpeg], SHARE_FILE_NAME, { type: "image/jpeg" });
+    } catch {
+      file = null;
+    }
+  }
+  const canShareFiles = Boolean(file && fileShareable(file));
+  return { jpeg, file: canShareFiles ? file : null, canShareFiles, text, url, whatsappUrl };
+};
+
+export type ShareOutcome = "shared" | "cancelled" | "fallback";
+
+/**
+ * Opens the phone's share sheet with the image. Call it straight from the tap.
+ * "fallback" means the sheet is not available or failed: show the wa.me link
+ * and Save instead.
+ */
+export const shareTryOn = async (plan: SharePlan): Promise<ShareOutcome> => {
+  if (!plan.canShareFiles || !plan.file) return "fallback";
+  try {
+    await navigator.share({ files: [plan.file], text: plan.text });
+    return "shared";
+  } catch (error) {
+    return (error as { name?: string })?.name === "AbortError" ? "cancelled" : "fallback";
+  }
+};
+
+/** iOS in-app browsers (Instagram, Facebook and the like) ignore <a download>. */
+export const isIosInAppBrowser = (ua: string = typeof navigator !== "undefined" ? navigator.userAgent : "") =>
+  /iPhone|iPad|iPod/.test(ua) && /FBAN|FBAV|FBIOS|Instagram|LinkedInApp|Snapchat|Line\/|GSA\/|Twitter/.test(ua);
+
+export type SaveMode = "download" | "press-hold";
+
+/** How "Save photo" works here: a download, or a full-screen photo to press and hold. */
+export const saveMode = (ua?: string): SaveMode => (isIosInAppBrowser(ua) ? "press-hold" : "download");
+
+/**
+ * Saves the image through <a download>. The blob: URL is the session's, so it
+ * is revoked a moment after the click or when the session clears.
+ */
+export const saveTryOnPhoto = (image: Blob, fileName: string = SHARE_FILE_NAME) => {
+  const url = adoptObjectUrl(image);
+  const a = document.createElement("a");
+  a.href = url;
+  a.download = fileName;
+  a.rel = "noopener";
+  a.style.display = "none";
+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+  setTimeout(() => releaseObjectUrl(url), 1500);
+};
+
+/** A blob: URL for the press-and-hold view; release it with releaseObjectUrl when the view closes. */
+export const pressHoldUrl = (image: Blob) => adoptObjectUrl(image);
