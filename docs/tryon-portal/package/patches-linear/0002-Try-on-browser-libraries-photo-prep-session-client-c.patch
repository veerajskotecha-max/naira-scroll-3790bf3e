diff --git a/src/lib/oneTapLine.ts b/src/lib/oneTapLine.ts
new file mode 100644
index 0000000..882e2f4
--- /dev/null
+++ b/src/lib/oneTapLine.ts
@@ -0,0 +1,86 @@
+import { preorderWhatsAppUrl, type JewelPiece, type JewelVariant } from "@/data/jewellery";
+import { isAdjustableRing } from "@/data/ringFit";
+import { buyableValues, cartLineFor, choices, findVariant, oneTapVariant, sizeOption } from "@/lib/variants";
+
+/*
+  The bag line a one-tap Add takes, in one place, so the product page's
+  "Complete the look" cards and the try-on's Add can never disagree about
+  what goes in the bag (extracted from PairingCard in JewelDetailNext).
+
+  - A piece sold in stones or metals: the variant chosen (findVariant), else
+    the one pictured or the first buyable (oneTapVariant). The result carries
+    the variant, so a button can name exactly what it adds.
+  - A piece sold in sizes (Baguette Eternity Band: Stone and Size): nothing
+    until a size is chosen; a sold-out pair (Ruby US 5) is reserved on
+    WhatsApp instead.
+  - A ring sold one way: an adjustable one (Cushion Halo) goes in as US 6,
+    the size its page opens on, as PairingCard always added it; a fixed one
+    needs a size, which rides on the line as a note.
+  - Anything else: as it is.
+*/
+
+export type OneTapCartLine = ReturnType<typeof cartLineFor> & { size?: string };
+
+export type OneTapResult =
+  | { line: OneTapCartLine; variant?: JewelVariant }
+  | { need: "size" | "month" }
+  | { soldOut: true; reserveUrl: string; variant?: JewelVariant };
+
+/* "Ruby, size 5": the choice a WhatsApp reservation names, as the product page writes it. */
+const choiceText = (options: Record<string, string>) =>
+  Object.entries(options)
+    .map(([name, value]) => (/size/i.test(name) ? `size ${value}` : value))
+    .join(", ");
+
+const soldOut = (piece: JewelPiece, variant?: JewelVariant): OneTapResult => ({
+  soldOut: true,
+  variant,
+  reserveUrl: preorderWhatsAppUrl({
+    name: piece.name,
+    handle: piece.handle,
+    priceLabel: variant ? `₹${variant.price.toLocaleString("en-IN")}` : piece.priceLabel,
+    choice: variant ? choiceText(variant.options) || undefined : undefined,
+  }),
+});
+
+/** The line to add for `piece` with the shopper's choices ("Stone" → "Ruby", "Size" → "7"). */
+export const oneTapLine = (piece: JewelPiece, chosen: Record<string, string> = {}): OneTapResult => {
+  const variants = piece.variants ?? [];
+  const sizeName = sizeOption(piece);
+  const month = choices(piece).find((o) => /month|birthstone/i.test(o.name));
+  if (sizeName && !chosen[sizeName]) return { need: "size" };
+  if (month && !chosen[month.name]) return { need: "month" };
+
+  let variant: JewelVariant | undefined;
+  if (variants.length) {
+    variant = findVariant(piece, chosen);
+    if (!variant) {
+      // A size or month that does not exist with the other choices is still a choice to make.
+      if (sizeName || month) return { need: sizeName ? "size" : "month" };
+      variant = oneTapVariant(piece, chosen) ?? variants[0];
+    }
+    if (!variant.availableForSale) return soldOut(piece, variant);
+  } else if (piece.availableForSale === false && !isAdjustableRing(piece)) {
+    return soldOut(piece);
+  }
+
+  let size: string | undefined;
+  if (piece.category === "Rings" && !sizeName) {
+    const picked = chosen.Size ?? chosen.size;
+    if (picked) size = `US ${picked.replace(/^US\s*/i, "")}`;
+    else if (!isAdjustableRing(piece)) return { need: "size" };
+    // An adjustable ring sold one way goes in as US 6, the size its page opens on.
+    else if (!variant) size = "US 6";
+  }
+
+  return { line: { ...cartLineFor(piece, variant), ...(size ? { size } : {}) }, ...(variant ? { variant } : {}) };
+};
+
+/** The size chips for a piece sold in sizes, each marked buyable or not with the other choices. */
+export const sizeChoices = (piece: JewelPiece, chosen: Record<string, string>) => {
+  const option = sizeOption(piece);
+  if (!option) return null;
+  const buyable = buyableValues(piece, option, chosen);
+  const values = piece.options?.find((o) => o.name === option)?.values ?? [];
+  return { option, values: values.map((value) => ({ value, buyable: Boolean(buyable[value]) })) };
+};
diff --git a/src/lib/tryon/analytics.ts b/src/lib/tryon/analytics.ts
new file mode 100644
index 0000000..e2a6713
--- /dev/null
+++ b/src/lib/tryon/analytics.ts
@@ -0,0 +1,83 @@
+import { clarityEvent, setClarityTag } from "@/lib/clarity";
+import { TRY_ON_HANDLES } from "@/data/tryOnHandles";
+import { CLIENT_ERROR_CODES, SERVER_ERROR_CODES, type TryOnError, type TryOnErrorCode } from "./errors";
+
+/*
+  What the try-on tells Clarity: event names from this list and two session
+  tags, nothing else. No reason beyond the error code, no verdict, no size,
+  no image, and never anything to Meta: AddToCart and InitiateCheckout keep
+  coming only from CartContext when a piece is added or bought.
+
+  Production only (window.__nairaProd, the hostname allowlist in index.html),
+  like the Clarity tag itself, so a preview or localhost run never reaches
+  the live project.
+*/
+
+const BASE_EVENTS = [
+  // Entry
+  "tryon_hub_opened",
+  "tryon_entry_pdp",
+  "tryon_piece_opened",
+  "tryon_demo_viewed",
+  // Photo
+  "tryon_photo_camera",
+  "tryon_photo_library",
+  "tryon_photo_reused",
+  "tryon_photo_warn_dark",
+  "tryon_photo_warn_soft",
+  "tryon_photo_blocked_format",
+  "tryon_photo_blocked_small",
+  // Render
+  "tryon_consent_given",
+  "tryon_render_started",
+  "tryon_render_ok",
+  "tryon_cancelled",
+  "tryon_interrupted",
+  // Result
+  "tryon_compare_used",
+  "tryon_real_piece_opened",
+  "tryon_feedback_yes",
+  "tryon_feedback_no",
+  "tryon_scene_high",
+  // Commerce
+  "tryon_added",
+  "tryon_buynow",
+  "tryon_choose_size",
+  "tryon_reserve",
+  "tryon_stone_rerender",
+  "tryon_another",
+  // Share
+  "tryon_shared",
+  "tryon_saved",
+  // Delete
+  "tryon_photo_deleted",
+] as const;
+
+/** A render that failed, by code; Cancel and a backgrounded tab have their own names. */
+const FAILED_CODES = [...SERVER_ERROR_CODES, ...CLIENT_ERROR_CODES].filter((code) => code !== "cancelled" && code !== "interrupted");
+
+export type TryOnBaseEvent = (typeof BASE_EVENTS)[number];
+export type TryOnFailedEvent = `tryon_render_failed_${Exclude<TryOnErrorCode, "cancelled" | "interrupted">}`;
+export type TryOnEventName = TryOnBaseEvent | TryOnFailedEvent;
+
+/** Every name the try-on may send, and the only ones that reach clarityEvent. */
+export const TRYON_EVENTS: ReadonlySet<string> = new Set<string>([...BASE_EVENTS, ...FAILED_CODES.map((code) => `tryon_render_failed_${code}`)]);
+
+const production = () => typeof window !== "undefined" && (window as unknown as { __nairaProd?: unknown }).__nairaProd === true;
+
+/** Sends one allow-listed event name to Clarity, on the live shop only. */
+export const tryonEvent = (name: TryOnEventName) => {
+  if (!TRYON_EVENTS.has(name) || !production()) return;
+  clarityEvent(name);
+};
+
+/** The event for a render that ended in an error. */
+export const renderFailedEvent = (error: Pick<TryOnError, "code">): TryOnEventName =>
+  error.code === "cancelled" ? "tryon_cancelled" : error.code === "interrupted" ? "tryon_interrupted" : (`tryon_render_failed_${error.code}` as TryOnFailedEvent);
+
+/** Tags the Clarity session as one that used the try-on, and with the piece. */
+export const tagTryOn = (handle: string) => {
+  if (!TRY_ON_HANDLES.has(handle) || !production()) return;
+  setClarityTag("tryon", "used");
+  setClarityTag("tryon_piece", handle);
+};
diff --git a/src/lib/tryon/canvas.ts b/src/lib/tryon/canvas.ts
new file mode 100644
index 0000000..c61ef39
--- /dev/null
+++ b/src/lib/tryon/canvas.ts
@@ -0,0 +1,105 @@
+/*
+  An off-DOM drawing surface that works on the phones the shop targets
+  (Safari 14, Chrome 87). OffscreenCanvas is used when it can draw in 2D and
+  encode (Chrome 69+, Safari 16.4+); Safari 14 has none, so it falls back to a
+  canvas element that is never attached to the page.
+*/
+
+export interface Surface {
+  width: number;
+  height: number;
+  ctx: CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D;
+  /** The surface itself, to draw onto another surface. */
+  source: CanvasImageSource;
+  /** JPEG or PNG bytes, or null when this browser cannot encode. */
+  encode: (type: string, quality?: number) => Promise<Blob | null>;
+  /** Frees the bitmap memory now; iOS counts canvas memory per tab. */
+  release: () => void;
+}
+
+const offscreen = (width: number, height: number): Surface | null => {
+  if (typeof OffscreenCanvas === "undefined") return null;
+  try {
+    const canvas = new OffscreenCanvas(width, height);
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return null;
+    const canEncode = typeof canvas.convertToBlob === "function";
+    return {
+      width,
+      height,
+      ctx,
+      source: canvas,
+      encode: (type, quality) => (canEncode ? canvas.convertToBlob({ type, quality }).catch(() => null) : Promise.resolve(null)),
+      release: () => {
+        canvas.width = 0;
+        canvas.height = 0;
+      },
+    };
+  } catch {
+    return null;
+  }
+};
+
+const element = (width: number, height: number): Surface | null => {
+  if (typeof document === "undefined") return null;
+  try {
+    const canvas = document.createElement("canvas");
+    canvas.width = width;
+    canvas.height = height;
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return null;
+    return {
+      width,
+      height,
+      ctx,
+      source: canvas,
+      encode: (type, quality) =>
+        typeof canvas.toBlob === "function"
+          ? new Promise<Blob | null>((resolve) => {
+              try {
+                canvas.toBlob((blob) => resolve(blob), type, quality);
+              } catch {
+                resolve(null);
+              }
+            })
+          : Promise.resolve(null),
+      release: () => {
+        canvas.width = 0;
+        canvas.height = 0;
+      },
+    };
+  } catch {
+    return null;
+  }
+};
+
+/** A surface to draw on, or null when this browser has no 2D canvas. */
+export const createSurface = (width: number, height: number): Surface | null => offscreen(width, height) ?? element(width, height);
+
+/** Whether this browser can turn a canvas into a JPEG at all. */
+export const canEncodeImages = (): boolean => {
+  if (typeof OffscreenCanvas !== "undefined" && typeof OffscreenCanvas.prototype?.convertToBlob === "function") return true;
+  return typeof HTMLCanvasElement !== "undefined" && typeof HTMLCanvasElement.prototype?.toBlob === "function";
+};
+
+/** A blob's bytes, through FileReader where Blob.arrayBuffer is missing. */
+export const blobBytes = (blob: Blob): Promise<Uint8Array> => {
+  if (typeof blob.arrayBuffer === "function") return blob.arrayBuffer().then((b) => new Uint8Array(b));
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(new Uint8Array(reader.result as ArrayBuffer));
+    reader.onerror = () => reject(reader.error);
+    reader.readAsArrayBuffer(blob);
+  });
+};
+
+/** A blob's text, through FileReader where Blob.text is missing. */
+export const blobText = (blob: Blob): Promise<string> => {
+  if (typeof blob.text === "function") return blob.text();
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(String(reader.result ?? ""));
+    reader.onerror = () => reject(reader.error);
+    reader.readAsText(blob);
+  });
+};
diff --git a/src/lib/tryon/client.ts b/src/lib/tryon/client.ts
new file mode 100644
index 0000000..4248275
--- /dev/null
+++ b/src/lib/tryon/client.ts
@@ -0,0 +1,234 @@
+import { TRY_ON_HANDLES } from "@/data/tryOnHandles";
+import { blobText } from "./canvas";
+import { getTryOnDevice } from "./device";
+import { errorFromResponse, TryOnError } from "./errors";
+import { CONSENT_VERSION, type PhotoKind, type TryOnVerified } from "./session";
+
+/*
+  The browser's half of POST {VITE_SUPABASE_URL}/functions/v1/tryon/render.
+
+  XHR rather than fetch, for one reason: fetch cannot report upload progress,
+  and "Sending securely 63%" is what a shopper on 4G watches for the first
+  seconds. The body is multipart with exactly two parts, "meta" (the JSON the
+  server parses strictly: any extra key is refused) and "photo" (the prepared
+  JPEG). The headers are the publishable key, as pixel.ts sends it to
+  meta-capi; there is no custom header, so the stock CORS preflight covers it.
+
+  The reply is the image itself, kept as a Blob: it is shown through a blob:
+  URL (session.ts), never as a data: URL, so it never sits in the DOM as text
+  where a session recording could read it.
+
+  The client stops waiting at 125 s, just past the server's own 118 s
+  deadline, with its own timer (so a test clock can move it).
+*/
+
+export const TRYON_TIMEOUT_MS = 125_000;
+
+export const TRYON_STONES = ["Ruby", "Crystal", "Emerald", "Amethyst"] as const;
+export type TryOnStone = (typeof TRYON_STONES)[number];
+
+/** The "meta" part, field for field the server's strict schema. */
+export interface TryOnMeta {
+  v: 1;
+  handle: string;
+  stone: TryOnStone | null;
+  kind: PhotoKind;
+  device: string;
+  consent: { version: typeof CONSENT_VERSION; accepted: true; adult: true; ownPhoto: true };
+}
+
+const BASE = (import.meta.env.VITE_SUPABASE_URL ?? "").replace(/\/+$/, "");
+const KEY = import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY ?? "";
+
+/** The function's URL for one of its two operations. */
+export const tryOnEndpoint = (op: "render" | "feedback") => `${BASE}/functions/v1/tryon/${op}`;
+
+/** The headers every call carries: the publishable key on both, as pixel.ts does. */
+export const tryOnHeaders = (): Record<string, string> => ({ apikey: KEY, Authorization: `Bearer ${KEY}` });
+
+const isStone = (value: unknown): value is TryOnStone => TRYON_STONES.includes(value as TryOnStone);
+
+/** The meta for a render; throws bad_request for a handle, stone or kind the server would refuse. */
+export const buildTryOnMeta = (input: { handle: string; stone: string | null; kind: PhotoKind; device?: string }): TryOnMeta => {
+  if (!TRY_ON_HANDLES.has(input.handle)) throw new TryOnError("bad_request");
+  if (input.stone !== null && !isStone(input.stone)) throw new TryOnError("bad_request");
+  if (input.kind !== "face" && input.kind !== "hand") throw new TryOnError("bad_request");
+  return {
+    v: 1,
+    handle: input.handle,
+    stone: input.stone as TryOnStone | null,
+    kind: input.kind,
+    device: input.device ?? getTryOnDevice(),
+    consent: { version: CONSENT_VERSION, accepted: true, adult: true, ownPhoto: true },
+  };
+};
+
+export interface TryOnRequest {
+  handle: string;
+  stone: string | null;
+  kind: PhotoKind;
+  /** The prepared 1152x1536 JPEG. */
+  photo: Blob;
+  /** Upload progress, 0 to 1. */
+  onUpload?: (fraction: number) => void;
+  /** The photo is up; the server is now working on it. */
+  onUploaded?: () => void;
+  signal?: AbortSignal;
+  /** Only tests change this. */
+  timeoutMs?: number;
+}
+
+export interface TryOnReply {
+  /** The preview image (PNG expected). */
+  blob: Blob;
+  /** Try-ons left today for this device, from X-Tryon-Remaining. */
+  remaining: number | null;
+  /** How the server's fidelity check ran, from X-Tryon-Verified. */
+  verified: TryOnVerified | null;
+  /** The anonymous render row, from X-Tryon-Render, for feedback. */
+  renderId: string | null;
+}
+
+const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+
+const readHeaders = (xhr: XMLHttpRequest) => {
+  const remainingRaw = xhr.getResponseHeader("X-Tryon-Remaining");
+  const remaining = remainingRaw !== null && /^\d+$/.test(remainingRaw.trim()) ? Number(remainingRaw.trim()) : null;
+  const verifiedRaw = (xhr.getResponseHeader("X-Tryon-Verified") ?? "").trim();
+  const verified = verifiedRaw === "pass" || verifiedRaw === "log" || verifiedRaw === "off" ? verifiedRaw : null;
+  const renderRaw = (xhr.getResponseHeader("X-Tryon-Render") ?? "").trim();
+  return { remaining, verified, renderId: UUID.test(renderRaw) ? renderRaw : null } as const;
+};
+
+const offline = () => typeof navigator !== "undefined" && navigator.onLine === false;
+
+/**
+ * Sends the photo and waits for the preview. Resolves with the image as a
+ * Blob, or rejects with a TryOnError whose `copy` is what to show.
+ */
+export const requestTryOn = (req: TryOnRequest): Promise<TryOnReply> =>
+  new Promise<TryOnReply>((resolve, reject) => {
+    let meta: TryOnMeta;
+    try {
+      meta = buildTryOnMeta(req);
+    } catch (error) {
+      reject(error);
+      return;
+    }
+    if (req.signal?.aborted) {
+      reject(new TryOnError("cancelled"));
+      return;
+    }
+    if (offline()) {
+      reject(new TryOnError("offline"));
+      return;
+    }
+
+    const xhr = new XMLHttpRequest();
+    let settled = false;
+    let uploaded = 0;
+    let wentHidden = false;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+
+    const onVisibility = () => {
+      if (typeof document !== "undefined" && document.visibilityState === "hidden") wentHidden = true;
+    };
+    const onAbort = () => fail(new TryOnError("cancelled"), true);
+
+    const cleanup = () => {
+      if (timer !== undefined) clearTimeout(timer);
+      req.signal?.removeEventListener("abort", onAbort);
+      if (typeof document !== "undefined") document.removeEventListener("visibilitychange", onVisibility);
+    };
+    function fail(error: TryOnError, abort = false) {
+      if (settled) return;
+      settled = true;
+      cleanup();
+      if (abort) {
+        try {
+          xhr.abort();
+        } catch {
+          /* already closed */
+        }
+      }
+      reject(error);
+    }
+    /* A connection lost while the tab was in the background reads as the
+       background's doing, which is what the shopper can act on. */
+    const lost = (code: "network" | "timeout") => {
+      if (wentHidden) return new TryOnError("interrupted");
+      if (code === "network" && (offline() || uploaded === 0)) return new TryOnError("offline");
+      return new TryOnError(code);
+    };
+
+    xhr.open("POST", tryOnEndpoint("render"));
+    xhr.responseType = "blob";
+    xhr.timeout = req.timeoutMs ?? TRYON_TIMEOUT_MS;
+    for (const [name, value] of Object.entries(tryOnHeaders())) xhr.setRequestHeader(name, value);
+
+    xhr.upload.onprogress = (event) => {
+      if (!event.lengthComputable || !event.total) return;
+      uploaded = event.loaded;
+      req.onUpload?.(Math.min(1, event.loaded / event.total));
+    };
+    xhr.upload.onload = () => {
+      uploaded = Math.max(uploaded, 1);
+      req.onUpload?.(1);
+      req.onUploaded?.();
+    };
+    xhr.onerror = () => fail(lost("network"));
+    xhr.ontimeout = () => fail(lost("timeout"));
+    xhr.onabort = () => fail(new TryOnError("cancelled"));
+    xhr.onload = () => {
+      if (settled) return;
+      const body = xhr.response as Blob | null;
+      if (xhr.status === 200) {
+        const type = (xhr.getResponseHeader("Content-Type") ?? body?.type ?? "").split(";")[0].trim().toLowerCase();
+        if (!body || !body.size || !type.startsWith("image/")) {
+          fail(new TryOnError("failed", { status: 200 }));
+          return;
+        }
+        settled = true;
+        cleanup();
+        resolve({ blob: body.type ? body : new Blob([body], { type }), ...readHeaders(xhr) });
+        return;
+      }
+      const status = xhr.status;
+      const parse = body ? blobText(body).then((text) => JSON.parse(text) as unknown) : Promise.resolve(null);
+      parse
+        .catch(() => null)
+        .then((json) => fail(errorFromResponse(status, json)));
+    };
+
+    req.signal?.addEventListener("abort", onAbort);
+    if (typeof document !== "undefined") document.addEventListener("visibilitychange", onVisibility);
+    timer = setTimeout(() => fail(lost("timeout"), true), req.timeoutMs ?? TRYON_TIMEOUT_MS);
+
+    const form = new FormData();
+    form.append("meta", JSON.stringify(meta));
+    form.append("photo", req.photo, "photo.jpg");
+    xhr.send(form);
+  });
+
+export type SceneBucketValue = "low" | "mid" | "high";
+
+/**
+ * "Does this look like the piece?" and the scene check's bucket, sent to the
+ * function's /feedback (always 204). Fire and forget: keepalive lets it
+ * finish if the shopper leaves at once, and it never throws.
+ */
+export const sendFeedback = (renderId: string, feedback: { looksRight: boolean | null; scene: SceneBucketValue | null }) => {
+  if (!UUID.test(renderId) || typeof fetch !== "function" || !BASE.startsWith("http")) return;
+  try {
+    void fetch(tryOnEndpoint("feedback"), {
+      method: "POST",
+      keepalive: true,
+      headers: { "Content-Type": "application/json", ...tryOnHeaders() },
+      body: JSON.stringify({ v: 1, render: renderId, looksRight: feedback.looksRight, scene: feedback.scene }),
+    }).catch(() => {
+      /* feedback must never break the page */
+    });
+  } catch {
+    /* ignore */
+  }
+};
