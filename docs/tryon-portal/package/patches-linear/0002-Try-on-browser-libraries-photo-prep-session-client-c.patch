+    const draw = contexts[0].drawImage.mock.calls[0];
+    expect(draw).toEqual([decoded, 0, 0, 3000, 4000, 0, 0, 1152, 1536]);
+    expect(contexts[0].imageSmoothingQuality).toBe("high");
+    expect(toBlob).toHaveBeenCalledWith(expect.any(Function), "image/jpeg", 0.85);
+    expect(out.width).toBe(1152);
+    expect(out.height).toBe(1536);
+    expect(out.blob.type).toBe("image/jpeg");
+    expect(out.blob).not.toBe(file);
+    expect(hasApp1(await blobBytes(out.blob))).toBe(false);
+    expect(out.warnings).toEqual([]);
+    expect(decoded.close).toHaveBeenCalled();
+  });
+
+  it("crops a landscape photo to its centred 3:4 frame", async () => {
+    vi.stubGlobal("createImageBitmap", vi.fn(async () => bitmap(4000, 3000)));
+    const out = await preparePhoto(new File([exifJpeg()], "a.jpg", { type: "image/jpeg" }));
+    expect(contexts[0].drawImage.mock.calls[0].slice(1)).toEqual([875, 0, 2250, 3000, 0, 0, 1152, 1536]);
+    expect(out.crop).toEqual({ x: 875, y: 0, width: 2250, height: 3000 });
+  });
+
+  it("draws the frame the shopper chose", async () => {
+    const decoded = await (async () => {
+      vi.stubGlobal("createImageBitmap", vi.fn(async () => bitmap(3000, 4000)));
+      return decodePhoto(new File([exifJpeg()], "a.jpg"));
+    })();
+    await encodePhoto(decoded, { x: 600, y: 900, width: 1200, height: 1600 });
+    expect(contexts[0].drawImage.mock.calls[0].slice(1)).toEqual([600, 900, 1200, 1600, 0, 0, 1152, 1536]);
+  });
+
+  /* Safari 14 has no createImageBitmap: an off-page <img> decodes (and orients)
+     the photo, and its blob: URL is revoked the moment it has loaded. */
+  it("falls back to an <img> never put on the page when createImageBitmap is absent", async () => {
+    vi.stubGlobal("createImageBitmap", undefined);
+    const created: string[] = [];
+    const revoked: string[] = [];
+    vi.stubGlobal("URL", Object.assign(URL, {
+      createObjectURL: vi.fn(() => {
+        created.push(`blob:fake/${created.length}`);
+        return created[created.length - 1];
+      }),
+      revokeObjectURL: vi.fn((u: string) => revoked.push(u)),
+    }));
+    const images: FakeImage[] = [];
+    class FakeImage {
+      naturalWidth = 0;
+      naturalHeight = 0;
+      decoding = "";
+      onload: (() => void) | null = null;
+      onerror: (() => void) | null = null;
+      removeAttribute = vi.fn();
+      constructor() {
+        images.push(this);
