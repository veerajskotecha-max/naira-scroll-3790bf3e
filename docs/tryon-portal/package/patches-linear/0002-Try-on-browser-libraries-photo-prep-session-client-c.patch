@@ -0,0 +1,63 @@
+/*
+  The try-on's own device id: a random uuid v4 in localStorage
+  naira_tryon_device, sent with each render so the server can hold a phone to
+  its daily allowance. It is deliberately NOT naira_vid, the visitor id Meta
+  receives as external_id: the server hashes this one with a daily salt and
+  keeps it two days, and no code joins the two, so a try-on can never be
+  matched to an ad profile. This module must not import visitorId.
+
+  crypto.randomUUID arrived in Chrome 92 and Safari 15.4, after the phones the
+  shop supports, so getRandomValues builds the uuid where it is missing. When
+  storage throws (Safari private mode of old, blocked storage) the id lives in
+  memory for the page, which still caps a tab.
+*/
+
+export const DEVICE_KEY = "naira_tryon_device";
+
+const UUID_V4 = /^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/;
+
+let memory: string | undefined;
+
+const hex = (bytes: ArrayLike<number>) => Array.prototype.map.call(bytes, (b: number) => (b + 0x100).toString(16).slice(1)).join("");
+
+/** A random uuid v4, by the best means this browser has. */
+export const newUuid = (): string => {
+  const c = typeof crypto !== "undefined" ? crypto : undefined;
+  try {
+    if (c && typeof c.randomUUID === "function") return c.randomUUID();
+  } catch {
+    /* fall through */
+  }
+  const bytes = new Uint8Array(16);
+  if (c && typeof c.getRandomValues === "function") c.getRandomValues(bytes);
+  else for (let i = 0; i < 16; i += 1) bytes[i] = Math.floor(Math.random() * 256);
+  bytes[6] = (bytes[6] & 0x0f) | 0x40;
+  bytes[8] = (bytes[8] & 0x3f) | 0x80;
+  const h = hex(bytes);
+  return `${h.slice(0, 8)}-${h.slice(8, 12)}-${h.slice(12, 16)}-${h.slice(16, 20)}-${h.slice(20)}`;
+};
+
+export const isTryOnDeviceId = (value: unknown): value is string => typeof value === "string" && UUID_V4.test(value);
+
+/** This browser's try-on id, made and stored on first use. */
+export const getTryOnDevice = (): string => {
+  if (memory) return memory;
+  try {
+    const stored = window.localStorage.getItem(DEVICE_KEY);
+    if (isTryOnDeviceId(stored)) return (memory = stored);
+  } catch {
+    /* storage blocked: an id for this page only */
+  }
+  const id = newUuid();
+  try {
+    window.localStorage.setItem(DEVICE_KEY, id);
+  } catch {
+    /* kept in memory */
+  }
+  return (memory = id);
+};
+
+/** Test seam: forgets the id held in memory. */
+export const resetTryOnDeviceForTest = () => {
+  memory = undefined;
+};
