@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+import { renderStage, renderStageCopy, TRYON_COPY } from "@/lib/tryon/copy";
+
+/* Every string the copy deck can produce: plain strings, lists, and each
+   template filled with a sample. */
+const strings = (value: unknown, path = "TRYON_COPY"): Array<[string, string]> => {
+  if (typeof value === "string") return [[path, value]];
+  if (typeof value === "function") {
+    const args = Array.from({ length: Math.max(value.length, 2) }, (_, i) => (i === 0 ? "Ruby" : "7"));
+    const numeric = (value as (...a: unknown[]) => unknown)(63);
+    return [
+      [`${path}(…)`, String((value as (...a: unknown[]) => unknown)(...args))],
+      [`${path}(63)`, String(numeric)],
+    ];
+  }
+  if (Array.isArray(value)) return value.flatMap((v, i) => strings(v, `${path}[${i}]`));
+  if (value && typeof value === "object") return Object.entries(value).flatMap(([k, v]) => strings(v, `${path}.${k}`));
+  return [];
+};
+
+describe("try-on copy", () => {
+  const all = strings(TRYON_COPY);
+
+  it("has the whole deck", () => {
+    expect(all.length).toBeGreaterThan(100);
+  });
+
+  /* The house style: Indian English, no exclamation marks, no em dashes. */
+  it("has no exclamation mark and no em dash anywhere", () => {
+    expect(all.filter(([, text]) => text.includes("!"))).toEqual([]);
+    expect(all.filter(([, text]) => text.includes("—"))).toEqual([]);
+    expect(all.filter(([, text]) => / - /.test(text))).toEqual([]);
+  });
+
+  it("writes Indian English", () => {
+    expect(all.filter(([, text]) => /\b(color|center|favorite|jewelry)\b/i.test(text))).toEqual([]);
+  });
+
+  it("fills its templates as the spec writes them", () => {
+    expect(TRYON_COPY.uploading(63)).toBe("Sending securely 63%");
+    expect(TRYON_COPY.studio.actualSize("25 mm across")).toBe("Actual size 25 mm across");
+    expect(TRYON_COPY.result.shownAt("25 mm across")).toBe("Shown at its listed size: 25 mm across");
+    expect(TRYON_COPY.result.remaining(3)).toBe("3 try-ons left today");
+    expect(TRYON_COPY.result.remaining(1)).toBe("1 try-on left today");
+    expect(TRYON_COPY.buy.add("Ruby")).toBe("Add to bag · Ruby");
+    expect(TRYON_COPY.buy.add("Ruby", "7")).toBe("Add to bag · Ruby · US 7");
+    expect(TRYON_COPY.buy.add(null)).toBe("Add to bag");
+    expect(TRYON_COPY.buy.ladder).toBe("Add a second piece and save 15%");
+    expect(TRYON_COPY.stoneChange.tryIn("Emerald")).toBe("Try in Emerald");
+    expect(TRYON_COPY.stoneChange.add("Emerald")).toBe("Add Emerald to bag");
+    expect(TRYON_COPY.share.band("Woven Gold Hoops")).toBe("AI try-on preview · Woven Gold Hoops · nairaflore.com");
+    expect(TRYON_COPY.errors.device_limit(5)).toBe("You have used today's 5 try-ons. They refresh at midnight.");
+  });
+
+  it("names honest stages by elapsed time, never a percentage", () => {
+    expect([0, 3999, 4000, 19_999, 20_000, 39_999, 40_000, 120_000].map(renderStage)).toEqual([
+      "checking", "checking", "placing", "placing", "light", "light", "final", "final",
+    ]);
+    expect(renderStageCopy("placing", "Woven Gold Hoops", "25 mm across")).toBe("Placing the Woven Gold Hoops at 25 mm across");
+    expect(renderStageCopy("final", "x", "y")).toBe("Almost there, a final check on the piece");
+  });
+
+  /* Returns are not promised until the owner settles the PDP and policy pages. */
+  it("never mentions returns", () => {
+    expect(all.filter(([, text]) => /\breturns\b|\breturn (it|them|the piece|within)\b|\bexchange|\brefund/i.test(text))).toEqual([]);
+  });
+});
diff --git a/src/test/tryon/cropMaths.test.ts b/src/test/tryon/cropMaths.test.ts
