+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import {
+  adoptObjectUrl,
+  clearTryOnSession,
+  CONSENT_KEY,
+  getTryOnPhoto,
+  getTryOnResult,
+  hasTryOnConsent,
+  IDLE_MS,
+  liveObjectUrlCount,
+  markTried,
+  onTryOnSessionCleared,
+  recordTryOnConsent,
+  releaseObjectUrl,
+  renderInFlight,
+  resetTryOnConsentForTest,
+  resultKey,
+  setTryOnPhoto,
+  setTryOnResult,
+  touchTryOnSession,
+  trackRender,
+  TRIED_KEY,
+  triedHandles,
+  tryOnResults,
+} from "@/lib/tryon/session";
+import { getTryOnDevice, resetTryOnDeviceForTest } from "@/lib/tryon/device";
+
+let created: string[];
+let revoked: string[];
+const SIZE = { width: 1152, height: 1536 };
+const jpeg = () => new Blob([new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 1, 2, 3, 0xff, 0xd9])], { type: "image/jpeg" });
+const png = () => new Blob([new Uint8Array([0x89, 0x50, 0x4e, 0x47, 1, 2, 3])], { type: "image/png" });
+
+beforeEach(() => {
+  created = [];
+  revoked = [];
+  Object.assign(URL, {
+    createObjectURL: vi.fn(() => {
+      const url = `blob:http://localhost/${created.length + 1}`;
+      created.push(url);
+      return url;
+    }),
+    revokeObjectURL: vi.fn((url: string) => revoked.push(url)),
+  });
+  clearTryOnSession();
+  created.length = 0;
+  revoked.length = 0;
+  window.sessionStorage.clear();
+  window.localStorage.clear();
+  resetTryOnConsentForTest();
+});
+
+afterEach(() => {
+  clearTryOnSession();
+  vi.useRealTimers();
+});
+
+describe("try-on session", () => {
+  it("keeps one photo per kind and a preview per handle and stone", () => {
+    const face = setTryOnPhoto("face", jpeg(), SIZE);
+    const hand = setTryOnPhoto("hand", jpeg(), SIZE);
+    expect(face.url).toMatch(/^blob:/);
+    expect(getTryOnPhoto("face")).toBe(face);
+    expect(getTryOnPhoto("hand")).toBe(hand);
+    const ruby = setTryOnResult("baguette-huggies", "Ruby", "face", { blob: png(), renderId: "r1", verified: "pass" });
+    expect(resultKey("baguette-huggies", "Ruby")).toBe("baguette-huggies:Ruby");
+    expect(getTryOnResult("baguette-huggies", "Ruby")).toBe(ruby);
+    expect(getTryOnResult("baguette-huggies", "Emerald")).toBeUndefined();
+    setTryOnResult("woven-gold-hoops", null, "face", { blob: png(), renderId: null, verified: "log" });
+    expect(getTryOnResult("woven-gold-hoops", null)?.verified).toBe("log");
+    expect(tryOnResults()).toHaveLength(2);
+  });
+
+  /* A new face photo makes every face preview stale: they were made from the old one. */
+  it("a new photo replaces the old one and drops only the previews of its kind", () => {
+    const old = setTryOnPhoto("face", jpeg(), SIZE);
+    const facePreview = setTryOnResult("woven-gold-hoops", null, "face", { blob: png(), renderId: null, verified: null });
+    const handPreview = setTryOnResult("cushion-halo-ring", null, "hand", { blob: png(), renderId: null, verified: null });
+    setTryOnPhoto("face", jpeg(), SIZE);
+    expect(revoked).toEqual(expect.arrayContaining([old.url, facePreview.url]));
+    expect(revoked).not.toContain(handPreview.url);
+    expect(getTryOnResult("woven-gold-hoops")).toBeUndefined();
+    expect(getTryOnResult("cushion-halo-ring")).toBe(handPreview);
+  });
+
+  it("a second preview for the same piece and stone revokes the first", () => {
+    const first = setTryOnResult("woven-gold-hoops", null, "face", { blob: png(), renderId: null, verified: null });
+    setTryOnResult("woven-gold-hoops", null, "face", { blob: png(), renderId: null, verified: null });
+    expect(revoked).toEqual([first.url]);
+  });
+
+  it("clearTryOnSession revokes every URL it made, aborts a running render and tells the screens", () => {
+    const listener = vi.fn();
+    const off = onTryOnSessionCleared(listener);
+    setTryOnPhoto("face", jpeg(), SIZE);
+    setTryOnPhoto("hand", jpeg(), SIZE);
+    setTryOnResult("woven-gold-hoops", null, "face", { blob: png(), renderId: null, verified: null });
+    adoptObjectUrl(jpeg());
+    const render = new AbortController();
+    trackRender(render);
+    expect(renderInFlight()).toBe(true);
+    expect(liveObjectUrlCount()).toBe(4);
+
+    clearTryOnSession();
+
+    expect(URL.revokeObjectURL).toHaveBeenCalledTimes(created.length);
+    expect(new Set(revoked)).toEqual(new Set(created));
+    expect(liveObjectUrlCount()).toBe(0);
+    expect(render.signal.aborted).toBe(true);
+    expect(renderInFlight()).toBe(false);
+    expect(getTryOnPhoto("face")).toBeUndefined();
+    expect(tryOnResults()).toEqual([]);
+    expect(listener).toHaveBeenCalledTimes(1);
+    off();
+  });
+
+  it("releases a share or save URL on its own, and never revokes one twice", () => {
+    const url = adoptObjectUrl(jpeg());
+    releaseObjectUrl(url);
+    releaseObjectUrl(url);
+    clearTryOnSession();
+    expect(revoked).toEqual([url]);
+  });
+
+  /* "They are cleared ... after 30 minutes": an idle tab must not keep a selfie in memory. */
+  it("clears after 30 minutes without use", () => {
+    vi.useFakeTimers();
+    setTryOnPhoto("face", jpeg(), SIZE);
+    vi.advanceTimersByTime(IDLE_MS - 1000);
+    expect(getTryOnPhoto("face")).toBeDefined(); // a use restarts the clock
+    vi.advanceTimersByTime(IDLE_MS - 1000);
+    expect(liveObjectUrlCount()).toBe(1);
+    vi.advanceTimersByTime(1000);
+    expect(liveObjectUrlCount()).toBe(0);
+    expect(revoked).toEqual(created);
+  });
+
+  it("clears at once on return when a background tab's timer ran late", () => {
+    vi.useFakeTimers();
+    setTryOnPhoto("face", jpeg(), SIZE);
+    vi.setSystemTime(Date.now() + IDLE_MS + 1);
+    expect(getTryOnPhoto("face")).toBeUndefined();
+    expect(revoked).toEqual(created);
+  });
+
+  it("clears when the visible tab comes back after the idle time", () => {
+    vi.useFakeTimers();
+    setTryOnPhoto("face", jpeg(), SIZE);
+    touchTryOnSession();
+    vi.setSystemTime(Date.now() + IDLE_MS + 1);
+    document.dispatchEvent(new Event("visibilitychange"));
+    expect(liveObjectUrlCount()).toBe(0);
+  });
+
+  it("clears on pagehide", () => {
+    setTryOnPhoto("face", jpeg(), SIZE);
+    setTryOnResult("woven-gold-hoops", null, "face", { blob: png(), renderId: null, verified: null });
+    window.dispatchEvent(new Event("pagehide"));
+    expect(liveObjectUrlCount()).toBe(0);
+    expect(revoked).toHaveLength(2);
+  });
+
+  it("runs one render per tab: a new one aborts the last", () => {
+    const first = new AbortController();
+    const second = new AbortController();
+    const releaseFirst = trackRender(first);
+    trackRender(second);
+    expect(first.signal.aborted).toBe(true);
+    releaseFirst(); // the old render ending must not release the new one
+    expect(renderInFlight()).toBe(true);
+  });
+
+  it("records the handles tried this tab for the order, 200 characters at most", () => {
+    markTried("woven-gold-hoops");
+    markTried("baguette-huggies");
+    markTried("woven-gold-hoops");
+    markTried("Bad Handle!");
+    expect(window.sessionStorage.getItem(TRIED_KEY)).toBe("woven-gold-hoops,baguette-huggies");
+    for (let i = 0; i < 40; i += 1) markTried(`piece-number-${i}`);
+    const value = window.sessionStorage.getItem(TRIED_KEY) ?? "";
+    expect(value.length).toBeLessThanOrEqual(200);
+    expect(value).toMatch(/^[a-z0-9,-]{1,200}$/);
+    expect(triedHandles()[0]).toBe("woven-gold-hoops");
+  });
+
+  it("asks for consent once per tab, recording the notice version", () => {
+    expect(hasTryOnConsent()).toBe(false);
+    recordTryOnConsent();
+    expect(hasTryOnConsent()).toBe(true);
+    expect(window.sessionStorage.getItem(CONSENT_KEY)).toBe("tryon-2026-11");
+    window.sessionStorage.setItem(CONSENT_KEY, "tryon-2026-01");
+    resetTryOnConsentForTest();
+    expect(hasTryOnConsent()).toBe(false); // an older notice does not count
+  });
+
+  /* Privacy: the photo and the preview live only in memory; storage holds three small keys. */
+  it("never writes anything image-like to localStorage or sessionStorage", () => {
+    resetTryOnDeviceForTest();
+    getTryOnDevice();
+    setTryOnPhoto("face", jpeg(), SIZE);
+    setTryOnResult("woven-gold-hoops", null, "face", { blob: png(), renderId: "x", verified: "pass" });
+    markTried("woven-gold-hoops");
+    recordTryOnConsent();
+    const dump = (s: Storage) => Array.from({ length: s.length }, (_, i) => [s.key(i) ?? "", s.getItem(s.key(i) ?? "") ?? ""]);
+    const all = [...dump(window.localStorage), ...dump(window.sessionStorage)];
+    expect(all.map(([k]) => k).sort()).toEqual(["naira_tryon", "naira_tryon_consent", "naira_tryon_device"]);
+    for (const [, value] of all) {
+      expect(value.length).toBeLessThanOrEqual(200);
+      expect(value).not.toMatch(/data:|blob:|base64|\xff\xd8/i);
+    }
+  });
+});
