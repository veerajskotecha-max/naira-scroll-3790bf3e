+++ b/src/test/tryon/analytics.test.ts
@@ -0,0 +1,138 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { readdirSync, readFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+
+vi.mock("@/lib/clarity", () => ({ clarityEvent: vi.fn(), setClarityTag: vi.fn() }));
+vi.mock("@/lib/pixel", () => ({ trackPixel: vi.fn(), trackPageView: vi.fn() }));
+
+import { clarityEvent, setClarityTag } from "@/lib/clarity";
+import { trackPixel } from "@/lib/pixel";
+import { renderFailedEvent, tagTryOn, tryonEvent, TRYON_EVENTS, type TryOnEventName } from "@/lib/tryon/analytics";
+import { CLIENT_ERROR_CODES, SERVER_ERROR_CODES, TryOnError } from "@/lib/tryon/errors";
+import { buildTryOnMeta } from "@/lib/tryon/client";
+import { markTried, recordTryOnConsent, setTryOnPhoto, clearTryOnSession } from "@/lib/tryon/session";
+import { getTryOnDevice } from "@/lib/tryon/device";
+import { oneTapLine } from "@/lib/oneTapLine";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+
+const prod = (on: boolean) => {
+  (window as unknown as { __nairaProd?: boolean }).__nairaProd = on;
+};
+
+beforeEach(() => {
+  vi.mocked(clarityEvent).mockClear();
+  vi.mocked(setClarityTag).mockClear();
+  vi.mocked(trackPixel).mockClear();
+});
+
+afterEach(() => {
+  delete (window as unknown as { __nairaProd?: boolean }).__nairaProd;
+});
+
+/* The analytics section of the spec, name for name. */
+const SPEC_EVENTS = [
+  "tryon_hub_opened", "tryon_entry_pdp", "tryon_piece_opened", "tryon_demo_viewed",
+  "tryon_photo_camera", "tryon_photo_library", "tryon_photo_reused", "tryon_photo_warn_dark", "tryon_photo_warn_soft",
+  "tryon_photo_blocked_format", "tryon_photo_blocked_small",
+  "tryon_consent_given", "tryon_render_started", "tryon_render_ok", "tryon_cancelled", "tryon_interrupted",
+  "tryon_compare_used", "tryon_real_piece_opened", "tryon_feedback_yes", "tryon_feedback_no", "tryon_scene_high",
+  "tryon_added", "tryon_buynow", "tryon_choose_size", "tryon_reserve", "tryon_stone_rerender", "tryon_another",
+  "tryon_shared", "tryon_saved", "tryon_photo_deleted",
+];
+
+describe("try-on analytics", () => {
+  it("allows exactly the spec's events plus one failure event per error code", () => {
+    const failed = [...SERVER_ERROR_CODES, ...CLIENT_ERROR_CODES]
+      .filter((c) => c !== "cancelled" && c !== "interrupted")
+      .map((c) => `tryon_render_failed_${c}`);
+    expect([...TRYON_EVENTS].sort()).toEqual([...SPEC_EVENTS, ...failed].sort());
+    for (const name of TRYON_EVENTS) expect(name.length).toBeLessThanOrEqual(64);
+  });
+
+  it("sends allow-listed names to Clarity on the live shop", () => {
+    prod(true);
+    tryonEvent("tryon_render_ok");
+    tryonEvent(renderFailedEvent(new TryOnError("photo_unusable", { reason: "ear_not_visible" })));
+    expect(vi.mocked(clarityEvent).mock.calls).toEqual([["tryon_render_ok"], ["tryon_render_failed_photo_unusable"]]);
+  });
+
+  /* Only names reach Clarity: a reason, a verdict or a handle in an event name would leak into recordings' search. */
+  it("drops any name off the list", () => {
+    prod(true);
+    tryonEvent("tryon_render_failed_photo_unusable_ear_not_visible" as TryOnEventName);
+    tryonEvent("tryon_scene_0.83" as TryOnEventName);
+    tryonEvent("bag_opened" as TryOnEventName);
+    expect(clarityEvent).not.toHaveBeenCalled();
+  });
+
+  it("sends nothing off the live shop", () => {
+    tryonEvent("tryon_hub_opened");
+    tagTryOn("woven-gold-hoops");
+    prod(false);
+    tryonEvent("tryon_hub_opened");
+    expect(clarityEvent).not.toHaveBeenCalled();
+    expect(setClarityTag).not.toHaveBeenCalled();
+  });
+
+  it("names Cancel and a backgrounded tab by their own events", () => {
+    expect(renderFailedEvent(new TryOnError("cancelled"))).toBe("tryon_cancelled");
+    expect(renderFailedEvent(new TryOnError("interrupted"))).toBe("tryon_interrupted");
+    expect(renderFailedEvent(new TryOnError("offline"))).toBe("tryon_render_failed_offline");
+  });
+
+  it("tags the session with the piece, and only with a try-on handle", () => {
+    prod(true);
+    tagTryOn("woven-gold-hoops");
+    tagTryOn("someone@example.com");
+    expect(vi.mocked(setClarityTag).mock.calls).toEqual([
+      ["tryon", "used"],
+      ["tryon_piece", "woven-gold-hoops"],
+    ]);
+  });
+
+  /* Meta gets nothing new: AddToCart and InitiateCheckout come only from CartContext. */
+  it("never calls trackPixel from a try-on code path", () => {
+    prod(true);
+    Object.assign(URL, { createObjectURL: () => "blob:x", revokeObjectURL: () => {} });
+    getTryOnDevice();
+    buildTryOnMeta({ handle: "woven-gold-hoops", stone: null, kind: "face" });
+    recordTryOnConsent();
+    markTried("woven-gold-hoops");
+    setTryOnPhoto("face", new Blob([new Uint8Array([0xff, 0xd8])], { type: "image/jpeg" }), { width: 1152, height: 1536 });
+    clearTryOnSession();
+    for (const name of TRYON_EVENTS) tryonEvent(name as TryOnEventName);
+    oneTapLine(jewellerySnapshot.find((p) => p.handle === "baguette-huggies")!, { Stone: "Ruby" });
+    expect(trackPixel).not.toHaveBeenCalled();
+  });
+});
+
+describe("try-on modules' imports", () => {
+  const root = resolve(__dirname, "../..");
+  const dir = join(root, "lib/tryon");
+  const sources = [
+    ...readdirSync(dir)
+      .filter((f) => /\.tsx?$/.test(f))
+      .map((f) => [`lib/tryon/${f}`, readFileSync(join(dir, f), "utf8")] as const),
+    ["lib/oneTapLine.ts", readFileSync(join(root, "lib/oneTapLine.ts"), "utf8")] as const,
+  ];
+
+  it("never import three, gsap, MediaPipe, the pixel or the visitor id", () => {
+    for (const [file, text] of sources) {
+      expect([file, text.match(/from\s+["'](three|gsap|@mediapipe[^"']*|@\/lib\/pixel|@\/lib\/visitorId)["']/g)]).toEqual([file, null]);
+      expect([file, text.match(/import\(\s*["'](three|gsap|@mediapipe)/g)]).toEqual([file, null]);
+    }
+  });
+
+  /* Privacy: a photo or preview as a data: URL would sit in the DOM as text. */
+  it("never turn an image into a data: URL", () => {
+    for (const [file, text] of sources) {
+      expect([file, /toDataURL|readAsDataURL|data:image/.test(text)]).toEqual([file, false]);
+    }
+  });
+
+  /* The quota key is a random device id, never the visitor id Meta receives (comments may name it). */
+  it("never touch naira_vid", () => {
+    const code = (text: string) => text.replace(/\/\*[\s\S]*?\*\//g, "").replace(/^\s*\/\/.*$/gm, "");
+    for (const [file, text] of sources) expect([file, /naira_vid|getVisitorId|__nairaVid/.test(code(text))]).toEqual([file, false]);
+  });
+});
