+
+  /* Where <img> applies EXIF itself it goes first: Chrome decodes a JPEG drawn
+     smaller at reduced scale, 647 ms against 1125 ms at 4x CPU for 12 MP. */
+  it("decodes through the <img> first where the browser orients <img> itself", async () => {
+    const createImageBitmap = vi.fn(async () => bitmap(3000, 4000));
+    vi.stubGlobal("createImageBitmap", createImageBitmap);
+    vi.stubGlobal("CSS", { supports: (prop: string, value: string) => prop === "image-orientation" && value === "from-image" });
+    vi.stubGlobal("URL", Object.assign(URL, { createObjectURL: vi.fn(() => "blob:x"), revokeObjectURL: vi.fn() }));
+    class FakeImage {
+      naturalWidth = 3000;
+      naturalHeight = 4000;
+      onload: (() => void) | null = null;
+      onerror: (() => void) | null = null;
+      removeAttribute() {}
+      set src(_: string) {
+        setTimeout(() => this.onload?.(), 0);
+      }
+    }
+    vi.stubGlobal("Image", FakeImage);
+    await preparePhoto(new File([exifJpeg()], "a.jpg"));
+    expect(createImageBitmap).not.toHaveBeenCalled();
+    expect(contexts[0].drawImage.mock.calls[0][0]).toBeInstanceOf(FakeImage);
+    expect(URL.revokeObjectURL).toHaveBeenCalledWith("blob:x");
