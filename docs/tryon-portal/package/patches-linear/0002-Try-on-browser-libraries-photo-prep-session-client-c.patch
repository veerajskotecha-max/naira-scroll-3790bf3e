index 0000000..071915d
--- /dev/null
+++ b/src/lib/tryon/cropMaths.ts
@@ -0,0 +1,108 @@
+/*
+  The 3:4 portrait frame a try-on photo is cut to, in the decoded photo's own
+  pixels (EXIF orientation already applied). Pure, so the crop step and the
+  encoder agree to the pixel and the maths is tested without a canvas.
+
+  Every photo leaves the phone at exactly 1152x1536: the server refuses any
+  other shape (long side 1024 to 1600, 3:4 within 2%), and one size keeps the
+  render cost and the upload predictable. A frame narrower than 768 source
+  pixels would be stretched more than 1.5 times to fill it, too soft to place
+  a 12 mm piece on, so it is refused as "too small" instead.
+*/
+
+export const OUTPUT_WIDTH = 1152;
+export const OUTPUT_HEIGHT = 1536;
+/** Width over height of the frame. */
+export const FRAME_ASPECT = 3 / 4;
+/** The narrowest frame, in source pixels, worth sending. */
+export const MIN_CROP_SHORT = 768;
+
+export interface CropRect {
+  x: number;
+  y: number;
+  width: number;
+  height: number;
+}
+
+export interface Size {
+  width: number;
+  height: number;
+}
+
+const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);
+
+/** The largest 3:4 frame that fits the photo. */
+export const maxCrop = (src: Size): Size => {
+  if (src.width / src.height > FRAME_ASPECT) {
+    const height = Math.floor(src.height);
+    return { width: Math.min(Math.floor(src.width), Math.round(height * FRAME_ASPECT)), height };
+  }
+  const width = Math.floor(src.width);
+  return { width, height: Math.min(Math.floor(src.height), Math.round(width / FRAME_ASPECT)) };
+};
+
+/** Keeps a frame inside the photo, its size untouched when it fits. */
+export const clampCrop = (rect: CropRect, src: Size): CropRect => {
+  const limit = maxCrop(src);
+  const width = Math.min(Math.round(rect.width), limit.width);
+  const height = Math.min(Math.round(rect.height), limit.height);
+  return {
+    x: Math.round(clamp(rect.x, 0, src.width - width)),
+    y: Math.round(clamp(rect.y, 0, src.height - height)),
+    width,
+    height,
+  };
+};
+
+/**
+ * The frame a photo opens on: centred, as large as fits (`zoom` 1), or
+ * `zoom` times smaller around the centre. Portrait phone photos are already
+ * 3:4, so most open uncut.
+ */
+export const initialCrop = (src: Size, zoom = 1): CropRect => {
+  const limit = maxCrop(src);
+  const z = Math.max(1, zoom);
+  const width = Math.round(limit.width / z);
+  const height = Math.round(width / FRAME_ASPECT);
+  return clampCrop({ x: (src.width - width) / 2, y: (src.height - height) / 2, width, height }, src);
+};
+
+/**
+ * Drag to reposition: the photo follows the finger under a fixed frame, so the
+ * frame moves the other way. `frameWidthPx` is the frame's width on screen;
+ * the drag is converted to source pixels at the frame's own scale.
+ */
+export const panCrop = (rect: CropRect, dxPx: number, dyPx: number, frameWidthPx: number, src: Size): CropRect => {
+  const perPx = frameWidthPx > 0 ? rect.width / frameWidthPx : 0;
+  return clampCrop({ ...rect, x: rect.x - dxPx * perPx, y: rect.y - dyPx * perPx }, src);
+};
+
+/**
+ * Zoom about the frame's centre: `factor` above 1 zooms in (a smaller frame).
+ * It stops at the largest frame that fits and, when the photo allows, at the
+ * smallest frame still worth sending, so zooming can never make it too small.
+ */
+export const zoomCrop = (rect: CropRect, factor: number, src: Size): CropRect => {
+  const limit = maxCrop(src);
+  const floor = Math.min(MIN_CROP_SHORT, limit.width);
+  const width = Math.round(clamp(rect.width / (factor > 0 ? factor : 1), floor, limit.width));
+  const height = Math.round(width / FRAME_ASPECT);
+  const cx = rect.x + rect.width / 2;
+  const cy = rect.y + rect.height / 2;
+  return clampCrop({ x: cx - width / 2, y: cy - height / 2, width, height }, src);
+};
+
+/** Too small to send: the frame's short side (its width) is under 768 source pixels. */
+export const isTooSmall = (rect: Pick<CropRect, "width" | "height">) => Math.min(rect.width, rect.height) < MIN_CROP_SHORT;
+
+/** Whatever the frame, the photo is drawn at 1152x1536. */
+export const outputSize = (): Size => ({ width: OUTPUT_WIDTH, height: OUTPUT_HEIGHT });
+
+/**
+ * How to show the photo under a frame `frameWidthPx` wide with CSS: scale the
+ * whole decoded photo by `scale` and shift it by (`x`, `y`) screen pixels.
+ */
+export const imageTransform = (rect: CropRect, frameWidthPx: number) => {
+  const scale = rect.width > 0 ? frameWidthPx / rect.width : 0;
+  return { scale, x: -rect.x * scale, y: -rect.y * scale };
+};
