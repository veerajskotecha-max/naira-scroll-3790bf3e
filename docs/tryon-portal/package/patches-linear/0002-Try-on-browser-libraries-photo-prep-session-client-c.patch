+  });
+
+  /* Chrome 87 knows only 'none' and 'flipY' and throws a TypeError on 'from-image'. */
+  it("falls back to the <img> path when createImageBitmap refuses the orientation option", async () => {
+    vi.stubGlobal("createImageBitmap", vi.fn(async () => {
+      throw new TypeError("The provided value 'from-image' is not a valid enum value");
+    }));
+    vi.stubGlobal("URL", Object.assign(URL, { createObjectURL: vi.fn(() => "blob:x"), revokeObjectURL: vi.fn() }));
+    class FakeImage {
+      naturalWidth = 1536;
+      naturalHeight = 2048;
+      onload: (() => void) | null = null;
+      onerror: (() => void) | null = null;
+      removeAttribute() {}
+      set src(_: string) {
+        setTimeout(() => this.onload?.(), 0);
+      }
