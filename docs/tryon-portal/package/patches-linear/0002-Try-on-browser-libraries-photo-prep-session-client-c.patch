+
+  it("blocks a photo nothing can decode as 'format', and flags HEIC", async () => {
+    vi.stubGlobal("createImageBitmap", vi.fn(async () => {
+      throw new DOMException("The source image could not be decoded.", "InvalidStateError");
+    }));
+    vi.stubGlobal("URL", Object.assign(URL, { createObjectURL: vi.fn(() => "blob:x"), revokeObjectURL: vi.fn() }));
+    class BrokenImage {
+      onload: (() => void) | null = null;
+      onerror: (() => void) | null = null;
+      set src(_: string) {
+        setTimeout(() => this.onerror?.(), 0);
+      }
+    }
+    vi.stubGlobal("Image", BrokenImage);
+    const heic = new Uint8Array([0, 0, 0, 0x18, ...Array.from("ftypheic").map((c) => c.charCodeAt(0)), 0, 0, 0, 0]);
+    const error = await preparePhoto(new File([heic], "IMG_0002.HEIC", { type: "image/heic" })).catch((e) => e);
+    expect(error).toBeInstanceOf(PhotoPrepError);
+    expect(error.code).toBe("format");
+    expect(error.heic).toBe(true);
+    const empty = await preparePhoto(new File([], "empty.jpg")).catch((e) => e);
+    expect(empty.code).toBe("format");
+  });
+
+  it("blocks a photo whose largest 3:4 frame is under 768 px wide as 'too small'", async () => {
+    const small = bitmap(600, 800);
+    vi.stubGlobal("createImageBitmap", vi.fn(async () => small));
+    const error = await preparePhoto(new File([exifJpeg()], "small.jpg")).catch((e) => e);
+    expect(error.code).toBe("too_small");
+    expect(small.close).toHaveBeenCalled();
+    expect(toBlob).not.toHaveBeenCalled();
+  });
+
+  it("refuses to encode a frame the shopper zoomed under 768 px", async () => {
+    vi.stubGlobal("createImageBitmap", vi.fn(async () => bitmap(3000, 4000)));
+    const decoded = await decodePhoto(new File([exifJpeg()], "a.jpg"));
+    const error = await encodePhoto(decoded, { x: 0, y: 0, width: 700, height: 933 }).catch((e) => e);
+    expect(error.code).toBe("too_small");
+  });
+
+  it("says 'unsupported' when this browser can only write PNG", async () => {
+    vi.stubGlobal("createImageBitmap", vi.fn(async () => bitmap(3000, 4000)));
+    HTMLCanvasElement.prototype.toBlob = vi.fn((cb: BlobCallback) => cb(new Blob([ENCODED], { type: "image/png" }))) as never;
+    const error = await preparePhoto(new File([exifJpeg()], "a.jpg")).catch((e) => e);
+    expect(error.code).toBe("unsupported");
+  });
+
+  it("uses OffscreenCanvas.convertToBlob where the browser has it", async () => {
+    vi.stubGlobal("createImageBitmap", vi.fn(async () => bitmap(3000, 4000)));
+    const convert = vi.fn(async (o: { type: string; quality: number }) => new Blob([ENCODED], { type: o.type }));
+    const draws: unknown[][] = [];
+    class FakeOffscreen {
+      constructor(
+        public width: number,
+        public height: number,
+      ) {}
+      getContext() {
+        return {
+          drawImage: (...args: unknown[]) => draws.push([this.width, this.height, ...args]),
+          getImageData: (_x: number, _y: number, w: number, h: number) => ({ data: new Uint8ClampedArray(w * h * 4).fill(200), width: w, height: h }),
+        };
+      }
+      convertToBlob = convert;
+    }
+    vi.stubGlobal("OffscreenCanvas", FakeOffscreen);
+    const out = await preparePhoto(new File([exifJpeg()], "a.jpg"));
+    expect(convert).toHaveBeenCalledWith({ type: "image/jpeg", quality: 0.85 });
+    expect(draws[0].slice(0, 2)).toEqual([1152, 1536]);
+    // the check copy: two exact halvings
+    expect(draws[1].slice(0, 2)).toEqual([576, 768]);
+    expect(draws[2].slice(0, 2)).toEqual([288, 384]);
+    expect(toBlob).not.toHaveBeenCalled();
+    expect(out.warnings).toEqual(["soft"]); // a flat bright frame: no edges
+  });
+
+  it("returns the dark and soft hints measured on the 288x384 copy", async () => {
+    vi.stubGlobal("createImageBitmap", vi.fn(async () => bitmap(3000, 4000)));
+    pixel = 45;
+    const out = await preparePhoto(new File([exifJpeg()], "a.jpg"));
+    expect(contexts[1].drawImage.mock.calls[0].slice(1)).toEqual([0, 0, 576, 768]);
+    expect(contexts[2].getImageData).toHaveBeenCalledWith(0, 0, 288, 384);
+    expect(contexts[2].imageSmoothingQuality).toBe("low");
+    expect(out.warnings).toEqual(["dark"]);
+  });
+});
+
+describe("sniffImageType", () => {
+  const bytes = (...parts: Array<number[] | string>) =>
+    new Uint8Array(parts.flatMap((p) => (typeof p === "string" ? Array.from(p).map((c) => c.charCodeAt(0)) : p)));
+  it.each([
+    ["jpeg", bytes([0xff, 0xd8, 0xff, 0xe0])],
+    ["png", bytes([0x89], "PNG", [0x0d, 0x0a, 0x1a, 0x0a])],
+    ["gif", bytes("GIF89a")],
+    ["webp", bytes("RIFF", [0, 0, 0, 0], "WEBP")],
+    ["heic", bytes([0, 0, 0, 0x18], "ftypheic")],
+    ["heic", bytes([0, 0, 0, 0x18], "ftypmif1")],
+    ["avif", bytes([0, 0, 0, 0x18], "ftypavif")],
+    ["unknown", bytes("%PDF-1.7")],
+  ])("reads %s from its first bytes", (type, b) => {
+    expect(sniffImageType(b)).toBe(type);
+  });
+});
diff --git a/src/test/tryon/sceneGuard.test.ts b/src/test/tryon/sceneGuard.test.ts
new file mode 100644
index 0000000..00ca735
--- /dev/null
+++ b/src/test/tryon/sceneGuard.test.ts
@@ -0,0 +1,88 @@
+import { describe, expect, it } from "vitest";
+import {
+  CHANGE_THRESHOLD,
+  changedFraction,
+  GUARD_HEIGHT,
+  GUARD_WIDTH,
+  SCENE_GUARD_MODE,
+  sceneBucket,
+  sceneGuard,
+  sceneVerdict,
+} from "@/lib/tryon/sceneGuard";
+
+/* Synthetic 96x128 scenes drawn in code: a "face" of soft gradients and features. */
+const scene = (shift = 0, patch?: { x: number; y: number; size: number; value: number }) => {
+  const w = GUARD_WIDTH;
+  const h = GUARD_HEIGHT;
+  const data = new Uint8ClampedArray(w * h * 4);
+  for (let y = 0; y < h; y += 1)
+    for (let x = 0; x < w; x += 1) {
+      let v = 60 + Math.round((120 * y) / h) + ((x - 48) ** 2 + (y - 50) ** 2 < 900 ? 50 : 0) + ((x * 7 + y * 3) % 11);
+      if (patch && x >= patch.x && x < patch.x + patch.size && y >= patch.y && y < patch.y + patch.size) v = patch.value;
+      v = Math.max(0, Math.min(255, v + shift));
+      data.set([v, v, v, 255], (y * w + x) * 4);
+    }
+  return { data, width: w, height: h };
+};
+
+describe("sceneGuard", () => {
+  it("launches in 'log' mode", () => {
+    expect(SCENE_GUARD_MODE).toBe("log");
+    expect(CHANGE_THRESHOLD).toBe(24);
+  });
+
+  it("calls identical images low", () => {
+    expect(changedFraction(scene(), scene())).toBe(0);
+    expect(sceneBucket(changedFraction(scene(), scene()))).toBe("low");
+  });
+
+  /* A lighter skin tone or a re-lit photo moves every pixel: the model judge can
+     miss it, this cannot. */
+  it("calls a uniform brightness shift high", () => {
+    const f = changedFraction(scene(), scene(40));
+    expect(f).toBeGreaterThan(0.9);
+    expect(sceneBucket(f)).toBe("high");
+  });
+
+  it("calls a small local patch (the earring) low", () => {
+    const f = changedFraction(scene(), scene(0, { x: 20, y: 60, size: 6, value: 250 }));
+    expect(f).toBeGreaterThan(0);
+    expect(f).toBeLessThan(0.02);
+    expect(sceneBucket(f)).toBe("low");
+  });
+
+  it("calls a regenerated lower half mid or high", () => {
+    const changed = scene(0, { x: 0, y: 64, size: 200, value: 10 });
+    expect(["mid", "high"]).toContain(sceneBucket(changedFraction(scene(), changed)));
+  });
+
+  it("uses the spec's buckets", () => {
+    expect(sceneBucket(0.149)).toBe("low");
+    expect(sceneBucket(0.15)).toBe("mid");
+    expect(sceneBucket(0.349)).toBe("mid");
+    expect(sceneBucket(0.35)).toBe("high");
+  });
+
+  it("blocks only a high result, and only in strict mode", () => {
+    expect(sceneVerdict(0.9, "log").blocked).toBe(false);
+    expect(sceneVerdict(0.9, "strict")).toMatchObject({ bucket: "high", blocked: true });
+    expect(sceneVerdict(0.2, "strict").blocked).toBe(false);
+  });
+
+  it("calls images of different shapes changed", () => {
+    expect(changedFraction(scene(), { data: new Uint8ClampedArray(4 * 4), width: 2, height: 2 })).toBe(1);
+  });
+
+  it("runs well under its 50 ms budget", () => {
+    const a = scene();
+    const b = scene(0, { x: 20, y: 60, size: 6, value: 250 });
+    const t0 = performance.now();
+    for (let i = 0; i < 10; i += 1) changedFraction(a, b);
+    expect((performance.now() - t0) / 10).toBeLessThan(50);
+  });
+
+  it("returns null instead of throwing where it cannot run", async () => {
+    const blob = new Blob([new Uint8Array([1, 2, 3])], { type: "image/png" });
+    await expect(sceneGuard(blob, blob)).resolves.toBeNull();
+  });
+});
