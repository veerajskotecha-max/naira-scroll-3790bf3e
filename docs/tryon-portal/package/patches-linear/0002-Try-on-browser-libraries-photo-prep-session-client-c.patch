index 0000000..8f9079d
--- /dev/null
+++ b/src/lib/tryon/photoChecks.ts
@@ -0,0 +1,71 @@
+/*
+  Two quick, non-blocking hints about a prepared photo, measured on the phone
+  on a 288x384 greyscale copy: too dark (mean luminance) and too soft (how
+  much a 3x3 Laplacian, an edge detector, varies; a blurred photo has few
+  edges, so little variance). Either can still be sent ("Use anyway"); they
+  only warn, because a dark or soft photo gives a less true preview.
+
+  The thresholds are exported so they can be tuned on the synthetic test
+  subjects without touching the maths.
+*/
+
+/** Mean luminance (0 to 255) under which a photo is called dark. */
+export const DARK_MEAN = 60;
+/** Laplacian variance under which a photo is called soft. */
+export const SOFT_VAR = 40;
+/** The size of the copy the checks run on. */
+export const CHECK_WIDTH = 288;
+export const CHECK_HEIGHT = 384;
+
+export type PhotoWarning = "dark" | "soft";
+
+/** RGBA pixels, as a canvas ImageData has them; tests build their own. */
+export interface PixelData {
+  data: ArrayLike<number>;
+  width: number;
+  height: number;
+}
+
+/** Rec. 601 luma of each pixel, 0 to 255. */
+export const toGrey = (img: PixelData): Float32Array => {
+  const out = new Float32Array(img.width * img.height);
+  const d = img.data;
+  for (let i = 0, p = 0; i < out.length; i += 1, p += 4) out[i] = 0.299 * d[p] + 0.587 * d[p + 1] + 0.114 * d[p + 2];
+  return out;
+};
+
+/** Mean luminance and Laplacian variance from one greyscale pass (the phone does this once per photo). */
+export const photoStats = (img: PixelData) => {
+  const { width: w, height: h } = img;
+  const g = toGrey(img);
+  let total = 0;
+  for (let i = 0; i < g.length; i += 1) total += g[i];
+  let sum = 0;
+  let sumSq = 0;
+  let n = 0;
+  for (let y = 1; y < h - 1; y += 1) {
+    for (let x = 1; x < w - 1; x += 1) {
+      const i = y * w + x;
+      const lap = g[i - w] + g[i + w] + g[i - 1] + g[i + 1] - 4 * g[i];
+      sum += lap;
+      sumSq += lap * lap;
+      n += 1;
+    }
+  }
+  const mean = n ? sum / n : 0;
+  return { mean: g.length ? total / g.length : 0, laplacianVariance: n ? sumSq / n - mean * mean : 0 };
+};
+
+export const meanLuminance = (img: PixelData): number => photoStats(img).mean;
+
+/** Variance of the 4-neighbour Laplacian over the inner pixels. */
+export const laplacianVariance = (img: PixelData): number => photoStats(img).laplacianVariance;
+
+/** The hints for one photo, dark first. */
+export const photoWarnings = (img: PixelData): PhotoWarning[] => {
+  const stats = photoStats(img);
+  const out: PhotoWarning[] = [];
+  if (stats.mean < DARK_MEAN) out.push("dark");
+  if (stats.laplacianVariance < SOFT_VAR) out.push("soft");
+  return out;
+};
diff --git a/src/lib/tryon/preparePhoto.ts b/src/lib/tryon/preparePhoto.ts
new file mode 100644
index 0000000..26464c4
--- /dev/null
+++ b/src/lib/tryon/preparePhoto.ts
@@ -0,0 +1,238 @@
+import { createSurface, blobBytes, type Surface } from "./canvas";
+import { initialCrop, isTooSmall, maxCrop, OUTPUT_HEIGHT, OUTPUT_WIDTH, type CropRect, type Size } from "./cropMaths";
+import { CHECK_HEIGHT, CHECK_WIDTH, photoWarnings, type PhotoWarning } from "./photoChecks";
+
+/*
+  Getting a shopper's photo ready, all on the phone, before anything is sent.
+
+  Decode with the camera's EXIF orientation applied, cut the 3:4 frame, draw
+  it at 1152x1536 and encode a fresh JPEG at quality 0.85. The new file is
+  pixels only: re-encoding through a canvas leaves the EXIF block (camera,
+  time, GPS location) behind, which is why the photo is never sent as picked.
+
+  Orientation, two paths, both proven upright in Chromium for EXIF 1, 3, 6
+  and 8. An <img> applies EXIF orientation itself wherever the browser
+  supports CSS image-orientation (Chrome 81+, Safari 13.1+), and is used
+  first there because it is the fast one: drawn smaller than it is, Chrome
+  decodes a JPEG at reduced scale, so a 4000x3000 photo is ready in a median
+  647 ms at 4x CPU throttle against 1125 ms through createImageBitmap, which
+  decodes all 12 MP before the draw (the 800 ms budget). createImageBitmap
+  with imageOrientation 'from-image' is the other path: first where the
+  browser cannot say it orients <img>, and the fallback when an <img> fails.
+  The <img> is never put on the page and its blob URL is revoked as soon as
+  it loads.
+*/
+
+export type PhotoBlock = "format" | "too_small" | "unsupported";
+
+/** A photo that cannot be used: undecodable, too small, or a browser that cannot encode. */
+export class PhotoPrepError extends Error {
+  readonly code: PhotoBlock;
+  /** The file was HEIC/HEIF, which Chrome on Android cannot open. */
+  readonly heic: boolean;
+  constructor(code: PhotoBlock, heic = false) {
+    super(`tryon photo: ${code}`);
+    this.name = "PhotoPrepError";
+    this.code = code;
+    this.heic = heic;
+  }
+}
+
+export type SniffedType = "jpeg" | "png" | "gif" | "webp" | "heic" | "avif" | "unknown";
+
+const HEIC_BRANDS = new Set(["heic", "heix", "hevc", "hevx", "heim", "heis", "hevm", "hevs", "mif1", "msf1"]);
+
+/** What a file really is, from its first bytes (its name and type can lie). */
+export const sniffImageType = (b: ArrayLike<number>): SniffedType => {
+  if (b.length >= 3 && b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return "jpeg";
+  if (b.length >= 8 && b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47) return "png";
+  if (b.length >= 4 && b[0] === 0x47 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x38) return "gif";
+  const ascii = (from: number, to: number) => String.fromCharCode(...Array.prototype.slice.call(b, from, to));
+  if (b.length >= 12 && ascii(0, 4) === "RIFF" && ascii(8, 12) === "WEBP") return "webp";
+  if (b.length >= 12 && ascii(4, 8) === "ftyp") {
+    const major = ascii(8, 12);
+    if (major === "avif" || major === "avis") return "avif";
+    if (HEIC_BRANDS.has(major)) return "heic";
+  }
+  return "unknown";
+};
+
+/** A photo decoded upright, ready to crop and draw. Call close() when done. */
+export interface DecodedPhoto {
+  image: CanvasImageSource;
+  width: number;
+  height: number;
+  via: "bitmap" | "img";
+  close: () => void;
+}
+
+const viaBitmap = async (file: Blob): Promise<DecodedPhoto | null> => {
+  if (typeof createImageBitmap !== "function") return null;
+  try {
+    const bitmap = await createImageBitmap(file, { imageOrientation: "from-image" });
+    return { image: bitmap, width: bitmap.width, height: bitmap.height, via: "bitmap", close: () => bitmap.close() };
+  } catch {
+    // An option this browser does not know, or bytes it cannot read: the <img> path decides.
+    return null;
+  }
+};
+
+/* A browser that neither loads nor fails the image must not leave "Getting your photo ready" up for good. */
+export const DECODE_TIMEOUT_MS = 20_000;
+
+const viaImg = (file: Blob): Promise<DecodedPhoto> =>
+  new Promise((resolve, reject) => {
+    if (typeof Image === "undefined" || typeof URL?.createObjectURL !== "function") {
+      reject(new PhotoPrepError("unsupported"));
+      return;
+    }
+    const url = URL.createObjectURL(file);
+    const img = new Image();
+    const timer = setTimeout(() => {
+      img.onload = img.onerror = null;
+      URL.revokeObjectURL(url);
+      reject(new PhotoPrepError("format"));
+    }, DECODE_TIMEOUT_MS);
+    img.decoding = "async";
+    img.onload = () => {
+      clearTimeout(timer);
+      URL.revokeObjectURL(url);
+      const width = img.naturalWidth;
+      const height = img.naturalHeight;
+      if (!width || !height) {
+        reject(new PhotoPrepError("format"));
+        return;
+      }
+      resolve({
+        image: img,
+        width,
+        height,
+        via: "img",
+        close: () => {
+          img.removeAttribute("src");
+        },
+      });
+    };
+    img.onerror = () => {
+      clearTimeout(timer);
+      URL.revokeObjectURL(url);
+      reject(new PhotoPrepError("format"));
+    };
+    img.src = url;
+  });
+
+/** Whether an <img> drawn to a canvas comes out upright: browsers that know CSS image-orientation apply EXIF to it. */
+export const imgAppliesOrientation = (): boolean => {
+  try {
+    return typeof CSS !== "undefined" && typeof CSS.supports === "function" && CSS.supports("image-orientation", "from-image");
+  } catch {
+    return false;
+  }
+};
+
+const viaImgOrNull = (file: Blob) => viaImg(file).catch(() => null);
+
+/** Decodes any image the browser can read, upright, at its own size. */
+export const decodeImage = async (file: Blob): Promise<DecodedPhoto> => {
+  if (!file || !file.size) throw new PhotoPrepError("format");
+  const decoded = imgAppliesOrientation()
+    ? (await viaImgOrNull(file)) ?? (await viaBitmap(file))
+    : (await viaBitmap(file)) ?? (await viaImgOrNull(file));
+  if (decoded) return decoded;
+  if (typeof createImageBitmap !== "function" && (typeof Image === "undefined" || typeof URL?.createObjectURL !== "function")) {
+    throw new PhotoPrepError("unsupported");
+  }
+  const head = await blobBytes(file.slice(0, 32)).catch(() => new Uint8Array());
+  throw new PhotoPrepError("format", sniffImageType(head) === "heic");
+};
+
+/** Decodes a shopper's photo, refusing one whose largest 3:4 frame is under 768 pixels wide. */
+export const decodePhoto = async (file: Blob): Promise<DecodedPhoto> => {
+  const decoded = await decodeImage(file);
+  if (isTooSmall(maxCrop(decoded))) {
+    decoded.close();
+    throw new PhotoPrepError("too_small");
+  }
+  return decoded;
+};
+
+const smooth = (ctx: Surface["ctx"]) => {
+  ctx.imageSmoothingEnabled = true;
+  if ("imageSmoothingQuality" in ctx) ctx.imageSmoothingQuality = "high";
+};
+
+/** Draws the framed part of the photo to fill `canvas`, for the crop step's preview. */
+export const drawCrop = (decoded: DecodedPhoto, crop: CropRect, canvas: HTMLCanvasElement) => {
+  const ctx = canvas.getContext("2d");
+  if (!ctx) return;
+  smooth(ctx);
+  ctx.drawImage(decoded.image, crop.x, crop.y, crop.width, crop.height, 0, 0, canvas.width, canvas.height);
+};
+
+/*
+  The 288x384 copy the hints are measured on: two exact halvings of the
+  1152x1536 frame with bilinear filtering. At exactly half size bilinear is a
+  true 2x2 average, so the copy is a 4x4 box average with no aliasing to fake
+  sharpness, in about 10 ms at 4x CPU against 30 to 45 ms for one 'high' draw.
+*/
+const checkPixels = (frame: CanvasImageSource) => {
+  const half = createSurface(CHECK_WIDTH * 2, CHECK_HEIGHT * 2);
+  const check = createSurface(CHECK_WIDTH, CHECK_HEIGHT);
+  try {
+    if (!half || !check) return null;
+    for (const s of [half, check]) {
+      s.ctx.imageSmoothingEnabled = true;
+      if ("imageSmoothingQuality" in s.ctx) s.ctx.imageSmoothingQuality = "low";
+    }
+    half.ctx.drawImage(frame, 0, 0, CHECK_WIDTH * 2, CHECK_HEIGHT * 2);
+    check.ctx.drawImage(half.source, 0, 0, CHECK_WIDTH, CHECK_HEIGHT);
+    return check.ctx.getImageData(0, 0, CHECK_WIDTH, CHECK_HEIGHT);
+  } finally {
+    half?.release();
+    check?.release();
+  }
+};
+
+export interface PreparedPhoto {
+  /** A fresh JPEG with no EXIF, exactly 1152x1536. */
+  blob: Blob;
+  width: number;
+  height: number;
+  warnings: PhotoWarning[];
+  crop: CropRect;
+  source: Size;
+}
+
+/** Draws the frame at 1152x1536, encodes JPEG q0.85 and runs the dark and soft checks. */
+export const encodePhoto = async (decoded: DecodedPhoto, crop: CropRect = initialCrop(decoded)): Promise<PreparedPhoto> => {
+  if (isTooSmall(crop)) throw new PhotoPrepError("too_small");
+  const out = createSurface(OUTPUT_WIDTH, OUTPUT_HEIGHT);
+  if (!out) throw new PhotoPrepError("unsupported");
+  try {
+    smooth(out.ctx);
+    out.ctx.drawImage(decoded.image, crop.x, crop.y, crop.width, crop.height, 0, 0, OUTPUT_WIDTH, OUTPUT_HEIGHT);
+    const blob = await out.encode("image/jpeg", 0.85);
+    // A browser that cannot write JPEG hands back PNG; the server would refuse it.
+    if (!blob || blob.type !== "image/jpeg") throw new PhotoPrepError("unsupported");
+    let warnings: PhotoWarning[] = [];
+    try {
+      const pixels = checkPixels(out.source);
+      if (pixels) warnings = photoWarnings(pixels);
+    } catch {
+      // The hints are advice; a photo is never held back for want of them.
+    }
+    return { blob, width: OUTPUT_WIDTH, height: OUTPUT_HEIGHT, warnings, crop, source: { width: decoded.width, height: decoded.height } };
+  } finally {
+    out.release();
+  }
+};
+
+/** Decode, frame (centred unless `crop` is given), encode: the whole preparation in one call. */
+export const preparePhoto = async (file: Blob, crop?: CropRect): Promise<PreparedPhoto> => {
+  const decoded = await decodePhoto(file);
+  try {
+    return await encodePhoto(decoded, crop ?? initialCrop(decoded));
+  } finally {
+    decoded.close();
+  }
+};
diff --git a/src/lib/tryon/sceneGuard.ts b/src/lib/tryon/sceneGuard.ts
new file mode 100644
index 0000000..6aee281
--- /dev/null
+++ b/src/lib/tryon/sceneGuard.ts
@@ -0,0 +1,114 @@
+import { createSurface } from "./canvas";
+import type { PixelData } from "./photoChecks";
+import { toGrey } from "./photoChecks";
+import { decodeImage } from "./preparePhoto";
+
+/*
+  A check on the preview that does not trust a model: did the photo around the
+  piece stay the shopper's own? Both images are shrunk to 96x128 greyscale and
+  softened by a 1 px box blur (so a sub-pixel shift is not "change"), then we
+  count the share of pixels whose grey moved by more than 24 of 255. Adding an
+  earring changes a few dozen of those 12,288 pixels; a regenerated face, a
+  lighter skin tone or a new background changes most of them.
+
+  Buckets: low under 0.15, mid under 0.35, high otherwise. In 'log' mode (the
+  launch setting until it is calibrated on the proof renders) it only
+  reports; in 'strict' a high preview is not shown (fidelity_failed).
+*/
+
+export type SceneGuardMode = "log" | "strict";
+export type SceneBucket = "low" | "mid" | "high";
+
+/** Client constant: report only, until the thresholds are calibrated. */
+export const SCENE_GUARD_MODE: SceneGuardMode = "log";
+
+export const GUARD_WIDTH = 96;
+export const GUARD_HEIGHT = 128;
+/** A pixel counts as changed past this grey difference (0 to 255). */
+export const CHANGE_THRESHOLD = 24;
+export const LOW_BELOW = 0.15;
+export const MID_BELOW = 0.35;
+
+/** A 3x3 mean (a 1 px box blur), edges clamped. */
+export const boxBlur = (grey: Float32Array, w: number, h: number): Float32Array => {
+  const out = new Float32Array(w * h);
+  for (let y = 0; y < h; y += 1) {
+    for (let x = 0; x < w; x += 1) {
+      let sum = 0;
+      let n = 0;
+      for (let dy = -1; dy <= 1; dy += 1) {
+        const yy = y + dy;
+        if (yy < 0 || yy >= h) continue;
+        for (let dx = -1; dx <= 1; dx += 1) {
+          const xx = x + dx;
+          if (xx < 0 || xx >= w) continue;
+          sum += grey[yy * w + xx];
+          n += 1;
+        }
+      }
+      out[y * w + x] = sum / n;
+    }
+  }
+  return out;
+};
+
+/** The share of pixels that changed between two same-sized RGBA images. */
+export const changedFraction = (original: PixelData, result: PixelData): number => {
+  if (original.width !== result.width || original.height !== result.height) return 1;
+  const { width: w, height: h } = original;
+  if (!w || !h) return 1;
+  const a = boxBlur(toGrey(original), w, h);
+  const b = boxBlur(toGrey(result), w, h);
+  let changed = 0;
+  for (let i = 0; i < a.length; i += 1) if (Math.abs(a[i] - b[i]) > CHANGE_THRESHOLD) changed += 1;
+  return changed / a.length;
+};
+
+export const sceneBucket = (fraction: number): SceneBucket => (fraction < LOW_BELOW ? "low" : fraction < MID_BELOW ? "mid" : "high");
+
+export interface SceneVerdict {
+  fraction: number;
+  bucket: SceneBucket;
+  /** Only in strict mode and only for high: the preview must not be shown. */
+  blocked: boolean;
+  /** How long the check took on this phone. */
+  ms: number;
+}
+
+export const sceneVerdict = (fraction: number, mode: SceneGuardMode = SCENE_GUARD_MODE, ms = 0): SceneVerdict => {
+  const bucket = sceneBucket(fraction);
+  return { fraction, bucket, blocked: mode === "strict" && bucket === "high", ms };
+};
+
+const now = () => (typeof performance !== "undefined" ? performance.now() : Date.now());
+
+const guardPixels = async (blob: Blob): Promise<PixelData | null> => {
+  const decoded = await decodeImage(blob);
+  const surface = createSurface(GUARD_WIDTH, GUARD_HEIGHT);
+  try {
+    if (!surface) return null;
+    surface.ctx.imageSmoothingEnabled = true;
+    if ("imageSmoothingQuality" in surface.ctx) surface.ctx.imageSmoothingQuality = "high";
+    surface.ctx.drawImage(decoded.image, 0, 0, GUARD_WIDTH, GUARD_HEIGHT);
+    return surface.ctx.getImageData(0, 0, GUARD_WIDTH, GUARD_HEIGHT);
+  } finally {
+    decoded.close();
+    surface?.release();
+  }
+};
+
+/**
+ * Compares the shopper's photo with the preview. Null when this browser
+ * cannot run it; it never throws, because a missing check must not cost the
+ * shopper her preview in 'log' mode.
+ */
+export const sceneGuard = async (original: Blob, result: Blob, mode: SceneGuardMode = SCENE_GUARD_MODE): Promise<SceneVerdict | null> => {
+  const started = now();
+  try {
+    const [a, b] = await Promise.all([guardPixels(original), guardPixels(result)]);
+    if (!a || !b) return null;
+    return sceneVerdict(changedFraction(a, b), mode, Math.round(now() - started));
+  } catch {
+    return null;
+  }
+};
diff --git a/src/lib/tryon/session.ts b/src/lib/tryon/session.ts
new file mode 100644
index 0000000..ddc6dbe
--- /dev/null
+++ b/src/lib/tryon/session.ts
@@ -0,0 +1,275 @@
+/*
+  The try-on's memory for one browser tab: the shopper's prepared photo (one
+  face photo for every face piece, one hand photo for every hand piece) and
+  each preview made from it, keyed "handle:stone", so going back or trying a
+  piece again never spends another of today's try-ons.
+
+  Held in this module only, never in storage: a photo or a preview is a blob
+  shown through a blob: URL, and every URL made here is revoked when the
+  session clears, which it does on Delete photo, when the page is hidden for
+  good (pagehide), and after 30 minutes without use. What does reach storage
+  is small and never an image: the handles tried this tab (for the order's
+  naira_tryon attribute) and the consent notice version (sessionStorage).
+*/
+
+export type PhotoKind = "face" | "hand";
+export type TryOnVerified = "pass" | "log" | "off";
+
+export const IDLE_MS = 30 * 60 * 1000;
+export const TRIED_KEY = "naira_tryon";
+export const CONSENT_KEY = "naira_tryon_consent";
+/** The notice version the shopper agreed to; the server accepts only this one. */
+export const CONSENT_VERSION = "tryon-2026-11";
+/** The longest naira_tryon value: Shopify keeps cart attributes short. */
+export const TRIED_MAX = 200;
+
+export interface SessionPhoto {
+  kind: PhotoKind;
+  blob: Blob;
+  url: string;
+  width: number;
+  height: number;
+}
+
+export interface SessionResult {
+  handle: string;
+  stone: string | null;
+  kind: PhotoKind;
+  blob: Blob;
+  url: string;
+  renderId: string | null;
+  verified: TryOnVerified | null;
+}
+
+const urls = new Set<string>();
+const photos = new Map<PhotoKind, SessionPhoto>();
+const results = new Map<string, SessionResult>();
+const listeners = new Set<() => void>();
+let lastUsed = 0;
+let idleTimer: ReturnType<typeof setTimeout> | undefined;
+let listening = false;
+let inFlight: AbortController | null = null;
+
+const mint = (blob: Blob) => {
+  const url = URL.createObjectURL(blob);
+  urls.add(url);
+  return url;
+};
+
+const revoke = (url: string) => {
+  if (!urls.delete(url)) return;
+  try {
+    URL.revokeObjectURL(url);
+  } catch {
+    /* already gone */
+  }
+};
+
+const expired = () => lastUsed > 0 && Date.now() - lastUsed >= IDLE_MS;
+
+const onVisible = () => {
+  // Timers in a background tab can run late; a return after 30 minutes clears at once.
+  if (document.visibilityState === "visible" && expired()) clearTryOnSession();
+};
+
+const listen = () => {
+  if (listening || typeof window === "undefined") return;
+  listening = true;
+  window.addEventListener("pagehide", clearTryOnSession);
+  document.addEventListener("visibilitychange", onVisible);
+};
+
+/** Marks the session as in use, restarting the 30-minute idle clock. */
+export const touchTryOnSession = () => {
+  if (!photos.size && !results.size && !urls.size) return;
+  lastUsed = Date.now();
+  if (idleTimer !== undefined) clearTimeout(idleTimer);
+  idleTimer = setTimeout(clearTryOnSession, IDLE_MS);
+};
+
+const fresh = () => {
+  if (expired()) clearTryOnSession();
+};
+
+export const resultKey = (handle: string, stone?: string | null) => `${handle}:${stone ?? "default"}`;
+
+/** Keeps the prepared photo for its kind, replacing (and revoking) the last one and the previews made from it. */
+export const setTryOnPhoto = (kind: PhotoKind, blob: Blob, size: { width: number; height: number }): SessionPhoto => {
+  fresh();
+  listen();
+  const prior = photos.get(kind);
+  if (prior) revoke(prior.url);
+  for (const [key, result] of results) {
+    if (result.kind === kind) {
+      revoke(result.url);
+      results.delete(key);
+    }
+  }
+  const photo: SessionPhoto = { kind, blob, url: mint(blob), width: size.width, height: size.height };
+  photos.set(kind, photo);
+  touchTryOnSession();
+  return photo;
+};
+
+/** The photo this tab holds for a kind, if any. */
+export const getTryOnPhoto = (kind: PhotoKind): SessionPhoto | undefined => {
+  fresh();
+  const photo = photos.get(kind);
+  if (photo) touchTryOnSession();
+  return photo;
+};
+
+/** Keeps a preview for a piece and stone, replacing any earlier one. */
+export const setTryOnResult = (
+  handle: string,
+  stone: string | null,
+  kind: PhotoKind,
+  reply: { blob: Blob; renderId: string | null; verified: TryOnVerified | null },
+): SessionResult => {
+  fresh();
+  listen();
+  const key = resultKey(handle, stone);
+  const prior = results.get(key);
+  if (prior) revoke(prior.url);
+  const result: SessionResult = { handle, stone, kind, blob: reply.blob, url: mint(reply.blob), renderId: reply.renderId, verified: reply.verified };
+  results.set(key, result);
+  touchTryOnSession();
+  return result;
+};
+
+/** A preview already made this tab for a piece and stone. */
+export const getTryOnResult = (handle: string, stone?: string | null): SessionResult | undefined => {
+  fresh();
+  const result = results.get(resultKey(handle, stone));
+  if (result) touchTryOnSession();
+  return result;
+};
+
+/** Every preview held, for the "Try another piece" rail's badges. */
+export const tryOnResults = (): SessionResult[] => {
+  fresh();
+  return Array.from(results.values());
+};
+
+/**
+ * A blob: URL for something made from the photo or a preview (the share
+ * image, the press-and-hold save view). It is revoked with everything else
+ * when the session clears, or earlier through releaseObjectUrl.
+ */
+export const adoptObjectUrl = (blob: Blob): string => {
+  listen();
+  const url = mint(blob);
+  touchTryOnSession();
+  return url;
+};
+
+export const releaseObjectUrl = (url: string) => revoke(url);
+
+/** How many blob: URLs this session has made and not yet revoked. */
+export const liveObjectUrlCount = () => urls.size;
+
+/**
+ * One render per tab: registers a render's AbortController, aborting any
+ * render still running. Returns the call that releases it when it ends.
+ */
+export const trackRender = (controller: AbortController): (() => void) => {
+  if (inFlight && inFlight !== controller) inFlight.abort();
+  inFlight = controller;
+  return () => {
+    if (inFlight === controller) inFlight = null;
+  };
+};
+
+export const renderInFlight = () => inFlight !== null && !inFlight.signal.aborted;
+
+/** Called whenever the session clears (Delete, pagehide, idle), so a screen can reset. */
+export const onTryOnSessionCleared = (listener: () => void): (() => void) => {
+  listeners.add(listener);
+  return () => {
+    listeners.delete(listener);
+  };
+};
+
+/** Forgets the photos and previews, aborts a running render and revokes every URL. */
+export function clearTryOnSession() {
+  if (inFlight) {
+    inFlight.abort();
+    inFlight = null;
+  }
+  for (const url of Array.from(urls)) revoke(url);
+  photos.clear();
+  results.clear();
+  lastUsed = 0;
+  if (idleTimer !== undefined) {
+    clearTimeout(idleTimer);
+    idleTimer = undefined;
+  }
+  for (const listener of Array.from(listeners)) {
+    try {
+      listener();
+    } catch {
+      /* a screen's reset must not stop the others */
+    }
+  }
+}
+
+const session = (): Storage | null => {
+  try {
+    return window.sessionStorage;
+  } catch {
+    return null;
+  }
+};
+
+const HANDLE = /^[a-z0-9-]+$/;
+
+/** The handles tried this tab, oldest first. */
+export const triedHandles = (): string[] => {
+  try {
+    return (session()?.getItem(TRIED_KEY) ?? "").split(",").filter((h) => HANDLE.test(h));
+  } catch {
+    return [];
+  }
+};
+
+/** Records a handle as tried this tab, for the order's naira_tryon attribute (200 characters at most). */
+export const markTried = (handle: string) => {
+  if (!HANDLE.test(handle)) return;
+  const tried = triedHandles();
+  if (tried.includes(handle)) return;
+  const value = [...tried, handle].join(",");
+  if (value.length > TRIED_MAX) return;
+  try {
+    session()?.setItem(TRIED_KEY, value);
+  } catch {
+    /* storage full or blocked: only the attribute is lost */
+  }
+};
+
+/* Where sessionStorage is blocked, consent holds for the page instead. */
+let consentInMemory = false;
+
+/** Whether the shopper agreed to the current notice in this tab. */
+export const hasTryOnConsent = () => {
+  if (consentInMemory) return true;
+  try {
+    return session()?.getItem(CONSENT_KEY) === CONSENT_VERSION;
+  } catch {
+    return false;
+  }
+};
+
+/** Records consent for this tab, so a second piece does not ask again. */
+export const recordTryOnConsent = () => {
+  consentInMemory = true;
+  try {
+    session()?.setItem(CONSENT_KEY, CONSENT_VERSION);
+  } catch {
+    /* held in memory for this page */
+  }
+};
+
+/** Test seam: forgets consent held in memory. */
+export const resetTryOnConsentForTest = () => {
+  consentInMemory = false;
+};
diff --git a/src/lib/tryon/share.ts b/src/lib/tryon/share.ts
