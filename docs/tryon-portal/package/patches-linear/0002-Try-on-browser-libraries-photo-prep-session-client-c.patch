+import { describe, expect, it } from "vitest";
+import {
+  clampCrop,
+  FRAME_ASPECT,
+  imageTransform,
+  initialCrop,
+  isTooSmall,
+  maxCrop,
+  MIN_CROP_SHORT,
+  outputSize,
+  panCrop,
+  zoomCrop,
+} from "@/lib/tryon/cropMaths";
+
+const ratio = (r: { width: number; height: number }) => r.width / r.height;
+
+describe("try-on crop frame", () => {
+  /* The server refuses anything but 3:4 within 2%: a frame off by a pixel or
+     two of rounding must still be inside that, for every photo shape. */
+  it.each([
+    ["landscape 4000x3000", 4000, 3000, { x: 875, y: 0, width: 2250, height: 3000 }],
+    ["portrait 3000x4000", 3000, 4000, { x: 0, y: 0, width: 3000, height: 4000 }],
+    ["square 2000x2000", 2000, 2000, { x: 250, y: 0, width: 1500, height: 2000 }],
+    ["tall 1080x2400", 1080, 2400, { x: 0, y: 480, width: 1080, height: 1440 }],
+  ])("opens a centred 3:4 frame on a %s photo", (_, width, height, expected) => {
+    const crop = initialCrop({ width, height });
+    expect(crop).toEqual(expected);
+    expect(Math.abs(ratio(crop) - FRAME_ASPECT)).toBeLessThan(0.0075);
+  });
+
+  it("keeps every frame 3:4 within the server's 2% for odd sizes", () => {
+    for (const [w, h] of [
+      [1001, 1000],
+      [1000, 1337],
+      [3024, 4032],
+      [4032, 3024],
+      [769, 4000],
+      [12345, 777],
+    ]) {
+      const crop = initialCrop({ width: w, height: h });
+      expect(Math.abs(ratio(crop) / FRAME_ASPECT - 1)).toBeLessThan(0.02);
+      expect(crop.x + crop.width).toBeLessThanOrEqual(w);
+      expect(crop.y + crop.height).toBeLessThanOrEqual(h);
+    }
+  });
+
+  it("zooms about the centre and never below the smallest frame worth sending", () => {
+    const src = { width: 3000, height: 4000 };
+    const zoomed = zoomCrop(initialCrop(src), 2, src);
+    expect(zoomed.width).toBe(1500);
+    expect(zoomed.x).toBe(750);
+    expect(zoomed.y).toBe(1000);
+    const far = zoomCrop(zoomed, 10, src);
+    expect(far.width).toBe(MIN_CROP_SHORT);
+    expect(isTooSmall(far)).toBe(false);
+    expect(zoomCrop(far, 0.01, src)).toEqual(initialCrop(src));
+  });
+
+  it("moves the frame against the drag, at the frame's own scale, and stops at the edges", () => {
+    const src = { width: 4000, height: 3000 };
+    const crop = initialCrop(src); // 2250 wide on a 300 px frame: 7.5 source px per screen px
+    expect(panCrop(crop, 20, 0, 300, src).x).toBe(875 - 150);
+    expect(panCrop(crop, -20, 0, 300, src).x).toBe(875 + 150);
+    // dragged far right: the frame stops at the photo's left edge
+    expect(panCrop(crop, 10_000, 0, 300, src).x).toBe(0);
+    expect(panCrop(crop, -10_000, 0, 300, src).x).toBe(4000 - 2250);
+    // a full-height frame cannot move up or down
+    expect(panCrop(crop, 0, 500, 300, src).y).toBe(0);
+  });
+
+  it("clamps a frame pushed outside the photo back inside", () => {
+    const src = { width: 3000, height: 4000 };
+    expect(clampCrop({ x: -50, y: 3900, width: 1500, height: 2000 }, src)).toEqual({ x: 0, y: 2000, width: 1500, height: 2000 });
+    expect(maxCrop(src)).toEqual({ width: 3000, height: 4000 });
+  });
+
+  /* A frame under 768 px wide is stretched past 1.5x to fill 1152: too soft to place a 12 mm piece on. */
+  it("calls a frame with a short side under 768 too small", () => {
+    expect(isTooSmall({ width: 767, height: 1023 })).toBe(true);
+    expect(isTooSmall({ width: 768, height: 1024 })).toBe(false);
+    expect(isTooSmall(initialCrop({ width: 600, height: 800 }))).toBe(true);
+    expect(isTooSmall(initialCrop({ width: 1024, height: 768 }))).toBe(true); // a 576 px wide frame
+  });
+
+  it("always draws the photo at 1152x1536", () => {
+    expect(outputSize()).toEqual({ width: 1152, height: 1536 });
+  });
+
+  it("places the photo under the frame with CSS", () => {
+    const t = imageTransform({ x: 875, y: 0, width: 2250, height: 3000 }, 300);
+    expect(t.scale).toBeCloseTo(300 / 2250);
+    expect(t.x).toBeCloseTo(-875 * (300 / 2250));
+    expect(t.y).toBeCloseTo(0);
+  });
+});
