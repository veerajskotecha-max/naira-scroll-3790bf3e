+++ b/src/lib/tryon/errors.ts
@@ -0,0 +1,173 @@
+import { TRYON_COPY, TRYON_DAILY_ALLOWANCE } from "./copy";
+
+/*
+  Every way a try-on can stop, as one typed error with its words and its next
+  step. The server's codes and reasons are the contract in the spec's api
+  section; anything the server did not name (a proxy's HTML page, an unknown
+  code) is mapped by HTTP status instead, and nothing the server or the model
+  wrote is ever shown: a shopper only ever reads TRYON_COPY.
+*/
+
+export const SERVER_ERROR_CODES = [
+  "bad_request",
+  "origin",
+  "challenge",
+  "too_large",
+  "not_jpeg",
+  "photo_unusable",
+  "fidelity_failed",
+  "device_limit",
+  "ip_limit",
+  "busy",
+  "paused",
+  "timeout",
+  "failed",
+] as const;
+
+/** Raised in the browser: no connection, a failed upload, the shopper's Cancel, a tab left in the background. */
+export const CLIENT_ERROR_CODES = ["offline", "network", "cancelled", "interrupted"] as const;
+
+export const PHOTO_UNUSABLE_REASONS = [
+  "ear_not_visible",
+  "neck_not_visible",
+  "hand_not_visible",
+  "wrist_not_visible",
+  "multiple_people",
+  "no_person",
+  "under_18",
+  "not_a_photo",
+  "blocked",
+  "too_dark",
+  "too_blurry",
+  "model_declined",
+] as const;
+
+export const PAUSED_REASONS = ["off", "not_configured", "daily_cap", "credits", "piece_unavailable"] as const;
+
+export type ServerErrorCode = (typeof SERVER_ERROR_CODES)[number];
+export type ClientErrorCode = (typeof CLIENT_ERROR_CODES)[number];
+export type TryOnErrorCode = ServerErrorCode | ClientErrorCode;
+export type PhotoUnusableReason = (typeof PHOTO_UNUSABLE_REASONS)[number];
+export type PausedReason = (typeof PAUSED_REASONS)[number];
+export type TryOnErrorReason = PhotoUnusableReason | PausedReason;
+
+/** What the error's button does. */
+export type ErrorAction = "choose_photo" | "view_piece" | "try_again";
+
+export interface ErrorCopy {
+  message: string;
+  /** The main button, or null when the screen simply returns to the photo (Cancel). */
+  action: ErrorAction | null;
+  secondary?: ErrorAction;
+}
+
+export const actionLabel = (action: ErrorAction) => TRYON_COPY.actions[action];
+
+const STATUS_CODE: Record<number, ServerErrorCode> = {
+  400: "bad_request",
+  403: "origin",
+  413: "too_large",
+  415: "not_jpeg",
+  422: "photo_unusable",
+  429: "busy",
+  503: "paused",
+  504: "timeout",
+};
+
+const isServerCode = (code: unknown): code is ServerErrorCode => SERVER_ERROR_CODES.includes(code as ServerErrorCode);
+
+/** The server refunds these, so they do not use one of today's try-ons. */
+const REFUNDED = new Set<TryOnErrorCode>(["photo_unusable", "fidelity_failed", "busy", "paused", "timeout"]);
+
+/** The words and buttons for a code and reason. */
+export const errorCopy = (code: TryOnErrorCode, reason?: string | null): ErrorCopy => {
+  const e = TRYON_COPY.errors;
+  switch (code) {
+    case "photo_unusable": {
+      const known = PHOTO_UNUSABLE_REASONS.includes(reason as PhotoUnusableReason) ? (reason as PhotoUnusableReason) : "model_declined";
+      return { message: e.photo_unusable[known], action: "choose_photo" };
+    }
+    case "fidelity_failed":
+      return { message: e.fidelity_failed, action: "choose_photo", secondary: "view_piece" };
+    case "device_limit":
+      return { message: e.device_limit(TRYON_DAILY_ALLOWANCE), action: "view_piece" };
+    case "ip_limit":
+      return { message: e.ip_limit, action: "view_piece" };
+    case "busy":
+      return { message: e.busy, action: "try_again" };
+    case "paused":
+      return { message: e.paused, action: "view_piece" };
+    case "timeout":
+      return { message: e.timeout, action: "try_again" };
+    case "offline":
+      return { message: e.offline, action: "try_again" };
+    case "interrupted":
+      return { message: e.interrupted, action: "try_again" };
+    case "cancelled":
+      return { message: TRYON_COPY.cancelled, action: null };
+    // bad_request, origin, challenge, too_large, not_jpeg, failed and network: nothing the shopper did.
+    default:
+      return { message: e.failed, action: "try_again" };
+  }
+};
+
+/** A reason the contract defines for the code; an unknown photo_unusable reason reads as model_declined. */
+const knownReason = (code: TryOnErrorCode, reason?: string | null): TryOnErrorReason | undefined => {
+  const reasons: readonly string[] = code === "photo_unusable" ? PHOTO_UNUSABLE_REASONS : code === "paused" ? PAUSED_REASONS : [];
+  if (reason && reasons.includes(reason)) return reason as TryOnErrorReason;
+  return code === "photo_unusable" ? "model_declined" : undefined;
+};
+
+export interface TryOnErrorInit {
+  status?: number;
+  reason?: string | null;
+  resetAt?: string;
+  retryAfter?: number;
+  retryable?: boolean;
+}
+
+/** A try-on that did not return a preview: code, reason, the words to show and what the button does. */
+export class TryOnError extends Error {
+  readonly code: TryOnErrorCode;
+  readonly reason?: TryOnErrorReason;
+  /** HTTP status, 0 when the request never got an answer. */
+  readonly status: number;
+  /** Next midnight in India (ISO), for the daily limits. */
+  readonly resetAt?: string;
+  readonly retryAfter?: number;
+  readonly retryable: boolean;
+  /** Whether the server gave the try-on back (it does not count against today's). */
+  readonly refunded: boolean;
+  readonly copy: ErrorCopy;
+  constructor(code: TryOnErrorCode, init: TryOnErrorInit = {}) {
+    const reason = knownReason(code, init.reason);
+    // Only the contract's own words reach the message: a reason the server did not define is dropped.
+    super(`tryon: ${code}${reason ? ` (${reason})` : ""}`);
+    this.name = "TryOnError";
+    this.code = code;
+    this.reason = reason;
+    this.status = init.status ?? 0;
+    this.resetAt = typeof init.resetAt === "string" && !Number.isNaN(Date.parse(init.resetAt)) ? init.resetAt : undefined;
+    this.retryAfter = typeof init.retryAfter === "number" && Number.isFinite(init.retryAfter) ? init.retryAfter : undefined;
+    this.retryable = init.retryable ?? ["busy", "timeout", "failed", "network", "offline", "interrupted", "cancelled"].includes(code);
+    this.refunded = REFUNDED.has(code);
+    this.copy = errorCopy(code, this.reason);
+  }
+}
+
+/**
+ * The error for a non-200 reply: its JSON code when it names one the contract
+ * knows, else the code its HTTP status implies (500 and anything unlisted:
+ * failed). Only fields the contract defines are read.
+ */
+export const errorFromResponse = (status: number, body: unknown): TryOnError => {
+  const b = body && typeof body === "object" ? (body as Record<string, unknown>) : {};
+  const code = isServerCode(b.code) ? b.code : STATUS_CODE[status] ?? "failed";
+  return new TryOnError(code, {
+    status,
+    reason: typeof b.reason === "string" ? b.reason : undefined,
+    resetAt: typeof b.resetAt === "string" ? b.resetAt : undefined,
+    retryAfter: typeof b.retryAfter === "number" ? b.retryAfter : undefined,
+    retryable: typeof b.retryable === "boolean" ? b.retryable : undefined,
+  });
+};
diff --git a/src/lib/tryon/photoChecks.ts b/src/lib/tryon/photoChecks.ts
