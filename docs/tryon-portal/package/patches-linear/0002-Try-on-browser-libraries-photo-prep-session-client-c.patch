index 0000000..d424f45
--- /dev/null
+++ b/src/test/tryon/client.test.ts
@@ -0,0 +1,317 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { z } from "zod";
+import { TRY_ON_HANDLES } from "@/data/tryOnHandles";
+import { buildTryOnMeta, requestTryOn, sendFeedback, TRYON_TIMEOUT_MS, tryOnEndpoint, tryOnHeaders } from "@/lib/tryon/client";
+import { TryOnError } from "@/lib/tryon/errors";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { resetTryOnDeviceForTest } from "@/lib/tryon/device";
+
+/* The server's strict meta schema, as the spec's api section writes it: any
+   other key (prompt, model, reference, image_url) is a 400. */
+const Meta = z
+  .object({
+    v: z.literal(1),
+    handle: z.enum([...TRY_ON_HANDLES] as [string, ...string[]]),
+    stone: z.enum(["Ruby", "Crystal", "Emerald", "Amethyst"]).nullable(),
+    kind: z.enum(["face", "hand"]),
+    device: z.string().uuid(),
+    consent: z
+      .object({ version: z.literal("tryon-2026-11"), accepted: z.literal(true), adult: z.literal(true), ownPhoto: z.literal(true) })
+      .strict(),
+    turnstile: z.string().max(2048).optional(),
+  })
+  .strict();
+
+class MockXHR {
+  static all: MockXHR[] = [];
+  method = "";
+  url = "";
+  headers: Record<string, string> = {};
+  responseType = "";
+  timeout = 0;
+  status = 0;
+  response: Blob | null = null;
+  responseHeaders: Record<string, string> = {};
+  body: FormData | null = null;
+  aborted = false;
+  upload: { onprogress: ((e: ProgressEvent) => void) | null; onload: (() => void) | null } = { onprogress: null, onload: null };
+  onload: (() => void) | null = null;
+  onerror: (() => void) | null = null;
+  ontimeout: (() => void) | null = null;
+  onabort: (() => void) | null = null;
+  constructor() {
+    MockXHR.all.push(this);
+  }
+  open(method: string, url: string) {
+    this.method = method;
+    this.url = url;
+  }
+  setRequestHeader(name: string, value: string) {
+    this.headers[name] = value;
+  }
+  getResponseHeader(name: string) {
+    const hit = Object.entries(this.responseHeaders).find(([k]) => k.toLowerCase() === name.toLowerCase());
+    return hit ? hit[1] : null;
+  }
+  send(body: FormData) {
+    this.body = body;
+  }
+  abort() {
+    this.aborted = true;
+    this.onabort?.();
+  }
+  progress(loaded: number, total: number) {
+    this.upload.onprogress?.({ lengthComputable: true, loaded, total } as ProgressEvent);
+  }
+  uploaded() {
+    this.upload.onload?.();
+  }
+  respond(status: number, body: Blob | null, headers: Record<string, string> = {}) {
+    this.status = status;
+    this.response = body;
+    this.responseHeaders = headers;
+    this.onload?.();
+  }
+}
+
+const last = () => MockXHR.all[MockXHR.all.length - 1];
+const photo = () => new Blob([new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 0, 0x10, 0xff, 0xd9])], { type: "image/jpeg" });
+const json = (body: unknown) => new Blob([JSON.stringify(body)], { type: "application/json" });
+const PNG = new Blob([new Uint8Array([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, 1, 2, 3])], { type: "image/png" });
+const RENDER_ID = "6f1c2b8e-3a4d-4e5f-9a6b-7c8d9e0f1a2b";
+const request = (extra: Partial<Parameters<typeof requestTryOn>[0]> = {}) =>
+  requestTryOn({ handle: "baguette-huggies", stone: "Ruby", kind: "face", photo: photo(), ...extra });
+
+const formEntries = (form: FormData) => {
+  const out: Array<[string, FormDataEntryValue]> = [];
+  form.forEach((value, key) => out.push([key, value]));
+  return out;
+};
+
+beforeEach(() => {
+  MockXHR.all = [];
+  vi.stubGlobal("XMLHttpRequest", MockXHR);
+  window.localStorage.clear();
+  resetTryOnDeviceForTest();
+});
+
+afterEach(() => {
+  vi.unstubAllGlobals();
+  vi.restoreAllMocks();
+  vi.useRealTimers();
+});
+
+describe("try-on request", () => {
+  it("posts multipart with only 'meta' and 'photo', and the meta passes the server's strict schema", async () => {
+    const pending = request();
+    const xhr = last();
+    expect(xhr.method).toBe("POST");
+    expect(xhr.url).toBe(`${import.meta.env.VITE_SUPABASE_URL}/functions/v1/tryon/render`);
+    expect(xhr.url).toBe(tryOnEndpoint("render"));
+    expect(xhr.responseType).toBe("blob");
+    const entries = formEntries(xhr.body as FormData);
+    expect(entries.map(([k]) => k)).toEqual(["meta", "photo"]);
+    const metaText = entries[0][1] as string;
+    expect(typeof metaText).toBe("string");
+    expect(metaText.length).toBeLessThanOrEqual(1024);
+    const meta = Meta.parse(JSON.parse(metaText));
+    expect(meta).toMatchObject({ v: 1, handle: "baguette-huggies", stone: "Ruby", kind: "face" });
+    expect(meta.device).toBe(window.localStorage.getItem("naira_tryon_device"));
+    const part = entries[1][1] as File;
+    expect(part.type).toBe("image/jpeg");
+    xhr.respond(200, PNG, { "Content-Type": "image/png" });
+    await pending;
+  });
+
+  it("builds a valid meta for every handle, with a null stone for single-stone pieces", () => {
+    for (const handle of TRY_ON_HANDLES) {
+      expect(() => Meta.parse(buildTryOnMeta({ handle, stone: null, kind: "face" }))).not.toThrow();
+    }
+    expect(() => buildTryOnMeta({ handle: "not-a-piece", stone: null, kind: "face" })).toThrow(TryOnError);
+    expect(() => buildTryOnMeta({ handle: "baguette-huggies", stone: "Sapphire", kind: "face" })).toThrow(TryOnError);
+  });
+
+  /* The same headers pixel.ts sends to meta-capi: the publishable key on apikey and as Bearer. */
+  it("sends the publishable key as pixel.ts does, and no custom header", async () => {
+    const key = import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY;
+    const pending = request();
+    expect(last().headers).toEqual({ apikey: key, Authorization: `Bearer ${key}` });
+    expect(tryOnHeaders()).toEqual({ apikey: key, Authorization: `Bearer ${key}` });
+    const pixel = readFileSync(resolve(__dirname, "../../lib/pixel.ts"), "utf8");
+    expect(pixel).toContain("apikey: CAPI_KEY, Authorization: `Bearer ${CAPI_KEY}`");
+    expect(pixel).toContain("const CAPI_KEY = import.meta.env.VITE_SUPABASE_PUBLISHABLE_KEY");
+    last().respond(200, PNG, { "Content-Type": "image/png" });
+    await pending;
+  });
+
+  it("reports upload progress, then that the photo is up", async () => {
+    const onUpload = vi.fn();
+    const onUploaded = vi.fn();
+    const pending = request({ onUpload, onUploaded });
+    last().progress(0, 400_000);
+    last().progress(252_000, 400_000);
+    last().uploaded();
+    expect(onUpload).toHaveBeenCalledWith(0.63);
+    expect(onUpload).toHaveBeenLastCalledWith(1);
+    expect(onUploaded).toHaveBeenCalledTimes(1);
+    last().respond(200, PNG, { "Content-Type": "image/png" });
+    await pending;
+  });
+
+  it("returns the image as a Blob and reads X-Tryon-Remaining, X-Tryon-Verified and X-Tryon-Render", async () => {
+    const pending = request();
+    last().respond(200, PNG, { "Content-Type": "image/png", "X-Tryon-Remaining": "3", "X-Tryon-Verified": "pass", "X-Tryon-Render": RENDER_ID });
+    const reply = await pending;
+    expect(reply.blob).toBeInstanceOf(Blob);
+    expect(reply.blob.type).toBe("image/png");
+    expect(reply).toMatchObject({ remaining: 3, verified: "pass", renderId: RENDER_ID });
+    // No data: URL anywhere the UI could put in the DOM.
+    expect(JSON.stringify(reply)).not.toContain("data:");
+  });
+
+  it("ignores malformed headers rather than showing them", async () => {
+    const pending = request();
+    last().respond(200, PNG, { "Content-Type": "image/png", "X-Tryon-Remaining": "lots", "X-Tryon-Verified": "maybe", "X-Tryon-Render": "<script>" });
+    expect(await pending).toMatchObject({ remaining: null, verified: null, renderId: null });
+  });
+
+  it("treats a 200 that is not an image as a failure", async () => {
+    const pending = request();
+    last().respond(200, new Blob(["<html>"], { type: "text/html" }), { "Content-Type": "text/html" });
+    await expect(pending).rejects.toMatchObject({ code: "failed" });
+  });
+
+  /* Every status and code in the contract becomes a TryOnError with the spec's words. */
+  it.each([
+    [400, { code: "bad_request", retryable: false }, "bad_request", undefined, TRYON_COPY.errors.failed, "try_again"],
+    [403, { code: "origin", retryable: false }, "origin", undefined, TRYON_COPY.errors.failed, "try_again"],
+    [403, { code: "challenge", retryable: false }, "challenge", undefined, TRYON_COPY.errors.failed, "try_again"],
+    [413, { code: "too_large", retryable: false }, "too_large", undefined, TRYON_COPY.errors.failed, "try_again"],
+    [415, { code: "not_jpeg", retryable: false }, "not_jpeg", undefined, TRYON_COPY.errors.failed, "try_again"],
+    [422, { code: "photo_unusable", reason: "ear_not_visible", retryable: false }, "photo_unusable", "ear_not_visible", TRYON_COPY.errors.photo_unusable.ear_not_visible, "choose_photo"],
+    [422, { code: "photo_unusable", reason: "wrist_not_visible", retryable: false }, "photo_unusable", "wrist_not_visible", TRYON_COPY.errors.photo_unusable.wrist_not_visible, "choose_photo"],
+    [422, { code: "photo_unusable", reason: "something_new", retryable: false }, "photo_unusable", "model_declined", TRYON_COPY.errors.photo_unusable.model_declined, "choose_photo"],
+    [422, { code: "fidelity_failed", retryable: false }, "fidelity_failed", undefined, TRYON_COPY.errors.fidelity_failed, "choose_photo"],
+    [429, { code: "device_limit", resetAt: "2026-10-30T18:30:00.000Z", retryable: false }, "device_limit", undefined, TRYON_COPY.errors.device_limit(5), "view_piece"],
+    [429, { code: "ip_limit", resetAt: "2026-10-30T18:30:00.000Z", retryable: false }, "ip_limit", undefined, TRYON_COPY.errors.ip_limit, "view_piece"],
+    [429, { code: "busy", retryAfter: 60, retryable: true }, "busy", undefined, TRYON_COPY.errors.busy, "try_again"],
+    [503, { code: "paused", reason: "off", retryable: false }, "paused", "off", TRYON_COPY.errors.paused, "view_piece"],
+    [503, { code: "paused", reason: "credits", retryable: false }, "paused", "credits", TRYON_COPY.errors.paused, "view_piece"],
+    [503, { code: "paused", reason: "piece_unavailable", retryable: false }, "paused", "piece_unavailable", TRYON_COPY.errors.paused, "view_piece"],
+    [504, { code: "timeout", retryable: true }, "timeout", undefined, TRYON_COPY.errors.timeout, "try_again"],
+    [500, { code: "failed", retryable: true }, "failed", undefined, TRYON_COPY.errors.failed, "try_again"],
+  ])("maps %i %j to %s", async (status, body, code, reason, message, action) => {
+    const pending = request();
+    last().respond(status, json(body), { "Content-Type": "application/json" });
+    const error = await pending.catch((e) => e);
+    expect(error).toBeInstanceOf(TryOnError);
+    expect(error.code).toBe(code);
+    expect(error.status).toBe(status);
+    expect(error.reason).toBe(reason);
+    expect(error.copy.message).toBe(message);
+    expect(error.copy.action).toBe(action);
+    if ("resetAt" in body) expect(error.resetAt).toBe(body.resetAt);
+    if ("retryAfter" in body) expect(error.retryAfter).toBe(60);
+  });
+
+  it.each([
+    [413, "too_large"],
+    [415, "not_jpeg"],
+    [429, "busy"],
+    [502, "failed"],
+    [503, "paused"],
+    [504, "timeout"],
+  ])("maps a %i with no JSON body (a proxy's page) by its status to %s", async (status, code) => {
+    const pending = request();
+    last().respond(status, new Blob(["<html>Bad gateway</html>"], { type: "text/html" }));
+    await expect(pending).rejects.toMatchObject({ code });
+  });
+
+  it("never shows text the server or the model wrote", async () => {
+    const pending = request();
+    last().respond(422, json({ code: "photo_unusable", reason: "I cannot help with this image of a person", message: "MODEL SAID THIS", retryable: false }));
+    const error: TryOnError = await pending.catch((e) => e);
+    expect(JSON.stringify({ ...error, copy: error.copy, message: error.message })).not.toMatch(/MODEL SAID|cannot help/);
+  });
+
+  /* The server gives up at 118 s; the phone stops waiting at 125 s whatever the network does. */
+  it("aborts after 125 seconds", async () => {
+    vi.useFakeTimers();
+    const pending = request();
+    const xhr = last();
+    expect(xhr.timeout).toBe(TRYON_TIMEOUT_MS);
+    vi.advanceTimersByTime(TRYON_TIMEOUT_MS - 1);
+    expect(xhr.aborted).toBe(false);
+    vi.advanceTimersByTime(1);
+    const error = await pending.catch((e) => e);
+    expect(error.code).toBe("timeout");
+    expect(error.copy.message).toBe(TRYON_COPY.errors.timeout);
+    expect(xhr.aborted).toBe(true);
+  });
+
+  it("cancels on the shopper's Cancel", async () => {
+    const controller = new AbortController();
+    const pending = request({ signal: controller.signal });
+    controller.abort();
+    const error = await pending.catch((e) => e);
+    expect(error.code).toBe("cancelled");
+    expect(error.copy.message).toBe(TRYON_COPY.cancelled);
+    expect(last().aborted).toBe(true);
+  });
+
+  it("says offline without sending when the phone is offline", async () => {
+    vi.spyOn(navigator, "onLine", "get").mockReturnValue(false);
+    const error = await request().catch((e) => e);
+    expect(error.code).toBe("offline");
+    expect(MockXHR.all).toHaveLength(0);
+  });
+
+  it("calls a network error before any upload 'offline', and after it 'network'", async () => {
+    let pending = request();
+    last().onerror?.();
+    expect((await pending.catch((e) => e)).code).toBe("offline");
+    pending = request();
+    last().progress(100_000, 400_000);
+    last().onerror?.();
+    const error = await pending.catch((e) => e);
+    expect(error.code).toBe("network");
+    expect(error.copy.message).toBe(TRYON_COPY.errors.failed);
+  });
+
+  it("calls a failure after the tab went to the background 'interrupted'", async () => {
+    const pending = request();
+    last().progress(400_000, 400_000);
+    const state = vi.spyOn(document, "visibilityState", "get").mockReturnValue("hidden");
+    document.dispatchEvent(new Event("visibilitychange"));
+    state.mockReturnValue("visible");
+    last().onerror?.();
+    const error = await pending.catch((e) => e);
+    expect(error.code).toBe("interrupted");
+    expect(error.copy.message).toBe(TRYON_COPY.errors.interrupted);
+  });
+});
+
+describe("try-on feedback", () => {
+  it("posts the strict feedback body with keepalive, and never throws", () => {
+    const fetch = vi.fn(() => Promise.reject(new Error("offline")));
+    vi.stubGlobal("fetch", fetch);
+    sendFeedback(RENDER_ID, { looksRight: false, scene: "low" });
+    expect(fetch).toHaveBeenCalledTimes(1);
+    const [url, init] = fetch.mock.calls[0] as unknown as [string, RequestInit];
+    expect(url).toBe(tryOnEndpoint("feedback"));
+    expect(init.keepalive).toBe(true);
+    expect(init.headers).toMatchObject({ "Content-Type": "application/json", ...tryOnHeaders() });
+    expect(JSON.parse(init.body as string)).toEqual({ v: 1, render: RENDER_ID, looksRight: false, scene: "low" });
+    expect((init.body as string).length).toBeLessThanOrEqual(512);
+  });
+
+  it("sends nothing without a real render id", () => {
+    const fetch = vi.fn();
+    vi.stubGlobal("fetch", fetch);
+    sendFeedback("", { looksRight: true, scene: null });
+    sendFeedback("not-a-uuid", { looksRight: true, scene: null });
+    expect(fetch).not.toHaveBeenCalled();
+  });
+});
