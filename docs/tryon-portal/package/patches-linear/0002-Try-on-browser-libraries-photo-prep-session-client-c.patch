+++ b/src/test/tryon/oneTapLine.test.ts
@@ -0,0 +1,138 @@
+import { describe, expect, it } from "vitest";
+import { jewellery, type JewelPiece } from "@/data/jewellery";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { TRY_ON_HANDLES } from "@/data/tryOnHandles";
+import { oneTapLine, sizeChoices } from "@/lib/oneTapLine";
+import { cardCover } from "@/lib/cardCover";
+
+/* Against the shop's own first-paint data for the 20 try-on pieces: the
+   hand-authored catalogue, then the generated snapshot (as the PDP reads them). */
+const piece = (handle: string): JewelPiece => {
+  const found = jewellery.find((p) => p.handle === handle) ?? jewellerySnapshot.find((p) => p.handle === handle);
+  if (!found) throw new Error(`no first-paint data for ${handle}`);
+  return found;
+};
+
+const STONE_PIECES = new Set(["baguette-huggies", "baguette-eternity-band", "baguette-tennis-bracelet"]);
+
+describe("oneTapLine on the 20 try-on pieces", () => {
+  it("has first-paint data for every try-on handle", () => {
+    expect(TRY_ON_HANDLES.size).toBe(20);
+    for (const handle of TRY_ON_HANDLES) expect(piece(handle).handle).toBe(handle);
+  });
+
+  /* The bag line's photo is always the product photo, never the try-on image. */
+  it("adds each single-variant piece as it is, with its product photo", () => {
+    for (const handle of TRY_ON_HANDLES) {
+      if (STONE_PIECES.has(handle)) continue;
+      const p = piece(handle);
+      const result = oneTapLine(p, {});
+      expect([handle, "line" in result]).toEqual([handle, true]);
+      if (!("line" in result)) continue;
+      expect(result.line.variantId).toBe(p.variantId);
+      expect(result.line.image).toBe(cardCover(p));
+      expect(result.line.image).toMatch(/^https:\/\/cdn\.shopify\.com\//);
+      expect(result.line.id).toBe(handle);
+    }
+  });
+
+  it("adds the chosen Stone of a colour piece, and names it", () => {
+    const huggies = piece("baguette-huggies");
+    for (const stone of ["Ruby", "Crystal", "Emerald", "Amethyst"]) {
+      const result = oneTapLine(huggies, { Stone: stone });
+      const variant = huggies.variants!.find((v) => v.options.Stone === stone)!;
+      expect(result).toMatchObject({ line: { variantId: variant.id, selectedOptions: [{ name: "Stone", value: stone }] }, variant: { id: variant.id } });
+    }
+    const bracelet = piece("baguette-tennis-bracelet");
+    const ruby = bracelet.variants!.find((v) => v.options.Stone === "Ruby")!;
+    expect(oneTapLine(bracelet, { Stone: "Ruby" })).toMatchObject({ line: { variantId: ruby.id } });
+  });
+
+  it("names the variant it falls back to when the stone asked for is not sold", () => {
+    const huggies = piece("baguette-huggies");
+    const result = oneTapLine(huggies, { Stone: "Sapphire" });
+    if (!("line" in result)) throw new Error("expected a line");
+    expect(result.line.variantId).toBe(result.variant!.id);
+    expect(huggies.options![0].values).toContain(result.variant!.options.Stone);
+  });
+
+  it("asks for a size before the Eternity Band can be added", () => {
+    const band = piece("baguette-eternity-band");
+    expect(oneTapLine(band, {})).toEqual({ need: "size" });
+    expect(oneTapLine(band, { Stone: "Ruby" })).toEqual({ need: "size" });
+  });
+
+  it("adds the Eternity Band in the stone and size chosen (Ruby US 7)", () => {
+    const band = piece("baguette-eternity-band");
+    const ruby7 = band.variants!.find((v) => v.options.Stone === "Ruby" && v.options.Size === "7")!;
+    expect(ruby7.availableForSale).toBe(true);
+    const result = oneTapLine(band, { Stone: "Ruby", Size: "7" });
+    expect(result).toMatchObject({
+      line: { variantId: ruby7.id, selectedOptions: [{ name: "Stone", value: "Ruby" }, { name: "Size", value: "7" }] },
+    });
+    if ("line" in result) expect(result.line.size).toBeUndefined(); // the size is the variant, not a note
+  });
+
+  /* A sold-out pair is reserved on WhatsApp by name, never added (Ruby US 5 in the snapshot). */
+  it("turns every sold-out pair into a WhatsApp reservation, and every buyable one into a line", () => {
+    const band = piece("baguette-eternity-band");
+    let soldOut = 0;
+    for (const v of band.variants!) {
+      const result = oneTapLine(band, v.options);
+      if (v.availableForSale) {
+        expect(result).toMatchObject({ line: { variantId: v.id } });
+      } else {
+        soldOut += 1;
+        expect(result).toMatchObject({ soldOut: true, variant: { id: v.id } });
+        if (!("soldOut" in result)) continue;
+        expect(result.reserveUrl).toMatch(/^https:\/\/wa\.me\/919561557935\?text=/);
+        const text = decodeURIComponent(result.reserveUrl.split("text=")[1]);
+        expect(text).toContain(`"Baguette Eternity Band" in ${v.options.Stone}, size ${v.options.Size}`);
+        expect(text).toContain("https://nairaflore.com/jewellery/baguette-eternity-band");
+      }
+    }
+    // Pinned to today's snapshot: Ruby US 5 is the one sold-out pair.
+    expect(soldOut).toBeGreaterThanOrEqual(1);
+  });
+
+  it("reserves a sold-out pair even when the snapshot changes", () => {
+    const band = piece("baguette-eternity-band");
+    const forced = { ...band, variants: band.variants!.map((v) => ({ ...v, availableForSale: !(v.options.Stone === "Emerald" && v.options.Size === "8") })) };
+    expect(oneTapLine(forced, { Stone: "Emerald", Size: "8" })).toMatchObject({ soldOut: true });
+  });
+
+  it("marks which Eternity Band sizes can be bought in the chosen stone", () => {
+    const band = piece("baguette-eternity-band");
+    const chips = sizeChoices(band, { Stone: "Ruby" })!;
+    expect(chips.option).toBe("Size");
+    expect(chips.values.map((c) => c.value)).toEqual(["5", "6", "7", "8"]);
+    for (const chip of chips.values) {
+      const v = band.variants!.find((x) => x.options.Stone === "Ruby" && x.options.Size === chip.value)!;
+      expect(chip.buyable).toBe(v.availableForSale);
+    }
+    expect(sizeChoices(piece("baguette-huggies"), {})).toBeNull();
+  });
+
+  /* As PairingCard has always added it: an adjustable ring sold one way goes in as US 6. */
+  it("adds Cushion Halo, adjustable and sold one way, as US 6", () => {
+    const halo = piece("cushion-halo-ring");
+    expect(halo.variants ?? []).toHaveLength(0);
+    const result = oneTapLine(halo, {});
+    expect(result).toMatchObject({ line: { variantId: halo.variantId, size: "US 6" } });
+    expect(oneTapLine(halo, { Size: "8" })).toMatchObject({ line: { size: "US 8" } });
+  });
+
+  it("asks a fixed-size ring sold one way for its size, and carries the size as a note", () => {
+    const fixed = { ...piece("cushion-halo-ring"), handle: "a-fixed-ring", tags: [] };
+    expect(oneTapLine(fixed, {})).toEqual({ need: "size" });
+    expect(oneTapLine(fixed, { Size: "7" })).toMatchObject({ line: { size: "US 7" } });
+  });
+
+  it("reserves a sold-out piece instead of adding it", () => {
+    const hoops = { ...piece("woven-gold-hoops"), availableForSale: false };
+    const result = oneTapLine(hoops, {});
+    expect(result).toMatchObject({ soldOut: true });
+    // An adjustable ring is never sold out (one stock covers every size), as on its page.
+    expect(oneTapLine({ ...piece("cushion-halo-ring"), availableForSale: false }, {})).toMatchObject({ line: { size: "US 6" } });
+  });
+});
diff --git a/src/test/tryon/photoChecks.test.ts b/src/test/tryon/photoChecks.test.ts
new file mode 100644
index 0000000..9319ff4
--- /dev/null
+++ b/src/test/tryon/photoChecks.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from "vitest";
+import { CHECK_HEIGHT, CHECK_WIDTH, DARK_MEAN, laplacianVariance, meanLuminance, photoWarnings, SOFT_VAR } from "@/lib/tryon/photoChecks";
+
+/* Synthetic 288x384 RGBA images, drawn in code: never a person's photo. */
+const image = (pixel: (x: number, y: number) => number, w = CHECK_WIDTH, h = CHECK_HEIGHT) => {
+  const data = new Uint8ClampedArray(w * h * 4);
+  for (let y = 0; y < h; y += 1)
+    for (let x = 0; x < w; x += 1) {
+      const v = pixel(x, y);
+      const i = (y * w + x) * 4;
+      data[i] = data[i + 1] = data[i + 2] = v;
+      data[i + 3] = 255;
+    }
+  return { data, width: w, height: h };
+};
+
+// A sharp pattern: 8 px squares, the kind of edge detail a sharp face photo has.
+const checker = (lo: number, hi: number) => image((x, y) => ((Math.floor(x / 8) + Math.floor(y / 8)) % 2 ? hi : lo));
+// The same contrast as a smooth ramp: no edges, like a badly blurred photo.
+const ramp = (lo: number, hi: number) => image((x) => lo + ((hi - lo) * x) / (CHECK_WIDTH - 1));
+
+describe("try-on photo hints", () => {
+  it("exports the thresholds the spec tunes", () => {
+    expect(DARK_MEAN).toBe(60);
+    expect(SOFT_VAR).toBe(40);
+  });
+
+  it("measures mean luminance", () => {
+    expect(meanLuminance(image(() => 100))).toBeCloseTo(100, 3);
+    expect(meanLuminance(checker(0, 200))).toBeCloseTo(100, 0);
+  });
+
+  it("warns 'dark' under a mean of 60, and only then", () => {
+    expect(photoWarnings(checker(20, 80))).toEqual(["dark"]); // mean 50
+    expect(photoWarnings(checker(40, 100))).toEqual([]); // mean 70
+  });
+
+  it("warns 'soft' when the Laplacian varies under 40", () => {
+    expect(laplacianVariance(ramp(80, 200))).toBeLessThan(SOFT_VAR);
+    expect(photoWarnings(ramp(80, 200))).toEqual(["soft"]);
+    expect(laplacianVariance(checker(80, 200))).toBeGreaterThan(SOFT_VAR);
+    expect(photoWarnings(checker(80, 200))).toEqual([]);
+  });
+
+  it("can warn both at once, dark first", () => {
+    expect(photoWarnings(image(() => 30))).toEqual(["dark", "soft"]);
+  });
+});
diff --git a/src/test/tryon/preparePhoto.test.ts b/src/test/tryon/preparePhoto.test.ts
new file mode 100644
index 0000000..8e028c8
--- /dev/null
+++ b/src/test/tryon/preparePhoto.test.ts
@@ -0,0 +1,341 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { blobBytes } from "@/lib/tryon/canvas";
+import { decodePhoto, encodePhoto, PhotoPrepError, preparePhoto, sniffImageType } from "@/lib/tryon/preparePhoto";
+
+/*
+  jsdom has no canvas and no image decoder, so both are stood in for here and
+  the test pins the pipeline: which decoder is asked, with which options, what
+  is drawn where, and how it is encoded. That the real browser applies the
+  EXIF orientation and drops the EXIF block is proven in Chromium
+  (scratchpad build/p2 prep proof, and tryonflow).
+*/
+
+/* A synthetic JPEG header carrying EXIF orientation 6 and a GPS position, built byte by byte. */
+const exifJpeg = () => {
+  const tiff = [
+    0x4d, 0x4d, 0x00, 0x2a, 0x00, 0x00, 0x00, 0x08, // big-endian TIFF, IFD0 at 8
+    0x00, 0x02, // two entries
+    0x01, 0x12, 0x00, 0x03, 0x00, 0x00, 0x00, 0x01, 0x00, 0x06, 0x00, 0x00, // Orientation = 6
+    0x88, 0x25, 0x00, 0x04, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x26, // GPS IFD at 38
+    0x00, 0x00, 0x00, 0x00, // no next IFD
+    0x00, 0x01, // GPS IFD: one entry
+    0x00, 0x01, 0x00, 0x02, 0x00, 0x00, 0x00, 0x02, 0x4e, 0x00, 0x00, 0x00, // GPSLatitudeRef "N"
+    0x00, 0x00, 0x00, 0x00,
+  ];
+  const payload = [0x45, 0x78, 0x69, 0x66, 0x00, 0x00, ...tiff]; // "Exif\0\0"
+  const len = payload.length + 2;
+  return new Uint8Array([0xff, 0xd8, 0xff, 0xe1, len >> 8, len & 0xff, ...payload, 0xff, 0xd9]);
+};
+
+const hasApp1 = (bytes: Uint8Array) => {
+  for (let i = 2; i + 1 < bytes.length; i += 1) if (bytes[i] === 0xff && bytes[i + 1] === 0xe1) return true;
+  return false;
+};
+
+// What the stand-in encoder writes: a bare JFIF header, as a canvas would.
+const ENCODED = new Uint8Array([0xff, 0xd8, 0xff, 0xe0, 0x00, 0x10, 0x4a, 0x46, 0x49, 0x46, 0x00, 0x01, 0xff, 0xd9]);
+
+interface FakeCtx {
+  drawImage: ReturnType<typeof vi.fn>;
+  getImageData: ReturnType<typeof vi.fn>;
+  imageSmoothingEnabled: boolean;
+  imageSmoothingQuality: string;
+  canvas: HTMLCanvasElement;
+}
+
+let contexts: FakeCtx[];
+let toBlob: ReturnType<typeof vi.fn>;
+let pixel = 128;
+
+beforeEach(() => {
+  contexts = [];
+  pixel = 128;
+  vi.spyOn(HTMLCanvasElement.prototype, "getContext").mockImplementation(function (this: HTMLCanvasElement) {
+    const canvas = this;
+    const ctx: FakeCtx = {
+      canvas,
+      imageSmoothingEnabled: false,
+      imageSmoothingQuality: "low",
+      drawImage: vi.fn(),
+      getImageData: vi.fn((_x: number, _y: number, w: number, h: number) => {
+        const data = new Uint8ClampedArray(w * h * 4);
+        // An 8 px checker around `pixel`: sharp, as bright as the test asks.
+        for (let i = 0; i < w * h; i += 1) {
+          const x = i % w;
+          const y = Math.floor(i / w);
+          const v = (Math.floor(x / 8) + Math.floor(y / 8)) % 2 ? pixel + 40 : pixel - 40;
+          data.set([v, v, v, 255], i * 4);
+        }
+        return { data, width: w, height: h };
+      }),
+    };
+    contexts.push(ctx);
+    return ctx as unknown as CanvasRenderingContext2D;
+  } as never);
+  toBlob = vi.fn(function (this: HTMLCanvasElement, cb: BlobCallback, type?: string) {
+    cb(new Blob([ENCODED], { type: type ?? "image/png" }));
+  });
+  HTMLCanvasElement.prototype.toBlob = toBlob as never;
+});
+
+const realToBlob = HTMLCanvasElement.prototype.toBlob;
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+  HTMLCanvasElement.prototype.toBlob = realToBlob;
+  // jsdom has no object URLs of its own; drop the stand-ins a test put on URL.
+  delete (URL as unknown as Record<string, unknown>).createObjectURL;
+  delete (URL as unknown as Record<string, unknown>).revokeObjectURL;
+});
+
+const bitmap = (width: number, height: number) => ({ width, height, close: vi.fn() });
+
+describe("preparePhoto", () => {
+  /* The 4000x3000 camera file with orientation 6 decodes upright as 3000x4000;
+     the whole frame is drawn to 1152x1536 and a fresh JPEG at q0.85 replaces
+     the original, so its EXIF (and GPS) never leave the phone. */
+  it("decodes with EXIF orientation, draws 1152x1536 and re-encodes JPEG q0.85 without the original's EXIF", async () => {
+    const decoded = bitmap(3000, 4000);
+    const createImageBitmap = vi.fn(async () => decoded);
+    vi.stubGlobal("createImageBitmap", createImageBitmap);
+    const file = new File([exifJpeg()], "IMG_0001.jpg", { type: "image/jpeg" });
