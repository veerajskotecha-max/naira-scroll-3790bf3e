+++ b/src/components/tryon/RenderingState.tsx
@@ -0,0 +1,83 @@
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import type { TryOnPiece } from "@/data/tryOnPieces";
+import { renderStage, renderStageCopy, TRYON_COPY } from "@/lib/tryon/copy";
+import { useSweep } from "./motion";
+import { smallButton } from "./styles";
+
+/*
+  The wait, told honestly: the upload's real percentage, then what is under
+  way by elapsed time (never a made-up percentage), over the shopper's own
+  photo dimmed, with one gold hairline sweeping it. The piece stays buyable
+  underneath the whole time (the studio passes TryOnBuy in as `buy`).
+
+  Screen readers hear each stage once, through a polite live region; the
+  upload is announced in quarters rather than at every progress event.
+*/
+
+interface Props {
+  piece: TryOnPiece;
+  photoUrl: string | undefined;
+  phase: "uploading" | "rendering";
+  /** Upload progress, 0 to 1. */
+  progress: number;
+  /** When the photo finished uploading, for the stages. */
+  startedAt: number | null;
+  onCancel: () => void;
+  buy: ReactNode;
+  quiet: ReactNode;
+  layout: (frame: ReactNode, controls: ReactNode) => ReactNode;
+}
+
+const RenderingState = ({ piece, photoUrl, phase, progress, startedAt, onCancel, buy, quiet, layout }: Props) => {
+  const [now, setNow] = useState(() => Date.now());
+  const sweep = useRef<HTMLSpanElement>(null);
+  useSweep(sweep, [{ top: "6%" }, { top: "94%" }], 2600);
+
+  useEffect(() => {
+    if (phase !== "rendering") return;
+    setNow(Date.now());
+    const timer = window.setInterval(() => setNow(Date.now()), 1000);
+    return () => window.clearInterval(timer);
+  }, [phase]);
+
+  const stage = phase === "rendering" ? renderStage(startedAt ? now - startedAt : 0) : null;
+  const text = stage ? renderStageCopy(stage, piece.name, piece.sizeLine) : TRYON_COPY.uploading(progress * 100);
+  const announcement = stage ? text : TRYON_COPY.uploading(Math.floor(progress * 4) * 25);
+
+  const frame = (
+    <div className="relative aspect-[3/4] w-full overflow-hidden bg-nf-ink" data-clarity-mask="True">
+      {photoUrl && <img src={photoUrl} alt="" width={900} height={1200} className="h-full w-full object-cover opacity-40" draggable={false} />}
+      <span ref={sweep} aria-hidden="true" className="pointer-events-none absolute inset-x-0 top-1/2 block h-px bg-nf-gold shadow-[0_0_14px_2px_rgb(var(--nf-gold-rgb)/0.55)]" />
+      <div className="absolute inset-x-0 bottom-0 bg-gradient-to-t from-nf-ink/80 via-nf-ink/40 to-transparent px-5 pb-6 pt-16 text-center">
+        <h2 id="tryon-step" tabIndex={-1} className="mx-auto max-w-[320px] font-nf-editorial text-[22px] italic leading-snug text-nf-ivory outline-none md:text-[25px]">
+          {text}
+        </h2>
+        {phase === "uploading" && (
+          <span className="mx-auto mt-3 block h-px w-40 bg-nf-ivory/25" aria-hidden="true">
+            <span className="block h-px bg-nf-gold transition-[width] duration-200" style={{ width: `${Math.round(progress * 100)}%` }} />
+          </span>
+        )}
+      </div>
+    </div>
+  );
+
+  const controls = (
+    <div className="space-y-4">
+      <p role="status" aria-live="polite" className="sr-only">
+        {announcement}
+      </p>
+      <div className="flex items-center justify-between gap-3 border-y border-nf-gold/25 py-2">
+        <p className="text-[12.5px] text-nf-ink/80">{TRYON_COPY.keepOpen}</p>
+        <button type="button" onClick={onCancel} className={smallButton}>
+          {TRYON_COPY.cancel}
+        </button>
+      </div>
+      {buy}
+      {quiet}
+    </div>
+  );
+
+  return <>{layout(frame, controls)}</>;
+};
+
+export default RenderingState;
