+import { Link } from "react-router-dom";
+import { useLiveJewellery } from "@/hooks/useLiveJewellery";
+import { TRY_ON_PIECES, type TryOnPiece } from "@/data/tryOnPieces";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { listed, livePiece } from "./live";
+import { eyebrow, primaryButton, textLink } from "./styles";
+
+/*
+  /try-on: every piece that can be tried on, in two groups by the photo it
+  needs. Names and photos paint at once from the manifest; the price waits
+  for the live catalogue (a one-line shimmer until then), and a piece that
+  has sold out disappears as soon as Shopify says so.
+*/
+
+const Card = ({ piece, eager, price, certified }: { piece: TryOnPiece; eager: boolean; price: string | null; certified: boolean }) => (
+  <Link to={`/try-on/${piece.handle}`} className="group block min-w-0" data-tryon-card={piece.handle}>
+    <div className="relative aspect-square overflow-hidden bg-nf-ivory-deep">
+      <img
+        src={shopifyImage(piece.image, 360)}
+        srcSet={shopifySrcSet(piece.image, [240, 360, 480]) || undefined}
+        sizes="(min-width: 1024px) 230px, (min-width: 640px) 30vw, 46vw"
+        alt={piece.name}
+        width={360}
+        height={360}
+        loading={eager ? "eager" : "lazy"}
+        decoding="async"
+        className="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
+      />
+      {!certified && (
+        <span className="absolute left-2 top-2 bg-nf-ivory/85 px-2 py-0.5 font-nf-label text-[9px] uppercase tracking-nf-16 text-nf-gold-text">
+          {TRYON_COPY.hub.uncertified}
+        </span>
+      )}
+    </div>
+    <p className="mt-2.5 line-clamp-2 font-cormorant text-[15px] font-semibold leading-[1.2] text-nf-ink">{piece.name}</p>
+    <div className="mt-1 flex min-h-[18px] items-center text-[12px] text-nf-ink/75">
+      {price ?? <span className="atelier-shimmer block h-3 w-14" aria-hidden="true" />}
+    </div>
+  </Link>
+);
+
+const Group = ({ id, title, sub, pieces, priceOf, eagerCount }: { id: string; title: string; sub: string; pieces: TryOnPiece[]; priceOf: (p: TryOnPiece) => string | null; eagerCount: number }) =>
+  pieces.length ? (
+    <section aria-labelledby={id} className="mt-10 first:mt-0">
+      <div className="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-nf-gold/25 pb-3">
+        <h2 id={id} className="font-cormorant text-[22px] leading-none text-nf-ink md:text-[26px]">
+          {title}
+        </h2>
+        <p className={eyebrow}>{sub}</p>
+      </div>
+      <div className="mt-5 grid grid-cols-2 gap-x-3 gap-y-6 sm:grid-cols-3 lg:grid-cols-5 lg:gap-x-5">
+        {pieces.map((piece, i) => (
+          <Card key={piece.handle} piece={piece} eager={i < eagerCount} price={priceOf(piece)} certified={Boolean(piece.certified)} />
+        ))}
+      </div>
+    </section>
+  ) : null;
+
+const TryOnHub = () => {
+  const { jewellery, isLive } = useLiveJewellery();
+  const shown = TRY_ON_PIECES.filter((p) => listed(p, jewellery, isLive));
+  const face = shown.filter((p) => p.kind === "face");
+  const hand = shown.filter((p) => p.kind === "hand");
+  const priceOf = (p: TryOnPiece) => livePiece(jewellery, isLive, p.handle)?.priceLabel ?? null;
+  const copy = TRYON_COPY.hub;
+
+  return (
+    <div className="mx-auto max-w-6xl px-4 pb-16 pt-8 sm:px-6 md:pt-12">
+      <header className="max-w-xl">
+        <h1 className="font-cormorant text-[34px] font-semibold leading-[1.05] text-nf-ink md:text-[48px]">{copy.title}</h1>
+        <p className="mt-3 font-nf-editorial text-[16px] leading-[1.6] text-nf-ink/75 md:text-[18px]">{copy.sub}</p>
+      </header>
+
+      <div className="mt-9 md:mt-12">
+        {shown.length === 0 ? (
+          <div className="border border-nf-gold/30 bg-nf-ivory-deep/60 px-6 py-10 text-center">
+            <p className="mx-auto max-w-sm font-nf-editorial text-[17px] leading-[1.6] text-nf-ink/85">{copy.empty}</p>
+            <Link to={copy.emptyHref} className={`${primaryButton} mt-6 max-w-[280px]`}>
+              {copy.emptyButton}
+            </Link>
+          </div>
+        ) : (
+          <>
+            <Group id="tryon-face" title={copy.faceGroup} sub={copy.faceGroupSub} pieces={face} priceOf={priceOf} eagerCount={2} />
+            <Group id="tryon-hand" title={copy.handGroup} sub={copy.handGroupSub} pieces={hand} priceOf={priceOf} eagerCount={0} />
+          </>
+        )}
+      </div>
+
+      <p className="mt-12 max-w-xl border-t border-nf-gold/25 pt-5 text-[12.5px] leading-[1.7] text-nf-ink/75">
+        {TRYON_COPY.trust.line}{" "}
+        <Link to={TRYON_COPY.trust.href} className={textLink}>
+          {TRYON_COPY.trust.link}
+        </Link>
+      </p>
+    </div>
+  );
+};
+
+export default TryOnHub;
diff --git a/src/components/tryon/TryOnResult.tsx b/src/components/tryon/TryOnResult.tsx
