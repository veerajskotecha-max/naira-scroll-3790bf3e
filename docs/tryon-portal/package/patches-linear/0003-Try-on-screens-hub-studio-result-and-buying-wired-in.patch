+import type { JewelPiece } from "@/data/jewellery";
+import type { TryOnPiece, TryOnStone } from "@/data/tryOnPieces";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { pieceInStone } from "./live";
+import { choiceButton, eyebrow, stoneSwatch, textLink } from "./styles";
+
+/*
+  The real piece, always in view above the photo: its studio thumbnail, name,
+  live price and true size, and the stones it is sold in. The thumbnail and
+  "The real piece" open the listing's own photos and size guide, so the AI
+  preview is never the only picture of what arrives.
+*/
+
+interface Props {
+  piece: TryOnPiece;
+  live: JewelPiece | undefined;
+  stone: TryOnStone | null;
+  onStone: (stone: TryOnStone) => void;
+  /** While a preview is being made, the stone it is for stays put. */
+  stonesLocked?: boolean;
+  onRealPiece: () => void;
+}
+
+const PieceStrip = ({ piece, live, stone, onStone, stonesLocked = false, onRealPiece }: Props) => {
+  const view = pieceInStone(live, stone);
+  const image = view?.image ?? piece.image;
+  return (
+    <section aria-label={piece.name} className="border-y border-nf-gold/25 py-3">
+      <div className="flex items-start gap-3">
+        <button
+          type="button"
+          onClick={onRealPiece}
+          className="block h-[72px] w-[72px] shrink-0 overflow-hidden bg-nf-ivory-deep"
+          aria-label={TRYON_COPY.ui.realPieceAlt(piece.name)}
+        >
+          <img
+            src={shopifyImage(image, 144)}
+            srcSet={shopifySrcSet(image, [144, 216]) || undefined}
+            sizes="72px"
+            alt=""
+            width={72}
+            height={72}
+            className="h-full w-full object-cover"
+          />
+        </button>
+        <div className="min-w-0 flex-1">
+          <h2 className="font-cormorant text-[19px] font-semibold leading-[1.15] text-nf-ink md:text-[21px]">{piece.name}</h2>
+          <div className="mt-1 flex min-h-[18px] items-center text-[13px] text-nf-ink">
+            {view ? view.priceLabel : <span className="atelier-shimmer block h-3 w-16" aria-hidden="true" />}
+          </div>
+          <p className="mt-1 text-[11.5px] leading-[1.4] text-nf-ink/75">{TRYON_COPY.studio.actualSize(piece.sizeLine)}</p>
+        </div>
+        <button type="button" onClick={onRealPiece} className={`-mr-1 shrink-0 self-start px-1 py-2 text-[11.5px] ${textLink}`}>
+          {TRYON_COPY.studio.realPiece}
+        </button>
+      </div>
+
+      {piece.stones && (
+        <div className="mt-3" data-option="Stone">
+          <p className={eyebrow}>
+            {TRYON_COPY.studio.stoneLabel}
+            {stone && <span className="ml-2 normal-case tracking-normal text-nf-ink/80">{stone}</span>}
+          </p>
+          {/* One row whatever the count, so the photo buttons stay on a 360px first screen. */}
+          <div
+            role="radiogroup"
+            aria-label={TRYON_COPY.studio.stoneLabel}
+            className="mt-1.5 grid gap-1.5"
+            style={{ gridTemplateColumns: `repeat(${piece.stones.length}, minmax(0, 1fr))` }}
+          >
+            {piece.stones.map((value) => {
+              const active = stone === value;
+              return (
+                <button
+                  key={value}
+                  type="button"
+                  role="radio"
+                  aria-checked={active}
+                  disabled={stonesLocked && !active}
+                  onClick={() => onStone(value)}
+                  className={choiceButton(active, true)}
+                >
+                  <span className="inline-flex min-w-0 items-center gap-1">
+                    <span aria-hidden="true" className="h-2.5 w-2.5 shrink-0 border border-nf-ink/15" style={{ background: stoneSwatch(value) }} />
+                    <span className="truncate">{value}</span>
+                  </span>
+                </button>
+              );
+            })}
+          </div>
+        </div>
+      )}
+    </section>
+  );
+};
+
+export default PieceStrip;
