index 0000000..04eb51e
--- /dev/null
+++ b/src/components/tryon/TryOnBuy.tsx
@@ -0,0 +1,188 @@
+import { useState } from "react";
+import { Link } from "react-router-dom";
+import { Gift } from "lucide-react";
+import RingSizeGuideModal from "@/components/jewellery/RingSizeGuideModal";
+import UpiBadges from "@/components/checkout/UpiBadges";
+import { useCart } from "@/contexts/CartContext";
+import type { JewelPiece } from "@/data/jewellery";
+import { adjustableSizes, isAdjustableRing } from "@/data/ringFit";
+import type { TryOnPiece } from "@/data/tryOnPieces";
+import { useBackToClose } from "@/hooks/useBackToClose";
+import { oneTapLine, sizeChoices } from "@/lib/oneTapLine";
+import { tryonEvent } from "@/lib/tryon/analytics";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { liveSoldOut, pieceInStone } from "./live";
+import { choiceButton, eyebrow, outlineButton, primaryButton, textLink } from "./styles";
+
+/*
+  Add to bag and Buy now, live from the first second of a try-on to the
+  result, so the wait is never dead time.
+
+  The line is the one the product page's one-tap Add takes (oneTapLine): the
+  stone shown, a size for the Eternity Band, US 6 for the open-back Cushion
+  Halo. The button always names the stone it adds. The bag opens AT the tap
+  and the piece goes in after (the product page's pattern); a refusal is said
+  inside the bag by CartContext. Buy now goes through CartContext.buyNow, so
+  the checkout handoff, discount and tracking stay the bag's.
+
+  Nothing is added from first-paint data: until the live catalogue has
+  answered the buttons wait, so a piece sold out since the snapshot is never
+  put in the bag.
+*/
+
+interface Props {
+  piece: TryOnPiece;
+  live: JewelPiece | undefined;
+  stone: string | null;
+  /** The add names the stone outright ("Add Emerald to bag") when it differs from the preview's. */
+  stoneDiffers?: boolean;
+  /** A thumbnail, name and price above the buttons, for the wait screens. */
+  withCard?: boolean;
+}
+
+const TryOnBuy = ({ piece, live, stone, stoneDiffers = false, withCard = false }: Props) => {
+  const { addItem, buyNow, setDrawerOpen, isLoading: cartLoading } = useCart();
+  const [size, setSize] = useState<string | null>(null);
+  const [adding, setAdding] = useState(false);
+  const [buying, setBuying] = useState(false);
+  const [guideOpen, setGuideOpen] = useState(false);
+  const guide = useBackToClose("nfSizeGuide", guideOpen, setGuideOpen);
+
+  const sizes = live ? sizeChoices(live, stone ? { Stone: stone } : {}) : null;
+  const chosen: Record<string, string> = {
+    ...(stone ? { Stone: stone } : {}),
+    ...(sizes && size ? { [sizes.option]: size } : {}),
+  };
+  const one = live ? oneTapLine(live, chosen) : null;
+  const soldOut = liveSoldOut(live);
+  const view = pieceInStone(live, stone);
+  const pieceHref = `/jewellery/${piece.handle}${stone ? `?colour=${encodeURIComponent(stone.toLowerCase())}` : ""}`;
+
+  const add = async () => {
+    if (!one || !("line" in one) || adding) return;
+    setAdding(true);
+    /* The bag opens first, then the piece goes in (JewelDetailNext's Add). */
+    setDrawerOpen(true);
+    tryonEvent("tryon_added");
+    try {
+      await addItem(one.line);
+    } finally {
+      setAdding(false);
+    }
+  };
+
+  const buy = async () => {
+    if (!one || !("line" in one) || buying || cartLoading) return;
+    setBuying(true);
+    tryonEvent("tryon_buynow");
+    try {
+      await buyNow(one.line);
+    } finally {
+      setBuying(false);
+    }
+  };
+
+  const addLabel = adding
+    ? TRYON_COPY.buy.adding
+    : stoneDiffers && stone
+      ? TRYON_COPY.stoneChange.add(stone)
+      : TRYON_COPY.buy.add(stone, sizes ? size : null);
+
+  return (
+    <div className="space-y-3" data-tryon-buy>
+      {withCard && (
+        <div className="flex items-center gap-3">
+          <img src={view?.image ?? piece.image} alt="" width={56} height={56} className="h-14 w-14 shrink-0 bg-nf-ivory-deep object-cover" loading="lazy" decoding="async" />
+          <div className="min-w-0">
+            <p className="truncate font-cormorant text-[16px] font-semibold leading-tight text-nf-ink">{piece.name}</p>
+            <div className="mt-0.5 flex min-h-[18px] items-center text-[12.5px] text-nf-ink/80">
+              {view ? [view.priceLabel, stone].filter(Boolean).join(" · ") : <span className="atelier-shimmer block h-3 w-16" aria-hidden="true" />}
+            </div>
+          </div>
+        </div>
+      )}
+
+      {soldOut ? (
+        <div>
+          <p className="text-[13px] text-nf-ink">{TRYON_COPY.soldOut.line}</p>
+          <div className="mt-3 grid gap-2.5">
+            {one && "soldOut" in one && (
+              <a href={one.reserveUrl} target="_blank" rel="noopener noreferrer" onClick={() => tryonEvent("tryon_reserve")} className={primaryButton}>
+                {TRYON_COPY.soldOut.reserve}
+              </a>
+            )}
+            <Link to={pieceHref} className={outlineButton}>
+              {TRYON_COPY.soldOut.view}
+            </Link>
+          </div>
+        </div>
+      ) : (
+        <>
+          {sizes && (
+            <div data-option={sizes.option}>
+              <div className="flex items-center justify-between">
+                <p className={eyebrow}>{TRYON_COPY.buy.chooseSize}</p>
+                <button type="button" onClick={() => setGuideOpen(true)} className={`-mr-2 inline-flex min-h-[44px] items-center px-2 text-[11.5px] ${textLink}`}>
+                  {TRYON_COPY.buy.sizeGuide}
+                </button>
+              </div>
+              <div role="radiogroup" aria-label={TRYON_COPY.buy.chooseSize} className="flex flex-wrap gap-2">
+                {sizes.values.map(({ value, buyable }) => (
+                  <button
+                    key={value}
+                    type="button"
+                    role="radio"
+                    aria-checked={size === value}
+                    onClick={() => {
+                      setSize(value);
+                      tryonEvent("tryon_choose_size");
+                    }}
+                    className={choiceButton(size === value)}
+                  >
+                    {TRYON_COPY.buy.sizeChip(value)}
+                    {!buyable && <span className="block text-[9px] font-normal uppercase tracking-nf-8 opacity-80">{TRYON_COPY.buy.preorder}</span>}
+                  </button>
+                ))}
+              </div>
+              <RingSizeGuideModal
+                isOpen={guideOpen}
+                onClose={guide.requestClose}
+                highlightSize={size ?? undefined}
+                adjustable={isAdjustableRing(live)}
+                fitSizes={adjustableSizes(piece.handle)}
+              />
+            </div>
+          )}
+
+          <div className="grid gap-2.5">
+            {one && "soldOut" in one ? (
+              <a href={one.reserveUrl} target="_blank" rel="noopener noreferrer" onClick={() => tryonEvent("tryon_reserve")} className={primaryButton}>
+                {TRYON_COPY.buy.reserve}
+              </a>
+            ) : one && "need" in one ? (
+              <button type="button" disabled className={primaryButton}>
+                {TRYON_COPY.buy.chooseSizeButton}
+              </button>
+            ) : (
+              <>
+                <button type="button" onClick={add} disabled={!one || adding || buying} className={primaryButton}>
+                  {addLabel}
+                </button>
+                <button type="button" onClick={buy} disabled={!one || adding || buying || cartLoading} className={outlineButton}>
+                  {TRYON_COPY.buy.buyNow}
+                  <UpiBadges size={16} />
+                </button>
+              </>
+            )}
+          </div>
+          <p className="flex items-center justify-center gap-2 text-center text-[11.5px] text-nf-ink/80">
+            <Gift size={14} strokeWidth={1.6} className="shrink-0 text-nf-gold-deep" aria-hidden="true" />
+            {TRYON_COPY.buy.ladder}
+          </p>
+        </>
+      )}
+    </div>
+  );
+};
+
+export default TryOnBuy;
