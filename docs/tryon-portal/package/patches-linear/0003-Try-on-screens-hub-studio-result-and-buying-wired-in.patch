+    <path d="M52 54c2-1 4-1 6 0M62 54c2-1 4-1 6 0M56 72c2.5 1.5 5.5 1.5 8 0" />
+    <circle cx="31.5" cy="69" r="2.2" strokeDasharray="1.2 1.6" />
+    <circle cx="88.5" cy="69" r="2.2" strokeDasharray="1.2 1.6" />
+    <path d="M48 103c4 14 20 14 24 0" strokeDasharray="1.5 2.5" />
+  </svg>
+);
+
+/* The back of a hand flat on a table, fingers a little apart, wrist in view:
+   dotted marks at the ring finger's base and across the wrist. */
+export const HandPose = ({ className }: { className?: string }) => (
+  <svg viewBox="0 0 120 150" className={className} fill="none" stroke="currentColor" strokeWidth={1} strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+    <rect x="35.5" y="26" width="10" height="52" rx="5" transform="rotate(-8 40.5 52)" fill="var(--nf-ivory-deep)" />
+    <rect x="48.5" y="16" width="10.5" height="60" rx="5.25" fill="var(--nf-ivory-deep)" />
+    <rect x="62" y="20" width="10" height="56" rx="5" transform="rotate(6 67 48)" fill="var(--nf-ivory-deep)" />
+    <rect x="75" y="34" width="9" height="44" rx="4.5" transform="rotate(14 79.5 56)" fill="var(--nf-ivory-deep)" />
+    <rect x="17" y="70" width="10.5" height="38" rx="5.25" transform="rotate(-48 22 89)" fill="var(--nf-ivory-deep)" />
+    <path d="M36 72c-1 14-1 26 4 38h40c5-12 6-24 4-38z" fill="var(--nf-ivory-deep)" />
+    <path d="M41 110l2 36M79 110l-2 36" />
+    <path d="M63.5 76.5c2.5 1.4 6 1.6 8.8.6" strokeDasharray="1.2 1.6" />
+    <path d="M42 124c11 4 25 4 36 0" strokeDasharray="1.5 2.5" />
+  </svg>
+);
+
+const PhotoGuide = ({ guide }: { guide: TryOnGuide }) => {
+  const [open, setOpen] = useState(() => !readClosed());
+  const onToggle = (event: SyntheticEvent<HTMLDetailsElement>) => {
+    const next = event.currentTarget.open;
+    setOpen(next);
+    writeClosed(!next);
+  };
+  const hand = guide === "hand";
+  const tips: readonly string[] = hand
+    ? TRYON_COPY.tips.hand
+    : guide === "ear-cuff"
+      ? [...TRYON_COPY.tips.face.slice(0, 2), TRYON_COPY.tips.earCuff, ...TRYON_COPY.tips.face.slice(2)]
+      : TRYON_COPY.tips.face;
+  const Pose = hand ? HandPose : FacePose;
+
+  return (
+    <details open={open} onToggle={onToggle} className="group border-y border-nf-gold/25">
+      <summary className="flex min-h-[48px] cursor-pointer list-none items-center justify-between font-nf-label text-[10px] uppercase tracking-nf-16 text-nf-ink [&::-webkit-details-marker]:hidden">
+        {TRYON_COPY.studio.tipsToggle}
+        <Plus size={14} strokeWidth={1.4} className="shrink-0 text-nf-ink/70 transition-transform duration-200 group-open:rotate-45" aria-hidden="true" />
+      </summary>
+      <div className="flex gap-4 pb-5">
+        <div className="w-[84px] shrink-0 self-start bg-nf-ivory-deep p-1.5 text-nf-gold" role="img" aria-label={TRYON_COPY.ui.tipsPose(hand ? "hand" : "face")}>
+          <Pose className="h-auto w-full" />
+        </div>
+        <div className="min-w-0 text-[12.5px] leading-[1.6] text-nf-ink/85">
+          <ul className="space-y-1.5">
+            {tips.map((tip) => (
+              <li key={tip} className="flex gap-2">
+                <span aria-hidden="true" className="mt-[9px] h-px w-2 shrink-0 bg-nf-gold" />
+                {tip}
+              </li>
+            ))}
+          </ul>
+          <p className="mt-2.5 text-nf-ink/65">{hand ? TRYON_COPY.tips.handAvoid : TRYON_COPY.tips.faceAvoid}</p>
+        </div>
+      </div>
+    </details>
+  );
+};
+
+export default PhotoGuide;
diff --git a/src/components/tryon/PhotoStep.tsx b/src/components/tryon/PhotoStep.tsx
new file mode 100644
index 0000000..6ba76d0
--- /dev/null
+++ b/src/components/tryon/PhotoStep.tsx
@@ -0,0 +1,234 @@
+import { useEffect, useLayoutEffect, useRef, useState, type ChangeEvent, type KeyboardEvent, type PointerEvent } from "react";
+import { Camera, ImageIcon } from "lucide-react";
+import type { TryOnKind } from "@/data/tryOnPieces";
+import { panCrop, zoomCrop, type CropRect } from "@/lib/tryon/cropMaths";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { drawCrop, type DecodedPhoto, type PhotoBlock } from "@/lib/tryon/preparePhoto";
+import type { PhotoWarning } from "@/lib/tryon/photoChecks";
+import type { SessionPhoto } from "@/lib/tryon/session";
+import { outlineButton, primaryButton, quietButton } from "./styles";
+
+/*
+  The photo: take one or choose one, or reuse the one this tab already holds
+  (one face photo serves every face piece, one hand photo every hand piece),
+  then frame it at 3:4.
+
+  "Take a photo" opens the camera, the front one for a face and the back one
+  for a hand laid on a table; "Choose from gallery" has no capture attribute,
+  so the phone offers its library. The inputs are off screen and opened from
+  real buttons, which keeps them keyboard-reachable on every phone.
+
+  The crop is drawn on a canvas straight from the decoded photo, so the
+  framing step needs no URL at all; the frame is masked from session
+  recordings like every other picture of the shopper.
+*/
+
+export type PhotoSource = "camera" | "library";
+
+interface PickerProps {
+  kind: TryOnKind;
+  held: SessionPhoto | undefined;
+  /** The shopper asked to change the photo the tab holds. */
+  changing: boolean;
+  block?: PhotoBlock;
+  disabled?: boolean;
+  onFile: (file: File, source: PhotoSource) => void;
+  onReuse: () => void;
+  onChange: () => void;
+}
+
+export const PhotoPicker = ({ kind, held, changing, block, disabled = false, onFile, onReuse, onChange }: PickerProps) => {
+  const camera = useRef<HTMLInputElement>(null);
+  const library = useRef<HTMLInputElement>(null);
+  const picked = (source: PhotoSource) => (event: ChangeEvent<HTMLInputElement>) => {
+    const file = event.target.files?.[0];
+    // Cleared so choosing the same photo again still counts as a choice.
+    event.target.value = "";
+    if (file) onFile(file, source);
+  };
+  const reuse = held && !changing;
+
+  return (
+    <div className="space-y-3">
+      {block && (
+        <p role="alert" className="border-l-2 border-nf-gold bg-nf-ivory-deep/70 px-3 py-2.5 text-[13px] leading-[1.6] text-nf-ink">
+          {TRYON_COPY.blocked[block]}
+        </p>
+      )}
+      {reuse ? (
+        <div className="flex items-stretch gap-3">
+          <div className="w-[60px] shrink-0 overflow-hidden bg-nf-ivory-deep" data-clarity-mask="True">
+            <img src={held.url} alt={TRYON_COPY.ui.yourPhoto} width={60} height={80} className="h-full w-full object-cover" />
+          </div>
+          <div className="grid min-w-0 flex-1 gap-2">
+            <button type="button" onClick={onReuse} disabled={disabled} className={primaryButton}>
+              {TRYON_COPY.reuse.use}
+            </button>
+            <button type="button" onClick={onChange} disabled={disabled} className={outlineButton}>
+              {TRYON_COPY.reuse.change}
+            </button>
+          </div>
+        </div>
+      ) : (
+        <div className="grid gap-2.5">
+          <button type="button" onClick={() => camera.current?.click()} disabled={disabled} className={primaryButton}>
+            <Camera size={16} strokeWidth={1.5} aria-hidden="true" />
+            {TRYON_COPY.studio.takePhoto}
+          </button>
+          <button type="button" onClick={() => library.current?.click()} disabled={disabled} className={outlineButton}>
+            <ImageIcon size={16} strokeWidth={1.5} aria-hidden="true" />
+            {TRYON_COPY.studio.chooseGallery}
+          </button>
+          {held && (
+            <button type="button" onClick={onReuse} disabled={disabled} className={quietButton}>
+              {TRYON_COPY.reuse.use}
+            </button>
+          )}
+        </div>
+      )}
+      <input
+        ref={camera}
+        type="file"
+        accept="image/*"
+        capture={kind === "hand" ? "environment" : "user"}
+        onChange={picked("camera")}
+        className="sr-only"
+        tabIndex={-1}
+        aria-hidden="true"
+        data-tryon-input="camera"
+      />
+      <input ref={library} type="file" accept="image/*" onChange={picked("library")} className="sr-only" tabIndex={-1} aria-hidden="true" data-tryon-input="library" />
+    </div>
+  );
+};
+
+/* The 3:4 frame the shopper drags (and pinches) her photo under. */
+export const CropFrame = ({ decoded, initial, onCrop }: { decoded: DecodedPhoto; initial: CropRect; onCrop: (crop: CropRect) => void }) => {
+  const box = useRef<HTMLDivElement>(null);
+  const canvas = useRef<HTMLCanvasElement>(null);
+  const [crop, setCrop] = useState(initial);
+  const current = useRef(initial);
+  const pointers = useRef(new Map<number, { x: number; y: number }>());
+
+  const update = (next: CropRect) => {
+    current.current = next;
+    setCrop(next);
+    onCrop(next);
+  };
+
+  /* The canvas matches the frame's size on screen (at up to 2x for sharpness). */
+  useLayoutEffect(() => {
+    const el = box.current;
+    const c = canvas.current;
+    if (!el || !c) return;
+    const fit = () => {
+      const scale = Math.min(2, window.devicePixelRatio || 1);
+      const width = Math.max(1, Math.round(el.clientWidth * scale));
+      c.width = width;
+      c.height = Math.round((width * 4) / 3);
+      drawCrop(decoded, current.current, c);
+    };
+    fit();
+    if (typeof ResizeObserver === "undefined") return;
+    const ro = new ResizeObserver(fit);
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, [decoded]);
+
+  useEffect(() => {
+    const c = canvas.current;
+    if (!c) return;
+    const frame = requestAnimationFrame(() => drawCrop(decoded, crop, c));
+    return () => cancelAnimationFrame(frame);
+  }, [crop, decoded]);
+
+  const onPointerDown = (event: PointerEvent<HTMLDivElement>) => {
+    try {
+      event.currentTarget.setPointerCapture(event.pointerId);
+    } catch {
+      /* capture is a nicety */
+    }
+    pointers.current.set(event.pointerId, { x: event.clientX, y: event.clientY });
+  };
+  const onPointerMove = (event: PointerEvent<HTMLDivElement>) => {
+    const map = pointers.current;
+    const last = map.get(event.pointerId);
+    if (!last || !box.current) return;
+    const next = { x: event.clientX, y: event.clientY };
+    if (map.size === 1) {
+      update(panCrop(current.current, next.x - last.x, next.y - last.y, box.current.clientWidth, decoded));
+    } else if (map.size === 2) {
+      const other = Array.from(map.entries()).find(([id]) => id !== event.pointerId)?.[1];
+      if (other) {
+        const before = Math.hypot(last.x - other.x, last.y - other.y);
+        const after = Math.hypot(next.x - other.x, next.y - other.y);
+        if (before > 0 && after > 0) update(zoomCrop(current.current, after / before, decoded));
+      }
+    }
+    map.set(event.pointerId, next);
+  };
+  const onPointerEnd = (event: PointerEvent<HTMLDivElement>) => {
+    pointers.current.delete(event.pointerId);
+  };
+  /* Keyboard: arrows move the photo, + and - zoom. */
+  const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+    const width = box.current?.clientWidth ?? 300;
+    const step = 12;
+    const moves: Record<string, [number, number]> = { ArrowLeft: [step, 0], ArrowRight: [-step, 0], ArrowUp: [0, step], ArrowDown: [0, -step] };
+    if (moves[event.key]) {
+      event.preventDefault();
+      update(panCrop(current.current, moves[event.key][0], moves[event.key][1], width, decoded));
+    } else if (event.key === "+" || event.key === "=" || event.key === "-") {
+      event.preventDefault();
+      update(zoomCrop(current.current, event.key === "-" ? 1 / 1.1 : 1.1, decoded));
+    }
+  };
+
+  return (
+    <div
+      ref={box}
+      data-clarity-mask="True"
+      data-tryon-crop
+      role="img"
+      aria-label={`${TRYON_COPY.ui.yourPhoto}. ${TRYON_COPY.crop.hint}`}
+      tabIndex={0}
+      onPointerDown={onPointerDown}
+      onPointerMove={onPointerMove}
+      onPointerUp={onPointerEnd}
+      onPointerCancel={onPointerEnd}
+      onKeyDown={onKeyDown}
+      className="relative aspect-[3/4] w-full cursor-grab select-none overflow-hidden bg-nf-ink active:cursor-grabbing"
+      style={{ touchAction: "none" }}
+    >
+      <canvas ref={canvas} className="block h-full w-full" />
+      {/* Hairline guides at the thirds, as a camera's grid. */}
+      <span aria-hidden="true" className="pointer-events-none absolute inset-0 border border-nf-gold/70" />
+      <span aria-hidden="true" className="pointer-events-none absolute inset-y-0 left-1/3 w-px bg-nf-ivory/25" />
+      <span aria-hidden="true" className="pointer-events-none absolute inset-y-0 left-2/3 w-px bg-nf-ivory/25" />
+      <span aria-hidden="true" className="pointer-events-none absolute inset-x-0 top-1/3 h-px bg-nf-ivory/25" />
+      <span aria-hidden="true" className="pointer-events-none absolute inset-x-0 top-2/3 h-px bg-nf-ivory/25" />
+      <span className="pointer-events-none absolute inset-x-0 bottom-3 mx-auto w-fit bg-nf-ivory/85 px-3 py-1.5 font-nf-label text-[10px] uppercase tracking-nf-16 text-nf-ink backdrop-blur-sm">
+        {TRYON_COPY.crop.hint}
+      </span>
+    </div>
+  );
+};
+
+/* Non-blocking hints: the photo can still be used as it is. */
+export const PhotoWarnings = ({ warnings, onRetake, onUseAnyway }: { warnings: PhotoWarning[]; onRetake: () => void; onUseAnyway: () => void }) => (
+  <div className="space-y-3">
+    <div className="space-y-1.5 border-l-2 border-nf-gold bg-nf-ivory-deep/70 px-3 py-2.5 text-[13px] leading-[1.6] text-nf-ink">
+      {warnings.map((w) => (
+        <p key={w}>{TRYON_COPY.warnings[w]}</p>
+      ))}
+    </div>
+    <div className="grid grid-cols-2 gap-2.5">
+      <button type="button" onClick={onRetake} className={outlineButton}>
+        {TRYON_COPY.warnings.retake}
+      </button>
+      <button type="button" onClick={onUseAnyway} className={primaryButton}>
+        {TRYON_COPY.warnings.useAnyway}
+      </button>
+    </div>
+  </div>
+);
