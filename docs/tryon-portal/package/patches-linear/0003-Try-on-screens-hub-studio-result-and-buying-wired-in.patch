+/*
+  The try-on's buttons and type, taken from the product page so the two read
+  as one shop: the ink Add to cart (h-[50px], label face, uppercase, 0.08em),
+  its outline twin, the gold-underlined text link and the small gold eyebrow.
+  Square corners throughout (the global radius is 0).
+*/
+
+export const primaryButton =
+  "press-scale inline-flex h-[50px] w-full items-center justify-center gap-2 bg-nf-ink px-4 font-nf-label text-[11.5px] font-medium uppercase tracking-nf-8 text-nf-ivory transition-colors duration-200 hover:bg-nf-ink/90 disabled:pointer-events-none disabled:opacity-60";
+
+export const outlineButton =
