+  const decoded = useRef<DecodedPhoto | null>(null);
+  const crop = useRef<CropRect | null>(null);
+  const dropDecoded = () => {
+    decoded.current?.close();
+    decoded.current = null;
+  };
+  useEffect(() => dropDecoded, []);
+
+  const onFile = async (file: File, source: PhotoSource) => {
+    tryonEvent(source === "camera" ? "tryon_photo_camera" : "tryon_photo_library");
