+import { useEffect, useRef, useState, type KeyboardEvent } from "react";
+import { Check } from "lucide-react";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { outlineButton, primaryButton, textLink } from "./styles";
+
+/*
+  Nothing leaves the phone until this box is ticked and "Create my try-on" is
+  tapped. The box always opens unticked; the version agreed to is kept for the
+  tab (session.ts) so a second piece does not ask again. The phone's back
+  closes the sheet (the studio gives it its own history entry), as it does
+  the bag. Focus goes to the title and stays inside the sheet while it is open.
+*/
+
+interface Props {
+  open: boolean;
+  onCreate: () => void;
+  onClose: () => void;
+}
+
+const ConsentSheet = ({ open, onCreate, onClose }: Props) => {
+  const [ticked, setTicked] = useState(false);
+  const titleRef = useRef<HTMLHeadingElement>(null);
+  const sheetRef = useRef<HTMLDivElement>(null);
+  const copy = TRYON_COPY.consent;
+
+  useEffect(() => {
+    if (!open) return;
+    setTicked(false);
+    titleRef.current?.focus();
+  }, [open]);
+
+  if (!open) return null;
+
+  const onKeyDown = (event: KeyboardEvent<HTMLDivElement>) => {
+    if (event.key === "Escape") {
+      event.preventDefault();
+      onClose();
+      return;
+    }
+    if (event.key !== "Tab" || !sheetRef.current) return;
+    const items = Array.from(sheetRef.current.querySelectorAll<HTMLElement>("a[href], button:not([disabled]), input:not([disabled])"));
+    if (!items.length) return;
+    const first = items[0];
+    const last = items[items.length - 1];
+    if (event.shiftKey && (document.activeElement === first || document.activeElement === titleRef.current)) {
+      event.preventDefault();
+      last.focus();
+    } else if (!event.shiftKey && document.activeElement === last) {
+      event.preventDefault();
+      first.focus();
+    }
+  };
+
+  return (
+    <>
+      <div className="fixed inset-0 z-[60] bg-nf-ink/40 backdrop-blur-sm" onClick={onClose} aria-hidden="true" />
+      <div
+        ref={sheetRef}
+        role="dialog"
+        aria-modal="true"
+        aria-labelledby="tryon-consent-title"
+        onKeyDown={onKeyDown}
+        className="fixed inset-x-0 bottom-0 z-[61] max-h-[92dvh] overflow-y-auto border-t border-nf-gold/40 bg-nf-ivory px-5 pb-[calc(1.25rem+env(safe-area-inset-bottom,0px))] pt-5 text-nf-ink md:inset-x-auto md:bottom-auto md:left-1/2 md:top-1/2 md:w-[520px] md:-translate-x-1/2 md:-translate-y-1/2 md:border md:px-8 md:pb-8 md:pt-7"
+      >
+        <span aria-hidden="true" className="mx-auto mb-4 block h-px w-10 bg-nf-gold md:hidden" />
+        <h2 id="tryon-consent-title" ref={titleRef} tabIndex={-1} className="font-cormorant text-[24px] font-semibold leading-tight outline-none">
+          {copy.title}
+        </h2>
+        <p className="mt-3 text-[13px] leading-[1.7] text-nf-ink/85">{copy.body}</p>
+        <a href={copy.href} target="_blank" rel="noopener" className={`mt-2 inline-flex min-h-[44px] items-center text-[12.5px] ${textLink}`}>
+          {copy.link}
+        </a>
+
+        <label className="mt-2 flex cursor-pointer items-start gap-3 border border-nf-gold/40 bg-nf-ivory-deep/60 p-3.5">
+          <span className="relative mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center">
+            <input
+              type="checkbox"
+              checked={ticked}
+              onChange={(event) => setTicked(event.target.checked)}
+              className="peer h-5 w-5 cursor-pointer appearance-none border border-nf-ink/60 bg-nf-ivory transition-colors checked:border-[var(--nf-cta)] checked:bg-[var(--nf-cta)]"
+            />
+            <Check size={14} strokeWidth={2.2} className="pointer-events-none absolute hidden text-nf-ivory peer-checked:block" aria-hidden="true" />
+          </span>
+          <span className="text-[13px] leading-[1.6] text-nf-ink">{copy.checkbox}</span>
+        </label>
+
+        <div className="mt-5 grid gap-2.5">
+          <button type="button" onClick={onCreate} disabled={!ticked} className={primaryButton}>
+            {copy.create}
+          </button>
+          <button type="button" onClick={onClose} className={outlineButton}>
+            {copy.notNow}
+          </button>
+        </div>
+      </div>
+    </>
+  );
+};
+
+export default ConsentSheet;
