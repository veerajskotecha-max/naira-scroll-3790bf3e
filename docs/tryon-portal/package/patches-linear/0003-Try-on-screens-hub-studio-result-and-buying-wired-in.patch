@@ -0,0 +1,54 @@
+import { useEffect } from "react";
+import { Navigate, useLocation, useParams } from "react-router-dom";
+import { Helmet } from "react-helmet-async";
+import Footer from "@/components/Footer";
+import TryOnHub from "@/components/tryon/TryOnHub";
+import TryOnStudio from "@/components/tryon/TryOnStudio";
+import { tryable } from "@/components/tryon/live";
+import { tryOnPiece } from "@/data/tryOnPieces";
+import { tryonEvent } from "@/lib/tryon/analytics";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+
+/*
+  /try-on (the hub) and /try-on/<handle> (one piece's studio), unlisted and
+  kept out of search through the pilot: shared from Instagram and ads, never
+  in the navigation or scripts/routes.ts (the prerenderer refuses noindex
+  pages). App.tsx keys the studio by handle, so each piece opens fresh.
+
+  An unknown handle, or one the owner has not certified on the real shop,
+  goes to the hub with its query kept (utm tags included), never to Coming
+  Soon. The header's flower stays still here (Navbar's productPage list), so
+  no three.js is fetched, and the slim footer leaves out the 3D box.
+*/
+const TryOn = () => {
+  const { handle } = useParams();
+  const { search } = useLocation();
+  const piece = handle ? tryOnPiece(handle) : undefined;
+  const allowed = piece ? tryable(piece) : false;
+
+  /* Naira's palette for the page and the dialogs it opens, as on the product page. */
+  useEffect(() => {
+    const root = document.documentElement;
+    root.classList.add("nf-next");
+    return () => root.classList.remove("nf-next");
+  }, []);
+
+  useEffect(() => {
+    if (!handle) tryonEvent("tryon_hub_opened");
+  }, [handle]);
+
+  if (handle && (!piece || !allowed)) return <Navigate to={{ pathname: "/try-on", search }} replace />;
+
+  return (
+    <div className="min-h-screen bg-nf-ivory pt-[107px] text-nf-ink md:pt-[114px] lg:pt-[132px]">
+      <Helmet>
+        <title>{TRYON_COPY.pageTitle}</title>
+        <meta name="robots" content="noindex,nofollow" />
+      </Helmet>
+      {piece ? <TryOnStudio piece={piece} /> : <TryOnHub />}
+      <Footer compact slim />
+    </div>
+  );
+};
+
+export default TryOn;
