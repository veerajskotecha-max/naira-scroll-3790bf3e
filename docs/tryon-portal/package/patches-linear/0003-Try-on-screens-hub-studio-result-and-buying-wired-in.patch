+import { useState } from "react";
+import type { TryOnPiece } from "@/data/tryOnPieces";
+import { tryonEvent } from "@/lib/tryon/analytics";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { overlayChip } from "./styles";
+
+/*
+  "See it on a model first": the owner-approved proof render of the piece on
+  a synthetic model, beside the model's own photo, as a press-and-hold
+  before and after. Static WebPs from public/tryon/demo, lazy. Nothing at all
+  until the owner has approved the piece's demo (manifest `demo: true`), so
+  no request is made for a file that does not exist yet.
+*/
+
+const DemoCompare = ({ piece }: { piece: TryOnPiece }) => {
+  const [before, setBefore] = useState(false);
+  const [seen, setSeen] = useState(false);
+  if (!piece.demo || !piece.certified) return null;
+  const hold = (down: boolean) => {
+    setBefore(down);
+    if (down && !seen) {
+      setSeen(true);
+      tryonEvent("tryon_demo_viewed");
+    }
+  };
+  const model = piece.kind === "hand" ? "/tryon/demo/model-hand.webp" : "/tryon/demo/model-face.webp";
+  return (
+    <section aria-labelledby="tryon-demo" className="mt-6">
+      <h2 id="tryon-demo" className="font-cormorant text-[19px] leading-none text-nf-ink">
+        {TRYON_COPY.studio.demo}
+      </h2>
+      <div
+        className="relative mt-3 aspect-[3/4] w-full max-w-[300px] select-none overflow-hidden bg-nf-ivory-deep"
+        style={{ WebkitTouchCallout: "none" }}
+        onPointerDown={() => hold(true)}
+        onPointerUp={() => hold(false)}
+        onPointerLeave={() => hold(false)}
+        onPointerCancel={() => hold(false)}
+        onContextMenu={(event) => event.preventDefault()}
+      >
+        <img src={`/tryon/demo/${piece.handle}.webp`} alt={TRYON_COPY.ui.previewAlt(piece.name)} width={900} height={1200} loading="lazy" decoding="async" className="h-full w-full object-cover" />
+        <img src={model} alt="" width={900} height={1200} loading="lazy" decoding="async" className={`absolute inset-0 h-full w-full object-cover ${before ? "opacity-100" : "opacity-0"}`} />
+        <span className={`${overlayChip} absolute left-3 top-3`}>{TRYON_COPY.result.chip}</span>
+      </div>
+      <p className="mt-2 text-[11.5px] text-nf-ink/60">{TRYON_COPY.result.hold}</p>
+    </section>
+  );
+};
+
+export default DemoCompare;
