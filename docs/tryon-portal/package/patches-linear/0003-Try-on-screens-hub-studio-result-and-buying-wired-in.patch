--- /dev/null
+++ b/src/components/tryon/motion.ts
@@ -0,0 +1,27 @@
+import { useEffect, type RefObject } from "react";
+
+/*
+  The one moving thing on a waiting screen: a gold hairline gliding across.
+  Run with the Web Animations API (Safari 13.1+, Chrome 84+), so no keyframes
+  join the site's stylesheet for every page. Under reduced motion, or where
+  element.animate is missing, the line simply stays where its styles put it.
+*/
+
+export const prefersReducedMotion = () => {
+  try {
+    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+  } catch {
+    return false;
+  }
+};
+
+export const useSweep = (ref: RefObject<HTMLElement>, keyframes: Keyframe[], duration: number, active = true) => {
+  useEffect(() => {
+    const el = ref.current;
+    if (!active || !el || typeof el.animate !== "function" || prefersReducedMotion()) return;
+    const animation = el.animate(keyframes, { duration, iterations: Infinity, direction: "alternate", easing: "ease-in-out" });
+    return () => animation.cancel();
+    // The keyframes are literals at each call site.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [ref, duration, active]);
+};
diff --git a/src/components/tryon/studioState.ts b/src/components/tryon/studioState.ts
new file mode 100644
index 0000000..c3e76ae
--- /dev/null
+++ b/src/components/tryon/studioState.ts
@@ -0,0 +1,68 @@
+import type { TryOnStone } from "@/data/tryOnPieces";
+import type { ErrorCopy, TryOnError, TryOnErrorCode } from "@/lib/tryon/errors";
+import type { PhotoWarning } from "@/lib/tryon/photoChecks";
+import type { PhotoBlock } from "@/lib/tryon/preparePhoto";
+
+/*
+  The studio's steps, as the spec names them: intro → preparing → crop →
+  ready → consent → uploading → rendering → result, or failed(code). Pure, so
+  every transition is tested without a screen (TryOnPage.test.tsx).
+*/
+
+export type Notice = "cancelled" | "deleted";
+
+export type StudioState =
+  | { step: "intro"; notice?: Notice; block?: PhotoBlock; changing?: boolean }
+  | { step: "preparing" }
+  | { step: "crop" }
+  | { step: "ready"; warnings: PhotoWarning[]; notice?: Notice }
+  | { step: "consent"; warnings: PhotoWarning[] }
+  | { step: "uploading"; stone: TryOnStone | null; progress: number }
+  | { step: "rendering"; stone: TryOnStone | null; startedAt: number }
+  | { step: "result"; stone: TryOnStone | null }
+  | { step: "failed"; stone: TryOnStone | null; code: TryOnErrorCode; copy: ErrorCopy };
+
+export type StudioEvent =
+  | { type: "reset"; notice?: Notice; changing?: boolean }
+  | { type: "blocked"; block: PhotoBlock }
+  | { type: "preparing" }
+  | { type: "crop" }
+  | { type: "ready"; warnings?: PhotoWarning[]; notice?: Notice }
+  | { type: "consent" }
+  | { type: "upload"; stone: TryOnStone | null }
+  | { type: "progress"; fraction: number }
+  | { type: "uploaded"; at: number }
+  | { type: "result"; stone: TryOnStone | null }
+  | { type: "failed"; error: TryOnError };
+
+const stoneOf = (state: StudioState): TryOnStone | null =>
+  state.step === "uploading" || state.step === "rendering" || state.step === "result" || state.step === "failed" ? state.stone : null;
+
+export const studioReducer = (state: StudioState, event: StudioEvent): StudioState => {
+  switch (event.type) {
+    case "reset":
+      return { step: "intro", notice: event.notice, changing: event.changing };
+    case "blocked":
+      return { step: "intro", block: event.block, changing: true };
+    case "preparing":
+      return { step: "preparing" };
+    case "crop":
+      return { step: "crop" };
+    case "ready":
+      return { step: "ready", warnings: event.warnings ?? [], notice: event.notice };
+    case "consent":
+      return { step: "consent", warnings: state.step === "ready" ? state.warnings : [] };
+    case "upload":
+      return { step: "uploading", stone: event.stone, progress: 0 };
+    case "progress":
+      return state.step === "uploading" ? { ...state, progress: Math.max(state.progress, Math.min(1, event.fraction)) } : state;
+    case "uploaded":
+      return state.step === "uploading" ? { step: "rendering", stone: state.stone, startedAt: event.at } : state;
+    case "result":
+      return { step: "result", stone: event.stone };
+    case "failed":
+      /* Cancel goes back to the photo, which is still here. */
+      if (event.error.code === "cancelled") return { step: "ready", warnings: [], notice: "cancelled" };
+      return { step: "failed", stone: stoneOf(state), code: event.error.code, copy: event.error.copy };
+  }
+};
