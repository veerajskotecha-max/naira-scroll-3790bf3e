--- /dev/null
+++ b/src/components/tryon/TryOnResult.tsx
@@ -0,0 +1,346 @@
+import { useCallback, useEffect, useRef, useState, type ReactNode } from "react";
+import { X } from "lucide-react";
+import type { TryOnPiece } from "@/data/tryOnPieces";
+import { useBackToClose } from "@/hooks/useBackToClose";
+import { shopifyImage } from "@/lib/shopifyImage";
+import { tryonEvent } from "@/lib/tryon/analytics";
+import { sendFeedback } from "@/lib/tryon/client";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { SCENE_GUARD_MODE, sceneGuard, type SceneBucket, type SceneVerdict } from "@/lib/tryon/sceneGuard";
+import { onTryOnSessionCleared, releaseObjectUrl, type SessionPhoto, type SessionResult } from "@/lib/tryon/session";
+import { prepareShare, pressHoldUrl, saveMode, saveTryOnPhoto, shareTryOn, whatsappUrlFor, type SharePlan } from "@/lib/tryon/share";
+import { outlineButton, overlayChip, primaryButton, quietButton, smallButton } from "./styles";
+
+/*
+  The preview, labelled for what it is: an "AI preview" chip, the piece's
+  listed size, and the real piece one tap away. Pressing and holding (or
+  "Show my photo") shows the shopper's own photo in its place, so she can see
+  that only the piece was added.
+
+  The image is the reply's Blob behind a blob: URL (session.ts), inside a
+  container session recordings mask. Once on screen, the scene check runs in
+  idle time; in 'log' mode it only reports, and its bucket travels with the
+  "Does this look like the piece?" answer. A preview never answered still
+  reports its bucket when the session clears (Delete, leaving, 30 minutes):
+  the server keeps only the first answer for a render, so it is sent once.
+*/
+
+/* Per render, across visits to the same preview this tab. */
+const scenes = new Map<string, SceneVerdict | null>();
+const answers = new Map<string, boolean>();
+const unsent = new Map<string, SceneBucket>();
+let flushing = false;
+const flushOnClear = () => {
+  if (flushing) return;
+  flushing = true;
+  onTryOnSessionCleared(() => {
+    for (const [renderId, scene] of unsent) sendFeedback(renderId, { looksRight: null, scene });
+    unsent.clear();
+  });
+};
+
+const answer = (renderId: string | null, looksRight: boolean, scene: SceneBucket | null) => {
+  if (!renderId || answers.has(renderId)) return;
+  answers.set(renderId, looksRight);
+  unsent.delete(renderId);
+  sendFeedback(renderId, { looksRight, scene });
+};
+
+interface Props {
+  piece: TryOnPiece;
+  result: SessionResult;
+  photo: SessionPhoto | undefined;
+  remaining: number | null;
+  /** The stone picked in the strip, when it differs from the one in the preview. */
+  otherStone: string | null;
+  onTryStone: (stone: string) => void;
+  onTryAgain: () => void;
+  onDelete: () => void;
+  onRealPiece: () => void;
+  /** Strict scene guard only: the preview must not be shown. */
+  onBlocked: () => void;
+  buy: ReactNode;
+  layout: (frame: ReactNode, controls: ReactNode) => ReactNode;
+}
+
+const TryOnResult = ({ piece, result, photo, remaining, otherStone, onTryStone, onTryAgain, onDelete, onRealPiece, onBlocked, buy, layout }: Props) => {
+  const [holding, setHolding] = useState(false);
+  const [showMine, setShowMine] = useState(false);
+  const [compared, setCompared] = useState(false);
+  const [scene, setScene] = useState<SceneVerdict | null>(() => scenes.get(result.url) ?? null);
+  const [answered, setAnswered] = useState<boolean | undefined>(() => (result.renderId ? answers.get(result.renderId) : undefined));
+  const [plan, setPlan] = useState<SharePlan | null>(null);
+  const [shareFallback, setShareFallback] = useState(false);
+  const [holdUrl, setHoldUrl] = useState<string | null>(null);
+  const held = useRef<string | null>(null);
+  const openHold = (url: string) => {
+    held.current = url;
+    setHoldUrl(url);
+  };
+  const closeHold = useCallback(() => {
+    if (held.current) releaseObjectUrl(held.current);
+    held.current = null;
+    setHoldUrl(null);
+  }, []);
+  const holdView = useBackToClose(
+    "nfTryonSave",
+    Boolean(holdUrl),
+    useCallback((open: boolean) => (open ? undefined : closeHold()), [closeHold]),
+  );
+  /* A quick tap or the start of a scroll must not flash the original. */
+  const holdTimer = useRef<number | undefined>(undefined);
+
+  /* The scene check, once per preview, after it is on screen. */
+  useEffect(() => {
+    if (!photo) return;
+    if (scenes.has(result.url)) {
+      setScene(scenes.get(result.url) ?? null);
+      return;
+    }
+    let cancelled = false;
+    const run = () => {
+      void sceneGuard(photo.blob, result.blob, SCENE_GUARD_MODE).then((verdict) => {
+        scenes.set(result.url, verdict);
+        if (verdict?.bucket === "high") tryonEvent("tryon_scene_high");
+        if (verdict && result.renderId && !answers.has(result.renderId)) {
+          unsent.set(result.renderId, verdict.bucket);
+          flushOnClear();
+        }
+        if (cancelled) return;
+        setScene(verdict);
+        if (verdict?.blocked) onBlocked();
+      });
+    };
+    const idle = (window as unknown as { requestIdleCallback?: (cb: () => void, opts?: { timeout: number }) => number }).requestIdleCallback;
