+  const acceptPhoto = async () => {
+    const source = decoded.current;
+    if (!source) {
+      dispatch({ type: "reset", changing: true });
+      return;
+    }
+    dispatch({ type: "preparing" });
+    try {
+      const prepared = await encodePhoto(source, crop.current ?? initialCrop(source));
+      dropDecoded();
+      setPhoto(setTryOnPhoto(kind, prepared.blob, prepared));
+      for (const w of prepared.warnings) tryonEvent(w === "dark" ? "tryon_photo_warn_dark" : "tryon_photo_warn_soft");
+      if (prepared.warnings.length) dispatch({ type: "ready", warnings: prepared.warnings });
+      else proceed();
+    } catch (error) {
+      dropDecoded();
+      const block = error instanceof PhotoPrepError ? error.code : "unsupported";
+      if (block === "too_small") tryonEvent("tryon_photo_blocked_small");
+      dispatch({ type: "blocked", block });
+    }
+  };
+
+  const reuse = () => {
+    tryonEvent("tryon_photo_reused");
+    proceed();
+  };
+
+  /* ---- consent sheet: its own history entry, closed by the phone's back ---- */
+  const consentOpen = state.step === "consent";
+  const onConsentOpenChange = useCallback((open: boolean) => {
+    // Only the sheet's own close returns to the photo; a render already under way stays.
+    if (!open && stepRef.current === "consent") dispatch({ type: "ready" });
+  }, []);
+  const consent = useBackToClose("nfTryonConsent", consentOpen, onConsentOpenChange);
+  const createTryOn = () => {
+    recordTryOnConsent();
+    tryonEvent("tryon_consent_given");
+    consent.closeThen(() => startRender(stone));
+  };
+
+  /* ---- the real piece: the listing's own photos and size guide ---- */
+  const [realOpen, setRealOpen] = useState(false);
+  const real = useBackToClose("nfTryonZoom", realOpen, setRealOpen);
+  const openReal = () => {
+    setRealOpen(true);
+    tryonEvent("tryon_real_piece_opened");
+  };
+
+  /* ---- stone ---- */
+  const setStone = (value: TryOnStone) => {
+    const next = new URLSearchParams(searchParams);
+    next.set("colour", value.toLowerCase());
+    setSearchParams(next, { replace: true });
+    // A preview already made in that stone is shown at once.
+    if (state.step === "result" && getTryOnResult(piece.handle, value)) dispatch({ type: "result", stone: value });
+  };
+
+  /* ---- focus follows the step ---- */
+  const firstStep = useRef(true);
+  useLayoutEffect(() => {
+    if (firstStep.current) {
+      firstStep.current = false;
+      return;
+    }
+    const heading = document.getElementById("tryon-step");
+    if (heading) {
+      try {
+        heading.focus({ preventScroll: true });
+      } catch {
+        heading.focus();
+      }
+    }
+    /* Bring the step into view under the fixed header: its picture where the
+       phone shows one, else its heading. */
+    const stage = document.getElementById("tryon-stage");
+    const target = stage && stage.getClientRects().length ? stage : heading;
+    if (!target) return;
+    const top = target.getBoundingClientRect().top;
+    if (top < 100 || top > window.innerHeight * 0.55) window.scrollTo({ top: Math.max(0, window.scrollY + top - 118), behavior: "auto" });
+  }, [state.step]);
+
+  const result = useMemo(
+    () => (state.step === "result" && photo ? getTryOnResult(piece.handle, state.stone) : undefined),
+    [state, photo, piece.handle],
+  );
+
+  /* ---- what each step shows ---- */
+  const strip = (
+    <PieceStrip
+      piece={piece}
+      live={live}
+      stone={stone}
+      onStone={setStone}
+      stonesLocked={state.step === "uploading" || state.step === "rendering"}
+      onRealPiece={openReal}
+    />
+  );
+  const layout = (frame: ReactNode, controls: ReactNode, frameOnPhone = true) => (
+    <StudioLayout strip={strip} frame={frame} controls={controls} frameOnPhone={frameOnPhone} />
+  );
+  const deleteButton = photo ? (
+    <button type="button" onClick={deletePhoto} className={quietButton}>
+      {TRYON_COPY.result.delete}
+    </button>
+  ) : null;
+  const pieceHref = `/jewellery/${piece.handle}${stone ? `?colour=${stone.toLowerCase()}` : ""}`;
+
+  const act = (action: ErrorAction | null | undefined, primary: boolean) => {
+    if (!action) return null;
+    const className = primary ? primaryButton : outlineButton;
+    if (action === "view_piece") {
+      return (
+        <Link key={action} to={pieceHref} className={className}>
+          {actionLabel(action)}
+        </Link>
+      );
+    }
+    const onClick = action === "choose_photo" ? () => dispatch({ type: "reset", changing: true }) : () => startRender(stone);
+    return (
+      <button key={action} type="button" onClick={onClick} className={className}>
+        {actionLabel(action)}
+      </button>
+    );
+  };
+
+  let body: ReactNode;
+  switch (state.step) {
+    case "intro": {
+      const frame = <EmptyFrame hand={hand} />;
+      const controls = (
+        <div className="space-y-4">
+          {state.notice === "deleted" && (
+            <p role="status" className="border-l-2 border-nf-gold bg-nf-ivory-deep/70 px-3 py-2.5 text-[13px] text-nf-ink">
+              {TRYON_COPY.deleted}
+            </p>
+          )}
+          <PhotoPicker
+            kind={kind}
+            held={photo}
+            changing={Boolean(state.changing)}
+            block={state.block}
+            disabled={soldOut}
+            onFile={onFile}
+            onReuse={reuse}
+            onChange={() => dispatch({ type: "reset", changing: true })}
+          />
+          {soldOut && <TryOnBuy piece={piece} live={live} stone={stone} />}
+          <p className="text-[12px] leading-[1.65] text-nf-ink/75">
+            {TRYON_COPY.trust.line}{" "}
+            <a href={TRYON_COPY.trust.href} target="_blank" rel="noopener" className="text-nf-ink underline decoration-nf-gold underline-offset-4">
+              {TRYON_COPY.trust.link}
+            </a>
+          </p>
+          <PhotoGuide guide={piece.guide} />
+          <DemoCompare piece={piece} />
+          {photo && <div className="flex justify-end">{deleteButton}</div>}
+        </div>
+      );
+      body = layout(frame, controls, false);
+      break;
+    }
+    case "preparing":
+      body = layout(<PreparingFrame hand={hand} />, null);
+      break;
+    case "crop": {
+      const source = decoded.current;
+      body = source
+        ? layout(
+            <CropFrame decoded={source} initial={crop.current ?? initialCrop(source)} onCrop={(next) => (crop.current = next)} />,
+            <div className="space-y-3">
+              {/* The frame shows the hint; screen readers get it as the step's heading. */}
+              <h2 id="tryon-step" tabIndex={-1} className="sr-only">
+                {TRYON_COPY.crop.hint}
+              </h2>
+              <button type="button" onClick={acceptPhoto} className={primaryButton}>
+                {TRYON_COPY.crop.use}
+              </button>
+              <button
+                type="button"
+                onClick={() => {
+                  dropDecoded();
+                  dispatch({ type: "reset", changing: true });
+                }}
+                className={outlineButton}
+              >
+                {TRYON_COPY.crop.another}
+              </button>
+            </div>,
+          )
+        : null;
+      break;
+    }
+    case "ready":
+    case "consent": {
+      const warnings = state.warnings;
+      const notice = state.step === "ready" ? state.notice : undefined;
+      const frame = photo ? (
+        <div className="relative aspect-[3/4] w-full overflow-hidden bg-nf-ivory-deep" data-clarity-mask="True">
+          <img src={photo.url} alt={TRYON_COPY.ui.yourPhoto} width={900} height={1200} className="h-full w-full object-cover" />
+        </div>
+      ) : (
+        <EmptyFrame hand={hand} />
+      );
+      const controls = (
+        <div className="space-y-3">
+          <h2 id="tryon-step" tabIndex={-1} className="sr-only">
+            {TRYON_COPY.ui.yourPhoto}
+          </h2>
+          {notice === "cancelled" && (
+            <p role="status" className="border-l-2 border-nf-gold bg-nf-ivory-deep/70 px-3 py-2.5 text-[13px] text-nf-ink">
+              {TRYON_COPY.cancelled}
+            </p>
+          )}
+          {warnings.length ? (
+            <PhotoWarnings warnings={warnings} onRetake={() => dispatch({ type: "reset", changing: true })} onUseAnyway={proceed} />
+          ) : (
+            <>
+              <button type="button" onClick={proceed} disabled={soldOut} className={primaryButton}>
+                {TRYON_COPY.consent.create}
+              </button>
+              <button type="button" onClick={() => dispatch({ type: "reset", changing: true })} className={outlineButton}>
+                {TRYON_COPY.reuse.change}
+              </button>
+            </>
+          )}
+          {soldOut && <TryOnBuy piece={piece} live={live} stone={stone} />}
+          <div className="flex justify-end">{deleteButton}</div>
+        </div>
+      );
+      body = layout(frame, controls);
+      break;
+    }
+    case "uploading":
+    case "rendering":
+      body = (
+        <RenderingState
+          piece={piece}
+          photoUrl={photo?.url}
+          phase={state.step}
+          progress={state.step === "uploading" ? state.progress : 1}
+          startedAt={state.step === "rendering" ? state.startedAt : null}
+          onCancel={() => watched?.controller.abort()}
+          buy={
+            <div className="border border-nf-gold/30 bg-nf-ivory-deep/40 p-4">
+              <TryOnBuy piece={piece} live={live} stone={state.stone} withCard />
+            </div>
+          }
+          quiet={<div className="flex justify-end">{deleteButton}</div>}
+          layout={layout}
+        />
+      );
+      break;
+    case "result": {
+      if (!result) {
+        body = null;
+        break;
+      }
+      const otherStone = piece.stones && stone && stone !== state.stone ? stone : null;
+      body = (
+        <ResultBoundary
+          fallback={layout(
+            <div className="relative aspect-[3/4] w-full overflow-hidden bg-nf-ivory-deep" data-clarity-mask="True">
+              <img src={result.url} alt={TRYON_COPY.ui.previewAlt(piece.name)} width={900} height={1200} className="h-full w-full object-cover" />
+              <span className={`${overlayChip} absolute left-3 top-3`}>{TRYON_COPY.result.chip}</span>
+            </div>,
+            <div className="space-y-4">
+              <h2 id="tryon-step" tabIndex={-1} className="sr-only">
+                {`${TRYON_COPY.result.chip} · ${piece.name}`}
+              </h2>
+              <p className="text-[12px] text-nf-ink/80">{TRYON_COPY.result.shownAt(piece.sizeLine)}</p>
+              <TryOnBuy piece={piece} live={live} stone={state.stone} />
+              <p className="font-nf-editorial text-[14px] italic leading-[1.55] text-nf-ink/70">{TRYON_COPY.result.note}</p>
+              <div className="flex justify-end">{deleteButton}</div>
+            </div>,
+          )}
+        >
+          <Suspense fallback={layout(<div className="aspect-[3/4] w-full bg-nf-ivory-deep" />, null)}>
+            <TryOnResult
+              key={result.url}
+              piece={piece}
+              result={result}
+              photo={photo}
+              remaining={lastRemaining}
+              otherStone={otherStone}
+              onTryStone={(value) => startRender(value as TryOnStone)}
+              onTryAgain={() => startRender(stone)}
+              onDelete={deletePhoto}
+              onRealPiece={openReal}
+              onBlocked={() => dispatch({ type: "failed", error: new TryOnError("fidelity_failed") })}
+              buy={<TryOnBuy piece={piece} live={live} stone={stone} stoneDiffers={Boolean(otherStone)} />}
+              layout={layout}
+            />
+          </Suspense>
+        </ResultBoundary>
+      );
+      break;
+    }
+    case "failed": {
+      const frame = photo ? (
+        <div className="relative aspect-[3/4] w-full overflow-hidden bg-nf-ivory-deep" data-clarity-mask="True">
+          <img src={photo.url} alt={TRYON_COPY.ui.yourPhoto} width={900} height={1200} className="h-full w-full object-cover opacity-60" />
+        </div>
+      ) : (
+        <EmptyFrame hand={hand} />
+      );
+      const controls = (
+        <div className="space-y-3" data-tryon-error={state.code}>
+          <h2 id="tryon-step" tabIndex={-1} role="alert" className="border-l-2 border-nf-gold bg-nf-ivory-deep/70 px-3.5 py-3 font-nf-editorial text-[18px] leading-snug text-nf-ink outline-none">
+            {state.copy.message}
+          </h2>
+          {act(state.copy.action, true)}
+          {act(state.copy.secondary, false)}
+          <div className="mt-2 border-t border-nf-gold/25 pt-5">
+            <TryOnBuy piece={piece} live={live} stone={stone} />
+          </div>
+          <div className="flex justify-end">{deleteButton}</div>
+        </div>
+      );
+      // On a phone the message comes straight after the piece; the photo is not the news.
+      body = layout(frame, controls, false);
+      break;
+    }
+  }
+
+  return (
+    <div className="mx-auto max-w-[1180px] px-4 pb-16 pt-3 sm:px-6 md:pt-6">
+      <div className="flex items-center justify-between gap-3">
+        <Link to="/try-on" className="-ml-1 inline-flex min-h-[44px] items-center gap-1.5 px-1 font-nf-label text-[10.5px] uppercase tracking-nf-16 text-nf-ink/75 transition-colors hover:text-nf-ink">
+          <ArrowLeft size={14} strokeWidth={1.6} aria-hidden="true" />
+          {TRYON_COPY.studio.back}
+        </Link>
+      </div>
+      <h1 className="mb-3 font-cormorant text-[26px] font-semibold leading-none text-nf-ink md:mb-5 md:text-[34px]">{TRYON_COPY.hub.title}</h1>
+
+      {body}
+
+      {state.step === "result" && <TryAnotherRail current={piece} stone={stone} jewellery={jewellery} isLive={isLive} />}
+
+      <ConsentSheet open={consentOpen} onCreate={createTryOn} onClose={consent.requestClose} />
+      <ImageLightbox
+        images={realPiecePhotos(piece, live, stone)}
+        name={piece.name}
+        open={realOpen}
+        onOpenChange={(open) => (open ? setRealOpen(true) : real.requestClose())}
+      />
+    </div>
+  );
+};
+
+export default TryOnStudio;
diff --git a/src/components/tryon/live.ts b/src/components/tryon/live.ts
new file mode 100644
index 0000000..bd00790
--- /dev/null
+++ b/src/components/tryon/live.ts
@@ -0,0 +1,67 @@
+import type { JewelPiece } from "@/data/jewellery";
+import { isAdjustableRing } from "@/data/ringFit";
+import type { TryOnPiece } from "@/data/tryOnPieces";
+import { firstBuyable } from "@/lib/variants";
+
+/*
+  What the try-on reads from the live catalogue (useLiveJewellery), and the
+  one rule for which pieces a shopper is shown.
+
+  Prices and stock come only from the live catalogue: the bundled first-paint
+  data is a snapshot and can be out of date, so nothing is added to the bag
+  until Shopify has answered (TryOnBuy), and a piece that has sold out since
+  the snapshot is hidden as soon as it has.
+*/
+
+/** The live listing for a piece, once Shopify has answered; never the bundled snapshot. */
+export const livePiece = (jewellery: JewelPiece[], isLive: boolean, handle: string): JewelPiece | undefined =>
+  isLive ? jewellery.find((j) => j.handle === handle) : undefined;
+
+/** Sold out on the live listing. An open-back ring adjusts to every size it offers, so it never reads as sold out here (as on its product page). */
+export const liveSoldOut = (piece: JewelPiece | undefined) => Boolean(piece && piece.availableForSale === false && !isAdjustableRing(piece));
+
+/** The real shop, by index.html's hostname allowlist; previews and localhost are not. */
+export const onRealShop = () => typeof window !== "undefined" && (window as unknown as { __nairaProd?: unknown }).__nairaProd === true;
+
+/**
+ * Whether a piece may be tried on: certified by the owner, or any piece off the
+ * real shop (labelled Uncertified there, for testing).
+ */
+export const tryable = (piece: TryOnPiece) => Boolean(piece.certified) || !onRealShop();
+
+/**
+ * Whether a piece is listed: tryable, and not sold out or unlisted on the live
+ * catalogue. Before Shopify answers, every tryable piece shows.
+ */
+export const listed = (piece: TryOnPiece, jewellery: JewelPiece[], isLive: boolean) => {
+  if (!tryable(piece)) return false;
+  if (!isLive) return true;
+  const live = livePiece(jewellery, isLive, piece.handle);
+  return Boolean(live) && !liveSoldOut(live);
+};
+
+/**
+ * A piece as the shopper has it chosen: in a stone, the stone's own photo
+ * (Shopify's photo for that variant) and the price of its first buyable
+ * variant; otherwise the listing's price. Undefined until Shopify has answered.
+ *
+ * Read straight from the variants rather than through colourCards: a second
+ * importer would split that module out of the chunk the shop grid shares, and
+ * every listing page would fetch one more file.
+ */
+export const pieceInStone = (live: JewelPiece | undefined, stone: string | null) => {
+  if (!live) return undefined;
+  const ways = stone ? (live.variants ?? []).filter((v) => v.options.Stone === stone) : [];
+  if (!ways.length) return { image: undefined, priceLabel: live.priceLabel };
+  const lead = firstBuyable(ways);
+  return { image: ways.find((v) => v.image)?.image, priceLabel: `₹${lead.price.toLocaleString("en-IN")}` };
+};
+
+/** The real piece's photos for the lightbox: the chosen stone's first, then the listing's gallery, size guide last. */
+export const realPiecePhotos = (piece: TryOnPiece, live: JewelPiece | undefined, stone: string | null): string[] => {
+  const lead = pieceInStone(live, stone)?.image;
+  const base = live?.gallery?.length ? live.gallery : [live?.image ?? piece.image];
+  const path = (url: string) => url.split("?")[0];
+  const all = lead ? [lead, ...base.filter((url) => path(url) !== path(lead))] : base;
+  return live?.sizeGuide && !all.some((url) => path(url) === path(live.sizeGuide as string)) ? [...all, live.sizeGuide] : all;
+};
