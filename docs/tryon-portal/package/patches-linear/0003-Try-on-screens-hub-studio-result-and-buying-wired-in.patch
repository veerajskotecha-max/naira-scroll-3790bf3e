+// @vitest-environment node
+import { describe, expect, it } from "vitest";
+import { ERROR_STATUS, PAUSED_REASONS, PHOTO_REASONS, RETRYABLE } from "../../../supabase/functions/tryon/errors";
+import { EXPOSED_HEADERS, TIMEOUTS } from "../../../supabase/functions/tryon/handler";
+import { CONSENT_VERSION as SERVER_CONSENT } from "../../../supabase/functions/tryon/prompt";
+import {
+  PAUSED_REASONS as CLIENT_PAUSED,
+  PHOTO_UNUSABLE_REASONS as CLIENT_PHOTO,
+  SERVER_ERROR_CODES,
+  TryOnError,
+  errorCopy,
+  errorFromResponse,
+} from "@/lib/tryon/errors";
+import { CONSENT_VERSION as SESSION_CONSENT } from "@/lib/tryon/session";
+import { TRYON_TIMEOUT_MS } from "@/lib/tryon/client";
+import { TRY_ON_CONSENT_VERSION } from "@/data/tryOnPieces";
+
+/*
+  The two halves of the try-on were written apart (the edge function, the
+  browser libraries) and meet only over HTTP. These hold them to one
+  contract, so a code, reason or version added on one side cannot leave the
+  other showing "Something went wrong" for it, or refusing every request.
+*/
+describe("browser and function agree", () => {
+  it("on every error code, and on each code's status", () => {
+    expect([...SERVER_ERROR_CODES].sort()).toEqual(Object.keys(ERROR_STATUS).sort());
+    for (const [code, status] of Object.entries(ERROR_STATUS)) {
+      // The browser reads the body's code first; the status alone maps to the same code or, for shared statuses, a sibling.
+      expect(errorFromResponse(status, { code }).code).toBe(code);
+    }
+  });
+
+  it("on every photo and pause reason, and each has its own words", () => {
+    expect([...CLIENT_PHOTO]).toEqual([...PHOTO_REASONS]);
+    expect([...CLIENT_PAUSED]).toEqual([...PAUSED_REASONS]);
+    for (const reason of PHOTO_REASONS) expect(errorCopy("photo_unusable", reason).message.length).toBeGreaterThan(10);
+  });
+
+  it("on which errors may simply be tried again", () => {
+    for (const [code, retryable] of Object.entries(RETRYABLE)) {
+      expect([code, new TryOnError(code as never, { retryable }).retryable]).toEqual([code, retryable]);
+      if (retryable) expect([code, errorCopy(code as never).action]).toEqual([code, "try_again"]);
+    }
+  });
+
+  it("on the consent notice version", () => {
+    expect(SESSION_CONSENT).toBe(SERVER_CONSENT);
+    expect(TRY_ON_CONSENT_VERSION).toBe(SERVER_CONSENT);
+  });
+
+  /* The browser must outwait the function, or a slow success reads as a timeout and is paid for twice. */
+  it("on time: the browser gives up after the function's own deadline", () => {
+    expect(TRYON_TIMEOUT_MS).toBeGreaterThan(TIMEOUTS.deadline);
+    expect(TRYON_TIMEOUT_MS - TIMEOUTS.deadline).toBeLessThanOrEqual(10_000);
+  });
+
+  it("on the headers the browser reads from a preview", () => {
+    expect(EXPOSED_HEADERS.split(/,\s*/).sort()).toEqual(["X-Tryon-Remaining", "X-Tryon-Render", "X-Tryon-Verified"]);
+  });
+});
