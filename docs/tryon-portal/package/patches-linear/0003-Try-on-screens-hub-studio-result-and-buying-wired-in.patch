+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { trackingCartAttributes } from "@/lib/shopify";
+import { markTried } from "@/lib/tryon/session";
+
+/*
+  An order carries naira_tryon (the pieces tried on in that tab) the way it
+  carries naira_visitor_id, so the owner can count orders the try-on led to.
+  cartAttributesUpdate replaces the whole set, so it must ride in the one list
+  with the others and never push them out.
+*/
+describe("the naira_tryon cart attribute", () => {
+  beforeEach(() => sessionStorage.clear());
+  afterEach(() => vi.restoreAllMocks());
+
+  it("is added only once a piece has been tried, beside the existing attributes", () => {
+    const before = trackingCartAttributes();
+    expect(before.some((a) => a.key === "naira_tryon")).toBe(false);
+    markTried("woven-gold-hoops");
+    markTried("baguette-huggies");
+    const after = trackingCartAttributes();
+    expect(after.find((a) => a.key === "naira_tryon")).toEqual({ key: "naira_tryon", value: "woven-gold-hoops,baguette-huggies" });
+    expect(after.filter((a) => a.key !== "naira_tryon")).toEqual(before);
+  });
+
+  it("carries handles only, 200 characters at most", () => {
+    for (const bad of ["<b>x</b>", "Woven Gold Hoops", "a".repeat(201), ""]) {
+      sessionStorage.setItem("naira_tryon", bad);
+      expect([bad, trackingCartAttributes().some((a) => a.key === "naira_tryon")]).toEqual([bad, false]);
+    }
+    sessionStorage.setItem("naira_tryon", "cushion-halo-ring");
+    const value = trackingCartAttributes().find((a) => a.key === "naira_tryon")?.value ?? "";
+    expect(value).toMatch(/^[a-z0-9,-]{1,200}$/);
+  });
+
+  it("never breaks the cart when storage is blocked", () => {
+    vi.spyOn(window, "sessionStorage", "get").mockImplementation(() => {
+      throw new Error("SecurityError");
+    });
+    expect(() => trackingCartAttributes()).not.toThrow();
+    expect(trackingCartAttributes().some((a) => a.key === "naira_tryon")).toBe(false);
+  });
+});
