+import { Link } from "react-router-dom";
+import { TRY_ON_ENTRY_LIVE, TRY_ON_LIVE_HANDLES } from "@/data/tryOnHandles";
+
+/*
+  The product page's "Try on" chip: a square ivory button under the wishlist
+  heart, a sibling of the gallery's slide buttons (never inside one). It
+  adds nothing to the first screen and imports only tryOnHandles.ts, so the
+  product page carries no try-on code. Nothing renders through the unlisted
+  pilot (TRY_ON_ENTRY_LIVE) or for a piece the owner has not certified.
+
+  The label is TRYON_COPY.pdpChip, written out here so the copy module stays
+  off the product page (routesAndWeight.test.ts keeps the two equal).
+*/
+
+export const TRY_ON_CHIP_LABEL = "Try on";
+
+/* JewelDetailNext's overlay button: square, like every corner on the site. */
+const overlayButton = "press-scale z-10 flex h-11 w-11 items-center justify-center bg-nf-ivory/75 backdrop-blur-sm";
+
+interface Props {
+  handle: string;
+  /** The stone or metal on screen, so the try-on opens on it. */
+  colour?: string;
+  /** Under the phone gallery's heart (top-3) or the desktop grid's (top-4). */
+  place: "mobile" | "desktop";
+}
+
+const TryOnEntry = ({ handle, colour, place }: Props) => {
+  if (!TRY_ON_ENTRY_LIVE || !TRY_ON_LIVE_HANDLES.has(handle)) return null;
+  const query = colour ? `?colour=${encodeURIComponent(colour.toLowerCase())}` : "";
+  return (
+    <Link
+      to={`/try-on/${handle}${query}`}
+      state={{ tryOnFrom: "pdp" }}
+      className={`${overlayButton} absolute right-4 ${place === "mobile" ? "top-[64px]" : "top-[68px]"}`}
+      aria-label={TRY_ON_CHIP_LABEL}
+      data-tryon-entry
+    >
+      <span className="text-center font-nf-label text-[8.5px] font-medium uppercase leading-[1.15] tracking-nf-8 text-nf-ink">{TRY_ON_CHIP_LABEL}</span>
+    </Link>
+  );
+};
+
+export default TryOnEntry;
