+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { act, fireEvent, render, screen, waitFor, within } from "@testing-library/react";
+import { MemoryRouter, Route, Routes, useLocation } from "react-router-dom";
+import { HelmetProvider } from "react-helmet-async";
+import { jewellery, type JewelPiece } from "@/data/jewellery";
+import { jewellerySnapshot } from "@/data/jewellerySnapshot";
+import { TryOnError } from "@/lib/tryon/errors";
+import { clearTryOnSession, liveObjectUrlCount, resetTryOnConsentForTest } from "@/lib/tryon/session";
+import { studioReducer, type StudioState } from "@/components/tryon/studioState";
+
+/*
+  The try-on's screens, driven as a shopper would, with the network, the
+  canvas and the bag stood in for (as bagOpensAtTap.test.tsx stands in for
+  Shopify). What they hold: nothing is sent before the unticked box is
+  ticked, consent is asked once per tab, Add opens the bag at the tap with
+  the variant shown, Buy now goes through CartContext.buyNow, the preview
+  is a blob: URL inside a masked container, and Delete leaves no URL alive.
+*/
+
+const mocks = vi.hoisted(() => ({
+  calls: [] as string[],
+  addItem: vi.fn(),
+  buyNow: vi.fn(),
+  setDrawerOpen: vi.fn(),
+  request: vi.fn(),
+  live: [] as unknown[],
+}));
+
+vi.mock("@/contexts/CartContext", () => ({
+  useCart: () => ({ addItem: mocks.addItem, buyNow: mocks.buyNow, setDrawerOpen: mocks.setDrawerOpen, isLoading: false }),
+}));
+vi.mock("@/hooks/useLiveJewellery", () => ({
+  useLiveJewellery: () => ({ jewellery: mocks.live, isLive: mocks.live.length > 0, isLoading: false }),
+}));
+vi.mock("@/components/Footer", () => ({ default: () => null }));
+vi.mock("@/lib/tryon/client", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/lib/tryon/client")>()),
+  requestTryOn: mocks.request,
+  sendFeedback: vi.fn(),
+}));
+vi.mock("@/lib/tryon/preparePhoto", async (importOriginal) => {
+  const real = await importOriginal<typeof import("@/lib/tryon/preparePhoto")>();
+  return {
+    ...real,
+    decodePhoto: vi.fn(async () => ({ image: {}, width: 1200, height: 1600, via: "img", close: vi.fn() })),
+    encodePhoto: vi.fn(async () => ({
+      blob: new Blob([new Uint8Array([0xff, 0xd8, 0xff, 0xe0])], { type: "image/jpeg" }),
+      width: 1152,
+      height: 1536,
+      warnings: [],
+      crop: { x: 0, y: 0, width: 1200, height: 1600 },
+      source: { width: 1200, height: 1600 },
+    })),
+    drawCrop: vi.fn(),
+  };
+});
+vi.mock("@/lib/tryon/sceneGuard", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/lib/tryon/sceneGuard")>()),
+  sceneGuard: vi.fn(async () => null),
+}));
+vi.mock("@/lib/tryon/share", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/lib/tryon/share")>()),
+  prepareShare: vi.fn(async () => ({ jpeg: null, file: null, canShareFiles: false, text: "", url: "", whatsappUrl: "https://wa.me/?text=x" })),
+}));
+
+import TryOn from "@/pages/TryOn";
+
+const firstPaint = (handle: string): JewelPiece => {
+  const found = jewellery.find((p) => p.handle === handle) ?? jewellerySnapshot.find((p) => p.handle === handle);
+  if (!found) throw new Error(handle);
+  return JSON.parse(JSON.stringify(found));
+};
+/* The live catalogue, with every variant in stock but the Eternity Band's Ruby US 5 (sold out today). */
+const liveCatalogue = () =>
+  ["woven-gold-hoops", "baguette-huggies", "baguette-eternity-band", "cushion-halo-ring", "brushed-gold-huggies"].map((handle) => {
+    const piece = firstPaint(handle);
+    piece.availableForSale = true;
+    for (const v of piece.variants ?? []) v.availableForSale = !(handle === "baguette-eternity-band" && v.options.Stone === "Ruby" && v.options.Size === "5");
+    return piece;
+  });
+
+const Where = () => {
+  const { pathname, search } = useLocation();
+  return <output data-testid="where">{pathname + search}</output>;
+};
+const open = (path: string) =>
+  render(
+    <HelmetProvider>
+      <MemoryRouter initialEntries={[path]}>
+        <Routes>
+          <Route path="/try-on" element={<TryOn />} />
+          <Route path="/try-on/:handle" element={<TryOn />} />
+        </Routes>
+        <Where />
+      </MemoryRouter>
+    </HelmetProvider>,
+  );
+
+const preview = () => new Blob([new Uint8Array([0x89, 0x50, 0x4e, 0x47])], { type: "image/png" });
+const reply = () => ({ blob: preview(), remaining: 4, verified: "pass" as const, renderId: "0f8fad5b-d9cb-469f-a165-70867728950e" });
+
+/* Pick a photo, frame it, and arrive at the consent sheet (or straight at the render once consent is given). */
+const addPhoto = async () => {
+  const input = document.querySelector('[data-tryon-input="library"]') as HTMLInputElement;
+  fireEvent.change(input, { target: { files: [new File([new Uint8Array([0xff, 0xd8, 0xff])], "me.jpg", { type: "image/jpeg" })] } });
+  await screen.findByRole("button", { name: "Use this photo" });
