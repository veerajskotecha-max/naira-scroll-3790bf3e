+import { useState, type SyntheticEvent } from "react";
+import { Plus } from "lucide-react";
+import type { TryOnGuide } from "@/data/tryOnPieces";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+
+/*
+  How to take the photo, before the shopper takes it: a face or hand pose in
+  gold hairline with the words beside it. Open on a first visit; once closed,
+  it stays closed (localStorage naira_tryon_tips), because a shopper trying a
+  second piece has read it already. Storage can throw (private mode, blocked
+  site data), so every read and write is guarded and the tips simply open.
+*/
+
+const TIPS_KEY = "naira_tryon_tips";
+
+const readClosed = () => {
+  try {
+    return window.localStorage.getItem(TIPS_KEY) === "closed";
+  } catch {
+    return false;
+  }
+};
+const writeClosed = (closed: boolean) => {
+  try {
+    if (closed) window.localStorage.setItem(TIPS_KEY, "closed");
+    else window.localStorage.removeItem(TIPS_KEY);
+  } catch {
+    /* only the remembering is lost */
+  }
+};
+
+/* Head and shoulders, hair tucked behind the ears: the dotted marks show where
+   earrings sit and where a chain falls. Shapes are filled with the ground so
+   the lines they cover stay hidden. */
+export const FacePose = ({ className }: { className?: string }) => (
+  <svg viewBox="0 0 120 150" className={className} fill="none" stroke="currentColor" strokeWidth={1} strokeLinecap="round" strokeLinejoin="round" aria-hidden="true">
+    <path d="M50 84v16M70 84v16" />
