@@ -0,0 +1,86 @@
+import { useNavigate } from "react-router-dom";
+import type { JewelPiece } from "@/data/jewellery";
+import { TRY_ON_PIECES, type TryOnPiece } from "@/data/tryOnPieces";
+import { matchScore } from "@/lib/pairings";
+import { shopifyImage, shopifySrcSet } from "@/lib/shopifyImage";
+import { tryonEvent } from "@/lib/tryon/analytics";
+import { TRYON_COPY } from "@/lib/tryon/copy";
+import { tryOnResults } from "@/lib/tryon/session";
+import { listed, livePiece } from "./live";
+import { overlayChip } from "./styles";
+
+/*
+  "Try another piece": the pieces the same photo can wear, best match first
+  by the shop's own pairing score (pairings.ts, which decides every "goes
+  with" on the site). One tap opens the piece and starts its preview with the
+  photo and consent already given; one already made this tab is shown at
+  once, so going back and forth never spends another try-on.
+*/
+
+export const AUTOSTART = "tryOnAutostart";
+
+interface Props {
+  current: TryOnPiece;
+  stone: string | null;
+  jewellery: JewelPiece[];
+  isLive: boolean;
+}
+
+const TryAnotherRail = ({ current, stone, jewellery, isLive }: Props) => {
+  const navigate = useNavigate();
+  const anchor = livePiece(jewellery, isLive, current.handle);
+  const made = new Set(tryOnResults().map((r) => r.handle));
+  const score = (p: TryOnPiece) => {
+    const candidate = livePiece(jewellery, isLive, p.handle);
+    return anchor && candidate ? matchScore(anchor, candidate) : 0;
+  };
+  const pieces = TRY_ON_PIECES.filter((p) => p.kind === current.kind && p.handle !== current.handle && listed(p, jewellery, isLive))
+    .map((p, i) => ({ p, i, s: score(p) }))
+    .sort((a, b) => b.s - a.s || a.i - b.i)
+    .map(({ p }) => p);
+  if (!pieces.length) return null;
+
+  const open = (p: TryOnPiece) => {
+    tryonEvent("tryon_another");
+    /* The stone carries over where the next piece is sold in it. */
+    const carry = stone && p.stones?.includes(stone as never) ? `?colour=${encodeURIComponent(stone.toLowerCase())}` : "";
+    navigate(`/try-on/${p.handle}${carry}`, { state: { [AUTOSTART]: true } });
+  };
+
+  return (
+    <section id="tryon-another" aria-labelledby="tryon-another-title" className="mt-12 scroll-mt-[140px] border-t border-nf-gold/25 pt-6">
+      <h2 id="tryon-another-title" className="px-4 font-cormorant text-[21px] leading-none text-nf-ink sm:px-0">
+        {TRYON_COPY.result.another}
+      </h2>
+      <div className="scrollbar-hide mt-4 flex snap-x gap-3 overflow-x-auto px-4 pb-1 sm:px-0 lg:grid lg:grid-cols-6 lg:overflow-visible" style={{ overscrollBehaviorX: "contain" }}>
+        {pieces.map((p) => (
+          <button
+            key={p.handle}
+            type="button"
+            onClick={() => open(p)}
+            className="w-[36vw] max-w-[170px] shrink-0 snap-start text-left lg:w-auto lg:max-w-none"
+            data-tryon-another={p.handle}
+          >
+            <span className="relative block aspect-square overflow-hidden bg-nf-ivory-deep">
+              <img
+                src={shopifyImage(p.image, 240)}
+                srcSet={shopifySrcSet(p.image, [240, 360]) || undefined}
+                sizes="(min-width: 1024px) 180px, 36vw"
+                alt=""
+                width={240}
+                height={240}
+                loading="lazy"
+                decoding="async"
+                className="h-full w-full object-cover"
+              />
+              {made.has(p.handle) && <span className={`${overlayChip} absolute left-2 top-2 px-2 text-[9px]`}>{TRYON_COPY.result.chip}</span>}
+            </span>
+            <span className="mt-2 line-clamp-2 block font-cormorant text-[14px] font-semibold leading-[1.2] text-nf-ink">{p.name}</span>
+          </button>
+        ))}
+      </div>
+    </section>
+  );
+};
+
+export default TryAnotherRail;
diff --git a/src/components/tryon/TryOnBuy.tsx b/src/components/tryon/TryOnBuy.tsx
