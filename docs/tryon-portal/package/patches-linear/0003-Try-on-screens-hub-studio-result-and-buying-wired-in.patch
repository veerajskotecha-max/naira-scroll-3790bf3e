+} from "@/lib/tryon/session";
+import ConsentSheet from "./ConsentSheet";
+import DemoCompare from "./DemoCompare";
+import { liveSoldOut, livePiece, realPiecePhotos } from "./live";
+import { prefersReducedMotion, useSweep } from "./motion";
+import PhotoGuide, { FacePose, HandPose } from "./PhotoGuide";
+import { CropFrame, PhotoPicker, PhotoWarnings, type PhotoSource } from "./PhotoStep";
+import PieceStrip from "./PieceStrip";
+import RenderingState from "./RenderingState";
+import TryAnotherRail, { AUTOSTART } from "./TryAnotherRail";
+import TryOnBuy from "./TryOnBuy";
+import { studioReducer, type StudioState } from "./studioState";
+import { outlineButton, overlayChip, primaryButton, quietButton } from "./styles";
+
+/*
+  /try-on/<handle>: one piece, one photo, one preview.
+
+  A reducer walks the steps the spec names: intro → preparing → crop → ready
+  → consent → uploading → rendering → result, or failed(code, reason). The
+  photo and every preview live in session.ts for the tab, so Back, a second
+  piece or a second stone never asks for the photo again, and a preview
+  already made is shown at once instead of being paid for twice.
+
+  The render itself is a job held at module level, not by this component:
+  a shopper who steps back to the hub and returns mid-wait finds the same
+  wait, not a second request, and the finished preview lands in the session
+  whichever screen she is on. Starting another render aborts the last one
+  (one render per tab, session.ts).
+
+  Focus moves to each step's heading (#tryon-step) as the step changes, and
+  the waiting screen announces its stages through a polite live region.
+*/
+
+/* The result screen (with the share image and the scene check) is fetched
+   while the preview is being made, 20 seconds or more, so a shopper who only
+   looks at the pieces never downloads it. */
+const loadResult = () => import("./TryOnResult");
+const TryOnResult = lazy(loadResult);
+const prefetchResult = () => {
+  loadResult().catch(() => undefined);
+};
+
+/* If that code cannot be fetched, the preview still shows, in a plainer frame:
+   never the stale-build reload (lib/optionalChunk.ts), which would lose it. */
+class ResultBoundary extends Component<{ fallback: ReactNode; children: ReactNode }, { failed: boolean }> {
+  state = { failed: false };
+  static getDerivedStateFromError() {
+    return { failed: true };
+  }
+  render() {
+    return this.state.failed ? this.props.fallback : this.props.children;
+  }
+}
+
+/* ---------- the render job, one per tab ---------- */
+
+/* error null: the preview is in the session. */
+type Outcome = { error: TryOnError | null };
+
+interface Job {
+  handle: string;
+  stone: TryOnStone | null;
+  controller: AbortController;
+  progress: number;
+  startedAt: number | null;
+  outcome: Outcome | null;
+  listeners: Set<(job: Job) => void>;
+}
+
+let job: Job | null = null;
+/* X-Tryon-Remaining from the last reply: shown again with a preview revisited this tab. */
+let lastRemaining: number | null = null;
+
+const emit = (j: Job) => {
+  for (const listener of Array.from(j.listeners)) listener(j);
+};
+
+const runJob = (piece: TryOnPiece, stone: TryOnStone | null, photo: Blob): Job => {
+  const controller = new AbortController();
+  const release = trackRender(controller);
+  const j: Job = { handle: piece.handle, stone, controller, progress: 0, startedAt: null, outcome: null, listeners: new Set() };
+  job = j;
+  prefetchResult();
+  tryonEvent("tryon_render_started");
+  tagTryOn(piece.handle);
+  requestTryOn({
+    handle: piece.handle,
+    stone,
+    kind: piece.kind,
+    photo,
+    signal: controller.signal,
+    onUpload: (fraction) => {
+      j.progress = fraction;
+      // Every byte sent is the upload done, even where the browser skips its load event.
+      if (fraction >= 1 && j.startedAt === null) j.startedAt = Date.now();
+      emit(j);
+    },
+    onUploaded: () => {
+      if (j.startedAt === null) j.startedAt = Date.now();
+      emit(j);
+    },
+  })
+    .then((reply): Outcome => {
+      setTryOnResult(piece.handle, stone, piece.kind, reply);
+      lastRemaining = reply.remaining;
+      markTried(piece.handle);
+      tryonEvent("tryon_render_ok");
+      return { error: null };
+    })
+    .catch((error: unknown): Outcome => {
+      const err = error instanceof TryOnError ? error : new TryOnError("failed");
+      tryonEvent(renderFailedEvent(err));
+      return { error: err };
+    })
+    .then((outcome) => {
+      release();
+      if (job === j) job = null;
+      j.outcome = outcome;
+      emit(j);
+    });
+  return j;
+};
+
+/* ---------- layout ---------- */
+
+const StudioLayout = ({ strip, frame, controls, frameOnPhone = true }: { strip: ReactNode; frame: ReactNode; controls: ReactNode; frameOnPhone?: boolean }) => (
+  /* Phone: piece, picture, actions, top to bottom. Laptop: the picture on the
+     left, held in view, sized so all of it fits under the header at 900px. */
+  <div className="lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,440px)] lg:grid-rows-[auto_auto_1fr] lg:gap-x-14">
+    <div className="lg:col-start-2 lg:row-start-1">{strip}</div>
+    <div id="tryon-stage" className={`${frameOnPhone ? "mt-4" : "hidden"} scroll-mt-[118px] lg:col-start-1 lg:row-span-3 lg:row-start-1 lg:mt-0 lg:block`}>
+      <div className="lg:sticky lg:top-[150px] lg:mx-auto lg:max-w-[440px]">{frame}</div>
+    </div>
+    <div className="mt-5 lg:col-start-2 lg:row-start-2">{controls}</div>
+  </div>
+);
+
+/* The ivory frame where the photo will be, while there is none: the pose to copy. */
+const EmptyFrame = ({ hand, children }: { hand: boolean; children?: ReactNode }) => (
+  <div className="relative flex aspect-[3/4] w-full items-center justify-center border border-nf-gold/40 bg-nf-ivory-deep text-nf-gold">
+    {hand ? <HandPose className="w-[58%]" /> : <FacePose className="w-[58%]" />}
+    {children}
+  </div>
+);
+
+const PreparingFrame = ({ hand }: { hand: boolean }) => {
+  const line = useRef<HTMLSpanElement>(null);
+  useSweep(line, [{ transform: "translateX(-100%)" }, { transform: "translateX(250%)" }], 1400);
+  return (
+    <EmptyFrame hand={hand}>
+      <div className="absolute inset-x-0 bottom-0 px-6 pb-8 text-center">
+        <h2 id="tryon-step" tabIndex={-1} className="font-nf-editorial text-[20px] italic text-nf-ink outline-none">
+          {TRYON_COPY.preparing}
+        </h2>
+        <span className="mx-auto mt-3 block h-px w-40 overflow-hidden bg-nf-gold/25" aria-hidden="true">
+          <span ref={line} className={`block h-px w-2/5 bg-nf-gold ${prefersReducedMotion() ? "mx-auto" : ""}`} />
+        </span>
+      </div>
+    </EmptyFrame>
+  );
+};
+
+/* ---------- the studio ---------- */
+
+const TryOnStudio = ({ piece }: { piece: TryOnPiece }) => {
+  const { jewellery, isLive } = useLiveJewellery();
+  const live = livePiece(jewellery, isLive, piece.handle);
+  const soldOut = liveSoldOut(live);
+  const kind = piece.kind;
+  const hand = kind === "hand";
+  const location = useLocation();
+  const navigate = useNavigate();
+
+  /* The stone lives in the link (?colour=emerald), as on the product page. */
+  const [searchParams, setSearchParams] = useSearchParams();
+  const stone: TryOnStone | null = piece.stones ? tryOnStone(piece, searchParams.get("colour")) ?? piece.stones[0] : null;
+
+  /* Read from the session when it changes, never on every render: a read
+     restarts the 30-minute idle clock, and the catalogue refetches each minute. */
+  const [photo, setPhoto] = useState(() => getTryOnPhoto(kind));
+
+  const [state, dispatch] = useReducer(studioReducer, undefined, (): StudioState => {
+    if (job && job.handle === piece.handle && !job.outcome) {
+      return job.startedAt ? { step: "rendering", stone: job.stone, startedAt: job.startedAt } : { step: "uploading", stone: job.stone, progress: job.progress };
+    }
+    return getTryOnPhoto(kind) && getTryOnResult(piece.handle, stone) ? { step: "result", stone } : { step: "intro" };
+  });
+  const stepRef = useRef(state.step);
+  stepRef.current = state.step;
+
+  /* ---- following the render job ---- */
+  const [watched, setWatched] = useState<Job | null>(() => (job && job.handle === piece.handle && !job.outcome ? job : null));
+  useEffect(() => {
+    if (!watched) return;
+    const onJob = (j: Job) => {
+      if (j.outcome) {
+        // A Delete during the wait has already reset the screen.
+        if (!getTryOnPhoto(kind)) return;
+        dispatch(j.outcome.error ? { type: "failed", error: j.outcome.error } : { type: "result", stone: j.stone });
+        setWatched((w) => (w === j ? null : w));
+      } else if (j.startedAt) {
+        dispatch({ type: "uploaded", at: j.startedAt });
+      } else {
+        dispatch({ type: "progress", fraction: j.progress });
+      }
+    };
+    watched.listeners.add(onJob);
+    // An outcome that landed before this screen listened.
+    if (watched.outcome) onJob(watched);
+    return () => {
+      watched.listeners.delete(onJob);
+    };
+  }, [watched, kind]);
+
+  const startRender = useCallback(
+    (renderStone: TryOnStone | null) => {
+      const held = getTryOnPhoto(kind);
+      if (!held) {
+        dispatch({ type: "reset", changing: true });
+        return;
+      }
+      if (!hasTryOnConsent()) {
+        dispatch({ type: "consent" });
+        return;
+      }
+      dispatch({ type: "upload", stone: renderStone });
+      setWatched(runJob(piece, renderStone, held.blob));
+    },
+    [kind, piece],
+  );
+
+  /* Past the photo: ask for consent once per tab, then send. */
+  const proceed = useCallback(() => {
+    if (soldOut) {
+      dispatch({ type: "ready" });
+      return;
+    }
+    if (!hasTryOnConsent()) dispatch({ type: "consent" });
+    else startRender(stone);
+  }, [soldOut, startRender, stone]);
+
+  /* ---- the session clearing under us (Delete, leaving the page, 30 minutes idle) ---- */
+  const deleting = useRef(false);
+  useEffect(
+    () =>
+      onTryOnSessionCleared(() => {
+        setPhoto(undefined);
+        setWatched(null);
+        dispatch({ type: "reset", notice: deleting.current ? "deleted" : undefined });
+        deleting.current = false;
+      }),
+    [],
+  );
+  const deletePhoto = () => {
+    deleting.current = true;
+    tryonEvent("tryon_photo_deleted");
+    clearTryOnSession();
+  };
+
+  /* ---- entry events, and "Try another piece" starting at once ---- */
+  useEffect(() => {
+    tryonEvent("tryon_piece_opened");
+    tagTryOn(piece.handle);
+    const from = location.state as Record<string, unknown> | null;
+    if (from?.tryOnFrom === "pdp") tryonEvent("tryon_entry_pdp");
+    if (from?.[AUTOSTART]) {
+      // Spent: a reload or a return to this entry must not start another.
+      navigate({ pathname: location.pathname, search: location.search }, { replace: true, state: null });
