+/**
+ * The try-on end to end on phones: a served build of this branch, driven by
+ * Playwright, with every {VITE_SUPABASE_URL}/functions/v1/tryon/* request
+ * answered by the REAL edge-function handler under scripts/tryon/serve-local.ts
+ * and its FAKE gateway. No AI call, no Supabase, no order: the Storefront API
+ * is real (test carts are read back), Shiprocket's checkout script is a
+ * stand-in that only records buyDirect, and every reporting host (Meta, Clarity,
+ * meta-capi, shopper-performance) is aborted by NO_REPORT and counted.
+ *
+ * Set up (ports are free choices):
+ *   npx vite build --outDir /tmp/x/dist                     (never npm run build: it prerenders)
+ *   node <harness>/distserve.mjs /tmp/x/dist 4540 &         (any static server with an SPA fallback)
+ *   TRYON_EXTRA_ORIGINS=http://127.0.0.1:4540 npx vite-node -c vitest.config.ts scripts/tryon/serve-local.ts &
+ *   node scripts/tryon/e2e.mjs --out /tmp/x/e2e
+ *
+ * Options: --base <url> (4540) --local <url> (4541) --out <dir>
+ *   --only routes,prep,flows,errors,pdp,prodsim,journey   --profiles pixel7,iphone13,desktop
+ *   --photo <face photo> (the shopper stand-in; default a synthetic drawing)
+ *   --flag-on <url>  a build with TRY_ON_ENTRY_LIVE true and every piece certified (pdp, prodsim)
+ *   --main <url>     a build of origin/main (pdp)          --dist <dir>  this branch's dist (chunk sizes)
+ *   --no-report-file <path>  NO_REPORT pattern module (default: the harness copy, else the one below)
+ *   --sheet <file.jpg>  a contact sheet of the journey and error screens, with the PNGs copied beside it
+ *   --skip-slow  leaves out the 75 s server timeout and the 125 s client one   --slow-only  only those
+ *
+ * Two ways the try-on request reaches serve-local:
+ *   fulfill (default): route.fetch to serve-local, route.fulfill with its answer. Chromium then
+ *     reports no XHR upload progress, so the screen goes from "Sending securely" to the result
+ *     without the stage copy; that is the interception, not the page.
+ *   direct (journey and the stage check): the page's XHR is pointed at serve-local by an init
+ *     script and continued, so the browser's own upload events, CORS preflight and network
+ *     throttling are real.
+ *
+ * Exit code 1 if any check fails; every check is also in <out>/report.json.
+ */
+import fs from "node:fs";
+import path from "node:path";
+import zlib from "node:zlib";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { playwright } from "./pw.mjs";
+import { jpegSegments, jpegSize, makeFixtures, QUADRANTS } from "./fixtures.mjs";
+
+const HERE = path.dirname(fileURLToPath(import.meta.url));
+const REPO = path.resolve(HERE, "../..");
+
+/* ---------- options ---------- */
+
+const argv = process.argv.slice(2);
+const opt = (name, fallback) => {
+  const i = argv.indexOf(`--${name}`);
+  return i >= 0 && argv[i + 1] && !argv[i + 1].startsWith("--") ? argv[i + 1] : fallback;
+};
+const BASE = opt("base", "http://127.0.0.1:4540");
+const LOCAL = opt("local", "http://127.0.0.1:4541");
+const OUT = path.resolve(opt("out", path.join(process.cwd(), "tryon-e2e")));
+const ONLY = new Set(opt("only", "routes,prep,flows,errors,pdp,prodsim,journey").split(","));
+const PROFILE_LIST = opt("profiles", "pixel7,iphone13,desktop").split(",");
+const FLAG_ON = opt("flag-on", null);
+const MAIN = opt("main", null);
+const DIST = opt("dist", null);
+fs.mkdirSync(OUT, { recursive: true });
+
+const NO_REPORT_FILE = opt("no-report-file", "/home/user/naira-scroll-3790bf3e/shopify/harness/noreport.mjs");
+/* The harness's list of hosts a test run must never reach; a copy for machines without the harness. */
+const NO_REPORT = fs.existsSync(NO_REPORT_FILE)
+  ? (await import(pathToFileURL(NO_REPORT_FILE).href)).NO_REPORT
+  : /(facebook\.net|facebook\.com|fbcdn\.net|clarity\.ms|googletagmanager|google-analytics|analytics\.google|doubleclick|hotjar|monorail-edge|events\.pickrr\.com|cloudflareinsights\.com|\/functions\/v1\/meta-capi|~api\/analytics|__l5e\/|~flock\.js|tinybird\.co|\/functions\/v1\/shopper-performance)/i;
+
+const env = Object.fromEntries(
+  fs
+    .readFileSync(path.join(REPO, ".env"), "utf8")
+    .split("\n")
+    .map((l) => /^([A-Z_]+)="?([^"]*)"?$/.exec(l.trim()))
+    .filter(Boolean)
+    .map((m) => [m[1], m[2]]),
+);
+const SUPA = env.VITE_SUPABASE_URL.replace(/\/+$/, "");
+const TRYON = `${SUPA}/functions/v1/tryon/`;
+const shopifySrc = fs.readFileSync(path.join(REPO, "src/lib/shopify.ts"), "utf8");
+const STOREFRONT = {
+  url: `https://${/SHOPIFY_STORE_PERMANENT_DOMAIN = "([^"]+)"/.exec(shopifySrc)[1]}/api/${/SHOPIFY_API_VERSION = "([^"]+)"/.exec(shopifySrc)[1]}/graphql.json`,
+  token: /SHOPIFY_STOREFRONT_TOKEN = "([^"]+)"/.exec(shopifySrc)[1],
+};
+/* The allow-listed Clarity names, read from the module that enforces them. */
+const analyticsSrc = fs.readFileSync(path.join(REPO, "src/lib/tryon/analytics.ts"), "utf8");
+const BASE_EVENTS = new Set([...analyticsSrc.slice(0, analyticsSrc.indexOf("] as const")).matchAll(/"(tryon_[a-z_]+)"/g)].map((m) => m[1]));
+const FAILED_EVENT =
+  /^tryon_render_failed_(bad_request|origin|challenge|too_large|not_jpeg|photo_unusable|fidelity_failed|device_limit|ip_limit|busy|paused|timeout|failed|offline|network)$/;
+
+/* What the spec's uxStates say each screen reads, word for word. */
+const COPY = {
+  ear: "We could not see your ear clearly. Tuck your hair back and turn a little toward the light.",
+  neck: "For necklaces, use a photo that shows your neck and both shoulders.",
+  hand: "We could not see your hand clearly. Lay it flat, back of the hand up, fingers slightly apart.",
+  wrist: "Please include your wrist, with your sleeve pulled back.",
+  multiple_people: "Please use a photo with just you in it.",
+  no_person: "We could not find a person in this photo. Please use a clear photo of yourself.",
+  under_18: "Try-on is for customers aged 18 and over.",
+  not_a_photo: "We could not use this photo. Please use a clear camera photo of yourself.",
+  too_dark: "This photo is too dark to place the piece well. Try again in daylight.",
+  too_blurry: "This photo is too soft to place the piece well. Hold the phone steady and try again.",
+  model_declined: "We could not make a preview from this photo. A clear, front-facing photo works best.",
+  fidelity: "We could not make a preview that matches the piece exactly, so we have not shown it. Try a clearer photo, or see the piece on our models.",
+  device_limit: "You have used today's 5 try-ons. They refresh at midnight.",
+  ip_limit: "Many people on your network have tried pieces on today. Please try again tomorrow.",
+  busy: "Lots of people are trying pieces on right now. Please try again in a minute.",
+  paused: "Try-on is resting for now. See the piece on our models instead.",
+  timeout: "This is taking longer than it should. Please try again; it usually works the second time.",
+  failed: "Something went wrong on our side. Your photo is still here; please try again.",
+  offline: "You seem to be offline. Your photo is still here; try again when you are connected.",
+  cancelled: "Cancelled. Your photo is still here.",
+  deleted: "Your photo is deleted from this page. We never kept a copy.",
+  format: "This photo could not be opened here. Take a new photo or choose a JPG.",
+  too_small: "This photo is too small to show the piece clearly. Take a new photo or choose a larger one.",
+  dark: "This photo looks a little dark. A brighter photo gives a truer preview.",
+};
+const ALLOWED_KEYS = new Set(["naira_tryon_device", "naira_tryon", "naira_tryon_consent", "naira_tryon_tips"]);
+const XFF = "203.0.113.7"; // a documentation address standing in for the shopper's network
+
+/* ---------- report ---------- */
+
+const results = [];
+const facts = {};
+let group = "setup";
+const check = (name, ok, detail = "") => {
+  results.push({
+    group,
+    name,
+    ok: Boolean(ok),
+    detail: typeof detail === "string" ? detail : JSON.stringify(detail),
+  });
+  console.log(`${ok ? "PASS" : "FAIL"}  [${group}] ${name}${detail ? `  (${typeof detail === "string" ? detail : JSON.stringify(detail)})` : ""}`);
+  return Boolean(ok);
+};
+const note = (key, value) => {
+  facts[key] = value;
+  console.log(`NOTE  [${group}] ${key}: ${typeof value === "string" ? value : JSON.stringify(value)}`);
+};
+const save = () =>
+  fs.writeFileSync(
+    path.join(OUT, "report.json"),
+    JSON.stringify(
+      {
+        when: new Date().toISOString(),
+        base: BASE,
+        local: LOCAL,
+        results,
+        facts,
+      },
+      null,
+      1,
+    ),
+  );
+
+/* ---------- serve-local ---------- */
+
+const local = async (p, body) => {
+  const res = await fetch(
+    `${LOCAL}${p}`,
+    body === undefined
+      ? {}
+      : {
+          method: "POST",
+          headers: { "content-type": "application/json" },
+          body: JSON.stringify(body),
+        },
+  );
+  return res.json();
+};
+const scenario = (s) => local("/__scenario", s);
+const quotaOf = async (device, ip) => (await local(`/__state?device=${device ?? ""}${ip ? `&ip=${ip}` : ""}`)).quota;
+
+/* ---------- the browser ---------- */
+
+const pw = playwright();
+const { devices } = pw;
+const browser = await pw.chromium.launch();
+
+const PROFILES = {
+  pixel7: { ...devices["Pixel 7"] },
+  iphone13: { ...devices["iPhone 13"] },
+  desktop: {
+    viewport: { width: 1440, height: 900 },
+    deviceScaleFactor: 1,
+    isMobile: false,
+    hasTouch: false,
+  },
+  // The spec's first-screen budget: a 360px Android in a 640px window (the Instagram in-app browser).
+  android360: { ...devices["Pixel 7"], viewport: { width: 360, height: 640 } },
+  // The contact sheet's frame.
+  phone390: { ...devices["iPhone 13"], viewport: { width: 390, height: 844 } },
+};
+for (const p of Object.values(PROFILES)) delete p.defaultBrowserType;
+
+const FASTRR_SCRIPT = /fastrr-boost-ui\.pickrr\.com\/assets\/js\/channels\/shopify\.js/;
+/* Shiprocket's checkout script, replaced: buyDirect only records what it was handed. */
+const FASTRR_STUB =
+  "window.shiprocketCheckoutEvents={buyDirect:function(p){(window.__e2e.fastrr=window.__e2e.fastrr||[]).push(JSON.parse(JSON.stringify(p)));}};";
+
+const initScript = ({ direct, prodSim }) => `(() => {
+  Object.defineProperty(Navigator.prototype, 'webdriver', { get: () => false });
+  ${prodSim ? "Object.defineProperty(window, '__nairaProd', { value: true, writable: false, configurable: false });" : ""}
+  const e2e = window.__e2e = { created: 0, revoked: 0, live: new Set(), fastrr: [], opened: [], marks: {}, dataImgSeen: 0 };
+  const create = URL.createObjectURL.bind(URL), revoke = URL.revokeObjectURL.bind(URL);
+  URL.createObjectURL = function (o) { const u = create(o); e2e.created++; e2e.live.add(u); return u; };
+  URL.revokeObjectURL = function (u) { if (e2e.live.delete(u)) e2e.revoked++; return revoke(u); };
+  window.open = function (u) { e2e.opened.push(String(u)); return null; };
+  const now = () => performance.now();
+  document.addEventListener('change', (ev) => { const t = ev.target; if (t && t.type === 'file') { e2e.marks = { pick: now() }; } }, true);
+  document.addEventListener('click', (ev) => { const b = ev.target && ev.target.closest && ev.target.closest('button'); if (b && /Use this photo/.test(b.textContent || '')) e2e.marks.use = now(); }, true);
+  new MutationObserver(() => {
+    const m = e2e.marks;
+    if (m.pick && !m.crop && document.querySelector('[data-tryon-crop] canvas')) m.crop = now();
+    if (m.use && !m.ready && (document.querySelector('[aria-labelledby="tryon-consent-title"]') || /Use anyway|Sending securely/.test(document.body ? document.body.innerText : ''))) m.ready = now();
+    if (document.querySelector('img[src^="data:"]')) e2e.dataImgSeen++;
+  }).observe(document, { subtree: true, childList: true, attributes: true, attributeFilter: ['src'] });
+  const SUPA = ${JSON.stringify(SUPA)}, TRYON = ${JSON.stringify(TRYON)}, LOCAL = ${JSON.stringify(LOCAL)};
+  const open = XMLHttpRequest.prototype.open;
+  XMLHttpRequest.prototype.open = function (m, u) {
+    let url = String(u);
+    if (url.indexOf(TRYON) === 0) { e2e.marks.send = e2e.marks.send || now(); if (!e2e.marks.ready && e2e.marks.use) e2e.marks.ready = now(); ${direct ? "url = LOCAL + url.slice(SUPA.length);" : ""} }
+    const args = Array.prototype.slice.call(arguments); args[1] = url;
+    return open.apply(this, args);
+  };
+  ${direct ? "const f = window.fetch; window.fetch = function (input, init) { if (typeof input === 'string' && input.indexOf(TRYON) === 0) input = LOCAL + input.slice(SUPA.length); return f.call(this, input, init); };" : ""}
+  window.__bag = function () {
+    return [].slice.call(document.querySelectorAll('[role="dialog"][data-state="open"]'))
+      .find(function (d) { return d.querySelector('[data-bag-foot], [data-ladder]') || /Your bag/i.test((d.querySelector('h2') || {}).textContent || ''); }) || null;
+  };
+})();`;
+
+const IMAGE_SIG = [
+  Buffer.from([0xff, 0xd8, 0xff]),
+  Buffer.from([0x89, 0x50, 0x4e, 0x47]),
+  Buffer.from("data:image"),
+  Buffer.from("/9j/"),
+  Buffer.from("iVBORw0KGgo"),
+];
+const carriesImage = (buf) => Boolean(buf) && IMAGE_SIG.some((sig) => buf.includes(sig));
+
+async function openContext(profile, { transport = "fulfill", prodSim = false, clock = false } = {}) {
+  const context = await browser.newContext({
+    ...PROFILES[profile],
+    acceptDownloads: true,
+  });
+  const log = {
+    profile,
+    phase: "pre-consent",
+    requests: [],
+    console: [],
+    pageErrors: [],
+    checkout: [],
+    blocked: [],
+  };
+  await context.addInitScript({
+    content: initScript({ direct: transport === "direct", prodSim }),
+  });
+  await context.route("**/*", async (route) => {
+    const req = route.request();
+    const u = req.url();
+    if (NO_REPORT.test(u)) {
+      log.blocked.push({ url: u, body: req.postData() ?? "" });
+      return route.abort();
+    }
+    if (FASTRR_SCRIPT.test(u))
+      return route.fulfill({
+        status: 200,
+        contentType: "application/javascript",
+        body: FASTRR_STUB,
+      });
+    if (/pickrr|shiprocket|fastrr/i.test(u))
+      return route.fulfill({
+        status: 200,
+        contentType: /\.css/.test(u) ? "text/css" : "application/javascript",
+        body: "",
+      });
+    // Never a checkout or a payment page; never WhatsApp.
+    if (
+      /\/checkouts?\/|\/cart\/c\/|payments\.nairaflore\.com|checkout\.shopify|wa\.me\/|api\.whatsapp\.com/i.test(u) ||
+      (/myshopify\.com/.test(u) && !/\/api\//.test(u))
+    ) {
+      log.checkout.push(u);
+      return route.abort();
+    }
+    if (u.startsWith(TRYON)) {
+      try {
+        const res = await route.fetch({
+          url: LOCAL + u.slice(SUPA.length),
+          headers: { ...req.headers(), "x-forwarded-for": XFF },
+          timeout: 0,
+        });
+        await route.fulfill({ response: res });
+      } catch {
+        await route.abort().catch(() => {});
+      }
+      return;
+    }
+    return route.continue();
+  });
+  context.on("request", (r) => {
+    let body = null;
+    try {
+      body = r.postDataBuffer();
+    } catch {
+      body = null;
+    }
+    log.requests.push({
+      url: r.url(),
+      method: r.method(),
+      body,
+      phase: log.phase,
+      at: Date.now(),
+    });
+  });
+  const page = await context.newPage();
+  if (clock) await page.clock.install();
+  page.on("console", (m) => {
+    if (m.type() === "error") log.console.push(m.text().slice(0, 300));
+  });
+  page.on("pageerror", (e) => log.pageErrors.push(String(e.message).slice(0, 300)));
+  return { context, page, log };
+}
+
+/* Console errors that are the test's own doing: aborted reporting hosts, the stubbed scripts, and the
+   4xx/5xx answers the error matrix asks for. Anything else is a real error. */
