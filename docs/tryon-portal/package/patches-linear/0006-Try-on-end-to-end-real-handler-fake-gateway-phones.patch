+  log.console.filter(
+    (t) => !/^Failed to load resource: (net::ERR_FAILED|net::ERR_INTERNET_DISCONNECTED|the server responded with a status of (4\d\d|5\d\d))/.test(t),
+  );
+
+/* ---------- page helpers ---------- */
+
