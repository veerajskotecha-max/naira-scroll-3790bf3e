+  await s("06-sending");
+  check("upload progress shows 'Sending securely n%' from the browser's own upload events", sending);
+  await page.waitForFunction(() => /Checking your photo/.test(document.body.innerText), null, { timeout: 60000 });
+  await cdp.send("Network.emulateNetworkConditions", {
+    offline: false,
+    latency: 0,
+    downloadThroughput: -1,
+    uploadThroughput: -1,
+  });
+  await s("07-rendering-checking");
+  await auditSmallTargets(page, "rendering screen");
+  const stages = ["Checking your photo"];
+  for (const [ms, name, re] of [
+    [5000, "08-rendering-placing", /Placing the Woven Gold Hoops at 25 mm across/],
