diff --git a/scripts/tryon/pw.mjs b/scripts/tryon/pw.mjs
new file mode 100644
index 0000000..1e80af2
--- /dev/null
+++ b/scripts/tryon/pw.mjs
@@ -0,0 +1,30 @@
+/**
+ * The Playwright these scripts drive. The repo's devDependency may be newer
+ * than the browsers installed on the machine (a container keeps one shared
+ * Chromium), so take the first Playwright whose Chromium is actually there:
+ * PLAYWRIGHT_FROM if set, then this repo's, then a global install. Browsers
+ * are never downloaded from here, and Chromium is launched with no options.
+ */
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { createRequire } from "node:module";
+
+const candidates = [process.env.PLAYWRIGHT_FROM, import.meta.url, path.join(os.tmpdir(), "x.js"), "/opt/node-tools/x.js"].filter(Boolean);
+
+export function playwright() {
+  const tried = [];
+  for (const from of candidates) {
+    try {
+      const pw = createRequire(from)("playwright");
+      const exe = pw.chromium.executablePath();
+      if (exe && fs.existsSync(exe)) return pw;
+      tried.push(`${from}: no browser at ${exe}`);
+    } catch (e) {
+      tried.push(`${from}: ${String(e.message || e).split("\n")[0]}`);
+    }
+  }
+  throw new Error(`No Playwright with an installed Chromium:\n  ${tried.join("\n  ")}`);
+}
+
+export const launchChromium = () => playwright().chromium.launch();
diff --git a/scripts/tryon/serve-local.ts b/scripts/tryon/serve-local.ts
new file mode 100644
index 0000000..e2281bf
--- /dev/null
+++ b/scripts/tryon/serve-local.ts
@@ -0,0 +1,472 @@
+/**
+ * The REAL try-on function on loopback, against a scripted FAKE Lovable AI
+ * gateway, with the in-memory quota and ledger. It is what the browser end to
+ * end (scripts/tryon/e2e.mjs) talks to, and a way to look at every screen by
+ * hand. It never makes an AI call: the gateway it calls is the fake below,
+ * and gateway.ts only honours a loopback TRYON_GATEWAY_URL.
+ *
+ *   npx vite-node -c vitest.config.ts scripts/tryon/serve-local.ts
+ *
+ * (vitest.config.ts holds the npm: aliases the Deno files need in Node.)
+ *
+ *   http://127.0.0.1:4541/functions/v1/tryon/{render,feedback}   handler.ts, unchanged
+ *   http://127.0.0.1:4542/v1/chat/completions                     the fake gateway
+ *
+ * Environment (all optional): TRYON_LOCAL_PORT (4541), TRYON_FAKE_GATEWAY_PORT
+ * (4542), TRYON_EXTRA_ORIGINS (http://127.0.0.1:4540, the served build),
+ * TRYON_DEVICE_DAILY / TRYON_IP_DAILY / TRYON_DAILY_CAP / TRYON_VERIFY as in
+ * production, TRYON_REF_DIR (a cache for reference photos; a miss is read
+ * from the Shopify CDN, read-only). The handler always gets
+ * TRYON_ENABLED=on and TRYON_ALLOW_UNCERTIFIED=1, a throwaway salt and a
+ * placeholder key the fake gateway checks for.
+ *
+ * Control, on the function's port (loopback only):
+ *   POST /__scenario {name, reason?, code?, on?, delayMs?}   what the gateway does next (SCENARIOS)
+ *   GET  /__state?device=<uuid>&ip=<addr>                     quota used, ledger rows, gateway calls, log lines
+ *   POST /__reset                                             empties quota, ledger, call log and log lines
+ *   POST /__env {KEY: "value"}                                changes one of the handler's settings
+ *
+ * The fake render is a mock on purpose: the shopper's photo with the piece's
+ * reference photo pasted in a corner and "MOCK" across it (Python Pillow, if
+ * present; otherwise the photo itself comes back), so nobody can take a
+ * screenshot of it for a real preview.
+ */
+import http from "node:http";
+import { spawn } from "node:child_process";
+import { createHash, randomBytes } from "node:crypto";
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { handle, type Env } from "../../supabase/functions/tryon/handler.ts";
+import { istDay, keyHash, memoryQuota, sha256Hex } from "../../supabase/functions/tryon/quota.ts";
+import { memoryStats } from "../../supabase/functions/tryon/stats.ts";
+
+const PORT = Number(process.env.TRYON_LOCAL_PORT || 4541);
+const GATEWAY_PORT = Number(process.env.TRYON_FAKE_GATEWAY_PORT || 4542);
+const HOST = "127.0.0.1";
+const FAKE_KEY = "local-fake-gateway-key";
+const REF_DIR = process.env.TRYON_REF_DIR || path.join(tmpdir(), "naira-tryon-refs");
+
+/* ---------- the gateway's script ---------- */
+
+type Kind = "precheck" | "render" | "verify";
+
+export const SCENARIOS = [
+  "ok", // pre-check passes, a mock image, verdict passes
+  "precheck_fail", // the pre-check names `reason` (any photo_unusable reason it can give); default ear_not_visible
+  "precheck_fail_ear", // the spec's name for precheck_fail ear_not_visible
+  "refusal_code", // the render answers only `code` (NO_EAR, NO_NECK, NO_HAND, NO_WRIST) and no image
+  "declined_text", // the render answers other words and no image
+  "status", // the call named by `on` (default render) answers HTTP `code` (429, 402, 401…)
+  "timeout", // the render never answers; the handler's own 75 s timer ends it
+  "slow", // the render answers after `delayMs` (default 30 s)
+  "verify_fail_once", // the first verdict fails same_design, the corrected retry passes
+  "verify_fail_twice", // every verdict fails same_design
+  "unparsable", // the pre-check answers words, not JSON (passes, recorded)
+  "unparsable_verify", // the verdict answers words, not JSON (fails under strict)
+] as const;
+type ScenarioName = (typeof SCENARIOS)[number];
+type Scenario = {
+  name: ScenarioName;
+  reason?: string;
+  code?: string | number;
+  on?: Kind;
+  delayMs?: number;
+};
+
+/* The spec's and the task's shorthand names, onto the ones above. */
+const ALIASES: Record<string, Scenario> = {
+  "429": { name: "status", code: 429 },
+  "402": { name: "status", code: 402 },
+  "401": { name: "status", code: 401 },
+  ok_after_retry: { name: "verify_fail_once" },
+  precheck_fail_ear: { name: "precheck_fail", reason: "ear_not_visible" },
+  no_image: { name: "refusal_code", code: "NO_EAR" },
+};
+
+export const PRECHECK_OK = {
+  people: 1,
+  adult: true,
+  real_photo: true,
+  ear_visible: true,
+  neck_visible: true,
+  hand_visible: true,
+  back_of_hand: true,
+  wrist_visible: true,
+  too_dark: false,
+  too_blurry: false,
+  explicit: false,
+};
+const VERIFY_OK = {
+  piece_present: true,
+  same_design: true,
+  same_colours: true,
+  placement_ok: true,
+  size_ok: true,
+  person_unchanged: true,
+  scene_unchanged: true,
+  extra_items_added: false,
+};
+/* What the pre-check would say to make the handler name each reason. */
+const PRECHECK_FOR: Record<string, Partial<typeof PRECHECK_OK>> = {
+  ear_not_visible: { ear_visible: false },
+  neck_not_visible: { neck_visible: false },
+  hand_not_visible: { hand_visible: false },
+  wrist_not_visible: { wrist_visible: false },
+  multiple_people: { people: 2 },
+  no_person: { people: 0 },
+  under_18: { adult: false },
+  not_a_photo: { real_photo: false },
+  blocked: { explicit: true },
+  too_dark: { too_dark: true },
+  too_blurry: { too_blurry: true },
+};
+
+let scenario: Scenario = { name: "ok" };
+/* Verdicts since the last pre-check: one try-on is pre-check, render, verify (, render, verify). */
+let verdictsThisTry = 0;
+const calls: {
+  kind: Kind;
+  at: number;
+  model: string;
+  images: number;
+  prompt: string;
+}[] = [];
+
+const setScenario = (input: Partial<Scenario> & { name?: string }) => {
+  const alias = ALIASES[String(input.name)];
+  const base: Scenario = alias ? { ...alias } : { name: input.name as ScenarioName };
+  if (!SCENARIOS.includes(base.name)) throw new Error(`unknown scenario ${input.name}`);
+  scenario = {
+    ...base,
+    ...Object.fromEntries(Object.entries(input).filter(([k, v]) => k !== "name" && v !== undefined)),
+  };
+  return scenario;
+};
+
+type Part = { type: string; text?: string; image_url?: { url: string } };
+type ChatBody = {
+  model: string;
+  messages: { content: Part[] }[];
+  modalities?: string[];
+};
+
+const chatReply = (message: Record<string, unknown>) => ({
+  status: 200,
+  body: { choices: [{ message: { role: "assistant", ...message } }] },
+});
+const jsonReply = (obj: unknown) => chatReply({ content: "```json\n" + JSON.stringify(obj) + "\n```" });
+
+const COMPOSITE = String.raw`
+import sys, json, base64, io
+from PIL import Image, ImageDraw, ImageFont, ImageOps
+req = json.load(sys.stdin)
+photo = ImageOps.exif_transpose(Image.open(io.BytesIO(base64.b64decode(req["photo"])))).convert("RGB")
+ref = Image.open(io.BytesIO(base64.b64decode(req["ref"]))).convert("RGB")
+W, H = photo.size
+side = int(W * 0.34)
+ref = ImageOps.fit(ref, (side, side))
+out = photo.copy()
+d = ImageDraw.Draw(out, "RGBA")
+# The reference top right, the label at the bottom left: the page lays its own
+# "AI preview" chip top left and "The real piece" inset bottom right over the image.
+x, y = W - side - 28, 28
+d.rectangle([x - 6, y - 6, x + side + 6, y + side + 6], fill=(184, 148, 83, 255))
+out.paste(ref, (x, y))
+def font(px):
+    try:
+        return ImageFont.load_default(size=px)
+    except TypeError:
+        return ImageFont.load_default()
+band = int(W * 0.7)
+d.rectangle([0, H - 170, band, H - 40], fill=(250, 246, 238, 230))
+d.text((28, H - 156), "MOCK TRY-ON (fake gateway, not AI)", fill=(26, 24, 22, 255), font=font(38))
+d.text((28, H - 100), req.get("label", "")[:44], fill=(120, 96, 52, 255), font=font(30))
+mark = Image.new("RGBA", (W, H), (0, 0, 0, 0))
+md = ImageDraw.Draw(mark)
+md.text((W * 0.1, H * 0.42), "MOCK", fill=(255, 255, 255, 96), font=font(300))
+out = Image.alpha_composite(out.convert("RGBA"), mark.rotate(28, center=(W / 2, H / 2))).convert("RGB")
+buf = io.BytesIO()
+out.save(buf, "PNG", optimize=False, compress_level=3)
+sys.stdout.buffer.write(buf.getvalue())
+`;
+
+const dataOf = (url: string | undefined) => /^data:(image\/[a-z]+);base64,(.+)$/.exec(url ?? "");
+
+/** The mock "render": Pillow pastes the reference on the photo. Falls back to the photo itself. */
+const mockImage = (photoUrl: string | undefined, refUrl: string | undefined, label: string): Promise<string> => {
+  const photo = dataOf(photoUrl);
+  const ref = dataOf(refUrl);
+  if (!photo) return Promise.resolve(photoUrl ?? "");
+  return new Promise((resolve) => {
+    const child = spawn("python3", ["-I", "-c", COMPOSITE], {
+      stdio: ["pipe", "pipe", "ignore"],
+    });
+    const chunks: Buffer[] = [];
+    child.stdout.on("data", (c: Buffer) => chunks.push(c));
+    child.on("error", () => resolve(photoUrl as string));
+    child.on("close", (code) => {
+      const png = Buffer.concat(chunks);
+      resolve(code === 0 && png.length > 8 ? `data:image/png;base64,${png.toString("base64")}` : (photoUrl as string));
+    });
+    child.stdin.end(JSON.stringify({ photo: photo[2], ref: ref ? ref[2] : photo[2], label }));
+  });
+};
+
+const kindOf = (body: ChatBody): Kind => (body.modalities ? "render" : body.messages[0]?.content.length === 4 ? "verify" : "precheck");
+
+/* "Image 2 is a studio photograph of one jewellery piece: gold braided hoop earrings." */
+const pieceWords = (prompt: string) => /one jewellery piece: ([^.]+)\./.exec(prompt)?.[1] ?? "";
+
+const sleep = (ms: number, signal: AbortSignal) =>
+  new Promise<void>((resolve, reject) => {
+    const t = setTimeout(resolve, ms);
+    signal.addEventListener("abort", () => {
+      clearTimeout(t);
+      reject(new Error("aborted"));
+    });
+  });
+
+async function gatewayAnswer(body: ChatBody, signal: AbortSignal): Promise<{ status: number; body: unknown } | null> {
+  const kind = kindOf(body);
+  const content = body.messages[0]?.content ?? [];
+  const prompt = content.find((p) => p.type === "text")?.text ?? "";
+  calls.push({
+    kind,
+    at: Date.now(),
+    model: body.model,
+    images: content.filter((p) => p.type === "image_url").length,
+    prompt,
+  });
+  if (kind === "precheck") verdictsThisTry = 0;
+  const s = scenario;
+
+  if (s.name === "status" && (s.on ?? "render") === kind)
+    return {
+      status: Number(s.code) || 500,
+      body: { error: { message: "fake gateway status" } },
+    };
+
+  if (kind === "precheck") {
+    if (s.name === "precheck_fail")
+      return jsonReply({
+        ...PRECHECK_OK,
+        ...(PRECHECK_FOR[s.reason ?? "ear_not_visible"] ?? {}),
+      });
+    if (s.name === "unparsable") return chatReply({ content: "The photo looks fine to me." });
+    return jsonReply(PRECHECK_OK);
+  }
+
+  if (kind === "verify") {
+    verdictsThisTry++;
+    if (s.name === "verify_fail_twice" || (s.name === "verify_fail_once" && verdictsThisTry === 1)) return jsonReply({ ...VERIFY_OK, same_design: false });
+    if (s.name === "unparsable_verify") return chatReply({ content: "It looks lovely." });
+    return jsonReply(VERIFY_OK);
+  }
+
+  // render
+  if (s.name === "timeout") {
+    await new Promise<void>((resolve) => signal.addEventListener("abort", () => resolve()));
+    return null;
+  }
+  if (s.name === "slow") await sleep(s.delayMs ?? 30_000, signal);
+  if (s.name === "refusal_code") return chatReply({ content: String(s.code ?? "NO_EAR") });
+  if (s.name === "declined_text")
+    return chatReply({
+      content: "I'm sorry, I can't help with editing this photo.",
+    });
+  const [photo, ref] = content.filter((p) => p.type === "image_url").map((p) => p.image_url?.url);
+  const url = await mockImage(photo, ref, pieceWords(prompt));
+  return chatReply({
+    content: "",
+    images: [{ type: "image_url", image_url: { url } }],
+  });
+}
+
+/* ---------- reference photos: a local cache, else the CDN (read-only) ---------- */
+
+const realFetch = globalThis.fetch.bind(globalThis);
+
+const handlerFetch: typeof fetch = async (input, init) => {
+  const url = String(input instanceof Request ? input.url : input);
+  if (!url.startsWith("https://cdn.shopify.com/") && !url.startsWith("https://nairaflore.com/tryon/ref/")) return realFetch(input, init);
+  const file = path.join(REF_DIR, createHash("sha256").update(url).digest("hex").slice(0, 24) + ".jpg");
+  if (existsSync(file))
+    return new Response(readFileSync(file), {
+      headers: { "content-type": "image/jpeg" },
+    });
+  const res = await realFetch(url, { signal: init?.signal });
+  if (!res.ok || !/^image\//.test(res.headers.get("content-type") ?? "")) return res;
+  const bytes = new Uint8Array(await res.arrayBuffer());
+  try {
+    mkdirSync(REF_DIR, { recursive: true });
+    writeFileSync(file, bytes);
+  } catch {
+    /* the cache is a convenience */
+  }
+  return new Response(bytes, {
+    headers: {
+      "content-type": res.headers.get("content-type") ?? "image/jpeg",
+    },
+  });
+};
+
+/* ---------- the handler's deps ---------- */
+
+const env: Env = {
+  TRYON_ENABLED: "on",
+  LOVABLE_API_KEY: FAKE_KEY,
+  TRYON_SALT: randomBytes(24).toString("hex"),
+  TRYON_ALLOW_UNCERTIFIED: "1",
+  TRYON_EXTRA_ORIGINS: process.env.TRYON_EXTRA_ORIGINS || "http://127.0.0.1:4540",
+  TRYON_GATEWAY_URL: `http://${HOST}:${GATEWAY_PORT}/v1`,
+  TRYON_DEVICE_DAILY: process.env.TRYON_DEVICE_DAILY,
+  TRYON_IP_DAILY: process.env.TRYON_IP_DAILY,
+  TRYON_DAILY_CAP: process.env.TRYON_DAILY_CAP,
+  TRYON_VERIFY: process.env.TRYON_VERIFY,
+};
+const ENV_KEYS = new Set([
+  "TRYON_ENABLED",
+  "TRYON_DEVICE_DAILY",
+  "TRYON_IP_DAILY",
+  "TRYON_DAILY_CAP",
+  "TRYON_VERIFY",
+  "TRYON_EXTRA_ORIGINS",
+  "TRYON_ALLOW_UNCERTIFIED",
+]);
+
+let quota = memoryQuota(Date.now);
+let stats = memoryStats(Date.now);
+let lines: string[] = [];
+
+const deps = () => ({
+  fetch: handlerFetch,
+  quota,
+  stats,
+  now: Date.now,
+  env,
+  log: (line: string, level?: "error") => {
+    lines.push(line);
+    (level === "error" ? console.error : console.log)(`[tryon] ${line}`);
+  },
+  sha256: sha256Hex,
+});
+
+/* ---------- HTTP ---------- */
+
+const readBody = (req: http.IncomingMessage) =>
+  new Promise<Buffer>((resolve, reject) => {
+    const chunks: Buffer[] = [];
+    req.on("data", (c: Buffer) => chunks.push(c));
+    req.on("end", () => resolve(Buffer.concat(chunks)));
+    req.on("error", reject);
+  });
+
+/* Connection-level headers belong to this hop, not to the Request the handler reads. */
+const HOP = new Set(["host", "connection", "keep-alive", "transfer-encoding", "expect", "upgrade"]);
+
+const sendJson = (res: http.ServerResponse, status: number, body: unknown) => {
+  res.writeHead(status, {
+    "content-type": "application/json",
+    "cache-control": "no-store",
+  });
+  res.end(JSON.stringify(body));
+};
+
+async function state(url: URL) {
+  const day = istDay(Date.now());
+  const device = url.searchParams.get("device");
+  const ip = url.searchParams.get("ip");
+  const deviceKey = device ? await keyHash(sha256Hex, env.TRYON_SALT as string, day, "device", device) : null;
+  // No x-forwarded-for: the handler keys the address row by the device's hash.
+  const ipKey = ip ? await keyHash(sha256Hex, env.TRYON_SALT as string, day, "ip", ip) : deviceKey;
+  return {
+    scenario,
+    env: Object.fromEntries(Object.entries(env).filter(([k]) => ENV_KEYS.has(k))),
+    quota: {
+      all: quota.used("all"),
+      device: deviceKey ? quota.used("device", deviceKey) : null,
+      ip: ipKey ? quota.used("ip", ipKey) : null,
+    },
+    rows: Array.from(stats.rows.values()).map(({ verdict, ...row }) => ({
+      ...row,
+      verdictKeys: Object.keys(verdict),
+    })),
+    calls: calls.map(({ prompt, ...c }) => ({
+      ...c,
+      promptChars: prompt.length,
+      retry: /Correction:/.test(prompt),
+    })),
+    lines,
+  };
+}
+
+const server = http.createServer(async (req, res) => {
+  const url = new URL(req.url ?? "/", `http://${HOST}:${PORT}`);
+  try {
+    if (url.pathname === "/__scenario" && req.method === "POST") return sendJson(res, 200, setScenario(JSON.parse(String(await readBody(req)) || "{}")));
+    if (url.pathname === "/__state") return sendJson(res, 200, await state(url));
+    if (url.pathname === "/__reset" && req.method === "POST") {
+      quota = memoryQuota(Date.now);
+      stats = memoryStats(Date.now);
+      lines = [];
+      calls.length = 0;
+      scenario = { name: "ok" };
+      return sendJson(res, 200, { ok: true });
+    }
+    if (url.pathname === "/__env" && req.method === "POST") {
+      const patch = JSON.parse(String(await readBody(req)) || "{}") as Record<string, string | null>;
+      for (const [k, v] of Object.entries(patch)) {
+        if (!ENV_KEYS.has(k)) return sendJson(res, 400, { error: `not settable: ${k}` });
+        (env as Record<string, string | undefined>)[k] = v === null ? undefined : String(v);
+      }
+      return sendJson(res, 200, (await state(url)).env);
+    }
+    if (!url.pathname.startsWith("/functions/v1/tryon/")) return sendJson(res, 404, { error: "not found" });
+
+    const headers = new Headers();
+    for (const [k, v] of Object.entries(req.headers)) if (typeof v === "string" && !HOP.has(k)) headers.set(k, v);
+    const hasBody = req.method !== "GET" && req.method !== "HEAD" && req.method !== "OPTIONS";
+    const request = new Request(url, {
+      method: req.method,
+      headers,
+      ...(hasBody ? { body: new Uint8Array(await readBody(req)) } : {}),
+    });
+    const reply = await handle(request, deps());
+    const out: Record<string, string> = {};
+    reply.headers.forEach((v, k) => (out[k] = v));
+    res.writeHead(reply.status, out);
+    res.end(Buffer.from(await reply.arrayBuffer()));
+  } catch (e) {
+    sendJson(res, 500, { error: String(e) });
+  }
+});
+
