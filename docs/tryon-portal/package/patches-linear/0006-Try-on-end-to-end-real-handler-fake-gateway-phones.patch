+/**
+ * Synthetic photos for the try-on end to end: drawn on a canvas in Chromium,
+ * never a photo of anyone. The EXIF block (orientation, a GPS position and a
+ * camera name) is written here byte by byte, so the test can prove the phone
+ * strips it and still turns the picture upright.
+ *
+ *   node scripts/tryon/fixtures.mjs [dir]      (default scripts/tryon/fixtures)
+ *
+ * e2e.mjs draws the whole set again on each run (the drawing is deterministic),
+ * so it never depends on these files; the small ones are committed for trying
+ * the screens by hand, and the PNG and the 4000x3000 camera-sized photo
+ * (--big) are drawn only when asked for.
+ *
+ * The orientation set is four coloured quadrants as the shopper would see
+ * them upright (red top left, green top right, blue bottom left, yellow
+ * bottom right), STORED rotated the way a phone camera stores them, with the
+ * EXIF orientation tag that turns them back.
+ */
+import fs from "node:fs";
+import path from "node:path";
+import { fileURLToPath } from "node:url";
+import { launchChromium } from "./pw.mjs";
+
+export const QUADRANTS = {
+  tl: [214, 40, 40],
+  tr: [40, 170, 70],
+  bl: [40, 70, 214],
+  br: [226, 196, 40],
+};
+
+/* ---------- EXIF (big-endian TIFF inside an APP1 segment) ---------- */
+
+const u16 = (n) => [(n >> 8) & 0xff, n & 0xff];
+const u32 = (n) => [(n >>> 24) & 0xff, (n >>> 16) & 0xff, (n >>> 8) & 0xff, n & 0xff];
+const ascii = (s) => [...Buffer.from(s + "\0", "latin1")];
+
+/** An APP1 "Exif" segment: Make, Orientation and, if asked, a GPS position. */
+export function exifSegment({ orientation = 1, gps = false, make = "NairaSyntheticCam" } = {}) {
+  const makeBytes = ascii(make);
+  const ifd0Count = gps ? 3 : 2;
+  const ifd0Size = 2 + ifd0Count * 12 + 4;
+  const makeOffset = 8 + ifd0Size;
+  const gpsOffset = makeOffset + makeBytes.length;
+  const gpsCount = 4;
+  const gpsSize = 2 + gpsCount * 12 + 4;
+  const ratOffset = gpsOffset + gpsSize;
+  const tiff = [0x4d, 0x4d, ...u16(42), ...u32(8)];
+  tiff.push(...u16(ifd0Count));
+  tiff.push(...u16(0x010f), ...u16(2), ...u32(makeBytes.length), ...u32(makeOffset)); // Make
+  tiff.push(...u16(0x0112), ...u16(3), ...u32(1), ...u16(orientation), 0, 0); // Orientation
+  if (gps) tiff.push(...u16(0x8825), ...u16(4), ...u32(1), ...u32(gpsOffset)); // GPS IFD
+  tiff.push(...u32(0));
+  tiff.push(...makeBytes);
+  if (gps) {
+    tiff.push(...u16(gpsCount));
+    tiff.push(...u16(0x0001), ...u16(2), ...u32(2), 0x4e, 0, 0, 0); // N
+    tiff.push(...u16(0x0002), ...u16(5), ...u32(3), ...u32(ratOffset)); // 19° 4' 34"
+    tiff.push(...u16(0x0003), ...u16(2), ...u32(2), 0x45, 0, 0, 0); // E
+    tiff.push(...u16(0x0004), ...u16(5), ...u32(3), ...u32(ratOffset + 24)); // 72° 52' 39"
+    tiff.push(...u32(0));
+    for (const [n, d] of [
+      [19, 1],
+      [4, 1],
+      [34, 1],
+      [72, 1],
+      [52, 1],
+      [39, 1],
+    ])
+      tiff.push(...u32(n), ...u32(d));
+  }
+  const body = [...Buffer.from("Exif\0\0", "latin1"), ...tiff];
+  return Buffer.from([0xff, 0xe1, ...u16(body.length + 2), ...body]);
+}
+
+/** The JPEG with an EXIF segment put straight after SOI. */
+export const withExif = (jpeg, exif) => Buffer.concat([jpeg.subarray(0, 2), exif, jpeg.subarray(2)]);
+
+/** The markers of a JPEG's header, up to the scan: [{marker, offset, length}]. */
+export function jpegSegments(bytes) {
+  const b = Buffer.from(bytes);
+  const out = [];
+  if (b[0] !== 0xff || b[1] !== 0xd8) return out;
+  let i = 2;
+  while (i + 4 <= b.length) {
+    if (b[i] !== 0xff) break;
+    const marker = b[i + 1];
+    if (marker === 0xd8 || (marker >= 0xd0 && marker <= 0xd7) || marker === 0x01) {
+      i += 2;
+      continue;
+    }
+    const length = b.readUInt16BE(i + 2);
+    out.push({ marker, offset: i, length });
+    if (marker === 0xda) break;
+    i += 2 + length;
+  }
+  return out;
+}
+
+/** Width and height from the SOF segment. */
+export function jpegSize(bytes) {
+  const b = Buffer.from(bytes);
+  for (const s of jpegSegments(b)) {
+    if (s.marker >= 0xc0 && s.marker <= 0xcf && s.marker !== 0xc4 && s.marker !== 0xc8 && s.marker !== 0xcc) {
+      return {
+        height: b.readUInt16BE(s.offset + 5),
+        width: b.readUInt16BE(s.offset + 7),
+      };
+    }
+  }
+  return null;
+}
+
+/* ---------- drawing, in the page ---------- */
+
+const PAGE_SCRIPT = String.raw`
+window.__fx = (() => {
+  let seed = 7;
+  const rand = () => ((seed = (seed * 1103515245 + 12345) >>> 0) / 4294967296);
+  const canvas = (w, h) => { const c = document.createElement('canvas'); c.width = w; c.height = h; return c; };
+  /* A fine grain, so the photo checks do not read the drawing as out of focus. */
+  const grain = (c, amp) => {
+    const g = c.getContext('2d'); const img = g.getImageData(0, 0, c.width, c.height); const d = img.data;
+    for (let i = 0; i < d.length; i += 4) { const n = (rand() - 0.5) * amp; d[i] += n; d[i + 1] += n; d[i + 2] += n; }
+    g.putImageData(img, 0, 0);
+  };
+  const quadrants = (w, h, q) => {
+    const c = canvas(w, h); const g = c.getContext('2d');
+    const fill = (rgb, x, y) => { g.fillStyle = 'rgb(' + rgb.join(',') + ')'; g.fillRect(x, y, w / 2, h / 2); };
+    fill(q.tl, 0, 0); fill(q.tr, w / 2, 0); fill(q.bl, 0, h / 2); fill(q.br, w / 2, h / 2);
+    g.globalAlpha = 0.18; g.fillStyle = '#000';
+    for (let y = 0; y < h; y += 16) for (let x = (y / 16) % 2 ? 0 : 8; x < w; x += 16) g.fillRect(x, y, 8, 8);
+    g.globalAlpha = 1;
+    grain(c, 14);
+    return c;
+  };
+  const face = (w, h, dark) => {
+    const c = canvas(w, h); const g = c.getContext('2d');
+    const bg = g.createLinearGradient(0, 0, 0, h); bg.addColorStop(0, '#d9cfc2'); bg.addColorStop(1, '#b9ab98');
+    g.fillStyle = bg; g.fillRect(0, 0, w, h);
+    g.fillStyle = '#2f4f4f'; g.beginPath(); g.ellipse(w / 2, h * 1.02, w * 0.48, h * 0.26, 0, 0, Math.PI * 2); g.fill();
+    g.fillStyle = '#b07a5a'; g.fillRect(w * 0.42, h * 0.52, w * 0.16, h * 0.2);
+    g.beginPath(); g.ellipse(w * 0.29, h * 0.42, w * 0.045, h * 0.05, 0, 0, Math.PI * 2); g.fill();
+    g.beginPath(); g.ellipse(w * 0.71, h * 0.42, w * 0.045, h * 0.05, 0, 0, Math.PI * 2); g.fill();
+    g.fillStyle = '#c08a68'; g.beginPath(); g.ellipse(w / 2, h * 0.4, w * 0.21, h * 0.17, 0, 0, Math.PI * 2); g.fill();
+    g.fillStyle = '#2b1d16'; g.beginPath(); g.ellipse(w / 2, h * 0.27, w * 0.23, h * 0.09, 0, Math.PI, 0); g.fill();
+    g.fillStyle = '#3a2a22';
+    for (const x of [0.42, 0.58]) { g.beginPath(); g.ellipse(w * x, h * 0.39, w * 0.025, h * 0.01, 0, 0, Math.PI * 2); g.fill(); }
+    g.strokeStyle = '#8a4a3a'; g.lineWidth = w * 0.01; g.beginPath(); g.arc(w / 2, h * 0.45, w * 0.05, 0.2, Math.PI - 0.2); g.stroke();
+    grain(c, 14);
+    if (dark) { g.fillStyle = 'rgba(0,0,0,0.86)'; g.fillRect(0, 0, w, h); grain(c, 6); }
+    return c;
+  };
+  const hand = (w, h) => {
+    const c = canvas(w, h); const g = c.getContext('2d');
+    g.fillStyle = '#e4ddd2'; g.fillRect(0, 0, w, h);
+    g.fillStyle = '#b98361';
+    g.fillRect(w * 0.36, h * 0.68, w * 0.28, h * 0.32);
+    g.beginPath(); g.ellipse(w / 2, h * 0.6, w * 0.2, h * 0.14, 0, 0, Math.PI * 2); g.fill();
+    const finger = (x, top, len, wid, tilt) => { g.save(); g.translate(w * x, h * 0.52); g.rotate(tilt); g.fillRect(-w * wid / 2, -h * len, w * wid, h * len); g.beginPath(); g.ellipse(0, -h * len, w * wid / 2, w * wid / 2, 0, 0, Math.PI * 2); g.fill(); g.restore(); };
+    finger(0.37, 0, 0.2, 0.075, -0.12); finger(0.46, 0, 0.25, 0.08, -0.04); finger(0.55, 0, 0.24, 0.08, 0.04); finger(0.635, 0, 0.19, 0.072, 0.12);
+    g.save(); g.translate(w * 0.3, h * 0.64); g.rotate(-0.9); g.fillRect(-w * 0.045, -h * 0.16, w * 0.09, h * 0.16); g.restore();
+    grain(c, 14);
+    return c;
+  };
+  /* Stored the way a camera with this EXIF orientation stores the upright picture. */
+  const stored = (upright, o) => {
+    const W = upright.width, H = upright.height;
+    const s = o === 6 || o === 8 ? canvas(H, W) : canvas(W, H); const g = s.getContext('2d');
+    if (o === 3) { g.translate(W, H); g.rotate(Math.PI); }
+    if (o === 6) { g.translate(0, W); g.rotate(-Math.PI / 2); }
+    if (o === 8) { g.translate(H, 0); g.rotate(Math.PI / 2); }
+    g.drawImage(upright, 0, 0);
+    return s;
+  };
+  const encode = (c, type, q) => new Promise((r) => c.toBlob(async (b) => r(Array.from(new Uint8Array(await b.arrayBuffer()))), type, q));
+  return {
+    async quadrants(w, h, q, o, quality) { seed = 11; return encode(stored(quadrants(w, h, q), o), 'image/jpeg', quality); },
+    async face(w, h, dark, type, quality) { seed = 5; return encode(face(w, h, dark), type || 'image/jpeg', quality); },
+    async hand(w, h, quality) { seed = 9; return encode(hand(w, h), 'image/jpeg', quality); },
+  };
+})();`;
+
+/** Draws every fixture into `dir`. `big` adds the 4000x3000 camera-sized one. */
+export async function makeFixtures(dir, { big = true, browser = null } = {}) {
+  fs.mkdirSync(dir, { recursive: true });
+  const own = !browser;
+  const b = browser ?? (await launchChromium());
+  const ctx = await b.newContext();
+  await ctx.route("**/*", (r) => r.abort());
+  const page = await ctx.newPage();
+  await page.setContent("<html><body></body></html>");
+  await page.addScriptTag({ content: PAGE_SCRIPT });
+  const write = (name, bytes) => {
+    fs.writeFileSync(path.join(dir, name), Buffer.from(bytes));
+    return path.join(dir, name);
+  };
+  const out = {};
+  out.face = write("face.jpg", await page.evaluate(() => window.__fx.face(900, 1200, false, "image/jpeg", 0.82)));
+  out.hand = write("hand.jpg", await page.evaluate(() => window.__fx.hand(900, 1200, 0.82)));
+  out.dark = write("dark.jpg", await page.evaluate(() => window.__fx.face(900, 1200, true, "image/jpeg", 0.82)));
+  out.small = write("too-small-600x800.jpg", await page.evaluate(() => window.__fx.face(600, 800, false, "image/jpeg", 0.8)));
+  for (const o of [1, 3, 6, 8]) {
+    const raw = Buffer.from(await page.evaluate(([q, o]) => window.__fx.quadrants(900, 1200, q, o, 0.72), [QUADRANTS, o]));
+    out[`o${o}`] = write(`orient-${o}.jpg`, withExif(raw, exifSegment({ orientation: o, gps: o === 6 })));
+  }
+  // Bytes no browser can open: a HEIC box header (what an iPhone's "Most Compatible: off" sends) and plain text.
+  out.heic = write("photo.heic", Buffer.concat([Buffer.from([0, 0, 0, 0x18]), Buffer.from("ftypheic\0\0\0\0mif1heic", "latin1"), Buffer.alloc(2048, 7)]));
+  out.notImage = write("not-a-photo.jpg", Buffer.from("this is a text file named like a photo\n".repeat(40)));
+  if (big) {
+    // A PNG (prepared to JPEG like any photo) and a camera-sized photo; both are large, so drawn per run, not committed.
+    out.png = write("face.png", await page.evaluate(() => window.__fx.face(810, 1080, false, "image/png")));
+    const raw = Buffer.from(await page.evaluate(([q]) => window.__fx.quadrants(3000, 4000, q, 6, 0.9), [QUADRANTS]));
+    out.big = write("camera-4000x3000-o6-gps.jpg", withExif(raw, exifSegment({ orientation: 6, gps: true })));
+  }
+  await ctx.close();
+  if (own) await b.close();
+  return out;
+}
+
+if (process.argv[1] && fileURLToPath(import.meta.url) === path.resolve(process.argv[1])) {
+  const dir = process.argv[2] || path.join(path.dirname(fileURLToPath(import.meta.url)), "fixtures");
+  const out = await makeFixtures(dir, { big: process.argv.includes("--big") });
+  for (const [k, f] of Object.entries(out)) console.log(`${k.padEnd(9)} ${fs.statSync(f).size.toString().padStart(8)}  ${f}`);
+}
