+/* ================================================================== */
+/* pdp: the Add to cart box at 360x640, chip off and on, against main  */
+/* ================================================================== */
+
+async function pdp() {
+  group = "pdp";
+  const builds = [
+    ["main", MAIN],
+    ["off", BASE],
+    ["on", FLAG_ON],
+  ].filter(([, u]) => u);
+  const rows = {};
+  for (const [name, base] of builds) {
+    for (const handle of ["woven-gold-hoops", "baguette-huggies", "cushion-halo-ring"]) {
+      const { context, page, log } = await openContext("android360");
+      await page.goto(`${base}/jewellery/${handle}`, {
+        waitUntil: "domcontentloaded",
+      });
+      await page.waitForSelector("#product-actions > button", {
+        timeout: 30000,
+      });
+      await page.waitForTimeout(4500);
+      const r = await page.evaluate(() => {
+        const box = (el) => {
+          if (!el) return null;
+          const b = el.getBoundingClientRect();
+          return [Math.round(b.x), Math.round(b.y + window.scrollY), Math.round(b.width), Math.round(b.height)];
+        };
+        // JewelDetailNext's line under the buttons is the gift line; its delivery and COD words sit in the Shipping panel.
+        const gift = Array.from(document.querySelectorAll("#product-actions p")).pop();
+        return {
+          add: box(document.querySelector("#product-actions > button")),
+          price: box(document.getElementById("product-price")),
+          actions: box(document.getElementById("product-actions")),
+          giftLine: box(gift ?? null),
+          chips: [...document.querySelectorAll("[data-tryon-entry]")]
+            .filter((e) => e.offsetParent)
+            .map((e) => ({
+              box: box(e),
+              href: e.getAttribute("href"),
+              text: e.textContent.trim(),
+            })),
+          scrolled: window.scrollY,
+        };
+      });
+      r.heavy = log.requests.filter((q) => /three|gsap|mediapipe|tasks-vision/i.test(q.url)).length;
+      r.tryonJs = log.requests.filter((q) => /\/assets\/(TryOn|tryOn)/.test(q.url)).map((q) => q.url.split("/").pop());
+      rows[`${name} ${handle}`] = r;
+      await shot(page, `pdp-${name}-${handle}`);
+      await context.close();
+    }
+  }
+  fs.writeFileSync(path.join(OUT, "pdp-boxes.json"), JSON.stringify(rows, null, 1));
+  for (const handle of ["woven-gold-hoops", "baguette-huggies", "cushion-halo-ring"]) {
+    const ref = rows[`off ${handle}`];
+    for (const [name] of builds.filter(([n]) => n !== "off")) {
+      const r = rows[`${name} ${handle}`];
+      check(
+        `${handle}: Add to cart, price, the action block and the line under it identical to the pixel, ${name} vs this branch`,
+        JSON.stringify([r.add, r.price, r.actions, r.giftLine]) === JSON.stringify([ref.add, ref.price, ref.actions, ref.giftLine]),
+        { [name]: [r.add, r.giftLine], off: [ref.add, ref.giftLine] },
+      );
+    }
+    note(`${handle} at 360x640: Add to cart box and the line under it (same on every build)`, { add: ref.add, line: ref.giftLine });
+    check(`${handle}: chip off renders nothing`, ref.chips.length === 0, ref.chips);
+    if (FLAG_ON) {
+      const on = rows[`on ${handle}`];
+      check(
+        `${handle}: chip on sits under the heart and links to the studio`,
+        on.chips.length === 1 && on.chips[0].text === "Try on" && on.chips[0].href.startsWith(`/try-on/${handle}`),
+        on.chips,
+      );
+    }
+    for (const [name] of builds) {
+      const r = rows[`${name} ${handle}`];
+      check(`${handle} (${name}): no three.js, gsap, mediapipe or try-on code on the product page`, r.heavy === 0 && r.tryonJs.length === 0, {
+        heavy: r.heavy,
+        tryonJs: r.tryonJs,
+      });
+    }
+  }
+}
