+  const cdp = await context.newCDPSession(page);
+  const cases = [
+    ["orient-1", FX.o1],
+    ["orient-3", FX.o3],
+    ["orient-6 (GPS)", FX.o6],
+    ["orient-8", FX.o8],
+    ["camera 4000x3000, orient-6, GPS", FX.big],
+    ["PNG", FX.png],
+  ];
+  const timings = [];
+  let first = true;
+  for (const [label, file] of cases) {
+    await gotoStudio(page, BASE, "woven-gold-hoops");
+    const throttle = /4000x3000/.test(label);
+    if (throttle) await cdp.send("Emulation.setCPUThrottlingRate", { rate: 4 });
+    const runs = throttle ? 5 : 1;
+    let bytes = null;
+    for (let i = 0; i < runs; i++) {
+      if (i > 0) await gotoStudio(page, BASE, "woven-gold-hoops");
+      const before = renderRequests(log).length;
+      await choosePhoto(page, file);
+      // The crop is drawn (and the photo decoded for it) by the next frames; the shopper waits for that, not for the element.
+      await page.evaluate(
+        () => new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(() => r((window.__e2e.marks.drawn = performance.now()))))),
+      );
+      await usePhoto(page);
+      if (first && (await consentSheet(page).count())) {
+        await giveConsent(page, log);
+        first = false;
+      }
+      await page.waitForFunction(() => window.__e2e.marks.send, null, {
+        timeout: 30000,
+      });
+      const m = await page.evaluate(() => window.__e2e.marks);
+      if (throttle)
+        timings.push({ total: Math.round(m.drawn - m.pick + (m.ready - m.use)), decode: Math.round(m.drawn - m.pick), encode: Math.round(m.ready - m.use) });
+      await waitOutcome(page);
+      const req = renderRequests(log).slice(before)[0];
