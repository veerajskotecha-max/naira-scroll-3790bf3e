+  await gotoStudio(page, BASE, "woven-gold-hoops");
+  await choosePhoto(page, FX.dark);
+  await page.getByRole("button", { name: "Use this photo" }).click();
+  const dark = await page
+    .waitForFunction((c) => document.body.innerText.includes(c), COPY.dark, {
+      timeout: 30000,
