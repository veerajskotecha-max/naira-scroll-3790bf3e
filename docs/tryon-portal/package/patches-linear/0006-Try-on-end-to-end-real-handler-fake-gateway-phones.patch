+  timings.sort((a, b) => a.total - b.total);
+  const median = timings[Math.floor(timings.length / 2)];
+  note("prep ms at 4x CPU, 4000x3000, as the shopper waits (file chosen to crop painted, plus Use tapped to sent)", timings);
