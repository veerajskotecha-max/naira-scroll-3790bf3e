+
+const consentSheet = (page) => page.locator('[aria-labelledby="tryon-consent-title"]');
+
+/** Ticks the box and taps Create, reporting the gate's state first. */
+const giveConsent = async (page, log) => {
+  const sheet = consentSheet(page);
