+        `${label}: upright (red top left, green top right, blue bottom left, yellow bottom right)`,
+        near(q.tl, QUADRANTS.tl) && near(q.tr, QUADRANTS.tr) && near(q.bl, QUADRANTS.bl) && near(q.br, QUADRANTS.br),
+        q,
+      );
+    }
