+    "journey: no console errors",
+    realConsoleErrors(log).length === 0 && log.pageErrors.length === 0,
+    [...realConsoleErrors(log), ...log.pageErrors].slice(0, 3),
+  );
+  const v = imageViolations(log);
+  check("journey: request audit (direct transport) clean", v.pre.length === 0 && v.post.length === 0, v);
+  await scenario({ name: "ok" });
