+function weights() {
+  if (!DIST) return;
+  group = "weight";
+  const manifest = JSON.parse(fs.readFileSync(path.join(DIST, ".vite/manifest.json"), "utf8"));
+  const gz = (file) => zlib.gzipSync(fs.readFileSync(path.join(DIST, file))).length;
