+  await waitResult(page, 60000);
+  await page.waitForTimeout(1200);
+  await s("11-result");
+  await page.getByRole("button", { name: "Show my photo" }).click();
+  await page.waitForTimeout(400);
+  await s("12-compare");
+  await page.getByRole("button", { name: "Show my photo" }).click();
+  await waitLive(page);
+  const add = page.locator("[data-tryon-buy]").last().getByRole("button", { name: /^Add/ }).first();
+  await page.waitForFunction((el) => !el.disabled, await add.elementHandle(), {
+    timeout: 30000,
+  });
+  await add.click();
