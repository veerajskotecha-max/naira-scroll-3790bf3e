+/** Buttons, links and form controls in the page body that are smaller than 44x44 CSS px (the header is the shop's own). */
+const smallTargets = (page) =>
+  page.evaluate(() => {
+    const out = [];
+    const header = document.querySelector("header, nav");
+    for (const el of document.querySelectorAll('button, a[href], input:not([type="hidden"]), [role="radio"], [role="button"], label')) {
+      if (header && header.contains(el)) continue;
+      if (el.closest("footer")) continue;
+      const r = el.getBoundingClientRect();
+      const st = getComputedStyle(el);
+      if (!r.width || !r.height || st.visibility === "hidden" || st.display === "none") continue;
+      if (el.tagName === "INPUT" && (el.type === "file" || el.type === "checkbox")) {
+        // A file input is driven by its button; a checkbox by its whole label.
+        const label = el.closest("label");
+        if (el.type === "file" || (label && label.getBoundingClientRect().height >= 44)) continue;
+      }
+      if (el.tagName === "LABEL" && !el.querySelector("input")) continue;
+      // An inline link inside running text is exempt (WCAG 2.5.8): it is a word, not a control.
+      const inline = el.tagName === "A" && st.display === "inline" && el.parentElement && /^(P|SPAN|LI)$/.test(el.parentElement.tagName);
