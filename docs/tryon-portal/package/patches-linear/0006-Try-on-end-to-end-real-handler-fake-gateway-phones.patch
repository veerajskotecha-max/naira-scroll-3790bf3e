+async function prodsim() {
+  group = "prodsim";
+  if (!FLAG_ON) return note("prodsim", "skipped: needs --flag-on (every piece certified, chip on)");
+  await local("/__env", {
+    TRYON_ENABLED: "on",
+    TRYON_DEVICE_DAILY: "1000",
+    TRYON_IP_DAILY: "1000",
