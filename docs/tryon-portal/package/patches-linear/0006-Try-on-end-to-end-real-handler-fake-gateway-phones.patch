+    "dark photo: the 'a little dark' warning with Retake / Use anyway",
+    dark && (await page.getByRole("button", { name: "Use anyway" }).count()) === 1 && (await page.getByRole("button", { name: "Retake" }).count()) === 1,
+  );
+  await shot(page, "prep-warning-dark");
+  check("no console errors", realConsoleErrors(log).length === 0 && log.pageErrors.length === 0, [...realConsoleErrors(log), ...log.pageErrors].slice(0, 3));
+  await context.close();
+}
