+  // The test build is served from its own origin; the function must accept it as it accepts a preview.
+  await local("/__env", { TRYON_EXTRA_ORIGINS: [BASE, FLAG_ON].map((u) => new URL(u).origin).join(",") });
+  await scenario({ name: "ok" });
+  const { context, page, log } = await openContext("pixel7", { prodSim: true });
+  // From the product page's chip, as a shopper would come.
+  await page.goto(`${FLAG_ON}/jewellery/woven-gold-hoops`, {
+    waitUntil: "domcontentloaded",
+  });
+  await page.waitForSelector("[data-tryon-entry]", { timeout: 30000 });
+  const pdpEvents = await metaCalls(page);
+  await page.locator("[data-tryon-entry]").filter({ visible: true }).first().click();
+  await page.waitForURL(/\/try-on\/woven-gold-hoops/, { timeout: 15000 });
+  await page.waitForSelector('[data-tryon-input="library"]', {
+    state: "attached",
+    timeout: 30000,
+  });
+  await waitLive(page);
+  const atStudio = await metaCalls(page);
+  await choosePhoto(page, FACE);
+  await usePhoto(page);
+  await giveConsent(page, log);
+  await waitResult(page);
+  await page.getByRole("button", { name: "Show my photo" }).click();
+  await page.getByRole("button", { name: "Not quite" }).click();
+  await page.waitForTimeout(800);
+  await page.keyboard.press("Escape");
+  await page.waitForTimeout(500);
+  const beforeAdd = await metaCalls(page);
+  const capiBeforeAdd = capiAttempts(log);
+  const add = page.locator("[data-tryon-buy]").last().getByRole("button", { name: /^Add/ }).first();
+  await page.waitForFunction((el) => !el.disabled, await add.elementHandle(), {
+    timeout: 30000,
+  });
+  await add.click();
+  await page.waitForFunction(() => JSON.parse(localStorage.getItem("naira-shopify-cart") || '{"items":[]}').items.length > 0, null, { timeout: 30000 });
+  await page.waitForTimeout(1500);
+  const afterAdd = await metaCalls(page);
+  const clarity = await clarityCalls(page);
+  const tryonEvents = clarity.filter((c) => c[0] === "event" && /^tryon_/.test(c[1])).map((c) => c[1]);
+  const tags = clarity.filter((c) => c[0] === "set" && /tryon/.test(c[1])).map((c) => `${c[1]}=${c[2]}`);
+  note("Clarity try-on events (live gates on)", tryonEvents);
+  note("Clarity try-on tags", [...new Set(tags)]);
+  check(
+    "Clarity: every try-on event name is on the allow-list",
+    tryonEvents.length > 0 && tryonEvents.every((n) => BASE_EVENTS.has(n) || FAILED_EVENT.test(n)),
+    tryonEvents.filter((n) => !(BASE_EVENTS.has(n) || FAILED_EVENT.test(n))),
+  );
+  check(
+    "Clarity: only the tags tryon=used and tryon_piece=<handle>",
+    tags.every((t) => t === "tryon=used" || t === "tryon_piece=woven-gold-hoops"),
+    [...new Set(tags)],
+  );
+  const tryonPhaseMeta = beforeAdd.slice(pdpEvents.length);
+  check("Meta: nothing from the try-on path itself (no ViewContent, no CustomizeProduct)", !tryonPhaseMeta.some((e) => e !== "PageView"), {
+    pdp: pdpEvents,
+    atStudio: atStudio.slice(pdpEvents.length),
+    beforeAdd: tryonPhaseMeta,
+  });
+  check("meta-capi: no attempt from the try-on path before Add", capiBeforeAdd.filter((e) => e !== "ViewContent").length === 0, capiBeforeAdd);
+  check(
+    "Add fires exactly one AddToCart (CartContext)",
+    afterAdd.filter((e) => e === "AddToCart").length - beforeAdd.filter((e) => e === "AddToCart").length === 1,
+    afterAdd.slice(beforeAdd.length),
+  );
+  check(
+    "meta-capi attempts are all aborted by NO_REPORT (none reached)",
+    log.blocked.filter((b) => /meta-capi/.test(b.url)).length === capiAttempts(log).length,
+    capiAttempts(log),
+  );
+  note("meta-capi attempts by event (aborted)", capiAttempts(log));
+  note("reporting requests aborted (all hosts)", [...new Set(log.blocked.map((b) => new URL(b.url).host + new URL(b.url).pathname.replace(/\/[^/]*$/, "")))]);
+  check("no console errors", realConsoleErrors(log).length === 0 && log.pageErrors.length === 0, [...realConsoleErrors(log), ...log.pageErrors].slice(0, 3));
+  await context.close();
+}
