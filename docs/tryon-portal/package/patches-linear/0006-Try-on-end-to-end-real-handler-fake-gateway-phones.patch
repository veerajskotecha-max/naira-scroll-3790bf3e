+const photoPart = (body) => {
+  // multipart: the "photo" part's bytes, from its header to the next boundary.
+  const b = Buffer.from(body);
+  const head = b.indexOf('name="photo"');
+  if (head < 0) return null;
+  const start = b.indexOf("\r\n\r\n", head) + 4;
+  const boundary = b.subarray(0, b.indexOf("\r\n"));
+  const end = b.indexOf(Buffer.concat([Buffer.from("\r\n"), boundary]), start);
+  return b.subarray(start, end);
+};
+const metaPart = (body) => {
+  const b = Buffer.from(body).toString("latin1");
+  const m = /name="meta"\r\n\r\n([\s\S]*?)\r\n--/.exec(b);
+  return m ? JSON.parse(m[1]) : null;
+};
+
+/* The four quadrant colours of a JPEG, read back by the browser that will show it. */
+const quadrantsOf = (page, bytes) =>
+  page.evaluate(async (arr) => {
+    const bmp = await createImageBitmap(new Blob([new Uint8Array(arr)], { type: "image/jpeg" }));
+    const c = document.createElement("canvas");
+    c.width = bmp.width;
+    c.height = bmp.height;
+    const g = c.getContext("2d");
+    g.drawImage(bmp, 0, 0);
+    const avg = (fx, fy) => {
+      const d = g.getImageData(Math.round(bmp.width * fx) - 30, Math.round(bmp.height * fy) - 30, 60, 60).data;
+      const s = [0, 0, 0];
+      for (let i = 0; i < d.length; i += 4) for (let k = 0; k < 3; k++) s[k] += d[i + k];
+      return s.map((v) => Math.round(v / (d.length / 4)));
+    };
+    return {
+      size: [bmp.width, bmp.height],
+      tl: avg(0.25, 0.25),
+      tr: avg(0.75, 0.25),
+      bl: avg(0.25, 0.75),
+      br: avg(0.75, 0.75),
+    };
+  }, Array.from(bytes));
+const near = (a, b) => a.every((v, i) => Math.abs(v - b[i]) < 60);
