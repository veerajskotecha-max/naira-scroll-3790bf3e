+/* ================================================================== */
+/* fold: a 360x640 Android, the first preview of a visit, slow render  */
+/* ================================================================== */
+
+/* The review's walk (SHOP-1, SHOP-2, SHOP-4): at 360x640 the crop's "Use this
+   photo" sat below the fold under a frame that takes no swipe, and the first
+   preview of a visit (its screen's code not yet fetched) landed 525 px above
+   the screen with focus on <body>. A fresh context, so that code is fetched
+   during this very render, and a 4 s render, so the wait is a real one. */
+async function fold() {
+  group = "fold";
+  for (const profile of ["android360", "iphone13"]) {
+    const { context, page, log } = await openContext(profile);
+    await scenario({ name: "slow", delayMs: 4000 });
+    try {
+      await gotoStudio(page, BASE, "woven-gold-hoops");
+      await waitLive(page);
+      await choosePhoto(page, FACE);
+      await page.waitForTimeout(300);
+      const crop = await cropFold(page);
+      check(`${profile}: crop 'Use this photo' on screen without a swipe`, useOnScreen(crop), crop);
+      await shot(page, `fold-${profile}-crop`);
+      await usePhoto(page);
+      await giveConsent(page, log);
+      await waitResult(page);
+      const arrival = await resultArrival(page);
+      check(`${profile}: the first preview lands on screen, focus on its heading`, resultOnScreen(arrival), arrival);
+      await shot(page, `fold-${profile}-result`);
+      check(`${profile}: no console errors`, realConsoleErrors(log).length === 0 && log.pageErrors.length === 0, [...realConsoleErrors(log), ...log.pageErrors].slice(0, 3));
+    } catch (e) {
+      check(`${profile}: fold walk ran to the end`, false, String(e).split("\n")[0]);
+    } finally {
+      await scenario({ name: "ok" });
+      await context.close();
+    }
+  }
+}
