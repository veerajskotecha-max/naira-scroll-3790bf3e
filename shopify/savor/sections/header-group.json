{
  "type": "header",
  "name": "t:names.header",
  "sections": {
    "header_section": {
      "type": "header",
      "blocks": {
        "header-logo": {
          "type": "_header-logo",
          "static": true,
          "settings": {
            "hide_logo_on_home_page": false
          },
          "blocks": {}
        },
        "header-menu": {
          "type": "_header-menu",
          "static": true,
          "settings": {
            "menu": "main-menu",
            "type_font_primary_size": "0.8125rem",
            "menu_font_style": "inverse_large",
            "type_font_primary_link": "subheading",
            "type_case_primary_link": "uppercase",
            "menu_style": "featured_collections",
            "featured_products_aspect_ratio": "4 / 5",
            "featured_collections_aspect_ratio": "16 / 9",
            "image_border_radius": 0,
            "navigation_bar": false,
            "drawer_accordion": false,
            "drawer_accordion_expand_first": false,
            "drawer_dividers": false
          },
          "blocks": {}
        }
      },
      "settings": {
        "logo_position": "left",
        "menu_position": "left",
        "menu_row": "top",
        "show_search": true,
        "search_position": "right",
        "search_row": "top",
        "show_country": false,
        "show_language": false,
        "localization_font": "heading",
        "localization_font_size": "1rem",
        "localization_position": "right",
        "localization_row": "top",
        "section_width": "full-width",
        "section_height": "standard",
        "enable_sticky_header": "always",
        "divider_width": 1,
        "divider_size": "page-width",
        "border_width": 0,
        "background_color_top": "{{ settings.color_palette.background }}",
        "enable_transparent_header_home": false,
        "enable_transparent_header_product": false,
        "enable_transparent_header_collection": false,
        "text_color_transparent_home": "{{ settings.color_palette.foreground }}",
        "text_color_transparent_collection": "{{ settings.color_palette.foreground }}"
      }
    },
    "announcements": {
      "type": "header-announcements",
      "blocks": {
        "a1": {
          "type": "_announcement",
          "settings": {
            "text": "10% off your first order · code NAIRA10",
            "font": "var(--font-body--family)",
            "font_size": "0.625rem",
            "weight": "400",
            "letter_spacing": "loose",
            "case": "uppercase",
            "text_color": "#1A1614",
            "link": "shopify://collections/shop-all"
          }
        },
        "a2": {
          "type": "_announcement",
          "settings": {
            "text": "Free insured shipping across India",
            "font": "var(--font-body--family)",
            "font_size": "0.625rem",
            "weight": "400",
            "letter_spacing": "loose",
            "case": "uppercase",
            "text_color": "#1A1614"
          }
        },
        "a3": {
          "type": "_announcement",
          "settings": {
            "text": "Gold tone plated · anti-tarnish · 7-day returns",
            "font": "var(--font-body--family)",
            "font_size": "0.625rem",
            "weight": "400",
            "letter_spacing": "loose",
            "case": "uppercase",
            "text_color": "#1A1614"
          }
        }
      },
      "block_order": [
        "a1",
        "a2",
        "a3"
      ],
      "settings": {
        "speed": 5,
        "section_width": "full-width",
        "background_color": "#99B4AF",
        "divider_width": 0,
        "padding-block-start": 10,
        "padding-block-end": 10
      }
    }
  },
  "order": [
    "announcements",
    "header_section"
  ]
}
