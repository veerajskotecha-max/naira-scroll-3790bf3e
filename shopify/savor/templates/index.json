{
  "sections": {
    "hero": {
      "type": "hero",
      "blocks": {
        "hero_group": {
          "type": "group",
          "settings": {
            "content_direction": "column",
            "horizontal_alignment": "flex-start",
            "vertical_alignment": "center",
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 18,
            "width": "custom",
            "custom_width": 100,
            "width_mobile": "fill"
          },
          "blocks": {
            "hero_eyebrow": {
              "type": "text",
              "settings": {
                "text": "<p>The zircone edit · Demi-fine</p>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h6",
                "font": "var(--font-body--family)",
                "line_height": "normal",
                "letter_spacing": "0.32em",
                "case": "uppercase",
                "text_color": "{{ settings.color_palette.foreground }}",
                "font_size": "0.625rem"
              },
              "blocks": {}
            },
            "hero_line": {
              "type": "text",
              "settings": {
                "text": "<p>Fine jewellery, made to be worn every day.</p>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "h1",
                "font": "var(--font-heading--family)",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "text_color": "{{ settings.color_palette.foreground }}"
              },
              "blocks": {}
            },
            "hero_sub": {
              "type": "text",
              "settings": {
                "text": "<p>Gold tone plated over brass, anti-tarnish, and dispatched insured from our Mumbai atelier in 3–5 working days.</p>",
                "width": "100%",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "text_color": "{{ settings.color_palette.foreground }}"
              },
              "blocks": {}
            },
            "hero_btn": {
              "type": "button",
              "settings": {
                "label": "Shop all jewellery",
                "link": "shopify://collections/shop-all",
                "style_class": "button-primary",
                "width": "fit-content",
                "width_mobile": "fill"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "hero_eyebrow",
            "hero_line",
            "hero_sub",
            "hero_btn"
          ]
        }
      },
      "block_order": [
        "hero_group"
      ],
