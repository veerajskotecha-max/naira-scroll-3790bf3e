{%- comment -%}
  Naira Flore — 404. No React equivalent (the SPA renders a NotFound
  route inline); built in the brand's language so a wrong URL doesn't
  drop the shopper onto raw Sense styling.
{%- endcomment -%}
<section class="nf nf-404">
  <p class="nf-404__eyebrow">{{ section.settings.eyebrow | escape }}</p>
  <h1 class="nf-404__title">{{ section.settings.heading | escape }}</h1>
  <p class="nf-404__copy">{{ section.settings.copy }}</p>
  <div class="nf-404__actions">
    <a class="nf-404__cta" href="{{ routes.all_products_collection_url }}">VIEW ALL PIECES</a>
    <a class="nf-404__ghost" href="{{ routes.root_url }}">BACK HOME</a>
  </div>
</section>

{% stylesheet %}
.nf-404 { max-width: 40rem; margin-inline: auto; text-align: center; padding: 5rem 1.5rem 7rem; }
.nf-404__eyebrow { margin: 0; font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-40); color: var(--nf-gold-shadow); }
.nf-404__title { margin: 1rem 0 0; font-family: var(--nf-font-display); font-size: 32px; line-height: 1.1; color: var(--nf-ink); }
@media (min-width: 768px) { .nf-404__title { font-size: 44px; } }
.nf-404__copy { margin: 1rem 0 0; font-family: var(--nf-font-editorial); font-size: 15px; line-height: 1.8; color: rgb(var(--nf-ink-rgb) / .6); }
.nf-404__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: .75rem; margin-top: 2rem; }
.nf-404__cta, .nf-404__ghost { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding-inline: 1.5rem; text-decoration: none; font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: var(--nf-track-24); }
.nf-404__cta { border: 1px solid var(--nf-ink); background-color: var(--nf-ink); color: var(--nf-ivory); }
.nf-404__ghost { border: 1px solid rgb(var(--nf-ink-rgb) / .3); color: var(--nf-ink); }
.nf-404__ghost:hover { border-color: var(--nf-ink); }
{% endstylesheet %}

{% schema %}
{
  "name": "NF 404",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "404" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has slipped away" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>The link may be old, or the piece may have found its owner. The full collection is a step away.</p>" }
  ]
}
{% endschema %}
