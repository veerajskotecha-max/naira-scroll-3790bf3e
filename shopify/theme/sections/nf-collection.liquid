{%- comment -%}
  ═══════════════════════════════════════════════════════════════════
  Naira Flore — collection / listing page
  Ported from src/pages/Jewellery.tsx + JewelleryCategory.tsx.

  Category pills filter client-side (same UX as the React page: no
  reload, no scroll jump). Shopify's faceted `collection.filters` was
  not used because the React page filters on a derived category, not
  on a storefront filter — matching the derivation keeps the two
  pages identical rather than approximately similar.

  Cards come from snippets/nf-product-card.liquid, which is already
  the port of ProductCard.tsx, so card markup stays in one place.
  ═══════════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign products = collection.products
  assign cats = 'Rings,Bracelets,Earrings,Necklaces' | split: ','

  # Derive each product's category ONCE, in this order. 'earring' contains the
  # substring 'ring', so testing rings first files every stud under Rings —
  # which is exactly the bug this ordering exists to prevent. Mirrors
  # CATEGORY_BY_TYPE + guessCategory in src/hooks/useLiveJewellery.ts.
  assign cat_csv = ''
  for p in products
    assign t = p.type | downcase
    assign c = 'Necklaces'
    if t contains 'earr' or t contains 'stud' or t contains 'hoop' or t contains 'huggie'
      assign c = 'Earrings'
    elsif t contains 'brac' or t contains 'cuff' or t contains 'ankl'
      assign c = 'Bracelets'
    elsif t contains 'ring' or t contains 'band'
      assign c = 'Rings'
    endif
    assign cat_csv = cat_csv | append: c | append: ','
  endfor
  assign cat_of = cat_csv | split: ','
-%}

<section class="nf nf-coll" data-nf-collection>
  <div class="nf-coll__hero">
    <header class="nf-coll__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-coll__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="nf-coll__title">{{ section.settings.heading | default: collection.title | escape }}</h1>
      {%- assign lede = section.settings.lede | default: collection.description -%}
      {%- if lede != blank -%}
        <p class="nf-coll__lede">{{ lede }}</p>
      {%- endif -%}
    </header>
  </div>

  {%- if section.settings.show_filters -%}
    <div class="nf-coll__filterbar">
      <div class="nf-coll__filters" role="group" aria-label="Filter by category">
        <button type="button" class="nf-coll__pill is-active" data-nf-cat="All" aria-pressed="true">
          <span>ALL</span><span class="nf-coll__count" aria-hidden="true">{{ products.size }}</span>
        </button>
        {%- for c in cats -%}
          {%- assign n = 0 -%}
          {%- for x in cat_of -%}
            {%- if x == c -%}{%- assign n = n | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if n > 0 -%}
            <button type="button" class="nf-coll__pill" data-nf-cat="{{ c }}" aria-pressed="false">
              <span>{{ c | upcase }}</span><span class="nf-coll__count" aria-hidden="true">{{ n }}</span>
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if products.size > 0 -%}
    {%- comment -%}
      paginate is required: outside it Shopify caps collection.products at 50,
      and shop-all carries 68. The category pills filter within the current page,
      which is why the page size is generous.
    {%- endcomment -%}
    {%- paginate collection.products by 48 -%}
    <div class="nf-coll__grid" data-nf-grid>
      {%- for product in products -%}
        {%- assign cat = cat_of[forloop.index0] -%}
        <div class="nf-coll__cell" data-nf-cell data-cat="{{ cat }}">
          {%- render 'nf-product-card', product: product, index: forloop.index0, uid: section.id -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="nf-coll__pager" aria-label="Pagination">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">Previous</a>{%- endif -%}
        <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
    {%- endpaginate -%}
    <div class="nf-coll__empty" data-nf-empty hidden>
      <h2 class="nf-coll__empty-title">Nothing in this edit yet</h2>
      <p class="nf-coll__empty-copy">New pieces join Naira Petite regularly. The full collection is a step away.</p>
      <button type="button" class="nf-coll__empty-cta" data-nf-cat-reset>VIEW ALL PIECES</button>
    </div>
  {%- else -%}
    <div class="nf-coll__empty">
      <h2 class="nf-coll__empty-title">Nothing in this edit yet</h2>
      <p class="nf-coll__empty-copy">New pieces join Naira Petite regularly. The full collection is a step away.</p>
      <a class="nf-coll__empty-cta" href="{{ routes.all_products_collection_url }}">VIEW ALL PIECES</a>
    </div>
  {%- endif -%}
</section>

<script>
  // Pills hide/show cells in place. No refetch, no scroll jump — the React
  // page keeps its scroll position when a category changes, so this does too.
  (function () {
    document.querySelectorAll('[data-nf-collection]').forEach(function (root) {
      var cells = root.querySelectorAll('[data-nf-cell]');
      var empty = root.querySelector('[data-nf-empty]');
      function apply(cat) {
        var shown = 0;
        cells.forEach(function (c) {
          var on = cat === 'All' || c.getAttribute('data-cat') === cat;
          c.hidden = !on;
          if (on) shown++;
        });
        if (empty) empty.hidden = shown !== 0;
        root.querySelectorAll('[data-nf-cat]').forEach(function (b) {
          var on = b.getAttribute('data-nf-cat') === cat;
          b.classList.toggle('is-active', on);
          b.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
      }
      root.querySelectorAll('[data-nf-cat]').forEach(function (b) {
        b.addEventListener('click', function () { apply(b.getAttribute('data-nf-cat')); });
      });
      var reset = root.querySelector('[data-nf-cat-reset]');
      if (reset) reset.addEventListener('click', function () { apply('All'); });
    });
  })();
</script>

{% stylesheet %}
.nf-coll__pager { display: flex; justify-content: center; align-items: center; gap: 1.25rem; padding: 0 1rem 3rem; font-family: var(--nf-font-label); font-size: 11px; letter-spacing: var(--nf-track-18); text-transform: uppercase; color: rgb(var(--nf-ink-rgb) / .6); }
.nf-coll__pager a { color: var(--nf-ink); text-decoration: none; border-bottom: 1px solid var(--nf-gold-deep); padding-bottom: 2px; }
.nf-coll__pager a:hover { color: var(--nf-gold-deep); }

.nf-coll__hero { background-color: var(--nf-ivory); }
.nf-coll__head { max-width: 72rem; margin-inline: auto; padding: 1.5rem 1rem; }
@media (min-width: 640px) { .nf-coll__head { padding-inline: 1.5rem; } }
@media (min-width: 768px) { .nf-coll__head { padding-top: 2.5rem; } }

.nf-coll__eyebrow { margin: 0; font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-40); color: var(--nf-gold-shadow); }
.nf-coll__title { margin: .75rem 0 0; font-family: var(--nf-font-display); font-size: 30px; line-height: 1.05; color: var(--nf-ink); }
@media (min-width: 768px) { .nf-coll__title { font-size: 48px; } }
.nf-coll__lede { margin: .75rem 0 0; max-width: 36rem; font-family: var(--nf-font-editorial); font-size: 14px; line-height: 1.8; color: rgb(var(--nf-ink-rgb) / .6); }
@media (min-width: 768px) { .nf-coll__lede { font-size: 16px; } }

.nf-coll__filterbar { position: sticky; top: 94px; z-index: 20; background-color: var(--nf-ivory); padding-block: 1rem; }
@media (min-width: 768px) { .nf-coll__filterbar { top: 100px; padding-block: 1.25rem; } }
@media (min-width: 1024px) { .nf-coll__filterbar { top: 116px; } }
.nf-coll__filters { display: flex; flex-wrap: nowrap; align-items: center; gap: .5rem; max-width: 72rem; margin-inline: auto; padding-inline: 1rem; overflow-x: auto; scrollbar-width: none; }
.nf-coll__filters::-webkit-scrollbar { display: none; }
@media (min-width: 640px) { .nf-coll__filters { justify-content: center; overflow: visible; padding-inline: 1.5rem; } }

.nf-coll__pill { display: inline-flex; align-items: baseline; gap: .375rem; flex-shrink: 0; min-height: 44px; padding-inline: 1rem; background: none; cursor: pointer;
  border: 1px solid rgb(var(--nf-ink-rgb) / .25); color: rgb(var(--nf-ink-rgb) / .7);
  font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-18); transition: border-color .2s, background-color .2s, color .2s; }
.nf-coll__pill > span { align-self: center; }
@media (min-width: 640px) { .nf-coll__pill { padding-inline: 1.25rem; font-size: 11px; letter-spacing: var(--nf-track-30); } }
.nf-coll__pill:hover { border-color: rgb(var(--nf-ink-rgb) / .6); }
.nf-coll__pill.is-active { border-color: var(--nf-ink); background-color: var(--nf-ink); color: var(--nf-ivory); }
.nf-coll__count { font-size: 9px; letter-spacing: var(--nf-track-8); color: rgb(var(--nf-ink-rgb) / .4); }
@media (min-width: 640px) { .nf-coll__count { font-size: 9.5px; } }
.nf-coll__pill.is-active .nf-coll__count { color: rgb(var(--nf-ivory-rgb) / .6); }

.nf-coll__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; max-width: 72rem; margin-inline: auto; padding: 2.5rem 1rem 4rem; }
@media (min-width: 640px) { .nf-coll__grid { gap: 1.5rem; padding-inline: 1.5rem; } }
@media (min-width: 1024px) { .nf-coll__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }
.nf-coll__cell[hidden] { display: none; }

/* An explicit display: wins over the UA stylesheet's [hidden]{display:none},
   so the empty state must opt out of its own display when hidden. */
.nf-coll__empty[hidden] { display: none; }
.nf-coll__empty { display: flex; flex-direction: column; align-items: center; text-align: center; max-width: 72rem; margin-inline: auto; padding: 4rem 1.5rem 6rem; }
.nf-coll__empty-title { margin: 0; font-family: var(--nf-font-display); font-size: 26px; line-height: 1.15; color: var(--nf-ink); }
@media (min-width: 768px) { .nf-coll__empty-title { font-size: 32px; } }
.nf-coll__empty-copy { margin: .75rem 0 0; max-width: 24rem; font-family: var(--nf-font-editorial); font-size: 14px; line-height: 1.8; color: rgb(var(--nf-ink-rgb) / .6); }
.nf-coll__empty-cta { display: inline-flex; align-items: center; justify-content: center; margin-top: 1.75rem; min-height: 48px; padding-inline: 1.75rem;
  border: 1px solid var(--nf-ink); background: none; color: var(--nf-ink); cursor: pointer; text-decoration: none;
  font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: var(--nf-track-28); transition: background-color .2s, color .2s; }
.nf-coll__empty-cta:hover { background-color: var(--nf-ink); color: var(--nf-ivory); }
{% endstylesheet %}

{% schema %}
{
  "name": "NF Collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NAIRA PETITE" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Falls back to the collection title.", "default": "Demi-Fine Jewellery" },
    { "type": "richtext", "id": "lede", "label": "Intro copy", "default": "<p>Brilliant-cut zircone in an 18K gold finish.</p>" },
    { "type": "checkbox", "id": "show_filters", "label": "Show category filters", "default": true }
  ],
  "presets": [{ "name": "NF Collection" }]
}
{% endschema %}
