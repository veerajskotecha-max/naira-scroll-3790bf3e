{%- comment -%}
  Naira Flore — Concept review page (route /concepts)
  Ported from src/pages/Concepts.tsx and the three concept components it stacks:
    src/components/jewellery/concepts/ConceptA.tsx  — THE IVORY ATELIER
    src/components/jewellery/concepts/ConceptB.tsx  — THE EMERALD JEWEL BOX
    src/components/jewellery/concepts/ConceptC.tsx  — GOLDEN HOUR
  plus src/components/jewellery/SpinStage.tsx (the drag-to-spin viewer) and
  src/components/wow/SplitText.tsx (the per-letter headline).

  One section = one labelled divider + one concept, so the review page stacks
  three of them. `variant` picks which concept.

  Two things the React source does by accident and this port keeps on purpose,
  because they are what actually paints:

  1. The headline/piece-name inline style is
        fontFamily: "var(--font-cormorant), 'Velista', Georgia, serif"
     and --font-cormorant is never declared anywhere in the source. The whole
     declaration is therefore invalid and those elements inherit the plain
     ui-sans-serif body stack — NOT the brand serif. nf-base.css forces
     var(--nf-font-display) on h1-h6 with !important, so the sans stack has to
     be re-forced here or the port renders a different typeface.

  2. SpinStage mounts two <img> on the faces of a 3D card; the back face is
     backface-hidden, so exactly one image is ever visible and a plain <img>
     is pixel-identical. The drag interaction needs JS the theme does not
     ship, so the DRAG TO SPIN chip stays (as in React before first drag)
     and the stage is static.

  The 39 piece thumbnails under the stage collapse to 0px of content in React
  (39 flex items in a 380px row), so only their 1-2px borders paint. The
  buttons are reproduced; the invisible <img> inside each one is not.
{%- endcomment -%}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}
{{ 'nf-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign v = section.settings.variant | default: 'a'
  assign model_src = section.settings.model_asset | asset_url
  assign thumb_count = section.settings.thumb_count | default: 39
  assign active = section.settings.active_index | default: 0
-%}

<div class="nf-doc nf-concepts">
  <div class="nf-concepts__divider nf-cx-divider">
    <span class="nf-concepts__badge">{{ section.settings.label | escape }}</span>
    <span class="nf-concepts__note">{{ section.settings.note | escape }}</span>
  </div>
</div>

<section id="jewellery" class="nf-cx nf-cx--{{ v }}">
  {%- case v -%}
    {%- when 'b' -%}<div class="nf-cx__hairline" aria-hidden="true"></div>
    {%- when 'c' -%}<div class="nf-cx__speckle" aria-hidden="true"></div>
    {%- else -%}<div class="nf-cx__wash" aria-hidden="true"></div>
  {%- endcase -%}

  <div class="nf-cx__grid">
    {%- comment -%} ── model ── {%- endcomment -%}
    <div class="nf-cx__model">
      {%- if v == 'c' -%}
        <div class="nf-cx__arch-model">
          <img src="{{ model_src }}" alt="{{ section.settings.model_alt | escape }}">
        </div>
      {%- else -%}
        <img class="nf-cx__model-img" src="{{ model_src }}" alt="{{ section.settings.model_alt | escape }}">
      {%- endif -%}
      <span class="nf-cx__worn">{{ section.settings.worn_label | escape }}</span>
    </div>

    {%- comment -%} ── spin console ── {%- endcomment -%}
    <div class="nf-cx__console">
      <p class="nf-cx__eyebrow">{{ section.settings.eyebrow | escape }}</p>

      <h2 class="nf-cx__h2" aria-label="{{ section.settings.head1 | escape }} {{ section.settings.head2 | escape }}">
        {%- assign l1 = section.settings.head1 | split: '' -%}
        <span class="nf-cx__line" aria-label="{{ section.settings.head1 | escape }}">{% for ch in l1 %}<span class="nf-cx__l" aria-hidden="true">{{ ch }}</span>{% endfor %}</span>
        {%- assign l2 = section.settings.head2 | split: '' -%}
        <div class="nf-cx__line nf-cx__line--em" aria-label="{{ section.settings.head2 | escape }}">{% for ch in l2 %}<span class="nf-cx__l" aria-hidden="true">{{ ch }}</span>{% endfor %}</div>
      </h2>

      <div class="nf-cx__stack">
        {%- if v == 'b' -%}
          <div class="nf-cx__vitrine">
            <span class="nf-cx__vitrine-glow" aria-hidden="true"></span>
            <div class="nf-cx__vitrine-inner">
              <div class="nf-cx__stage" role="img" aria-label="{{ section.settings.piece_name | escape }}">
                <img src="{{ section.settings.piece_image }}" alt="{{ section.settings.piece_name | escape }}" draggable="false">
                <span class="nf-cx__hint"><span aria-hidden="true">&#10226;</span> DRAG TO SPIN</span>
              </div>
            </div>
          </div>
        {%- elsif v == 'c' -%}
          <div class="nf-cx__arch-stage">
            <div class="nf-cx__arch-clip">
              <div class="nf-cx__stage" role="img" aria-label="{{ section.settings.piece_name | escape }}">
                <img src="{{ section.settings.piece_image }}" alt="{{ section.settings.piece_name | escape }}" draggable="false">
                <span class="nf-cx__hint"><span aria-hidden="true">&#10226;</span> DRAG TO SPIN</span>
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="nf-cx__tray">
            <div class="nf-cx__stage" role="img" aria-label="{{ section.settings.piece_name | escape }}">
              <img src="{{ section.settings.piece_image }}" alt="{{ section.settings.piece_name | escape }}" draggable="false">
              <span class="nf-cx__hint"><span aria-hidden="true">&#10226;</span> DRAG TO SPIN</span>
            </div>
          </div>
        {%- endif -%}

        <div class="nf-cx__selector">
          {%- for i in (1..thumb_count) -%}
            {%- assign idx = forloop.index0 -%}
            <button type="button" class="nf-cx__chip{% if idx == active %} is-active{% endif %}" aria-label="{{ section.settings.piece_name | escape }}"></button>
          {%- endfor -%}
        </div>
      </div>

      <h3 class="nf-cx__name">{{ section.settings.piece_name | escape }}</h3>
      <p class="nf-cx__materials">{{ section.settings.piece_materials | escape }}</p>
      <p class="nf-cx__price">{{ section.settings.piece_price | escape }}</p>

      <div class="nf-cx__actions">
        <button type="button" class="nf-cx__enquire">
          <span class="nf-cx__enquire-fill" aria-hidden="true"></span>
          <span class="nf-cx__enquire-label">ENQUIRE TO ORDER</span>
        </button>
        <a class="nf-cx__all" href="{{ section.settings.view_all_link | default: '/collections/jewellery' }}">VIEW ALL &#8594;</a>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
/* nf-content.css gives .nf-concepts__divider flex-wrap: wrap; React's divider
   is a plain non-wrapping flex row, so below 1024px the theme grew a third
   line. Overridden here (0,2,0 beats 0,1,0) rather than editing the shared
   stylesheet. */
.nf-cx-divider.nf-concepts__divider { flex-wrap: nowrap; }

/* Scoped preflight. :where() keeps it at (0,1,0) so the component rules that
   follow — also (0,1,0) — win on source order. */
.nf-cx, .nf-cx *, .nf-cx *::before, .nf-cx *::after { box-sizing: border-box; }
.nf-cx :where(h1, h2, h3, h4, h5, h6, p) { margin: 0; font-size: inherit; font-weight: inherit; letter-spacing: normal; }
.nf-cx :where(img, svg) { display: block; vertical-align: middle; max-width: 100%; height: auto; }
.nf-cx :where(a) { color: inherit; text-decoration: none; }
.nf-cx :where(button) { background: transparent; border: 0; padding: 0; margin: 0; font: inherit; color: inherit; cursor: pointer; }

.nf-cx {
  position: relative;
  overflow: hidden;
  padding-block: 80px;
  display: block;
}
@media (min-width: 1024px) { .nf-cx { padding-block: 112px; } }

.nf-cx--a { background-color: #FBF3EC; color: #1A1614; }
.nf-cx--b { color: #F4E9DD; background: radial-gradient(120% 85% at 50% -10%, #16553F 0%, #0E3B2E 55%, #082820 100%); }
.nf-cx--c { color: #3A2016; background: linear-gradient(180deg, #C4623C 0%, #B85A38 60%, #A94F30 100%); }

.nf-cx__wash {
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: radial-gradient(60% 45% at 80% 0%, rgba(255, 189, 168, 0.16) 0%, transparent 60%);
}
.nf-cx__hairline {
  pointer-events: none;
  position: absolute;
  inset-inline: 0;
  top: 0;
  height: 1px;
  background-image: linear-gradient(to right, transparent, rgba(232, 197, 126, 0.6), transparent);
}
.nf-cx__speckle {
  pointer-events: none;
  position: absolute;
  inset: 0;
  opacity: 0.6;
  background-image: radial-gradient(rgba(58, 32, 22, 0.05) 1px, transparent 1px);
  background-size: 9px 9px;
}

.nf-cx__grid {
  position: relative;
  margin-inline: auto;
  display: grid;
  max-width: 1152px; /* 72rem in React; html here is 62.5% so rem must not be used */
  grid-template-columns: minmax(0, 1fr); /* Tailwind grid-cols-1; the minmax(0,…) is what lets the 39-swatch row shrink */
  align-items: center;
  gap: 40px;
  padding-inline: 24px;
}
@media (min-width: 1024px) {
  .nf-cx__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px; }
}
.nf-cx--c .nf-cx__grid { align-items: end; }

/* ── model ─────────────────────────────────────────────────────── */
.nf-cx__model { position: relative; order: 2; }
@media (min-width: 1024px) { .nf-cx__model { order: 1; } }
.nf-cx--b .nf-cx__model { order: 0; }
@media (min-width: 1024px) { .nf-cx--b .nf-cx__model { order: 2; } }
.nf-cx__model-img { width: 100%; object-fit: cover; }
.nf-cx--a .nf-cx__model-img { box-shadow: 0 30px 60px -30px rgba(122, 90, 40, 0.5); }
.nf-cx--b .nf-cx__model-img {
  box-shadow: 0 36px 70px -30px rgba(0, 0, 0, 0.8);
  outline: 1px solid rgba(232, 197, 126, 0.35);
  outline-offset: 10px;
}
.nf-cx__arch-model {
  overflow: hidden;
  border-radius: 999px 999px 0 0;
  box-shadow: 0 30px 60px -28px rgba(58, 32, 22, 0.65), inset 0 0 0 6px #F3E4CE;
}
.nf-cx__arch-model img { width: 100%; object-fit: cover; }
.nf-cx__worn {
  position: absolute;
  bottom: 16px;
  left: 16px;
  padding: 6px 12px;
  font-family: var(--nf-font-label);
  font-size: 9px;
  line-height: 1.5;
  letter-spacing: 0.3em;
}
.nf-cx--a .nf-cx__worn { background-color: rgba(251, 243, 236, 0.9); color: #9A7634; }
.nf-cx--b .nf-cx__worn { background-color: rgba(8, 40, 32, 0.85); color: #E8C57E; }
.nf-cx--c .nf-cx__worn { left: 50%; transform: translateX(-50%); background-color: rgba(58, 32, 22, 0.85); color: #F3E4CE; }

/* ── console ───────────────────────────────────────────────────── */
.nf-cx__console {
  order: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
@media (min-width: 1024px) { .nf-cx__console { order: 2; } }
.nf-cx--b .nf-cx__console { order: 0; }
@media (min-width: 1024px) { .nf-cx--b .nf-cx__console { order: 1; } }
.nf-cx--c .nf-cx__console { padding-bottom: 16px; }

.nf-cx__eyebrow {
  margin-bottom: 16px;
  font-family: var(--nf-font-label);
  font-size: 11px;
  line-height: 1.5;
  letter-spacing: 0.5em;
}
.nf-cx--a .nf-cx__eyebrow { color: #B0843A; }
.nf-cx--b .nf-cx__eyebrow { color: #E8C57E; }
.nf-cx--c .nf-cx__eyebrow { color: #F3E4CE; }

/* The headline inherits the plain body stack in React — see the note at the
   top of this file. !important is required to beat nf-base.css's h1-h6 rule. */
.nf-cx__h2 {
  font-family: ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji",
               "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji" !important;
  font-size: clamp(35.2px, 5.5vw, 60.8px);
  font-weight: 400;
  line-height: 1;
  letter-spacing: normal;
}
.nf-cx--c .nf-cx__h2 { color: #FBF3EC; }
.nf-cx__line { display: inline-block; }
.nf-cx__line--em { font-family: var(--nf-font-editorial); font-style: italic; }
.nf-cx--a .nf-cx__line--em { color: #B0843A; }
.nf-cx--b .nf-cx__line--em { color: #E8C57E; }
.nf-cx--c .nf-cx__line--em { color: #F8D9A8; }
.nf-cx__l { display: inline-block; white-space: pre; }

.nf-cx__stack { margin-top: 32px; width: 100%; max-width: 380px; }
.nf-cx--c .nf-cx__stack { max-width: 360px; }

.nf-cx__tray { background-color: #F4EBE2; padding: 12px; box-shadow: 0 24px 50px -30px rgba(122, 90, 40, 0.55); }
.nf-cx__vitrine {
  position: relative;
  padding: 12px;
  background: linear-gradient(180deg, #0C3325, #0A2A20);
  box-shadow: inset 0 2px 24px rgba(0, 0, 0, 0.6), inset 0 0 0 1px rgba(232, 197, 126, 0.4);
}
.nf-cx__vitrine-glow {
  pointer-events: none;
  position: absolute;
  inset: 0;
  background: radial-gradient(75% 55% at 50% 0%, rgba(232, 197, 126, 0.3), transparent 70%);
}
.nf-cx__vitrine-inner { position: relative; background-color: #F4EBE2; }
.nf-cx__arch-stage {
  overflow: hidden;
  padding: 12px 12px 0;
  border-radius: 999px 999px 0 0;
  background: linear-gradient(180deg, #F3E4CE, #EDDABF);
  box-shadow: inset 0 3px 16px rgba(58, 32, 22, 0.3), 0 24px 46px -22px rgba(58, 32, 22, 0.6);
}
.nf-cx__arch-clip { overflow: hidden; border-radius: 999px 999px 0 0; }

.nf-cx__stage {
  position: relative;
  user-select: none;
  aspect-ratio: 1 / 1;
  width: 100%;
  overflow: hidden;
  perspective: 1100px;
  touch-action: pan-y;
  cursor: grab;
}
.nf-cx--c .nf-cx__stage { aspect-ratio: 4 / 5; }
.nf-cx__stage > img { width: 100%; height: 100%; object-fit: cover; }
.nf-cx__hint {
  pointer-events: none;
  position: absolute;
  bottom: 12px;
  left: 50%;
  z-index: 10;
  display: flex;
  transform: translateX(-50%);
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  font-family: var(--nf-font-label);
  font-size: 10px;
  line-height: 1.5;
  letter-spacing: 0.28em;
  white-space: nowrap;
}
.nf-cx--a .nf-cx__hint { background: rgba(251, 243, 236, 0.9); color: #1A1614; }
.nf-cx--b .nf-cx__hint { background: rgba(14, 59, 46, 0.85); color: #E8C57E; }
.nf-cx--c .nf-cx__hint { background: rgba(58, 32, 22, 0.8); color: #F3E4CE; }

.nf-cx__selector { margin-top: 16px; display: flex; justify-content: center; gap: 10px; }
.nf-cx--b .nf-cx__selector { margin-top: 20px; gap: 12px; }
.nf-cx__chip { overflow: hidden; transition: all 0.3s; }
.nf-cx--a .nf-cx__chip { height: 56px; width: 56px; border: 1px solid transparent; opacity: 0.55; }
.nf-cx--a .nf-cx__chip.is-active { border-color: #B0843A; opacity: 1; }
.nf-cx--b .nf-cx__chip { height: 48px; width: 48px; border-radius: 9999px; border: 2px solid rgba(232, 197, 126, 0.25); opacity: 0.6; }
.nf-cx--b .nf-cx__chip.is-active { border-color: #E8C57E; opacity: 1; box-shadow: 0 0 18px rgba(232, 197, 126, 0.5); }
.nf-cx--c .nf-cx__chip { height: 48px; width: 40px; border: 2px solid rgba(243, 228, 206, 0.3); border-radius: 999px 999px 0 0; opacity: 0.6; }
.nf-cx--c .nf-cx__chip.is-active { border-color: #F3E4CE; opacity: 1; }

.nf-cx__name {
  margin-top: 24px;
  font-family: ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji",
               "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji" !important;
  font-size: 26px;
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: normal;
}
.nf-cx--c .nf-cx__name { margin-top: 20px; }
.nf-cx--b .nf-cx__name { color: #F4E9DD; }
.nf-cx--c .nf-cx__name { color: #FBF3EC; }

.nf-cx__materials {
  margin-top: 4px;
  font-family: var(--nf-font-editorial);
  font-size: 13px;
  font-style: italic;
  line-height: 1.5;
}
.nf-cx--a .nf-cx__materials { color: rgba(26, 22, 20, 0.55); }
.nf-cx--b .nf-cx__materials { color: rgba(244, 233, 221, 0.55); }
.nf-cx--c .nf-cx__materials { color: rgba(251, 243, 236, 0.7); }

.nf-cx__price {
  margin-top: 8px;
  font-family: var(--nf-font-label);
  font-size: 15px;
  line-height: 1.5;
  letter-spacing: 0.025em;
}
.nf-cx--b .nf-cx__price { color: #E8C57E; }
.nf-cx--c .nf-cx__price { color: #F8D9A8; }

.nf-cx__actions { margin-top: 24px; display: flex; align-items: center; gap: 16px; }
.nf-cx__enquire {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  overflow: hidden;
  padding: 14px 32px;
  font-family: var(--nf-font-label);
  font-size: 11px;
  line-height: 1.5;
  letter-spacing: 0.3em;
  transition: color 0.5s;
}
.nf-cx--a .nf-cx__enquire { border: 1px solid #1A1614; color: #1A1614; }
.nf-cx--b .nf-cx__enquire { border: 1px solid rgba(232, 197, 126, 0.7); color: #E8C57E; }
.nf-cx--c .nf-cx__enquire { border: 1px solid rgba(243, 228, 206, 0.8); color: #F3E4CE; }
.nf-cx__enquire-fill {
  position: absolute;
  inset: 0;
  transform-origin: left;
  transform: scaleX(0);
  transition: transform 0.5s cubic-bezier(0, 0, 0.2, 1);
}
.nf-cx--a .nf-cx__enquire-fill { background-color: #1A1614; }
.nf-cx--b .nf-cx__enquire-fill { background-color: #E8C57E; }
.nf-cx--c .nf-cx__enquire-fill { background-color: #F3E4CE; }
.nf-cx__enquire:hover .nf-cx__enquire-fill { transform: scaleX(1); }
.nf-cx--a .nf-cx__enquire:hover { color: #FBF3EC; }
.nf-cx--b .nf-cx__enquire:hover { color: #0E3B2E; }
.nf-cx--c .nf-cx__enquire:hover { color: #A94F30; }
.nf-cx__enquire-label { position: relative; }

.nf-cx__all {
  padding-bottom: 2px;
  font-family: var(--nf-font-label);
  font-size: 11px;
  line-height: 1.5;
  letter-spacing: 0.25em;
}
.nf-cx--a .nf-cx__all { border-bottom: 1px solid #B0843A; color: #9A7634; }
.nf-cx--b .nf-cx__all { border-bottom: 1px solid rgba(232, 197, 126, 0.7); color: #E8C57E; }
.nf-cx--c .nf-cx__all { border-bottom: 1px solid #F3E4CE; color: #F3E4CE; }
{% endstylesheet %}

{% schema %}
{
  "name": "Naira concept",
  "tag": "section",
  "class": "nf-concepts-section",
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Concept",
      "options": [
        { "value": "a", "label": "A — Ivory atelier" },
        { "value": "b", "label": "B — Emerald jewel box" },
        { "value": "c", "label": "C — Golden hour" }
      ],
      "default": "a"
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Concept label",
      "default": "CONCEPT A"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "THE IVORY ATELIER · BRAND-LIGHT · DRAG TO SPIN"
    },
    {
      "type": "header",
      "content": "Campaign model"
    },
    {
      "type": "text",
      "id": "model_asset",
      "label": "Model theme asset",
      "default": "nf-model-ivory.webp"
    },
    {
      "type": "text",
      "id": "model_alt",
      "label": "Model alt text",
      "default": "Chandbali Florale worn, Naira Flore demi-gold campaign"
    },
    {
      "type": "text",
      "id": "worn_label",
      "label": "Worn badge",
      "default": "WORN · CHANDBALI FLORALE"
    },
    {
      "type": "header",
      "content": "Headline"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "NAIRA FLORE · DEMI-GOLD"
    },
    {
      "type": "text",
      "id": "head1",
      "label": "Headline line 1",
      "default": "Turn it"
    },
    {
      "type": "text",
      "id": "head2",
      "label": "Headline line 2 (italic)",
      "default": "in your hand."
    },
    {
      "type": "header",
      "content": "Selected piece"
    },
    {
      "type": "text",
      "id": "piece_name",
      "label": "Name",
      "default": "Rivière Eternal Necklace"
    },
    {
      "type": "text",
      "id": "piece_materials",
      "label": "Materials",
      "default": "18K gold tone plated · brilliant-cut zircone · surgical stainless steel · waterproof, anti-tarnish"
    },
    {
      "type": "text",
      "id": "piece_price",
      "label": "Price label",
      "default": "₹1,799"
    },
    {
      "type": "text",
      "id": "piece_image",
      "label": "Packshot URL"
    },
    {
      "type": "range",
      "id": "thumb_count",
      "label": "Selector swatches",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 39
    },
    {
      "type": "range",
      "id": "active_index",
      "label": "Selected swatch",
      "min": 0,
      "max": 59,
      "step": 1,
      "default": 0
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    }
  ],
  "presets": [{ "name": "Naira concept" }]
}
{% endschema %}
