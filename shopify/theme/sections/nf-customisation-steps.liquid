{% comment %}
  nf-customisation-steps — port of src/components/CustomisationSteps.tsx
  Five step cards with a spotlight that starts 0.9s after the section is
  seen and advances every 1.8s, looping; hovering a card takes the
  spotlight. The desktop connector line fills to the active card.
  Lucide icon paths inlined as SVG.
{% endcomment %}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}
{{ 'nf-home.css' | asset_url | stylesheet_tag }}

<section class="nf nf-steps" id="NfSteps-{{ section.id }}" data-nf-reveal>
  <div class="nf-wrap">
    <div class="nf-steps__head nf-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-steps__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="nf-steps__title nf-display">{{ section.settings.heading }}</h2>
    </div>

    <div class="nf-steps__connector" aria-hidden="true">
      <i></i><b data-nf-steps-fill></b>
    </div>

    <div class="nf-steps__grid" data-nf-steps-grid>
      {%- for block in section.blocks -%}
        {%- assign delay = forloop.index0 | times: 12 | plus: 15 -%}
        <div class="nf-step nf-reveal" data-nf-step="{{ forloop.index0 }}"
             style="transition-delay: 0.{{ delay }}s;" {{ block.shopify_attributes }}>
          {%- if block.settings.step != blank -%}
            <span class="nf-step__num">{{ block.settings.step }}</span>
          {%- endif -%}
          <div class="nf-step__icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              {%- case block.settings.icon -%}
                {%- when 'message-square' -%}
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                {%- when 'palette' -%}
                  <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"/>
                {%- when 'sliders-horizontal' -%}
                  <line x1="21" x2="14" y1="4" y2="4"/><line x1="10" x2="3" y1="4" y2="4"/><line x1="21" x2="12" y1="12" y2="12"/><line x1="8" x2="3" y1="12" y2="12"/><line x1="21" x2="16" y1="20" y2="20"/><line x1="12" x2="3" y1="20" y2="20"/><line x1="14" x2="14" y1="2" y2="6"/><line x1="8" x2="8" y1="10" y2="14"/><line x1="16" x2="16" y1="18" y2="22"/>
                {%- when 'phone' -%}
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                {%- when 'package' -%}
                  <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/><path d="M12 22V12"/><path d="m3.3 7 7.703 4.734a2 2 0 0 0 1.994 0L20.7 7"/><path d="m7.5 4.27 9 5.15"/>
                {%- else -%}
                  <circle cx="12" cy="12" r="9"/>
              {%- endcase -%}
            </svg>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="nf-steps__cta-wrap nf-reveal">
        <a class="nf-steps__cta" href="{{ section.settings.cta_link | default: '/pages/made-for-you' }}">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    function scan() {
      var nodes = document.querySelectorAll('[data-nf-reveal]:not(.nf-in)');
      if (!('IntersectionObserver' in window)) {
        for (var i = 0; i < nodes.length; i++) nodes[i].classList.add('nf-in');
        return;
      }
      var io = new IntersectionObserver(function (entries, obs) {
        for (var k = 0; k < entries.length; k++) {
          if (entries[k].isIntersecting) { entries[k].target.classList.add('nf-in'); obs.unobserve(entries[k].target); }
        }
      }, { threshold: 0.03 });
      for (var j = 0; j < nodes.length; j++) io.observe(nodes[j]);
    }
    if (!window.__nfRevealBound) {
      window.__nfRevealBound = true;
      document.addEventListener('shopify:section:load', scan);
      window.addEventListener('load', scan);
    }
    scan();

    function initSteps(root) {
      if (!root || root.dataset.nfStepsInit === '1') return;
      root.dataset.nfStepsInit = '1';
      var cards = root.querySelectorAll('[data-nf-step]');
      var fill = root.querySelector('[data-nf-steps-fill]');
      if (!cards.length) return;
      var active = -1, timer = null, started = false;

      function paint() {
        for (var i = 0; i < cards.length; i++) cards[i].classList.toggle('is-active', i === active);
        if (fill) fill.style.width = active < 0 || cards.length < 2 ? '0%' : (active / (cards.length - 1)) * 80 + '%';
      }
      function advance() {
        active = (active + 1) % cards.length;
        paint();
        timer = setTimeout(advance, 1800);
      }
      function setActive(i) {
        clearTimeout(timer);
        active = i;
        paint();
        timer = setTimeout(advance, 1800);
      }
      for (var c = 0; c < cards.length; c++) {
        (function (idx) {
          cards[idx].addEventListener('mouseenter', function () { setActive(idx); });
          cards[idx].addEventListener('focusin', function () { setActive(idx); });
        })(c);
      }
      function start() {
        if (started) return;
        started = true;
        setTimeout(function () { active = 0; paint(); timer = setTimeout(advance, 1800); }, 900);
      }
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries, obs) {
          for (var k = 0; k < entries.length; k++) {
            if (entries[k].isIntersecting) { start(); obs.disconnect(); }
          }
        }, { threshold: 0.03 });
        io.observe(root);
      } else { start(); }
    }

    initSteps(document.getElementById('NfSteps-{{ section.id }}'));
    document.addEventListener('shopify:section:load', function (e) {
      if (e.target && e.target.querySelector) initSteps(e.target.querySelector('.nf-steps'));
    });
  })();
</script>

{% schema %}
{
  "name": "NF Customisation steps",
  "tag": "section",
  "class": "nf-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "STEPS TO EASY CUSTOMISATION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customise Your Dress" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "BEGIN MY MADE TO MEASURE" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "message-square", "label": "Message" },
            { "value": "palette", "label": "Palette" },
            { "value": "sliders-horizontal", "label": "Sliders" },
            { "value": "phone", "label": "Phone" },
            { "value": "package", "label": "Package" }
          ],
          "default": "message-square"
        },
        { "type": "text", "id": "step", "label": "Step number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Share Your Vision" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Share your dream look with us on WhatsApp." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "NF Customisation steps",
      "blocks": [
        { "type": "step", "settings": { "icon": "message-square", "step": "01", "title": "Share Your Vision", "description": "Share your dream look with us on WhatsApp." } },
        { "type": "step", "settings": { "icon": "palette", "step": "02", "title": "Curated Design Options", "description": "Receive curated design, colour, and fabric options, handpicked for you." } },
        { "type": "step", "settings": { "icon": "sliders-horizontal", "step": "03", "title": "Finalise Your Style", "description": "Choose your fabric and silhouette, then share your measurements." } },
        { "type": "step", "settings": { "icon": "phone", "step": "04", "title": "Personal Consultation", "description": "A personal consultation call to refine every last detail." } },
        { "type": "step", "settings": { "icon": "package", "step": "05", "title": "Delivered to You", "description": "Your customised outfit, delivered to your doorstep." } }
      ]
    }
  ]
}
{% endschema %}