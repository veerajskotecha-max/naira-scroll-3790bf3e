{%- comment -%}
  Naira Flore — site footer (the sage block).
  Ported from src/components/Footer.tsx in the Lovable repo.

  Colours come from the --nf-footer-* component tokens in
  assets/nf-tokens.css; nothing here hard-codes the sage or the cream.
  The source's three hard-coded link arrays become `link_list` blocks so
  every href is a real Shopify menu entry, and the newsletter posts to
  Shopify's own customer form instead of opening WhatsApp.
{%- endcomment -%}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign column_count = section.blocks.size
  assign search_terms = section.settings.popular_searches | split: ','
-%}

<div class="nf-footer" style="--nf-footer-cols: 1.4fr{% for i in (1..column_count) %} 1fr{% endfor %} 1.2fr;">
  <div class="nf-footer__inner">
    <div class="nf-footer__grid">
      {%- comment -%} Brand column {%- endcomment -%}
      <div class="nf-footer__brand">
        <a href="{{ routes.root_url }}" class="nf-footer__logo" aria-label="{{ shop.name | escape }} — home">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 520
              | image_tag:
                class: 'nf-footer__logo-img nf-footer__logo-img--tinted',
                loading: 'lazy',
                alt: shop.name,
                widths: '200, 300, 400, 520'
            }}
          {%- else -%}
            <img
              src="{{ 'nf-wordmark-cream.png' | asset_url }}"
              alt="{{ shop.name | escape }}"
              class="nf-footer__logo-img"
              width="520"
              height="116"
              loading="lazy"
            >
          {%- endif -%}
        </a>

        {%- if section.settings.brand_text != blank -%}
          <div class="nf-footer__blurb">{{ section.settings.brand_text }}</div>
        {%- endif -%}

        <div class="nf-footer__social">
          {%- if section.settings.instagram_url != blank -%}
            <a
              href="{{ section.settings.instagram_url }}"
              class="nf-footer__chip"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
            >
              {%- render 'nf-icon-instagram', size: 16 -%}
            </a>
          {%- endif -%}
          {%- if section.settings.whatsapp_url != blank -%}
            <a
              href="{{ section.settings.whatsapp_url }}"
              class="nf-footer__chip"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
            >
              {%- render 'nf-icon-whatsapp', size: 16 -%}
            </a>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <a href="mailto:{{ section.settings.email }}" class="nf-footer__chip" aria-label="Email">
              {%- render 'nf-icon-mail', size: 16 -%}
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Link columns, one per block {%- endcomment -%}
      {%- for block in section.blocks -%}
        <div class="nf-footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}
            <h2 class="nf-footer__col-title">{{ block.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- assign block_menu = linklists[block.settings.menu] -%}
          {%- if block_menu.links != blank -%}
            <ul class="nf-footer__list" role="list">
              {%- for link in block_menu.links -%}
                <li>
                  <a href="{{ link.url }}" class="nf-footer__link">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- elsif block.settings.fallback_links != blank -%}
            {%- comment -%}
              No menu selected (or none exists on this store yet): fall
              back to the links hard-coded in the Lovable source
              (src/components/Footer.tsx) so the column never renders
              empty. Pick a real menu above to override this.
            {%- endcomment -%}
            <div class="nf-footer__fallback">{{ block.settings.fallback_links }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- comment -%} Newsletter column — real Shopify customer form {%- endcomment -%}
      <div class="nf-footer__col nf-footer__newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="nf-footer__col-title">{{ section.settings.newsletter_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.newsletter_text != blank -%}
          <div class="nf-footer__blurb">{{ section.settings.newsletter_text }}</div>
        {%- endif -%}

        {%- form 'customer', id: 'NfNewsletter', class: 'nf-footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="nf-visually-hidden" for="NfNewsletterEmail-{{ section.id }}">
            {{- section.settings.newsletter_placeholder | escape -}}
          </label>
          <input
            id="NfNewsletterEmail-{{ section.id }}"
            class="nf-footer__input"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ section.settings.newsletter_placeholder | escape }}"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            aria-required="true"
            required
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="NfNewsletterError-{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="NfNewsletterSuccess-{{ section.id }}"
            {% endif %}
          >
          {%- if form.errors -%}
            <p class="nf-footer__form-note" id="NfNewsletterError-{{ section.id }}">
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="nf-footer__form-note" id="NfNewsletterSuccess-{{ section.id }}" tabindex="-1">
              {{- 'newsletter.success' | t -}}
            </p>
          {%- endif -%}
          <button type="submit" name="commit" class="nf-footer__submit">
            {{- section.settings.newsletter_button | escape -}}
          </button>
        {%- endform -%}
      </div>
    </div>

    {%- comment -%} Popular searches — SEO row, points at Shopify search {%- endcomment -%}
    {%- if search_terms != blank -%}
      <div class="nf-footer__searches">
        {%- if section.settings.popular_searches_label != blank -%}
          <p class="nf-footer__searches-label">{{ section.settings.popular_searches_label | escape }}</p>
        {%- endif -%}
        <p class="nf-footer__searches-list">
          {%- for term in search_terms -%}
            {%- assign clean_term = term | strip -%}
            {%- if clean_term == blank -%}{%- continue -%}{%- endif -%}
            <span>
              <a
                href="{{ routes.search_url }}?q={{ clean_term | url_encode }}"
                class="nf-footer__search-link"
              >
                {{- clean_term | escape -}}
              </a>
              {%- unless forloop.last -%}<span class="nf-footer__sep" aria-hidden="true">·</span>{%- endunless -%}
            </span>
          {%- endfor -%}
        </p>
      </div>
    {%- endif -%}

    <div class="nf-footer__bottom">
      <p class="nf-footer__copy">{{ section.settings.copyright | escape }}</p>
    </div>
  </div>
</div>

{% stylesheet %}
/* ── Sage block ───────────────────────────────────────────────────
   Every colour below resolves through the --nf-footer-* component
   tokens in assets/nf-tokens.css. Do not substitute literals. */
.nf-footer {
  width: 100%;
  padding-top: 60px;
  padding-bottom: 24px;
  background-color: var(--nf-footer-surface);
}
@media (min-width: 768px)  { .nf-footer { padding-top: 70px; } }
@media (min-width: 1024px) { .nf-footer { padding-top: 80px; } }

.nf-footer__inner {
  max-width: 1280px;
  margin-inline: auto;
  padding-inline: 24px;
}
@media (min-width: 768px)  { .nf-footer__inner { padding-inline: 40px; } }
@media (min-width: 1024px) { .nf-footer__inner { padding-inline: 48px; } }

.nf-footer__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 32px;
  padding-bottom: 48px;
}
@media (min-width: 640px) {
  .nf-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .nf-footer__brand { grid-column: span 2; }
}
@media (min-width: 768px) {
  .nf-footer__grid { padding-bottom: 64px; }
}
@media (min-width: 1024px) {
  .nf-footer__grid {
    grid-template-columns: var(--nf-footer-cols, 1.4fr 1fr 1fr 1fr 1.2fr);
    gap: 48px;
  }
  .nf-footer__brand { grid-column: span 1; }
}

/* ── Brand column ─────────────────────────────────────────────── */
.nf-footer__logo { display: inline-block; }
.nf-footer__logo-img {
  display: block;
  width: 100px;
  height: auto;
  max-width: 100%;
  margin-bottom: 16px;
}
/* A merchant-uploaded wordmark is knocked back to cream, matching the
   `brightness-0 invert` the source applies to its footer logo. */
.nf-footer__logo-img--tinted { filter: brightness(0) invert(1); }
@media (min-width: 768px)  { .nf-footer__logo-img { width: 120px; } }
@media (min-width: 1024px) { .nf-footer__logo-img { width: 150px; } }

.nf-footer__blurb {
  margin: 0 0 24px;
  max-width: 280px;
  font-family: var(--nf-font-display);
  font-size: 14px;
  line-height: 1.625;
  color: var(--nf-footer-text-muted);
}
.nf-footer__blurb > p { margin: 0; }
.nf-footer__newsletter .nf-footer__blurb { max-width: none; margin-bottom: 20px; }

.nf-footer__social { display: flex; gap: 12px; }
.nf-footer__chip {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--nf-footer-text);
  background-color: var(--nf-footer-chip-bg);
  transition: background-color 200ms ease;
}
.nf-footer__chip:hover { background-color: var(--nf-footer-chip-bg-hover); }

/* ── Link columns ─────────────────────────────────────────────── */
/* The layout stamps `font-family: Ophelia !important` on every h1-h6,
   so the override here has to match that weight to keep the brand
   serif. Specificity, not order, is what wins. */
.nf-footer .nf-footer__col-title {
  margin: 0 0 20px;
  font-family: var(--nf-font-display) !important;
  font-size: 16px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--nf-track-10);
  color: var(--nf-footer-text);
}
.nf-footer__list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.nf-footer__link {
  font-family: var(--nf-font-display);
  font-size: 14px;
  text-decoration: none;
  color: var(--nf-footer-text-muted);
  transition: color 200ms ease;
}
.nf-footer__link:hover { color: var(--nf-footer-text); }

/* ── Link column fallback (no Shopify menu picked yet) ──────────
   Renders the richtext `fallback_links` block setting — a plain
   <ul><li><a> list — with the same look as .nf-footer__list/__link
   above, since block.settings.menu has no default menu to resolve. */
.nf-footer__fallback ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.nf-footer__fallback li { margin: 0; padding: 0; }
.nf-footer__fallback a {
  font-family: var(--nf-font-display);
  font-size: 14px;
  text-decoration: none;
  color: var(--nf-footer-text-muted);
  transition: color 200ms ease;
}
.nf-footer__fallback a:hover { color: var(--nf-footer-text); }

/* ── Newsletter ───────────────────────────────────────────────── */
.nf-footer__form { display: flex; flex-direction: column; gap: 12px; }
.nf-footer__input {
  width: 100%;
  padding: 10px 16px;
  border: 1.5px solid var(--nf-footer-text);
  border-radius: 0;
  background-color: var(--nf-footer-input-bg);
  color: var(--nf-footer-text);
  font-family: var(--nf-font-display);
  font-size: 13px;
  outline: none;
  transition: background-color 200ms ease;
}
.nf-footer__input::placeholder { color: var(--nf-footer-text-muted); }
.nf-footer__input:focus { background-color: var(--nf-footer-input-bg-focus); }
.nf-footer__submit {
  width: 100%;
  padding: 10px 16px;
  border: 0;
  border-radius: 0;
  background-color: var(--nf-footer-cta);
  color: var(--nf-footer-text);
  font-family: var(--nf-font-display);
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: var(--nf-track-8);
  cursor: pointer;
  transition: opacity 200ms ease;
}
.nf-footer__submit:hover { opacity: 0.9; }
.nf-footer__form-note {
  margin: 0;
  font-family: var(--nf-font-display);
  font-size: 13px;
  color: var(--nf-footer-text);
}

/* ── Popular searches ─────────────────────────────────────────── */
.nf-footer__searches {
  margin-top: 48px;
  padding-top: 24px;
  border-top: 1px solid var(--nf-footer-hairline);
}
.nf-footer__searches-label {
  margin: 0 0 12px;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: var(--nf-track-16);
  color: var(--nf-footer-text-faint);
}
.nf-footer__searches-list {
  margin: 0;
  font-size: 12px;
  line-height: 1.9;
  color: var(--nf-footer-text-faint);
}
.nf-footer__search-link {
  text-decoration: none;
  color: var(--nf-footer-text-faint);
  transition: color 200ms ease;
}
.nf-footer__search-link:hover { color: var(--nf-footer-text); }
.nf-footer__sep { margin-inline: 8px; opacity: 0.4; }

/* ── Bottom bar ───────────────────────────────────────────────── */
.nf-footer__bottom {
  margin-top: 32px;
  padding-top: 24px;
  text-align: center;
  border-top: 1px solid var(--nf-footer-hairline-strong);
}
.nf-footer__copy {
  margin: 0;
  font-family: var(--nf-font-display);
  font-size: 13px;
  color: var(--nf-footer-text-faint);
}

.nf-visually-hidden {
  position: absolute !important;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

@media (prefers-reduced-motion: reduce) {
  .nf-footer__chip,
  .nf-footer__link,
  .nf-footer__input,
  .nf-footer__submit,
  .nf-footer__search-link { transition: none; }
}
{% endstylesheet %}

