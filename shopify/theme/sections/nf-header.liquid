{%- comment -%}
  Naira Flore — site header.
  Ported from src/components/Navbar.tsx (+ the height ladder in
  src/components/Header.tsx) in the Lovable repo. React Router links
  become Shopify linklist links; the cart badge reads real cart state.

  The announcement strip above the bar is a separate section
  (sections/nf-announcement-bar.liquid) so it stays independently
  editable in the header group.
{%- endcomment -%}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nf-header.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Cormorant Garamond + Jost, loaded exactly as index.html does in the
  Lovable repo. Velista (the brand display serif) is served from the
  theme's own assets. Together these back var(--nf-font-display).
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
>

{%- style -%}
  @font-face {
    font-family: 'Velista';
    src: url({{ 'nf-velista.woff2' | asset_url }}) format('woff2');
    font-weight: 400 600;
    font-style: normal;
    font-display: swap;
  }
{%- endstyle -%}

{%- liquid
  assign menu = linklists[section.settings.menu]
  assign menu_right = linklists[section.settings.menu_right]
  assign cart_count = cart.item_count

  comment
    Bug 2 fix: the live main-menu already carries its own CONTACT
    item, and menu_right has no default so it's blank on a fresh
    install. Without this guard the elsif below would ALWAYS also
    render a second "CONTACT" link, and since contact_url has no
    default it would point at routes.root_url ("/") — a second, broken
    link. Suppress the fallback whenever the left menu already has a
    same-titled item, or whenever contact_url is genuinely empty.
  endcomment
  comment
    main-menu is shared with the published theme, so it cannot be reshaped for
    this port. The live navbar (src/components/Navbar.tsx) reads
    HOME / SHOP / GIFTING / ABOUT / CUSTOMISE. These settings reproduce it inside
    the section; clear nav_labels to fall back to the Shopify linklist.
  endcomment
  assign nav_labels = section.settings.nav_labels | split: ','
  assign nav_urls = section.settings.nav_urls | split: ','
  assign use_manual_nav = false
  if nav_labels.size > 0 and nav_labels.size == nav_urls.size
    assign use_manual_nav = true
  endif

  assign contact_label_lower = section.settings.contact_label | strip | downcase
  assign menu_has_contact_link = false
  for link in menu.links
    assign nf_link_title_lower = link.title | strip | downcase
    if contact_label_lower != blank and nf_link_title_lower == contact_label_lower
      assign menu_has_contact_link = true
    endif
  endfor
  assign show_contact_fallback = false
  if menu_right.links == blank and section.settings.contact_label != blank and section.settings.contact_url != blank and menu_has_contact_link == false
    assign show_contact_fallback = true
  endif

  comment
    Bug 3 fix: the live main-menu is flat (no child items), so SHOP ALL
    never gets a hover dropdown even though the Lovable source shows
    Jewellery / Indo-Western under it. Rather than create a Shopify
    menu (out of scope — menus are shared with the live theme), a
    manual dropdown can be configured per top-level title below and is
    used only when that menu item has no real children of its own.
  endcomment
  assign dropdown_parent_lower = section.settings.dropdown_parent | strip | downcase
-%}

<div
  class="nf-header{% if section.settings.sticky %} nf-header--sticky{% endif %}"
  data-nf-header
  style="--nf-header-bg: {{ section.settings.bg_colour }}; --nf-header-accent: {{ section.settings.accent_colour }};"
>
  <nav class="nf-header__bar" aria-label="Primary">
    <div class="nf-header__inner">
      {%- comment -%} Left: hamburger on mobile, links from lg up {%- endcomment -%}
      <div class="nf-header__left">
        <button
          type="button"
          class="nf-header__burger"
          data-nf-menu-open
          aria-label="Open menu"
          aria-expanded="false"
        >
          {%- render 'nf-icon-menu', size: 22 -%}
        </button>

        <div class="nf-header__links">
          {%- if use_manual_nav -%}
            {%- for lbl in nav_labels -%}
              {%- assign nav_label = lbl | strip -%}
              {%- assign nav_url = nav_urls[forloop.index0] | strip -%}
              {%- assign nav_label_lower = nav_label | downcase -%}
              {%- if dropdown_parent_lower != blank and nav_label_lower == dropdown_parent_lower -%}
                <div class="nf-header__item">
                  <a href="{{ nav_url }}" class="nf-header__link">{{ nav_label | escape }}</a>
                  <div class="nf-header__dropdown">
                    <div class="nf-header__dropdown-inner">
                      {%- if section.settings.dropdown_link_1_label != blank and section.settings.dropdown_link_1_url != blank -%}<a href="{{ section.settings.dropdown_link_1_url }}" class="nf-header__dropdown-link">{{ section.settings.dropdown_link_1_label | escape }}</a>{%- endif -%}
                      {%- if section.settings.dropdown_link_2_label != blank and section.settings.dropdown_link_2_url != blank -%}<a href="{{ section.settings.dropdown_link_2_url }}" class="nf-header__dropdown-link">{{ section.settings.dropdown_link_2_label | escape }}</a>{%- endif -%}
                      {%- if section.settings.dropdown_link_3_label != blank and section.settings.dropdown_link_3_url != blank -%}<a href="{{ section.settings.dropdown_link_3_url }}" class="nf-header__dropdown-link">{{ section.settings.dropdown_link_3_label | escape }}</a>{%- endif -%}
                      {%- if section.settings.dropdown_link_4_label != blank and section.settings.dropdown_link_4_url != blank -%}<a href="{{ section.settings.dropdown_link_4_url }}" class="nf-header__dropdown-link">{{ section.settings.dropdown_link_4_label | escape }}</a>{%- endif -%}
                    </div>
                  </div>
                </div>
              {%- else -%}
                <a href="{{ nav_url }}" class="nf-header__link">{{ nav_label | escape }}</a>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
          {%- for link in menu.links -%}
            {%- assign nf_link_title_lower = link.title | strip | downcase -%}
            {%- assign nf_use_manual_dropdown = false -%}
            {%- if link.links == blank and dropdown_parent_lower != blank and nf_link_title_lower == dropdown_parent_lower -%}
              {%- assign nf_use_manual_dropdown = true -%}
            {%- endif -%}
            {%- if link.links != blank -%}
              <div class="nf-header__item">
                <a
                  href="{{ link.url }}"
                  class="nf-header__link{% if link.active %} is-active{% endif %}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{- link.title | escape -}}
                </a>
                <div class="nf-header__dropdown">
                  <div class="nf-header__dropdown-inner">
                    {%- for child in link.links -%}
                      <a
                        href="{{ child.url }}"
                        class="nf-header__dropdown-link"
                        {% if child.current %}aria-current="page"{% endif %}
                      >
                        {{- child.title | escape -}}
                      </a>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            {%- elsif nf_use_manual_dropdown -%}
              <div class="nf-header__item">
                <a
                  href="{{ link.url }}"
                  class="nf-header__link{% if link.active %} is-active{% endif %}"
                  {% if link.current %}aria-current="page"{% endif %}
                >
                  {{- link.title | escape -}}
                </a>
                <div class="nf-header__dropdown">
                  <div class="nf-header__dropdown-inner">
                    {%- if section.settings.dropdown_link_1_label != blank and section.settings.dropdown_link_1_url != blank -%}
                      <a href="{{ section.settings.dropdown_link_1_url }}" class="nf-header__dropdown-link">
                        {{- section.settings.dropdown_link_1_label | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if section.settings.dropdown_link_2_label != blank and section.settings.dropdown_link_2_url != blank -%}
                      <a href="{{ section.settings.dropdown_link_2_url }}" class="nf-header__dropdown-link">
                        {{- section.settings.dropdown_link_2_label | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if section.settings.dropdown_link_3_label != blank and section.settings.dropdown_link_3_url != blank -%}
                      <a href="{{ section.settings.dropdown_link_3_url }}" class="nf-header__dropdown-link">
                        {{- section.settings.dropdown_link_3_label | escape -}}
                      </a>
                    {%- endif -%}
                    {%- if section.settings.dropdown_link_4_label != blank and section.settings.dropdown_link_4_url != blank -%}
                      <a href="{{ section.settings.dropdown_link_4_url }}" class="nf-header__dropdown-link">
                        {{- section.settings.dropdown_link_4_label | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="nf-header__link{% if link.active %} is-active{% endif %}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{- link.title | escape -}}
              </a>
            {%- endif -%}
          {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Centre: NAIRA wordmark, the "I" is a floral glyph {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="nf-header__logo" aria-label="{{ shop.name | escape }} — home">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 440
            | image_tag:
              class: 'nf-header__logo-img',
              loading: 'eager',
              fetchpriority: 'high',
              alt: shop.name,
              widths: '160, 260, 320, 440'
          }}
        {%- else -%}
          <img
            src="{{ 'nf-wordmark.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            class="nf-header__logo-img"
            width="440"
            height="99"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </a>

      {%- comment -%} Right: contact link, then the icon rail {%- endcomment -%}
      <div class="nf-header__right">
        {%- if menu_right.links != blank -%}
          {%- for link in menu_right.links -%}
            <a
              href="{{ link.url }}"
              class="nf-header__link nf-header__link--right{% if link.active %} is-active{% endif %}"
              {% if link.current %}aria-current="page"{% endif %}
            >
              {{- link.title | escape -}}
            </a>
          {%- endfor -%}
        {%- elsif show_contact_fallback -%}
          <a
            href="{{ section.settings.contact_url }}"
            class="nf-header__link nf-header__link--right"
          >
            {{- section.settings.contact_label | escape -}}
          </a>
        {%- endif -%}

        <a href="{{ routes.search_url }}" class="nf-header__icon" aria-label="Search">
          {%- render 'nf-icon-search', size: 20 -%}
        </a>

        <a
          href="{{ routes.account_url }}"
          class="nf-header__icon nf-header__icon--account"
          aria-label="{% if customer %}{{ customer.first_name | default: 'Account' | escape }}{% else %}Account{% endif %}"
        >
          {%- render 'nf-icon-user', size: 20 -%}
        </a>

        {%- if section.settings.show_wishlist -%}
          <a
            href="{{ section.settings.wishlist_url | default: routes.account_url }}"
            class="nf-header__icon nf-header__icon--badged"
            aria-label="Wishlist"
          >
            {%- render 'nf-icon-heart', size: 20 -%}
            <span class="nf-header__dot" data-nf-wishlist-dot hidden></span>
          </a>
        {%- endif -%}

        {%- comment -%}
          id="cart-icon-bubble" is what Dawn's cart notification and cart
          drawer look for, so this link stays in step with real cart
          state. nf-header.js restores our glyph after those re-render it.
        {%- endcomment -%}
        <a
          href="{{ routes.cart_url }}"
          id="cart-icon-bubble"
          data-nf-cart
          class="nf-header__icon nf-header__icon--badged nf-header__cart"
        >
          {%- render 'nf-icon-bag', size: 20 -%}
          <span
            class="nf-header__badge"
            data-nf-cart-count
            aria-hidden="true"
            {% if cart_count == 0 %}hidden{% endif %}
          >
            {%- if cart_count > 9 -%}9+{%- else -%}{{ cart_count }}{%- endif -%}
          </span>
          <span class="nf-visually-hidden" data-nf-cart-label>
            {{- cart_count }} {% if cart_count == 1 %}item{% else %}items{% endif %} in cart
          </span>
        </a>
      </div>
    </div>
  </nav>

  {%- render 'nf-mobile-menu',
    menu: menu,
    nav_labels: nav_labels,
    nav_urls: nav_urls,
    use_manual_nav: use_manual_nav,
    menu_right: menu_right,
    contact_label: section.settings.contact_label,
    contact_url: section.settings.contact_url,
    whatsapp_url: section.settings.whatsapp_url,
    whatsapp_label: section.settings.whatsapp_label,
    show_wishlist: section.settings.show_wishlist,
    wishlist_url: section.settings.wishlist_url
  -%}
</div>

{% stylesheet %}
/* ── Header shell ─────────────────────────────────────────────────
   Height ladder and colours are the Lovable values verbatim:
   Header.tsx --navbar-h 64 / 72 / 80 at 0 / 768 / 1024,
   Navbar.tsx bg #F4F1ED, scrolled -> rgba(244,241,237,0.85) + blur(8px). */
.nf-header {
  --nf-navbar-h: 64px;
  --nf-header-track: 0.12em;
  width: 100%;
  background-color: var(--nf-header-bg, #f4f1ed);
  color: var(--nf-text, #1a1614);
  transition: background-color 300ms ease, box-shadow 300ms ease, backdrop-filter 300ms ease;
}
/* Sticky is declared on the section wrapper as well as the inner shell:
   in the body grid the wrapper is the element with room to travel. */
.nf-header-section:has(.nf-header--sticky),
.nf-header--sticky {
  position: sticky;
  top: 0;
  z-index: 50;
}
.nf-header--scrolled {
  background-color: color-mix(in srgb, var(--nf-header-bg, #f4f1ed) 85%, transparent);
  box-shadow: 0 1px 8px rgb(0 0 0 / 0.06);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
@media (min-width: 768px) {
  .nf-header { --nf-navbar-h: 72px; }
}
@media (min-width: 1024px) {
  .nf-header { --nf-navbar-h: 80px; }
}

.nf-header__bar { height: var(--nf-navbar-h); }
.nf-header__inner {
  height: 100%;
  max-width: 1400px;
  margin-inline: auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding-inline: 20px;
}
@media (min-width: 1024px) {
  .nf-header__inner { padding-inline: 40px; }
}

/* ── Left cluster ─────────────────────────────────────────────── */
.nf-header__left { display: flex; align-items: center; }
.nf-header__burger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity 200ms ease;
}
.nf-header__burger:hover { opacity: 1; }
.nf-header__links { display: none; }
@media (min-width: 1024px) {
  .nf-header__burger { display: none; }
  .nf-header__links {
    display: flex;
    align-items: center;
    gap: 34px;
  }
}

/* ── Nav links + the underline sweep (index.css .nav-link) ─────── */
.nf-header__link {
  position: relative;
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: var(--nf-header-track);
  white-space: nowrap;
  text-decoration: none;
  color: inherit;
  transition: opacity 200ms ease;
}
@media (min-width: 1024px) {
  .nf-header__link { font-size: 14px; }
}
.nf-header__link:hover { opacity: 0.8; }
.nf-header__link::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 100%;
  height: 1px;
  background-color: currentColor;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 250ms ease;
}
.nf-header__link:hover::after,
.nf-header__link.is-active::after { transform: scaleX(1); }

/* ── Hover dropdown ───────────────────────────────────────────── */
.nf-header__item { position: relative; }
.nf-header__dropdown {
  position: absolute;
  left: 50%;
  top: 100%;
  transform: translateX(-50%);
  padding-top: 12px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 200ms ease, visibility 200ms ease;
  z-index: 50;
}
.nf-header__item:hover .nf-header__dropdown,
.nf-header__item:focus-within .nf-header__dropdown {
  opacity: 1;
  visibility: visible;
}
.nf-header__dropdown-inner {
  min-width: 190px;
  padding-block: 8px;
  background-color: var(--nf-header-bg, #f4f1ed);
  border: 1px solid rgb(0 0 0 / 0.08);
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
}
.nf-header__dropdown-link {
  display: block;
  padding: 10px 20px;
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: var(--nf-header-track);
  text-decoration: none;
  color: hsl(0 0% 20%);
  transition: background-color 150ms ease;
}
.nf-header__dropdown-link:hover { background-color: rgb(0 0 0 / 0.05); }

/* ── Centre wordmark ──────────────────────────────────────────── */
.nf-header__logo {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.nf-header__logo-img {
  display: block;
  width: 80px;
  height: auto;
  max-height: 70%;
  object-fit: contain;
}
@media (min-width: 640px)  { .nf-header__logo-img { width: 90px; } }
@media (min-width: 768px)  { .nf-header__logo-img { width: 100px; } }
@media (min-width: 1024px) { .nf-header__logo-img { width: 130px; } }
@media (min-width: 1280px) { .nf-header__logo-img { width: 140px; } }

/* ── Right cluster ────────────────────────────────────────────── */
.nf-header__right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16px;
}
@media (min-width: 1024px) {
  .nf-header__right { gap: 22px; }
}
.nf-header__link--right { display: none; }
@media (min-width: 1024px) {
  .nf-header__link--right { display: inline; }
}
.nf-header__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: inherit;
  opacity: 0.7;
  transition: opacity 200ms ease, transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
}
.nf-header__icon:hover { opacity: 1; }
.nf-header__icon:active { transform: scale(0.97); }
.nf-header__icon--badged { position: relative; }
.nf-header__icon--account { display: none; }
@media (min-width: 768px) {
  .nf-header__icon--account { display: inline-flex; }
}

/* ── Count badge + wishlist dot ───────────────────────────────── */
.nf-header__badge {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  background-color: var(--nf-header-accent, #2e5b60);
  color: #fff;
}
.nf-header__badge[hidden] { display: none; }
.nf-header__dot {
  position: absolute;
  top: -2px;
  right: -2px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--nf-header-accent, #2e5b60);
}
.nf-header__dot[hidden] { display: none; }

/* Dawn re-renders #cart-icon-bubble on add-to-cart; keep whatever it
   drops in there looking like ours until nf-header.js repaints. */
.nf-header__cart .cart-count-bubble {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  background-color: var(--nf-header-accent, #2e5b60);
  color: #fff;
}
.nf-header__cart .svg-wrapper { display: inline-flex; width: 20px; height: 20px; }

.nf-visually-hidden {
  position: absolute !important;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* ── Mobile drawer (MobileMenu.tsx) ───────────────────────────── */
.nf-mm {
  position: fixed;
  inset: 0;
  z-index: 70;
  visibility: hidden;
}
.nf-mm.is-open { visibility: visible; }
.nf-mm__backdrop {
  position: absolute;
  inset: 0;
  z-index: 60;
  background-color: rgb(0 0 0 / 0.4);
  opacity: 0;
  pointer-events: none;
  transition: opacity 300ms ease;
}
.nf-mm.is-open .nf-mm__backdrop { opacity: 1; pointer-events: auto; }
.nf-mm__panel {
  position: absolute;
  inset-block: 0;
  left: 0;
  z-index: 70;
  width: 85%;
  max-width: 24rem;
  display: flex;
  flex-direction: column;
  background-color: var(--nf-header-bg, #f4f1ed);
  color: var(--nf-text, #1a1614);
  transform: translateX(-100%);
  transition: transform 250ms cubic-bezier(0.4, 0, 1, 1);
}
.nf-mm.is-open .nf-mm__panel {
  transform: translateX(0);
  transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
}
.nf-mm__head { display: flex; justify-content: flex-end; padding: 20px; }
.nf-mm__close {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity 200ms ease;
}
.nf-mm__close:hover { opacity: 1; }
.nf-mm__nav {
  display: flex;
  flex-direction: column;
  gap: 24px;
  flex: 1;
  padding: 8px 32px 0;
  overflow-y: auto;
}
.nf-mm__link {
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 20px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  text-decoration: none;
  color: inherit;
  opacity: 0.8;
  transition: opacity 200ms ease;
}
.nf-mm__link:hover,
.nf-mm__link.is-active { opacity: 1; }
.nf-mm__sub { display: flex; flex-direction: column; gap: 16px; padding-left: 16px; margin-top: -8px; }
.nf-mm__link--sub { font-size: 16px; opacity: 0.65; }
.nf-mm__foot {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 24px 32px 48px;
  border-top: 1px solid rgb(0 0 0 / 0.06);
}
.nf-mm__action {
  position: relative;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: inherit;
  opacity: 0.7;
  transition: opacity 200ms ease;
}
.nf-mm__action:hover { opacity: 1; }
.nf-mm__dot {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--nf-header-accent, #2e5b60);
}
.nf-mm__dot[hidden] { display: none; }
.nf-mm__badge {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  background-color: var(--nf-header-accent, #2e5b60);
  color: #fff;
}
.nf-mm__badge[hidden] { display: none; }
.nf-mm__whatsapp {
  margin-left: auto;
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: var(--nf-track-10, 0.1em);
  text-decoration: none;
  color: inherit;
  opacity: 0.6;
  transition: opacity 200ms ease;
}
.nf-mm__whatsapp:hover { opacity: 1; }

@media (prefers-reduced-motion: reduce) {
  .nf-header,
  .nf-header__link::after,
  .nf-header__icon,
  .nf-mm__panel,
  .nf-mm__backdrop { transition: none; }
  .nf-header__icon:active { transform: none; }
}
{% endstylesheet %}

{% schema %}
{
