{%- comment -%}
  Naira Flore -- site header.
  Ported from src/components/Navbar.tsx (+ the height ladder in
  src/components/Header.tsx) and src/components/MobileMenu.tsx in the
  Lovable repo. React Router links become Shopify routes; the cart
  badge reads real cart state.

  Navigation is block-driven, not linklist-driven: the live main-menu
  is a flat 5-item menu and cannot express React's expandable groups
  (JEWELLERY / THE EDITS / OCCASION / APPAREL each carry children, and
  the mobile drawer has entries -- TRACK ORDER, the split-out
  JEWELLERY group -- that desktop's condensed SHOP entry does not).
  Every top-level nav entry is one "Navigation item" block (see the
  schema block at the end of this file). One ordered block list drives
  both surfaces so they can never drift apart:
    - desktop bar:   blocks with show_in_desktop_bar, split left/right
                      of the logo by desktop_area
    - mobile drawer: blocks with show_in_mobile_drawer, in block order
                      (rendered by snippets/nf-mobile-menu.liquid)
  A block with a non-blank "Children" textarea (Label|/url per line)
  becomes a hover dropdown on desktop and an expand/collapse accordion
  on mobile, matching React's `links` array on a nav Section.

  The announcement strip above the bar is a separate section
  (sections/nf-announcement-bar.liquid) so it stays independently
  editable in the header group.
{%- endcomment -%}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}
<script src="{{ 'nf-header.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Cormorant Garamond + Jost, loaded exactly as index.html does in the
  Lovable repo. Velista (the brand display serif) is served from the
  theme's own assets. Together these back var(--nf-font-display).
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Jost:wght@300;400;500&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
>

{%- style -%}
  @font-face {
    font-family: 'Velista';
    src: url({{ 'nf-velista.woff2' | asset_url }}) format('woff2');
    font-weight: 400 600;
    font-style: normal;
    font-display: swap;
  }
{%- endstyle -%}

{%- liquid
  assign cart_count = cart.item_count
-%}

<div
  class="nf-header{% if section.settings.sticky %} nf-header--sticky{% endif %}"
  data-nf-header
  style="--nf-header-bg: {{ section.settings.bg_colour }}; --nf-header-accent: {{ section.settings.accent_colour }};"
>
  <nav class="nf-header__bar" aria-label="Primary">
    <div class="nf-header__inner">
      {%- comment -%} Left: hamburger on mobile, links from lg up {%- endcomment -%}
      <div class="nf-header__left">
        <button
          type="button"
          class="nf-header__burger"
          data-nf-menu-open
          aria-label="Open menu"
          aria-expanded="false"
        >
          {%- render 'nf-icon-menu', size: 22 -%}
        </button>

        <div class="nf-header__links">
          {%- for block in section.blocks -%}
            {%- assign nf_area = block.settings.desktop_area | default: 'left' -%}
            {%- if block.settings.show_in_desktop_bar and nf_area == 'left' -%}
              {%- assign nf_label = block.settings.label | strip -%}
              {%- assign nf_url = block.settings.url | strip -%}
              {%- assign nf_children = block.settings.children | strip -%}
              {%- comment -%}
                ponytail: exact-path match only. React marks SHOP active
                on every /jewellery* and /shop* sub-route (startsWith);
                this only lights up on /collections/shop-all itself, so
                a Rings/Earrings/etc. sub-page won't underline SHOP.
                Upgrade: compare request.path against each child href's
                prefix too, if that polish is ever asked for.
              {%- endcomment -%}
              {%- assign nf_is_current = false -%}
              {%- if nf_url != blank and request.path == nf_url -%}
                {%- assign nf_is_current = true -%}
              {%- endif -%}

              {%- if block.settings.mega_role == 'panel' and nf_children != blank -%}
                {%- comment -%}
                  React's SHOP entry opens a four-column panel, not a list:
                  an image-tile row built from this block's own children plus
                  one text column per sibling block whose mega_role is column.
                  Reusing the sibling blocks keeps the drawer and the panel on
                  one set of links instead of two that drift apart.
                {%- endcomment -%}
                <div class="nf-header__item nf-header__item--mega" {{ block.shopify_attributes }}>
                  {%- if nf_url != blank -%}
                    <a
                      href="{{ nf_url | escape }}"
                      class="nf-header__link{% if nf_is_current %} is-active{% endif %}"
                      {% if nf_is_current %}aria-current="page"{% endif %}
                    >
                      {{- nf_label | escape -}}
                    </a>
                  {%- else -%}
                    <span class="nf-header__link" tabindex="0">{{- nf_label | escape -}}</span>
                  {%- endif -%}
                  <div class="nf-mega">
                    <div class="nf-mega__inner">
                      <div class="nf-mega__grid">
                        <div class="nf-mega__tiles-col">
                          <p class="nf-mega__label">{{ block.settings.mega_tiles_title | default: 'Shop by category' | escape }}</p>
                          <div class="nf-mega__tiles">
                            {%- assign nf_tile_lines = nf_children | newline_to_br | split: '<br />' -%}
                            {%- for tline in nf_tile_lines -%}
                              {%- assign nf_tline = tline | strip -%}
                              {%- if nf_tline == blank -%}{%- continue -%}{%- endif -%}
                              {%- assign nf_tparts = nf_tline | split: '|' -%}
                              {%- assign nf_tlabel = nf_tparts[0] | strip -%}
                              {%- assign nf_turl = nf_tparts[1] | strip -%}
                              {%- if nf_tlabel == blank or nf_turl == blank -%}{%- continue -%}{%- endif -%}
                              {%- comment -%}
                                React fills each tile with the first live product
                                in that category. The handle is the last path
                                segment of the child href, minus any query string.
                              {%- endcomment -%}
                              {%- assign nf_thandle = nf_turl | split: '?' | first | split: '/' | last -%}
                              {%- assign nf_tcoll = collections[nf_thandle] -%}
                              {%- assign nf_timg = nf_tcoll.products.first.featured_image -%}
                              <a href="{{ nf_turl | escape }}" class="nf-mega__tile">
                                <span class="nf-mega__tile-frame">
                                  {%- if nf_timg -%}
                                    <img
                                      src="{{ nf_timg | image_url: width: 240 }}"
                                      alt=""
                                      loading="lazy"
                                      decoding="async"
                                      width="240"
                                      height="240"
                                      class="nf-mega__tile-img"
                                    >
                                  {%- endif -%}
                                </span>
                                <span class="nf-mega__tile-label">{{- nf_tlabel | escape -}}</span>
                              </a>
                            {%- endfor -%}
                          </div>
                        </div>
                        {%- for col in section.blocks -%}
                          {%- if col.settings.mega_role != 'column' -%}{%- continue -%}{%- endif -%}
                          {%- assign nf_colkids = col.settings.children | strip -%}
                          {%- if nf_colkids == blank -%}{%- continue -%}{%- endif -%}
                          <div class="nf-mega__col">
                            <p class="nf-mega__label">{{ col.settings.mega_title | default: col.settings.label | escape }}</p>
                            <ul class="nf-mega__list">
                              {%- assign nf_col_lines = nf_colkids | newline_to_br | split: '<br />' -%}
                              {%- for kline in nf_col_lines -%}
                                {%- assign nf_kline = kline | strip -%}
                                {%- if nf_kline == blank -%}{%- continue -%}{%- endif -%}
                                {%- assign nf_kparts = nf_kline | split: '|' -%}
                                {%- assign nf_klabel = nf_kparts[0] | strip -%}
                                {%- assign nf_kurl = nf_kparts[1] | strip -%}
                                {%- if nf_klabel == blank or nf_kurl == blank -%}{%- continue -%}{%- endif -%}
                                <li><a href="{{ nf_kurl | escape }}" class="nf-mega__link">{{- nf_klabel | escape -}}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endfor -%}
                      </div>
                    </div>
                  </div>
                </div>
              {%- elsif nf_children != blank -%}
                <div class="nf-header__item" {{ block.shopify_attributes }}>
                  {%- if nf_url != blank -%}
                    <a
                      href="{{ nf_url | escape }}"
                      class="nf-header__link{% if nf_is_current %} is-active{% endif %}"
                      {% if nf_is_current %}aria-current="page"{% endif %}
                    >
                      {{- nf_label | escape -}}
                    </a>
                  {%- else -%}
                    <span class="nf-header__link" tabindex="0">{{- nf_label | escape -}}</span>
                  {%- endif -%}
                  <div class="nf-header__dropdown">
                    <div class="nf-header__dropdown-inner">
                      {%- assign nf_child_lines = nf_children | newline_to_br | split: '<br />' -%}
                      {%- for cline in nf_child_lines -%}
                        {%- assign nf_cline = cline | strip -%}
                        {%- if nf_cline == blank -%}
                          {%- continue -%}
                        {%- endif -%}
                        {%- assign nf_cparts = nf_cline | split: '|' -%}
                        {%- assign nf_clabel = nf_cparts[0] | strip -%}
                        {%- assign nf_curl = nf_cparts[1] | strip -%}
                        {%- if nf_clabel == blank or nf_curl == blank -%}
                          {%- continue -%}
                        {%- endif -%}
                        <a href="{{ nf_curl | escape }}" class="nf-header__dropdown-link">{{- nf_clabel | escape -}}</a>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              {%- else -%}
                {%- if nf_url != blank -%}
                  <a
                    href="{{ nf_url | escape }}"
                    class="nf-header__link{% if nf_is_current %} is-active{% endif %}"
                    {% if nf_is_current %}aria-current="page"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    {{- nf_label | escape -}}
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Centre: NAIRA wordmark, the "I" is a floral glyph {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="nf-header__logo" aria-label="{{ shop.name | escape }} -- home">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 440
            | image_tag:
              class: 'nf-header__logo-img',
              loading: 'eager',
              fetchpriority: 'high',
              alt: shop.name,
              widths: '160, 260, 320, 440'
          }}
        {%- else -%}
          <img
            src="{{ 'nf-wordmark.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            class="nf-header__logo-img"
            width="440"
            height="99"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </a>

      {%- comment -%} Right: nav items pinned right (CONTACT), then the icon rail {%- endcomment -%}
      <div class="nf-header__right">
        {%- for block in section.blocks -%}
          {%- assign nf_area = block.settings.desktop_area | default: 'left' -%}
          {%- if block.settings.show_in_desktop_bar and nf_area == 'right' -%}
            {%- assign nf_label = block.settings.label | strip -%}
            {%- assign nf_url = block.settings.url | strip -%}
            {%- if nf_url != blank -%}
              {%- assign nf_is_current = false -%}
              {%- if request.path == nf_url -%}
                {%- assign nf_is_current = true -%}
              {%- endif -%}
              <a
                href="{{ nf_url | escape }}"
                class="nf-header__link nf-header__link--right{% if nf_is_current %} is-active{% endif %}"
                {% if nf_is_current %}aria-current="page"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{- nf_label | escape -}}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        <a href="{{ routes.search_url }}" class="nf-header__icon" aria-label="Search">
          {%- render 'nf-icon-search', size: 20 -%}
        </a>

        <a
          href="{{ routes.account_url }}"
          class="nf-header__icon nf-header__icon--account"
          aria-label="{% if customer %}{{ customer.first_name | default: 'Account' | escape }}{% else %}Account{% endif %}"
        >
          {%- render 'nf-icon-user', size: 20 -%}
        </a>

        {%- if section.settings.show_wishlist -%}
          <a
            href="{{ section.settings.wishlist_url | default: routes.account_url }}"
            class="nf-header__icon nf-header__icon--badged"
            aria-label="Wishlist"
          >
            {%- render 'nf-icon-heart', size: 20 -%}
            <span class="nf-header__dot" data-nf-wishlist-dot hidden></span>
          </a>
        {%- endif -%}

        {%- comment -%}
          id="cart-icon-bubble" is what Dawn's cart notification and cart
          drawer look for, so this link stays in step with real cart
          state. nf-header.js restores our glyph after those re-render it.
        {%- endcomment -%}
        <a
          href="{{ routes.cart_url }}"
          id="cart-icon-bubble"
          data-nf-cart
          class="nf-header__icon nf-header__icon--badged nf-header__cart"
        >
          {%- render 'nf-icon-bag', size: 20 -%}
          <span
            class="nf-header__badge"
            data-nf-cart-count
            aria-hidden="true"
            {% if cart_count == 0 %}hidden{% endif %}
          >
            {%- if cart_count > 9 -%}9+{%- else -%}{{ cart_count }}{%- endif -%}
          </span>
          <span class="nf-visually-hidden" data-nf-cart-label>
            {{- cart_count }} {% if cart_count == 1 %}item{% else %}items{% endif %} in cart
          </span>
        </a>
      </div>
    </div>
  </nav>

  {%- render 'nf-mobile-menu',
    blocks: section.blocks,
    default_open: section.settings.mobile_default_open,
    whatsapp_url: section.settings.whatsapp_url,
    whatsapp_label: section.settings.whatsapp_label,
    show_wishlist: section.settings.show_wishlist,
    wishlist_url: section.settings.wishlist_url
  -%}
</div>

{% stylesheet %}
/* -- Header shell --------------------------------------------------
   Height ladder and colours are the Lovable values verbatim:
   Header.tsx --navbar-h 64 / 72 / 80 at 0 / 768 / 1024,
   Navbar.tsx bg #F4F1ED, scrolled -> rgba(244,241,237,0.85) + blur(8px). */
.nf-header {
  --nf-navbar-h: 64px;
  --nf-header-track: 0.12em;
  width: 100%;
  background-color: var(--nf-header-bg, #f4f1ed);
  color: var(--nf-text, #1a1614);
  transition: background-color 300ms ease, box-shadow 300ms ease, backdrop-filter 300ms ease;
}
/* Sticky is declared on the section wrapper as well as the inner shell:
   in the body grid the wrapper is the element with room to travel. */
.nf-header-section:has(.nf-header--sticky),
.nf-header--sticky {
  position: sticky;
  top: 0;
  z-index: 50;
}
.nf-header--scrolled {
  background-color: color-mix(in srgb, var(--nf-header-bg, #f4f1ed) 85%, transparent);
  box-shadow: 0 1px 8px rgb(0 0 0 / 0.06);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
@media (min-width: 768px) {
  .nf-header { --nf-navbar-h: 72px; }
}
@media (min-width: 1024px) {
  .nf-header { --nf-navbar-h: 80px; }
}

.nf-header__bar { height: var(--nf-navbar-h); }
.nf-header__inner {
  height: 100%;
  max-width: 1400px;
  margin-inline: auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding-inline: 20px;
}
@media (min-width: 1024px) {
  .nf-header__inner { padding-inline: 40px; }
}

/* -- Left cluster ---------------------------------------------------- */
.nf-header__left { display: flex; align-items: center; }
.nf-header__burger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity 200ms ease;
}
.nf-header__burger:hover { opacity: 1; }
.nf-header__links { display: none; }
@media (min-width: 1024px) {
  .nf-header__burger { display: none; }
  .nf-header__links {
    display: flex;
    align-items: center;
    gap: 34px;
  }
}

/* -- Nav links + the underline sweep (index.css .nav-link) ---------- */
.nf-header__link {
  position: relative;
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: var(--nf-header-track);
  white-space: nowrap;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
  transition: opacity 200ms ease;
}
@media (min-width: 1024px) {
  .nf-header__link { font-size: 14px; }
}
.nf-header__link:hover { opacity: 0.8; }
.nf-header__link::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 100%;
  height: 1px;
  background-color: currentColor;
  transform: scaleX(0);
  transform-origin: center;
  transition: transform 250ms ease;
}
.nf-header__link:hover::after,
.nf-header__link.is-active::after { transform: scaleX(1); }

/* -- Hover dropdown --------------------------------------------------- */
.nf-header__item { position: relative; }
.nf-header__dropdown {
  position: absolute;
  left: 50%;
  top: 100%;
  transform: translateX(-50%);
  padding-top: 12px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 200ms ease, visibility 200ms ease;
  z-index: 50;
}
.nf-header__item:hover .nf-header__dropdown,
.nf-header__item:focus-within .nf-header__dropdown {
  opacity: 1;
  visibility: visible;
}
.nf-header__dropdown-inner {
  min-width: 190px;
  padding-block: 8px;
  background-color: var(--nf-header-bg, #f4f1ed);
  border: 1px solid rgb(0 0 0 / 0.08);
  box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
}
.nf-header__dropdown-link {
  display: block;
  padding: 10px 20px;
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: var(--nf-header-track);
  text-decoration: none;
  color: hsl(0 0% 20%);
  transition: background-color 150ms ease;
}
.nf-header__dropdown-link:hover { background-color: rgb(0 0 0 / 0.05); }

/* -- SHOP mega panel ---------------------------------------------------
   Ported from src/components/nav/MegaMenu.tsx + the wrapper in Navbar.tsx.
   The panel is fixed to the viewport rather than the trigger, so the grid
   stays centred at every width instead of sliding with the SHOP link. */
.nf-mega {
  position: fixed;
  left: 50%;
  top: calc(var(--nf-announcement-h, 0px) + var(--nf-navbar-h, 72px));
  transform: translateX(-50%);
  padding-top: 12px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 200ms ease, visibility 200ms ease;
  z-index: 50;
}
.nf-header__item--mega:hover .nf-mega,
.nf-header__item--mega:focus-within .nf-mega { opacity: 1; visibility: visible; }
.nf-mega__inner {
  width: min(1100px, 92vw);
  padding: 32px;
  background-color: #f4f1ed;
  border: 1px solid rgb(0 0 0 / 0.08);
  box-shadow: 0 14px 40px rgb(0 0 0 / 0.10);
}
.nf-mega__grid {
  display: grid;
  grid-template-columns: 1.35fr repeat(3, 0.65fr);
  gap: 32px;
}
.nf-mega__label {
  margin: 0;
  font-family: var(--nf-font-label, 'Jost', ui-sans-serif, system-ui, sans-serif);
  font-size: 9px;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: hsl(0 0% 20% / 0.4);
}
.nf-mega__tiles {
  margin-top: 16px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}
.nf-mega__tile { display: block; text-decoration: none; }
.nf-mega__tile-frame {
  display: block;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background-color: var(--nf-ivory-deep, #ece7e0);
}
.nf-mega__tile-img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 500ms ease;
}
.nf-mega__tile:hover .nf-mega__tile-img { transform: scale(1.05); }
.nf-mega__tile-label {
  display: block;
  margin-top: 8px;
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: hsl(0 0% 20% / 0.75);
  transition: color 150ms ease;
}
.nf-mega__tile:hover .nf-mega__tile-label { color: hsl(0 0% 20%); }
.nf-mega__list {
  margin: 16px 0 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.nf-mega__link {
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  text-decoration: none;
  color: hsl(0 0% 20% / 0.75);
  transition: color 150ms ease;
}
.nf-mega__link:hover { color: hsl(0 0% 20%); }

/* The panel is desktop-only; the drawer carries the same links on mobile. */
@media (max-width: 989px) { .nf-mega { display: none; } }

/* -- Centre wordmark --------------------------------------------------- */
.nf-header__logo {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}
.nf-header__logo-img {
  display: block;
  width: 80px;
  height: auto;
  max-height: 70%;
  object-fit: contain;
}
@media (min-width: 640px)  { .nf-header__logo-img { width: 90px; } }
@media (min-width: 768px)  { .nf-header__logo-img { width: 100px; } }
@media (min-width: 1024px) { .nf-header__logo-img { width: 130px; } }
@media (min-width: 1280px) { .nf-header__logo-img { width: 140px; } }

/* -- Right cluster ----------------------------------------------------- */
.nf-header__right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16px;
}
@media (min-width: 1024px) {
  .nf-header__right { gap: 22px; }
}
.nf-header__link--right { display: none; }
@media (min-width: 1024px) {
  .nf-header__link--right { display: inline; }
}
.nf-header__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: inherit;
  opacity: 0.7;
  transition: opacity 200ms ease, transform 140ms cubic-bezier(0.23, 1, 0.32, 1);
}
.nf-header__icon:hover { opacity: 1; }
.nf-header__icon:active { transform: scale(0.97); }
.nf-header__icon--badged { position: relative; }
.nf-header__icon--account { display: none; }
@media (min-width: 768px) {
  .nf-header__icon--account { display: inline-flex; }
}

/* -- Count badge + wishlist dot ---------------------------------------- */
.nf-header__badge {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  background-color: var(--nf-header-accent, #2e5b60);
  color: #fff;
}
.nf-header__badge[hidden] { display: none; }
.nf-header__dot {
  position: absolute;
  top: -2px;
  right: -2px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--nf-header-accent, #2e5b60);
}
.nf-header__dot[hidden] { display: none; }

/* Dawn re-renders #cart-icon-bubble on add-to-cart; keep whatever it
   drops in there looking like ours until nf-header.js repaints. */
.nf-header__cart .cart-count-bubble {
  position: absolute;
  top: -8px;
  right: -8px;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  background-color: var(--nf-header-accent, #2e5b60);
  color: #fff;
}
.nf-header__cart .svg-wrapper { display: inline-flex; width: 20px; height: 20px; }

.nf-visually-hidden {
  position: absolute !important;
  width: 1px;
  height: 1px;
  margin: -1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}

/* -- Mobile drawer (MobileMenu.tsx) ------------------------------------
   The closed state is transform + opacity only, same as the React
   source (translate-x-full / opacity-0), never visibility:hidden or
   display:none on the wrapper: those would also strip every focusable
   element in the drawer from `inert`-style handling below, and they
   read as "not present" to any tool that walks computed styles rather
   than actual visibility. Real hiding comes from `inert` (set in the
   markup by default, cleared by nf-header.js on open), which drops
   the whole subtree out of both the tab order and the a11y tree. */
.nf-mm {
  position: fixed;
  inset: 0;
  z-index: 70;
  /* The closed drawer is a full-viewport fixed box. `inert` alone is not
     enough to make it harmless: browsers without inert support (and any
     context that strips the attribute) leave a transparent 100vw x 100vh
     layer at z-index 70 swallowing every click on the page -- the header
     nav, the product grid, the whole site reads as dead. pointer-events
     costs nothing and fails safe. */
  pointer-events: none;
}
.nf-mm.is-open { pointer-events: auto; }
.nf-mm__backdrop {
  position: absolute;
  inset: 0;
  z-index: 60;
  background-color: rgb(0 0 0 / 0.4);
  opacity: 0;
  pointer-events: none;
  transition: opacity 300ms ease;
}
.nf-mm.is-open .nf-mm__backdrop { opacity: 1; pointer-events: auto; }
.nf-mm__panel {
  position: absolute;
  inset-block: 0;
  left: 0;
  z-index: 70;
  width: 85%;
  max-width: 24rem;
  display: flex;
  flex-direction: column;
  background-color: var(--nf-header-bg, #f4f1ed);
  color: var(--nf-text, #1a1614);
  transform: translateX(-100%);
  transition: transform 250ms cubic-bezier(0.4, 0, 1, 1);
}
.nf-mm.is-open .nf-mm__panel {
  transform: translateX(0);
  transition: transform 300ms cubic-bezier(0.32, 0.72, 0, 1);
}
.nf-mm__head { display: flex; justify-content: flex-end; padding: 20px; }
.nf-mm__close {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  cursor: pointer;
  opacity: 0.7;
  transition: opacity 200ms ease;
}
.nf-mm__close:hover { opacity: 1; }
.nf-mm__nav {
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
  padding: 8px 32px 24px;
  overflow-y: auto;
}
/* One hairline divider per top-level row (flat link or accordion
   group), last row bare -- React's border-b border-black/5 last:border-0
   applied per item, but done once here since both markup shapes are
   direct children of .nf-mm__nav. */
.nf-mm__nav > * { border-bottom: 1px solid rgb(0 0 0 / 0.05); }
.nf-mm__nav > *:last-child { border-bottom: 0; }
.nf-mm__link {
  display: flex;
  align-items: center;
  min-height: 52px;
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 20px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  text-decoration: none;
  color: inherit;
  opacity: 0.8;
  transition: opacity 200ms ease;
}
.nf-mm__link:hover,
.nf-mm__link.is-active { opacity: 1; }
/* Accordion trigger: same look as a link, reset as a button. */
.nf-mm__toggle {
  width: 100%;
  justify-content: space-between;
  gap: 12px;
  padding: 0;
  border: 0;
  background: none;
  font: inherit;
  text-align: left;
  cursor: pointer;
}
.nf-mm__chevron { flex: none; transition: transform 200ms ease; }
.nf-mm__toggle[aria-expanded="true"] .nf-mm__chevron { transform: rotate(180deg); }
.nf-mm__sub {
  display: flex;
  flex-direction: column;
  gap: 4px;
  margin: 0;
  padding: 0 0 16px 4px;
  list-style: none;
  animation: nf-fade-in 200ms ease;
}
.nf-mm__sub[hidden] { display: none; }
.nf-mm__link--sub { min-height: 42px; padding-block: 8px; font-size: 16px; opacity: 0.65; }
@keyframes nf-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}
.nf-mm__foot {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 24px 32px 48px;
  border-top: 1px solid rgb(0 0 0 / 0.06);
}
.nf-mm__action {
  position: relative;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: inherit;
  opacity: 0.7;
  transition: opacity 200ms ease;
}
.nf-mm__action:hover { opacity: 1; }
.nf-mm__dot {
  position: absolute;
  top: 4px;
  right: 4px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background-color: var(--nf-header-accent, #2e5b60);
}
.nf-mm__dot[hidden] { display: none; }
.nf-mm__badge {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 10px;
  font-weight: 700;
  line-height: 1;
  background-color: var(--nf-header-accent, #2e5b60);
  color: #fff;
}
.nf-mm__badge[hidden] { display: none; }
.nf-mm__whatsapp {
  margin-left: auto;
  font-family: var(--nf-font-display, 'Velista', 'Cormorant Garamond', Georgia, serif);
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: var(--nf-track-10, 0.1em);
  text-decoration: none;
  color: inherit;
  opacity: 0.6;
  transition: opacity 200ms ease;
}
.nf-mm__whatsapp:hover { opacity: 1; }

/* Interactive elements already get a visible focus ring from the
   global :where(a, button, [tabindex]):focus-visible rule in
   nf-base.css (zero specificity, applies here without repeating it). */

@media (prefers-reduced-motion: reduce) {
  .nf-header,
  .nf-header__link::after,
  .nf-header__icon,
  .nf-mm__panel,
  .nf-mm__backdrop,
  .nf-mm__chevron,
  .nf-mm__sub { transition: none; animation: none; }
  .nf-header__icon:active { transform: none; }
}
{% endstylesheet %}

{%- comment -%}
  Route substitutions used in the default blocks below (no exact
  Shopify equivalent exists yet on this store):
    /jewellery, /shop            -> /collections/shop-all
    /shop/indo-western           -> /collections/all (no Indo-Western
                                     collection yet; matches the old
                                     dropdown_link_2_url placeholder)
    /gifting                     -> /collections/sets (closest existing
                                     collection; matches the old
                                     nav_urls placeholder for GIFTING)
    ?sort=newest / ?sort=best / ?under=1500
                                  -> /collections/shop-all with
                                     Shopify's own sort_by / filter.v.price.lte
                                     query params -- native platform params,
                                     no theme code needed. The store may
                                     not have those price bands live yet.
    ?tag=Everyday / Festive / Wedding
                                  -> /collections/shop-all?filter.p.tag=...
                                     (native platform param; those exact
                                     product tags may not exist yet)
    /track-order                 -> /account (Shopify has no storefront
                                     order-tracking route without an app;
                                     account order history is the closest
                                     built-in equivalent)
  Full reasoning: see the port report.
{%- endcomment -%}

