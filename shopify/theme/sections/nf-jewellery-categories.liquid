{% comment %}
  nf-jewellery-categories - port of src/components/jewellery/JewelleryCategories.tsx
  Card = image (gold hairline frame + zoom on hover) on top, then a cream
  caption block below holding the label, an italic note, and a bordered
  "N PIECES ->" chip that fills gold on card hover. No dark scrim on the
  image; the caption sits below it, same as the React card.

  The React version counted pieces out of a hardcoded src/data/jewellery.ts
  array; here each card is bound to a real Shopify collection and the count
  comes from collection.all_products_count.

  Card image resolution order:
    1. block.settings.image        - merchant-picked image, wins
    2. block.settings.image_asset  - theme asset filename, plain <img> tag
    3. col.image                   - the collection's own image
    4. col.products.first.featured_image
    5. placeholder block
{% endcomment %}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}
{{ 'nf-home.css' | asset_url | stylesheet_tag }}

<section class="nf nf-cats">
  <div class="nf-cats__wrap">
    <div class="nf-cats__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-cats__eyebrow nf-label">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h3 class="nf-cats__title">
        {{ section.settings.heading_lead }} <em class="nf-editorial">{{ section.settings.heading_italic }}</em>
      </h3>
    </div>

    <div class="nf-cats__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          if col == blank and block.settings.collection_handle != blank
            assign col = collections[block.settings.collection_handle]
          endif

          assign label = block.settings.label
          if label == blank
            assign label = col.title
          endif
          assign card_alt = label | append: ', Naira Flore demi-gold'

          assign card_image = ''
          assign card_image_asset = ''
          if block.settings.image != blank
            assign card_image = block.settings.image
          elsif block.settings.image_asset != blank
            assign card_image_asset = block.settings.image_asset
          elsif col.image != blank
            assign card_image = col.image
          elsif col.products.first.featured_image != blank
            assign card_image = col.products.first.featured_image
          endif
        -%}
        {%- if col != blank or block.settings.label != blank -%}
          <a class="nf-cats__card" href="{{ col.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            <span class="nf-cats__media">
              {%- if card_image != blank -%}
                {{ card_image | image_url: width: 900 | image_tag:
                    alt: card_alt, loading: 'lazy', widths: '300,450,600,900',
                    sizes: '(min-width: 1024px) 25vw, 50vw' }}
              {%- elsif card_image_asset != blank -%}
                <img src="{{ card_image_asset | asset_url }}" alt="{{ card_alt }}" loading="lazy" width="800" height="1000">
              {%- else -%}
                <span class="nf-cats__ph" aria-hidden="true"></span>
              {%- endif -%}
              <span class="nf-cats__frame" aria-hidden="true"></span>
            </span>
            <span class="nf-cats__caption">
              <b>{{ label }}</b>
              {%- if block.settings.note != blank -%}
                <i class="nf-editorial">{{ block.settings.note }}</i>
              {%- endif -%}
              {%- if col != blank -%}
                <span class="nf-cats__count nf-label">{{ col.all_products_count | default: col.products_count }} {{ section.settings.count_word }} &rarr;</span>
              {%- endif -%}
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* The React source styles both of these with a `velista` font-family whose
   var(--font-cormorant) is defined nowhere, so the declaration is invalid at
   computed-value time and the headings fall back to the app sans with normal
   tracking. `.nf-display` would apply Velista and its own tracking, which is
   the "display-font landmine" in docs/design-tokens.md -- the same override
   nf-collection.liquid uses on .nf-coll__title and .jc__title. */
.nf-cats__title { font-family: inherit !important; letter-spacing: normal !important; line-height: 1.5 !important; }
.nf-cats__caption b { font-family: inherit; letter-spacing: normal !important; }
{% endstylesheet %}

{% schema %}
{
  "name": "NF Jewellery categories",
  "tag": "section",
  "class": "nf-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP BY CATEGORY" },
    { "type": "text", "id": "heading_lead", "label": "Heading", "default": "The" },
    { "type": "text", "id": "heading_italic", "label": "Heading, italic word", "default": "edit." },
    { "type": "text", "id": "count_word", "label": "Count label", "default": "PIECES" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "collection_handle", "label": "Fallback collection handle", "info": "Used when no collection is picked above. Lets the section work out of the box." },
        { "type": "text", "id": "label", "label": "Card label", "info": "Leave empty to use the collection title." },
        { "type": "text", "id": "note", "label": "Italic note" },
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Overrides the theme asset and collection image below." },
        { "type": "text", "id": "image_asset", "label": "Card image asset", "info": "Filename of an image already uploaded to the theme's Assets, e.g. nf-cat-rings.jpg. Used when no image is picked above; falls back to the collection image, then its first product image." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "NF Jewellery categories",
      "blocks": [
        { "type": "category", "settings": { "collection_handle": "rings", "label": "Rings", "note": "solitaires, halo & stack" } },
        { "type": "category", "settings": { "collection_handle": "bracelets", "label": "Bracelets", "note": "tennis, bow & baroque pearl" } },
        { "type": "category", "settings": { "collection_handle": "earrings", "label": "Earrings", "note": "hoops & the studs, three ways" } },
        { "type": "category", "settings": { "collection_handle": "necklaces", "label": "Necklaces", "note": "lariats, chains & a cascade" } }
      ]
    }
  ]
}
{% endschema %}