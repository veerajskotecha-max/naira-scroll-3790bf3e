{%- comment -%}
  nf-new-arrivals -- port of src/components/NewArrivals.tsx

  On the React homepage this section never stands alone: it is the last
  child rendered inside HeroScrollyWrapper.tsx, which supplies the entire
  backdrop behind it -- an hsl(33 30% 85%) ground, a tiled floral pattern
  overlay at 0.5 opacity, and a large centred Naira logo reveal floating
  above the grid. A Shopify section has no wrapper component to hold that
  chrome, so the ground colour, floral tile and logo reveal are all
  reproduced here, inside the section root, instead of being left behind.

  NewArrivals.tsx also renders its own bottom-right floral accent image
  (src/assets/floral-bottom-right.webp -- a watercolour sprig, a
  different piece of art from the tiled damask pattern above it). No
  theme asset matches that sprig, so it is intentionally left out; see
  the port notes for detail.

  Products come from a merchant-chosen collection, falling back to
  collections.all, rendered through snippets/nf-product-card.liquid --
  the same card nf-collection.liquid already uses. The React version
  always fetches 8 products and shows only the first 4; here that is a
  "Number of products" setting defaulted to 4, to match the live site.
{%- endcomment -%}

{%- liquid
  assign nf_collection = section.settings.collection
  if nf_collection == blank
    assign nf_collection = collections.all
  endif
  assign nf_products = nf_collection.products
  assign nf_count = section.settings.product_count | default: 4
-%}

<section class="nf nf-arr">
  <div class="nf-arr__tile" aria-hidden="true" style="background-image: url({{ 'nf-background-flora.webp' | asset_url }});"></div>

  <div class="nf-arr__logo" aria-hidden="true">
    <div class="nf-arr__logo-box">
      <img
        src="{{ 'nf-naira-logo.webp' | asset_url }}"
        alt=""
        class="nf-arr__logo-img"
        loading="eager"
        decoding="async"
        width="788"
        height="178"
      >
    </div>
  </div>

  <div class="nf-arr__inner">
    <div class="nf-arr__head">
      <h2 class="nf-arr__title">{{ section.settings.heading | default: 'New Arrivals' }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="nf-arr__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- if nf_products.size > 0 -%}
      <div class="nf-arr__grid">
        {%- for product in nf_products limit: nf_count -%}
          {%- render 'nf-product-card', product: product, index: forloop.index0, uid: section.id -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="nf-arr__empty">
        <p>No products found</p>
      </div>
    {%- endif -%}

    <div class="nf-arr__cta-row">
      <a
        href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
        class="nf-arr__cta"
      >
        {{ section.settings.cta_label | default: 'VIEW ALL' }}
        <span class="nf-arr__cta-arrow" aria-hidden="true">&rsaquo;</span>
      </a>
    </div>
  </div>
</section>

{% stylesheet %}
.nf-arr {
  position: relative;
  width: 100%;
  background-color: hsl(33 30% 85%);
  padding-block: 40px;
}
@media (min-width: 768px) { .nf-arr { padding-block: 56px; } }
@media (min-width: 1024px) {
  .nf-arr { padding-top: 155px; padding-bottom: 64px; min-height: 100vh; }
}

/* Tiled floral pattern -- HeroScrollyWrapper's ground decoration, ported
   in because Shopify has no wrapper element to hold it for us. */
.nf-arr__tile {
  position: absolute;
  inset: 0;
  background-size: 600px;
  background-position: center;
  background-repeat: repeat;
  opacity: .5;
  z-index: 0;
  pointer-events: none;
}

/* Naira logo reveal -- also HeroScrollyWrapper's; it floats above the
   grid rather than belonging to any one product tile. */
.nf-arr__logo {
  position: absolute;
  inset-inline: 0;
  top: 38vh;
  z-index: 2;
  display: flex;
  justify-content: center;
  opacity: .95;
  pointer-events: none;
}
@media (min-width: 768px)  { .nf-arr__logo { top: 34vh; } }
@media (min-width: 1024px) { .nf-arr__logo { top: 30vh; } }

.nf-arr__logo-box {
  position: relative;
  width: 82vw;
  max-width: 520px;
  aspect-ratio: 788 / 178;
  overflow: hidden;
}
@media (min-width: 768px)  { .nf-arr__logo-box { max-width: 760px; } }
@media (min-width: 1024px) { .nf-arr__logo-box { max-width: 980px; } }

.nf-arr__logo-img {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 243.7%;
  height: auto;
  max-width: none;
  object-fit: contain;
  transform: translate(-50%, -50%);
  filter: sepia(.15) saturate(.85);
}

.nf-arr__inner {
  position: relative;
  z-index: 10;
  max-width: 1280px;
  margin-inline: auto;
  padding-inline: 20px;
}
@media (min-width: 768px)  { .nf-arr__inner { padding-inline: 32px; } }
@media (min-width: 1024px) { .nf-arr__inner { padding-inline: 40px; } }

.nf-arr__head { text-align: center; margin-bottom: 32px; }
@media (min-width: 768px)  { .nf-arr__head { margin-bottom: 40px; } }
@media (min-width: 1024px) { .nf-arr__head { margin-bottom: 48px; } }

.nf-arr__title {
  margin: 0 0 8px;
  font-family: var(--nf-font-display);
  font-size: 28px;
  font-weight: 500;
  font-style: italic;
  color: hsl(0 0% 18%);
}
@media (min-width: 768px)  { .nf-arr__title { font-size: 34px; } }
@media (min-width: 1024px) { .nf-arr__title { font-size: 42px; } }

.nf-arr__subtitle {
  margin: 0;
  font-family: var(--nf-font-display);
  font-size: 14px;
  color: hsl(0 0% 43%);
}
@media (min-width: 768px)  { .nf-arr__subtitle { font-size: 15px; } }
@media (min-width: 1024px) { .nf-arr__subtitle { font-size: 16px; } }

.nf-arr__grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
@media (min-width: 640px)  { .nf-arr__grid { gap: 16px; } }
@media (min-width: 1024px) { .nf-arr__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; } }

.nf-arr__empty { padding-block: 56px; text-align: center; }
.nf-arr__empty p {
  margin: 0;
  font-family: var(--nf-font-display);
  font-size: 20px;
  font-weight: 600;
  color: hsl(0 0% 25%);
}

.nf-arr__cta-row { display: flex; justify-content: center; margin-top: 40px; }
@media (min-width: 768px)  { .nf-arr__cta-row { margin-top: 48px; } }
@media (min-width: 1024px) { .nf-arr__cta-row { margin-top: 56px; } }

.nf-arr__cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 40px;
  border-radius: 6px;
  background-color: hsl(186 35% 28%);
  color: hsl(0 0% 100%);
  font-family: var(--nf-font-display);
  font-size: 15px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: .08em;
  text-decoration: none;
  transition: background-color .3s cubic-bezier(.4,0,.2,1), transform .3s cubic-bezier(.4,0,.2,1), box-shadow .3s cubic-bezier(.4,0,.2,1);
}
.nf-arr__cta:hover,
.nf-arr__cta:focus-visible {
  background-color: hsl(186 35% 23%);
  transform: translateY(-2px);
  box-shadow: 0 10px 15px -3px rgb(0 0 0 / .1), 0 4px 6px -4px rgb(0 0 0 / .1);
}
.nf-arr__cta-arrow { font-size: 16px; }

@media (prefers-reduced-motion: reduce) {
  .nf-arr__cta { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "NF New Arrivals",
  "tag": "section",
  "class": "nf-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "The latest pieces, straight from our studio." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to pull from all products." },
    { "type": "range", "id": "product_count", "label": "Number of products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "VIEW ALL" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Leave empty to link to all products." }
  ],
  "presets": [{ "name": "NF New Arrivals" }]
}
{% endschema %}
