      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Get in touch"
    },
    {
      "type": "html",
      "id": "hero_heading",
      "label": "Heading",
      "info": "Wrap a word in <span class=\"nf-italic\">…</span> for the blush italic.",
      "default": "Contact <span class=\"nf-italic\">Us</span>"
    },
    {
      "type": "textarea",
      "id": "hero_text",
      "label": "Intro",
      "default": "We'd love to hear from you. Whether you have questions about our collections, custom designs, or orders, our team is here to help."
    },
    {
      "type": "color",
      "id": "hero_background",
      "label": "Cream section background",
      "default": "#FBF6F1"
    },
    {
      "type": "image_picker",
      "id": "floral_image",
      "label": "Floral pattern background"
    },
    {
      "type": "header",
      "content": "Enquiry form"
    },
    {
      "type": "text",
      "id": "form_eyebrow",
      "label": "Eyebrow",
      "default": "Send a message"
    },
    {
      "type": "html",
      "id": "form_heading",
      "label": "Heading",
      "default": "We're Here to <span class=\"nf-italic\">Help</span>"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name placeholder",
      "default": "Full Name"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email placeholder",
      "default": "Email Address"
    },
    {
      "type": "text",
      "id": "label_phone",
      "label": "Phone placeholder",
      "default": "Phone Number"
    },
    {
      "type": "text",
      "id": "label_subject",
      "label": "Subject placeholder",
      "default": "Subject"
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message placeholder",
      "default": "Your Message"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button",
      "default": "Submit Message"
    },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. Your message has reached the atelier — we usually reply within 24 to 48 hours."
    },
    {
      "type": "text",
      "id": "response_note",
      "label": "Note under the form",
      "default": "Our team usually responds within 24–48 hours."
    },
    {
      "type": "header",
      "content": "WhatsApp block"
    },
    {
      "type": "checkbox",
      "id": "show_whatsapp",
      "label": "Show WhatsApp block",
      "default": true
    },
    {
      "type": "html",
      "id": "whatsapp_heading",
      "label": "Heading",
      "default": "Need a quick <span class=\"nf-italic\">answer?</span>"
    },
    {
      "type": "text",
      "id": "whatsapp_text",
      "label": "Text",
      "default": "Chat with our team on WhatsApp for faster support."
    },
    {
      "type": "text",
      "id": "whatsapp_button",
      "label": "Button label",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "url",
      "id": "whatsapp_link",
      "label": "WhatsApp link"
    },
    {
      "type": "header",
      "content": "FAQ shortcut"
    },
    {
      "type": "checkbox",
      "id": "show_faq_shortcut",
      "label": "Show FAQ shortcut",
