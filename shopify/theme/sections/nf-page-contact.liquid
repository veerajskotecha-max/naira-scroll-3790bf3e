    },
    {
      "type": "text",
      "id": "faq_text",
      "label": "Text",
      "default": "Visit our FAQ page to find answers to common questions."
    },
    {
      "type": "text",
      "id": "faq_button",
      "label": "Button label",
      "default": "View FAQs"
    },
    {
      "type": "url",
      "id": "faq_link",
      "label": "FAQ page link"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Contact card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "pin",
              "label": "Map pin"
