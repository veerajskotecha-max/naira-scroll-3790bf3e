{%- comment -%}
  Naira Flore — Contact page
  Ported from src/pages/ContactUs.tsx (Lovable repo).

  The Lovable form only deep-linked to WhatsApp; nothing was ever delivered to
  the merchant. This rebuild posts through Shopify's own contact form tag,
  so every submission lands in the store's notification email. The WhatsApp
  route is kept as the separate "quick answer" block it always was.
{%- endcomment -%}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}
{{ 'nf-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign floral = section.settings.floral_image
  if floral != blank
    assign floral_url = floral | image_url: width: 600
  endif
-%}

<div class="nf-mk nf-contact">
  {%- comment -%} ── SECTION 1 — Hero ── {%- endcomment -%}
  <section class="nf-mk__section nf-mk__pad" style="background-color: {{ section.settings.hero_background }};">
    {%- if floral_url -%}
      <div class="nf-mk__floral" style="background-image: url({{ floral_url }}); opacity: 0.06;"></div>
    {%- endif -%}
    <div class="nf-mk__wrap" style="position: relative; z-index: 1; text-align: center;">
      <p class="nf-eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
      <h1 style="font-size: 32px; line-height: 1.15; color: var(--nf-mk-heading); margin-bottom: 24px;">
        {{ section.settings.hero_heading }}
      </h1>
      <p class="nf-mk__lede" style="max-width: 560px;">{{ section.settings.hero_text | escape }}</p>
    </div>
  </section>

  {%- comment -%} ── SECTION 2 — Contact cards ── {%- endcomment -%}
  {%- assign card_blocks = section.blocks | where: 'type', 'card' -%}
  {%- if card_blocks.size > 0 -%}
    <section class="nf-mk__section nf-mk__pad" style="background-color: var(--nf-mk-white);">
      <div class="nf-mk__wrap">
        <div class="nf-contact__cards">
          {%- for block in card_blocks -%}
            <div class="nf-contact__card" {{ block.shopify_attributes }}>
              <span class="nf-chip" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'pin' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                  {%- when 'phone' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z"/></svg>
                  {%- when 'mail' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16"/><path d="m2 6 10 7L22 6"/></svg>
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                {%- endcase -%}
              </span>
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.line_1 != blank -%}<p>{{ block.settings.line_1 | escape }}</p>{%- endif -%}
              {%- if block.settings.line_2 != blank -%}<p>{{ block.settings.line_2 | escape }}</p>{%- endif -%}
              {%- if block.settings.line_3 != blank -%}<p>{{ block.settings.line_3 | escape }}</p>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── SECTION 3 — Contact form, posted through Shopify ── {%- endcomment -%}
  <section
    id="nf-contact-form"
    class="nf-mk__section nf-mk__pad"
    style="background-color: {{ section.settings.hero_background }}; scroll-margin-top: 110px;"
  >
    {%- if floral_url -%}
      <div class="nf-mk__floral" style="background-image: url({{ floral_url }}); opacity: 0.05;"></div>
    {%- endif -%}
    <div class="nf-mk__wrap" style="position: relative; z-index: 1;">
      <div style="text-align: center; margin-bottom: 40px;">
        <p class="nf-eyebrow">{{ section.settings.form_eyebrow | escape }}</p>
        <h2 class="nf-mk__h2" style="margin-bottom: 0;">{{ section.settings.form_heading }}</h2>
      </div>

      {%- form 'contact', id: 'NfContactForm', class: 'nf-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="nf-contact__success" role="status" tabindex="-1" autofocus>
            {{ section.settings.success_message | escape }}
          </p>
        {%- elsif form.errors -%}
          <div class="nf-contact__errors" role="alert">
            <strong>{{ 'templates.contact.form.error_heading' | t }}</strong>
            <ul>
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="nf-contact__row nf-contact__row--2">
          <label class="nf-contact__field">
            <span class="nf-visually-hidden">{{ section.settings.label_name | escape }}</span>
            <input
              class="nf-contact__input"
              type="text"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              id="NfContactName"
              autocomplete="name"
              placeholder="{{ section.settings.label_name | escape }}"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              required
            >
          </label>
          <label class="nf-contact__field">
            <span class="nf-visually-hidden">{{ section.settings.label_email | escape }}</span>
            <input
              class="nf-contact__input"
              type="email"
              name="contact[email]"
              id="NfContactEmail"
              autocomplete="email"
              autocapitalize="off"
              autocorrect="off"
              spellcheck="false"
              placeholder="{{ section.settings.label_email | escape }}"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              required
            >
          </label>
        </div>

        <div class="nf-contact__row nf-contact__row--2">
          <label class="nf-contact__field">
            <span class="nf-visually-hidden">{{ section.settings.label_phone | escape }}</span>
            <input
              class="nf-contact__input"
              type="tel"
              name="contact[{{ 'templates.contact.form.phone' | t }}]"
              id="NfContactPhone"
              autocomplete="tel"
              placeholder="{{ section.settings.label_phone | escape }}"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
            >
          </label>
          <label class="nf-contact__field">
            <span class="nf-visually-hidden">{{ section.settings.label_subject | escape }}</span>
            <input
              class="nf-contact__input"
              type="text"
              name="contact[Subject]"
              id="NfContactSubject"
              placeholder="{{ section.settings.label_subject | escape }}"
              required
            >
          </label>
        </div>

        <div class="nf-contact__row">
          <label class="nf-contact__field">
            <span class="nf-visually-hidden">{{ section.settings.label_message | escape }}</span>
            <textarea
              class="nf-contact__textarea"
              rows="5"
              name="contact[body]"
              id="NfContactMessage"
              placeholder="{{ section.settings.label_message | escape }}"
              required
            >{{ form.body }}</textarea>
          </label>
        </div>

        <div class="nf-contact__submit">
          <button class="nf-btn" type="submit">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>
            {{ section.settings.submit_label | escape }}
          </button>
        </div>

        <p class="nf-contact__note">{{ section.settings.response_note | escape }}</p>
      {%- endform -%}
    </div>
  </section>

  {%- comment -%} ── SECTION 4 — WhatsApp ── {%- endcomment -%}
  {%- if section.settings.show_whatsapp -%}
    <section class="nf-mk__section nf-mk__pad" style="background-color: var(--nf-mk-white);">
      <div class="nf-mk__wrap" style="text-align: center;">
        <span class="nf-chip" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"/></svg>
        </span>
        <h2 class="nf-mk__h2" style="font-size: 26px;">{{ section.settings.whatsapp_heading }}</h2>
        <p class="nf-mk__lede" style="max-width: 440px; margin-bottom: 32px;">{{ section.settings.whatsapp_text | escape }}</p>
        <a class="nf-btn" href="{{ section.settings.whatsapp_link }}" target="_blank" rel="noopener noreferrer">
          {{ section.settings.whatsapp_button | escape }}
        </a>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── SECTION 5 — FAQ shortcut ── {%- endcomment -%}
  {%- if section.settings.show_faq_shortcut -%}
    <section class="nf-mk__section nf-mk__pad" style="background-color: {{ section.settings.hero_background }};">
      {%- if floral_url -%}
        <div class="nf-mk__floral" style="background-image: url({{ floral_url }}); opacity: 0.05;"></div>
      {%- endif -%}
      <div class="nf-mk__wrap" style="position: relative; z-index: 1; text-align: center;">
        <span class="nf-chip nf-chip--blush" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2.5-3 4"/><path d="M12 17h.01"/></svg>
        </span>
        <h2 class="nf-mk__h2" style="font-size: 26px;">{{ section.settings.faq_heading }}</h2>
        <p class="nf-mk__lede" style="max-width: 440px; margin-bottom: 32px;">{{ section.settings.faq_text | escape }}</p>
        <a class="nf-btn nf-btn--outline" href="{{ section.settings.faq_link }}">{{ section.settings.faq_button | escape }}</a>
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Naira contact page",
  "tag": "section",
  "class": "nf-contact-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
