          "default": "pin"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Visit Us"
        },
        {
          "type": "text",
          "id": "line_1",
          "label": "Line 1"
        },
        {
          "type": "text",
          "id": "line_2",
          "label": "Line 2"
        },
        {
          "type": "text",
          "id": "line_3",
          "label": "Line 3"
        }
