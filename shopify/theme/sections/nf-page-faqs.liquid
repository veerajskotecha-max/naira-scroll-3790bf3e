{%- comment -%}
  Naira Flore — FAQs
  Ported from src/pages/FAQs.tsx (Lovable repo).

  The source used the Radix/shadcn <Accordion> primitive (JS-driven, aria
  wiring, single-open). Rebuilt here with native <details>/<summary>: no
  JavaScript at all, keyboard operable and screen-reader announced for free,
  and the answers stay in the DOM so browser find-in-page and Google can read
  them. Grouping, anchor nav, copy and the FAQPage JSON-LD (faqLd in
  src/components/PageSEO.tsx) are all preserved.

  Blocks are flat: a "group" block opens a new titled group, "question"
  blocks fall under the most recent group.
{%- endcomment -%}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}
{{ 'nf-content.css' | asset_url | stylesheet_tag }}

<div class="nf-doc" style="--nf-doc-hero-bg: {{ section.settings.hero_background }};">
  <header class="nf-doc__hero">
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.lede != blank -%}
      <p class="nf-doc__lede">{{ section.settings.lede | escape }}</p>
    {%- endif -%}
  </header>

  {%- assign group_blocks = section.blocks | where: 'type', 'group' -%}
  {%- if section.settings.show_anchor_nav and group_blocks.size > 1 -%}
    <nav class="nf-doc__nav" aria-label="FAQ topics">
      {%- for block in group_blocks -%}
        <a href="#nf-faq-{{ block.id }}">{{ block.settings.title | escape }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <div class="nf-doc__body">
    <div class="nf-doc__inner">
      {%- assign open_group = false -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'group' -%}
            {%- if open_group -%}</section>{%- endif -%}
            <section class="nf-doc__section" id="nf-faq-{{ block.id }}" {{ block.shopify_attributes }}>
              <h2 style="margin-bottom: 20px;">{{ block.settings.title | escape }}</h2>
            {%- assign open_group = true -%}
          {%- when 'question' -%}
            {%- unless open_group -%}
              <section class="nf-doc__section">
              {%- assign open_group = true -%}
            {%- endunless -%}
            <details class="nf-faq__item" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.question | escape }}</span>
                <span class="nf-faq__caret" aria-hidden="true"></span>
              </summary>
              <div class="nf-faq__answer nf-rte">{{ block.settings.answer }}</div>
            </details>
        {%- endcase -%}
      {%- endfor -%}
      {%- if open_group -%}</section>{%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_help -%}
    <section class="nf-doc__foot">
      <div class="nf-doc__foot-inner">
        <h2>{{ section.settings.help_heading | escape }}</h2>
        {%- if section.settings.help_text != blank -%}
          <p>{{ section.settings.help_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.help_button_label != blank and section.settings.help_button_link != blank -%}
          <a class="nf-btn nf-btn--ink" href="{{ section.settings.help_button_link }}" target="_blank" rel="noopener noreferrer">
            {{ section.settings.help_button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}
</div>

{%- comment -%}
  FAQPage structured data — the Liquid equivalent of faqLd() in
  src/components/PageSEO.tsx.
{%- endcomment -%}
{%- assign question_blocks = section.blocks | where: 'type', 'question' -%}
{%- if section.settings.enable_schema_org and question_blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in question_blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip_newlines | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Naira FAQs",
  "tag": "section",
  "class": "nf-faqs-section",
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro line",
      "default": "Everything you need to know before placing your order"
    },
    {
      "type": "color",
      "id": "hero_background",
      "label": "Header background",
      "default": "#F4F1ED"
    },
    {
      "type": "checkbox",
      "id": "show_anchor_nav",
      "label": "Show jump-to navigation",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_schema_org",
      "label": "Output FAQPage structured data",
      "info": "Lets Google show these questions as rich results.",
      "default": true
    },
    {
      "type": "header",
      "content": "Need help footer"
    },
    {
      "type": "checkbox",
      "id": "show_help",
      "label": "Show the “Need Help?” footer",
      "default": true
    },
    {
      "type": "text",
      "id": "help_heading",
      "label": "Footer heading",
      "default": "Need Help?"
    },
    {
      "type": "textarea",
      "id": "help_text",
      "label": "Footer text",
      "default": "Can't find what you're looking for? Write to us on WhatsApp."
    },
    {
      "type": "text",
      "id": "help_button_label",
      "label": "Button label",
      "default": "Contact on WhatsApp"
    },
    {
      "type": "url",
      "id": "help_button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "group",
      "name": "Topic heading",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Topic",
          "default": "Orders & Customisation"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does the customisation process work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Write the answer here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Naira FAQs",
      "blocks": [
        {
          "type": "group"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
