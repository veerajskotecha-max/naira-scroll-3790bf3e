.nf-pdp__sizeguide-steps { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
.nf-pdp__sizeguide-steps li { display: flex; gap: 12px; }
.nf-pdp__sizeguide-num { flex-shrink: 0; margin-top: 2px; width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; border: 1px solid rgb(176 132 58 / .5); font-size: 10px; font-weight: 500; color: #8A6526; }
.nf-pdp__sizeguide-steps strong { display: block; font-size: 12.5px; font-weight: 500; color: hsl(0 0% 20%); }
.nf-pdp__sizeguide-steps span > span { display: block; margin-top: 2px; font-size: 12px; line-height: 1.7; color: hsl(0 0% 45%); }

/* -- Lightbox (native dialog) -- */
.nf-pdp__lightbox { border: 0; padding: 0; margin: 0; inset: 0; width: 100%; height: 100%; max-width: 100%; max-height: 100%; background-color: #FBF3EC; }
.nf-pdp__lightbox[open] { display: flex; flex-direction: column; }
.nf-pdp__lightbox::backdrop { background-color: #FBF3EC; }
.nf-pdp__lightbox-top { flex-shrink: 0; display: flex; align-items: flex-start; justify-content: space-between; padding: 16px 16px 0; }
@media (min-width: 768px) { .nf-pdp__lightbox-top { padding: 24px 32px 0; } }
.nf-pdp__lightbox-id { min-width: 0; padding-right: 16px; }
.nf-pdp__lightbox-tools { flex-shrink: 0; display: flex; align-items: center; gap: 8px; }
.nf-pdp__lightbox-name { margin: 0; padding-top: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--nf-font-label); font-size: 10px; text-transform: uppercase; letter-spacing: var(--nf-track-30); color: #9A7634; }
.nf-pdp__lightbox-btn { width: 44px; height: 44px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid rgb(26 22 20 / .15); background-color: rgb(251 243 236 / .9); color: #1A1614; cursor: pointer; transition: background-color .2s, color .2s; }
.nf-pdp__lightbox-btn:hover { background-color: #1A1614; color: #FBF3EC; }
.nf-pdp__lightbox-btn:focus-visible { outline: 2px solid var(--nf-gold-deep); outline-offset: 2px; }
.nf-pdp__lightbox-stage { flex: 1; min-height: 0; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 12px 16px 24px; }
@media (min-width: 768px) { .nf-pdp__lightbox-stage { padding: 12px 96px 40px; } }
/* ImageLightbox: click the photo to toggle a 2x zoom about the clicked point,
   500ms cubic-bezier(0.22, 1, 0.36, 1). */
.nf-pdp__lightbox-stage img { max-width: 100%; max-height: 100%; object-fit: contain; user-select: none; cursor: zoom-in; transform-origin: 50% 50%; transition: transform 500ms cubic-bezier(0.22, 1, 0.36, 1); }
.nf-pdp__lightbox-stage.is-zoomed img { transform: scale(2); cursor: zoom-out; }
.nf-pdp__lightbox[open] { animation: nf-pdp-fade-in 200ms cubic-bezier(0, 0, .2, 1); }
.nf-pdp__lightbox[open]::backdrop { animation: nf-pdp-fade-in 200ms cubic-bezier(0, 0, .2, 1); }
@keyframes nf-pdp-fade-in { from { opacity: 0; } to { opacity: 1; } }
.nf-pdp__lightbox-count { margin: 6px 0 0; font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-24); color: rgb(26 22 20 / .55); }
.nf-pdp__lightbox-prev, .nf-pdp__lightbox-next { position: absolute; top: 50%; transform: translateY(-50%); z-index: 10; }
.nf-pdp__lightbox-prev { left: 12px; }
.nf-pdp__lightbox-next { right: 12px; }
@media (min-width: 768px) { .nf-pdp__lightbox-prev { left: 24px; } .nf-pdp__lightbox-next { right: 24px; } }

