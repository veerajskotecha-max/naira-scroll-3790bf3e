/* -- Sticky mobile bar -- */
.nf-pdp__bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: flex; align-items: center; gap: 8px; padding: 8px 12px calc(8px + env(safe-area-inset-bottom, 0px)); background-color: hsla(0,0%,100%,.95); backdrop-filter: blur(6px); border-top: 1px solid hsl(0 0% 90%); box-shadow: 0 -6px 18px hsla(0,0%,0%,.06); transform: translateY(110%); visibility: hidden; pointer-events: none; transition: transform 300ms cubic-bezier(0, 0, .2, 1), visibility 300ms cubic-bezier(0, 0, .2, 1); }
