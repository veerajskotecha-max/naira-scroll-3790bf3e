.nf-pdp__related { padding-block: 4rem; background-color: #FBF3EC; }
@media (min-width: 768px) { .nf-pdp__related { padding-block: 5rem; } }
.nf-pdp__related-inner { max-width: 1400px; margin-inline: auto; padding-inline: 1rem; }
@media (min-width: 768px) { .nf-pdp__related-inner { padding-inline: 1.5rem; } }
.nf-pdp__related-title { margin: 0; font-family: var(--nf-font-display); font-size: 26px; text-align: center; color: #1A1614; }
@media (min-width: 768px) { .nf-pdp__related-title { font-size: 34px; } }
.nf-pdp__related-sub { margin: .5rem 0 0; text-align: center; font-family: var(--nf-font-label); font-size: 12px; letter-spacing: var(--nf-track-30); color: #B0843A; }
.nf-pdp__related-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-top: 2rem; }
@media (min-width: 768px) { .nf-pdp__related-grid { grid-template-columns: repeat(4, 1fr); gap: 1.5rem; } }
.nf-pdp__related-card { display: block; text-decoration: none; }
.nf-pdp__related-imgwrap { display: block; aspect-ratio: 1 / 1; overflow: hidden; background-color: var(--nf-ivory-deep); }
.nf-pdp__related-img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 700ms ease; }
.nf-pdp__related-card:hover .nf-pdp__related-img { transform: scale(1.05); }
.nf-pdp__related-cat { display: block; margin-top: .75rem; font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-30); color: #B0843A; }
.nf-pdp__related-name { display: block; margin-top: .25rem; font-family: var(--nf-font-display); font-size: 18px; color: #1A1614; }
@media (min-width: 768px) { .nf-pdp__related-name { font-size: 20px; } }
.nf-pdp__related-price { display: inline-flex; align-items: center; gap: .375rem; margin-top: .375rem; font-family: var(--nf-font-label); font-size: 10px; text-transform: uppercase; letter-spacing: var(--nf-track-18); color: #9A7634; }
.nf-pdp__related-dot { width: 5px; height: 5px; border-radius: 50%; background-color: #C99A4C; }
.nf-pdp__related-card:focus-visible { outline: 2px solid var(--nf-gold-deep); outline-offset: 2px; }

@media (prefers-reduced-motion: reduce) {
  .nf-pdp__img, .nf-pdp__related-img { transition: none; }
  .nf-pdp__dot::before { transition: none; }
  .nf-pdp__bar { transition: none; }
  .nf-pdp__acc-chev { transition: none; }
  .nf-pdp__add.is-added { animation: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "NF Product",
  "settings": [
    { "type": "text", "id": "in_stock_label", "label": "In stock label", "default": "In Stock" },
    { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold Out" },
    { "type": "text", "id": "whatsapp_url", "label": "Size chart / sizing-help WhatsApp link", "default": "https://www.whatsapp.com/catalog/919561557935/?app_absent=0", "info": "Shown as \"Sizing help\" next to non-ring sizes. Leave blank to hide. Rings always open the in-page size chart instead." },
    { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number (digits only, with country code)", "default": "919561557935" },
    { "type": "text", "id": "preorder_note", "label": "Fallback delivery note", "default": "Delivery in 3–5 working days.", "info": "Shown until the client-side delivery date computes, and to crawlers/automation." },
    { "type": "range", "id": "delivery_working_days", "label": "Working days to delivery", "min": 1, "max": 15, "step": 1, "default": 5 },
    { "type": "text", "id": "ring_sizes", "label": "Ring sizes (US, comma separated)", "default": "5,6,7" },
    { "type": "text", "id": "ring_preorder_sizes", "label": "Which ring sizes are pre-order", "default": "5,7" },
    { "type": "text", "id": "size_in_stock_note", "label": "In-stock size note (%s = size)", "default": "%s is in stock and ships now." },
    { "type": "text", "id": "size_preorder_note", "label": "Pre-order size note (%s = size)", "default": "%s is a pre-order — 45 days delivery." },
    { "type": "text", "id": "adjustable_ring_handles", "label": "Adjustable-ring product handles (comma separated)", "default": "rose-verdant-band,granule-dome-ring,verdant-eternity-band,halo-curve-ring,silver-dome-ring,petite-pave-band", "info": "Open-back styles: US 6 is labelled adjustable and fits US 6-8." },
    { "type": "text", "id": "adjustable_fit_note", "label": "Adjustable-ring fit note", "default": "Open-back design — adjustable to fit US 6 to 8 comfortably." },
    { "type": "richtext", "id": "care_text", "label": "Care tab content", "default": "<p><strong>Care guide</strong>: store in the pouch provided, away from moisture. Avoid contact with perfume, lotion and chlorinated water. Wipe gently with the polishing cloth; re-plating available.</p>" },
    { "type": "richtext", "id": "delivery_timelines_text", "label": "\"Delivery Timelines\" accordion content", "default": "<p>• Delivery in 3-5 working days.</p><p>• Flat ₹150 shipping across India, insured in transit.</p><p>• Enter your pincode above for a dated delivery estimate.</p>" },
    { "type": "richtext", "id": "disclaimer_text", "label": "\"Disclaimer\" accordion content", "default": "<p>• Each piece carries gentle variation, part of its character.</p><p>• Stone tone may vary slightly from screen colours.</p>" },
    { "type": "richtext", "id": "additional_info_text", "label": "\"Additional Information\" accordion content", "default": "<p>• WhatsApp / WhatsApp Call: <strong>+91 9561557935</strong></p><p>• Manufactured and marketed by Naira Flore</p><p>• Address: Flat 7, Veeraj Blossom, Karanyogi Nagar, Maharashtra – 422002</p>" }
  ],
  "presets": [{ "name": "NF Product" }]
}
{% endschema %}
