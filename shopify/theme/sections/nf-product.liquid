/* -- From the collection: the 3D ring (circular-gallery.tsx). Every measured
   dimension is set by the script from viewport width, exactly as React does;
   only the fixed styling lives here. -- */
.nf-ring { padding-block: 56px; background-color: #FBF7F2; }
@media (min-width: 768px) { .nf-ring { padding-block: 80px; } }
.nf-ring__head { text-align: center; padding-inline: 16px; }
.nf-ring__eyebrow { margin: 0; font-size: 10px; text-transform: uppercase; letter-spacing: var(--nf-track-30); color: #B0843A; }
.nf-ring__title { margin: 8px 0 0; font-family: var(--nf-font-display); font-size: 26px; font-weight: 400; line-height: 1.5; letter-spacing: normal; color: #1A1614; }
@media (min-width: 768px) { .nf-ring__title { font-size: 34px; } }
.nf-ring__sub { margin: 6px 0 0; font-size: 11px; letter-spacing: .14em; color: hsl(0 0% 48%); }
.nf-ring__viewport { position: relative; width: 100%; overflow: hidden; margin-top: 24px; }
@media (min-width: 768px) { .nf-ring__viewport { margin-top: 32px; } }
.nf-ring__stage { position: relative; width: 100%; margin-inline: auto; }
.nf-ring__spin { position: absolute; left: 50%; top: 50%; width: 0; height: 0; transform-style: preserve-3d; }
.nf-ring__card { position: absolute; display: block; text-decoration: none; backface-visibility: hidden; -webkit-backface-visibility: hidden; transition: opacity 200ms linear; }
.nf-ring__frame { display: block; overflow: hidden; background-color: var(--nf-ivory-deep); }
.nf-ring__img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
.nf-ring__text { display: block; overflow: hidden; padding-top: 8px; text-align: center; }
.nf-ring__name { display: block; font-family: var(--nf-font-display); line-height: 1.25; color: #1A1614; }
.nf-ring__cat { display: block; margin-top: 4px; text-transform: uppercase; line-height: 1; letter-spacing: .22em; color: #9A7634; }

/* Late, on purpose. The 768px gallery block sits above the base rules for the
   zoom badge and the dot rail, so its `display: none` lost the cascade to them
   on equal specificity and both kept showing on desktop, where JewelDetail.tsx
   renders neither (they belong to its isMobile branch only). */
@media (min-width: 768px) {
  .nf-pdp__counter, .nf-pdp__zoomhint, .nf-pdp__dots { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .nf-pdp__img, .nf-pdp__related-img { transition: none; }
  .nf-ring__card { transition: none; }
  .nf-pdp__dot::before { transition: none; }
  .nf-pdp__bar { transition: none; }
  .nf-pdp__acc-chev { transition: none; }
  .nf-pdp__lightbox-stage img { transition: none; }
  .nf-pdp__lightbox[open], .nf-pdp__lightbox[open]::backdrop { animation: none; }
  .nf-pdp__add.is-added { animation: none; }
}

/* == Customer reviews == src/components/CustomerReviews.tsx.
   Every rule here is scoped to .nf-reviews / nf-reviews__ so it cannot reach
   the rest of the PDP. Colours are the shadcn tokens the React page resolves
   to (--foreground 222.2 84% 4.9%, --muted-foreground 215.4 16.3% 46.9%,
   --border 214.3 31.8% 91.4%, --secondary 210 40% 96.1%, --primary and
   --secondary-foreground 222.2 47.4% 11.2%), plus the section's own teal
   186 35% 28% and Tailwind's yellow-500 #eab308 for the stars.
   The unprefixed text inherits nf-base.css's ui-sans-serif body stack and
   line-height 1.5, which is exactly what Tailwind's preflight gives React;
   only the .font-cormorant elements are pulled onto the display face. */
.nf-reviews {
  max-width: 1200px;
  margin-inline: auto;
  padding: 0 16px 80px;
  scroll-margin-top: 120px;
}
/* Star sprite: one <symbol>, 220-odd <use> instances. Kept out of flow rather
   than display:none so the references resolve in every engine. */
.nf-reviews__sprite { position: absolute; width: 0; height: 0; overflow: hidden; }

/* letter-spacing/line-height are restated because base.css gives every heading
   Sense's tracking and a 1.25 leading; React's h2/h3 inherit Tailwind preflight's
   normal tracking and 1.5. */
.nf-reviews__title { font-family: var(--nf-font-display); font-size: 28px; font-weight: 600; line-height: 1.5; letter-spacing: normal; color: hsl(222.2 84% 4.9%); margin: 0; }
@media (min-width: 768px) { .nf-reviews__title { font-size: 32px; } }

.nf-reviews__stars { display: flex; gap: 2px; }
.nf-reviews__star { display: block; width: 12px; height: 12px; overflow: hidden; fill: #eab308; stroke: #eab308; }
.nf-reviews__star--off { fill: none; stroke: hsl(214.3 31.8% 91.4%); }
.nf-reviews__stars--lg .nf-reviews__star { width: 18px; height: 18px; }

.nf-reviews__head { margin-top: 24px; display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 32px; }
@media (min-width: 1024px) { .nf-reviews__head { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; } }

.nf-reviews__summary { display: flex; flex-direction: column; gap: 24px; }
@media (min-width: 640px) { .nf-reviews__summary { flex-direction: row; gap: 40px; } }
.nf-reviews__overall { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
.nf-reviews__score { font-family: var(--nf-font-display); font-size: 36px; font-weight: 700; color: hsl(222.2 84% 4.9%); margin: 0; }
.nf-reviews__based { font-family: var(--nf-font-display); font-size: 13px; color: hsl(215.4 16.3% 46.9%); margin: 0; }

/* Baymard: the distribution is the most-used part of a reviews block and 90%
   of shoppers try to click the bars, so each row is the filter for its rating. */
.nf-reviews__bars { flex: 1 1 0%; max-width: 320px; display: flex; flex-direction: column; gap: 10px; }
.nf-reviews__bar { display: flex; width: 100%; align-items: center; gap: 12px; padding: 4px 0; text-align: left; background: none; border: 0; cursor: pointer; font-family: inherit; font-size: 100%; font-weight: inherit; line-height: inherit; color: inherit; transition: opacity 150ms; }
.nf-reviews__bar:disabled { cursor: default; opacity: .45; }
.nf-reviews__bar:not(:disabled):hover { opacity: .8; }
.nf-reviews__bar-label { font-size: 13px; width: 32px; flex-shrink: 0; font-weight: 500; color: hsl(215.4 16.3% 46.9%); }
.nf-reviews__bar-track { position: relative; width: 100%; height: 10px; flex: 1 1 0%; overflow: hidden; background-color: hsl(210 40% 96.1%); }
.nf-reviews__bar-fill { display: block; height: 100%; background-color: hsl(222.2 47.4% 11.2%); transition: width 200ms; }
.nf-reviews__bar-count { font-size: 12px; width: 32px; text-align: right; color: hsl(215.4 16.3% 46.9%); }
.nf-reviews__bar.is-review-active .nf-reviews__bar-label,
.nf-reviews__bar.is-review-active .nf-reviews__bar-count { color: hsl(186 35% 28%); }

.nf-reviews__gallery { display: flex; flex-direction: column; gap: 20px; }
.nf-reviews__subtitle { display: flex; align-items: center; gap: 8px; font-family: var(--nf-font-display); font-size: 18px; font-weight: 600; line-height: 1.5; letter-spacing: normal; color: hsl(222.2 84% 4.9%); margin: 0; }
.nf-reviews__camera { width: 16px; height: 16px; flex-shrink: 0; }
.nf-reviews__strip { display: flex; gap: 12px; overflow-x: auto; padding-bottom: 8px; }
.nf-reviews__thumb { flex-shrink: 0; width: 80px; height: 80px; padding: 0; border: 0; background: none; overflow: hidden; cursor: pointer; transition: transform 200ms, box-shadow 200ms; }
@media (min-width: 768px) { .nf-reviews__thumb { width: 90px; height: 90px; } }
.nf-reviews__thumb:hover { transform: scale(1.05); box-shadow: 0 4px 6px -1px hsla(0,0%,0%,.1), 0 2px 4px -2px hsla(0,0%,0%,.1); }
.nf-reviews__thumb-img { display: block; width: 100%; height: 100%; object-fit: cover; }

.nf-reviews__write,
.nf-reviews__morebtn { padding: 12px 32px; font-family: inherit; font-size: 13px; font-weight: 500; line-height: inherit; text-transform: uppercase; letter-spacing: .1em; color: hsl(222.2 84% 4.9%); background-color: transparent; cursor: pointer; transition: all 250ms ease-in-out; }
.nf-reviews__write { margin-top: 8px; align-self: flex-start; border: 1px solid hsl(222.2 84% 4.9%); }
.nf-reviews__morebtn { border: 2px solid hsl(222.2 84% 4.9%); }
.nf-reviews__write:hover,
.nf-reviews__morebtn:hover { background-color: hsl(222.2 84% 4.9%); color: hsl(0 0% 100%); box-shadow: 0 4px 6px -1px hsla(0,0%,0%,.1), 0 2px 4px -2px hsla(0,0%,0%,.1); transform: translateY(-1px); }

.nf-reviews__filters { margin-top: 32px; display: flex; flex-wrap: wrap; gap: 10px; }
.nf-reviews__chip { padding: 8px 16px; font-family: inherit; font-size: 13px; font-weight: 500; line-height: inherit; color: hsl(215.4 16.3% 46.9%); background-color: transparent; border: 1px solid hsl(214.3 31.8% 91.4%); cursor: pointer; transition: all 200ms; }
.nf-reviews__chip.is-review-active { color: hsl(0 0% 100%); background-color: hsl(186 35% 28%); border-color: hsl(186 35% 28%); }

.nf-reviews__grid { margin-top: 32px; display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 20px; transition: opacity 200ms; }
@media (min-width: 640px) { .nf-reviews__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (min-width: 1024px) { .nf-reviews__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
.nf-reviews__grid.is-review-fading { opacity: 0; }

.nf-reviews__card { padding: 20px; background-color: hsl(0 0% 100%); border: 1px solid hsl(214.3 31.8% 91.4%); transition: transform 300ms, box-shadow 300ms; }
.nf-reviews__card:hover { transform: translateY(-4px); box-shadow: 0 4px 6px -1px hsla(0,0%,0%,.1), 0 2px 4px -2px hsla(0,0%,0%,.1); }
.nf-reviews__card.is-review-hidden,
.nf-reviews__none.is-review-hidden,
.nf-reviews__more.is-review-hidden { display: none; }
.nf-reviews__card-head { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
/* Source order puts the number first but paints it last, hard right. */
.nf-reviews__no { order: 9999; margin-left: auto; font-size: 10px; letter-spacing: .08em; color: hsl(215.4 16.3% 46.9%); }
.nf-reviews__avatar { position: relative; display: flex; flex-shrink: 0; width: 36px; height: 36px; overflow: hidden; }
.nf-reviews__initials { display: flex; width: 100%; height: 100%; align-items: center; justify-content: center; font-size: 12px; font-weight: 500; background-color: hsl(210 40% 96.1%); color: hsl(222.2 47.4% 11.2%); }
/* 16px is only a strut: both children below set their own size, but the
   "Verified Buyer" span is inline, so its line box takes the block's
   line-height. React inherits Tailwind's 16px/1.5 body here and the theme
   inherits 15px, which cost 1.5px on every review card. */
.nf-reviews__who { font-size: 16px; }
.nf-reviews__name { font-family: var(--nf-font-display); font-size: 14px; font-weight: 600; color: hsl(222.2 84% 4.9%); margin: 0; }
.nf-reviews__verified { font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: .08em; color: hsl(186 35% 28%); }
.nf-reviews__meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.nf-reviews__date { font-size: 11px; color: hsl(215.4 16.3% 46.9%); }
.nf-reviews__text { font-family: var(--nf-font-display); font-size: 13px; line-height: 1.625; color: hsl(215.4 16.3% 46.9%); margin: 0; }
.nf-reviews__shots { display: flex; gap: 8px; margin-top: 12px; }
.nf-reviews__shot { display: block; width: 48px; height: 48px; object-fit: cover; }

.nf-reviews__none { grid-column: 1 / -1; padding: 40px 0; text-align: center; font-family: var(--nf-font-display); font-size: 14px; color: hsl(215.4 16.3% 46.9%); margin: 0; }
.nf-reviews__more { margin-top: 40px; display: flex; justify-content: center; }

.nf-reviews__lightbox { position: fixed; width: calc(100% - 32px); max-width: 512px; padding: 8px; border: 0; background-color: hsl(0 0% 100%); }
.nf-reviews__lightbox::backdrop { background-color: hsla(0, 0%, 0%, .8); }
.nf-reviews__lightbox-img { display: block; width: 100%; height: auto; }
.nf-reviews__lightbox-close { position: absolute; top: 16px; right: 16px; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; padding: 0; border: 0; background-color: hsla(0, 0%, 100%, .85); color: hsl(0 0% 20%); cursor: pointer; }
.nf-reviews__x { width: 16px; height: 16px; }

{% endstylesheet %}

