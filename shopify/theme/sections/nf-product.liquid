        <button type="submit" form="NfPdpForm" data-nf-buy-now data-nf-add-button class="nf-pdp__buy press-scale" {% if sold_out %}disabled{% endif %}>{% if sold_out %}Sold Out{% else %}Shop Now{% endif %}</button>

        <p class="nf-pdp__trust">
          {%- if sold_out -%}
            This piece is currently sold out &mdash; we'll let you know the moment it's back.
          {%- else -%}
            {%- comment -%}
              60% of Baymard's subjects looked for the returns policy on the
              product page itself; 44% of sites neither show nor link it there.
            {%- endcomment -%}
            Secure payments &middot; Insured delivery &middot;
            <a href="/policies/refund-policy">7-day returns</a>
          {%- endif -%}
        </p>

        <div class="nf-pdp__pair">
          <button type="button" class="nf-pdp__ghost press-scale" data-nf-wishlist aria-pressed="false">
            {%- render 'nf-icon-heart', size: 14 -%} <span data-nf-wishlist-label>Wishlist</span>
          </button>
          <a class="nf-pdp__ghost" href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ wa_msg | url_encode }}" target="_blank" rel="noopener noreferrer">
            <svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>

      {%- comment -%} -- Product reel: renders nothing unless the product has a
        video media or a custom.reel_url metafield. Sits under the buy actions,
        above the Details/Care tabs. -- {%- endcomment -%}
      {%- render 'nf-product-reel', product: product, block: block -%}

      {%- comment -%} -- Delivery -- {%- endcomment -%}
      <div class="nf-pdp__delivery">
        <svg class="nf-icon nf-pdp__truck" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
        <p><strong data-nf-arrives>{{ section.settings.preorder_note }}</strong>
           Dispatched insured from our Mumbai atelier, with easy 7-day returns.</p>
      </div>

      {%- comment -%} -- Offers -- {%- endcomment -%}
      <div class="nf-pdp__offers">
        <p class="nf-pdp__offers-head">AVAILABLE OFFERS</p>
        <ul>
          <li><span aria-hidden="true" class="nf-pdp__bullet">&#10022;</span><span><strong class="nf-pdp__code">NAIRA10</strong>10% off your first order</span></li>
          <li><span aria-hidden="true" class="nf-pdp__bullet">&#10022;</span><span>Flat &#8377;150 insured shipping &mdash; anywhere in India, any order size</span></li>
          <li><span aria-hidden="true" class="nf-pdp__bullet">&#10022;</span><span>2-year plating assurance on all demi-fine pieces</span></li>
        </ul>
      </div>

      {%- if is_jewellery -%}
        {%- comment -%}
          Key facts. Finish/Stone are read out of the product's tags (the
          closest live-Shopify stand-in for JewelDetail.tsx's curated
          materials string); Fit only applies to rings.
        {%- endcomment -%}
        {%- liquid
          assign tags_lc = product.tags | join: ',' | downcase
          assign has_gold = false
          assign has_rhodium = false
          assign has_pearl = false
          assign has_zircone = false
          if tags_lc contains '18k gold' or tags_lc contains 'gold tone'
            assign has_gold = true
          endif
          if tags_lc contains 'rhodium'
            assign has_rhodium = true
          endif
          if tags_lc contains 'pearl'
            assign has_pearl = true
          endif
          if tags_lc contains 'zircon'
            assign has_zircone = true
          endif
          assign finish_value = 'Demi-gold'
          if has_gold and has_rhodium
            assign finish_value = '18k gold & rhodium'
          elsif has_gold
            assign finish_value = '18k gold'
          elsif has_rhodium
            assign finish_value = 'Rhodium'
          endif
          assign stone_value = 'Polished metal'
          if has_pearl and has_zircone
            assign stone_value = 'Pearl & zircone'
          elsif has_pearl
            assign stone_value = 'Freshwater pearl'
          elsif has_zircone
            assign stone_value = 'Brilliant-cut zircone'
          endif
        -%}
        <dl class="nf-pdp__facts" aria-label="Key facts">
          <div class="nf-pdp__fact"><dt>Finish</dt><dd>{{ finish_value }}</dd></div>
          <div class="nf-pdp__fact"><dt>Stone</dt><dd>{{ stone_value }}</dd></div>
          {%- if is_ring -%}
            <div class="nf-pdp__fact"><dt>Fit</dt><dd>{% if is_adjustable %}Adjustable &middot; US 6&ndash;8{% else %}Fixed size{% endif %}</dd></div>
          {%- else -%}
            <div class="nf-pdp__fact"><dt>Category</dt><dd>{{ cat }}</dd></div>
          {%- endif -%}
        </dl>
      {%- endif -%}

      {%- comment -%} -- Availability -- {%- endcomment -%}
      <p class="nf-pdp__stock{% if sold_out %} is-out{% endif %}" data-nf-stock>
        {% if sold_out %}{{ section.settings.sold_out_label }}{% else %}{{ section.settings.in_stock_label }}{% endif %}
      </p>

      {%- comment -%} -- Trust badges -- {%- endcomment -%}
      <div class="nf-pdp__trustbadges">
        {%- if is_jewellery -%}
          <div class="nf-pdp__trustbadge">
            <svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/></svg>
            <span>Anti-Tarnish Sealed</span>
          </div>
          <div class="nf-pdp__trustbadge">
            <svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            <span>18k Demi-Gold</span>
          </div>
        {%- else -%}
          <div class="nf-pdp__trustbadge">
            <svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg>
            <span>Handcrafted</span>
          </div>
          <div class="nf-pdp__trustbadge">
            <svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            <span>Quality Assured</span>
          </div>
        {%- endif -%}
        <div class="nf-pdp__trustbadge">
          <svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M14 8H8"/><path d="M16 12H8"/><path d="M13 16H8"/></svg>
          <span>Secure Payments</span>
        </div>
      </div>

      {%- comment -%} -- Pincode / delivery checker --
        Identical in JewelDetail.tsx and ProductDetails.tsx, so it renders
        for every product regardless of category. {%- endcomment -%}
      <div class="nf-pdp__pincode" data-nf-pincode>
        <div class="nf-pdp__pincode-head">
          <svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="nf-pdp__label">Delivery</span>
        </div>
        <div class="nf-pdp__pincode-row">
          <label class="nf-sr-only" for="nf-pincode-{{ uid }}">Pincode</label>
          <input type="text" inputmode="numeric" maxlength="6" placeholder="Enter pincode" id="nf-pincode-{{ uid }}" class="nf-pdp__pincode-input" data-nf-pincode-input>
          <button type="button" class="nf-pdp__pincode-btn" data-nf-pincode-check>Check</button>
        </div>
        <div class="nf-pdp__pincode-result" data-nf-pincode-result hidden aria-live="polite"></div>
      </div>

      {%- if is_jewellery -%}
        {%- comment -%} -- Jewellery assurances (4-chip strip) -- {%- endcomment -%}
        <ul class="nf-pdp__strip" aria-label="Naira Flore jewellery assurances">
          <li><svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg><span>Anti-tarnish coating</span></li>
          <li><svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"/><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"/></svg><span>Waterproof sealed</span></li>
          <li><svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/></svg><span>18k gold / rhodium finish</span></li>
          <li><svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73Z"/><path d="M12 22V12"/><path d="M3.29 7 12 12l8.71-5"/><path d="m7.5 4.27 9 5.15"/></svg><span>Limited batches only</span></li>
        </ul>
      {%- endif -%}

      {%- comment -%} -- Policy links -- {%- endcomment -%}
      <div class="nf-pdp__policylinks">
        <a href="/policies/refund-policy">Exchange &amp; Return Policy</a>
        <span aria-hidden="true">|</span>
        <a href="/pages/faqs">FAQs</a>
      </div>

      <div class="nf-pdp__rule"></div>

      {%- comment -%} -- Details / Care tabs -- {%- endcomment -%}
      <div class="nf-pdp__tabs">
        <div class="nf-pdp__tabbar" role="tablist">
          <button type="button" class="nf-pdp__tabbtn is-active" role="tab" aria-selected="true" id="nf-tab-details-{{ uid }}" aria-controls="nf-panel-details-{{ uid }}" data-nf-tab="details">Details</button>
          <button type="button" class="nf-pdp__tabbtn" role="tab" aria-selected="false" id="nf-tab-care-{{ uid }}" aria-controls="nf-panel-care-{{ uid }}" data-nf-tab="care">Care</button>
        </div>
        {%- comment -%}
          JewelDetail.tsx does not dump the raw listing copy into the Details
          tab: it renders a blurb, then a definition list of Length / Stone /
          Setting / ... specs, then the styling tip, then the materials line,
          and keeps the care copy for the Care tab. The bundled catalogue holds
          those as separate fields; the live listing holds the same content as
          one description, so it is split back apart here. The Shopify copy is
          written to a fixed shape -- lead paragraph, a "STYLING TIP:"
          paragraph, a "Details" heading over a spec list, a "Care" heading over
          its paragraph -- and anything that does not match simply falls through
          to the raw description, which is what this used to render for
          everything.
        {%- endcomment -%}
        {%- liquid
          assign desc = product.description
          assign desc_paras = desc | split: '</p>'
          assign desc_blurb = ''
          assign desc_tip = ''
          assign desc_care = ''
          assign desc_specs = ''
          assign has_specs = false
          assign has_care_head = false

          if desc_paras.size > 0
            assign desc_blurb = desc_paras[0] | strip_html | strip
          endif

          for chunk in desc_paras
            assign is_tip = false
            if chunk contains 'STYLING TIP'
              assign is_tip = true
            endif
            if is_tip
              assign desc_tip = chunk | strip_html | remove_first: 'STYLING TIP:' | strip
            endif
          endfor

          assign ul_parts = desc | split: '<ul>'
          if ul_parts.size > 1
            assign has_specs = true
            assign desc_specs = ul_parts[1] | split: '</ul>' | first
          endif

          if desc contains '<strong>Care</strong>'
            assign has_care_head = true
          endif
          if has_care_head
            assign care_rest = desc | split: '<strong>Care</strong>' | last | split: '</p>'
            if care_rest.size > 1
              assign desc_care = care_rest[1] | strip_html | strip
            endif
          endif
        -%}
        <div class="nf-pdp__tabpanel" id="nf-panel-details-{{ uid }}" role="tabpanel" aria-labelledby="nf-tab-details-{{ uid }}" data-nf-tabpanel="details">
          {%- if has_specs -%}
            <div class="nf-pdp__detailstack">
              {%- if desc_blurb != blank -%}<p class="nf-pdp__blurb">{{ desc_blurb }}</p>{%- endif -%}
              <dl class="nf-pdp__specs">
                {%- assign spec_items = desc_specs | split: '<li>' -%}
                {%- for raw_spec in spec_items -%}
                  {%- assign spec = raw_spec | split: '</li>' | first | strip_html | strip -%}
                  {%- if spec != blank -%}
                    {%- assign spec_head = spec | split: ':' | first -%}
                    {%- assign has_label = false -%}
                    {%- if spec_head != spec -%}{%- assign has_label = true -%}{%- endif -%}
                    {%- if has_label -%}
                      {%- assign spec_label = spec_head | strip -%}
                      {%- assign spec_value = spec | remove_first: spec_head | remove_first: ':' | strip -%}
                      {%- assign spec_label_lc = spec_label | downcase -%}
                      {%- if spec_label_lc == 'plating' -%}{%- assign plating_value = spec_value -%}{%- endif -%}
                      {%- if spec_label_lc == 'material' -%}{%- assign material_value = spec_value -%}{%- endif -%}
                      <div class="nf-pdp__spec"><dt>{{ spec_label }}</dt><dd>{{ spec_value }}</dd></div>
                    {%- else -%}
                      <dd class="nf-pdp__spec-loose">{{ spec }}</dd>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </dl>
              {%- if desc_tip != blank -%}
                <p class="nf-pdp__tip"><span class="nf-pdp__tip-label">Styling tip</span>{{ desc_tip }}</p>
              {%- endif -%}
              {%- liquid
                # The bundled catalogue carries a curated one-line materials
                # string; Shopify has no field for it, so it is rebuilt from the
                # product's own Plating / stone / Material words rather than
                # invented. A `custom.materials` metafield still wins.
                if materials_value == blank
                  assign derived_materials = ''
                  if plating_value != blank
                    assign derived_materials = plating_value
                  endif
                  if stone_value != blank
                    assign stone_lc = stone_value | downcase
                    if derived_materials != blank
                      assign derived_materials = derived_materials | append: ' · '
                    endif
                    assign derived_materials = derived_materials | append: stone_lc
