{%- comment -%} -- Customer reviews -- ported from src/components/CustomerReviews.tsx
  (variant="jewellery"), which JewelDetail.tsx renders between the product grid
  and "You may also like".

  DATA. React's set is a bundled fixture, not a review app: a 260-entry numbered
  bank in src/data/productReviews.ts sliced per product, plus nine photo reviews
  and thirty one-line notes in CustomerReviews.tsx. snippets/nf-review-data.liquid
  carries the same rows verbatim (regenerate with shopify/harness/reviewfixture.mjs).
  Shopify's own product-review metafields are deliberately NOT used -- they hold
  different reviews, so the page would not match.

  The slice is chosen by getProductReviews()'s hash, reimplemented above the
  buy box (the rv_* block, hoisted there so the title badge can use it): it is
  h = (h * 31 + charCode) >>> 0 over the lowercased product title, so the Liquid
  side needs character codes. Liquid has no charCodeAt, hence the three lookup
  tables -- lowercase letters, digits, and a punctuation/accent pair of lists.
  A character outside all three falls back to "?" (63); no title in the
  catalogue contains one. The modulo after every step is the >>> 0.

  The nine UGC photos have no bytes in the repo -- src/assets/jewellery/ugc holds
  only .asset.json pointers to a host that is not reachable here -- so they are
  referenced as theme assets by name and will 404 until the files are uploaded,
  exactly as they currently do on the React side.
{%- endcomment -%}
{%- if rv_rows.size > 0 -%}

  <svg class="nf-reviews__sprite" aria-hidden="true" focusable="false" width="0" height="0"><symbol id="nf-review-star" viewBox="0 0 24 24"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></symbol></svg>

  <section id="customer-reviews" class="nf-reviews" data-nf-reviews>
    <h2 class="nf-reviews__title">Customer Reviews</h2>

    <div class="nf-reviews__head">
      <div class="nf-reviews__summary">
        <div class="nf-reviews__overall">
          <div class="nf-reviews__stars nf-reviews__stars--lg" role="img" aria-label="Rated {{ rv_score }} out of 5">
            {%- for i in (1..5) -%}<svg class="nf-reviews__star" aria-hidden="true" focusable="false"><use href="#nf-review-star"/></svg>{%- endfor -%}
          </div>
          <p class="nf-reviews__score">{{ rv_score }}</p>
          <p class="nf-reviews__based">Based on {{ rv_total }} reviews</p>
        </div>

        {%- comment -%} The bars are the filter, as in the source: clicking one
          narrows the list, clicking the active one clears back to all. {%- endcomment -%}
        <div class="nf-reviews__bars">
          {%- for rv_s in rv_stars_desc -%}
            {%- assign rv_bn = rv_counts[forloop.index0] | plus: 0 -%}
            {%- assign rv_bw = rv_bn | times: 100 | divided_by: rv_maxf -%}
            <button type="button" class="nf-reviews__bar" data-nf-review-bar="{{ rv_s }}&#9733;"
                    {% if rv_bn == 0 %}disabled{% endif %} aria-pressed="false"
                    aria-label="{{ rv_bn }} {{ rv_s }}-star review{% if rv_bn != 1 %}s{% endif %}">
              <span class="nf-reviews__bar-label">{{ rv_s }} &#9733;</span>
              <span class="nf-reviews__bar-track"><span class="nf-reviews__bar-fill" style="width: {{ rv_bw }}%;"></span></span>
              <span class="nf-reviews__bar-count">{{ rv_bn }}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="nf-reviews__gallery">
        <h3 class="nf-reviews__subtitle">
          <svg class="nf-reviews__camera" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          Customer Photos
        </h3>
        <div class="nf-reviews__strip">
          {%- for rv_ph in rv_strip -%}
            <button type="button" class="nf-reviews__thumb" data-nf-review-photo="{{ rv_ph | prepend: 'nf-' | asset_url }}" aria-label="Open customer photo {{ forloop.index }}">
              <img class="nf-reviews__thumb-img" src="{{ rv_ph | prepend: 'nf-' | asset_url }}" alt="Customer photo {{ forloop.index }}" loading="lazy" width="90" height="90">
            </button>
          {%- endfor -%}
        </div>
        <button type="button" class="nf-reviews__write" data-nf-review-write>Write a Review</button>
      </div>
    </div>

    <div class="nf-reviews__filters">
      {%- assign rv_filters = 'All Reviews,With Photos,5&#9733;,4&#9733;,3&#9733;,2&#9733;,1&#9733;' | split: ',' -%}
      {%- for rv_f in rv_filters -%}
        <button type="button" class="nf-reviews__chip{% if forloop.first %} is-review-active{% endif %}" data-nf-review-filter="{{ rv_f }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ rv_f }}</button>
      {%- endfor -%}
    </div>

    <div class="nf-reviews__grid" data-nf-review-grid>
      {%- for rv_row in rv_rows -%}
        {%- liquid
          assign rv_f = rv_row | split: '|'
          assign rv_no = rv_f[0]
          assign rv_rating = rv_f[4] | plus: 0
          assign rv_ph = rv_f[7]
          assign rv_badge = rv_no
          if rv_badge == blank
            assign rv_badge = forloop.index
          endif
        -%}
        <div class="nf-reviews__card{% if forloop.index > 8 %} is-review-hidden{% endif %}" data-nf-review
             data-no="{{ rv_no }}" data-rating="{{ rv_rating }}" data-photos="{% if rv_ph != blank %}1{% else %}0{% endif %}">
          <div class="nf-reviews__card-head">
            <span class="nf-reviews__no" data-nf-review-no>#{{ rv_badge }}</span>
            <span class="nf-reviews__avatar"><span class="nf-reviews__initials">{{ rv_f[2] }}</span></span>
            <div class="nf-reviews__who">
              <p class="nf-reviews__name">{{ rv_f[1] }}</p>
              {%- if rv_f[3] == '1' -%}<span class="nf-reviews__verified">Verified Buyer</span>{%- endif -%}
            </div>
          </div>
          <div class="nf-reviews__meta">
            <div class="nf-reviews__stars" role="img" aria-label="Rated {{ rv_rating }} out of 5">
              {%- for i in (1..5) -%}<svg class="nf-reviews__star{% if i > rv_rating %} nf-reviews__star--off{% endif %}" aria-hidden="true" focusable="false"><use href="#nf-review-star"/></svg>{%- endfor -%}
            </div>
            <span class="nf-reviews__date">{{ rv_f[5] }}</span>
          </div>
          <p class="nf-reviews__text">"{{ rv_f[6] }}"</p>
          {%- if rv_ph != blank -%}
            <div class="nf-reviews__shots"><img class="nf-reviews__shot" src="{{ rv_ph | prepend: 'nf-' | asset_url }}" alt="Review photo" loading="lazy" width="48" height="48"></div>
          {%- endif -%}
        </div>
      {%- endfor -%}
      <p class="nf-reviews__none is-review-hidden" data-nf-review-empty>No reviews match this filter.</p>
    </div>

    <div class="nf-reviews__more{% if rv_total <= 8 %} is-review-hidden{% endif %}" data-nf-review-morewrap>
      <button type="button" class="nf-reviews__morebtn" data-nf-review-more>Load More Reviews</button>
    </div>

    <dialog class="nf-reviews__lightbox" data-nf-review-lightbox aria-label="Customer photo">
      <button type="button" class="nf-reviews__lightbox-close" data-nf-review-lightbox-close aria-label="Close photo">
        <svg class="nf-reviews__x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <img class="nf-reviews__lightbox-img" data-nf-review-lightbox-img src="" alt="Customer photo">
    </dialog>
  </section>
{%- endif -%}


{%- comment -%} -- Customer reviews behaviour -- mirrors the useState logic in
  CustomerReviews.tsx: the chip row fades the grid for 200ms before swapping the
  filter and resetting the page size to 8; the histogram bars set the filter
  straight away and toggle back to "All Reviews" when the active one is clicked
  again; "Load More" adds 8. Every review is in the DOM and the ones past the
  page size are display:none, which is what React's slice() amounts to.
  The #n badge is the review's own number when it has one and otherwise its
  position in the *filtered* list, so it is recomputed on every render, exactly
  as `review.no ?? i + 1` does. {%- endcomment -%}
<script>
(function () {
  var root = document.querySelector('[data-nf-reviews]');
  if (!root) return;
  var grid  = root.querySelector('[data-nf-review-grid]');
  var cards = Array.prototype.slice.call(root.querySelectorAll('[data-nf-review]'));
  var chips = Array.prototype.slice.call(root.querySelectorAll('[data-nf-review-filter]'));
  var bars  = Array.prototype.slice.call(root.querySelectorAll('[data-nf-review-bar]'));
  var empty = root.querySelector('[data-nf-review-empty]');
  var more  = root.querySelector('[data-nf-review-morewrap]');
  var PAGE = 8;
  var active = 'All Reviews';
  var visible = PAGE;

  function matches(card) {
    if (active === 'All Reviews') return true;
    if (active === 'With Photos') return card.getAttribute('data-photos') === '1';
    return card.getAttribute('data-rating') === active.charAt(0);
  }

  function render() {
    var matched = 0;
    cards.forEach(function (card) {
      if (!matches(card)) { card.classList.add('is-review-hidden'); return; }
      matched += 1;
      if (matched > visible) { card.classList.add('is-review-hidden'); return; }
      card.classList.remove('is-review-hidden');
      var badge = card.querySelector('[data-nf-review-no]');
      if (badge) badge.textContent = '#' + (card.getAttribute('data-no') || matched);
    });
    chips.forEach(function (c) {
      var on = c.getAttribute('data-nf-review-filter') === active;
      c.classList.toggle('is-review-active', on);
      c.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    bars.forEach(function (b) {
      var on = b.getAttribute('data-nf-review-bar') === active;
      b.classList.toggle('is-review-active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    if (empty) empty.classList.toggle('is-review-hidden', matched > 0);
    if (more) more.classList.toggle('is-review-hidden', visible >= matched);
  }

  chips.forEach(function (c) {
    c.addEventListener('click', function () {
      if (grid) grid.classList.add('is-review-fading');
      setTimeout(function () {
        active = c.getAttribute('data-nf-review-filter');
        visible = PAGE;
        render();
        if (grid) grid.classList.remove('is-review-fading');
      }, 200);
    });
  });

  bars.forEach(function (b) {
    b.addEventListener('click', function () {
      var label = b.getAttribute('data-nf-review-bar');
      active = active === label ? 'All Reviews' : label;
      render();
    });
  });

  var moreBtn = root.querySelector('[data-nf-review-more]');
  if (moreBtn) moreBtn.addEventListener('click', function () {
    visible += PAGE;
    render();
  });

  /* Photo strip -> lightbox, the Dialog the source opens on a thumbnail. */
  var box = root.querySelector('[data-nf-review-lightbox]');
  var boxImg = root.querySelector('[data-nf-review-lightbox-img]');
  if (box && boxImg && typeof box.showModal === 'function') {
    root.querySelectorAll('[data-nf-review-photo]').forEach(function (t) {
      t.addEventListener('click', function () {
        boxImg.src = t.getAttribute('data-nf-review-photo');
        box.showModal();
      });
    });
    box.addEventListener('click', function (e) { if (e.target === box) box.close(); });
    var close = root.querySelector('[data-nf-review-lightbox-close]');
    if (close) close.addEventListener('click', function () { box.close(); });
  }

  render();
}());
</script>

{%- comment -%} -- You may also like -- inline in JewelDetail.tsx (not a separate
  section), so it is ported here. Same-collection pieces lead; "all
  products" backfills when the product is not in any collection. {%- endcomment -%}
{%- if related_pool != blank -%}
  {%- liquid
    assign related_sub = 'From The Demi-Gold Atelier' | upcase
    if is_jewellery
      assign related_sub = 'More ' | append: cat | append: ' From The Atelier' | upcase
    endif
  -%}
  <section class="nf-pdp__related" aria-label="You may also like">
    <div class="nf-pdp__related-inner">
      <h2 class="nf-pdp__related-title">You may also like</h2>
      <p class="nf-pdp__related-sub">{{ related_sub }}</p>
      <div class="nf-pdp__related-grid">
        {%- assign related_shown = 0 -%}
        {%- assign related_seen = '' -%}
        {%- comment -%} Pass 1: same product type. Pass 2: the rest. {%- endcomment -%}
        {%- for pass in (1..2) -%}
        {%- for rp in related_pool -%}
          {%- if related_shown >= 4 -%}{%- break -%}{%- endif -%}
          {%- capture rp_cat -%}{%- render 'nf-jewel-category', p: rp -%}{%- endcapture -%}
          {%- assign same_type = false -%}
          {%- if rp_cat == cat -%}{%- assign same_type = true -%}{%- endif -%}
          {%- assign wanted = false -%}
          {%- if pass == 1 and same_type -%}{%- assign wanted = true -%}{%- endif -%}
          {%- if pass == 2 and same_type == false -%}{%- assign wanted = true -%}{%- endif -%}
          {%- if wanted -%}
          {%- if rp.handle != product.handle -%}
            {%- assign related_shown = related_shown | plus: 1 -%}
            <a href="{{ rp.url }}" class="nf-pdp__related-card">
              <span class="nf-pdp__related-imgwrap">
                <img class="nf-pdp__related-img"
                     src="{{ rp.featured_image | image_url: width: 600 }}"
                     srcset="{{ rp.featured_image | image_url: width: 300 }} 300w, {{ rp.featured_image | image_url: width: 450 }} 450w, {{ rp.featured_image | image_url: width: 600 }} 600w"
                     sizes="(min-width: 768px) 22vw, 45vw"
                     alt="{{ rp.title | escape }}" loading="lazy" decoding="async">
              </span>
              <span class="nf-pdp__related-cat">{{ rp_cat | default: rp.type | upcase }}</span>
              <span class="nf-pdp__related-name">{{ rp.title }}</span>
              <span class="nf-pdp__related-price"><span aria-hidden="true" class="nf-pdp__related-dot"></span>{{ rp.price | money }}</span>
            </a>
          {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} -- From the collection -- ported from src/components/CollectionCarousel.tsx
  + src/components/ui/circular-gallery.tsx, which JewelDetail.tsx renders under
  "You may also like".

  A ring of cards in 3D, turned by page scroll with a slow idle drift. React
  drives it from a requestAnimationFrame loop writing rotateY on the ring and a
  per-card opacity; the same loop is reproduced below rather than approximated
  with a CSS animation, because the scroll term has no CSS equivalent. Card
  size, ring radius, stage height, perspective and tilt are the same formulas
  React computes from viewport width (the 640px phone break is
  circular-gallery's own, not the page's).

  React shuffles its ten pieces per render; a Liquid page is cached, so the
  order here is catalogue order instead -- same cards, stable sequence.

  RecentlyViewed, which follows this in JewelDetail.tsx, renders nothing until
  a shopper has two pieces in their localStorage history, so there is nothing
  to port for a first view.
{%- endcomment -%}
{%- liquid
  # Two passes: count the eligible pieces first so the ten shown can be spread
  # evenly across the catalogue. React shuffles, which lands a mix of rings,
  # earrings and necklaces on the ring; taking the first ten in catalogue order
  # would have put ten necklaces on a necklace page.
  assign ring_pool = collections['all'].products
  assign ring_total = 0
  for rc in ring_pool
    if rc.handle == product.handle
      continue
    endif
    capture rc_cat
      render 'nf-jewel-category', p: rc
    endcapture
    if rc_cat == blank
      continue
    endif
    assign ring_total = ring_total | plus: 1
  endfor
  # floor, not bare divided_by: the local engine returns 4.6 where Shopify
  # returns 4, and a fractional stride never hits modulo 0 again.
  assign ring_stride = ring_total | divided_by: 10.0 | floor
  if ring_stride < 1
    assign ring_stride = 1
  endif
  assign ring_count = ring_total
  if ring_count > 10
    assign ring_count = 10
  endif
-%}
{%- if ring_count > 2 -%}
  <section class="nf-ring" aria-label="From the collection" data-nf-ring>
    <div class="nf-ring__head">
      <p class="nf-ring__eyebrow">Naira Petite</p>
      <h2 class="nf-ring__title">From the collection</h2>
      <p class="nf-ring__sub">Scroll to turn the carousel</p>
    </div>
    <div class="nf-ring__viewport">
      <div class="nf-ring__stage" data-nf-ring-stage>
        <div class="nf-ring__spin" data-nf-ring-spin>
          {%- assign ring_i = 0 -%}
          {%- assign ring_seen = 0 -%}
          {%- for rc in ring_pool -%}
            {%- if ring_i >= 10 -%}{%- break -%}{%- endif -%}
            {%- if rc.handle == product.handle -%}{%- continue -%}{%- endif -%}
            {%- capture rc_cat -%}{%- render 'nf-jewel-category', p: rc -%}{%- endcapture -%}
            {%- if rc_cat == blank -%}{%- continue -%}{%- endif -%}
            {%- assign ring_mod = ring_seen | modulo: ring_stride -%}
            {%- assign ring_seen = ring_seen | plus: 1 -%}
            {%- if ring_mod != 0 -%}{%- continue -%}{%- endif -%}
            <a class="nf-ring__card" href="{{ rc.url }}" data-nf-ring-card data-i="{{ ring_i }}">
              <span class="nf-ring__frame">
                <img class="nf-ring__img"
                     src="{{ rc.featured_image | image_url: width: 440 }}"
                     srcset="{{ rc.featured_image | image_url: width: 220 }} 220w, {{ rc.featured_image | image_url: width: 440 }} 440w"
                     sizes="220px"
                     alt="{{ rc.title | escape }}, {{ rc_cat | downcase }} by Naira Flore" loading="lazy" decoding="async" draggable="false">
              </span>
              <span class="nf-ring__text">
                <span class="nf-ring__name">{{ rc.title }}</span>
                <span class="nf-ring__cat">{{ rc_cat }}</span>
              </span>
            </a>
            {%- assign ring_i = ring_i | plus: 1 -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>

  <script>
  (function () {
    var root = document.querySelector('[data-nf-ring]');
    if (!root) return;
    var stage = root.querySelector('[data-nf-ring-stage]');
    var spin = root.querySelector('[data-nf-ring-spin]');
    var cards = Array.prototype.slice.call(root.querySelectorAll('[data-nf-ring-card]'));
    if (!stage || !spin || !cards.length) return;

    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var AUTO = 0.03;            /* degrees added per frame while idle */
    var anglePer = 360 / cards.length;
    var scrollOffset = 0, drift = 0, scrolling = false, scrollTimer = 0;

    /* circular-gallery.tsx: every dimension is derived from viewport width. */
    var geo = {};
    function measure() {
      var vw = window.innerWidth;
      var phone = vw < 640;
      var cardW = Math.round(Math.max(120, Math.min(phone ? vw * 0.34 : vw * 0.16, 220)));
      var cardH = Math.round(cardW * (4 / 3));
      var textBlock = phone ? 58 : 64;
      var autoRadius = Math.round((cards.length * cardW * 1.12) / (2 * Math.PI));
      geo = {
        phone: phone, cardW: cardW, cardH: cardH, textBlock: textBlock,
        radius: Math.max(phone ? 190 : 300, Math.min(autoRadius, 480)),
        stageH: cardH + textBlock + (phone ? 90 : 140)
      };
      stage.style.height = geo.stageH + 'px';
      stage.style.perspective = (geo.phone ? 900 : 1300) + 'px';
      cards.forEach(function (c, i) {
        c.style.width = geo.cardW + 'px';
        c.style.marginLeft = (-geo.cardW / 2) + 'px';
        c.style.marginTop = (-(geo.cardH + geo.textBlock) / 2) + 'px';
        c.style.transform = 'rotateY(' + (i * anglePer) + 'deg) translateZ(' + geo.radius + 'px)';
        var frame = c.querySelector('.nf-ring__frame');
        if (frame) { frame.style.height = geo.cardH + 'px'; frame.style.width = geo.cardW + 'px'; }
        var text = c.querySelector('.nf-ring__text');
        if (text) text.style.height = geo.textBlock + 'px';
        var name = c.querySelector('.nf-ring__name');
        if (name) name.style.fontSize = (geo.phone ? 14 : 17) + 'px';
        var cat = c.querySelector('.nf-ring__cat');
        if (cat) cat.style.fontSize = (geo.phone ? 8 : 9) + 'px';
      });
    }

    function onScroll() {
      var rect = root.getBoundingClientRect();
      var progress = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
      scrollOffset = Math.max(-0.2, Math.min(1.2, progress)) * 360;
      scrolling = true;
      window.clearTimeout(scrollTimer);
      scrollTimer = window.setTimeout(function () { scrolling = false; }, 150);
    }

    function paint() {
      var rotation = scrollOffset + drift;
      spin.style.transform = 'translate(-50%, -50%) rotateX(' + (geo.phone ? -4 : -6) + 'deg) rotateY(' + rotation + 'deg)';
      var mod = ((rotation % 360) + 360) % 360;
      cards.forEach(function (c, i) {
        var rel = (i * anglePer + mod) % 360;
        var norm = rel > 180 ? 360 - rel : rel;
        c.style.opacity = String(Math.max(0.18, 1 - norm / 130));
      });
    }

    function tick() {
      if (!reduced && !scrolling) drift += AUTO;
      paint();
      window.requestAnimationFrame(tick);
    }

    measure();
    onScroll();
    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', function () { measure(); onScroll(); paint(); });
    window.requestAnimationFrame(tick);
  })();
  </script>
{%- endif -%}

<script>
(function () {
  var root = document.querySelector('[data-nf-pdp]');
  if (!root) return;

  /* ---- back button: history if there is somewhere to go back to, else the listing ---- */
  root.querySelectorAll('[data-nf-back]').forEach(function (b) {
    b.addEventListener('click', function () {
      if (window.history.length > 1) window.history.back();
      else window.location.href = {{ routes.all_products_collection_url | json }};
    });
  });

  /* ---- size selection (rings: line-item property) ---- */
  var sizeInput = root.querySelector('[data-nf-size-input]');
  var helpEl = root.querySelector('[data-nf-size-help]');
  var IN_STOCK = {{ section.settings.size_in_stock_note | json }};
  var PREORDER = {{ section.settings.size_preorder_note | json }};
  var ADJUSTABLE_NOTE = {{ section.settings.adjustable_fit_note | json }};
  root.querySelectorAll('[data-nf-size]').forEach(function (b) {
    b.addEventListener('click', function () {
      root.querySelectorAll('[data-nf-size]').forEach(function (o) {
        o.classList.remove('is-active'); o.setAttribute('aria-checked', 'false');
      });
      b.classList.add('is-active'); b.setAttribute('aria-checked', 'true');
      if (sizeInput) sizeInput.value = b.getAttribute('data-nf-size');
      if (helpEl) {
        var text = b.hasAttribute('data-preorder')
          ? PREORDER.replace('%s', b.getAttribute('data-nf-size'))
          : IN_STOCK.replace('%s', b.getAttribute('data-nf-size'));
        if (b.hasAttribute('data-nf-adjustable')) text += ' ' + ADJUSTABLE_NOTE;
        helpEl.textContent = text;
      }
      updateSizeGuideHighlight();
    });
  });

  /* ---- size selection (non-ring products with a real Shopify Size option) ----
     Price/compare-at are deliberately not swapped -- see the Liquid comment
     above the markup for why. Availability still gates checkout correctly. */
  var variantInput = root.querySelector('[data-nf-variant-input]');
  root.querySelectorAll('[data-nf-variant-btn]').forEach(function (b) {
    b.addEventListener('click', function () {
      root.querySelectorAll('[data-nf-variant-btn]').forEach(function (o) {
        o.classList.remove('is-active'); o.setAttribute('aria-checked', 'false');
      });
      b.classList.add('is-active'); b.setAttribute('aria-checked', 'true');
      var id = b.getAttribute('data-nf-variant-id');
      var avail = b.getAttribute('data-nf-variant-available') !== 'false';
      var blocked = !avail || !id;
      if (variantInput && id) variantInput.value = id;
      root.querySelectorAll('[data-nf-add-button]').forEach(function (btn) {
        btn.disabled = blocked;
        /* The inline CTAs carry their label as the button's own text (React
           does, and a wrapper span makes the text node's background
           transparent where React's is the button fill); the sticky bar
           still wraps it, so write to the span when there is one. */
        var label = btn.querySelector('[data-nf-buy-label]') || btn;
        label.textContent = blocked ? 'Sold Out' : (btn.hasAttribute('data-nf-buy-now') ? 'Shop Now' : 'Add to Cart');
      });
    });
  });

  /* ---- quantity ---- */
  var qtyVal = root.querySelector('[data-nf-qty-val]');
  var qtyInput = root.querySelector('[data-nf-qty-input]');
  root.querySelectorAll('[data-nf-qty]').forEach(function (b) {
    b.addEventListener('click', function () {
      var n = Math.max(1, parseInt(qtyVal.textContent, 10) + parseInt(b.getAttribute('data-nf-qty'), 10));
      qtyVal.textContent = n; if (qtyInput) qtyInput.value = n;
    });
  });

  /* ---- buy-now busy label ----
     nf-cart.js owns the actual submit/redirect (data-nf-buy-now + the form=
     attribute is its whole contract); this only swaps the label so the
     button does not sit inert while /checkout is loading. */
  var form = document.getElementById('NfPdpForm');
  if (form) {
    form.addEventListener('submit', function (e) {
      var btn = e.submitter;
      if (!btn || !btn.hasAttribute('data-nf-buy-now')) return;
      var label = btn.querySelector('[data-nf-buy-label]') || btn;
      label.textContent = 'Opening checkout...';
    });
  }

  /* ---- arrival date ----
     Baymard: 41% of sites quote a shipping speed instead of a date. Computed
     here, not in Liquid, because a build-time date goes stale overnight --
     and skipped for automation (navigator.webdriver), same as
     JewelDetail.tsx: a prerendered or crawled copy of this page must not
     bake in a date that has already passed by the time someone reads it. */
  var arrives = root.querySelector('[data-nf-arrives]');
  if (arrives && !(window.navigator && window.navigator.webdriver)) {
    var d = new Date(), added = 0;
    while (added < {{ section.settings.delivery_working_days }}) {
      d.setDate(d.getDate() + 1);
      var wd = d.getDay();
      if (wd !== 0 && wd !== 6) added++;
    }
    arrives.textContent = 'Order today, arrives by ' +
      d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' }) + '.';
  }

  /* ---- pincode checker (ported from src/lib/serviceability.ts) ---- */
  (function () {
    var box = root.querySelector('[data-nf-pincode]');
    if (!box) return;
    var input = box.querySelector('[data-nf-pincode-input]');
    var btn = box.querySelector('[data-nf-pincode-check]');
    var out = box.querySelector('[data-nf-pincode-result]');
    var CHECK_ICON = '<svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>';
    var ALERT_ICON = '<svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
    var INFO_ICON = '<svg class="nf-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>';
    var BLOCKED_RANGES = [
      [180, 194], [800, 855], [814, 835], [781, 799], [744, 744], [682, 682], [273, 277], [202, 205], [121, 122]
    ];
    var BLOCKED_PINCODES = ['122103', '122107', '121102', '247001', '854105', '845401'];
    function isMaharashtra(pin) {
      var two = Number(pin.slice(0, 2)), three = pin.slice(0, 3);
      if (three === '403') return false;
      return two >= 40 && two <= 44;
    }
    function addWorkingDays(days) {
      var d = new Date(), added = 0;
      while (added < days) { d.setDate(d.getDate() + 1); var wd = d.getDay(); if (wd !== 0 && wd !== 6) added++; }
      return d;
    }
    function fmt(d) { return d.toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' }); }
    function run(pin) {
      if (!/^[1-9]\d{5}$/.test(pin)) {
        out.hidden = false;
        out.innerHTML = '<div class="nf-pdp__pincode-error">' + ALERT_ICON + '<span>Enter a valid 6-digit pincode.</span></div>';
        return;
      }
      var mh = isMaharashtra(pin), days = mh ? 3 : 5, three = Number(pin.slice(0, 3));
      var blocked = BLOCKED_PINCODES.indexOf(pin) !== -1;
      if (!blocked) {
        for (var i = 0; i < BLOCKED_RANGES.length; i++) {
          if (three >= BLOCKED_RANGES[i][0] && three <= BLOCKED_RANGES[i][1]) { blocked = true; break; }
        }
      }
      var eta = fmt(addWorkingDays(days));
      var html = '<div class="nf-pdp__pincode-ok">' + CHECK_ICON + '<span>Delivery to <strong>' + pin + '</strong> in <strong>' + days + ' working days</strong> &middot; by <strong>' + eta + '</strong></span></div>';
      html += blocked
        ? '<div class="nf-pdp__pincode-note">' + INFO_ICON + '<p>Cash on Delivery is unavailable for this pincode. Prepaid only &middot; UPI, cards, wallets and net banking accepted.</p></div>'
        : '<p class="nf-pdp__pincode-cod">Cash on Delivery available &middot; UPI, cards, wallets and net banking accepted</p>';
      out.hidden = false;
      out.innerHTML = html;
      try { window.localStorage.setItem('naira-pincode', pin); } catch (e) {}
    }
    if (input) input.addEventListener('input', function () { input.value = input.value.replace(/\D/g, ''); });
    if (btn) btn.addEventListener('click', function () { run(input.value); });
    if (input) input.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); run(input.value); } });
    try {
      var saved = window.localStorage.getItem('naira-pincode');
      if (saved && /^[1-9]\d{5}$/.test(saved) && input) { input.value = saved; run(saved); }
    } catch (e) {}
  })();

  /* ---- wishlist: kept in sync across every instance on the page (gallery
     overlay, CTA row, sticky bar) ---- */
  (function () {
    var wishBtns = root.querySelectorAll('[data-nf-wishlist]');
    if (!wishBtns.length) return;
    function setState(on) {
      wishBtns.forEach(function (w) {
        w.setAttribute('aria-pressed', on ? 'true' : 'false');
        w.classList.toggle('is-on', on);
        var lbl = w.querySelector('[data-nf-wishlist-label]');
        if (lbl) lbl.textContent = on ? 'Saved' : 'Wishlist';
        w.setAttribute('aria-label', on ? 'Remove from wishlist' : 'Add to wishlist');
      });
    }
    wishBtns.forEach(function (w) {
      w.addEventListener('click', function () {
        var wasOn = w.getAttribute('aria-pressed') === 'true';
        setState(!wasOn);
        if (!wasOn) {
          wishBtns.forEach(function (o) {
            var icon = o.querySelector('.nf-icon');
            if (!icon) return;
            icon.classList.add('heart-pop');
            icon.addEventListener('animationend', function handler() {
              icon.classList.remove('heart-pop');
              icon.removeEventListener('animationend', handler);
            });
          });
        }
      });
    });
  })();

  /* ---- share: native share sheet, clipboard fallback ---- */
  var shareBtn = root.querySelector('[data-nf-share]');
  if (shareBtn) {
    shareBtn.addEventListener('click', function () {
      var url = window.location.href;
      var title = {{ product.title | json }};
      if (navigator.share) {
        navigator.share({ title: title, text: 'Check out ' + title + ' on Naira Flore', url: url }).catch(function () {});
        return;
      }
      if (navigator.clipboard) {
        navigator.clipboard.writeText(url).then(function () {
          shareBtn.classList.add('is-copied');
          window.setTimeout(function () { shareBtn.classList.remove('is-copied'); }, 1800);
        }).catch(function () {});
      }
    });
  }

  /* ---- gallery: dots + counter track the rail on mobile/tablet ---- */
  var rail = root.querySelector('[data-nf-rail]');
  var idx = root.querySelector('[data-nf-idx]');
  var dots = root.querySelectorAll('[data-nf-dot]');
  function setActiveSlide(i) {
    if (idx) {
      var label = '\u00B7 ' + (i + 1) + '/' + (idx.getAttribute('data-nf-total') || 1);
      if (idx.textContent !== label) idx.textContent = label;
    }
    dots.forEach(function (d) { d.classList.toggle('is-active', Number(d.getAttribute('data-index')) === i); });
  }
  if (rail) {
    rail.addEventListener('scroll', function () {
      var i = Math.round(rail.scrollLeft / (rail.clientWidth || 1));
      setActiveSlide(i);
    }, { passive: true });
  }
  dots.forEach(function (d) {
    d.addEventListener('click', function () {
      var i = Number(d.getAttribute('data-index'));
      if (rail) rail.scrollTo({ left: i * rail.offsetWidth, behavior: 'smooth' });
      setActiveSlide(i);
    });
  });

  /* ---- accordion: Radix animates the panel height (0.34s open, 0.26s closed,
     cubic-bezier(0.22, 1, 0.36, 1)); a bare <details> snaps. The open attribute
     is held on until the collapse finishes, and the trigger's open styling runs
     off a class so the chevron turns back at the start of the collapse, as it
     does in React. ---- */
  (function () {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    root.querySelectorAll('.nf-pdp__acc').forEach(function (d) {
      var sum = d.querySelector('summary');
      var body = d.querySelector('.nf-pdp__acc-body');
      if (!sum || !body) return;
      var anim = null;
      if (d.open) d.classList.add('is-open');
      sum.addEventListener('click', function (e) {
        if (reduced || typeof body.animate !== 'function') return;
        e.preventDefault();
        if (anim) { anim.cancel(); anim = null; }
        var opening = !d.open;
        if (opening) d.open = true;
        d.classList.toggle('is-open', opening);
        d.classList.toggle('is-closing', !opening);
        var full = body.scrollHeight;
        anim = body.animate(
          [{ height: (opening ? 0 : full) + 'px' }, { height: (opening ? full : 0) + 'px' }],
          { duration: opening ? 340 : 260, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
        );
        anim.onfinish = function () {
          anim = null;
          d.classList.remove('is-closing');
          if (!opening) d.open = false;
        };
      });
    });
  })();

  /* ---- details / care tabs ---- */
  var tabBtns = root.querySelectorAll('[data-nf-tab]');
  var tabPanels = root.querySelectorAll('[data-nf-tabpanel]');
  tabBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      tabBtns.forEach(function (o) { o.classList.remove('is-active'); o.setAttribute('aria-selected', 'false'); });
      tabPanels.forEach(function (p) { p.hidden = true; });
      b.classList.add('is-active'); b.setAttribute('aria-selected', 'true');
      var target = root.querySelector('[data-nf-tabpanel="' + b.getAttribute('data-nf-tab') + '"]');
      if (target) target.hidden = false;
    });
  });

  /* ---- ring size guide: native <dialog> gives Escape / focus trap / backdrop
     click-through for free; only open/close and the highlighted row are wired
     here. ---- */
  var sizeGuide = root.querySelector('[data-nf-sizeguide]');
  var sizeGuideOpenBtn = root.querySelector('[data-nf-sizeguide-open]');
  function updateSizeGuideHighlight() {
    if (!sizeGuide) return;
    var active = root.querySelector('[data-nf-size].is-active');
    var num = active ? active.getAttribute('data-nf-size-num') : null;
    sizeGuide.querySelectorAll('[data-nf-sizeguide-row]').forEach(function (row) {
      row.classList.toggle('is-active', num !== null && row.getAttribute('data-us') === num);
    });
  }
  if (sizeGuide && sizeGuideOpenBtn && sizeGuide.showModal) {
    sizeGuideOpenBtn.addEventListener('click', function () {
      updateSizeGuideHighlight();
      sizeGuide.showModal();
    });
    sizeGuide.querySelectorAll('[data-nf-dialog-close]').forEach(function (b) {
      b.addEventListener('click', function () { sizeGuide.close(); });
    });
    sizeGuide.addEventListener('click', function (e) { if (e.target === sizeGuide) sizeGuide.close(); });
  }

  /* ---- lightbox: same native-<dialog> approach ---- */
  (function () {
    var lb = root.querySelector('[data-nf-lightbox]');
    if (!lb || !lb.showModal) return;
    var img = lb.querySelector('[data-nf-lightbox-img]');
    var stage = lb.querySelector('[data-nf-lightbox-stage]');
    var count = lb.querySelector('[data-nf-lightbox-count]');
    var zoomBtn = lb.querySelector('[data-nf-lightbox-zoom]');
    var zoomIn = lb.querySelector('[data-nf-zoom-in]');
    var zoomOut = lb.querySelector('[data-nf-zoom-out]');
    var slides = Array.prototype.slice.call(root.querySelectorAll('[data-nf-lightbox-open] img'));
    var current = 0;
    function setZoom(on, origin) {
      if (!stage) return;
      img.style.transformOrigin = origin || '50% 50%';
      stage.classList.toggle('is-zoomed', on);
      if (zoomBtn) {
        zoomBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
        zoomBtn.setAttribute('aria-label', on ? 'Zoom out' : 'Zoom in to 2x');
      }
      if (zoomIn) zoomIn.hidden = on;
      if (zoomOut) zoomOut.hidden = !on;
    }
    function zoomed() { return !!stage && stage.classList.contains('is-zoomed'); }
    function show(i) {
      if (!slides.length) return;
      current = (i + slides.length) % slides.length;
      var src = slides[current].currentSrc || slides[current].src;
      img.src = src;
      img.alt = slides[current].alt || '';
      setZoom(false);
      if (count) count.textContent = (current + 1) + ' / ' + slides.length;
    }
    if (zoomBtn) zoomBtn.addEventListener('click', function () { setZoom(!zoomed()); });
    img.addEventListener('click', function (e) {
      var r = img.getBoundingClientRect();
      var x = Math.min(100, Math.max(0, ((e.clientX - r.left) / r.width) * 100));
      var y = Math.min(100, Math.max(0, ((e.clientY - r.top) / r.height) * 100));
      setZoom(!zoomed(), x.toFixed(1) + '% ' + y.toFixed(1) + '%');
    });
    root.querySelectorAll('[data-nf-lightbox-open]').forEach(function (b) {
      b.addEventListener('click', function () {
        show(Number(b.getAttribute('data-index')) || 0);
        lb.showModal();
      });
    });
    lb.querySelectorAll('[data-nf-dialog-close]').forEach(function (b) { b.addEventListener('click', function () { lb.close(); }); });
    lb.addEventListener('click', function (e) { if (e.target === lb) lb.close(); });
    var prev = lb.querySelector('[data-nf-lightbox-prev]');
    var next = lb.querySelector('[data-nf-lightbox-next]');
    if (prev) prev.addEventListener('click', function () { show(current - 1); });
    if (next) next.addEventListener('click', function () { show(current + 1); });
    lb.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') show(current + 1);
      else if (e.key === 'ArrowLeft') show(current - 1);
    });
  })();

  /* ---- sticky bar ----
     Not a plain IntersectionObserver: the bar must stay hidden whenever the
     price is still on screen (it sits right above the CTA block, so a
     rootMargin-based observer on #product-actions alone would let the bar
     cover a price the shopper has not seen yet). This mirrors
     JewelDetail.tsx's checkStickyBar effect: show once the CTA block is
     fully off screen (above OR below the viewport) AND the price has
     scrolled clear of where the bar would sit. */
  var bar = root.querySelector('[data-nf-bar]');
  var actions = root.querySelector('#product-actions');
  var priceEl = root.querySelector('#product-price');
  if (bar && actions) {
    var checkStickyBar = function () {
      var r = actions.getBoundingClientRect();
      var offScreen = r.bottom < 0 || r.top > window.innerHeight;
      var barHeight = bar.offsetHeight || 72;
      var priceClear = !priceEl || priceEl.getBoundingClientRect().bottom < window.innerHeight - barHeight;
      var visible = offScreen && priceClear;
      bar.classList.toggle('is-on', visible);
      bar.setAttribute('aria-hidden', visible ? 'false' : 'true');
    };
    checkStickyBar();
    window.addEventListener('scroll', checkStickyBar, { passive: true });
    window.addEventListener('resize', checkStickyBar);
    if ('ResizeObserver' in window) new ResizeObserver(checkStickyBar).observe(document.body);
  }
})();
</script>

{% stylesheet %}
.nf-pdp { max-width: 1400px; margin-inline: auto; padding-bottom: 96px; position: relative; }
.nf-pdp button, .nf-pdp input, .nf-pdp select, .nf-pdp textarea { font-family: inherit; line-height: 1.5; }
.nf-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

/* 4px, not 16: JewelDetail.tsx clears its FIXED header with pt-[112px] at md
   and lg:pt-[120px], measured from the top of the page. The theme header is
   in flow (108px at md, 116px at lg), so the crumb only owes the remainder --
   4px at both widths. Measured, not assumed: if the header's height changes,
   re-measure `Home`'s y against React's before trusting this number. */
.nf-pdp__crumb { display: none; align-items: center; justify-content: space-between; gap: 16px; padding: 4px 24px 12px; font-size: 11px; letter-spacing: var(--nf-track-4); color: hsl(0 0% 55%); }
.nf-pdp__crumb-trail { display: flex; align-items: center; gap: 8px; }
.nf-pdp__crumb a { color: inherit; text-decoration: none; }
.nf-pdp__crumb a:hover { color: var(--nf-ink); }
.nf-pdp__crumb [aria-current] { color: hsl(0 0% 30%); }
.nf-pdp__back { display: inline-flex; align-items: center; gap: 6px; border: 0; background: none; padding: 8px; margin: -8px; font-size: 11px; text-transform: uppercase; letter-spacing: .14em; color: hsl(0 0% 45%); cursor: pointer; }
.nf-pdp__back:hover { color: var(--nf-ink); }
@media (min-width: 768px) { .nf-pdp__crumb { display: flex; } }

.nf-pdp__layout { display: flex; flex-direction: column; gap: 0; }
@media (min-width: 1024px) { .nf-pdp__layout { display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: start; padding-inline: 24px; } }

.nf-pdp__gallery { position: relative; }
.nf-pdp__rail { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
.nf-pdp__rail::-webkit-scrollbar { display: none; }
.nf-pdp__slide { flex: 0 0 100%; scroll-snap-align: center; margin: 0; aspect-ratio: 1 / 1; overflow: hidden; background-color: var(--nf-ivory-deep); cursor: zoom-in; border: 0; padding: 0; display: block; }
.nf-pdp__slide:focus-visible { outline: 2px solid var(--nf-gold-deep); outline-offset: -2px; }

/* Desktop/tablet shows every photo once, in a grid -- as JewelDetail.tsx does
   -- rather than a horizontal rail: a rail overflowed the viewport at 2358px
   wide at a 1440 viewport, because each slide is flex-basis 100% of the
   container. This switches at the same 768px width the React gallery's own
   isMobile check does, which is a different breakpoint than the two-column
   page layout above (1024px) -- intentionally, matching the source. */
@media (min-width: 768px) {
  .nf-pdp__rail { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 4px; overflow: visible; scroll-snap-type: none; }
  .nf-pdp__slide { flex: none; aspect-ratio: 4 / 5; min-height: 0; cursor: zoom-in; }
  .nf-pdp__slide:first-child:nth-last-child(odd) { grid-column: span 2; }
  /* One photo: a single full-bleed frame (grid-cols-1 grid-rows-1). */
  .nf-pdp__rail--1 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
  /* Exactly two photos: JewelDetail.tsx stacks them (grid-cols-1 grid-rows-2)
     instead of sitting them side by side. */
  .nf-pdp__rail--2 { grid-template-columns: 1fr; }
  .nf-pdp__counter, .nf-pdp__zoomhint, .nf-pdp__dots { display: none; }
}

/* No fixed frame ratio on desktop. JewelDetail.tsx's photo grid is
   `grid-rows-2 h-full min-h-full` inside an `lg:items-start` cell -- every
   height in that chain is a percentage of an indefinite height, so it all
   collapses to auto and the two 1fr rows end up sized by the largest photo's
   own aspect ratio at the column width, both rows equal. A hard 4/5 frame
   cropped the hero and halved the second row; stretching the rail to the buy
   column's height (the other obvious reading) overshot it by ~330px. */
@media (min-width: 768px) {
  .nf-pdp__slide { aspect-ratio: auto; }
}
/* JewelDetail.tsx: `transition-transform duration-700 ease-out hover:scale-[1.03]`.
   Tailwind's ease-out is cubic-bezier(0,0,.2,1), not the atelier reveal curve. */
.nf-pdp__img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 700ms cubic-bezier(0, 0, .2, 1); }
@media (min-width: 768px) { .nf-pdp__slide:hover .nf-pdp__img { transform: scale(1.03); } }

.nf-pdp__wish, .nf-pdp__share { position: absolute; z-index: 10; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: 0; cursor: pointer; color: hsl(0 0% 40%); }
.nf-pdp__wish { top: 16px; right: 16px; background-color: hsla(0,0%,100%,.85); }
.nf-pdp__wish .nf-icon { width: 17px; height: 17px; }
.nf-pdp__wish.is-on { color: hsl(0 70% 55%); }
.nf-pdp__wish.is-on .nf-icon { fill: hsl(0 70% 55%); }
.nf-pdp__share { bottom: 64px; right: 16px; border-radius: 50%; background-color: hsla(0,0%,100%,.92); box-shadow: 0 1px 4px hsla(0,0%,0%,.08); color: hsl(0 0% 30%); }
.nf-pdp__share .nf-icon { width: 15px; height: 15px; }
.nf-pdp__share-copied { position: absolute; bottom: 120%; right: 0; white-space: nowrap; padding: 5px 10px; font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: var(--nf-track-4); color: #fff; background-color: hsl(0 0% 12%); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 150ms ease, visibility 150ms ease; }
.nf-pdp__share.is-copied .nf-pdp__share-copied { opacity: 1; visibility: visible; }
.nf-pdp__wish:focus-visible, .nf-pdp__share:focus-visible { outline: 2px solid var(--nf-gold-deep); outline-offset: 2px; }

.nf-pdp__zoomhint { position: absolute; left: 16px; bottom: 12px; z-index: 10; display: inline-flex; align-items: center; gap: 6px; margin: 0; padding: 6px 10px; font-size: 10px; text-transform: uppercase; letter-spacing: .12em; color: hsl(0 0% 35%); background-color: hsla(0,0%,100%,.88); }
.nf-pdp__zoomhint .nf-icon { width: 12px; height: 12px; }
.nf-pdp__zoomhint-count { color: hsl(0 0% 55%); font-variant-numeric: tabular-nums; }
.nf-pdp__dots { display: flex; justify-content: center; gap: 4px; margin: 4px 0 2px; }
.nf-pdp__dot { width: 32px; height: 28px; border: 0; background: none; padding: 0; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.nf-pdp__dot::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background-color: hsl(0 0% 75%); transition: transform 200ms cubic-bezier(0, 0, .2, 1), background-color 200ms cubic-bezier(0, 0, .2, 1); }
.nf-pdp__dot.is-active::before { background-color: hsl(0 0% 20%); transform: scale(1.4); }
.nf-pdp__mback { display: flex; position: absolute; top: 12px; left: 16px; z-index: 10; width: 44px; height: 44px; align-items: center; justify-content: center; border: 0; border-radius: 50%; background-color: hsla(0,0%,100%,.92); box-shadow: 0 2px 6px hsla(0,0%,0%,.12); color: hsl(0 0% 20%); cursor: pointer; }
@media (min-width: 768px) { .nf-pdp__mback { display: none; } }

.nf-pdp__details { display: flex; flex-direction: column; padding: 20px 16px 0; }
/* React drops the details column's top margin at md (`mt-5 md:mt-0`). */
@media (min-width: 768px) { .nf-pdp__details { padding-top: 0; } }
/* No sticky: JewelDetail.tsx's details column scrolls with the page. */
@media (min-width: 1024px) { .nf-pdp__details { padding: 8px 32px 0; } }
@media (min-width: 1280px) { .nf-pdp__details { padding: 8px 40px 0; } }

.nf-pdp__toprow { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 26px; }
.nf-pdp__eyebrow { margin: 0; font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-34); color: var(--nf-gold-deep); }
.nf-pdp__rating { display: inline-flex; flex-shrink: 0; align-items: center; gap: 4px; margin-right: -4px; padding: 4px 0 4px 8px; font-size: 12px; letter-spacing: .02em; color: hsl(0 0% 35%); text-decoration: none; }
.nf-pdp__star { color: var(--nf-gold-deep); }
.nf-pdp__rating-n { font-weight: 500; color: hsl(0 0% 15%); }
.nf-pdp__rating-c { text-decoration: underline; text-underline-offset: 4px; color: hsl(0 0% 48%); }
.nf-pdp__reviewlink { display: flex; align-items: center; gap: 8px; min-height: 44px; font-size: 12px; text-decoration: underline; text-underline-offset: 4px; color: hsl(186 35% 28%); }
.nf-pdp__reviewlink .nf-icon { width: 13px; height: 13px; }

.nf-pdp__title { margin: 8px 0 0; font-family: var(--nf-font-display); font-size: 26px; font-weight: 600; line-height: 1.15; letter-spacing: -0.01em; color: hsl(0 0% 12%); }
@media (min-width: 768px) { .nf-pdp__title { font-size: 32px; } }
@media (min-width: 1024px) { .nf-pdp__title { font-size: 36px; } }

.nf-pdp__price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px; margin-top: 12px; }
.nf-pdp__price { font-family: var(--nf-font-display); font-size: 24px; font-weight: 600; color: hsl(0 0% 12%); }
@media (min-width: 768px) { .nf-pdp__price { font-size: 28px; } }
.nf-pdp__was { font-size: 14px; color: hsl(0 0% 55%); }
.nf-pdp__off { font-size: 11.5px; font-weight: 500; letter-spacing: var(--nf-track-4); color: #8A6A2A; }
.nf-pdp__tax { font-size: 11px; letter-spacing: .06em; color: hsl(0 0% 48%); }
.nf-pdp__mrp { margin: 6px 0 0; font-size: 12px; letter-spacing: .02em; line-height: 1.625; color: hsl(0 0% 48%); }
.nf-pdp__rule { margin: 16px 0; border-top: 1px solid hsl(0 0% 88%); }
/* Three of JewelDetail.tsx's four hairlines are my-4; the one above the
   accordion is my-5. */
.nf-pdp__rule--wide { margin: 20px 0; }

.nf-pdp__label { font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .14em; color: hsl(0 0% 25%); }
.nf-pdp__size-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.nf-pdp__link { font: inherit; border: 0; background: none; cursor: pointer; font-size: 11px; letter-spacing: .02em; text-decoration: underline; text-underline-offset: 4px; color: hsl(186 35% 28%); min-height: 44px; display: inline-flex; align-items: center; padding-inline: 8px; }
.nf-pdp__sizes { display: flex; flex-wrap: wrap; gap: 8px; }
.nf-pdp__size-btn { min-width: 64px; min-height: 44px; padding-inline: 16px; border: 1px solid hsl(0 0% 80%); background: transparent; color: hsl(0 0% 20%); font-size: 13px; font-weight: 500; letter-spacing: .02em; cursor: pointer; transition: background-color 150ms cubic-bezier(.4, 0, .2, 1), border-color 150ms cubic-bezier(.4, 0, .2, 1), color 150ms cubic-bezier(.4, 0, .2, 1); }
.nf-pdp__size-btn.is-active { border-color: hsl(0 0% 12%); background-color: hsl(0 0% 12%); color: #fff; }
.nf-pdp__size-note { display: block; font-size: 9.5px; font-weight: 400; text-transform: uppercase; letter-spacing: var(--nf-track-8); opacity: .7; }
.nf-pdp__size-help { margin: 8px 0 0; font-size: 12px; line-height: 1.6; color: hsl(0 0% 45%); }
.nf-pdp__onesize { display: flex; align-items: center; width: 100%; height: 44px; padding-inline: 12px; border: 1px solid hsl(0 0% 80%); font-size: 13px; color: hsl(0 0% 20%); }

.nf-pdp__qty-block { margin-top: 16px; }
.nf-pdp__qty-block .nf-pdp__label { display: block; margin-bottom: 10px; }
.nf-pdp__qty { display: inline-flex; align-items: center; border: 1px solid hsl(0 0% 80%); }
.nf-pdp__qty button { width: 44px; height: 44px; border: 0; background: none; cursor: pointer; font-size: 16px; color: hsl(0 0% 30%); }
.nf-pdp__qty button:hover { background-color: var(--nf-ivory-deep); }
.nf-pdp__qty button:focus-visible { outline: 2px solid var(--nf-gold-deep); outline-offset: -2px; }
.nf-pdp__qty span { width: 48px; text-align: center; font-size: 13px; font-weight: 500; color: hsl(0 0% 20%); }

.nf-pdp__actions { margin-top: 24px; }
.nf-pdp__form { margin: 0; }
.nf-pdp__add, .nf-pdp__buy { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 0; cursor: pointer; font-size: 12px; font-weight: 500; text-transform: uppercase; transition: background-color 200ms cubic-bezier(.4, 0, .2, 1), border-color 200ms cubic-bezier(.4, 0, .2, 1), color 200ms cubic-bezier(.4, 0, .2, 1); text-decoration: none; }
.nf-pdp__add { height: 54px; background-color: var(--nf-gold-deep); color: #fff; letter-spacing: var(--nf-track-16); }
.nf-pdp__add--notify { border: 1px solid hsl(0 0% 24%); background: none; color: hsl(0 0% 15%); }
.nf-pdp__add--notify:hover { border-color: hsl(0 0% 35%); }
.nf-pdp__add .nf-icon, .nf-pdp__add--notify .nf-icon { width: 13px; height: 13px; }
.nf-pdp__buy { height: 50px; margin-top: 12px; background-color: hsl(0 0% 12%); color: #fff; letter-spacing: var(--nf-track-16); }
.nf-pdp__add:hover, .nf-pdp__buy:hover { opacity: .9; }
.nf-pdp__add:disabled, .nf-pdp__buy:disabled { opacity: .6; cursor: not-allowed; }
.nf-pdp__add:focus-visible, .nf-pdp__buy:focus-visible { outline: 2px solid var(--nf-gold-deep); outline-offset: 2px; }
.nf-pdp__add.is-added { animation: nf-pdp-check-pop 260ms var(--ease-out-strong, ease-out); }
@keyframes nf-pdp-check-pop { from { opacity: .7; transform: scale(0.97); } to { opacity: 1; transform: scale(1); } }
.nf-pdp__trust { margin: 8px 0 0; text-align: center; font-size: 11px; letter-spacing: .02em; color: hsl(0 0% 50%); }
.nf-pdp__trust a { color: hsl(0 0% 35%); text-decoration: underline; text-underline-offset: 4px; }
.nf-pdp__pair { display: flex; gap: 12px; margin-top: 12px; }
.nf-pdp__ghost { flex: 1; height: 46px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid hsl(0 0% 74%); background: none; color: hsl(0 0% 30%); cursor: pointer; text-decoration: none; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .12em; }
.nf-pdp__ghost { transition: background-color 200ms cubic-bezier(.4, 0, .2, 1), border-color 200ms cubic-bezier(.4, 0, .2, 1), color 200ms cubic-bezier(.4, 0, .2, 1); }
.nf-pdp__ghost:hover { border-color: hsl(0 0% 45%); }
.nf-pdp__ghost:focus-visible { outline: 2px solid var(--nf-gold-deep); outline-offset: 2px; }
.nf-pdp__ghost .nf-icon { width: 14px; height: 14px; }
.nf-pdp__ghost.is-on .nf-icon { fill: hsl(0 70% 55%); color: hsl(0 70% 55%); }

.nf-pdp__delivery { display: flex; align-items: flex-start; gap: 8px; margin-top: 20px; padding: 10px 12px; border: 1px solid hsl(36 40% 80%); background-color: hsl(36 60% 96%); }
.nf-pdp__truck { flex-shrink: 0; margin-top: 2px; width: 13px; height: 13px; color: var(--nf-gold-shadow); }
.nf-pdp__delivery p { margin: 0; font-size: 12px; line-height: 1.6; color: hsl(0 0% 32%); }
.nf-pdp__delivery strong { font-weight: 500; }

.nf-pdp__offers { margin-top: 12px; padding: 12px; border: 1px solid hsl(0 0% 88%); }
.nf-pdp__offers-head { margin: 0; font-family: var(--nf-font-label); font-size: 9px; letter-spacing: var(--nf-track-24); color: hsl(0 0% 45%); }
.nf-pdp__offers ul { list-style: none; margin: 8px 0 0; padding: 0; }
.nf-pdp__offers li { display: flex; align-items: flex-start; gap: 8px; margin-top: 6px; font-size: 12px; line-height: 1.6; color: hsl(0 0% 32%); }
.nf-pdp__bullet { color: var(--nf-gold-deep); }
.nf-pdp__code { margin-right: 6px; padding: 1px 6px; border: 1px solid hsl(36 40% 76%); font-size: 10.5px; letter-spacing: var(--nf-track-10); font-weight: 500; color: #8A6A2A; }

.nf-pdp__facts { display: flex; flex-wrap: wrap; gap: 8px; margin: 16px 0 0; }
.nf-pdp__fact { padding: 6px 12px; border: 1px solid hsl(36 30% 84%); background-color: hsl(33 41% 97%); }
.nf-pdp__fact dt { margin: 0; font-family: var(--nf-font-label); font-size: 8.5px; text-transform: uppercase; letter-spacing: var(--nf-track-18); color: #9A7634; }
.nf-pdp__fact dd { margin: 2px 0 0; font-size: 12px; line-height: 1.25; letter-spacing: .01em; color: hsl(0 0% 22%); }

.nf-pdp__stock { display: inline-flex; align-items: center; gap: 6px; margin: 12px 0 0; font-size: 12px; font-weight: 500; text-transform: uppercase; letter-spacing: .12em; color: hsl(142 50% 30%); }
.nf-pdp__stock::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background-color: currentColor; }
.nf-pdp__stock.is-out { color: hsl(0 65% 42%); }

.nf-pdp__trustbadges { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 20px; padding: 12px 0; border-top: 1px solid hsl(0 0% 90%); border-bottom: 1px solid hsl(0 0% 90%); }
.nf-pdp__trustbadge { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
.nf-pdp__trustbadge .nf-icon { width: 16px; height: 16px; color: hsl(186 35% 28%); }
.nf-pdp__trustbadge span { font-size: 10px; text-transform: uppercase; letter-spacing: .1em; line-height: 1.25; color: hsl(0 0% 30%); }

/* 32, not 16: JewelDetail.tsx wraps <PincodeChecker/> in a `mt-4` div and the
   component's own root is `mt-4` again. The two do not collapse -- the details
   column is a flex container, so its items open a new formatting context. */
.nf-pdp__pincode { margin-top: 32px; }
.nf-pdp__pincode-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
.nf-pdp__pincode-head .nf-icon { width: 13px; height: 13px; color: hsl(186 35% 28%); }
