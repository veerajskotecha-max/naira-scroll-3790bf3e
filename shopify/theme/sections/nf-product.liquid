.nf-pdp__sizeguide-tablewrap { margin-top: 12px; overflow-x: auto; }
.nf-pdp__sizeguide-table { width: 100%; min-width: 330px; border-collapse: collapse; text-align: left; }
.nf-pdp__sizeguide-table th { padding: 10px 16px 10px 0; border-bottom: 1px solid hsl(0 0% 88%); font-family: var(--nf-font-label); font-size: 10px; font-weight: 500; text-transform: uppercase; letter-spacing: .12em; color: hsl(0 0% 35%); }
.nf-pdp__sizeguide-table td { padding: 10px 16px 10px 0; border-bottom: 1px solid hsl(0 0% 93%); font-size: 13px; color: hsl(0 0% 35%); }
.nf-pdp__sizeguide-table td:first-child { font-weight: 500; color: hsl(0 0% 18%); }
