.nf-pdp__bar-add, .nf-pdp__bar-buy, .nf-pdp__bar-notify, .nf-pdp__bar-soldout { flex: 1; height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-size: 11px; font-weight: 500; text-transform: uppercase; letter-spacing: .12em; text-decoration: none; cursor: pointer; }
.nf-pdp__bar-add { border: 1px solid hsl(0 0% 24%); background: none; color: hsl(0 0% 15%); }
.nf-pdp__bar-buy, .nf-pdp__bar-notify { border: 0; background-color: hsl(0 0% 12%); color: #fff; }
.nf-pdp__bar-soldout { border: 1px solid hsl(0 0% 80%); color: hsl(0 0% 45%); }
.nf-pdp__bar-add:disabled, .nf-pdp__bar-buy:disabled { opacity: .6; cursor: not-allowed; }
.nf-pdp__bar-add:focus-visible, .nf-pdp__bar-buy:focus-visible, .nf-pdp__bar-wish:focus-visible, .nf-pdp__bar-notify:focus-visible { outline: 2px solid var(--nf-gold-deep); outline-offset: 2px; }

/* -- Ring size guide (native dialog) -- */
.nf-pdp__sizeguide { border: 0; padding: 0; margin: 0 auto auto; max-width: none; width: 100%; max-height: 88vh; background-color: #FDFAF7; color: hsl(0 0% 20%); position: fixed; inset: auto 0 0 0; overflow-y: auto; }
