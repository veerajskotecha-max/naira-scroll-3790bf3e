.nf-pdp__help-link { flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding-block: 12px; font-size: 12px; line-height: 1.5; letter-spacing: .02em; color: hsl(0 0% 35%); text-decoration: none; border-top: 1px solid hsl(0 0% 90%); border-bottom: 1px solid hsl(0 0% 90%); border-right: 1px solid hsl(0 0% 90%); transition: color 200ms cubic-bezier(.4, 0, .2, 1); }
