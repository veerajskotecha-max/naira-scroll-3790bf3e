@media (min-width: 768px) { .nf-pdp__sizeguide { inset: 0; top: 50%; left: 50%; right: auto; bottom: auto; transform: translate(-50%, -50%); width: 560px; } }
.nf-pdp__sizeguide-grabber { display: flex; justify-content: center; padding: 12px 0 4px; }
.nf-pdp__sizeguide-grabber::before { content: ''; width: 40px; height: 4px; border-radius: 999px; background-color: hsl(0 0% 82%); }
@media (min-width: 768px) { .nf-pdp__sizeguide-grabber { display: none; } }
.nf-pdp__sizeguide-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid hsl(0 0% 90%); }
