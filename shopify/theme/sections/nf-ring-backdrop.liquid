{%- comment -%}
  ─────────────────────────────────────────────────────────────────
  Naira Flore — ring atelier backdrop (section)

  src/pages/Index.tsx renders <RingAtelierBackdrop variant="section" />
  behind the jewellery band. The snippet was ported and uploaded but no
  section ever rendered it, so the wash never appeared on the storefront.

  Sits in normal flow with its own height and holds the absolutely
  positioned backdrop; anything placed after it scrolls over the wash.
  ─────────────────────────────────────────────────────────────────
{%- endcomment -%}

<section class="nf nf-bdsec" style="min-height: {{ section.settings.height }}px;">
  {%- render 'nf-ring-backdrop', variant: 'section' -%}
  {%- if section.settings.heading != blank -%}
    <div class="nf-bdsec__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="nf-bdsec__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="nf-bdsec__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.copy != blank -%}<div class="nf-bdsec__copy">{{ section.settings.copy }}</div>{%- endif -%}
      {%- if section.settings.cta_label != blank -%}
        <a class="nf-bdsec__cta" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.nf-bdsec { position: relative; display: flex; align-items: center; justify-content: center; background-color: var(--nf-ivory); overflow: hidden; }
.nf-bdsec__inner { position: relative; z-index: 1; max-width: 40rem; margin-inline: auto; padding: 3rem 1.5rem; text-align: center; }
.nf-bdsec__eyebrow { margin: 0; font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-40); text-transform: uppercase; color: var(--nf-gold-shadow); }
.nf-bdsec__title { margin: .75rem 0 0; font-family: var(--nf-font-display); font-size: 30px; line-height: 1.1; color: var(--nf-ink); }
@media (min-width: 768px) { .nf-bdsec__title { font-size: 42px; } }
.nf-bdsec__copy { margin-top: .75rem; font-family: var(--nf-font-editorial); font-size: 15px; line-height: 1.8; color: rgb(var(--nf-ink-rgb) / .65); }
.nf-bdsec__cta { display: inline-flex; align-items: center; justify-content: center; margin-top: 1.75rem; min-height: 48px; padding-inline: 1.75rem; border: 1px solid var(--nf-ink); color: var(--nf-ink); text-decoration: none; font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: var(--nf-track-28); transition: background-color .2s, color .2s; }
.nf-bdsec__cta:hover { background-color: var(--nf-ink); color: var(--nf-ivory); }
{% endstylesheet %}

{% schema %}
{
  "name": "NF Ring Backdrop",
  "settings": [
    { "type": "range", "id": "height", "label": "Section height", "min": 220, "max": 720, "step": 20, "unit": "px", "default": 420 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NAIRA PETITE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Demi-fine, made to be worn" },
    { "type": "richtext", "id": "copy", "label": "Copy", "default": "<p>Brilliant-cut zircone in an 18K gold finish. Waterproof, anti-tarnish, and built for every day.</p>" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "NF Ring Backdrop" }]
}
{% endschema %}
