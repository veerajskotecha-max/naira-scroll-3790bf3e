{%- comment -%}
  Naira Flore - ring atelier backdrop (band overlay)

  In src/pages/Index.tsx the backdrop is not a band of its own. It is an
  absolutely positioned wash sitting BEHIND a run of sections:

      <div class="relative isolate overflow-hidden bg-[#FBF3EC]
                  [&_section]:!bg-transparent">
        <div class="pointer-events-none absolute inset-0 z-0">
          <RingAtelierBackdrop variant="section" />
        </div>
        <div class="relative z-[1]"> ...the sections... </div>
      </div>

  The homepage uses that wrapper twice: once around ZirconeTurn and
  JewelleryCategories, once around CustomisationSteps, BrandEthos,
  Craftsmanship and FounderStoryTeaser.

  A Shopify section cannot wrap other sections, so this one takes no
  height of itself and instead reaches forward: `span` says how many of
  the following sections the wash sits behind. A little script measures
  that run and sizes the wash to it, and marks those sections so their
  own ivory grounds go transparent - the Liquid equivalent of the
  `[&_section]:!bg-transparent` above. The wash paints at z-index -1, so
  in-flow section content stays on top of it without any of them needing
  to know this section exists.

  An earlier version of this file was a standalone band with its own
  min-height and a heading, which put a whole extra block on the homepage
  that the React page does not have.
{%- endcomment -%}

<div
  class="nf-bdband"
  id="nf-bdband-{{ section.id }}"
  data-nf-bdband
  data-nf-bdband-span="{{ section.settings.span }}"
>
  <div class="nf-bdband__inner" aria-hidden="true">
    {%- render 'nf-ring-backdrop', variant: 'section' -%}
  </div>
</div>

{% stylesheet %}
/* Takes no height: the wash hangs out of a zero-height box and is sized
   to the run of sections below it. */
.nf-bdband { position: relative; height: 0; }
.nf-bdband__inner {
  position: absolute; left: 0; right: 0; top: 0; height: 0;
  z-index: -1;
  background-color: var(--nf-ivory);
  pointer-events: none;
}
/* The React wrapper's [&_section]:!bg-transparent. The class lands on the
   .shopify-section wrapper on the storefront and on the section root in
   the local render harness, so both shapes are matched. */
.nf-onwash section,
section.nf-onwash { background-color: transparent !important; }
{% endstylesheet %}

<script>
(function () {
  /* This script is inline, so it executes while the document is still
     parsing - at which point the sections it has to measure do not exist
     yet and nextElementSibling is null. Wait for the parse to finish. */
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }

  function start() {
  var band = document.getElementById('nf-bdband-{{ section.id }}');
  if (!band || band.dataset.nfBdbandReady) return;
  band.dataset.nfBdbandReady = '1';

  var inner = band.querySelector('.nf-bdband__inner');
  var span = parseInt(band.dataset.nfBdbandSpan, 10) || 1;
  /* On the storefront each section is wrapped in .shopify-section; the
     render harness emits the section root directly. Either way the run we
     want is the following siblings of whichever box this one sits in. */
  var host = band.closest('.shopify-section') || band;
  /* Sections are separated by inline <script> and <style> nodes that render
     nothing; counting those as sections put the wash behind a zero-height
     script tag and it never appeared. */
  var SKIP = { SCRIPT: 1, STYLE: 1, TEMPLATE: 1, LINK: 1, NOSCRIPT: 1 };
  var covered = [];
  var el = host;
  while (covered.length < span) {
    el = el.nextElementSibling;
    if (!el) break;
    if (SKIP[el.tagName]) continue;
    el.classList.add('nf-onwash');
    covered.push(el);
  }
  if (!covered.length) return;

  function size() {
    var top = band.getBoundingClientRect().top;
    var bottom = covered[covered.length - 1].getBoundingClientRect().bottom;
    inner.style.height = Math.max(0, bottom - top) + 'px';
  }

  size();
  window.addEventListener('resize', size, { passive: true });
  window.addEventListener('load', size);
  if ('ResizeObserver' in window) {
    var ro = new ResizeObserver(size);
    covered.forEach(function (c) { ro.observe(c); });
  }
  }
})();
</script>

{% schema %}
{
  "name": "NF Ring Backdrop",
  "settings": [
    {
      "type": "range",
      "id": "span",
      "label": "Sections covered",
      "info": "How many of the sections below this one the wash sits behind. Place this directly above the first section of the run.",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 2
    }
  ],
  "presets": [{ "name": "NF Ring Backdrop" }]
}
{% endschema %}
