{%- comment -%}
  ═══════════════════════════════════════════════════════════════════
  Naira Flore — search results

  The React site has no /search route, so there is nothing to port
  one-for-one. Shopify needs the template, so this is built from the
  collection page's language (same hero, same grid, same card) rather
  than a second visual idiom.
  ═══════════════════════════════════════════════════════════════════
{%- endcomment -%}

<section class="nf nf-search">
  <div class="nf-search__hero">
    <header class="nf-search__head">
      <p class="nf-search__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1 class="nf-search__title">
        {%- if search.performed and search.terms != blank -%}
          {{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}
        {%- else -%}
          {{ section.settings.heading | escape }}
        {%- endif -%}
      </h1>
      {%- if search.performed and search.terms != blank -%}
        <p class="nf-search__lede">for “{{ search.terms | escape }}”</p>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="nf-search__form">
        <label class="nf-visually-hidden" for="nf-search-input">Search</label>
        <input type="search" id="nf-search-input" name="q" value="{{ search.terms | escape }}"
               placeholder="{{ section.settings.placeholder | escape }}" autocomplete="off">
        <button type="submit">SEARCH</button>
      </form>
    </header>
  </div>

  {%- if search.performed -%}
    {%- if search.results_count > 0 -%}
      <div class="nf-search__grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            {%- render 'nf-product-card', product: item, index: forloop.index0, uid: section.id -%}
          {%- else -%}
            <a class="nf-search__page" href="{{ item.url }}">
              <p class="nf-search__page-kind">{{ item.object_type }}</p>
              <p class="nf-search__page-title">{{ item.title }}</p>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="nf-search__empty">
        <h2>Nothing matched that</h2>
        <p>Try a shorter word, or browse the full collection.</p>
        <a class="nf-search__cta" href="{{ routes.all_products_collection_url }}">VIEW ALL PIECES</a>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% stylesheet %}
.nf-visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.nf-search__hero { background-color: var(--nf-ivory); }
.nf-search__head { max-width: 72rem; margin-inline: auto; padding: 1.5rem 1rem 2rem; }
@media (min-width: 640px) { .nf-search__head { padding-inline: 1.5rem; } }
@media (min-width: 768px) { .nf-search__head { padding-top: 2.5rem; } }
.nf-search__eyebrow { margin: 0; font-family: var(--nf-font-label); font-size: 10px; letter-spacing: var(--nf-track-40); color: var(--nf-gold-shadow); }
.nf-search__title { margin: .75rem 0 0; font-family: var(--nf-font-display); font-size: 30px; line-height: 1.05; color: var(--nf-ink); }
@media (min-width: 768px) { .nf-search__title { font-size: 44px; } }
.nf-search__lede { margin: .5rem 0 0; font-family: var(--nf-font-editorial); font-size: 15px; color: rgb(var(--nf-ink-rgb) / .6); }
.nf-search__form { display: flex; gap: .5rem; margin-top: 1.25rem; max-width: 34rem; }
.nf-search__form input { flex: 1; min-height: 48px; padding-inline: .875rem; border: 1px solid rgb(var(--nf-ink-rgb) / .25); background: #fff; font-family: var(--nf-font-editorial); font-size: 15px; color: var(--nf-ink); }
.nf-search__form input:focus { outline: none; border-color: var(--nf-ink); }
.nf-search__form button { min-height: 48px; padding-inline: 1.25rem; border: 1px solid var(--nf-ink); background-color: var(--nf-ink); color: var(--nf-ivory); cursor: pointer; font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: var(--nf-track-24); }

.nf-search__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; max-width: 72rem; margin-inline: auto; padding: 2.5rem 1rem 4rem; }
@media (min-width: 640px) { .nf-search__grid { gap: 1.5rem; padding-inline: 1.5rem; } }
@media (min-width: 1024px) { .nf-search__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }
.nf-search__page { display: block; padding: 1rem; border: 1px solid rgb(var(--nf-ink-rgb) / .12); text-decoration: none; }
.nf-search__page-kind { margin: 0; font-family: var(--nf-font-label); font-size: 9px; text-transform: uppercase; letter-spacing: var(--nf-track-24); color: var(--nf-gold-shadow); }
.nf-search__page-title { margin: .375rem 0 0; font-family: var(--nf-font-editorial); font-size: 16px; color: var(--nf-ink); }

.nf-search__empty { text-align: center; max-width: 72rem; margin-inline: auto; padding: 4rem 1.5rem 6rem; }
.nf-search__empty h2 { margin: 0; font-family: var(--nf-font-display); font-size: 26px; color: var(--nf-ink); }
.nf-search__empty p { margin: .75rem 0 0; font-family: var(--nf-font-editorial); font-size: 14px; color: rgb(var(--nf-ink-rgb) / .6); }
.nf-search__cta { display: inline-flex; align-items: center; justify-content: center; margin-top: 1.75rem; min-height: 48px; padding-inline: 1.75rem; border: 1px solid var(--nf-ink); color: var(--nf-ink); text-decoration: none; font-family: var(--nf-font-label); font-size: 10.5px; letter-spacing: var(--nf-track-28); }
.nf-search__cta:hover { background-color: var(--nf-ink); color: var(--nf-ivory); }
{% endstylesheet %}

{% schema %}
{
  "name": "NF Search",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NAIRA" },
    { "type": "text", "id": "heading", "label": "Heading (no query yet)", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Rings, earrings, lehenga…" }
  ]
}
{% endschema %}
