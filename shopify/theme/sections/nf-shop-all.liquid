{%- comment -%}
  ===========================================================================
  Naira Flore -- apparel shop listing
  Ported from src/pages/ShopAll.tsx (the /shop route), together with the two
  components that page renders around its grid:
    src/components/shop/ShopHero.tsx        -> .nf-shop-hero
    src/components/product/CustomizationCTA.tsx -> .nf-shop-cta
  Both are page furniture belonging to ShopAll, not standalone routes, so
  they live in this one section rather than becoming sections of their own.

  Cards come from snippets/nf-product-card.liquid -- that snippet IS the port
  of src/components/ProductCard.tsx, which is exactly the card ShopAll.tsx
  renders (unlike nf-collection.liquid, whose page renders JewelCard.tsx).

  Vendor gate: ShopAll fetches the store's products and shows them all, but
  this store's catalogue is two lines in one shop. src/lib/isJewelleryProduct.ts
  buckets a listing as jewellery on the exact vendor string "Naira Petite";
  everything else is the ready-to-wear line this page is for. The jewellery
  half already has its own listing (nf-collection.liquid), so the gate here is
  the inverse of the gate there -- without it /shop and the jewellery page
  would show the same stock.

  Filters: the sidebar is open by default on the React page and every control
  in it is live there, so they are live here too -- all client-side over the
  rendered cells (show/hide + reorder), no reload and no scroll jump, the same
  way nf-collection.liquid filters its grid. Disclosure uses <details>/<summary>
  rather than JS state, which is what Radix's Collapsible renders down to.

  Not reproduced, and why:
    - Loading skeletons and the network-error panel: Liquid renders with the
      products already in hand, so neither state can occur.
    - The active-filter chip row: it only exists when a filter is on, never in
      the default view. A single "Clear all" replaces it.
  ===========================================================================
{%- endcomment -%}

{%- liquid
  # nil-safe fallback: `collections['bad-handle']` is nil, and nil.products.size
  # is nil too, so test the size with `> 0` rather than comparing against empty
  # -- neither nil nor EmptyDrop compares equal to a sentinel reliably.
  assign shop_products = collections[section.settings.collection].products
  unless shop_products.size > 0
    assign shop_products = collections.all.products
  endunless

  # ShopAll.tsx opens with priceRange = [0, 50000] and filters on it from the
  # first render, so anything dearer never appears on /shop -- the slider only
  # travels down from that ceiling. Applied here as well, or the server-rendered
  # grid would show pieces the client-side filter removes on the first click.
  # ponytail: 50000 is React's constant, repeated in the slider max, the "₹50,000"
  # label and the JS default below. Raise all four together if the catalogue does.
  assign price_cap = 50000

  assign cat_csv = ''
  assign shop_count = 0
  for p in shop_products
    assign v = p.vendor | downcase | strip
    assign p_rupees = p.price_min | divided_by: 100
    if v != 'naira petite' and p_rupees <= price_cap
      assign shop_count = shop_count | plus: 1
      assign c = p.type
      if c == blank
        assign c = 'Naira Flore'
      endif
      assign probe = cat_csv | append: '|'
      assign needle = c | append: '|'
      assign seen = false
      if probe contains needle
        assign seen = true
      endif
      unless seen
        assign cat_csv = cat_csv | append: c | append: '|'
      endunless
    endif
  endfor
  assign shop_categories = cat_csv | split: '|'
  assign sizes = 'XS,S,M,L,XL' | split: ','
-%}

<div class="nf nf-shop">
  <h1 class="visually-hidden">{{ section.settings.seo_heading }}</h1>

  {%- comment -%} ── Campaign hero — ShopHero.tsx ── {%- endcomment -%}
  <section class="nf-shop-hero" aria-label="Shop hero">
    <div class="nf-shop-hero__pattern" aria-hidden="true" style="background-image:url({{ 'nf-floral-pattern-bg.webp' | asset_url }});"></div>
    <div class="nf-shop-hero__glow nf-shop-hero__glow--warm" aria-hidden="true"></div>
    <div class="nf-shop-hero__glow nf-shop-hero__glow--sage" aria-hidden="true"></div>
    <div class="nf-shop-hero__rule nf-shop-hero__rule--top" aria-hidden="true"></div>

    <div class="nf-shop-hero__inner">
      <div class="nf-shop-hero__eyebrow-row">
        <span class="nf-shop-hero__dash" aria-hidden="true"></span>
        <span class="nf-shop-hero__eyebrow">{{ section.settings.hero_eyebrow | escape }}</span>
        <span class="nf-shop-hero__dash" aria-hidden="true"></span>
      </div>

      <h2 class="nf-shop-hero__title">
        {{- section.settings.hero_title | escape -}}
        {%- if section.settings.hero_title_accent != blank -%}
          {{ ' ' }}<em class="nf-shop-hero__accent">{{ section.settings.hero_title_accent | escape }}</em>
        {%- endif -%}
      </h2>

      {%- if section.settings.hero_copy != blank -%}
        <p class="nf-shop-hero__copy">{{ section.settings.hero_copy | escape }}</p>
      {%- endif -%}

      <div class="nf-shop-hero__cta-row">
        <a class="nf-shop-hero__cta" href="{{ section.settings.hero_cta_url }}">{{ section.settings.hero_cta_label | escape }}</a>
      </div>
    </div>

    <div class="nf-shop-hero__rule nf-shop-hero__rule--bottom" aria-hidden="true"></div>
  </section>

  {%- comment -%} ── Ready-to-wear section header ── {%- endcomment -%}
  <section id="indo-western" class="nf-shop-head">
    <div class="nf-shop-head__inner">
      <span class="nf-shop-head__eyebrow">{{ section.settings.head_eyebrow | escape }}</span>
      <h2 class="nf-shop-head__title">{{ section.settings.head_title | escape }}</h2>
      <div class="nf-shop-head__rule" aria-hidden="true"></div>
    </div>
  </section>

  {%- comment -%} ── Toolbar ── {%- endcomment -%}
  <div class="nf-shop-bar" data-nf-shop>
    <div class="nf-shop-bar__desk">
      <div class="nf-shop-bar__wrap">
        <div class="nf-shop-bar__row">
          <div class="nf-shop-bar__cols">
            <button type="button" class="nf-shop-bar__col" data-nf-cols="2" title="2 columns" aria-label="2 columns">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M12 3v18"/></svg>
            </button>
            <button type="button" class="nf-shop-bar__col is-on" data-nf-cols="4" title="4 columns" aria-label="4 columns">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
            </button>
          </div>

