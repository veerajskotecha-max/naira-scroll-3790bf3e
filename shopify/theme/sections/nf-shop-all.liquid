}
.nf-shop-bar__lbtn {
  width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
  border: 0; background-color: transparent; color: hsl(0 0% 55%); cursor: pointer;
  transition: background-color .15s, color .15s;
}
.nf-shop-bar__lbtn.is-on { background-color: hsl(0 0% 92%); color: hsl(0 0% 15%); }

/* ───────── Two-column body ───────── */
.nf-shop-body { flex: 1 1 0%; display: flex; background-color: hsl(0 0% 98%); }
.nf-shop-body__inner { display: flex; width: 100%; max-width: 1400px; margin-inline: auto; }

.nf-shop-side { display: none; }
@media (min-width: 768px) {
