              <div class="nf-shop-sort__menu">
                <button type="button" class="nf-shop-sort__opt is-on" data-nf-sort="newest">Newest Arrivals</button>
                <button type="button" class="nf-shop-sort__opt" data-nf-sort="price-low">Price: Low to High</button>
                <button type="button" class="nf-shop-sort__opt" data-nf-sort="price-high">Price: High to Low</button>
