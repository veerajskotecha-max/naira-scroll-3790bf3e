@media (min-width: 1024px) { .nf-shop-side { width: 280px; padding-inline: 40px; top: 168px; } }

/* Phone: the same aside doubles as the filter sheet, so there is only ever
   one set of filter controls in the document. */
.nf-shop-side.is-open {
  display: block; position: fixed; inset: auto 0 0 0; z-index: 60;
  max-height: 85vh; overflow-y: auto;
