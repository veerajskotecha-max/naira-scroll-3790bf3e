{%- comment -%}
  nf-trust-strip - port of src/components/TrustStrip.tsx
  Infinite marquee of six trust points (shipping, karigar handwork,
  consultation, fabrics, payments, custom-piece count). Same three-pass
  marquee mechanism as nf-brand-ethos.liquid, but this strip scrolls the
  opposite direction (translateX 0 -> -33.333%, ethos goes the other
  way) and has its own timing (25s vs 30s), spacing and colours - kept
  as a separate stylesheet block on purpose, do not merge with ethos.
  Purely decorative/informational markup: the source has no links,
  buttons or inputs, so no focus-visible states are needed here.
{%- endcomment -%}

{{ 'nf-tokens.css' | asset_url | stylesheet_tag }}
{{ 'nf-home.css' | asset_url | stylesheet_tag }}

<section class="nf nf-trust-strip" aria-label="{{ section.settings.aria_label | escape }}">
  <div class="nf-trust-strip__track">
    {%- for pass in (1..3) -%}
      {%- for block in section.blocks -%}
        <div class="nf-trust-strip__item" {{ block.shopify_attributes }}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
              {%- when 'hand' -%}
                <path d="M18 11V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2"/><path d="M14 10V4a2 2 0 0 0-2-2a2 2 0 0 0-2 2v2"/><path d="M10 10.5V6a2 2 0 0 0-2-2a2 2 0 0 0-2 2v8"/><path d="M18 8a2 2 0 1 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.86-5.99-2.34l-3.6-3.6a2 2 0 0 1 2.83-2.82L7 15"/>
              {%- when 'message-circle' -%}
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
              {%- when 'sparkles' -%}
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>
              {%- when 'shield-check' -%}
                <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>
              {%- when 'scissors' -%}
                <circle cx="6" cy="6" r="3"/><path d="M8.12 8.12 12 12"/><path d="M20 4 8.12 15.88"/><circle cx="6" cy="18" r="3"/><path d="M14.8 14.8 20 20"/>
              {%- else -%}
                <circle cx="12" cy="12" r="3"/>
            {%- endcase -%}
          </svg>
          <span class="nf-trust-strip__label">{{ block.settings.label }}</span>
          <span class="nf-trust-strip__dot" aria-hidden="true">•</span>
        </div>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.nf-trust-strip {
  width: 100%;
  overflow: hidden;
  padding: 1.25rem 0;
  background-color: hsl(30 25% 96%);
}
@media (min-width: 768px) {
  .nf-trust-strip { padding: 1.5rem 0; }
}
.nf-trust-strip__track {
  display: flex;
  align-items: center;
  width: max-content;
  animation: nf-trust-strip-marquee 25s linear infinite;
}
.nf-trust-strip:hover .nf-trust-strip__track { animation-play-state: paused; }
@keyframes nf-trust-strip-marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-33.333%); }
}
.nf-trust-strip__item {
  display: flex;
  align-items: center;
  gap: .5rem;
  flex-shrink: 0;
  padding: 0 1.5rem;
}
@media (min-width: 768px) {
  .nf-trust-strip__item { gap: .75rem; padding: 0 2rem; }
}
.nf-trust-strip__item svg {
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  color: hsl(20 30% 45%);
}
@media (min-width: 768px) {
  .nf-trust-strip__item svg { width: 20px; height: 20px; }
}
.nf-trust-strip__label {
  font-family: var(--nf-font-display);
  font-size: 11.5px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  white-space: nowrap;
  color: hsl(0 0% 35%);
}
@media (min-width: 768px) {
  .nf-trust-strip__label { font-size: 14px; letter-spacing: 0.14em; }
}
.nf-trust-strip__dot {
  margin-left: 1.5rem;
  font-size: 10px;
  color: hsl(0 0% 75% / .6);
}
@media (min-width: 768px) {
  .nf-trust-strip__dot { margin-left: 2rem; }
}
@media (prefers-reduced-motion: reduce) {
  .nf-trust-strip__track { animation: none !important; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "NF Trust strip",
  "tag": "section",
  "class": "nf-section",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessible label", "default": "Store highlights" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "hand", "label": "Hand" },
            { "value": "message-circle", "label": "Message circle" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "shield-check", "label": "Shield check" },
            { "value": "scissors", "label": "Scissors" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Pan India Shipping" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "NF Trust strip",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "label": "Pan India Shipping" } },
        { "type": "item", "settings": { "icon": "hand", "label": "Authentic Karigar Handwork" } },
        { "type": "item", "settings": { "icon": "message-circle", "label": "Free Design Consultation" } },
        { "type": "item", "settings": { "icon": "sparkles", "label": "Premium Quality Fabrics" } },
        { "type": "item", "settings": { "icon": "shield-check", "label": "Secure Payments" } },
        { "type": "item", "settings": { "icon": "scissors", "label": "2,500+ Custom Pieces Made" } }
      ]
    }
  ]
}
{% endschema %}
