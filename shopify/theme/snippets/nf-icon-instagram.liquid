{%- comment -%}
  Naira Flore icon: instagram.
  Ported from the inline SVG in src/components/Footer.tsx. Stroke 2 on a 24x24 grid; colour comes
  from the parent through `currentColor`.

  Accepts:
  - size: {Number} pixel box, defaults to 16

  Usage: {% render 'nf-icon-instagram', size: 16 %}
{%- endcomment -%}
{%- liquid
  assign icon_size = size | default: 16
-%}
