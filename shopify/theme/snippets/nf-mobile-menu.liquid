{%- comment -%}
  Naira Flore -- mobile navigation drawer.
  Ported from src/components/MobileMenu.tsx in the Lovable repo.
  React state (isOpen) becomes an `.is-open` class driven by
  assets/nf-header.js; the transitions, sizes and copy are the
  source's exact values. The single-open accordion
  (useState<string | null>) is also driven by nf-header.js, toggling
  `aria-expanded` and `hidden` on server-rendered markup that already
  starts in the right state (see default_open below), so there's no
  flash of the wrong panel before JS runs.

  Accepts:
  - blocks:          {Array} section.blocks from sections/nf-header.liquid
                      ("Navigation item" blocks). Only blocks with
                      show_in_mobile_drawer render here, in block order --
                      the same ordered list the desktop bar reads, so
                      the two surfaces can never disagree. A block with
                      a non-blank children textarea (Label|/url per
                      line) renders as an expand/collapse accordion
                      group; otherwise it's a plain link.
  - default_open:     {String} block label that starts expanded,
                       matching MobileMenu.tsx's useState("JEWELLERY").
                       Case-insensitive.
  - whatsapp_url:      {String} quick-contact link, hidden when blank
  - whatsapp_label:    {String} its label
  - show_wishlist:     {Boolean}
  - wishlist_url:      {String} where the wishlist heart points

  Usage: {% render 'nf-mobile-menu', blocks: section.blocks, default_open: '...', ... %}
{%- endcomment -%}

{%- liquid
  assign default_open_lower = default_open | strip | downcase
-%}

<div class="nf-mm" data-nf-menu aria-hidden="true" inert>
  <div class="nf-mm__backdrop" data-nf-menu-close aria-hidden="true"></div>

  <div
    class="nf-mm__panel"
    data-nf-menu-panel
    role="dialog"
    aria-modal="true"
    aria-label="Navigation menu"
  >
    <div class="nf-mm__head">
      <button type="button" class="nf-mm__close" data-nf-menu-close aria-label="Close menu">
        {%- render 'nf-icon-close', size: 22 -%}
      </button>
    </div>

    <nav class="nf-mm__nav" aria-label="Main navigation">
      {%- for block in blocks -%}
        {%- if block.settings.show_in_mobile_drawer -%}
          {%- assign nf_label = block.settings.label | strip -%}
          {%- assign nf_url = block.settings.url | strip -%}
          {%- assign nf_children = block.settings.children | strip -%}
          {%- assign nf_is_current = false -%}
          {%- if nf_url != blank and request.path == nf_url -%}
            {%- assign nf_is_current = true -%}
          {%- endif -%}

          {%- if nf_children != blank -%}
            {%- assign nf_label_lower = nf_label | downcase -%}
            {%- assign nf_open = false -%}
            {%- if default_open_lower != blank and nf_label_lower == default_open_lower -%}
              {%- assign nf_open = true -%}
            {%- endif -%}
            <div class="nf-mm__group" {{ block.shopify_attributes }}>
              <button
                type="button"
                class="nf-mm__link nf-mm__toggle"
                data-nf-accordion-trigger
                aria-expanded="{{ nf_open }}"
                aria-controls="nf-mm-panel-{{ block.id }}"
              >
                <span>{{- nf_label | escape -}}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="nf-mm__chevron"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <ul
                id="nf-mm-panel-{{ block.id }}"
                class="nf-mm__sub"
                data-nf-accordion-panel
                {% unless nf_open %}hidden{% endunless %}
              >
                {%- assign nf_child_lines = nf_children | newline_to_br | split: '<br />' -%}
                {%- for cline in nf_child_lines -%}
                  {%- assign nf_cline = cline | strip -%}
                  {%- if nf_cline == blank -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- assign nf_cparts = nf_cline | split: '|' -%}
                  {%- assign nf_clabel = nf_cparts[0] | strip -%}
                  {%- assign nf_curl = nf_cparts[1] | strip -%}
                  {%- if nf_clabel == blank or nf_curl == blank -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- assign nf_child_current = false -%}
                  {%- if request.path == nf_curl -%}
                    {%- assign nf_child_current = true -%}
                  {%- endif -%}
                  <li>
                    <a
                      href="{{ nf_curl | escape }}"
                      class="nf-mm__link nf-mm__link--sub{% if nf_child_current %} is-active{% endif %}"
                      data-nf-menu-close
                      {% if nf_child_current %}aria-current="page"{% endif %}
                    >
                      {{- nf_clabel | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- else -%}
            {%- if nf_url != blank -%}
              <a
                href="{{ nf_url | escape }}"
                class="nf-mm__link{% if nf_is_current %} is-active{% endif %}"
                data-nf-menu-close
                {% if nf_is_current %}aria-current="page"{% endif %}
                {{ block.shopify_attributes }}
              >
                {{- nf_label | escape -}}
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="nf-mm__foot">
      {%- if show_wishlist -%}
        <a
          href="{{ wishlist_url | default: routes.account_url }}"
          class="nf-mm__action"
          data-nf-menu-close
          aria-label="Wishlist"
        >
          {%- render 'nf-icon-heart', size: 22 -%}
          <span class="nf-mm__dot" data-nf-wishlist-dot hidden></span>
        </a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="nf-mm__action"
        data-nf-menu-close
        aria-label="Cart, {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}"
      >
        {%- render 'nf-icon-bag', size: 22 -%}
        <span
          class="nf-mm__badge"
          data-nf-cart-mirror
          aria-hidden="true"
          {% if cart.item_count == 0 %}hidden{% endif %}
        >
          {%- if cart.item_count > 9 -%}9+{%- else -%}{{ cart.item_count }}{%- endif -%}
        </span>
      </a>

      {%- if whatsapp_url != blank -%}
        <a
          href="{{ whatsapp_url | escape }}"
          class="nf-mm__whatsapp"
          target="_blank"
          rel="noopener noreferrer"
          data-nf-menu-close
        >
          {{- whatsapp_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
