          "settings": {
            "title": "Shipping & Delivery"
          }
        },
        "faq_g1q0": {
          "type": "question",
          "settings": {
            "question": "What are the delivery timelines?",
            "answer": "<p>Standard (ready-to-ship) orders are delivered within 3–7 working days. Made-to-measure pieces take 4–8 weeks, depending on the complexity of the piece.</p>"
          }
        },
        "faq_g1q1": {
          "type": "question",
          "settings": {
            "question": "Do you offer express shipping?",
            "answer": "<p>Currently, we do not offer express shipping for made-to-measure pieces due to the handcrafted nature of our pieces. For standard orders, expedited shipping may be available, please contact us on WhatsApp for options.</p>"
          }
        },
        "faq_g1q2": {
          "type": "question",
          "settings": {
            "question": "How can I track my order?",
            "answer": "<p>Once your order is dispatched, you will receive a tracking link via WhatsApp and email. You can use this link to monitor your shipment in real time.</p>"
          }
        },
