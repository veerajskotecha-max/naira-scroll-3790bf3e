{%- doc -%}
  Naira: the facts a jewellery shopper weighs before buying, held directly
  under Add to bag so they share the first screen with it.

  The shipping line is built from two settings rather than typed, so the
  threshold is printed with the shop's own money format and changes with it.
  Plain text, not links: a line that looks tappable and goes nowhere is a
  dead click.
{%- enddoc -%}

{%- liquid
  assign block_settings = block.settings
  assign free_over = block_settings.free_shipping_over
-%}

<ul
  class="nf-assurances spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  {{ block.shopify_attributes }}
>
  {%- if block_settings.shipping_days != blank -%}
    <li class="nf-assurances__item">
      {%- render 'icon-or-image', icon: 'truck', width: 18, class_name: 'nf-assurances__icon' -%}
      <span>
        {{- 'Ships in ' | append: block_settings.shipping_days | escape -}}
        {%- if free_over != blank -%}
          {%- if free_over == 0 -%}
            {{- ' · free shipping' -}}
          {%- else -%}
            {{- ' · free over ' -}}{{- free_over | times: 100 | money_without_trailing_zeros -}}
          {%- endif -%}
        {%- endif -%}
      </span>
    </li>
  {%- endif -%}

  {%- for i in (1..3) -%}
    {%- liquid
      assign text_key = 'text_' | append: i
      assign icon_key = 'icon_' | append: i
      assign line = block_settings[text_key]
    -%}
    {%- if line != blank -%}
      <li class="nf-assurances__item">
        {%- render 'icon-or-image', icon: block_settings[icon_key], width: 18, class_name: 'nf-assurances__icon' -%}
        <span>{{ line }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

{% stylesheet %}
  .nf-assurances {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-size: var(--font-size--sm, 0.875rem);
    line-height: 1.45;
  }

  .nf-assurances__item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }

  .nf-assurances__icon {
    flex-shrink: 0;
    margin-block-start: 1px;
    color: var(--color-primary);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Naira assurances",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "shipping_days",
      "label": "Ships in",
      "default": "3–5 working days",
      "info": "Leave empty to hide the shipping line."
    },
    {
      "type": "number",
      "id": "free_shipping_over",
      "label": "Free shipping over (₹)",
      "default": 3000,
      "info": "Match Settings > Shipping. 0 means free on every order; empty hides it."
    },
    {
      "type": "select",
      "id": "icon_1",
      "label": "Line 1 icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "return", "label": "Return" },
        { "value": "box", "label": "Box" },
        { "value": "lock", "label": "Lock" },
        { "value": "heart", "label": "Heart" },
        { "value": "star", "label": "Star" },
        { "value": "price_tag", "label": "Price tag" },
        { "value": "chat_bubble", "label": "Chat" }
      ],
      "default": "return"
    },
    {
      "type": "inline_richtext",
      "id": "text_1",
      "label": "Line 1",
      "default": "7-day returns on eligible pieces"
    },
    {
      "type": "select",
      "id": "icon_2",
      "label": "Line 2 icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "return", "label": "Return" },
        { "value": "box", "label": "Box" },
        { "value": "lock", "label": "Lock" },
        { "value": "heart", "label": "Heart" },
        { "value": "star", "label": "Star" },
        { "value": "price_tag", "label": "Price tag" },
        { "value": "chat_bubble", "label": "Chat" }
      ],
      "default": "box"
    },
    {
      "type": "inline_richtext",
      "id": "text_2",
      "label": "Line 2",
      "default": "Arrives in a Naira Petite box, ready to gift"
    },
    {
      "type": "select",
      "id": "icon_3",
      "label": "Line 3 icon",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "return", "label": "Return" },
        { "value": "box", "label": "Box" },
        { "value": "lock", "label": "Lock" },
        { "value": "heart", "label": "Heart" },
        { "value": "star", "label": "Star" },
        { "value": "price_tag", "label": "Price tag" },
        { "value": "chat_bubble", "label": "Chat" }
      ],
      "default": "lock"
    },
    {
      "type": "inline_richtext",
      "id": "text_3",
      "label": "Line 3",
      "info": "For example: Cash on delivery available. Only add what checkout really offers."
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Naira assurances"
    }
  ]
}
{% endschema %}
