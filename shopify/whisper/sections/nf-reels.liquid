{%- doc -%}
  Naira: "Shop the reel", a rail of the brand's reels, each one tagged with
  the pieces it shows and a link to them.

  On the home page every reel shows. On a product page, with "Only reels of
  this piece" on, only the reels that feature that piece show, and when none
  do the section prints nothing.

  Video loads only when a reel scrolls into view, plays muted while it is
  mostly on screen and pauses when it leaves, so a phone downloads only what
  is watched. With reduced motion asked for, nothing plays until tapped.
  Each reel's video comes from the Files picker or, failing that, from a
  pasted Shopify CDN address; the 720p MP4 is used either way.
{%- enddoc -%}

{%- liquid
  assign current = closest.product
  assign shown = 0
-%}

{%- capture slides -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign include = true
      if section.settings.only_this_product and current != blank
        assign include = false
        for piece in block.settings.products
          if piece.id == current.id
            assign include = true
            break
          endif
        endfor
      endif

      assign src = block.settings.video_url
      if block.settings.video != blank
        assign mp4s = block.settings.video.sources | where: 'format', 'mp4'
        assign picked = mp4s | where: 'height', 720 | first | default: mp4s.first
        assign src = picked.url
      endif
      if src == blank
        assign include = false
      endif

      assign poster = block.settings.poster | default: block.settings.video.preview_image
    -%}
    {%- if include -%}
      {%- assign shown = shown | plus: 1 -%}
      <li class="nf-reel" {{ block.shopify_attributes }}>
        <div class="nf-reel__media">
          <video
            class="nf-reel__video"
            data-src="{{ src | escape }}"
            {% if poster != blank %}
              poster="{{ poster | image_url: width: 720 }}"
            {% endif %}
            muted
            playsinline
            loop
            preload="none"
            aria-label="{{ block.settings.caption | default: section.settings.heading | escape }}"
          ></video>
          <button
            type="button"
            class="nf-reel__sound"
            aria-pressed="false"
            aria-label="Sound on"
          >
            <svg aria-hidden="true" focusable="false" viewBox="0 0 20 20" width="18" height="18">
              <path d="M3 8h3l4-3.5v11L6 12H3z" fill="currentColor" />
              <path class="nf-reel__wave" d="M13 7.5a3.5 3.5 0 0 1 0 5M15 5.5a6.5 6.5 0 0 1 0 9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              <path class="nf-reel__mute" d="M13.5 7.5l4 5m0-5l-4 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
          </button>
        </div>
        {%- if block.settings.caption != blank -%}
          <p class="nf-reel__caption">{{ block.settings.caption | escape }}</p>
        {%- endif -%}
        {%- if block.settings.products.size > 0 -%}
          <ul class="nf-reel__pieces" role="list">
            {%- for piece in block.settings.products -%}
              <li>
                <a class="nf-reel__piece" href="{{ piece.url }}">
                  {%- if piece.featured_image -%}
                    {{
                      piece.featured_image
                      | image_url: width: 120
                      | image_tag: width: 40, height: 50, loading: 'lazy', alt: '', class: 'nf-reel__thumb'
                    }}
                  {%- endif -%}
                  <span class="nf-reel__name">{{ piece.title | escape }}</span>
                  <span class="nf-reel__price">
                    {%- if piece.available -%}
                      {{ piece.price | money }}
                    {%- else -%}
                      {{ 'content.product_badge_sold_out' | t }}
                    {%- endif -%}
                  </span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 -%}
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div class="section section--page-width color-{{ section.settings.color_scheme }}">
    <nf-reels
      class="nf-reels spacing-style"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="nf-reels__head">
        <h2 class="h4">{{ section.settings.heading | escape }}</h2>
        {%- if shown > 1 -%}
          <p class="nf-reels__count">{{ shown }} reels</p>
        {%- endif -%}
      </div>
      <ul class="nf-reels__rail" role="list">
        {{ slides }}
      </ul>
    </nf-reels>
  </div>

  <script type="module">
    if (!customElements.get('nf-reels')) {
      customElements.define(
        'nf-reels',
        class extends HTMLElement {
          connectedCallback() {
            const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            this.videos = [...this.querySelectorAll('.nf-reel__video')];

            for (const video of this.videos) {
              video.addEventListener('click', () => this.toggle(video));
              video.parentElement.querySelector('.nf-reel__sound')?.addEventListener('click', (event) => {
                event.stopPropagation();
                video.muted = !video.muted;
                event.currentTarget.setAttribute('aria-pressed', String(!video.muted));
                event.currentTarget.setAttribute('aria-label', video.muted ? 'Sound on' : 'Sound off');
                if (video.paused) this.play(video);
              });
            }

            if (reduced) return;
            this.observer = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (entry.intersectionRatio >= 0.6) this.play(entry.target);
                  else entry.target.pause();
                }
              },
              { threshold: [0, 0.6, 1] }
            );
            for (const video of this.videos) this.observer.observe(video);
          }

          disconnectedCallback() {
            this.observer?.disconnect();
          }

          load(video) {
            if (!video.getAttribute('src')) video.src = video.dataset.src;
          }

          play(video) {
            this.load(video);
            video.play().catch(() => {});
          }

          toggle(video) {
            if (video.paused) this.play(video);
            else video.pause();
          }
        }
      );
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .nf-reels {
    display: grid;
    gap: 20px;
  }

  .nf-reels__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }

  .nf-reels__head .h4 {
    margin: 0;
  }

  .nf-reels__count {
    margin: 0;
    font-size: var(--font-size--xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .nf-reels__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 260px);
    gap: 12px;
    margin: 0;
    padding: 0 0 4px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .nf-reels__rail::-webkit-scrollbar {
    display: none;
  }

  .nf-reel {
    display: grid;
    gap: 10px;
    align-content: start;
    scroll-snap-align: start;
  }

  .nf-reel__media {
    position: relative;
    aspect-ratio: 9 / 16;
    background: var(--color-border);
    overflow: hidden;
  }

  .nf-reel__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
  }

  .nf-reel__sound {
    position: absolute;
    inset: auto 8px 8px auto;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(26 22 20 / 0.45);
    color: #fff8f5;
    cursor: pointer;
  }

  .nf-reel__sound[aria-pressed='false'] .nf-reel__wave,
  .nf-reel__sound[aria-pressed='true'] .nf-reel__mute {
    display: none;
  }

  .nf-reel__caption {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: var(--font-size--md, 1rem);
    line-height: 1.2;
  }

  .nf-reel__pieces {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nf-reel__piece {
    display: grid;
    grid-template-columns: 40px 1fr;
    grid-template-rows: auto auto;
    column-gap: 10px;
    align-items: center;
    min-height: 50px;
    color: inherit;
    text-decoration: none;
  }

  .nf-reel__thumb {
    grid-row: span 2;
    width: 40px;
    height: 50px;
    object-fit: cover;
  }

  .nf-reel__name {
    font-size: var(--font-size--sm);
    line-height: 1.25;
  }

  .nf-reel__price {
    font-family: var(--font-subheading--family);
    font-size: var(--font-size--xs);
    font-variant-numeric: tabular-nums;
  }

  .nf-reel__piece:hover .nf-reel__name,
  .nf-reel__piece:focus-visible .nf-reel__name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Naira reels",
  "class": "section-wrapper",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the reel"
    },
    {
      "type": "checkbox",
      "id": "only_this_product",
      "label": "Only reels of this piece",
      "info": "On a product page, show just the reels that feature the product. The section hides when there are none.",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Or video address",
          "info": "A Shopify CDN MP4 address. Used when no video is picked above."
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Pieces in this reel",
          "limit": 3
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Naira reels"
    }
  ]
}
{% endschema %}
